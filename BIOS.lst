00095Er 2  A6 11                ldx     FAC+3
000960r 2  86 10                stx     FAC+2
000962r 2  A6 12                ldx     FAC+4
000964r 2  86 11                stx     FAC+3
000966r 2  A6 1D                ldx     FACEXTENSION
000968r 2  86 12                stx     FAC+4
00096Ar 2  84 1D                sty     FACEXTENSION
00096Cr 2  69 08                adc     #$08
00096Er 2  C9 20                cmp     #MANTISSA_BYTES*8
000970r 2  D0 E4                bne     Lbl36C7
000972r 2               
000972r 2               ; ----------------------------------------------------------------------------
000972r 2               ; SET FAC = 0
000972r 2               ; (ONLY NECESSARY TO Zero EXPONENT AND Sign CELLS)
000972r 2               ; ----------------------------------------------------------------------------
000972r 2               ZeroFac:
000972r 2  A9 00                lda     #$00
000974r 2               StaInFacSignAndExp:
000974r 2  85 0E                sta     FAC
000976r 2               StaInFacSign:
000976r 2  85 13                sta     FACSIGN
000978r 2  60                   rts
000979r 2               
000979r 2               ; ----------------------------------------------------------------------------
000979r 2               ; ADD MANTISSAS OF FAC AND ARG INTO FAC
000979r 2               ; ----------------------------------------------------------------------------
000979r 2               FAdd4:
000979r 2  65 43                adc     ARGEXTENSION
00097Br 2  85 1D                sta     FACEXTENSION
00097Dr 2  A5 12                lda     FAC+4
00097Fr 2  65 1A                adc     ARG+4
000981r 2  85 12                sta     FAC+4
000983r 2  A5 11                lda     FAC+3
