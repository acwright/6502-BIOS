001704r 2               ; BasCmdClr -- implement CLR (clear vars/arrays/strings without erasing program).
001704r 2               ;   VARTAB := PRGEND (already correct in our model)
001704r 2               ;   ARYTAB := STREND := VARTAB
001704r 2               ;   FRETOP := MEMSIZ
001704r 2               ;   TEMPPT := TEMPST, DATAPTR := TXTTAB-1, stacks emptied
001704r 2               ; ---------------------------------------------------------------------------
001704r 2               BasCmdClr:
001704r 2                       ; ARYTAB = STREND = VARTAB
001704r 2  AD 5F 03             lda     VARTAB
