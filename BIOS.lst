0022F2r 2               
0022F2r 2               ; ---------------------------------------------------------------------------
0022F2r 2               ; Statement: INPUT [<"prompt">{,;}] var[,var,...]
0022F2r 2               ;   Prompts user for input, reads a line, parses it into the variable list.
0022F2r 2               ;   "abc";VAR  prints  abc?    (question + space appended)
0022F2r 2               ;   "abc",VAR  prints  abc      (no question mark)
0022F2r 2               ;   no prompt: prints  ?
0022F2r 2               ;   On bad numeric input or premature end-of-line: "?REDO FROM START"
0022F2r 2               ;   and reprompt.  Trailing un-consumed input: "?EXTRA IGNORED".
0022F2r 2               ; ---------------------------------------------------------------------------
0022F2r 2               BasCmdInput:
0022F2r 2                       ; INPUT is illegal in direct mode.
0022F2r 2  AD 6A 03             lda     BAS_CURLIN+1
0022F5r 2  C9 FF                cmp     #$FF
0022F7r 2  D0 05                bne     @notDirect
0022F9r 2  A2 07                ldx     #ERR_ILLDIRECT
0022FBr 2  4C rr rr             jmp     BasErrorVec
0022FEr 2               @notDirect:
0022FEr 2                       ; ChrGot returns first char after the INPUT token.
0022FEr 2  20 rr rr             jsr     ChrGot
002301r 2  C9 22                cmp     #'"'
002303r 2  D0 27                bne     @noPrompt
002305r 2                       ; Parse string literal & print it; FrmEvl will leave descriptor in FAC.
002305r 2  20 rr rr             jsr     FrmEvl
002308r 2  20 rr rr             jsr     ChkStr
00230Br 2  20 rr rr             jsr     PrintStrFAC
00230Er 2  20 rr rr             jsr     FreFac
002311r 2  20 rr rr             jsr     ChrGot
002314r 2  C9 3B                cmp     #';'
002316r 2  F0 09                beq     @semi
002318r 2  C9 2C                cmp     #','
00231Ar 2  D0 0D                bne     @badPrompt
00231Cr 2  20 rr rr             jsr     ChrGet                  ; consume ','
00231Fr 2  80 0E                bra     @afterPrompt
002321r 2               @semi:
002321r 2  20 rr rr             jsr     ChrGet                  ; consume ';'
002324r 2  20 rr rr             jsr     BasInpQues              ; '? '
002327r 2  80 06                bra     @afterPrompt
002329r 2               @badPrompt:
002329r 2  4C rr rr             jmp     SynErr
00232Cr 2               @noPrompt:
00232Cr 2  20 rr rr             jsr     BasInpQues              ; '? '
00232Fr 2               @afterPrompt:
00232Fr 2                       ; Save program TXTPTR (start of var-list) for REDO retry.
00232Fr 2  A5 04                lda     TXTPTR
002331r 2  8D 71 03             sta     BAS_INPSAV
002334r 2  A5 05                lda     TXTPTR+1
002336r 2  8D 72 03             sta     BAS_INPSAV+1
002339r 2               @retry:
002339r 2  20 rr rr             jsr     BasReadLine             ; reads to BAS_LINBUF, NUL-terminated, prints CRLF
00233Cr 2                       ; Set up data pointer with leading ',' sentinel just before LINBUF.
00233Cr 2  A9 2C                lda     #','
00233Er 2  8D FF 03             sta     BAS_LINBUF-1
002341r 2  A9 FF                lda     #<(BAS_LINBUF-1)
002343r 2  85 3A                sta     BAS_TMP1
002345r 2  A9 03                lda     #>(BAS_LINBUF-1)
002347r 2  85 3B                sta     BAS_TMP1+1
002349r 2                       ; Restore program TXTPTR.
002349r 2  AD 71 03             lda     BAS_INPSAV
00234Cr 2  85 04                sta     TXTPTR
00234Er 2  AD 72 03             lda     BAS_INPSAV+1
002351r 2  85 05                sta     TXTPTR+1
002353r 2  64 69                stz     BAS_INPUTFLG            ; INPUT mode ($00)
002355r 2               @nextVar:
002355r 2  20 rr rr             jsr     PtrGet                  ; advance program TXTPTR past var name
002358r 2  85 46                sta     BAS_FORPNT
00235Ar 2  84 47                sty     BAS_FORPNT+1
00235Cr 2                       ; Save program TXTPTR; switch to data side.
00235Cr 2  A5 05                lda     TXTPTR+1
00235Er 2  48                   pha
00235Fr 2  A5 04                lda     TXTPTR
002361r 2  48                   pha
002362r 2  A5 3A                lda     BAS_TMP1
002364r 2  85 04                sta     TXTPTR
002366r 2  A5 3B                lda     BAS_TMP1+1
002368r 2  85 05                sta     TXTPTR+1
00236Ar 2  20 rr rr             jsr     ChrGot
00236Dr 2  D0 05                bne     @gotData
00236Fr 2                       ; Out of input data before var list exhausted -> REDO.
00236Fr 2  68                   pla
002370r 2  68                   pla
002371r 2  4C rr rr             jmp     @doRedo
002374r 2               @gotData:
002374r 2  20 rr rr             jsr     ChrGet                  ; consume the separator/sentinel
002377r 2  24 64                bit     VALTYP
002379r 2  30 2E                bmi     @inpStr
00237Br 2                       ; Numeric: must start with digit, '+', '-' or '.'; else REDO.
00237Br 2  20 rr rr             jsr     ChrGot
00237Er 2  90 11                bcc     @numOk                  ; carry clear == digit
002380r 2  C9 2D                cmp     #'-'
002382r 2  F0 0D                beq     @numOk
002384r 2  C9 2B                cmp     #'+'
002386r 2  F0 09                beq     @numOk
002388r 2  C9 2E                cmp     #'.'
00238Ar 2  F0 05                beq     @numOk
00238Cr 2                       ; bad numeric
00238Cr 2  68                   pla
00238Dr 2  68                   pla
00238Er 2  4C rr rr             jmp     @doRedo
002391r 2               @numOk:
002391r 2  20 rr rr             jsr     Fin
002394r 2  A6 46                ldx     BAS_FORPNT
002396r 2  A4 47                ldy     BAS_FORPNT+1
002398r 2  20 rr rr             jsr     StoreFacAtYxRounded
00239Br 2                       ; After Fin, ChrGot result must be NUL or ',' (Fin/ChrGot skips spaces).
00239Br 2  20 rr rr             jsr     ChrGot
00239Er 2  F0 51                beq     @afterStore
0023A0r 2  C9 2C                cmp     #','
0023A2r 2  F0 4D                beq     @afterStore
0023A4r 2                       ; Garbage trailing the number -> REDO.
0023A4r 2  68                   pla
0023A5r 2  68                   pla
0023A6r 2  4C rr rr             jmp     @doRedo
0023A9r 2               @inpStr:
0023A9r 2                       ; Peek at the first data character.  If it's a '"', use quote-mode
0023A9r 2                       ; (terminator = '"' or NUL); otherwise terminate at ',' or NUL.
0023A9r 2  A0 00                ldy     #0
0023ABr 2  B1 04                lda     (TXTPTR),y
0023ADr 2  C9 22                cmp     #'"'
0023AFr 2  F0 0E                beq     @sQuoted
0023B1r 2                       ; Unquoted: STRLT2 source = TXTPTR.
0023B1r 2  A9 00                lda     #0
0023B3r 2  85 44                sta     CHARAC
0023B5r 2  A9 2C                lda     #','
0023B7r 2  85 6A                sta     ENDCHR
0023B9r 2  A5 04                lda     TXTPTR
0023BBr 2  A4 05                ldy     TXTPTR+1
0023BDr 2  80 10                bra     @sCallStrLt
0023BFr 2               @sQuoted:
0023BFr 2  A9 22                lda     #'"'
0023C1r 2  85 44                sta     CHARAC
0023C3r 2  85 6A                sta     ENDCHR
0023C5r 2                       ; Skip the opening '"'; STRLT2 source = TXTPTR + 1.
0023C5r 2  18                   clc
0023C6r 2  A5 04                lda     TXTPTR
0023C8r 2  69 01                adc     #1
0023CAr 2  A4 05                ldy     TXTPTR+1
0023CCr 2  90 01                bcc     @sCallStrLt
0023CEr 2  C8                   iny
0023CFr 2               @sCallStrLt:
0023CFr 2  20 rr rr             jsr     StrLt2
0023D2r 2                       ; StrLt2 leaves STRNG2 pointing past the consumed string (at the
0023D2r 2                       ; terminator for unquoted input, or just past the closing '"' for
0023D2r 2                       ; quoted input).  Advance TXTPTR (== data pointer) accordingly so
0023D2r 2                       ; the trailing-extra check sees only what truly remained on the
0023D2r 2                       ; input line.
0023D2r 2  A5 1E                lda     STRNG2
0023D4r 2  85 04                sta     TXTPTR
0023D6r 2  A5 1F                lda     STRNG2+1
0023D8r 2  85 05                sta     TXTPTR+1
0023DAr 2  A0 00                ldy     #0
0023DCr 2  A5 0E                lda     FAC
0023DEr 2  91 46                sta     (BAS_FORPNT),y
0023E0r 2  C8                   iny
0023E1r 2  A5 0F                lda     FAC+1
0023E3r 2  91 46                sta     (BAS_FORPNT),y
0023E5r 2  C8                   iny
0023E6r 2  A5 10                lda     FAC+2
0023E8r 2  91 46                sta     (BAS_FORPNT),y
0023EAr 2                       ; StrLt2 pushed a temporary string descriptor via PutNew.  The
0023EAr 2                       ; variable now owns the heap copy, so pop the temp (pop only -- do
0023EAr 2                       ; NOT use FreFac, which would reclaim the heap we just handed to the
0023EAr 2                       ; variable).  Leaving temps unfreed leaks the 3-slot temp stack and
0023EAr 2                       ; both overflows it (?FORMULA TOO COMPLEX) and corrupts later strings
0023EAr 2                       ; via stale descriptor pointers.
0023EAr 2  A5 11                lda     FAC+3
0023ECr 2  A4 12                ldy     FAC+4
0023EEr 2  20 rr rr             jsr     FreTms
0023F1r 2               @afterStore:
0023F1r 2                       ; Save data ptr; restore program TXTPTR.
0023F1r 2  A5 04                lda     TXTPTR
0023F3r 2  85 3A                sta     BAS_TMP1
0023F5r 2  A5 05                lda     TXTPTR+1
0023F7r 2  85 3B                sta     BAS_TMP1+1
0023F9r 2  68                   pla
0023FAr 2  85 04                sta     TXTPTR
0023FCr 2  68                   pla
0023FDr 2  85 05                sta     TXTPTR+1
0023FFr 2                       ; More variables?
0023FFr 2  20 rr rr             jsr     ChrGot
002402r 2  C9 2C                cmp     #','
002404r 2  D0 06                bne     @doneVars
002406r 2  20 rr rr             jsr     ChrGet                  ; consume ','
002409r 2  4C rr rr             jmp     @nextVar
00240Cr 2               @doneVars:
00240Cr 2                       ; Check for un-consumed input (EXTRA IGNORED).
00240Cr 2  A0 00                ldy     #0
00240Er 2  B1 3A                lda     (BAS_TMP1),y
002410r 2  F0 12                beq     @inpDone
002412r 2                       ; Skip leading spaces; anything else is "extra".
002412r 2               @chkExtra:
002412r 2  B1 3A                lda     (BAS_TMP1),y
002414r 2  F0 0E                beq     @inpDone
002416r 2  C9 20                cmp     #' '
002418r 2  D0 03                bne     @hasExtra
00241Ar 2  C8                   iny
00241Br 2  D0 F5                bne     @chkExtra
00241Dr 2               @hasExtra:
00241Dr 2  A9 rr                lda     #<MsgExtra
00241Fr 2  A0 rr                ldy     #>MsgExtra
002421r 2  20 rr rr             jsr     BasPrintStr
002424r 2               @inpDone:
002424r 2  60                   rts
002425r 2               @doRedo:
002425r 2  A9 rr                lda     #<MsgRedo
002427r 2  A0 rr                ldy     #>MsgRedo
002429r 2  20 rr rr             jsr     BasPrintStr
