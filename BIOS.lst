00171Ar 2               ; BasCmdClr -- implement CLR (clear vars/arrays/strings without erasing program).
00171Ar 2               ;   VARTAB := PRGEND (already correct in our model)
00171Ar 2               ;   ARYTAB := STREND := VARTAB
00171Ar 2               ;   FRETOP := MEMSIZ
00171Ar 2               ;   TEMPPT := TEMPST, DATAPTR := TXTTAB-1, stacks emptied
00171Ar 2               ; ---------------------------------------------------------------------------
00171Ar 2               BasCmdClr:
00171Ar 2                       ; ARYTAB = STREND = VARTAB
00171Ar 2  AD 5F 03             lda     VARTAB
00171Dr 2  8D 61 03             sta     ARYTAB
001720r 2  8D 63 03             sta     STREND
001723r 2  AD 60 03             lda     VARTAB+1
