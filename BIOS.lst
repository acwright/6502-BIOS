000949r 2  F5 01                sbc     1,x
00094Br 2  85 0F                sta     FAC+1
00094Dr 2               
00094Dr 2               ; ----------------------------------------------------------------------------
00094Dr 2               ; NORMALIZE VALUE IN FAC
00094Dr 2               ; ----------------------------------------------------------------------------
00094Dr 2               NormalizeFac1:
00094Dr 2  B0 03                bcs     NormalizeFac2
00094Fr 2  20 rr rr             jsr     ComplementFac
000952r 2               NormalizeFac2:
