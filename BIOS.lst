000000r 1               ; =============================================================================
000000r 1               ; BIOS  —  Top-Level Assembly Source
000000r 1               ;           for AC6502 Homebrew Computer
000000r 1               ;
000000r 1               ;   Role        :  Sets the CPU target, then .include's every segment source
000000r 1               ;                   below in link order to produce the assembled ROM image.
000000r 1               ;   Segments    :  KERNAL $A000-$BFFF, BASIC $C000-$FEFF, WOZMON $FF00-$FFF9,
000000r 1               ;                   VECTORS $FFFA-$FFFF  (see BIOS.cfg)
000000r 1               ;   Assembler   :  ca65  (cc65 toolchain)
000000r 1               ;   Linker cfg  :  BIOS.cfg
000000r 1               ;
000000r 1               ;   Build       :  make build   ->  BIOS.bin / BIOS.lst / BIOS.dbg
000000r 1               ;   Test        :  make test    ->  runs tests/run.mjs against BIOS.bin
000000r 1               ; =============================================================================
000000r 1               
000000r 1               ; The hardware is a WDC 65C02S. cc65's "65C02" is the Rockwell part: it has
000000r 1               ; RMB/SMB/BBR/BBS but not WAI or STP, which are WDC additions. "W65C02" is that
000000r 1               ; set plus those two, so this is a pure superset — no instruction already in use
000000r 1               ; changes encoding, and the ROM is byte-identical until something emits WAI or
000000r 1               ; STP.
000000r 1               .setcpu "W65C02"
000000r 1               
000000r 1               ; Stated as a requirement rather than left to the line above, so that narrowing
000000r 1               ; the CPU fails the build here with a reason instead of failing at whichever
000000r 1               ; instruction happened to need it.
000000r 1               .if (.cpu .bitand CPU_ISET_W65C02) = 0
000000r 1                 .error "BIOS targets the WDC 65C02S — .setcpu must be W65C02 (WAI/STP)"
000000r 1               .endif
000000r 1               
000000r 1               .include "BIOS.inc"
000000r 2               ; =============================================================================
000000r 2               ; BIOS.INC  —  Shared Zero-Page, Memory-Map, and Hardware Register Equates
000000r 2               ;               for AC6502 Homebrew Computer
000000r 2               ;
000000r 2               ;   Role        :  .include'd by BIOS.asm before any segment. Defines the
000000r 2               ;                   zero-page layout, stack/buffer addresses, Kernal RAM
000000r 2               ;                   variables, and the memory-mapped I/O registers (VIA,
000000r 2               ;                   6551 ACIA, 6502-PICOVDP, SID, RTC, CompactFlash) shared by
000000r 2               ;                   every segment.
000000r 2               ;   Assembler   :  ca65  (cc65 toolchain)
000000r 2               ;
000000r 2               ;   Coding style :  Match the rest of the BIOS project.
000000r 2               ;                   * Constants / equates : UPPER_SNAKE_CASE.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; Zero Page
000000r 2               ZP                  := $00
000000r 2               READ_PTR            := $00
000000r 2               WRITE_PTR           := $01
000000r 2               STR_PTR             := $02               ; $02-$03 - String pointer (2 bytes)
000000r 2               ; $04-$23 reserved by BASIC interpreter
000000r 2               CF_BUF_PTR          := $24               ; $24-$25 - CF sector data buffer pointer (2 bytes)
000000r 2               CF_LBA              := $26               ; $26-$29 - CF 28-bit LBA address (4 bytes, little-endian)
000000r 2               XFER_PTR            := $2A               ; $2A-$2B - Serial transfer data pointer (2 bytes)
000000r 2               DELAY_CNT           := $2C               ; $2C-$2D - SysDelay 16-bit centisecond counter
000000r 2               ; $2E-$35 unassigned
000000r 2               
000000r 2               ; XModem ZP variables ($36-$39)
000000r 2               XMODEM_BLK          := $36               ; $36     - XModem expected/current block number
000000r 2               XMODEM_CHK          := $37               ; $37     - XModem running checksum
000000r 2               XMODEM_RETRY        := $38               ; $38     - XModem retry counter
000000r 2               XMODEM_RCVBLK       := $39               ; $39     - XModem received block number
000000r 2               
000000r 2               ; ProgramEnd chain-walk scratch.  Aliases the CF sector pointer / LBA, which are
000000r 2               ; idle whenever ProgramEnd runs (BASIC cold init or BASIC entry, never with an
000000r 2               ; I/O transfer in flight).
000000r 2               PE_PTR              := CF_BUF_PTR        ; $24-$25 - chain walk cursor
000000r 2               PE_NEXT             := CF_LBA            ; $26-$27 - candidate next-pointer
000000r 2               
000000r 2               ; NVRAM save-slot copy pointer.  Aliases STR_PTR, which NvRead/NvWrite clobber
000000r 2               ; exactly as PrintStr does — the two are never live at the same time.
000000r 2               NV_PTR              := STR_PTR           ; $02-$03 - caller's buffer during a slot copy
000000r 2               
000000r 2               ; Stack
000000r 2               STACK               := $0100             ; $0100-$01FF
000000r 2               
000000r 2               ; Input Buffer
000000r 2               INPUT_BUFFER        := $0200             ; $0200-$02FF
000000r 2               
000000r 2               ; Kernal Vars
000000r 2               KERNAL_VARS         := $0300             ; $0300-$03FF
000000r 2               IRQ_PTR             := $0300             ; $0300-$0301
000000r 2               BRK_PTR             := $0302             ; $0302-$0303
000000r 2               NMI_PTR             := $0304             ; $0304-$0305
000000r 2               IO_MODE             := $0306             ; Bit 0: 0=video, 1=serial output
000000r 2               VID_CURSOR_X        := $0307             ; Video cursor column (0-39)
000000r 2               VID_CURSOR_Y        := $0308             ; Video cursor row (0-23)
000000r 2               VID_CURSOR_ADDR     := $0309             ; Video cursor VRAM address ($0309-$030A)
000000r 2               RTC_BUF_CENT        := $030B             ; Century value from last RtcReadDate / for RtcWriteDate
000000r 2               RTC_TMP             := $030C             ; Scratch byte for BCD conversion
000000r 2               HW_PRESENT          := $030D             ; Hardware present bitmask (set during Reset probe)
000000r 2               ; HW_PRESENT bit definitions (bit order matches IO slot numbers)
000000r 2               HW_RAM_L            = %00000001          ; Bit 0: RAM card low  (IO 1, $8000-$83FF)
000000r 2               HW_RAM_H            = %00000010          ; Bit 1: RAM card high (IO 2, $8400-$87FF)
000000r 2               HW_RTC              = %00000100          ; Bit 2: RTC card (IO 3, DS1511Y)
000000r 2               HW_CF               = %00001000          ; Bit 3: Storage card (IO 4, CompactFlash)
000000r 2               HW_SC               = %00010000          ; Bit 4: Serial card (IO 5, R65C51)
000000r 2               HW_GPIO             = %00100000          ; Bit 5: GPIO card (IO 6, 65C22 VIA — keyboard/joysticks)
000000r 2               HW_SID              = %01000000          ; Bit 6: Sound card (IO 7, SID/ARMSID)
000000r 2               HW_VID              = %10000000          ; Bit 7: Video card (IO 8): a PICOVDP with the built-in font
000000r 2               BAS_PENDKEY         := $030E             ; Pending key from BasCheckBreak (1 byte)
000000r 2               CF_DISK             := $030F             ; Current CF "disk" bank (0-255); base LBA = CF_DISK * FS_DISK_SECTORS
000000r 2               BRK_P               := $0310             ; Saved P at time of BRK
000000r 2               BRK_PCL             := $0311             ; Saved PCL at time of BRK (points to BRK+2)
000000r 2               BRK_PCH             := $0312             ; Saved PCH at time of BRK
000000r 2               BRK_A               := $0313             ; Saved A at time of BRK
000000r 2               BRK_X               := $0314             ; Saved X at time of BRK
000000r 2               BRK_Y               := $0315             ; Saved Y at time of BRK
000000r 2               BRK_SP              := $0316             ; Saved SP at time of BRK
000000r 2               XFER_REMAIN         := $0317             ; $0317-$0318 - Remaining bytes to transfer (2 bytes)
000000r 2               XFER_IO_SAVE        := $0319             ; Saved IO_MODE before switching to serial
000000r 2               BAS_DATAPTR         := $031A             ; $031A-$031B - DATA read position (2 bytes)
000000r 2               BAS_STOPLINE        := $031C             ; $031C-$031D - Saved BAS_CURLINE for CONT (2 bytes)
000000r 2               BAS_STOPTXT         := $031E             ; $031E-$031F - Saved BAS_TXTPTR for CONT (2 bytes)
000000r 2               ; $0320-$0347 unassigned (1.x's SCROLL_BUF; the console scrolls in hardware)
000000r 2               ; Filesystem temp vars ($0348+)
000000r 2               FS_START_SEC        := $0348             ; $0348-$0349 - File start sector (2 bytes)
000000r 2               FS_FILE_SIZE        := $034A             ; $034A-$034B - File size in bytes (2 bytes)
000000r 2               FS_SEC_COUNT        := $034C             ; Number of sectors to read/write
000000r 2               FS_DIR_IDX          := $034D             ; Directory entry index (0-15)
000000r 2               FS_NEXT_SEC         := $034E             ; $034E-$034F - Next free sector for allocation (2 bytes)
000000r 2               FS_FNAME_BUF        := $0350             ; $0350-$035A - 11-byte filename buffer (8 name + 3 ext)
000000r 2               BOOT_VECTOR         := $035B             ; $035B-$035C - Cart/boot redirect vector (2 bytes, 0=normal boot)
000000r 2               
000000r 2               ; BASIC runtime variables ($035D-$038F) - additive; assignable by BASIC
000000r 2               BAS_TXTTAB          := $035D             ; $035D-$035E - Start of program text (= $0800)
000000r 2               BAS_VARTAB          := $035F             ; $035F-$0360 - End-of-program / start-of-vars pointer
000000r 2               BAS_ARYTAB          := $0361             ; $0361-$0362 - Start of arrays
000000r 2               BAS_STREND          := $0363             ; $0363-$0364 - End of arrays
000000r 2               BAS_FRETOP          := $0365             ; $0365-$0366 - Top-of-string-heap pointer
000000r 2               BAS_MEMSIZ          := $0367             ; $0367-$0368 - End of usable memory (= $8000)
000000r 2               BAS_CURLIN          := $0369             ; $0369-$036A - Currently executing line ($FFFF=direct mode)
000000r 2               BAS_OLDLIN          := $036B             ; $036B-$036C - Saved line for CONT
000000r 2               BAS_OLDTEXT         := $036D             ; $036D-$036E - Saved text ptr for CONT
000000r 2               BAS_WARM            := $036F             ; Warm-start magic ($A5 = previously initialised)
000000r 2               BAS_POSX            := $0370             ; PRINT column counter (0-39 video / 0-79 serial)
000000r 2               BAS_INPSAV          := $0371             ; $0371-$0372 - Saved TXTPTR across INPUT REDO retry
000000r 2               BAS_FNPTR           := $0373             ; $0373-$0374 - FN variable slot addr held across FnCall's expression evaluations (out of ZP so FrmEvl/Garbag cannot touch it)
000000r 2               BAS_STKBASE         := $0375             ; Stack pointer the READY loop restores before each direct-mode line: $FF with no
000000r 2                                                        ;   program suspended, or the running program's statement-boundary SP after a
000000r 2                                                        ;   STOP/END/Ctrl+C break, which is what keeps its FOR and GOSUB frames alive
000000r 2                                                        ;   for CONT.  Reset to $FF wherever the stack is reset (RUN, CLR, NEW, an error)
000000r 2               FS_IO_ADDR          := $037F             ; $037F-$0380 - Load/save target address for FsLoadFileAddr/FsSaveFileAddr
000000r 2               BAS_FNAME           := $0381             ; $0381-$038D - 13-byte scratch for null-terminated 8.3 filename (12-char "NAME.EXT" + null)
000000r 2               PRG_IMAGE_END       := $038E             ; $038E-$038F - End address of a program image placed at PROGRAM_START by a loader
000000r 2                                                        ;   outside BASIC; 0 = none.  Cleared by KernalInit and consumed by
000000r 2                                                        ;   ProgramEnd, so a stale value can never be mistaken for a fresh load.
000000r 2               
000000r 2               ; Kernal NVRAM save-slot variables ($0390-$03FF)
000000r 2               NV_ID               := $0390             ; Owner ID input for NvWrite ($00 is refused — that is NvErase)
000000r 2               
000000r 2               ; Kernal video variables ($0391-$039B)
000000r 2               VID_PEN             := $0391             ; Attribute byte for new output, fg<<4 | bg ($1F from KernalInit)
000000r 2               VID_TOP             := $0392             ; Name-table row shown at the top of the screen (0-23); L0SCRY = VID_TOP * 8
000000r 2               VID_MODE            := $0393             ; $00 = console not set up since KernalInit (card in the legacy submode);
000000r 2                                                        ;   $01 = text console intact.  Otherwise low nibble = the VMODE the Kernal
000000r 2                                                        ;   last set, b7 = disturbed (sprites, scroll, layers)
000000r 2               VDP_FW              := $0394             ; STAT5 (firmware version, BCD) at boot; $00 if no PICOVDP
000000r 2               VDP_CAPS            := $0395             ; STAT6 (capability bits) at boot; $00 if no PICOVDP
000000r 2               VDP_L0CTRL_SHADOW   := $0396             ; Shadow of the write-only L0CTRL register
000000r 2               VDP_L1CTRL_SHADOW   := $0397             ; Shadow of the write-only L1CTRL register
000000r 2               VDP_P0              := $0398             ; Parameter block for VDP entries that take more than A/X/Y
000000r 2               VDP_P1              := $0399
000000r 2               VDP_P2              := $039A
000000r 2               VDP_P3              := $039B
000000r 2               
000000r 2               FS_SECTOR_BUF       := $0600             ; $0600-$07FF - 512-byte sector buffer (overlaps BAS_TOKBUF/BAS_STRBUF)
000000r 2               
000000r 2               ; XModem Protocol Constants
000000r 2               XMODEM_SOH          = $01                ; Start of Header
000000r 2               XMODEM_EOT          = $04                ; End of Transmission
000000r 2               XMODEM_ACK          = $06                ; Acknowledge
000000r 2               XMODEM_NAK          = $15                ; Negative Acknowledge
000000r 2               XMODEM_CAN          = $18                ; Cancel
000000r 2               XMODEM_SUB          = $1A                ; Padding byte (end of last block)
000000r 2               XMODEM_BLKSZ        = 128                ; Data bytes per block
000000r 2               XMODEM_MAXRETRY     = 10                 ; Max retries per block during transfer
000000r 2               XMODEM_STARTRETRY   = 60                 ; Retries waiting for initial connect (~60s)
000000r 2               
000000r 2               ; BIOS Version
000000r 2               BIOS_VERSION_MAJOR  = 2
000000r 2               BIOS_VERSION_MINOR  = 0
000000r 2               
000000r 2               ; NOT user memory, despite the name -- kept only because Wozmon builds its input
000000r 2               ; buffer on it.  Every byte of $0400-$07FF belongs to something: $0400 is
000000r 2               ; BAS_LINBUF (the raw input line), $0500 is BAS_TOKBUF (tokenizing scratch), and
000000r 2               ; $0600-$07FF is FS_SECTOR_BUF, which any filesystem call overwrites.  A program
000000r 2               ; wanting scratch space has $003A-$00FF in zero page and everything above itself
000000r 2               ; up to MEMORY_TOP.
000000r 2               USER_VARS           := $0400             ; $0400-$07FF - see above; Wozmon's input buffer
000000r 2               
000000r 2               ; Program
000000r 2               PROGRAM_START       := $0800             ; $0800-$7FFF
000000r 2               MEMORY_TOP          := $8000             ; First address past usable RAM (I/O starts here)
000000r 2               
000000r 2               ; RAM Card | IO 1 | $8000-$83FF
000000r 2               RAM_DATA_L          := $8000             ; R/W ($8000-$83FE)
000000r 2               RAM_BANK_L          := $83FF             ; Write-only RAM bank latch, value ($00-$FF) sets which of 256 ~1K banks of RAM is selected
000000r 2               
000000r 2               ; RAM Card | IO 2 | $8400-$87FF
000000r 2               RAM_DATA_H          := $8400             ; R/W ($8400-$87FE)
000000r 2               RAM_BANK_H          := $87FF             ; Write-only RAM bank latch, value ($00-$FF) sets which of 256 ~1K banks of RAM is selected
000000r 2               
000000r 2               ; RTC Card (DS1511Y) | IO 3 | $8800-$881F
000000r 2               RTC_SEC             := $8800
000000r 2               RTC_MIN             := $8801
000000r 2               RTC_HR              := $8802
000000r 2               RTC_DAY             := $8803
000000r 2               RTC_DATE            := $8804
000000r 2               RTC_MON             := $8805
000000r 2               RTC_YR              := $8806
000000r 2               RTC_CENT            := $8807
000000r 2               RTC_ALARM_SEC       := $8808
000000r 2               RTC_ALARM_MIN       := $8809
000000r 2               RTC_ALARM_HR        := $880A
000000r 2               RTC_ALARM_DATE      := $880B
000000r 2               RTC_WD_L            := $880C
000000r 2               RTC_WD_H            := $880D
000000r 2               RTC_CTRL_A          := $880E
000000r 2               RTC_CTRL_B          := $880F
000000r 2               RTC_RAM_ADDR        := $8810
000000r 2               RTC_RAM_DATA        := $8813
000000r 2               ; DS1511Y Control Register B Bits
000000r 2               RTC_CTRL_B_TE       := %10000000         ; Transfer Enable — 1 = counters update the user registers once a second, 0 = inhibited
000000r 2               RTC_CTRL_B_BME      := %00100000         ; Burst Mode Enable — 1 = RTC_RAM_ADDR auto-increments on each access of RTC_RAM_DATA
000000r 2               ; DS1511Y Month Register (05H) — upper 3 bits are control bits, low 5 are month
000000r 2               RTC_MON_MASK        := %00011111         ; Month value occupies the low 5 bits
000000r 2               RTC_MON_EOSC        := %10000000         ; Oscillator Start/Stop (0 = oscillator running)
000000r 2               RTC_MON_E32K        := %01000000         ; 32kHz square-wave enable (1 = SQW output disabled)
000000r 2               RTC_MON_BB32        := %00100000         ; Battery-backup 32kHz SQW enable (1 = enabled in backup)
000000r 2               ; NVRAM save slots — slot n occupies NVRAM n*16 .. n*16+15:
000000r 2               ;   +0 owner ID ($00 = free), +1 checksum, +2..+15 payload
000000r 2               ; Checksum: ck = NV_CK_SEED, then ck = rol8(ck) EOR b for the ID and the 14 payload bytes
000000r 2               NV_SLOTS            = 16                 ; Save slots in RTC NVRAM
000000r 2               NV_SLOT_SIZE        = 16                 ; Bytes per slot (slot n at NVRAM n*16)
000000r 2               NV_SLOT_DATA        = 14                 ; Payload bytes per slot
000000r 2               NV_CK_SEED          = $A6                ; Checksum seed
000000r 2               NV_EMPTY            = 0                  ; NvStat: slot is free
000000r 2               NV_VALID            = 1                  ; NvStat: owner ID set, checksum agrees
000000r 2               NV_BAD              = 2                  ; NvStat: owner ID set, checksum does not
000000r 2               
000000r 2               ; Storage Card (CompactFlash 8-bit IDE) | IO 4 | $8C00-$8C07
000000r 2               ST_DATA             := $8C00             ; R/W
000000r 2               ST_ERROR            := $8C01             ; Read
000000r 2               ST_FEATURE          := $8C01             ; Write
000000r 2               ST_SECT_CNT         := $8C02             ; R/W
000000r 2               ST_LBA_0            := $8C03             ; R/W
000000r 2               ST_LBA_1            := $8C04             ; R/W
000000r 2               ST_LBA_2            := $8C05             ; R/W
000000r 2               ST_LBA_3            := $8C06             ; R/W
000000r 2               ST_STATUS           := $8C07             ; Read
000000r 2               ST_CMD              := $8C07             ; Write
000000r 2               ST_ERR_AMNF         := %00000001
000000r 2               ST_ERR_ABRT         := %00000100
000000r 2               ST_ERR_IDNF         := %00010000
000000r 2               ST_ERR_UNC          := %01000000
000000r 2               ST_ERR_BBK          := %10000000
000000r 2               ST_STATUS_ERR       := %00000001
000000r 2               ST_STATUS_IDX       := %00000010
000000r 2               ST_STATUS_CORR      := %00000100
000000r 2               ST_STATUS_DRQ       := %00001000
000000r 2               ST_STATUS_DSC       := %00010000
000000r 2               ST_STATUS_DWF       := %00100000
000000r 2               ST_STATUS_RDY       := %01000000
000000r 2               ST_STATUS_BSY       := %10000000
000000r 2               ; ATA Command Constants
000000r 2               ST_CMD_READ         := $20               ; Read Sectors
000000r 2               ST_CMD_WRITE        := $30               ; Write Sectors
000000r 2               ST_CMD_SET_FEAT     := $EF               ; Set Features
000000r 2               ST_FEAT_8BIT        := $01               ; Enable 8-bit data I/O
000000r 2               ST_LBA3_MASTER      := $E0               ; LBA mode, master drive (bits 7-5 = 111, bit 4 = 0)
000000r 2               ; Filesystem Constants
000000r 2               FS_DIR_LBA          = 0                  ; Directory sector at LBA 0
000000r 2               FS_DATA_START       = 1                  ; Data sectors start at LBA 1
000000r 2               FS_MAX_FILES        = 16                 ; Max directory entries
000000r 2               FS_ENTRY_SIZE       = 32                 ; Bytes per directory entry
000000r 2               FS_ENTRY_FLAGS      = 11                 ; Offset of flags byte within entry
000000r 2               FS_ENTRY_START      = 12                 ; Offset of start sector (2 bytes)
000000r 2               FS_ENTRY_FSIZE      = 14                 ; Offset of file size (2 bytes)
000000r 2               FS_FLAG_USED        = %00000001          ; Entry in use
000000r 2               FS_DISK_SECTORS     = 2048               ; Sectors per disk bank (2048 * 512 = 1 MB); 256 disks = 256 MB
000000r 2               
000000r 2               ; Serial Card / Serial Card Pro (R65C51) | IO 5 | $9000-$9003
000000r 2               SC_DATA             := $9000             ; R/W
000000r 2               SC_RESET            := $9001             ; Write
000000r 2               SC_STATUS           := $9001             ; Read
000000r 2               SC_CMD              := $9002             ; R/W
000000r 2               SC_CTRL             := $9003             ; R/W
000000r 2               SC_STATUS_IRQ       := %10000000         ; Interrupt
000000r 2               SC_STATUS_DSR       := %01000000         ; Data Set Ready
000000r 2               SC_STATUS_DCD       := %00100000         ; Data Carrier Detect
000000r 2               SC_STATUS_TDRE      := %00010000         ; TX Data Register Empty
000000r 2               SC_STATUS_RDRF      := %00001000         ; RX Data Register Full
000000r 2               SC_STATUS_OVR       := %00000100         ; Overrun
000000r 2               SC_STATUS_FRME      := %00000010         ; Framing Error
000000r 2               SC_STATUS_PARE      := %00000001         ; Parity Error
000000r 2               SC_CMD_RXIRQ_OFF    := %00000010         ; Receiver interrupt disabled
000000r 2               ; Command register bytes. TIC (bits 3-2) drives RTS *and* the transmitter: 00
000000r 2               ; raises RTS and turns the transmitter off, 10 lowers RTS and turns it on. So
000000r 2               ; the machine cannot send a character while it is holding RTS high — see ScRts.
000000r 2               SC_CMD_RTS_LOW      := %00001001         ; DTR on, RX IRQ on, TIC 10: RTS low, transmitter on
000000r 2               SC_CMD_RTS_HIGH     := %00000001         ; DTR on, RX IRQ on, TIC 00: RTS high, transmitter off
000000r 2               SC_CMD_XMODEM       := %00001011         ; DTR on, RX IRQ off, TIC 10: XModem polls the chip itself
000000r 2               SC_RTS_HIGH_WATER   = $C0                ; Unread bytes at which RTS goes up
000000r 2               SC_RTS_LOW_WATER    = $80                ; Unread bytes below which RTS comes down
000000r 2               
000000r 2               ; GPIO Card / Input Board (65C22) | IO 6 | $9400-$940F
000000r 2               GPIO_PORTB          := $9400
000000r 2               GPIO_PORTA          := $9401
000000r 2               GPIO_DDRB           := $9402
000000r 2               GPIO_DDRA           := $9403
000000r 2               GPIO_T1CL           := $9404
000000r 2               GPIO_T1CH           := $9405
000000r 2               GPIO_T1LL           := $9406
000000r 2               GPIO_T1LH           := $9407
000000r 2               GPIO_T2CL           := $9408
000000r 2               GPIO_T2CH           := $9409
000000r 2               GPIO_SR             := $940A
000000r 2               GPIO_ACR            := $940B
000000r 2               GPIO_PCR            := $940C
000000r 2               GPIO_IFR            := $940D
000000r 2               GPIO_IER            := $940E
000000r 2               GPIO_ORA            := $940F
000000r 2               ; Keyboard (VIA) Constants
000000r 2               GPIO_PCR_CB2_LO     := %11000000         ; PCR CB2 mode = manual output low (enables matrix keyboard encoder)
000000r 2               GPIO_PCR_CB2_HI     := %11100000         ; PCR CB2 mode = manual output high (disables matrix keyboard encoder)
000000r 2               GPIO_PCR_CB1_NEG    := %00000000         ; PCR CB1 active on falling (high-to-low) edge
000000r 2               GPIO_PCR_CA2_LO     := %00001100         ; PCR CA2 mode = manual output low (enables PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA2_HI     := %00001110         ; PCR CA2 mode = manual output high (disables PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA1_NEG    := %00000000         ; PCR CA1 active on falling (high-to-low) edge
000000r 2               GPIO_INT_CB1        := %00010000         ; IFR/IER bit 4 = CB1 interrupt flag/enable
000000r 2               GPIO_INT_CA1        := %00000010         ; IFR/IER bit 1 = CA1 interrupt flag/enable
000000r 2               GPIO_IER_SET        := %10000000         ; IER bit 7 = set mode (1=set named bits, 0=clear)
000000r 2               
000000r 2               ; Sound Card (SID/ARMSID) | IO 7 | $9800-$981C
000000r 2               SID_V1_FREQ_LO      := $9800             ; Voice 1 Frequency Low
000000r 2               SID_V1_FREQ_HI      := $9801             ; Voice 1 Frequency High
000000r 2               SID_V1_PW_LO        := $9802             ; Voice 1 Pulse Width Low
000000r 2               SID_V1_PW_HI        := $9803             ; Voice 1 Pulse Width High
000000r 2               SID_V1_CTRL         := $9804             ; Voice 1 Control Register
000000r 2               SID_V1_AD           := $9805             ; Voice 1 Attack/Decay
000000r 2               SID_V1_SR           := $9806             ; Voice 1 Sustain/Release
000000r 2               SID_V2_FREQ_LO      := $9807             ; Voice 2 Frequency Low
000000r 2               SID_V2_FREQ_HI      := $9808             ; Voice 2 Frequency High
000000r 2               SID_V2_PW_LO        := $9809             ; Voice 2 Pulse Width Low
000000r 2               SID_V2_PW_HI        := $980A             ; Voice 2 Pulse Width High
000000r 2               SID_V2_CTRL         := $980B             ; Voice 2 Control Register
000000r 2               SID_V2_AD           := $980C             ; Voice 2 Attack/Decay
000000r 2               SID_V2_SR           := $980D             ; Voice 2 Sustain/Release
000000r 2               SID_V3_FREQ_LO      := $980E             ; Voice 3 Frequency Low
000000r 2               SID_V3_FREQ_HI      := $980F             ; Voice 3 Frequency High
000000r 2               SID_V3_PW_LO        := $9810             ; Voice 3 Pulse Width Low
000000r 2               SID_V3_PW_HI        := $9811             ; Voice 3 Pulse Width High
000000r 2               SID_V3_CTRL         := $9812             ; Voice 3 Control Register
000000r 2               SID_V3_AD           := $9813             ; Voice 3 Attack/Decay
000000r 2               SID_V3_SR           := $9814             ; Voice 3 Sustain/Release
000000r 2               SID_FC_LO           := $9815             ; Filter Cutoff Low
000000r 2               SID_FC_HI           := $9816             ; Filter Cutoff High
000000r 2               SID_RES_FILT        := $9817             ; Resonance/Filter
000000r 2               SID_MODE_VOL        := $9818             ; Filter Mode/Volume
000000r 2               SID_PADDLE_X        := $9819             ; Paddle X (Read-only)
000000r 2               SID_PADDLE_Y        := $981A             ; Paddle Y (Read-only)
000000r 2               SID_OSC3            := $981B             ; Oscillator 3 (Read-only)
000000r 2               SID_ENV3            := $981C             ; Envelope 3 (Read-only)
000000r 2               ; SID Control Register Bits
000000r 2               SID_CTRL_GATE       := %00000001         ; Gate bit
000000r 2               SID_CTRL_SYNC       := %00000010         ; Sync bit
000000r 2               SID_CTRL_RING       := %00000100         ; Ring modulation
000000r 2               SID_CTRL_TEST       := %00001000         ; Test bit
000000r 2               SID_CTRL_TRIANGLE   := %00010000         ; Triangle waveform
000000r 2               SID_CTRL_SAWTOOTH   := %00100000         ; Sawtooth waveform
000000r 2               SID_CTRL_PULSE      := %01000000         ; Pulse waveform
000000r 2               SID_CTRL_NOISE      := %10000000         ; Noise waveform
000000r 2               ; SID Filter Mode Bits
000000r 2               SID_FILT_LP         := %00010000         ; Low-pass filter
000000r 2               SID_FILT_BP         := %00100000         ; Band-pass filter
000000r 2               SID_FILT_HP         := %01000000         ; High-pass filter
000000r 2               SID_FILT_3OFF       := %10000000         ; Voice 3 off
000000r 2               
000000r 2               ; Video Card (6502-PICOVDP) | IO 8 | $9C00-$9C03
000000r 2               ; Two complete port pairs.  The Kernal uses port A only; port B is for interrupt
000000r 2               ; handlers (SPEC §4).  A register write is two writes to a command port: the
000000r 2               ; value, then the register number with bit 7 set.
000000r 2               VC_DATA             := $9C00             ; R/W  VRAM data, port A
000000r 2               VC_REG              := $9C01             ; Write  command, port A
000000r 2               VC_STATUS           := $9C01             ; Read  status (STATSEL_A selects which), port A
000000r 2               VC_DATA2            := $9C02             ; R/W  VRAM data, port B
000000r 2               VC_REG2             := $9C03             ; Write  command, port B
000000r 2               VC_STATUS2          := $9C03             ; Read  status (STATSEL_B selects which), port B
000000r 2               VDP_ID              = $AC                ; STAT4, the identification byte
000000r 2               ; Registers (SPEC §5).  All write-only.
000000r 2               VDP_MODE0           = $00                ; b1 M3
000000r 2               VDP_MODE1           = $01                ; b6 display enable, b5 vblank IRQ enable, b4 M1, b3 M2, b1 sprite size, b0 magnify
000000r 2                                                        ; $02-$06 are legacy aliases of L0NAME, L0ATTR, L0PAT, SPRATTR, SPRPAT
000000r 2               VDP_COLOR           = $07                ; b7:4 default foreground, b3:0 backdrop/border
000000r 2               VDP_VBANK           = $08                ; VRAM address bits 15:14, sampled by an address command
000000r 2               VDP_VINC            = $09                ; VRAM pointer stride, signed (the Kernal assumes +1)
000000r 2               VDP_IRQEN           = $0A                ; b0 vblank, b1 scanline, b2 sprite overflow, b3 collision
000000r 2               VDP_IRQLINE         = $0B                ; Scanline compare value
000000r 2               VDP_PALBASE         = $0C                ; Palette base, x $400 ($3F = $FC00)
000000r 2               VDP_VMODE           = $0D                ; $0 legacy submode, $1 Text, $2 Compact, $3 Graphics, $4 Full
000000r 2               VDP_STATSEL_B       = $0E                ; Status register port B returns
000000r 2               VDP_STATSEL_A       = $0F                ; Status register port A returns
000000r 2               VDP_L0NAME          = $10                ; Layer 0 name table base, x $400
000000r 2               VDP_L0ATTR          = $11                ; Layer 0 attribute table base, x $400
000000r 2               VDP_L0PAT           = $12                ; Layer 0 pattern table base, x $800
000000r 2               VDP_L0SCRX          = $13                ; Layer 0 horizontal scroll, pixels (bit 8 = L0CTRL b6)
000000r 2               VDP_L0SCRY          = $14                ; Layer 0 vertical scroll, pixels
000000r 2               VDP_L0CTRL          = $15                ; b1:0 depth, b3:2 attribute source, b4 enable, b5 index 0 opaque, b6 X bit 8
000000r 2               VDP_L0PAL           = $16                ; Layer 0 palette group high bits
000000r 2               VDP_L1NAME          = $18                ; Layer 1 name table base, x $400
000000r 2               VDP_L1ATTR          = $19                ; Layer 1 attribute table base, x $400
000000r 2               VDP_L1PAT           = $1A                ; Layer 1 pattern table base, x $800
000000r 2               VDP_L1SCRX          = $1B                ; Layer 1 horizontal scroll, pixels (bit 8 = L1CTRL b6)
000000r 2               VDP_L1SCRY          = $1C                ; Layer 1 vertical scroll, pixels
000000r 2               VDP_L1CTRL          = $1D                ; As VDP_L0CTRL
000000r 2               VDP_L1PAL           = $1E                ; Layer 1 palette group high bits
000000r 2               VDP_SPRATTR         = $20                ; Sprite attribute table base, x $80
000000r 2               VDP_SPRPAT          = $21                ; Sprite pattern table base, x $800
000000r 2               VDP_SPRCOUNT        = $22                ; Active sprite slots, 0-64
000000r 2               VDP_SPRCTRL         = $23                ; b0 enable, b1 collision, b2 $D0 terminates, b3 detailed collision, b5:4 depth
000000r 2               VDP_SPRLIMIT        = $24                ; Sprites drawn per scanline, 1-32
000000r 2               VDP_SPRPAL          = $25                ; Sprite palette group high bits
000000r 2               VDP_FONT            = $30                ; Load a built-in font: b7 layer (0 = L0PAT), b6:0 font ID. Every write is a command
000000r 2               ; FONT values (SPEC §7)
000000r 2               VDP_FONT_CP437      = $00                ; Font $00: CP437 6x8, 2,048 bytes; reset puts it at $0800
000000r 2               ; STAT6 capability bits (SPEC §6)
000000r 2               VDP_CAP_LAYERS      = %00000001          ; Two layers
000000r 2               VDP_CAP_8BPP        = %00000010          ; 8bpp layer
000000r 2               VDP_CAP_FLIP        = %00000100          ; Sprite flip
000000r 2               VDP_CAP_SCROLL      = %00001000          ; Hardware scroll
000000r 2               VDP_CAP_SCANIRQ     = %00010000          ; Scanline IRQ
000000r 2               VDP_CAP_64K         = %00100000          ; 64 KB VRAM
000000r 2               VDP_CAP_FONT        = %10000000          ; Built-in font: FONT and font $00 (the Kernal requires it)
000000r 2               
000000r 1               
000000r 1               .segment "KERNAL"
000000r 1               .include "Kernal.asm"
000000r 2               ; =============================================================================
000000r 2               ; KERNAL  —  Hardware Driver Library and Jump Table
000000r 2               ;             for AC6502 Homebrew Computer
000000r 2               ;
000000r 2               ;   ROM Region  :  $A000-$BFFF  (8,192 bytes / $2000)
000000r 2               ;   Segment     :  KERNAL
000000r 2               ;   Entry point :  Chrout  (jump table, first byte of segment = $A000)
000000r 2               ;   Assembler   :  ca65  (cc65 toolchain)
000000r 2               ;   Linker cfg  :  BIOS.cfg
000000r 2               ;
000000r 2               ;   Contents    :  85-slot JMP table ($A000-$A0FF) giving external code and
000000r 2               ;                   cartridges stable entry points, followed by the driver
000000r 2               ;                   implementations for character I/O, the 6502-PICOVDP
000000r 2               ;                   (Text-mode console and the VDP entries), SID sound,
000000r 2               ;                   CompactFlash storage, RTC and NVRAM save slots,
000000r 2               ;                   keyboard/joystick, serial (6551 + XModem), the BRK report,
000000r 2               ;                   and the Reset/NMI/IRQ handlers.  BIOS 2.x: no Monitor, no
000000r 2               ;                   character set (the font comes from the card), no TMS9918A.
000000r 2               ;
000000r 2               ;   Coding style :  Match the rest of the BIOS project.
000000r 2               ;                   * Routine / data labels : PascalCase  (e.g. ChroutDispatch,
000000r 2               ;                     KernalInit, RtcReadTime).
000000r 2               ;                   * Constants / equates    : UPPER_SNAKE_CASE  (e.g. IO_MODE).
000000r 2               ;                   * Local labels           : @camelCase or @PascalCase.
000000r 2               ;                   * Opcodes are lowercase.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; === Kernal Jump Table ($A000-$A0FF) ===
000000r 2               ; 85 slots of 3-byte JMP instructions plus 1 padding byte
000000r 2               ; Provides stable entry points for external code and cartridges
000000r 2               
000000r 2               ; --- Character I/O ---
000000r 2  4C rr rr     Chrout:         jmp ChroutDispatch      ; $A000 - Output char (dispatched by IO_MODE)
000003r 2  4C rr rr     Chrin:          jmp ChrinImpl           ; $A003 - Input char from buffer
000006r 2  4C rr rr     WriteBuffer:    jmp WriteBufferImpl     ; $A006 - Write byte to input buffer
000009r 2  4C rr rr     ReadBuffer:     jmp ReadBufferImpl      ; $A009 - Read byte from input buffer
00000Cr 2  4C rr rr     BufferSize:     jmp BufferSizeImpl      ; $A00C - Get buffer count
00000Fr 2               ; --- IO Mode ---
00000Fr 2  4C rr rr     SetIOMode:      jmp SetIOModeImpl       ; $A00F - Set IO_MODE
000012r 2  4C rr rr     GetIOMode:      jmp GetIOModeImpl       ; $A012 - Get IO_MODE
000015r 2               ; --- Video console (PICOVDP) ---
000015r 2  4C rr rr     InitVideo:      jmp InitVideoImpl       ; $A015 - Text-mode console: registers, the card's font, palette row 0
000018r 2  4C rr rr     VideoClear:     jmp VideoClearImpl      ; $A018 - Clear video screen
00001Br 2  4C rr rr     VideoPutChar:   jmp VideoPutCharImpl    ; $A01B - Write char at cursor
00001Er 2  4C rr rr     VideoSetCursor: jmp VideoSetCursorImpl  ; $A01E - Set cursor (X=col, Y=row)
000021r 2  4C rr rr     VideoGetCursor: jmp VideoGetCursorImpl  ; $A021 - Get cursor position
000024r 2  4C rr rr     VideoScroll:    jmp VideoScrollImpl     ; $A024 - Scroll screen up one line
000027r 2  4C rr rr     VideoSetColor:  jmp VideoSetColorImpl   ; $A027 - Set the pen and the border (A = fg<<4 | bg)
00002Ar 2  4C rr rr     VideoChroutRaw: jmp VideoChroutRawImpl  ; $A02A - Output char to video (raw, no control-code handling)
00002Dr 2               ; --- Sound (SID) ---
00002Dr 2  4C rr rr     InitSID:        jmp InitSIDImpl         ; $A02D - Initialize SID
000030r 2  4C rr rr     Beep:           jmp BeepImpl            ; $A030 - Play beep tone
000033r 2  4C rr rr     SidPlayNote:    jmp SidPlayNoteImpl     ; $A033 - Play note (A=voice, X=freqLo, Y=freqHi)
000036r 2  4C rr rr     SidSilence:     jmp SidSilenceImpl      ; $A036 - Silence all voices
000039r 2  4C rr rr     SidSetVolume:   jmp SidSetVolumeImpl    ; $A039 - Set SID master volume (A=0-15)
00003Cr 2               ; --- Filesystem ---
00003Cr 2  4C rr rr     FsLoadFile:     jmp FsLoadFileImpl      ; $A03C - Load file from CF
00003Fr 2  4C rr rr     FsSaveFile:     jmp FsSaveFileImpl      ; $A03F - Save file to CF
000042r 2  4C rr rr     FsDeleteFile:   jmp FsDeleteFileImpl    ; $A042 - Delete file from CF
000045r 2               ; --- Keyboard / GPIO ---
000045r 2  4C rr rr     InitKB:         jmp InitKBImpl          ; $A045 - Initialize GPIO/VIA keyboard
000048r 2  4C rr rr     ReadJoystick1:  jmp ReadJoystick1Impl   ; $A048 - Read joystick 1
00004Br 2  4C rr rr     ReadJoystick2:  jmp ReadJoystick2Impl   ; $A04B - Read joystick 2
00004Er 2               ; --- Serial (6551) ---
00004Er 2  4C rr rr     InitSC:         jmp InitSCImpl          ; $A04E - Initialize serial 6551
000051r 2  4C rr rr     SerialChrout:   jmp SerialChroutImpl    ; $A051 - Direct serial output (bypass IO_MODE)
000054r 2  4C rr rr     XModemLoad:     jmp XModemLoadImpl      ; $A054 - Receive binary via XModem
000057r 2  4C rr rr     XModemSave:     jmp XModemSaveImpl      ; $A057 - Send binary via XModem
00005Ar 2               ; --- RTC (DS1511Y) ---
00005Ar 2  4C rr rr     RtcReadTime:    jmp RtcReadTimeImpl     ; $A05A - Read RTC time
00005Dr 2  4C rr rr     RtcReadDate:    jmp RtcReadDateImpl     ; $A05D - Read RTC date
000060r 2  4C rr rr     RtcWriteTime:   jmp RtcWriteTimeImpl    ; $A060 - Set RTC time
000063r 2  4C rr rr     RtcWriteDate:   jmp RtcWriteDateImpl    ; $A063 - Set RTC date
000066r 2  4C rr rr     RtcReadNVRAM:   jmp RtcReadNVRAMImpl    ; $A066 - Read NVRAM byte
000069r 2  4C rr rr     RtcWriteNVRAM:  jmp RtcWriteNVRAMImpl   ; $A069 - Write NVRAM byte
00006Cr 2               ; --- CompactFlash Storage ---
00006Cr 2  4C rr rr     StReadSector:   jmp StReadSectorImpl    ; $A06C - Read CF sector
00006Fr 2  4C rr rr     StWriteSector:  jmp StWriteSectorImpl   ; $A06F - Write CF sector
000072r 2  4C rr rr     StWaitReady:    jmp StWaitReadyImpl     ; $A072 - Wait CF ready
000075r 2               ; --- System ---
000075r 2  4C rr rr     SysDelay:       jmp SysDelayImpl        ; $A075 - Delay A=cnt_lo, X=cnt_hi centiseconds
000078r 2  4C rr rr     KernalInit:     jmp KernalInitImpl      ; $A078 - Initialize all hardware (caller must reset SP; no cli); rts when done
00007Br 2  4C rr rr     KernalVersion:  jmp KernalVersionImpl   ; $A07B - Get BIOS version (A=major, X=minor)
00007Er 2               ; --- Disk banking / addressed storage ---
00007Er 2  4C rr rr     FsLoadFileAddr: jmp FsLoadFileAddrImpl  ; $A07E - Load named file to FS_IO_ADDR
000081r 2  4C rr rr     FsSaveFileAddr: jmp FsSaveFileAddrImpl  ; $A081 - Save FS_FILE_SIZE bytes from FS_IO_ADDR to named file
000084r 2  4C rr rr     FsFormatDisk:   jmp FsFormatDiskImpl    ; $A084 - Zero the current disk's directory sector
000087r 2  4C rr rr     FsSetDisk:      jmp FsSetDiskImpl       ; $A087 - Select current CF disk (A=0-255)
00008Ar 2  4C rr rr     FsGetDisk:      jmp FsGetDiskImpl       ; $A08A - Get current CF disk (A=disk)
00008Dr 2  4C rr rr     FsPrintDisk:    jmp FsPrintDiskImpl     ; $A08D - Print "DISK n" + CRLF via Chrout
000090r 2               ; --- General output utilities (console = IO_MODE-routed via Chrout) ---
000090r 2  4C rr rr     PrintStr:       jmp PrintStrImpl        ; $A090 - Print NUL-terminated string (A=lo, Y=hi); clobbers A,Y,STR_PTR
000093r 2  4C rr rr     PrintCRLF:      jmp PrintCRLFImpl       ; $A093 - Print CR+LF
000096r 2  4C rr rr     PrintDecU16:    jmp PrintDecU16Impl     ; $A096 - Print unsigned 16-bit decimal (A=lo, X=hi), no leading zeros
000099r 2               ; --- Keyboard encoder control (raw port access) ---
000099r 2  4C rr rr     KBDisable:      jmp KBDisableImpl       ; $A099 - Release both encoders and settle; ports free for raw read
00009Cr 2  4C rr rr     KBEnable:       jmp KBEnableImpl        ; $A09C - Re-enable both encoders
00009Fr 2               ; --- NVRAM save slots (DS1511Y) ---
00009Fr 2  4C rr rr     NvStat:         jmp NvStatImpl          ; $A09F - Slot status (X=slot) → A=status, Y=owner ID
0000A2r 2  4C rr rr     NvRead:         jmp NvReadImpl          ; $A0A2 - Copy a valid slot's payload (X=slot, A/Y=dest lo/hi)
0000A5r 2  4C rr rr     NvWrite:        jmp NvWriteImpl         ; $A0A5 - Write a slot (X=slot, A/Y=src lo/hi, NV_ID=owner ID)
0000A8r 2  4C rr rr     NvErase:        jmp NvEraseImpl         ; $A0A8 - Zero all 16 bytes of a slot (X=slot)
0000ABr 2  4C rr rr     NvFind:         jmp NvFindImpl          ; $A0AB - Lowest slot owned by A ($00 = first free) → X
0000AEr 2  4C rr rr     NvFormat:       jmp NvFormatImpl        ; $A0AE - Erase all 16 slots
0000B1r 2               
0000B1r 2               ; --- PICOVDP (2.0) ---
0000B1r 2  4C rr rr     VdpInfo:        jmp VdpInfoImpl         ; $A0B1 - Card found at boot → A=VDP_FW, X=VDP_CAPS, Y=$AC; carry set if none
0000B4r 2  4C rr rr     VdpWriteReg:    jmp VdpWriteRegImpl     ; $A0B4 - Write register (A=value, X=0-127), keeping VID_MODE and the LxCTRL shadows
0000B7r 2  4C rr rr     VdpSetMode:     jmp VdpSetModeImpl      ; $A0B7 - Write VMODE (A=1-4); carry set if out of range
0000BAr 2  4C rr rr     VdpPoke:        jmp VdpPokeImpl         ; $A0BA - Write VRAM byte A at X/Y = address lo/hi (all 64 KB)
0000BDr 2  4C rr rr     VdpPeek:        jmp VdpPeekImpl         ; $A0BD - Read VRAM byte at X/Y = address lo/hi → A
0000C0r 2  4C rr rr     VdpSetPalette:  jmp VdpSetPaletteImpl   ; $A0C0 - Palette entry X = 0-255 ← A = $0R, Y = $GB (at $FC00 + 2X)
0000C3r 2  4C rr rr     WaitVBlank:     jmp WaitVBlankImpl      ; $A0C3 - Return at the start of the next vertical blank (STAT0 untouched)
0000C6r 2  4C rr rr     VdpLoadFile:    jmp VdpLoadFileImpl     ; $A0C6 - Load named file (STR_PTR) into VRAM at FS_IO_ADDR, exactly FS_FILE_SIZE bytes
0000C9r 2  4C rr rr     VdpLoadFont:    jmp VdpLoadFontImpl     ; $A0C9 - Copy built-in font A into L0PAT and wait for it
0000CCr 2  4C rr rr     VdpSprite:      jmp VdpSpriteImpl       ; $A0CC - Sprite X = 0-63 ← VDP_P0-P3 = Y, X lo, pattern, attributes (table at $2000)
0000CFr 2  4C rr rr     VdpSetScroll:   jmp VdpSetScrollImpl    ; $A0CF - Layer X = 0-1 scroll: A = x lo, Y = y, VDP_P0 = x bit 8
0000D2r 2  4C rr rr     VdpLayer:       jmp VdpLayerImpl        ; $A0D2 - Layer X = 0-1 off (A = 0) or on
0000D5r 2  4C rr rr     VdpStatus:      jmp VdpStatusImpl       ; $A0D5 - Read status register X = 0-15 on port A → A
0000D8r 2               
0000D8r 2               ; Reserved entries ($A0D8-$A0FE)
0000D8r 2  4C rr rr 4C  .repeat 13
0000DCr 2  rr rr 4C rr  
0000E0r 2  rr 4C rr rr  
0000FFr 2                               jmp UnimplementedStub
0000FFr 2               .endrepeat
0000FFr 2  00           .byte $00                             ; Pad to 256 bytes ($A0FF)
000100r 2               
000100r 2               ; === Kernal Implementation ===
000100r 2               
000100r 2               ; Stub for unimplemented jump table entries
000100r 2               UnimplementedStub:
000100r 2  60             rts
000101r 2               
000101r 2               ; Chrout dispatcher — routes output based on IO_MODE
000101r 2               ; Input: A = character to output
000101r 2               ; Modifies: Flags
000101r 2               ChroutDispatch:
000101r 2  48             pha
000102r 2  AD 06 03       lda IO_MODE
000105r 2  29 01          and #$01                      ; Bit 0: 0=video, 1=serial
000107r 2  D0 04          bne @Serial
000109r 2  68             pla
00010Ar 2  4C rr rr       jmp VideoChroutImpl
00010Dr 2               @Serial:
00010Dr 2  68             pla
00010Er 2  4C rr rr       jmp SerialChroutImpl
000111r 2               
000111r 2               ; Set IO_MODE
000111r 2               ; Input: A = mode (bit 0: 0=video, 1=serial)
000111r 2               SetIOModeImpl:
000111r 2  8D 06 03       sta IO_MODE
000114r 2  60             rts
000115r 2               
000115r 2               ; Get IO_MODE
000115r 2               ; Output: A = current IO_MODE
000115r 2               GetIOModeImpl:
000115r 2  AD 06 03       lda IO_MODE
000118r 2  60             rts
000119r 2               
000119r 2               ; === PICOVDP Video Driver ===
000119r 2               ;
000119r 2               ; The console is Text mode (VMODE $1): 40x24 cells of 6x8, a name table of 960
000119r 2               ; bytes at VRAM $0000 and a per-cell attribute table beside it at $0400, one
000119r 2               ; fg<<4 | bg byte for each cell.  A cell's name byte is at VID_CURSOR_ADDR and
000119r 2               ; its attribute at VID_CURSOR_ADDR | $0400.  Everything here goes through port
000119r 2               ; A and leaves VBANK = 0 and VINC = +1; nothing in the ROM touches port B, which
000119r 2               ; belongs to interrupt handlers (SPEC §4).
000119r 2               
000119r 2               ; VdpSetReg — write a VDP register through port A (no card check)
000119r 2               ; Input: A = value, X = register (0-127)
000119r 2               ; Modifies: Flags, A
000119r 2               VdpSetReg:
000119r 2  8D 01 9C       sta VC_REG                    ; Value
00011Cr 2  8A             txa
00011Dr 2  09 80          ora #$80                      ; Register number with the write flag
00011Fr 2  8D 01 9C       sta VC_REG
000122r 2  60             rts
000123r 2               
000123r 2               ; === PICOVDP entries ($A0B1-$A0D5) ===
000123r 2               ;
000123r 2               ; Each one returns carry set, having written nothing, when no card is fitted
000123r 2               ; (HW_VID clear) or an argument is out of range, and carry clear otherwise.
000123r 2               ; Port A only, and VBANK = 0, VINC = +1 on the way out, like the console.
000123r 2               
000123r 2               ; VdpInfo — What the probe found
000123r 2               ; Output: A = VDP_FW (STAT5), X = VDP_CAPS (STAT6), Y = VDP_ID ($AC); with no
000123r 2               ;         card A = X = Y = 0 and carry set
000123r 2               ; Modifies: Flags, A, X, Y
000123r 2               VdpInfoImpl:
000123r 2  AD 94 03       lda VDP_FW                    ; Both $00 when the probe found no PICOVDP
000126r 2  AE 95 03       ldx VDP_CAPS
000129r 2  A0 00          ldy #$00
00012Br 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
00012Er 2  10 36          bpl VdpNoCard
000130r 2  A0 AC          ldy #VDP_ID
000132r 2  18             clc
000133r 2  60             rts
000134r 2               
000134r 2               ; VdpWriteReg — Write a VDP register, keeping the Kernal's records of it
000134r 2               ; Input: A = value, X = register (0-127)
000134r 2               ; A VMODE write sets VID_MODE: the mode, with b7 (disturbed) set when it takes
000134r 2               ; the card to Text or the legacy submode from anything else, so that only
000134r 2               ; InitVideo can say the Text console is intact.  L0CTRL and L1CTRL, which read
000134r 2               ; back as nothing, are kept in VDP_L0CTRL_SHADOW and VDP_L1CTRL_SHADOW.
000134r 2               ; Output: carry set, and nothing written, if no card or X > 127
000134r 2               ; Preserves: X, Y
000134r 2               ; Modifies: Flags, A
000134r 2               VdpWriteRegImpl:
000134r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
000137r 2  10 2D          bpl VdpNoCard
000139r 2  E0 80          cpx #$80
00013Br 2  B0 29          bcs VdpNoCard
00013Dr 2  E0 0D          cpx #VDP_VMODE
00013Fr 2  D0 12          bne @VdpWriteRegL0
000141r 2  48             pha
000142r 2  29 0F          and #$0F                      ; The mode, b3:0
000144r 2  C9 02          cmp #$02
000146r 2  B0 07          bcs @VdpWriteRegMode          ; Compact, Graphics, Full: the mode itself
000148r 2  CD 93 03       cmp VID_MODE
00014Br 2  F0 02          beq @VdpWriteRegMode          ; Text over the Text console, or legacy over legacy
00014Dr 2  09 80          ora #$80                      ; Anything else back to Text or legacy: disturbed
00014Fr 2               @VdpWriteRegMode:
00014Fr 2  8D 93 03       sta VID_MODE
000152r 2  68             pla
000153r 2               @VdpWriteRegL0:
000153r 2  E0 15          cpx #VDP_L0CTRL
000155r 2  D0 03          bne @VdpWriteRegL1
000157r 2  8D 96 03       sta VDP_L0CTRL_SHADOW
00015Ar 2               @VdpWriteRegL1:
00015Ar 2  E0 1D          cpx #VDP_L1CTRL
00015Cr 2  D0 03          bne @VdpWriteRegSet
00015Er 2  8D 97 03       sta VDP_L1CTRL_SHADOW
000161r 2               @VdpWriteRegSet:
000161r 2  20 rr rr       jsr VdpSetReg
000164r 2  18             clc
000165r 2  60             rts
000166r 2               
000166r 2               ; The shared exit for no card or a bad argument
000166r 2               VdpNoCard:
000166r 2  38             sec
000167r 2  60             rts
000168r 2               
000168r 2               ; VdpSetMode — Set VMODE: 1 Text, 2 Compact, 3 Graphics, 4 Full
000168r 2               ; Only the register (and VID_MODE, as VdpWriteReg keeps it): the tables, layers
000168r 2               ; and sprites are the caller's to lay out.  The Text console proper is
000168r 2               ; InitVideo.
000168r 2               ; Input: A = mode (1-4)
000168r 2               ; Output: carry set, and nothing written, if no card or A is out of range
000168r 2               ; Modifies: Flags, A, X
000168r 2               VdpSetModeImpl:
000168r 2  C9 01          cmp #$01
00016Ar 2  90 FA          bcc VdpNoCard
00016Cr 2  C9 05          cmp #$05
00016Er 2  B0 F6          bcs VdpNoCard
000170r 2  A2 0D          ldx #VDP_VMODE
000172r 2  80 C0          bra VdpWriteRegImpl
000174r 2               
000174r 2               ; VdpPoke — Write one byte anywhere in VRAM
000174r 2               ; Input: A = value, X = address low, Y = address high ($0000-$FFFF)
000174r 2               ; Output: carry set, and nothing written, if no card
000174r 2               ; Modifies: Flags, A, X
000174r 2               VdpPokeImpl:
000174r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
000177r 2  10 ED          bpl VdpNoCard
000179r 2  48             pha
00017Ar 2  A9 40          lda #$40                      ; Write
00017Cr 2  20 rr rr       jsr VdpAddress
00017Fr 2  68             pla
000180r 2  8D 00 9C       sta VC_DATA
000183r 2  18             clc
000184r 2  60             rts
000185r 2               
000185r 2               ; VdpPeek — Read one byte anywhere in VRAM
000185r 2               ; Input: X = address low, Y = address high ($0000-$FFFF)
000185r 2               ; Output: A = the byte; carry set, and nothing read, if no card
000185r 2               ; Modifies: Flags, A, X
000185r 2               VdpPeekImpl:
000185r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
000188r 2  10 DC          bpl VdpNoCard
00018Ar 2  A9 00          lda #$00                      ; Read: the address command prefetches it
00018Cr 2  20 rr rr       jsr VdpAddress
00018Fr 2  AD 00 9C       lda VC_DATA
000192r 2  18             clc
000193r 2  60             rts
000194r 2               
000194r 2               ; VdpSetPalette — Set one palette entry in VRAM, at $FC00 + 2 * entry
000194r 2               ; The card takes the write into its palette at once (SPEC §11).  $FC00 is where
000194r 2               ; InitVideo puts PALBASE; a program that moves PALBASE writes its own.
000194r 2               ; Input: X = entry (0-255), A = $0R, Y = $GB
000194r 2               ; Output: carry set, and nothing written, if no card
000194r 2               ; Modifies: Flags, A, X, Y
000194r 2               VdpSetPaletteImpl:
000194r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
000197r 2  10 CD          bpl VdpNoCard
000199r 2  5A             phy                           ; $GB
00019Ar 2  48             pha                           ; $0R
00019Br 2  8A             txa
00019Cr 2  0A             asl a                         ; 2 * entry: the low byte, and the carry
00019Dr 2  AA             tax                           ;   into the high one
00019Er 2  A9 FC          lda #>$FC00
0001A0r 2  69 00          adc #$00
0001A2r 2  A8             tay
0001A3r 2  A9 40          lda #$40                      ; Write
0001A5r 2  20 rr rr       jsr VdpAddress
0001A8r 2  68             pla
0001A9r 2  8D 00 9C       sta VC_DATA
0001ACr 2  68             pla
0001ADr 2  8D 00 9C       sta VC_DATA
0001B0r 2  18             clc
0001B1r 2  60             rts
0001B2r 2               
0001B2r 2               ; WaitVBlank — Return at the start of the next vertical blank
0001B2r 2               ; Polls STAT3 b0 on port A: waits while the display is in blanking, then until
0001B2r 2               ; it is, and puts STATSEL_A back to 0.  Not STAT0's F: reading STAT0 clears
0001B2r 2               ; F, OVF and COL and the STAT1 latches a program or its interrupt handler may
0001B2r 2               ; be relying on, and this leaves them all as they were.
0001B2r 2               ; No card: waits 2 cs through SysDelay instead, so a loop paced by it still
0001B2r 2               ; runs at about the speed it would, and returns carry set.
0001B2r 2               ; Modifies: Flags, A, X, Y
0001B2r 2               WaitVBlankImpl:
0001B2r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
0001B5r 2  30 09          bmi @WaitVBlankCard
0001B7r 2  A9 02          lda #2
0001B9r 2  A2 00          ldx #0
0001BBr 2  20 rr rr       jsr SysDelay
0001BEr 2  38             sec
0001BFr 2  60             rts
0001C0r 2               @WaitVBlankCard:
0001C0r 2  A9 03          lda #$03
0001C2r 2  20 rr rr       jsr VdpSelectStat             ; STAT3
0001C5r 2               @WaitVBlankOut:
0001C5r 2  AD 01 9C       lda VC_STATUS
0001C8r 2  4A             lsr a                         ; b0, vertical blanking, into carry
0001C9r 2  B0 FA          bcs @WaitVBlankOut            ; Still in the last one
0001CBr 2               @WaitVBlankIn:
0001CBr 2  AD 01 9C       lda VC_STATUS
0001CEr 2  4A             lsr a
0001CFr 2  90 FA          bcc @WaitVBlankIn             ; Not yet in the next
0001D1r 2  A9 00          lda #$00
0001D3r 2  20 rr rr       jsr VdpSelectStat             ; STATSEL_A back to STAT0, without reading it
0001D6r 2  18             clc
0001D7r 2  60             rts
0001D8r 2               
0001D8r 2               ; VdpLoadFont — Load one of the card's built-in fonts into layer 0's pattern table
0001D8r 2               ; Writes the font ID to FONT (SPEC §7), which copies it to L0PAT x $800 as that
0001D8r 2               ; register stands at the write, and waits for the copy: a pending load lands at
0001D8r 2               ; the line start where vertical blank begins, before STAT3 b0 sets, so
0001D8r 2               ; WaitVBlank returning is the completion.  STAT0 is not read.  The only font
0001D8r 2               ; STAT6 b7 promises is $00 (VDP_FONT_CP437), so any other ID is refused rather
0001D8r 2               ; than written as a command that would do nothing.
0001D8r 2               ; Input: A = font ID
0001D8r 2               ; Output: carry set, and nothing written, if no card or A is not $00
0001D8r 2               ; Modifies: Flags, A, X, Y
0001D8r 2               VdpLoadFontImpl:
0001D8r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
0001DBr 2  10 89          bpl VdpNoCard
0001DDr 2  C9 01          cmp #VDP_FONT_CP437 + 1
0001DFr 2  B0 85          bcs VdpNoCard
0001E1r 2  A2 30          ldx #VDP_FONT                 ; b7 clear: layer 0
0001E3r 2  20 rr rr       jsr VdpSetReg
0001E6r 2  4C rr rr       jmp WaitVBlankImpl            ; Carry clear: there is a card
0001E9r 2               
0001E9r 2               ; VdpSprite — Write one sprite's four attribute bytes
0001E9r 2               ; The attribute table is taken to be at VRAM $2000 (SPRATTR = $40), where
0001E9r 2               ; BASIC's SCREEN 1-3 puts it; a program that moves SPRATTR writes its sprites
0001E9r 2               ; with VdpPoke.  Sets VID_MODE b7 (disturbed).
0001E9r 2               ; Input: X = sprite (0-63), VDP_P0 = Y, VDP_P1 = X bits 7:0, VDP_P2 = pattern,
0001E9r 2               ;        VDP_P3 = attributes (b7 = X bit 8, b6 priority, b5:4 flips, b3:0
0001E9r 2               ;        sub-palette; SPEC §10)
0001E9r 2               ; Output: carry set, and nothing written, if no card or X > 63
0001E9r 2               ; Preserves: X
0001E9r 2               ; Modifies: Flags, A, Y
0001E9r 2               VdpSpriteImpl:
0001E9r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
0001ECr 2  10 20          bpl @VdpSpriteNone
0001EEr 2  E0 40          cpx #64
0001F0r 2  B0 1C          bcs @VdpSpriteNone
0001F2r 2  DA             phx
0001F3r 2  8A             txa
0001F4r 2  0A             asl a                         ; 4 bytes a sprite: at most 252
0001F5r 2  0A             asl a
0001F6r 2  AA             tax
0001F7r 2  A0 20          ldy #>$2000
0001F9r 2  A9 40          lda #$40                      ; Write
0001FBr 2  20 rr rr       jsr VdpAddress
0001FEr 2  A2 00          ldx #$00
000200r 2               @VdpSpriteByte:
000200r 2  BD 98 03       lda VDP_P0,x
000203r 2  8D 00 9C       sta VC_DATA
000206r 2  E8             inx
000207r 2  E0 04          cpx #4
000209r 2  D0 F5          bne @VdpSpriteByte
00020Br 2  FA             plx
00020Cr 2  80 41          bra VdpDisturbed
00020Er 2               @VdpSpriteNone:
00020Er 2  38             sec
00020Fr 2  60             rts
000210r 2               
000210r 2               ; VdpSetScroll — Scroll a layer
000210r 2               ; Writes LxSCRX, LxSCRY, and LxCTRL with b6 = X bit 8 and its other bits from
000210r 2               ; the shadow.  Sets VID_MODE b7 (disturbed).
000210r 2               ; Input: X = layer (0-1), A = x bits 7:0, Y = y, VDP_P0 = x bit 8 (0 or not)
000210r 2               ; Output: carry set, and nothing written, if no card or X > 1
000210r 2               ; Modifies: Flags, A, X
000210r 2               VdpSetScrollImpl:
000210r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
000213r 2  10 44          bpl VdpLayerNone
000215r 2  E0 02          cpx #2
000217r 2  B0 40          bcs VdpLayerNone
000219r 2  5A             phy                           ; y
00021Ar 2  48             pha                           ; x
00021Br 2  BD 96 03       lda VDP_L0CTRL_SHADOW,x
00021Er 2  29 BF          and #<~$40
000220r 2  AC 98 03       ldy VDP_P0
000223r 2  F0 02          beq @VdpSetScrollCtrl
000225r 2  09 40          ora #$40                      ; X bit 8
000227r 2               @VdpSetScrollCtrl:
000227r 2  20 rr rr       jsr VdpWriteLayerCtrl         ; X = LxCTRL
00022Ar 2  CA             dex                           ; LxSCRX
00022Br 2  CA             dex
00022Cr 2  68             pla
00022Dr 2  20 rr rr       jsr VdpWriteRegImpl
000230r 2  E8             inx                           ; LxSCRY
000231r 2  68             pla
000232r 2  20 rr rr       jsr VdpWriteRegImpl
000235r 2  80 18          bra VdpDisturbed
000237r 2               
000237r 2               ; VdpLayer — Show or hide a layer
000237r 2               ; Sets or clears LxCTRL b4, keeping its other bits from the shadow.  Sets
000237r 2               ; VID_MODE b7 (disturbed).
000237r 2               ; Input: X = layer (0-1), A = 0 to hide, anything else to show
000237r 2               ; Output: carry set, and nothing written, if no card or X > 1
000237r 2               ; Modifies: Flags, A, X
000237r 2               VdpLayerImpl:
000237r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
00023Ar 2  10 1D          bpl VdpLayerNone
00023Cr 2  E0 02          cpx #2
00023Er 2  B0 19          bcs VdpLayerNone
000240r 2  A8             tay                           ; Sets Z from A
000241r 2  BD 96 03       lda VDP_L0CTRL_SHADOW,x
000244r 2  29 EF          and #<~$10
000246r 2  C0 00          cpy #$00
000248r 2  F0 02          beq @VdpLayerOff
00024Ar 2  09 10          ora #$10                      ; Enable
00024Cr 2               @VdpLayerOff:
00024Cr 2  20 rr rr       jsr VdpWriteLayerCtrl
00024Fr 2               VdpDisturbed:                   ; VID_MODE b7: sprites, scroll or layers moved
00024Fr 2  AD 93 03       lda VID_MODE
000252r 2  09 80          ora #$80
000254r 2  8D 93 03       sta VID_MODE
000257r 2  18             clc
000258r 2  60             rts
000259r 2               VdpLayerNone:
000259r 2  38             sec
00025Ar 2  60             rts
00025Br 2               
00025Br 2               ; VdpWriteLayerCtrl — LxCTRL = A for layer X (0-1) through VdpWriteReg, so the
00025Br 2               ; shadow follows (no checks)
00025Br 2               ; Output: X = the register, $15 or $1D
00025Br 2               ; Modifies: Flags, A, X
00025Br 2               VdpWriteLayerCtrl:
00025Br 2  48             pha
00025Cr 2  8A             txa
00025Dr 2  0A             asl a                         ; 0 or 8, carry clear
00025Er 2  0A             asl a
00025Fr 2  0A             asl a
000260r 2  69 15          adc #VDP_L0CTRL
000262r 2  AA             tax
000263r 2  68             pla
000264r 2  4C rr rr       jmp VdpWriteRegImpl
000267r 2               
000267r 2               ; VdpStatus — Read a status register through port A
000267r 2               ; Selects STATn with STATSEL_A, reads it, and puts STATSEL_A back to 0 without
000267r 2               ; reading STAT0.  Reading STAT0 itself clears its flags, and STAT1 its
000267r 2               ; latches, as SPEC §6 says.
000267r 2               ; Input: X = status register (0-15)
000267r 2               ; Output: A = its value; carry set, and nothing read, if no card or X > 15
000267r 2               ; Preserves: X, Y
000267r 2               ; Modifies: Flags, A
000267r 2               VdpStatusImpl:
000267r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
00026Ar 2  10 ED          bpl VdpLayerNone
00026Cr 2  E0 10          cpx #16
00026Er 2  B0 E9          bcs VdpLayerNone
000270r 2  8A             txa
000271r 2  20 rr rr       jsr VdpReadStat
000274r 2  18             clc
000275r 2  60             rts
000276r 2               
000276r 2               ; VdpAddress — Point port A at any VRAM address (no card check)
000276r 2               ; VBANK = the address's bits 15:14 for the address command, then back to 0:
000276r 2               ; the card samples it there, and the pointer carries across banks by itself.
000276r 2               ; Input: A = $40 to write or $00 to read, X = address low, Y = address high
000276r 2               ; Modifies: Flags, A, X
000276r 2               VdpAddress:
000276r 2  48             pha                           ; Write or read
000277r 2  98             tya
000278r 2  0A             asl a                         ; Bits 15:14 down to 1:0
000279r 2  2A             rol a
00027Ar 2  2A             rol a
00027Br 2  29 03          and #$03
00027Dr 2  DA             phx
00027Er 2  A2 08          ldx #VDP_VBANK
000280r 2  20 rr rr       jsr VdpSetReg
000283r 2  68             pla
000284r 2  8D 01 9C       sta VC_REG                    ; Address low
000287r 2  98             tya
000288r 2  29 3F          and #$3F
00028Ar 2  BA             tsx
00028Br 2  1D 01 01       ora $0101,x                   ; With the write bit
00028Er 2  8D 01 9C       sta VC_REG
000291r 2  68             pla
000292r 2  A9 00          lda #$00
000294r 2  A2 08          ldx #VDP_VBANK
000296r 2  4C rr rr       jmp VdpSetReg
000299r 2               
000299r 2               ; VdpReadStat — A = STATn for n in A, leaving STATSEL_A = 0 (no card check)
000299r 2               ; Modifies: Flags, A
000299r 2               VdpReadStat:
000299r 2  20 rr rr       jsr VdpSelectStat
00029Cr 2  AD 01 9C       lda VC_STATUS
00029Fr 2  48             pha
0002A0r 2  A9 00          lda #$00                      ; STATSEL_A back to STAT0, without reading it
0002A2r 2  20 rr rr       jsr VdpSelectStat
0002A5r 2  68             pla
0002A6r 2  60             rts
0002A7r 2               
0002A7r 2               ; VdpSelectStat — STATSEL_A = A (no card check)
0002A7r 2               ; Modifies: Flags, A
0002A7r 2               VdpSelectStat:
0002A7r 2  8D 01 9C       sta VC_REG
0002AAr 2  A9 8F          lda #($80 | VDP_STATSEL_A)
0002ACr 2  8D 01 9C       sta VC_REG
0002AFr 2  60             rts
0002B0r 2               
0002B0r 2               ; VideoClear — Fill the screen with spaces in the current pen, cursor home
0002B0r 2               ; Fills the 960-byte name table at VRAM $0000 with $20 and the 960 attributes at
0002B0r 2               ; $0400 with VID_PEN, so COLOR fg,bg : CLS gives a screen of that colour, and
0002B0r 2               ; takes the scroll origin back to row 0.
0002B0r 2               ; Skips silently if no video card is fitted
0002B0r 2               ; Modifies: Flags, A, X, Y
0002B0r 2               VideoClearImpl:
0002B0r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7, so BIT tests it in N without
0002B3r 2  30 01          bmi @VideoClearFitted         ;   disturbing A — these routines take their
0002B5r 2  60             rts                           ;   argument there.  See the note above
0002B6r 2                                               ;   HW_PRESENT's bit definitions in BIOS.inc.
0002B6r 2               @VideoClearFitted:
0002B6r 2  AD 93 03       lda VID_MODE                  ; First use since KernalInit: bring the console
0002B9r 2  D0 03          bne VideoClearNow             ;   up, and then this is the clear it needs
0002BBr 2  20 rr rr       jsr InitVideoImpl
0002BEr 2               VideoClearNow:
0002BEr 2  A9 40          lda #$40                      ; Name table, $0000, write
0002C0r 2  A2 20          ldx #$20
0002C2r 2  20 rr rr       jsr @Fill
0002C5r 2  A9 44          lda #$44                      ; Attribute table, $0400, write
0002C7r 2  AE 91 03       ldx VID_PEN
0002CAr 2  20 rr rr       jsr @Fill
0002CDr 2  9C 92 03       stz VID_TOP                   ; Unscrolled
0002D0r 2  A9 00          lda #$00
0002D2r 2  A2 14          ldx #VDP_L0SCRY
0002D4r 2  20 rr rr       jsr VdpSetReg
0002D7r 2                 ; Reset cursor to (0,0)
0002D7r 2  9C 07 03       stz VID_CURSOR_X
0002DAr 2  9C 08 03       stz VID_CURSOR_Y
0002DDr 2  9C 09 03       stz VID_CURSOR_ADDR
0002E0r 2  9C 0A 03       stz VID_CURSOR_ADDR + 1
0002E3r 2  60             rts
0002E4r 2               @Fill:                          ; A = address command high byte, X = fill value
0002E4r 2  9C 01 9C       stz VC_REG                    ; Low byte of the address
0002E7r 2  8D 01 9C       sta VC_REG
0002EAr 2  8A             txa
0002EBr 2  A0 00          ldy #$00
0002EDr 2  A2 03          ldx #$03                      ; 3 full pages (768 bytes)
0002EFr 2               @VideoClearPage:
0002EFr 2  8D 00 9C       sta VC_DATA
0002F2r 2  C8             iny
0002F3r 2  D0 FA          bne @VideoClearPage
0002F5r 2  CA             dex
0002F6r 2  D0 F7          bne @VideoClearPage
0002F8r 2  A0 C0          ldy #192                      ; Remaining 192 bytes (960 - 768)
0002FAr 2               @VideoClearRem:
0002FAr 2  8D 00 9C       sta VC_DATA
0002FDr 2  88             dey
0002FEr 2  D0 FA          bne @VideoClearRem
000300r 2  60             rts
000301r 2               
000301r 2               ; VideoSetCursor — Set cursor position
000301r 2               ; Input: X = column (0-39), Y = row (0-23), on the screen as shown
000301r 2               ; VID_CURSOR_ADDR = ((Y + VID_TOP) mod 24) * 40 + X, the cell's place in the
000301r 2               ; name table once the scroll origin is folded in
000301r 2               ; Skips silently if no video card is fitted
000301r 2               ; Modifies: Flags, A
000301r 2               VideoSetCursorImpl:
000301r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
000304r 2  10 23          bpl @VideoSetCursorNone
000306r 2  20 rr rr       jsr VideoConsoleReady
000309r 2  8E 07 03       stx VID_CURSOR_X
00030Cr 2  8C 08 03       sty VID_CURSOR_Y
00030Fr 2  98             tya                           ; Screen row to name-table row:
000310r 2  18             clc                           ;   (row + VID_TOP) mod 24
000311r 2  6D 92 03       adc VID_TOP
000314r 2  C9 18          cmp #24
000316r 2  90 02          bcc @VideoSetCursorRow
000318r 2  E9 18          sbc #24                       ; Carry is set
00031Ar 2               @VideoSetCursorRow:
00031Ar 2  20 rr rr       jsr VideoRowAddr              ; VID_CURSOR_ADDR = row * 40, carry clear
00031Dr 2  8A             txa                           ; Add the column
00031Er 2  6D 09 03       adc VID_CURSOR_ADDR
000321r 2  8D 09 03       sta VID_CURSOR_ADDR
000324r 2  90 03          bcc @VideoSetCursorNone
000326r 2  EE 0A 03       inc VID_CURSOR_ADDR + 1
000329r 2               @VideoSetCursorNone:
000329r 2  60             rts
00032Ar 2               
00032Ar 2               ; VideoConsoleReady — Bring the Text console up on its first use
00032Ar 2               ; KernalInit leaves the card in the legacy submode it resets to (VID_MODE = $00),
00032Ar 2               ; so that a cartridge programming M1/M2/M3 itself sees what it saw on 1.x.  The
00032Ar 2               ; console entries call this first: if the card is fitted and VID_MODE is still
00032Ar 2               ; $00, InitVideo + VideoClear.  Only $00 triggers it, so a program that switched
00032Ar 2               ; to another mode and then prints is not reset behind its back.
00032Ar 2               ; Preserves: A, X, Y
00032Ar 2               ; Modifies: Flags
00032Ar 2               VideoConsoleReady:
00032Ar 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
00032Dr 2  10 11          bpl @VideoConsoleNone
00032Fr 2  48             pha
000330r 2  AD 93 03       lda VID_MODE
000333r 2  D0 0A          bne @VideoConsoleUp
000335r 2  DA             phx
000336r 2  5A             phy
000337r 2  20 rr rr       jsr InitVideoImpl             ; Sets VID_MODE = $01, so no recursion
00033Ar 2  20 rr rr       jsr VideoClearNow
00033Dr 2  7A             ply
00033Er 2  FA             plx
00033Fr 2               @VideoConsoleUp:
00033Fr 2  68             pla
000340r 2               @VideoConsoleNone:
000340r 2  60             rts
000341r 2               
000341r 2               ; VideoRowAddr — VID_CURSOR_ADDR = A * 40, for a name-table row 0-23
000341r 2               ; Output: carry clear
000341r 2               ; Modifies: Flags, A
000341r 2               VideoRowAddr:
000341r 2  9C 0A 03       stz VID_CURSOR_ADDR + 1
000344r 2  0A             asl a                         ; x8 fits in a byte (23 * 8 = 184)
000345r 2  0A             asl a
000346r 2  0A             asl a
000347r 2  8D 09 03       sta VID_CURSOR_ADDR
00034Ar 2  0A             asl a                         ; x32 does not: carry into the high byte
00034Br 2  2E 0A 03       rol VID_CURSOR_ADDR + 1
00034Er 2  0A             asl a
00034Fr 2  2E 0A 03       rol VID_CURSOR_ADDR + 1       ; Leaves carry clear (the high byte's b7 was 0)
000352r 2  6D 09 03       adc VID_CURSOR_ADDR           ; x32 + x8
000355r 2  8D 09 03       sta VID_CURSOR_ADDR
000358r 2  90 04          bcc @VideoRowAddrDone
00035Ar 2  EE 0A 03       inc VID_CURSOR_ADDR + 1
00035Dr 2  18             clc
00035Er 2               @VideoRowAddrDone:
00035Er 2  60             rts
00035Fr 2               
00035Fr 2               ; VideoGetCursor — Get cursor position
00035Fr 2               ; Output: X = column (0-39), Y = row (0-23)
00035Fr 2               ; Modifies: Flags
00035Fr 2               VideoGetCursorImpl:
00035Fr 2  20 rr rr       jsr VideoConsoleReady
000362r 2  AE 07 03       ldx VID_CURSOR_X
000365r 2  AC 08 03       ldy VID_CURSOR_Y
000368r 2  60             rts
000369r 2               
000369r 2               ; VideoPutChar — Write a character at VID_CURSOR_ADDR, coloured with VID_PEN
000369r 2               ; Input: A = character to write
000369r 2               ; Modifies: Flags
000369r 2               VideoPutCharImpl:
000369r 2  48             pha
00036Ar 2  AD 09 03       lda VID_CURSOR_ADDR           ; Name byte
00036Dr 2  8D 01 9C       sta VC_REG
000370r 2  AD 0A 03       lda VID_CURSOR_ADDR + 1
000373r 2  09 40          ora #$40                      ; Write mode
000375r 2  8D 01 9C       sta VC_REG
000378r 2  68             pla
000379r 2  8D 00 9C       sta VC_DATA
00037Cr 2  48             pha
00037Dr 2  AD 09 03       lda VID_CURSOR_ADDR           ; Attribute byte, $0400 further on
000380r 2  8D 01 9C       sta VC_REG
000383r 2  AD 0A 03       lda VID_CURSOR_ADDR + 1
000386r 2  09 44          ora #$44                      ; Write mode, + $0400
000388r 2  8D 01 9C       sta VC_REG
00038Br 2  AD 91 03       lda VID_PEN
00038Er 2  8D 00 9C       sta VC_DATA
000391r 2  68             pla
000392r 2  60             rts
000393r 2               
000393r 2               ; VideoScroll — Scroll the screen up one line, in hardware
000393r 2               ; Moves the display origin down a row (VID_TOP, and L0SCRY = VID_TOP * 8) and
000393r 2               ; blanks the row that was at the top, which is now the bottom line, in the
000393r 2               ; current pen.  The name table does not move.  The cursor keeps its screen
000393r 2               ; position, so its VRAM address is worked out again.
000393r 2               ; Skips silently if no video card is fitted
000393r 2               ; Modifies: Flags, A, X, Y
000393r 2               VideoScrollImpl:
000393r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
000396r 2  10 32          bpl @VideoScrollNone
000398r 2  AD 92 03       lda VID_TOP
00039Br 2  48             pha                           ; The row leaving the top
00039Cr 2  1A             inc a
00039Dr 2  C9 18          cmp #24
00039Fr 2  90 02          bcc @VideoScrollTop
0003A1r 2  A9 00          lda #$00
0003A3r 2               @VideoScrollTop:
0003A3r 2  8D 92 03       sta VID_TOP
0003A6r 2  0A             asl a                         ; x8 pixels (at most 184)
0003A7r 2  0A             asl a
0003A8r 2  0A             asl a
0003A9r 2  A2 14          ldx #VDP_L0SCRY
0003ABr 2  20 rr rr       jsr VdpSetReg
0003AEr 2  68             pla
0003AFr 2  20 rr rr       jsr VideoRowAddr              ; VID_CURSOR_ADDR = that row * 40
0003B2r 2  A9 40          lda #$40                      ; Its names, write mode
0003B4r 2  A2 20          ldx #$20
0003B6r 2  20 rr rr       jsr @VideoScrollRow
0003B9r 2  A9 44          lda #$44                      ; Its attributes, write mode, + $0400
0003BBr 2  AE 91 03       ldx VID_PEN
0003BEr 2  20 rr rr       jsr @VideoScrollRow
0003C1r 2  AE 07 03       ldx VID_CURSOR_X              ; Put the cursor back on its screen cell
0003C4r 2  AC 08 03       ldy VID_CURSOR_Y
0003C7r 2  4C rr rr       jmp VideoSetCursorImpl
0003CAr 2               @VideoScrollNone:
0003CAr 2  60             rts
0003CBr 2               @VideoScrollRow:                ; A = address high bits, X = fill value
0003CBr 2  0D 0A 03       ora VID_CURSOR_ADDR + 1
0003CEr 2  AC 09 03       ldy VID_CURSOR_ADDR
0003D1r 2  8C 01 9C       sty VC_REG
0003D4r 2  8D 01 9C       sta VC_REG
0003D7r 2  8A             txa
0003D8r 2  A0 28          ldy #40
0003DAr 2               @VideoScrollFill:
0003DAr 2  8D 00 9C       sta VC_DATA
0003DDr 2  88             dey
0003DEr 2  D0 FA          bne @VideoScrollFill
0003E0r 2  60             rts
0003E1r 2               
0003E1r 2               ; VideoChrout — Output character to video display
0003E1r 2               ; Handles control characters: CR ($0D), LF ($0A), BS ($08), BEL ($07)
0003E1r 2               ; Printable ASCII ($20-$7E) written to VRAM; all other codes silently discarded
0003E1r 2               ; Auto-wraps at column 40, auto-scrolls at row 24
0003E1r 2               ; Input: A = character to output
0003E1r 2               ; Preserves: A, X, Y (callers like ChrinImpl, BasPrintStr and Wozmon depend on this)
0003E1r 2               ; Modifies: Flags
0003E1r 2               VideoChroutImpl:
0003E1r 2  20 rr rr       jsr VideoConsoleReady
0003E4r 2  48             pha
0003E5r 2  DA             phx
0003E6r 2  5A             phy
0003E7r 2                 ; Fast path: printable ASCII ($20-$7E) — most common case
0003E7r 2  C9 20          cmp #$20
0003E9r 2  90 06          bcc @Control                  ; < $20 → check control codes
0003EBr 2  C9 7F          cmp #$7F
0003EDr 2  90 14          bcc @PrintChar                ; $20-$7E → printable character
0003EFr 2                 ; >= $7F (DEL and above) — discard
0003EFr 2                 ; User programs wanting raw glyph output should use VideoChroutRaw.
0003EFr 2  80 45          bra @VideoChroutDone
0003F1r 2               @Control:
0003F1r 2  C9 0D          cmp #$0D                      ; Carriage Return?
0003F3r 2  F0 45          beq @VideoCR
0003F5r 2  C9 0A          cmp #$0A                      ; Line Feed?
0003F7r 2  F0 4E          beq @VideoLF
0003F9r 2  C9 08          cmp #$08                      ; Backspace?
0003FBr 2  F0 67          beq @VideoBS
0003FDr 2  C9 07          cmp #$07                      ; Bell?
0003FFr 2  F0 7B          beq @VideoBEL
000401r 2                 ; Unrecognized control code — discard
000401r 2  80 33          bra @VideoChroutDone
000403r 2               @PrintChar:
000403r 2                 ; Regular printable character — write at cursor and advance
000403r 2  20 rr rr       jsr VideoPutChar              ; Write char to VRAM at cursor
000406r 2                 ; Advance cursor
000406r 2  EE 07 03       inc VID_CURSOR_X
000409r 2                 ; Increment VRAM address
000409r 2  EE 09 03       inc VID_CURSOR_ADDR
00040Cr 2  D0 03          bne @CheckWrap
00040Er 2  EE 0A 03       inc VID_CURSOR_ADDR + 1
000411r 2               @CheckWrap:
000411r 2  AD 07 03       lda VID_CURSOR_X
000414r 2  C9 28          cmp #40                       ; Past last column?
000416r 2  90 1E          bcc @VideoChroutDone          ; No, done
000418r 2                 ; Auto-wrap: CR + LF
000418r 2  9C 07 03       stz VID_CURSOR_X
00041Br 2  EE 08 03       inc VID_CURSOR_Y
00041Er 2  AD 08 03       lda VID_CURSOR_Y
000421r 2  C9 18          cmp #24                       ; Past last row?
000423r 2  90 08          bcc @WrapRecalc
000425r 2                 ; Need to scroll
000425r 2  20 rr rr       jsr VideoScroll
000428r 2  A9 17          lda #23
00042Ar 2  8D 08 03       sta VID_CURSOR_Y
00042Dr 2               @WrapRecalc:
00042Dr 2  AE 07 03       ldx VID_CURSOR_X
000430r 2  AC 08 03       ldy VID_CURSOR_Y
000433r 2  20 rr rr       jsr VideoSetCursor            ; Recalculate VRAM address
000436r 2               @VideoChroutDone:
000436r 2  7A             ply
000437r 2  FA             plx
000438r 2  68             pla
000439r 2  60             rts
00043Ar 2               
00043Ar 2               @VideoCR:
00043Ar 2  9C 07 03       stz VID_CURSOR_X              ; Column = 0
00043Dr 2  A2 00          ldx #$00
00043Fr 2  AC 08 03       ldy VID_CURSOR_Y
000442r 2  20 rr rr       jsr VideoSetCursor            ; Recalculate VRAM address
000445r 2  80 EF          bra @VideoChroutDone
000447r 2               
000447r 2               @VideoLF:
000447r 2  EE 08 03       inc VID_CURSOR_Y
00044Ar 2  AD 08 03       lda VID_CURSOR_Y
00044Dr 2  C9 18          cmp #24                       ; Past last row?
00044Fr 2  90 08          bcc @LFRecalc
000451r 2  20 rr rr       jsr VideoScroll
000454r 2  A9 17          lda #23
000456r 2  8D 08 03       sta VID_CURSOR_Y
000459r 2               @LFRecalc:
000459r 2  AE 07 03       ldx VID_CURSOR_X
00045Cr 2  AC 08 03       ldy VID_CURSOR_Y
00045Fr 2  20 rr rr       jsr VideoSetCursor
000462r 2  80 D2          bra @VideoChroutDone
000464r 2               
000464r 2               @VideoBS:
000464r 2  AD 07 03       lda VID_CURSOR_X
000467r 2  F0 CD          beq @VideoChroutDone          ; Already at column 0, ignore
000469r 2  CE 07 03       dec VID_CURSOR_X
00046Cr 2  AE 07 03       ldx VID_CURSOR_X
00046Fr 2  AC 08 03       ldy VID_CURSOR_Y
000472r 2  20 rr rr       jsr VideoSetCursor            ; Recalculate VRAM address
000475r 2  A9 20          lda #$20                      ; Write space to erase character
000477r 2  20 rr rr       jsr VideoPutChar
00047Ar 2  80 BA          bra @VideoChroutDone
00047Cr 2               
00047Cr 2               @VideoBEL:
00047Cr 2  20 rr rr       jsr Beep
00047Fr 2  80 B5          bra @VideoChroutDone
000481r 2               
000481r 2               ; VideoChroutRaw — Output character to video (raw, no control-code handling)
000481r 2               ; Always writes the character glyph at the cursor position and advances.
000481r 2               ; Input: A = character code (0-255)
000481r 2               ; Preserves: A, X, Y
000481r 2               ; Modifies: Flags
000481r 2               VideoChroutRawImpl:
000481r 2  20 rr rr       jsr VideoConsoleReady
000484r 2  48             pha
000485r 2  DA             phx
000486r 2  5A             phy
000487r 2  20 rr rr       jsr VideoPutChar              ; Write char to VRAM at cursor
00048Ar 2  EE 07 03       inc VID_CURSOR_X
00048Dr 2  EE 09 03       inc VID_CURSOR_ADDR
000490r 2  D0 03          bne @RawCheckWrap
000492r 2  EE 0A 03       inc VID_CURSOR_ADDR + 1
000495r 2               @RawCheckWrap:
000495r 2  AD 07 03       lda VID_CURSOR_X
000498r 2  C9 28          cmp #40                       ; Past last column?
00049Ar 2  90 1E          bcc @RawDone
00049Cr 2  9C 07 03       stz VID_CURSOR_X
00049Fr 2  EE 08 03       inc VID_CURSOR_Y
0004A2r 2  AD 08 03       lda VID_CURSOR_Y
0004A5r 2  C9 18          cmp #24                       ; Past last row?
0004A7r 2  90 08          bcc @RawRecalc
0004A9r 2  20 rr rr       jsr VideoScroll
0004ACr 2  A9 17          lda #23
0004AEr 2  8D 08 03       sta VID_CURSOR_Y
0004B1r 2               @RawRecalc:
0004B1r 2  AE 07 03       ldx VID_CURSOR_X
0004B4r 2  AC 08 03       ldy VID_CURSOR_Y
0004B7r 2  20 rr rr       jsr VideoSetCursor
0004BAr 2               @RawDone:
0004BAr 2  7A             ply
0004BBr 2  FA             plx
0004BCr 2  68             pla
0004BDr 2  60             rts
0004BEr 2               
0004BEr 2               ; PrintStr — Print a NUL-terminated string to the console (routed by IO_MODE
0004BEr 2               ; through Chrout, so it works for video OR serial).  General-purpose; used by
0004BEr 2               ; BASIC (via the BasPrintStr alias) and available to cartridges.
0004BEr 2               ; Input : A = string address low, Y = string address high
0004BEr 2               ; Output: A, Y clobbered; X preserved; clobbers STR_PTR (Chrout preserves it)
0004BEr 2               PrintStrImpl:
0004BEr 2  85 02          sta STR_PTR
0004C0r 2  84 03          sty STR_PTR + 1
0004C2r 2  A0 00          ldy #$00
0004C4r 2               @PrintStrLoop:
0004C4r 2  B1 02          lda (STR_PTR),y
0004C6r 2  F0 06          beq @PrintStrDone             ; NUL terminator
0004C8r 2  20 rr rr       jsr Chrout
0004CBr 2  C8             iny
0004CCr 2  D0 F6          bne @PrintStrLoop             ; Max 256 chars per call
0004CEr 2               @PrintStrDone:
0004CEr 2  60             rts
0004CFr 2               
0004CFr 2               ; PrintCRLF — Emit CR ($0D) then LF ($0A) via Chrout.
0004CFr 2               PrintCRLFImpl:
0004CFr 2  A9 0D          lda #$0D
0004D1r 2  20 rr rr       jsr Chrout
0004D4r 2  A9 0A          lda #$0A
0004D6r 2  4C rr rr       jmp Chrout
0004D9r 2               
0004D9r 2               ; KernalInit — Initialize RAM variables, probe & init all hardware
0004D9r 2               ; Sets HW_PRESENT, IO_MODE, IRQ/BRK/NMI pointers, BOOT_VECTOR=0
0004D9r 2               ; Does NOT enable interrupts (caller must cli)
0004D9r 2               ; Does NOT reset the stack pointer (caller should do this before JSR)
0004D9r 2               ; Does NOT print anything or start BASIC
0004D9r 2               ; Modifies: All registers, flags
0004D9r 2               KernalInitImpl:
0004D9r 2  D8             cld                           ; Clear decimal mode
0004DAr 2  78             sei                           ; Disable interrupts
0004DBr 2               
0004DBr 2  A9 rr          lda #<Irq                     ; Initialize the IRQ pointer
0004DDr 2  8D 00 03       sta IRQ_PTR
0004E0r 2  A9 rr          lda #>Irq
0004E2r 2  8D 01 03       sta IRQ_PTR + 1
0004E5r 2               
0004E5r 2  A9 rr          lda #<Break                   ; Initialize the BRK pointer
0004E7r 2  8D 02 03       sta BRK_PTR
0004EAr 2  A9 rr          lda #>Break
0004ECr 2  8D 03 03       sta BRK_PTR + 1
0004EFr 2               
0004EFr 2  A9 rr          lda #<Nmi                     ; Initialize the NMI pointer
0004F1r 2  8D 04 03       sta NMI_PTR
0004F4r 2  A9 rr          lda #>Nmi
0004F6r 2  8D 05 03       sta NMI_PTR + 1
0004F9r 2               
0004F9r 2  9C 0D 03       stz HW_PRESENT                ; Clear all hardware flags
0004FCr 2  9C 5B 03       stz BOOT_VECTOR               ; Clear boot redirect vector
0004FFr 2  9C 5C 03       stz BOOT_VECTOR + 1
000502r 2  9C 8E 03       stz PRG_IMAGE_END             ; No externally-loaded program image yet.  This
000505r 2  9C 8F 03       stz PRG_IMAGE_END + 1         ;   runs before any loader can, so a non-zero
000508r 2                                               ;   value always means a loader put it there
000508r 2  9C 0F 03       stz CF_DISK                   ; Reset current CF disk bank to 0
00050Br 2  A9 1F          lda #$1F                      ; Black on white.  Only KernalInit resets the
00050Dr 2  8D 91 03       sta VID_PEN                   ;   pen: NEW, RUN, CLR and errors keep it
000510r 2               
000510r 2  20 rr rr       jsr InitBuffer                ; Initialize the input buffer (RAM-only, no hardware)
000513r 2               
000513r 2  20 rr rr       jsr ProbeRAM                  ; Sets HW_RAM_L / HW_RAM_H if present (no init needed)
000516r 2               
000516r 2  20 rr rr       jsr ProbeRTC                  ; Sets HW_RTC if present (no init needed)
000519r 2               
000519r 2  20 rr rr       jsr StInit                    ; CF: timeout will handle absent card in Phase 3, sets HW_CF on success
00051Cr 2               
00051Cr 2  20 rr rr       jsr ProbeSerial               ; Sets HW_SC if present
00051Fr 2  AD 0D 03       lda HW_PRESENT
000522r 2  29 10          and #HW_SC
000524r 2  F0 03          beq @SkipSerial
000526r 2  20 rr rr       jsr InitSCImpl
000529r 2               @SkipSerial:
000529r 2               
000529r 2  20 rr rr       jsr ProbeGPIO                 ; Sets HW_GPIO if present
00052Cr 2  AD 0D 03       lda HW_PRESENT
00052Fr 2  29 20          and #HW_GPIO
000531r 2  F0 03          beq @SkipGPIO
000533r 2  20 rr rr       jsr InitKBImpl
000536r 2               @SkipGPIO:
000536r 2               
000536r 2  20 rr rr       jsr ProbeSID                  ; Sets HW_SID if present
000539r 2  AD 0D 03       lda HW_PRESENT
00053Cr 2  29 40          and #HW_SID
00053Er 2  F0 03          beq @SkipSID
000540r 2  20 rr rr       jsr InitSIDImpl
000543r 2               @SkipSID:
000543r 2               
000543r 2  9C 93 03       stz VID_MODE                  ; No console set up since KernalInit
000546r 2  9C 92 03       stz VID_TOP
000549r 2  20 rr rr       jsr ProbeVideo                ; Sets HW_VID if present
00054Cr 2  2C 0D 03       bit HW_PRESENT
00054Fr 2  10 19          bpl @SkipVideo
000551r 2                 ; The card as it is after its own reset, so that a warm KernalInit matches a
000551r 2                 ; power-on: the legacy submode, unscrolled, port A reading STAT0 (the probe
000551r 2                 ; restored that).  No InitVideo — the console comes up on first use
000551r 2                 ; (VideoConsoleReady), and a cartridge that drives the card itself finds it
000551r 2                 ; where a 1.x ROM left a TMS9918.
000551r 2  A2 0D          ldx #VDP_VMODE
000553r 2  20 rr rr       jsr @ZeroReg
000556r 2  A2 13          ldx #VDP_L0SCRX
000558r 2  20 rr rr       jsr @ZeroReg
00055Br 2  A2 14          ldx #VDP_L0SCRY
00055Dr 2  20 rr rr       jsr @ZeroReg
000560r 2  A9 3C          lda #$3C                      ; LxCTRL as the card resets them (SPEC §5), for
000562r 2  8D 96 03       sta VDP_L0CTRL_SHADOW         ;   VdpSetScroll and VdpLayer before anything
000565r 2  A9 0C          lda #$0C                      ;   has written them
000567r 2  8D 97 03       sta VDP_L1CTRL_SHADOW
00056Ar 2               @SkipVideo:
00056Ar 2               
00056Ar 2                 ; Console auto-detection — determine IO_MODE from available hardware
00056Ar 2  AD 0D 03       lda HW_PRESENT
00056Dr 2  29 80          and #HW_VID
00056Fr 2  D0 09          bne @ConsoleVideo             ; Video present — use it
000571r 2  AD 0D 03       lda HW_PRESENT
000574r 2  29 10          and #HW_SC
000576r 2  D0 15          bne @ConsoleSerial            ; Serial present — use it
000578r 2                 ; Neither video nor serial — IO_MODE left as-is (no console)
000578r 2  80 18          bra @ConsoleDone
00057Ar 2               
00057Ar 2               @ConsoleVideo:
00057Ar 2  A9 00          lda #$00                      ; IO_MODE = video
00057Cr 2  8D 06 03       sta IO_MODE
00057Fr 2  9C 07 03       stz VID_CURSOR_X
000582r 2  9C 08 03       stz VID_CURSOR_Y
000585r 2  9C 09 03       stz VID_CURSOR_ADDR
000588r 2  9C 0A 03       stz VID_CURSOR_ADDR + 1
00058Br 2  80 05          bra @ConsoleDone
00058Dr 2               
00058Dr 2               @ConsoleSerial:
00058Dr 2  A9 01          lda #$01                      ; IO_MODE = serial
00058Fr 2  8D 06 03       sta IO_MODE
000592r 2               
000592r 2               @ConsoleDone:
000592r 2  60             rts
000593r 2               @ZeroReg:                       ; X = register
000593r 2  A9 00          lda #$00
000595r 2  4C rr rr       jmp VdpSetReg
000598r 2               
000598r 2               ; KernalVersion — Return BIOS version in registers
000598r 2               ; Output: A = major version, X = minor version
000598r 2               ; Modifies: A, X
000598r 2               KernalVersionImpl:
000598r 2  A9 02          lda #BIOS_VERSION_MAJOR
00059Ar 2  A2 00          ldx #BIOS_VERSION_MINOR
00059Cr 2  60             rts
00059Dr 2               
00059Dr 2               ; ProgramEnd — Determine where the program image at PROGRAM_START ends.
00059Dr 2               ; A program image is a tokenized BASIC line chain, optionally followed by machine
00059Dr 2               ; code (a ".prg").  Only a byte count can find the end of the machine code; a
00059Dr 2               ; chain walk stops at the $0000 end marker.  So prefer a count recorded by a
00059Dr 2               ; loader running outside BASIC, and fall back to the walk when there is none.
00059Dr 2               ; Input: none (reads PRG_IMAGE_END, set by a loader that places a .prg at $0800)
00059Dr 2               ; Output: A = end lo, Y = end hi — the address BASIC should use for VARTAB
00059Dr 2               ; Modifies: Flags, A, X, Y, PE_PTR, PE_NEXT, PRG_IMAGE_END (consumed)
00059Dr 2               ; Note: writes the $00 $00 end marker at PROGRAM_START in the empty case.
00059Dr 2               ; Not in the jump table — BASIC calls this label directly, as it does ReqHw.
00059Dr 2               ProgramEnd:
00059Dr 2                 ; --- 1. A loader recorded a byte count: trust it if it is in range ---
00059Dr 2  AD 8E 03       lda PRG_IMAGE_END
0005A0r 2  AE 8F 03       ldx PRG_IMAGE_END + 1
0005A3r 2  9C 8E 03       stz PRG_IMAGE_END             ; Consume it either way, so a stale value cannot
0005A6r 2  9C 8F 03       stz PRG_IMAGE_END + 1         ;   be acted on twice
0005A9r 2  E0 08          cpx #>PROGRAM_START           ; Must be >= PROGRAM_START + 2 (0 fails here too)
0005ABr 2  90 13          bcc @PeWalk
0005ADr 2  D0 04          bne @PeHiOk
0005AFr 2  C9 02          cmp #<(PROGRAM_START + 2)
0005B1r 2  90 0D          bcc @PeWalk
0005B3r 2               @PeHiOk:
0005B3r 2  E0 80          cpx #>MEMORY_TOP              ; ...and must not run past the top of RAM
0005B5r 2  90 06          bcc @PeUse
0005B7r 2  D0 07          bne @PeWalk
0005B9r 2  C9 00          cmp #<MEMORY_TOP
0005BBr 2  D0 03          bne @PeWalk
0005BDr 2               @PeUse:
0005BDr 2  DA             phx                           ; Y = hi; A still holds lo
0005BEr 2  7A             ply
0005BFr 2  60             rts
0005C0r 2               
0005C0r 2                 ; --- 2. No count: walk the line chain to the $0000 end marker ---
0005C0r 2               @PeWalk:
0005C0r 2  AD 01 08       lda PROGRAM_START + 1         ; High byte of the first next-pointer: a real
0005C3r 2  C9 08          cmp #>PROGRAM_START           ;   program's lines all live in [$0800, $8000)
0005C5r 2  90 3E          bcc @PeEmpty
0005C7r 2  C9 80          cmp #>MEMORY_TOP
0005C9r 2  B0 3A          bcs @PeEmpty
0005CBr 2  A9 00          lda #<PROGRAM_START
0005CDr 2  85 24          sta PE_PTR
0005CFr 2  A9 08          lda #>PROGRAM_START
0005D1r 2  85 25          sta PE_PTR + 1
0005D3r 2               @PeWalkLoop:
0005D3r 2  A0 01          ldy #1
0005D5r 2  B1 24          lda (PE_PTR),y                ; Next-pointer high byte
0005D7r 2  F0 1F          beq @PeWalkDone               ; 0 → end marker reached
0005D9r 2  C9 80          cmp #>MEMORY_TOP              ; Out of range → not a real program
0005DBr 2  B0 28          bcs @PeEmpty
0005DDr 2  85 27          sta PE_NEXT + 1
0005DFr 2  88             dey
0005E0r 2  B1 24          lda (PE_PTR),y                ; Next-pointer low byte
0005E2r 2  85 26          sta PE_NEXT
0005E4r 2                 ; Lines are stored in strictly ascending address order.  If the next-pointer
0005E4r 2                 ; does not advance upward we are walking random power-up RAM, which would
0005E4r 2                 ; otherwise loop forever — bail out and install an empty program.
0005E4r 2  A5 24          lda PE_PTR
0005E6r 2  C5 26          cmp PE_NEXT
0005E8r 2  A5 25          lda PE_PTR + 1
0005EAr 2  E5 27          sbc PE_NEXT + 1
0005ECr 2  B0 17          bcs @PeEmpty                  ; current >= candidate → invalid chain
0005EEr 2  A5 26          lda PE_NEXT                   ; Advance to the next line
0005F0r 2  85 24          sta PE_PTR
0005F2r 2  A5 27          lda PE_NEXT + 1
0005F4r 2  85 25          sta PE_PTR + 1
0005F6r 2  80 DB          bra @PeWalkLoop
0005F8r 2               @PeWalkDone:
0005F8r 2  18             clc                           ; PE_PTR is on the end marker; end = PE_PTR + 2
0005F9r 2  A5 24          lda PE_PTR
0005FBr 2  69 02          adc #2
0005FDr 2  AA             tax
0005FEr 2  A5 25          lda PE_PTR + 1
000600r 2  69 00          adc #0
000602r 2  A8             tay
000603r 2  8A             txa
000604r 2  60             rts
000605r 2               
000605r 2                 ; --- 3. Nothing usable at $0800: install an empty program ---
000605r 2               @PeEmpty:
000605r 2  9C 00 08       stz PROGRAM_START             ; Write the [00][00] end marker
000608r 2  9C 01 08       stz PROGRAM_START + 1
00060Br 2  A9 02          lda #<(PROGRAM_START + 2)
00060Dr 2  A0 08          ldy #>(PROGRAM_START + 2)
00060Fr 2  60             rts
000610r 2               
000610r 2               ; Reset — Full system startup: init hardware, beep, check boot vector, start BASIC
000610r 2               Reset:
000610r 2  A2 FF          ldx #$ff
000612r 2  9A             txs                           ; Reset the stack pointer
000613r 2  20 rr rr       jsr KernalInitImpl            ; Initialize all hardware (leaves interrupts disabled)
000616r 2               
000616r 2  20 rr rr       jsr Beep                      ; Play the startup beep (guarded — skips if no SID)
000619r 2               
000619r 2                 ; Check boot redirect vector — cartridges set this before jumping to Reset
000619r 2  AD 5B 03       lda BOOT_VECTOR
00061Cr 2  0D 5C 03       ora BOOT_VECTOR + 1
00061Fr 2  F0 03          beq @NormalBoot               ; Zero — continue normal boot
000621r 2  6C 5B 03       jmp (BOOT_VECTOR)             ; Non-zero — jump to cartridge/external program
000624r 2               
000624r 2               @NormalBoot:
000624r 2                 ; Verify console is available for interactive boot
000624r 2  AD 0D 03       lda HW_PRESENT
000627r 2  29 90          and #(HW_VID | HW_SC)
000629r 2  D0 02          bne @HasConsole
00062Br 2                 ; Neither video nor serial — halt (no console for interactive boot)
00062Br 2               @Halt:
00062Br 2  80 FE          bra @Halt
00062Dr 2               
00062Dr 2               @HasConsole:
00062Dr 2  9C 6F 03       stz BAS_WARM                  ; A reset is a cold BASIC start: the header
000630r 2                                               ;   prints and the variables are cleared, while
000630r 2                                               ;   the program at $0800 is kept (ProgramEnd
000630r 2                                               ;   walks its line chain)
000630r 2  58             cli                           ; Enable interrupts before anything is printed:
000631r 2                                               ;   reading the ACIA's status register clears a
000631r 2                                               ;   pending receive interrupt (6551 datasheet),
000631r 2                                               ;   and the transmit loop reads it on every
000631r 2                                               ;   character — so a key pressed while the
000631r 2                                               ;   header prints would be sitting in the
000631r 2                                               ;   receive register with nothing left to tell
000631r 2                                               ;   the handler about it.  With interrupts on,
000631r 2                                               ;   it is in the input buffer when BASIC asks.
000631r 2  4C rr rr       jmp BasEntry
000634r 2               
000634r 2               ; Initialize the Keyboard via VIA (IO 6)
000634r 2               ; Configures Port B (matrix) and Port A (PS/2) as inputs
000634r 2               ; CB2 low (enable matrix encoder), CA2 low (enable PS/2 encoder)
000634r 2               ; CB1 and CA1 falling-edge IRQs enabled
000634r 2               ; Modifies: Flags, A
000634r 2               InitKBImpl:
000634r 2  A9 00          lda #$00                      ; Port B all inputs (matrix keyboard data bus)
000636r 2  8D 02 94       sta GPIO_DDRB
000639r 2  A9 00          lda #$00                      ; Port A all inputs (PS/2 keyboard data bus)
00063Br 2  8D 03 94       sta GPIO_DDRA
00063Er 2                 ; PCR: CB2 low + CB1 neg + CA2 low + CA1 neg
00063Er 2  A9 CC          lda #(GPIO_PCR_CB2_LO | GPIO_PCR_CB1_NEG | GPIO_PCR_CA2_LO | GPIO_PCR_CA1_NEG)
000640r 2  8D 0C 94       sta GPIO_PCR
000643r 2                 ; Enable both CB1 and CA1 interrupts
000643r 2  A9 92          lda #(GPIO_IER_SET | GPIO_INT_CB1 | GPIO_INT_CA1)
000645r 2  8D 0E 94       sta GPIO_IER
000648r 2  60             rts
000649r 2               
000649r 2               ; Initialize the Serial Card (6551)
000649r 2               ; Modifies: Flags, A
000649r 2               InitSCImpl:
000649r 2  A9 1F          lda     #$1F                  ; 8-N-1, 19200 baud
00064Br 2  8D 03 90       sta     SC_CTRL
00064Er 2  A9 09          lda     #SC_CMD_RTS_LOW       ; No parity, no echo, RTSB low, TX interrupts disabled, RX interrupts enabled
000650r 2  8D 02 90       sta     SC_CMD
000653r 2  60             rts
000654r 2               
000654r 2               ; Initialze the Sound Card (6581)
000654r 2               ; Modifies: Flags, A, X
000654r 2               InitSIDImpl:
000654r 2  A9 00          lda #$00
000656r 2  A2 1D          ldx #$1D                      ; Clear all 29 SID registers
000658r 2               @InitSIDLoop:
000658r 2  9D 00 98       sta SID_V1_FREQ_LO,x          ; Clear register
00065Br 2  CA             dex
00065Cr 2  10 FA          bpl @InitSIDLoop              ; Loop until all registers cleared
00065Er 2  A9 0F          lda #$0F                      ; Set volume to maximum
000660r 2  8D 18 98       sta SID_MODE_VOL
000663r 2  60             rts
000664r 2               
000664r 2               ; InitVideo — Put the PICOVDP in the Kernal's Text-mode console
000664r 2               ; Writes the register table below with the display off, has the card reload its
000664r 2               ; font into the pattern table at $0800 (VdpLoadFont, a frame at most), restores
000664r 2               ; palette row 0, sets the border
000664r 2               ; from VID_PEN and turns the display on.  It does not clear the screen: the
000664r 2               ; name and attribute tables are left as they were and shown unscrolled.  A
000664r 2               ; program that switched modes, moved tables or overwrote the glyphs gets the
000664r 2               ; console back with this one call.
000664r 2               ; Skips silently if no video card is fitted
000664r 2               ; Modifies: Flags, A, X, Y
000664r 2               InitVideoImpl:
000664r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
000667r 2  10 66          bpl @InitVideoNone
000669r 2  A2 00          ldx #$00
00066Br 2               @InitVideoLoop:
00066Br 2  BD rr rr       lda @InitVideoRegs + 1,x      ; Value
00066Er 2  8D 01 9C       sta VC_REG
000671r 2  BD rr rr       lda @InitVideoRegs,x          ; Register | $80
000674r 2  8D 01 9C       sta VC_REG
000677r 2  E8             inx
000678r 2  E8             inx
000679r 2  E0 22          cpx #(@InitVideoRegsEnd - @InitVideoRegs)
00067Br 2  D0 EE          bne @InitVideoLoop
00067Dr 2  A9 00          lda #VDP_FONT_CP437           ; The card's font, into L0PAT = $0800, with the
00067Fr 2  20 rr rr       jsr VdpLoadFontImpl           ;   display still off
000682r 2                 ; Palette row 0, 16 entries of $0R $GB at $FC00.  $FC00 is in bank 3, and
000682r 2                 ; VBANK is sampled by the address command, so it goes straight back to 0.
000682r 2  A9 03          lda #$03
000684r 2  A2 08          ldx #VDP_VBANK
000686r 2  20 rr rr       jsr VdpSetReg
000689r 2  9C 01 9C       stz VC_REG                    ; $FC00 = bank 3, $3C00
00068Cr 2  A9 7C          lda #($40 | $3C)
00068Er 2  8D 01 9C       sta VC_REG
000691r 2  A9 00          lda #$00
000693r 2  A2 08          ldx #VDP_VBANK
000695r 2  20 rr rr       jsr VdpSetReg
000698r 2  A2 00          ldx #$00
00069Ar 2               @InitVideoPalette:
00069Ar 2  BD rr rr       lda @InitVideoPaletteRow0,x
00069Dr 2  8D 00 9C       sta VC_DATA
0006A0r 2  E8             inx
0006A1r 2  E0 20          cpx #32
0006A3r 2  D0 F5          bne @InitVideoPalette
0006A5r 2  AD 91 03       lda VID_PEN                   ; Border = the pen's background
0006A8r 2  A2 07          ldx #VDP_COLOR
0006AAr 2  20 rr rr       jsr VdpSetReg
0006ADr 2  A9 40          lda #$40                      ; Display on
0006AFr 2  A2 01          ldx #VDP_MODE1
0006B1r 2  20 rr rr       jsr VdpSetReg
0006B4r 2  A9 30          lda #$30
0006B6r 2  8D 96 03       sta VDP_L0CTRL_SHADOW
0006B9r 2  A9 0C          lda #$0C
0006BBr 2  8D 97 03       sta VDP_L1CTRL_SHADOW
0006BEr 2  A9 01          lda #$01
0006C0r 2  8D 93 03       sta VID_MODE                  ; Text console intact
0006C3r 2  9C 92 03       stz VID_TOP
0006C6r 2  AE 07 03       ldx VID_CURSOR_X              ; The cursor keeps its screen position
0006C9r 2  AC 08 03       ldy VID_CURSOR_Y
0006CCr 2  4C rr rr       jmp VideoSetCursorImpl
0006CFr 2               @InitVideoNone:
0006CFr 2  60             rts
0006D0r 2               @InitVideoRegs:                 ; Register | $80, value
0006D0r 2  81 00          .byte $80 | VDP_MODE1,     $00  ; Display off, IRQ off, legacy mode bits clear
0006D2r 2  80 00          .byte $80 | VDP_MODE0,     $00
0006D4r 2  8D 01          .byte $80 | VDP_VMODE,     $01  ; Text, 40x24 of 6x8
0006D6r 2  88 00          .byte $80 | VDP_VBANK,     $00  ; The Kernal assumes both
0006D8r 2  89 01          .byte $80 | VDP_VINC,      $01
0006DAr 2  8A 00          .byte $80 | VDP_IRQEN,     $00
0006DCr 2  8F 00          .byte $80 | VDP_STATSEL_A, $00  ; Port B's STATSEL_B is never touched
0006DEr 2  8C 3F          .byte $80 | VDP_PALBASE,   $3F  ; $FC00
0006E0r 2  90 00          .byte $80 | VDP_L0NAME,    $00  ; Name table $0000
0006E2r 2  91 01          .byte $80 | VDP_L0ATTR,    $01  ; Attributes $0400
0006E4r 2  92 01          .byte $80 | VDP_L0PAT,     $01  ; Patterns $0800
0006E6r 2  93 00          .byte $80 | VDP_L0SCRX,    $00
0006E8r 2  94 00          .byte $80 | VDP_L0SCRY,    $00
0006EAr 2  95 30          .byte $80 | VDP_L0CTRL,    $30  ; 1bpp, per-cell attributes, enabled, index 0 opaque
0006ECr 2  96 00          .byte $80 | VDP_L0PAL,     $00  ; Palette row 0, the TMS9918 colours
0006EEr 2  9D 0C          .byte $80 | VDP_L1CTRL,    $0C  ; Layer 1 off (its reset value)
0006F0r 2  A3 26          .byte $80 | VDP_SPRCTRL,   $26  ; Sprites off
0006F2r 2               @InitVideoRegsEnd:
0006F2r 2               @InitVideoPaletteRow0:          ; SPEC §11 default palette, row 0
0006F2r 2  00 00 00 00    .byte $00,$00, $00,$00, $02,$C4, $06,$D7, $05,$5E, $07,$7F, $0C,$55, $04,$EE
0006F6r 2  02 C4 06 D7  
0006FAr 2  05 5E 07 7F  
000702r 2  0F 55 0F 77    .byte $0F,$55, $0F,$77, $0C,$B5, $0D,$C8, $02,$A4, $0C,$5B, $0C,$CC, $0F,$FF
000706r 2  0C B5 0D C8  
00070Ar 2  02 A4 0C 5B  
000712r 2               
000712r 2               ; Initialize the INPUT_BUFFER
000712r 2               ; Modifies: Flags, A
000712r 2               InitBuffer:
000712r 2  A9 00          lda #$00
000714r 2  85 00          sta READ_PTR                  ; Init read and write pointers
000716r 2  85 01          sta WRITE_PTR
000718r 2  60             rts
000719r 2               
000719r 2               ; Write a character from the A register to the INPUT_BUFFER
000719r 2               ; Modifies: Flags, X
000719r 2               WriteBufferImpl:
000719r 2  A6 01          ldx WRITE_PTR
00071Br 2  9D 00 02       sta INPUT_BUFFER,x
00071Er 2  E6 01          inc WRITE_PTR
000720r 2  60             rts
000721r 2               
000721r 2               ; --- The Serial Card's command register ---
000721r 2               ;
000721r 2               ; Once InitSC has run, ScRts and ScRtsLow are the only places that write the
000721r 2               ; command register, so the whole RTS scheme lives here. XModem is the exception:
000721r 2               ; it turns the receive interrupt off and drives the register itself, and while
000721r 2               ; that bit is set these routines leave it alone.
000721r 2               ;
000721r 2               ; RTS is the machine saying "stop sending". The catch is that TIC 00 raises RTS
000721r 2               ; *and* turns the transmitter off, so while RTS is up the machine cannot send a
000721r 2               ; character either — and BASIC echoes every character it reads. Holding RTS up
000721r 2               ; across a transmit therefore hangs the board: SerialChrout spins on TDRE that
000721r 2               ; can never come, the buffer never drains and RTS never falls. (Seen on a real
000721r 2               ; R6551, 2026-09-17.)
000721r 2               ;
000721r 2               ; So RTS goes up only between transmits, and SerialChrout drops it around every
000721r 2               ; byte it sends. Each of those releases lets a byte or two in at 19,200 baud,
000721r 2               ; which is why the marks sit well below the 256-byte buffer: up at
000721r 2               ; SC_RTS_HIGH_WATER ($C0) with $40 bytes still spare, down again below
000721r 2               ; SC_RTS_LOW_WATER ($80). The $40 between them is the hysteresis — the same band
000721r 2               ; the old $F0/$B0 pair had — so a line being read does not flap the pin.
000721r 2               ;
000721r 2               ; Irq calls ScRts after it stores a byte, ReadBuffer after it takes one, and
000721r 2               ; SerialChrout at the end of each character.
000721r 2               
000721r 2               ; ScRts — Put RTS where the amount of unread input says it belongs
000721r 2               ; Raises it at SC_RTS_HIGH_WATER unread bytes, lowers it below SC_RTS_LOW_WATER,
000721r 2               ; and between the two leaves the pin as it is.
000721r 2               ; Modifies: Flags, A, X
000721r 2               ScRts:
000721r 2  A5 01          lda WRITE_PTR                 ; Unread bytes
000723r 2  38             sec
000724r 2  E5 00          sbc READ_PTR
000726r 2  A2 01          ldx #SC_CMD_RTS_HIGH
000728r 2  C9 C0          cmp #SC_RTS_HIGH_WATER
00072Ar 2  B0 09          bcs ScRtsWrite                ; Full enough — stop the far end
00072Cr 2  A2 09          ldx #SC_CMD_RTS_LOW
00072Er 2  C9 80          cmp #SC_RTS_LOW_WATER
000730r 2  90 03          bcc ScRtsWrite                ; Drained — let it talk again
000732r 2  60             rts                           ; Between the marks — leave the pin alone
000733r 2               
000733r 2               ; ScRtsLow — Lower RTS, which is also what turns the transmitter back on
000733r 2               ; Preserves: A
000733r 2               ; Modifies: Flags, X
000733r 2               ScRtsLow:
000733r 2  A2 09          ldx #SC_CMD_RTS_LOW
000735r 2                 ; Fall through
000735r 2               
000735r 2               ; ScRtsWrite — Write X to the command register unless XModem owns it
000735r 2               ; Preserves: A
000735r 2               ; Modifies: Flags
000735r 2               ScRtsWrite:
000735r 2  48             pha
000736r 2  AD 0D 03       lda HW_PRESENT
000739r 2  29 10          and #HW_SC
00073Br 2  F0 0A          beq @ScRtsDone                ; No serial card — nothing to signal
00073Dr 2  AD 02 90       lda SC_CMD
000740r 2  29 02          and #SC_CMD_RXIRQ_OFF
000742r 2  D0 03          bne @ScRtsDone                ; XModem owns the receiver
000744r 2  8E 02 90       stx SC_CMD
000747r 2               @ScRtsDone:
000747r 2  68             pla
000748r 2  60             rts
000749r 2               
000749r 2               ; ScRxPoll — Read the Serial Card's status, keeping any byte that came with it
000749r 2               ; Reading the status register clears a pending receive interrupt. A byte that
000749r 2               ; arrives while SerialChrout is polling would therefore lose its interrupt
000749r 2               ; before Irq could see it, and since the receive register stays full the ACIA
000749r 2               ; would not hand over the next one either — the console would stop accepting
000749r 2               ; input for good. So the byte is collected here rather than left for a handler
000749r 2               ; that will never run. XModem is the exception: it turns the receiver interrupt
000749r 2               ; off and polls the chip itself, and those bytes belong to it.
000749r 2               ; Callers hold interrupts off, so WriteBuffer's pointer bump is safe here.
000749r 2               ; Output: A = the status register
000749r 2               ; Modifies: Flags, A, X
000749r 2               ScRxPoll:
000749r 2  AD 01 90       lda SC_STATUS
00074Cr 2  89 08          bit #SC_STATUS_RDRF           ; Did a byte arrive during the poll?
00074Er 2  F0 0F          beq @ScRxPollDone
000750r 2  48             pha                           ; Keep the status just read
000751r 2  AD 02 90       lda SC_CMD
000754r 2  29 02          and #SC_CMD_RXIRQ_OFF
000756r 2  D0 06          bne @ScRxPollKeep             ; Receiver is somebody else's — leave it alone
000758r 2  AD 00 90       lda SC_DATA                   ; Frees the receive register
00075Br 2  20 rr rr       jsr WriteBuffer
00075Er 2               @ScRxPollKeep:
00075Er 2  68             pla                           ; Back to the status
00075Fr 2               @ScRxPollDone:
00075Fr 2  60             rts
000760r 2               
000760r 2               ; Read a character from the INPUT_BUFFER and store it in A register
000760r 2               ; Every reader comes through here — Chrin, BASIC's line input, INKEY, the break
000760r 2               ; check, a cartridge — so this is where RTS is lowered again once the buffer has
000760r 2               ; drained. A reader that skipped it would leave a terminal with RTS/CTS flow
000760r 2               ; control waiting for good.
000760r 2               ; Modifies: Flags, X, A
000760r 2               ReadBufferImpl:
000760r 2  A6 00          ldx READ_PTR
000762r 2  BD 00 02       lda INPUT_BUFFER,x
000765r 2  E6 00          inc READ_PTR
000767r 2  48             pha
000768r 2  DA             phx                           ; ScRts uses X, and callers have leaned on
000769r 2                                               ;   ReadBuffer leaving the read pointer there —
000769r 2                                               ;   1.6's boot menu counts its timeout down in X
000769r 2  20 rr rr       jsr ScRts                     ; One fewer unread byte — RTS may come down
00076Cr 2  FA             plx
00076Dr 2  68             pla
00076Er 2  60             rts
00076Fr 2               
00076Fr 2               ; Return in A register the number of unread bytes in the INPUT_BUFFER
00076Fr 2               ; Modifies: Flags, A
00076Fr 2               BufferSizeImpl:
00076Fr 2  A5 01          lda WRITE_PTR
000771r 2  38             sec
000772r 2  E5 00          sbc READ_PTR
000774r 2  60             rts
000775r 2               
000775r 2               ; Get a character from the INPUT_BUFFER if available
000775r 2               ; On return, carry flag indicates whether a character was available
000775r 2               ; If character available the character will be in the A register
000775r 2               ; Modifies: Flags, A
000775r 2               ChrinImpl:
000775r 2  DA             phx
000776r 2  20 rr rr       jsr BufferSize                ; Check for character available
000779r 2  F0 09          beq @ChrinNoChar              ; Branch if no character available
00077Br 2  20 rr rr       jsr ReadBuffer                ; Read the character (and set RTS for what is left)
00077Er 2  20 rr rr       jsr Chrout                    ; Echo
000781r 2  FA             plx
000782r 2  38             sec
000783r 2  60             rts
000784r 2               @ChrinNoChar:
000784r 2  FA             plx
000785r 2  18             clc
000786r 2  60             rts
000787r 2               
000787r 2               ; Output a character from the A register to the Serial Card
000787r 2               ; TIC 00 turns the transmitter off as well as raising RTS, so a character
000787r 2               ; written while the BIOS is holding RTS up would never leave: the loop below
000787r 2               ; would spin on a TDRE that cannot come. RTS is therefore dropped for the byte
000787r 2               ; and put back afterwards if the buffer is still full, and interrupts are held
000787r 2               ; off meanwhile so that Irq cannot raise it again mid-character.
000787r 2               ; Modifies: Flags
000787r 2               SerialChroutImpl:
000787r 2  48             pha
000788r 2  DA             phx                           ; WriteBuffer uses X
000789r 2  08             php
00078Ar 2  78             sei                           ; Irq must not raise RTS while the byte goes out
00078Br 2  20 rr rr       jsr ScRtsLow                  ; The transmitter only runs with RTS down
00078Er 2  8D 00 90       sta SC_DATA
000791r 2               @ChroutWait:
000791r 2  20 rr rr       jsr ScRxPoll                  ; Status, and any byte that arrived with it
000794r 2  29 10          and #SC_STATUS_TDRE           ; Check if TX buffer not empty
000796r 2  F0 F9          beq @ChroutWait               ; Loop if TX buffer not empty
000798r 2  20 rr rr       jsr ScRts                     ; Byte is gone — RTS may go back up
00079Br 2  28             plp                           ; Interrupts back as the caller had them
00079Cr 2  FA             plx
00079Dr 2  68             pla                           ; The character, and the flags it left, as before
00079Er 2  60             rts
00079Fr 2               
00079Fr 2               ; SidPlayNote — Play a note on a SID voice
00079Fr 2               ; Input: A = voice (0-2), X = frequency low byte, Y = frequency high byte
00079Fr 2               ; Uses triangle waveform with standard ADSR (Attack=0, Decay=9, Sustain=A, Release=2)
00079Fr 2               ; Skips silently if no SID is fitted
00079Fr 2               ; Modifies: Flags, A
00079Fr 2               SidPlayNoteImpl:
00079Fr 2  2C 0D 03       bit HW_PRESENT                ; SID is bit 6, so BIT tests it in V and leaves
0007A2r 2  50 49          bvc @SidPlayNoteNone          ;   the voice number in A — see VideoClear
0007A4r 2  C9 01          cmp #$01
0007A6r 2  F0 1A          beq @Voice2
0007A8r 2  C9 02          cmp #$02
0007AAr 2  F0 2C          beq @Voice3
0007ACr 2                 ; Voice 0
0007ACr 2  8E 00 98       stx SID_V1_FREQ_LO
0007AFr 2  8C 01 98       sty SID_V1_FREQ_HI
0007B2r 2  A9 09          lda #$09                      ; Attack = 0, Decay = 9
0007B4r 2  8D 05 98       sta SID_V1_AD
0007B7r 2  A9 F8          lda #$F8                      ; Sustain = F, Release = 8
0007B9r 2  8D 06 98       sta SID_V1_SR
0007BCr 2  A9 11          lda #$11                      ; Triangle wave + Gate on
0007BEr 2  8D 04 98       sta SID_V1_CTRL
0007C1r 2  60             rts
0007C2r 2               @Voice2:
0007C2r 2  8E 07 98       stx SID_V2_FREQ_LO
0007C5r 2  8C 08 98       sty SID_V2_FREQ_HI
0007C8r 2  A9 09          lda #$09
0007CAr 2  8D 0C 98       sta SID_V2_AD
0007CDr 2  A9 F8          lda #$F8
0007CFr 2  8D 0D 98       sta SID_V2_SR
0007D2r 2  A9 11          lda #$11
0007D4r 2  8D 0B 98       sta SID_V2_CTRL
0007D7r 2  60             rts
0007D8r 2               @Voice3:
0007D8r 2  8E 0E 98       stx SID_V3_FREQ_LO
0007DBr 2  8C 0F 98       sty SID_V3_FREQ_HI
0007DEr 2  A9 09          lda #$09
0007E0r 2  8D 13 98       sta SID_V3_AD
0007E3r 2  A9 F8          lda #$F8
0007E5r 2  8D 14 98       sta SID_V3_SR
0007E8r 2  A9 11          lda #$11
0007EAr 2  8D 12 98       sta SID_V3_CTRL
0007EDr 2               @SidPlayNoteNone:
0007EDr 2  60             rts
0007EEr 2               
0007EEr 2               ; SidSilence — Silence all 3 SID voices
0007EEr 2               ; Gates off all voices, letting the release phase of the envelope ring out.
0007EEr 2               ;
0007EEr 2               ; The frequency registers are deliberately left alone. Zeroing them stops the
0007EEr 2               ; oscillator dead, which freezes the waveform at whatever level it had reached
0007EEr 2               ; and leaves the envelope to decay a DC offset instead of a tone — an audible
0007EEr 2               ; thump at the end of every note. Gate off is all the SID needs; the envelope
0007EEr 2               ; takes the voice to zero on its own.
0007EEr 2               ; Skips silently if no SID is fitted
0007EEr 2               ; Modifies: Flags, A
0007EEr 2               SidSilenceImpl:
0007EEr 2  2C 0D 03       bit HW_PRESENT                ; SID is bit 6 — see VideoClear
0007F1r 2  50 0B          bvc @SidSilenceNone
0007F3r 2  A9 10          lda #$10                      ; Triangle wave, Gate off
0007F5r 2  8D 04 98       sta SID_V1_CTRL
0007F8r 2  8D 0B 98       sta SID_V2_CTRL
0007FBr 2  8D 12 98       sta SID_V3_CTRL
0007FEr 2               @SidSilenceNone:
0007FEr 2  60             rts
0007FFr 2               
0007FFr 2               ; Play a short beep sound
0007FFr 2               ; Uses SidPlayNote on voice 0 with ~475 Hz tone, then silences
0007FFr 2               ; Skips silently if SID is absent
0007FFr 2               ; Modifies: Flags, A, X, Y
0007FFr 2               BeepImpl:
0007FFr 2  AD 0D 03       lda HW_PRESENT
000802r 2  29 40          and #HW_SID
000804r 2  D0 01          bne @BeepStart
000806r 2  60             rts                           ; No SID — skip silently
000807r 2               @BeepStart:
000807r 2  A9 00          lda #$00                      ; Voice 0
000809r 2  A2 20          ldx #$20                      ; Frequency low byte (~475 Hz)
00080Br 2  A0 1F          ldy #$1F                      ; Frequency high byte
00080Dr 2  20 rr rr       jsr SidPlayNote
000810r 2                 ; Override ADSR for beep: fast decay, no sustain
000810r 2  A9 09          lda #$09                      ; Attack = 0, Decay = 9
000812r 2  8D 05 98       sta SID_V1_AD
000815r 2  A9 00          lda #$00                      ; Sustain = 0, Release = 0
000817r 2  8D 06 98       sta SID_V1_SR
00081Ar 2                 ; Delay for beep duration
00081Ar 2  A2 F0          ldx #$F0                      ; Outer loop counter
00081Cr 2               @BeepDelay1:
00081Cr 2  A0 FF          ldy #$FF                      ; Inner loop counter
00081Er 2               @BeepDelay2:
00081Er 2  88             dey
00081Fr 2  D0 FD          bne @BeepDelay2
000821r 2  CA             dex
000822r 2  D0 F8          bne @BeepDelay1
000824r 2  20 rr rr       jsr SidSilence                ; Gate off all voices
000827r 2  60             rts
000828r 2               
000828r 2               ; SysDelay — Delay for a specified number of centiseconds
000828r 2               ; Input: A = count low byte, X = count high byte
000828r 2               ; Uses VIA T1 in one-shot mode. 9999 cycles @ 1MHz = ~10ms per tick.
000828r 2               ; Modifies: Flags, A, X, Y (X/Y clobbered only in software-fallback path)
000828r 2               SysDelayImpl:
000828r 2  85 2C          sta DELAY_CNT
00082Ar 2  86 2D          stx DELAY_CNT + 1
00082Cr 2                 ; Return immediately if count is zero
00082Cr 2  05 2D          ora DELAY_CNT + 1
00082Er 2  F0 4F          beq @DelayDone
000830r 2                 ; Check if VIA is present for hardware timer
000830r 2  AD 0D 03       lda HW_PRESENT
000833r 2  29 20          and #HW_GPIO
000835r 2  D0 19          bne @DelayHardware
000837r 2                 ; Software fallback — calibrated busy loop (~10ms per centisecond at 1MHz)
000837r 2                 ; Inner loop: 5 cycles × 256 iterations × 8 = ~10240 cycles ≈ 10ms
000837r 2               @DelaySoftLoop:
000837r 2  A0 00          ldy #$00                      ; 256 outer iterations
000839r 2  A2 08          ldx #8
00083Br 2               @DelaySoftInner:
00083Br 2  88             dey
00083Cr 2  D0 FD          bne @DelaySoftInner
00083Er 2  CA             dex
00083Fr 2  D0 FA          bne @DelaySoftInner
000841r 2                 ; 16-bit decrement of DELAY_CNT
000841r 2  A5 2C          lda DELAY_CNT
000843r 2  D0 02          bne @SoftDecLo
000845r 2  C6 2D          dec DELAY_CNT + 1
000847r 2               @SoftDecLo:
000847r 2  C6 2C          dec DELAY_CNT
000849r 2  A5 2C          lda DELAY_CNT
00084Br 2  05 2D          ora DELAY_CNT + 1
00084Dr 2  D0 E8          bne @DelaySoftLoop
00084Fr 2  60             rts
000850r 2               @DelayHardware:
000850r 2                 ; Configure T1 one-shot mode: clear ACR bit 6
000850r 2  AD 0B 94       lda GPIO_ACR
000853r 2  29 BF          and #%10111111
000855r 2  8D 0B 94       sta GPIO_ACR
000858r 2               @DelayLoop:
000858r 2                 ; Load T1 latch: 9999 = $270F
000858r 2  A9 0F          lda #$0F
00085Ar 2  8D 06 94       sta GPIO_T1LL
00085Dr 2  A9 27          lda #$27
00085Fr 2  8D 07 94       sta GPIO_T1LH
000862r 2                 ; Write T1CH to start countdown (also clears IFR T1 flag)
000862r 2  A9 27          lda #$27
000864r 2  8D 05 94       sta GPIO_T1CH
000867r 2               @DelayPoll:
000867r 2  AD 0D 94       lda GPIO_IFR
00086Ar 2  29 40          and #%01000000                ; T1 timeout flag
00086Cr 2  F0 F9          beq @DelayPoll
00086Er 2                 ; Clear flag by reading T1CL
00086Er 2  AD 04 94       lda GPIO_T1CL
000871r 2                 ; 16-bit decrement
000871r 2  A5 2C          lda DELAY_CNT
000873r 2  D0 02          bne @DelayDecLo
000875r 2  C6 2D          dec DELAY_CNT + 1
000877r 2               @DelayDecLo:
000877r 2  C6 2C          dec DELAY_CNT
000879r 2                 ; Loop until both bytes zero
000879r 2  A5 2C          lda DELAY_CNT
00087Br 2  05 2D          ora DELAY_CNT + 1
00087Dr 2  D0 D9          bne @DelayLoop
00087Fr 2               @DelayDone:
00087Fr 2  60             rts
000880r 2               
000880r 2               ; SidSetVolume — Set SID master volume
000880r 2               ; Input: A = volume (0-15); upper nibble of SID_MODE_VOL is cleared (no filter)
000880r 2               ; Skips silently if no SID is fitted
000880r 2               ; Modifies: Flags, A
000880r 2               SidSetVolumeImpl:
000880r 2  2C 0D 03       bit HW_PRESENT                ; SID is bit 6 — see VideoClear
000883r 2  50 05          bvc @SidSetVolumeNone
000885r 2  29 0F          and #$0F
000887r 2  8D 18 98       sta SID_MODE_VOL
00088Ar 2               @SidSetVolumeNone:
00088Ar 2  60             rts
00088Br 2               
00088Br 2               ; VideoSetPen — Set the pen for later output, and nothing else (internal)
00088Br 2               ; Input: A = fg<<4 | bg.  VID_PEN = A, after bringing the console up.  Register
00088Br 2               ; 7 is not written, so a caller with a border of its own (COLOR fg,bg,border)
00088Br 2               ; writes it once instead of after VideoSetColor has shown the background there
00088Br 2               ; for part of a frame.  The one exception is the console's first use: the
00088Br 2               ; bring-up (InitVideo + clear) sets the border from the old pen before A is
00088Br 2               ; stored.
00088Br 2               ; Skips silently if no video card is fitted
00088Br 2               ; Preserves: A, X, Y
00088Br 2               ; Modifies: Flags
00088Br 2               VideoSetPen:
00088Br 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
00088Er 2  10 06          bpl @VideoSetPenNone
000890r 2  20 rr rr       jsr VideoConsoleReady
000893r 2  8D 91 03       sta VID_PEN
000896r 2               @VideoSetPenNone:
000896r 2  60             rts
000897r 2               
000897r 2               ; VideoSetColor — Set the pen for later output, and the border
000897r 2               ; Input: A = fg<<4 | bg.  VID_PEN = A, and register 7 = A, so the border follows
000897r 2               ; the background.  Characters already on screen keep their colours.
000897r 2               ; Skips silently if no video card is fitted
000897r 2               ; Modifies: Flags, A
000897r 2               VideoSetColorImpl:
000897r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
00089Ar 2  10 0B          bpl @VideoSetColorNone
00089Cr 2  20 rr rr       jsr VideoSetPen
00089Fr 2  8D 01 9C       sta VC_REG                    ; Data byte
0008A2r 2  A9 87          lda #($80 | VDP_COLOR)
0008A4r 2  8D 01 9C       sta VC_REG
0008A7r 2               @VideoSetColorNone:
0008A7r 2  60             rts
0008A8r 2               
0008A8r 2               ; Encoder settle count for KBDisableImpl. Each loop iteration is 5 cycles, so
0008A8r 2               ; the busy-wait is ~KB_SETTLE_COUNT*5 cycles. Sized against the 2 MHz clock
0008A8r 2               ; option (the worst case): 80 => ~400 cycles => ~200 us @ 2 MHz (~400 us @ 1 MHz),
0008A8r 2               ; comfortably above the firmware's guaranteed 100 us release ceiling.
0008A8r 2               KB_SETTLE_COUNT = 80
0008A8r 2               
0008A8r 2               ; KBDisable — Disable both keyboard encoders and wait for them to release the ports
0008A8r 2               ; Sets CB2/CA2 high, then busy-waits so the encoder firmware has time to let go of
0008A8r 2               ; both ports before the caller reads them. Self-contained cycle loop — deliberately
0008A8r 2               ; not SysDelay or the VIA T1 path, so it is safe to call while the caller owns the timers.
0008A8r 2               ; Modifies: Flags, A
0008A8r 2               KBDisableImpl:
0008A8r 2  A9 EE          lda #(GPIO_PCR_CB2_HI | GPIO_PCR_CB1_NEG | GPIO_PCR_CA2_HI | GPIO_PCR_CA1_NEG)
0008AAr 2  8D 0C 94       sta GPIO_PCR                  ; Tell both encoders to release the ports
0008ADr 2  8A             txa
0008AEr 2  48             pha                           ; Preserve X so the contract stays "Modifies: Flags, A"
0008AFr 2  A2 50          ldx #KB_SETTLE_COUNT
0008B1r 2               @KBSettle:
0008B1r 2  CA             dex
0008B2r 2  D0 FD          bne @KBSettle                 ; Give the encoders time to go high-impedance
0008B4r 2  68             pla
0008B5r 2  AA             tax
0008B6r 2  60             rts
0008B7r 2               
0008B7r 2               ; KBEnable — Re-enable both keyboard encoders
0008B7r 2               ; Sets CB2 low (enable matrix encoder) and CA2 low (enable PS/2 encoder)
0008B7r 2               ; Modifies: Flags, A
0008B7r 2               KBEnableImpl:
0008B7r 2  A9 CC          lda #(GPIO_PCR_CB2_LO | GPIO_PCR_CB1_NEG | GPIO_PCR_CA2_LO | GPIO_PCR_CA1_NEG)
0008B9r 2  8D 0C 94       sta GPIO_PCR
0008BCr 2  60             rts
0008BDr 2               
0008BDr 2               ; ReadJoystick1 — Read joystick 1 on Port B
0008BDr 2               ; Disables both encoders, waits for release, then reads the raw port directly —
0008BDr 2               ; the same way a C64 reads a CIA port. No sei/PCR save-restore is needed: the port
0008BDr 2               ; is static while the encoders are off and no interrupt handler touches these ports.
0008BDr 2               ; Output: A = joystick bitmask (active-low bits: R-L-D-U-Y-X-B-A)
0008BDr 2               ; Modifies: Flags, A
0008BDr 2               ReadJoystick1Impl:
0008BDr 2  20 rr rr       jsr KBDisableImpl             ; Encoders off, ports released, settled
0008C0r 2  AD 00 94       lda GPIO_PORTB                ; JOY(1) - raw Port B
0008C3r 2  48             pha
0008C4r 2  20 rr rr       jsr KBEnableImpl
0008C7r 2  68             pla
0008C8r 2  60             rts
0008C9r 2               
0008C9r 2               ; ReadJoystick2 — Read joystick 2 on Port A
0008C9r 2               ; Output: A = joystick bitmask (active-low bits: R-L-D-U-Y-X-B-A)
0008C9r 2               ; Modifies: Flags, A
0008C9r 2               ReadJoystick2Impl:
0008C9r 2  20 rr rr       jsr KBDisableImpl             ; Encoders off, ports released, settled
0008CCr 2  AD 01 94       lda GPIO_PORTA                ; JOY(2) - raw Port A
0008CFr 2  48             pha
0008D0r 2  20 rr rr       jsr KBEnableImpl
0008D3r 2  68             pla
0008D4r 2  60             rts
0008D5r 2               
0008D5r 2               ; === BCD Conversion Helpers ===
0008D5r 2               
0008D5r 2               ; BcdToBin — Convert BCD byte to binary
0008D5r 2               ; Input: A = BCD value (e.g. $35 represents 35)
0008D5r 2               ; Output: A = binary value (e.g. 35 = $23)
0008D5r 2               ; Modifies: Flags
0008D5r 2               BcdToBin:
0008D5r 2  48             pha
0008D6r 2  4A             lsr a                         ; Shift tens digit to low nibble
0008D7r 2  4A             lsr a
0008D8r 2  4A             lsr a
0008D9r 2  4A             lsr a                         ; A = tens digit (0-9)
0008DAr 2  0A             asl a                         ; A = tens * 2
0008DBr 2  8D 0C 03       sta RTC_TMP
0008DEr 2  0A             asl a                         ; A = tens * 4
0008DFr 2  0A             asl a                         ; A = tens * 8
0008E0r 2  18             clc
0008E1r 2  6D 0C 03       adc RTC_TMP                   ; A = tens * 10 (8 + 2)
0008E4r 2  8D 0C 03       sta RTC_TMP
0008E7r 2  68             pla
0008E8r 2  29 0F          and #$0F                      ; A = ones digit
0008EAr 2  18             clc
0008EBr 2  6D 0C 03       adc RTC_TMP                   ; A = tens * 10 + ones = binary
0008EEr 2  60             rts
0008EFr 2               
0008EFr 2               ; BinToBcd — Convert binary byte to BCD
0008EFr 2               ; Input: A = binary value (0-99)
0008EFr 2               ; Output: A = BCD value
0008EFr 2               ; Modifies: Flags, X
0008EFr 2               BinToBcd:
0008EFr 2  A2 FF          ldx #$FF                      ; Tens counter (starts at -1)
0008F1r 2               @BinToBcdLoop:
0008F1r 2  E8             inx
0008F2r 2  38             sec
0008F3r 2  E9 0A          sbc #10
0008F5r 2  B0 FA          bcs @BinToBcdLoop             ; Count tens
0008F7r 2  69 0A          adc #10                       ; Restore ones (carry clear, so adds 10 + 0)
0008F9r 2  8D 0C 03       sta RTC_TMP                   ; Save ones digit
0008FCr 2  8A             txa                           ; A = tens digit
0008FDr 2  0A             asl a
0008FEr 2  0A             asl a
0008FFr 2  0A             asl a
000900r 2  0A             asl a                         ; Shift tens to high nibble
000901r 2  0D 0C 03       ora RTC_TMP                   ; Combine with ones
000904r 2  60             rts
000905r 2               
000905r 2               ; === DS1511Y RTC Routines ===
000905r 2               
000905r 2               ; The clock registers at $8800-$8807 are double buffered.  A set of internal
000905r 2               ; counters does the actual timekeeping; what the CPU reads and writes is a
000905r 2               ; user-facing copy, and the TE bit in Control Register B decides how the two
000905r 2               ; are joined:
000905r 2               ;
000905r 2               ;   TE = 1  the counters are copied into the user registers once a second —
000905r 2               ;           the normal running state, and what makes a read see time advance
000905r 2               ;   TE = 0  that copy is inhibited, so the user registers hold one consistent
000905r 2               ;           instant.  Returning TE to 1 transfers the user registers back into
000905r 2               ;           the counters, which is how a write takes effect
000905r 2               ;
000905r 2               ; So a write brackets itself with RtcFreeze / RtcThaw, keeping the per-second
000905r 2               ; update from landing in the middle of the bytes being set and then committing
000905r 2               ; the lot.  Leaving TE set afterwards is not housekeeping, it is the whole
000905r 2               ; point: TE is battery-backed and no internal function of the part ever changes
000905r 2               ; it, so a TE left at 0 freezes the CPU's view of the clock indefinitely — the
000905r 2               ; counters go on counting, but every read returns the same instant, across
000905r 2               ; resets and power cycles alike, until something sets TE again.
000905r 2               ;
000905r 2               ; A read has a rollover to worry about — read the hour at 23:59:59 and the
000905r 2               ; minute a moment later and the answer is 23:00, an hour that never happened —
000905r 2               ; but it deliberately does not use TE for it.  Freezing would work, and is what
000905r 2               ; the part is for, except that the thaw both commits the user registers back
000905r 2               ; into the counters and restarts the second from zero; a program polling the
000905r 2               ; time in a loop would thereby hold the clock still.  Reading the seconds on
000905r 2               ; either side of the other registers and retrying if they differ costs nothing
000905r 2               ; and writes nothing.
000905r 2               
000905r 2               ; RtcFreeze — Clear TE, holding the user registers at one instant
000905r 2               ; Modifies: Flags, A
000905r 2               RtcFreeze:
000905r 2  AD 0F 88       lda RTC_CTRL_B
000908r 2  29 7F          and #<~RTC_CTRL_B_TE
00090Ar 2  8D 0F 88       sta RTC_CTRL_B
00090Dr 2  60             rts
00090Er 2               
00090Er 2               ; RtcThaw — Set TE, committing the user registers and resuming the updates
00090Er 2               ; Modifies: Flags, A
00090Er 2               RtcThaw:
00090Er 2  AD 0F 88       lda RTC_CTRL_B
000911r 2  09 80          ora #RTC_CTRL_B_TE
000913r 2  8D 0F 88       sta RTC_CTRL_B
000916r 2  60             rts
000917r 2               
000917r 2               ; RtcReadTime — Read current time from DS1511Y
000917r 2               ; Output: A = hours (binary), X = minutes (binary), Y = seconds (binary)
000917r 2               ; Modifies: Flags
000917r 2               RtcReadTimeImpl:
000917r 2  A0 02          ldy #2                        ; Attempts.  One retry is all a working clock
000919r 2               @Retry:                         ;   can need — a rollover cannot happen twice
000919r 2  AD 00 88       lda RTC_SEC                   ;   in the same second — and the count is what
00091Cr 2  8D 0C 03       sta RTC_TMP                   ;   keeps a floating bus, on a machine with no
00091Fr 2  AD 02 88       lda RTC_HR                    ;   card, from spinning here forever
000922r 2  48             pha                           ; Stacked raw: the seconds have to be compared
000923r 2  AD 01 88       lda RTC_MIN                   ;   before BcdToBin, which wants RTC_TMP itself
000926r 2  48             pha
000927r 2  AD 00 88       lda RTC_SEC                   ; Seconds after; unchanged means no rollover
00092Ar 2  CD 0C 03       cmp RTC_TMP                   ;   happened between the two reads above
00092Dr 2  F0 07          beq @Stable
00092Fr 2  88             dey
000930r 2  F0 04          beq @Stable                   ; Out of attempts: take what is there
000932r 2  68             pla                           ; Torn — drop the pair and read again
000933r 2  68             pla
000934r 2  80 E3          bra @Retry
000936r 2               @Stable:
000936r 2  20 rr rr       jsr BcdToBin                  ; A still holds the seconds
000939r 2  A8             tay                           ; Y = seconds
00093Ar 2  68             pla
00093Br 2  20 rr rr       jsr BcdToBin
00093Er 2  AA             tax                           ; X = minutes
00093Fr 2  68             pla
000940r 2  20 rr rr       jsr BcdToBin                  ; A = hours
000943r 2  60             rts
000944r 2               
000944r 2               ; RtcReadDate — Read current date from DS1511Y
000944r 2               ; Output: A = day of month (binary), X = month (binary), Y = year (binary)
000944r 2               ;         RTC_BUF_CENT = century (binary)
000944r 2               ; Modifies: Flags
000944r 2               RtcReadDateImpl:
000944r 2  A0 02          ldy #2                        ; Attempts, bounded as in RtcReadTime
000946r 2               @Retry:
000946r 2  AD 00 88       lda RTC_SEC                   ; The date rolls over on a second like anything
000949r 2  8D 0C 03       sta RTC_TMP                   ;   else, so it is guarded the same way
00094Cr 2  AD 04 88       lda RTC_DATE                  ; Pushed in reverse of the order they are
00094Fr 2  48             pha                           ;   wanted, so the day of month comes off last
000950r 2  AD 06 88       lda RTC_YR                    ;   and is already in A to return
000953r 2  48             pha
000954r 2  AD 05 88       lda RTC_MON
000957r 2  48             pha
000958r 2  AD 07 88       lda RTC_CENT
00095Br 2  48             pha
00095Cr 2  AD 00 88       lda RTC_SEC
00095Fr 2  CD 0C 03       cmp RTC_TMP
000962r 2  F0 09          beq @Stable
000964r 2  88             dey
000965r 2  F0 06          beq @Stable                   ; Out of attempts: take what is there
000967r 2  68             pla                           ; Torn — drop the four and read again
000968r 2  68             pla
000969r 2  68             pla
00096Ar 2  68             pla
00096Br 2  80 D9          bra @Retry
00096Dr 2               @Stable:
00096Dr 2  68             pla
00096Er 2  20 rr rr       jsr BcdToBin
000971r 2  8D 0B 03       sta RTC_BUF_CENT              ; Store century in buffer
000974r 2  68             pla
000975r 2  29 1F          and #RTC_MON_MASK             ; Strip control bits (EOSC/E32K/BB32) before BCD decode
000977r 2  20 rr rr       jsr BcdToBin
00097Ar 2  AA             tax                           ; X = month
00097Br 2  68             pla
00097Cr 2  20 rr rr       jsr BcdToBin
00097Fr 2  A8             tay                           ; Y = year
000980r 2  68             pla
000981r 2  20 rr rr       jsr BcdToBin                  ; A = day of month
000984r 2  60             rts
000985r 2               
000985r 2               ; RtcWriteTime — Set DS1511Y time
000985r 2               ; Input: A = hours (binary), X = minutes (binary), Y = seconds (binary)
000985r 2               ; Modifies: Flags, A, X
000985r 2               RtcWriteTimeImpl:
000985r 2  48             pha                           ; Save hours
000986r 2  DA             phx                           ; Save minutes
000987r 2  5A             phy                           ; Save seconds
000988r 2  20 rr rr       jsr RtcFreeze                 ; Hold off the once-a-second update
00098Br 2                 ; Write seconds
00098Br 2  68             pla                           ; A = seconds
00098Cr 2  20 rr rr       jsr BinToBcd
00098Fr 2  8D 00 88       sta RTC_SEC
000992r 2                 ; Write minutes
000992r 2  68             pla                           ; A = minutes
000993r 2  20 rr rr       jsr BinToBcd
000996r 2  8D 01 88       sta RTC_MIN
000999r 2                 ; Write hours
000999r 2  68             pla                           ; A = hours
00099Ar 2  20 rr rr       jsr BinToBcd
00099Dr 2  8D 02 88       sta RTC_HR
0009A0r 2  4C rr rr       jmp RtcThaw                   ; Commit the write and resume the updates
0009A3r 2               
0009A3r 2               ; RtcWriteDate — Set DS1511Y date
0009A3r 2               ; Input: A = day of month (binary), X = month (binary), Y = year (binary)
0009A3r 2               ;        RTC_BUF_CENT = century (binary)
0009A3r 2               ; Modifies: Flags, A, X
0009A3r 2               RtcWriteDateImpl:
0009A3r 2  48             pha                           ; Save day
0009A4r 2  DA             phx                           ; Save month
0009A5r 2  5A             phy                           ; Save year
0009A6r 2  20 rr rr       jsr RtcFreeze                 ; Hold off the once-a-second update
0009A9r 2                 ; Write century
0009A9r 2  AD 0B 03       lda RTC_BUF_CENT
0009ACr 2  20 rr rr       jsr BinToBcd
0009AFr 2  8D 07 88       sta RTC_CENT
0009B2r 2                 ; Write year
0009B2r 2  68             pla                           ; A = year
0009B3r 2  20 rr rr       jsr BinToBcd
0009B6r 2  8D 06 88       sta RTC_YR
0009B9r 2                 ; Write month
0009B9r 2  68             pla                           ; A = month
0009BAr 2  20 rr rr       jsr BinToBcd
0009BDr 2  29 1F          and #RTC_MON_MASK             ; Keep only the month value bits
0009BFr 2  8D 0C 03       sta RTC_TMP
0009C2r 2  AD 05 88       lda RTC_MON
0009C5r 2  29 E0          and #<~RTC_MON_MASK           ; Preserve control bits (EOSC/E32K/BB32)
0009C7r 2  0D 0C 03       ora RTC_TMP
0009CAr 2  8D 05 88       sta RTC_MON
0009CDr 2                 ; Write day
0009CDr 2  68             pla                           ; A = day
0009CEr 2  20 rr rr       jsr BinToBcd
0009D1r 2  8D 04 88       sta RTC_DATE
0009D4r 2  4C rr rr       jmp RtcThaw                   ; Commit the write and resume the updates
0009D7r 2               
0009D7r 2               ; RtcReadNVRAM — Read a byte from DS1511Y NVRAM
0009D7r 2               ; Input: X = NVRAM address ($00-$FF)
0009D7r 2               ; Output: A = data byte
0009D7r 2               ; Modifies: Flags
0009D7r 2               RtcReadNVRAMImpl:
0009D7r 2  8E 10 88       stx RTC_RAM_ADDR
0009DAr 2  AD 13 88       lda RTC_RAM_DATA
0009DDr 2  60             rts
0009DEr 2               
0009DEr 2               ; RtcWriteNVRAM — Write a byte to DS1511Y NVRAM
0009DEr 2               ; Input: X = NVRAM address ($00-$FF), A = data byte
0009DEr 2               ; Modifies: Flags
0009DEr 2               RtcWriteNVRAMImpl:
0009DEr 2  8E 10 88       stx RTC_RAM_ADDR
0009E1r 2  8D 13 88       sta RTC_RAM_DATA
0009E4r 2  60             rts
0009E5r 2               
0009E5r 2               ; === NVRAM Save Slots ===
0009E5r 2               ;
0009E5r 2               ; The 256 NVRAM bytes are 16 slots of 16 bytes; slot n starts at NVRAM n*16:
0009E5r 2               ;
0009E5r 2               ;   +$0      owner ID     $00 = free, otherwise a game-chosen identity byte
0009E5r 2               ;   +$1      checksum     over the owner ID and the 14 payload bytes
0009E5r 2               ;   +$2-$F   payload
0009E5r 2               ;
0009E5r 2               ; Checksum: ck = NV_CK_SEED, then ck = rol8(ck) EOR b for each covered byte.
0009E5r 2               ; The 8-bit rotate is asl / adc #0, which is why these routines clear D.
0009E5r 2               ;
0009E5r 2               ; Contract shared by all six:
0009E5r 2               ;   * Carry set means the call did nothing: no RTC card, slot >= NV_SLOTS, and
0009E5r 2               ;     the per-routine cases documented on each.
0009E5r 2               ;   * The caller's D and I flags come back unchanged.  Interrupts are masked for
0009E5r 2               ;     the duration, because the slot copies use burst mode, where every access
0009E5r 2               ;     of RTC_RAM_DATA advances the address latch — an IRQ handler touching NVRAM
0009E5r 2               ;     mid-copy would corrupt the save.  A user NMI handler must not touch NVRAM.
0009E5r 2               ;   * BME is clear on exit, so RtcReadNVRAM / RtcWriteNVRAM keep their
0009E5r 2               ;     single-byte behaviour.
0009E5r 2               ;   * While BME is set, RTC_RAM_DATA is only ever touched with plain absolute
0009E5r 2               ;     addressing: one instruction, one bus access, one step of the latch.
0009E5r 2               
0009E5r 2               ; NvStat — Report a slot's state
0009E5r 2               ; Input: X = slot (0-15)
0009E5r 2               ; Output: A = NV_EMPTY / NV_VALID / NV_BAD, Y = owner ID, C clear
0009E5r 2               ;         C set on no RTC or bad slot (A, Y undefined)
0009E5r 2               ; Modifies: Flags (D and I preserved), A, Y
0009E5r 2               NvStatImpl:
0009E5r 2  08             php
0009E6r 2  78             sei
0009E7r 2  D8             cld
0009E8r 2  20 rr rr       jsr NvCheck
0009EBr 2  B0 3B          bcs NvFail
0009EDr 2  20 rr rr       jsr NvScan
0009F0r 2  4C rr rr       jmp NvOk
0009F3r 2               
0009F3r 2               ; NvRead — Copy a valid slot's 14 payload bytes to the caller's buffer
0009F3r 2               ; Input: X = slot (0-15), A/Y = destination lo/hi
0009F3r 2               ; Output: A = status, Y = owner ID; C clear and the buffer written only if A = NV_VALID
0009F3r 2               ;         C set on no RTC or bad slot (A, Y undefined), or a slot that is not
0009F3r 2               ;         valid (A = its status, Y = its owner ID) — the buffer is untouched
0009F3r 2               ; Modifies: Flags (D and I preserved), A, Y, NV_PTR
0009F3r 2               NvReadImpl:
0009F3r 2  08             php
0009F4r 2  78             sei
0009F5r 2  D8             cld
0009F6r 2  85 02          sta NV_PTR
0009F8r 2  84 03          sty NV_PTR+1
0009FAr 2  20 rr rr       jsr NvCheck
0009FDr 2  B0 29          bcs NvFail
0009FFr 2  20 rr rr       jsr NvScan
000A02r 2  C9 01          cmp #NV_VALID
000A04r 2  D0 22          bne NvFail                    ; Nothing copied until the slot has validated
000A06r 2  5A             phy                           ; Owner ID
000A07r 2  20 rr rr       jsr NvBurstStart
000A0Ar 2  AD 13 88       lda RTC_RAM_DATA              ; Step past the owner ID...
000A0Dr 2  AD 13 88       lda RTC_RAM_DATA              ;   ...and the checksum
000A10r 2  A0 00          ldy #0
000A12r 2               @Copy:
000A12r 2  AD 13 88       lda RTC_RAM_DATA
000A15r 2  91 02          sta (NV_PTR),y
000A17r 2  C8             iny
000A18r 2  C0 0E          cpy #NV_SLOT_DATA
000A1Ar 2  D0 F6          bne @Copy
000A1Cr 2  20 rr rr       jsr NvBurstEnd
000A1Fr 2  7A             ply
000A20r 2  A9 01          lda #NV_VALID
000A22r 2  4C rr rr       jmp NvOk
000A25r 2               
000A25r 2               ; NvOk / NvFail — Common exits: restore the caller's flags, then report
000A25r 2               ; Entered by jmp with the P byte an entry's php pushed on top of the stack.
000A25r 2               ; A, X and Y pass through untouched.
000A25r 2               NvOk:
000A25r 2  28             plp
000A26r 2  18             clc
000A27r 2  60             rts
000A28r 2               NvFail:
000A28r 2  28             plp
000A29r 2  38             sec
000A2Ar 2  60             rts
000A2Br 2               
000A2Br 2               ; NvFind — Find the lowest slot whose owner ID is A
000A2Br 2               ; Matches any non-free slot, valid or damaged; A = $00 finds the lowest free slot.
000A2Br 2               ; Input: A = owner ID
000A2Br 2               ; Output: X = slot, C clear; C set if no slot matched (X undefined)
000A2Br 2               ; Modifies: Flags (I preserved), A, X, RTC_TMP
000A2Br 2               NvFindImpl:
000A2Br 2  08             php
000A2Cr 2  78             sei
000A2Dr 2  8D 0C 03       sta RTC_TMP
000A30r 2  AD 0D 03       lda HW_PRESENT
000A33r 2  29 04          and #HW_RTC
000A35r 2  F0 F1          beq NvFail
000A37r 2  A2 00          ldx #0
000A39r 2               @Next:
000A39r 2  8A             txa
000A3Ar 2  0A             asl a
000A3Br 2  0A             asl a
000A3Cr 2  0A             asl a
000A3Dr 2  0A             asl a
000A3Er 2  8D 10 88       sta RTC_RAM_ADDR              ; One byte per slot, so no burst: the latch is
000A41r 2  AD 13 88       lda RTC_RAM_DATA              ;   set afresh each time
000A44r 2  CD 0C 03       cmp RTC_TMP
000A47r 2  F0 DC          beq NvOk
000A49r 2  E8             inx
000A4Ar 2  E0 10          cpx #NV_SLOTS
000A4Cr 2  D0 EB          bne @Next
000A4Er 2  F0 D8          beq NvFail
000A50r 2               
000A50r 2               ; NvErase — Zero all 16 bytes of a slot, so nothing of the old save is legible
000A50r 2               ; Input: X = slot (0-15)
000A50r 2               ; Output: C clear; C set on no RTC or bad slot
000A50r 2               ; Modifies: Flags (I preserved), A, Y
000A50r 2               NvEraseImpl:
000A50r 2  08             php
000A51r 2  78             sei
000A52r 2  20 rr rr       jsr NvCheck
000A55r 2  B0 D1          bcs NvFail
000A57r 2  20 rr rr       jsr NvBurstStart
000A5Ar 2  A0 10          ldy #NV_SLOT_SIZE
000A5Cr 2               @Zero:
000A5Cr 2  9C 13 88       stz RTC_RAM_DATA
000A5Fr 2  88             dey
000A60r 2  D0 FA          bne @Zero
000A62r 2  20 rr rr       jsr NvBurstEnd
000A65r 2  4C rr rr       jmp NvOk
000A68r 2               
000A68r 2               ; NvWrite — Write a slot: owner ID, checksum and 14 payload bytes
000A68r 2               ; Input: X = slot (0-15), A/Y = source lo/hi, NV_ID = owner ID ($01-$FF)
000A68r 2               ; Output: C clear; C set on no RTC, bad slot, or NV_ID = 0 (nothing written)
000A68r 2               ; Modifies: Flags (D and I preserved), A, Y, NV_PTR
000A68r 2               NvWriteImpl:
000A68r 2  08             php
000A69r 2  78             sei
000A6Ar 2  D8             cld
000A6Br 2  85 02          sta NV_PTR
000A6Dr 2  84 03          sty NV_PTR+1
000A6Fr 2  20 rr rr       jsr NvCheck
000A72r 2  B0 B4          bcs NvFail
000A74r 2  AD 90 03       lda NV_ID
000A77r 2  F0 AF          beq NvFail                    ; ID 0 marks a free slot — that is NvErase
000A79r 2  A9 A6          lda #NV_CK_SEED               ; Checksum first, from the caller's buffer
000A7Br 2  0A             asl a
000A7Cr 2  69 00          adc #$00
000A7Er 2  4D 90 03       eor NV_ID
000A81r 2  A0 00          ldy #0
000A83r 2               @Sum:
000A83r 2  0A             asl a
000A84r 2  69 00          adc #$00
000A86r 2  51 02          eor (NV_PTR),y
000A88r 2  C8             iny
000A89r 2  C0 0E          cpy #NV_SLOT_DATA
000A8Br 2  D0 F6          bne @Sum
000A8Dr 2  8D 0C 03       sta RTC_TMP
000A90r 2  20 rr rr       jsr NvBurstStart
000A93r 2  AD 90 03       lda NV_ID
000A96r 2  8D 13 88       sta RTC_RAM_DATA
000A99r 2  AD 0C 03       lda RTC_TMP
000A9Cr 2  8D 13 88       sta RTC_RAM_DATA
000A9Fr 2  A0 00          ldy #0
000AA1r 2               @Copy:
000AA1r 2  B1 02          lda (NV_PTR),y
000AA3r 2  8D 13 88       sta RTC_RAM_DATA
000AA6r 2  C8             iny
000AA7r 2  C0 0E          cpy #NV_SLOT_DATA
000AA9r 2  D0 F6          bne @Copy
000AABr 2  20 rr rr       jsr NvBurstEnd
000AAEr 2  4C rr rr       jmp NvOk
000AB1r 2               
000AB1r 2               ; NvFormat — Erase all 16 slots
000AB1r 2               ; Output: C clear; C set on no RTC
000AB1r 2               ; Modifies: Flags, A, X, Y
000AB1r 2               NvFormatImpl:
000AB1r 2  A2 0F          ldx #NV_SLOTS-1
000AB3r 2               @Next:
000AB3r 2  20 rr rr       jsr NvEraseImpl
000AB6r 2  B0 03          bcs @Done
000AB8r 2  CA             dex
000AB9r 2  10 F8          bpl @Next
000ABBr 2               @Done:
000ABBr 2  60             rts
000ABCr 2               
000ABCr 2               ; NvCheck — Fail unless an RTC is fitted and X names a slot
000ABCr 2               ; Input: X = slot
000ABCr 2               ; Output: C set if no RTC or X >= NV_SLOTS
000ABCr 2               ; Modifies: Flags, A
000ABCr 2               NvCheck:
000ABCr 2  AD 0D 03       lda HW_PRESENT
000ABFr 2  29 04          and #HW_RTC
000AC1r 2  F0 03          beq @Fail
000AC3r 2  E0 10          cpx #NV_SLOTS                 ; C = X >= NV_SLOTS
000AC5r 2  60             rts
000AC6r 2               @Fail:
000AC6r 2  38             sec
000AC7r 2  60             rts
000AC8r 2               
000AC8r 2               ; NvScan — Read slot X's header and validate its checksum
000AC8r 2               ; Input: X = slot (already checked), D clear, interrupts masked
000AC8r 2               ; Output: A = NV_EMPTY / NV_VALID / NV_BAD, Y = owner ID
000AC8r 2               ; Modifies: Flags, A, Y, RTC_TMP
000AC8r 2               NvScan:
000AC8r 2  20 rr rr       jsr NvBurstStart
000ACBr 2  AD 13 88       lda RTC_RAM_DATA              ; Owner ID
000ACEr 2  48             pha
000ACFr 2  8D 0C 03       sta RTC_TMP
000AD2r 2  A9 A6          lda #NV_CK_SEED               ; Fold in the owner ID
000AD4r 2  0A             asl a
000AD5r 2  69 00          adc #$00
000AD7r 2  4D 0C 03       eor RTC_TMP
000ADAr 2  AC 13 88       ldy RTC_RAM_DATA              ; Stored checksum
000ADDr 2  8C 0C 03       sty RTC_TMP
000AE0r 2  A0 0E          ldy #NV_SLOT_DATA
000AE2r 2               @Sum:
000AE2r 2  0A             asl a                         ; Rotate left: bit 7 into carry...
000AE3r 2  69 00          adc #$00                      ;   ...and back into bit 0
000AE5r 2  4D 13 88       eor RTC_RAM_DATA              ; Next payload byte
000AE8r 2  88             dey
000AE9r 2  D0 F7          bne @Sum
000AEBr 2  4D 0C 03       eor RTC_TMP                   ; 0 when the checksum agrees
000AEEr 2  8D 0C 03       sta RTC_TMP
000AF1r 2  20 rr rr       jsr NvBurstEnd
000AF4r 2  7A             ply                           ; Y = owner ID
000AF5r 2  F0 0B          beq @Empty
000AF7r 2  AD 0C 03       lda RTC_TMP
000AFAr 2  F0 03          beq @Valid
000AFCr 2  A9 02          lda #NV_BAD
000AFEr 2  60             rts
000AFFr 2               @Valid:
000AFFr 2  A9 01          lda #NV_VALID
000B01r 2  60             rts
000B02r 2               @Empty:
000B02r 2  A9 00          lda #NV_EMPTY
000B04r 2  60             rts
000B05r 2               
000B05r 2               ; NvBurstStart — Point the NVRAM latch at slot X and enable burst mode
000B05r 2               ; Input: X = slot
000B05r 2               ; Modifies: Flags, A
000B05r 2               NvBurstStart:
000B05r 2  8A             txa
000B06r 2  0A             asl a                         ; Slot base = slot * 16
000B07r 2  0A             asl a
000B08r 2  0A             asl a
000B09r 2  0A             asl a
000B0Ar 2  8D 10 88       sta RTC_RAM_ADDR
000B0Dr 2  AD 0F 88       lda RTC_CTRL_B                ; Read-modify-write: Control B also holds TE
000B10r 2  09 20          ora #RTC_CTRL_B_BME
000B12r 2  8D 0F 88       sta RTC_CTRL_B
000B15r 2  60             rts
000B16r 2               
000B16r 2               ; NvBurstEnd — Disable burst mode
000B16r 2               ; Modifies: Flags, A
000B16r 2               NvBurstEnd:
000B16r 2  AD 0F 88       lda RTC_CTRL_B
000B19r 2  29 DF          and #<~RTC_CTRL_B_BME
000B1Br 2  8D 0F 88       sta RTC_CTRL_B
000B1Er 2  60             rts
000B1Fr 2               
000B1Fr 2               ; === Hardware Probes ===
000B1Fr 2               
000B1Fr 2               ; ProbeRAM — Test for banked SRAM on IO 1 and IO 2
000B1Fr 2               ; Two-pattern read-back test ($A5 then $5A) on bank 0 data byte
000B1Fr 2               ; Sets HW_RAM_L / HW_RAM_H in HW_PRESENT on success
000B1Fr 2               ; Modifies: Flags, A
000B1Fr 2               ProbeRAM:
000B1Fr 2                 ; A naive "write byte, immediately read it back" test is unreliable: with no
000B1Fr 2                 ; SRAM responding, bus/parasitic capacitance holds the just-written value for
000B1Fr 2                 ; a cycle or two, so the read-back matches and the probe falsely passes.
000B1Fr 2                 ; Instead we write complementary patterns into TWO different banks, then read
000B1Fr 2                 ; them back AFTER intervening bus cycles (opcode fetches from ROM + a second
000B1Fr 2                 ; bank's data) have flushed the bus. This forces the chip to actually store
000B1Fr 2                 ; distinct values and also exercises the bank-select latch. Open bus cannot
000B1Fr 2                 ; fake both reads. Bank-0/bank-1 byte 0 are saved and restored.
000B1Fr 2               
000B1Fr 2                 ; --- Probe RAM Low (IO 1) ---
000B1Fr 2  9C FF 83       stz RAM_BANK_L                ; Bank 0
000B22r 2  AD 00 80       lda RAM_DATA_L                ; Save bank-0 byte 0
000B25r 2  48             pha
000B26r 2  A9 01          lda #$01
000B28r 2  8D FF 83       sta RAM_BANK_L                ; Bank 1
000B2Br 2  AD 00 80       lda RAM_DATA_L                ; Save bank-1 byte 0
000B2Er 2  48             pha
000B2Fr 2  9C FF 83       stz RAM_BANK_L               ; Bank 0
000B32r 2  A9 A5          lda #$A5
000B34r 2  8D 00 80       sta RAM_DATA_L                ; bank0[0] = $A5
000B37r 2  A9 01          lda #$01
000B39r 2  8D FF 83       sta RAM_BANK_L                ; Bank 1
000B3Cr 2  A9 5A          lda #$5A
000B3Er 2  8D 00 80       sta RAM_DATA_L                ; bank1[0] = $5A (flips data + address lines)
000B41r 2  9C FF 83       stz RAM_BANK_L               ; Back to bank 0
000B44r 2  AD 00 80       lda RAM_DATA_L               ; Read bank0[0] (bus no longer holds $A5)
000B47r 2  C9 A5          cmp #$A5
000B49r 2  D0 14          bne @RAMLRestore             ; Bank 0 did not retain its value
000B4Br 2  A9 01          lda #$01
000B4Dr 2  8D FF 83       sta RAM_BANK_L                ; Bank 1
000B50r 2  AD 00 80       lda RAM_DATA_L               ; Read bank1[0]
000B53r 2  C9 5A          cmp #$5A
000B55r 2  D0 08          bne @RAMLRestore             ; Bank 1 did not retain (or latch failed)
000B57r 2  AD 0D 03       lda HW_PRESENT
000B5Ar 2  09 01          ora #HW_RAM_L
000B5Cr 2  8D 0D 03       sta HW_PRESENT
000B5Fr 2               @RAMLRestore:
000B5Fr 2  A9 01          lda #$01
000B61r 2  8D FF 83       sta RAM_BANK_L                ; Bank 1
000B64r 2  68             pla
000B65r 2  8D 00 80       sta RAM_DATA_L                ; Restore bank-1 byte 0
000B68r 2  9C FF 83       stz RAM_BANK_L               ; Bank 0
000B6Br 2  68             pla
000B6Cr 2  8D 00 80       sta RAM_DATA_L                ; Restore bank-0 byte 0
000B6Fr 2               
000B6Fr 2                 ; --- Probe RAM High (IO 2) ---
000B6Fr 2  9C FF 87       stz RAM_BANK_H                ; Bank 0
000B72r 2  AD 00 84       lda RAM_DATA_H                ; Save bank-0 byte 0
000B75r 2  48             pha
000B76r 2  A9 01          lda #$01
000B78r 2  8D FF 87       sta RAM_BANK_H                ; Bank 1
000B7Br 2  AD 00 84       lda RAM_DATA_H                ; Save bank-1 byte 0
000B7Er 2  48             pha
000B7Fr 2  9C FF 87       stz RAM_BANK_H               ; Bank 0
000B82r 2  A9 A5          lda #$A5
000B84r 2  8D 00 84       sta RAM_DATA_H                ; bank0[0] = $A5
000B87r 2  A9 01          lda #$01
000B89r 2  8D FF 87       sta RAM_BANK_H                ; Bank 1
000B8Cr 2  A9 5A          lda #$5A
000B8Er 2  8D 00 84       sta RAM_DATA_H                ; bank1[0] = $5A (flips data + address lines)
000B91r 2  9C FF 87       stz RAM_BANK_H               ; Back to bank 0
000B94r 2  AD 00 84       lda RAM_DATA_H               ; Read bank0[0] (bus no longer holds $A5)
000B97r 2  C9 A5          cmp #$A5
000B99r 2  D0 14          bne @RAMHRestore             ; Bank 0 did not retain its value
000B9Br 2  A9 01          lda #$01
000B9Dr 2  8D FF 87       sta RAM_BANK_H                ; Bank 1
000BA0r 2  AD 00 84       lda RAM_DATA_H               ; Read bank1[0]
000BA3r 2  C9 5A          cmp #$5A
000BA5r 2  D0 08          bne @RAMHRestore             ; Bank 1 did not retain (or latch failed)
000BA7r 2  AD 0D 03       lda HW_PRESENT
000BAAr 2  09 02          ora #HW_RAM_H
000BACr 2  8D 0D 03       sta HW_PRESENT
000BAFr 2               @RAMHRestore:
000BAFr 2  A9 01          lda #$01
000BB1r 2  8D FF 87       sta RAM_BANK_H                ; Bank 1
000BB4r 2  68             pla
000BB5r 2  8D 00 84       sta RAM_DATA_H                ; Restore bank-1 byte 0
000BB8r 2  9C FF 87       stz RAM_BANK_H               ; Bank 0
000BBBr 2  68             pla
000BBCr 2  8D 00 84       sta RAM_DATA_H                ; Restore bank-0 byte 0
000BBFr 2  60             rts
000BC0r 2               
000BC0r 2               ; ProbeVideo — identify a 6502-PICOVDP (SPEC §16)
000BC0r 2               ; Selects STAT4 on port A and looks for the identification byte.  Only a PICOVDP
000BC0r 2               ; is video: an empty slot reads something else, and a TMS9918A decodes three
000BC0r 2               ; register bits, takes the select as a harmless register 7 write, and is left
000BC0r 2               ; alone after that.  On a PICOVDP, records STAT5 in VDP_FW and STAT6 in
000BC0r 2               ; VDP_CAPS and puts STATSEL_A back to STAT0.  HW_VID means a PICOVDP with the
000BC0r 2               ; built-in font, so it is set only if STAT6 b7 is: the Kernal has no character
000BC0r 2               ; set of its own to fall back on.  STAT5 gates nothing.
000BC0r 2               ; Modifies: Flags, A, VDP_FW, VDP_CAPS
000BC0r 2               ProbeVideo:
000BC0r 2  9C 94 03       stz VDP_FW                    ; No card until one answers
000BC3r 2  9C 95 03       stz VDP_CAPS
000BC6r 2  AD 01 9C       lda VC_STATUS                 ; Resynchronise the command flip-flop (and, on
000BC9r 2                                               ;   a TMS9918A, clear the flags that could
000BC9r 2                                               ;   otherwise read as $AC)
000BC9r 2  A9 04          lda #$04
000BCBr 2  20 rr rr       jsr VdpSelectStat
000BCEr 2  AD 01 9C       lda VC_STATUS                 ; STAT4
000BD1r 2  C9 AC          cmp #VDP_ID
000BD3r 2  D0 1E          bne @ProbeVideoDone           ; Not a PICOVDP: nothing more is written
000BD5r 2  A9 05          lda #$05
000BD7r 2  20 rr rr       jsr VdpSelectStat
000BDAr 2  AD 01 9C       lda VC_STATUS
000BDDr 2  8D 94 03       sta VDP_FW                    ; STAT5: firmware version, BCD
000BE0r 2  A9 06          lda #$06
000BE2r 2  20 rr rr       jsr VdpReadStat               ; And STATSEL_A back to STAT0
000BE5r 2  8D 95 03       sta VDP_CAPS                  ; STAT6: capability bits
000BE8r 2  0A             asl a                         ; b7, the built-in font, into carry
000BE9r 2  90 08          bcc @ProbeVideoDone           ; No font: not a console
000BEBr 2  AD 0D 03       lda HW_PRESENT
000BEEr 2  09 80          ora #HW_VID
000BF0r 2  8D 0D 03       sta HW_PRESENT
000BF3r 2               @ProbeVideoDone:
000BF3r 2  60             rts
000BF4r 2               
000BF4r 2               ; ProbeGPIO — VIA DDR register read-back test
000BF4r 2               ; Writes $AA to GPIO_DDRB, reads it back
000BF4r 2               ; Sets HW_GPIO in HW_PRESENT on success
000BF4r 2               ; Restores GPIO_DDRB to $00 afterward
000BF4r 2               ; Modifies: Flags, A
000BF4r 2               ProbeGPIO:
000BF4r 2  A9 AA          lda #$AA
000BF6r 2  8D 02 94       sta GPIO_DDRB
000BF9r 2  CD 02 94       cmp GPIO_DDRB
000BFCr 2  D0 08          bne @ProbeGPIODone
000BFEr 2  AD 0D 03       lda HW_PRESENT
000C01r 2  09 20          ora #HW_GPIO
000C03r 2  8D 0D 03       sta HW_PRESENT
000C06r 2               @ProbeGPIODone:
000C06r 2  9C 02 94       stz GPIO_DDRB                 ; Restore to inputs (InitKBImpl will configure properly)
000C09r 2  60             rts
000C0Ar 2               
000C0Ar 2               ; ProbeSerial — R65C51 CMD register write/read-back test
000C0Ar 2               ; Issues programmatic reset, writes test value to CMD, reads back
000C0Ar 2               ; Open bus will not match — prevents false detection
000C0Ar 2               ; Sets HW_SC in HW_PRESENT on success
000C0Ar 2               ; Modifies: Flags, A
000C0Ar 2               ProbeSerial:
000C0Ar 2  9C 01 90       stz SC_RESET                  ; Programmatic reset (write any value)
000C0Dr 2  A9 0A          lda #$0A                      ; Test value (bits within CMD writable range)
000C0Fr 2  8D 02 90       sta SC_CMD                    ; Write to Command Register
000C12r 2  CD 02 90       cmp SC_CMD                    ; Read back — should match if real hardware
000C15r 2  D0 08          bne @ProbeSerialDone          ; Mismatch = open bus, no card present
000C17r 2  AD 0D 03       lda HW_PRESENT
000C1Ar 2  09 10          ora #HW_SC
000C1Cr 2  8D 0D 03       sta HW_PRESENT
000C1Fr 2               @ProbeSerialDone:
000C1Fr 2  60             rts
000C20r 2               
000C20r 2               ; ProbeSID — Active oscillator test using voice 3
000C20r 2               ; Configures voice 3 noise waveform, brief delay, reads SID_OSC3
000C20r 2               ; Non-zero and non-$FF result indicates SID present
000C20r 2               ; Sets HW_SID in HW_PRESENT on success
000C20r 2               ; Modifies: Flags, A, X, Y
000C20r 2               ProbeSID:
000C20r 2                 ; Set voice 3 frequency to a fast value
000C20r 2  A9 FF          lda #$FF
000C22r 2  8D 0E 98       sta SID_V3_FREQ_LO
000C25r 2  8D 0F 98       sta SID_V3_FREQ_HI
000C28r 2                 ; Gate on + noise waveform
000C28r 2  A9 81          lda #(SID_CTRL_GATE | SID_CTRL_NOISE)
000C2Ar 2  8D 12 98       sta SID_V3_CTRL
000C2Dr 2                 ; Brief software delay for oscillator to run
000C2Dr 2  A0 00          ldy #$00
000C2Fr 2               @ProbeSIDDelay:
000C2Fr 2  88             dey
000C30r 2  D0 FD          bne @ProbeSIDDelay            ; ~1280 cycles
000C32r 2                 ; Read oscillator 3 output
000C32r 2  AD 1B 98       lda SID_OSC3
000C35r 2  F0 0E          beq @ProbeSIDCleanup          ; Zero → no SID
000C37r 2  C9 FF          cmp #$FF
000C39r 2  F0 0A          beq @ProbeSIDCleanup          ; $FF → likely floating bus
000C3Br 2                 ; SID detected
000C3Br 2  48             pha
000C3Cr 2  AD 0D 03       lda HW_PRESENT
000C3Fr 2  09 40          ora #HW_SID
000C41r 2  8D 0D 03       sta HW_PRESENT
000C44r 2  68             pla
000C45r 2               @ProbeSIDCleanup:
000C45r 2                 ; Silence voice 3
000C45r 2  9C 12 98       stz SID_V3_CTRL
000C48r 2  9C 0E 98       stz SID_V3_FREQ_LO
000C4Br 2  9C 0F 98       stz SID_V3_FREQ_HI
000C4Er 2  60             rts
000C4Fr 2               
000C4Fr 2               ; ProbeRTC — DS1511Y NVRAM read-back test
000C4Fr 2               ; Writes test pattern to NVRAM address 0, reads it back
000C4Fr 2               ; Sets HW_RTC in HW_PRESENT on success
000C4Fr 2               ; Restores original NVRAM value afterward
000C4Fr 2               ; Modifies: Flags, A
000C4Fr 2               ProbeRTC:
000C4Fr 2                 ; BME is battery-backed and undefined at power-up, like TE beside it.  Left set,
000C4Fr 2                 ; every access of RTC_RAM_DATA below would advance the address latch: the
000C4Fr 2                 ; read-back would compare against the wrong byte, HW_RTC would never be set,
000C4Fr 2                 ; and the restore would land on a third address.  So clear it before the RAM
000C4Fr 2                 ; ports are touched — read-modify-write, since Control B also holds TE.
000C4Fr 2  AD 0F 88       lda RTC_CTRL_B
000C52r 2  29 DF          and #<~RTC_CTRL_B_BME
000C54r 2  8D 0F 88       sta RTC_CTRL_B
000C57r 2  9C 10 88       stz RTC_RAM_ADDR              ; Select NVRAM address 0
000C5Ar 2  AD 13 88       lda RTC_RAM_DATA              ; Save existing value
000C5Dr 2  48             pha
000C5Er 2  A9 A5          lda #$A5
000C60r 2  8D 13 88       sta RTC_RAM_DATA              ; Write test pattern
000C63r 2  CD 13 88       cmp RTC_RAM_DATA              ; Read back
000C66r 2  D0 18          bne @ProbeRTCDone
000C68r 2  AD 0D 03       lda HW_PRESENT
000C6Br 2  09 04          ora #HW_RTC
000C6Dr 2  8D 0D 03       sta HW_PRESENT
000C70r 2                 ; The DS1511Y SQW pin feeds the AB Controller, which turns every SQW edge into
000C70r 2                 ; a 6502 NMI. Its control bits power up undefined and are battery-backed, so
000C70r 2                 ; explicitly disable the square-wave output here. E32K/BB32/EOSC live in the
000C70r 2                 ; upper 3 bits of the month register (05H); keep the month value and leave the
000C70r 2                 ; oscillator running.
000C70r 2                 ;
000C70r 2                 ; Bracketed like any other clock write, since 05H carries the month as well as
000C70r 2                 ; the control bits. The thaw doubles as a repair: TE is battery-backed, so a
000C70r 2                 ; board whose TE was left at 0 reads a stopped clock forever, and setting it
000C70r 2                 ; here is the only thing that starts the readout moving again.
000C70r 2  20 rr rr       jsr RtcFreeze
000C73r 2  AD 05 88       lda RTC_MON
000C76r 2  29 1F          and #RTC_MON_MASK             ; Keep month value (low 5 bits)
000C78r 2  09 40          ora #RTC_MON_E32K             ; E32K=1 → SQW disabled; BB32=0, EOSC=0
000C7Ar 2  8D 05 88       sta RTC_MON
000C7Dr 2  20 rr rr       jsr RtcThaw
000C80r 2               @ProbeRTCDone:
000C80r 2  68             pla
000C81r 2  8D 13 88       sta RTC_RAM_DATA              ; Restore original value
000C84r 2  60             rts
000C85r 2               
000C85r 2               ; === CompactFlash Storage Driver (True 8-bit IDE Mode) ===
000C85r 2               
000C85r 2               ; StWaitReady — Wait for CompactFlash to become ready
000C85r 2               ; Polls ST_STATUS until BSY=0 and RDY=1, with X/Y timeout (~65536 iterations)
000C85r 2               ; Output: Carry clear = ready, Carry set = error or timeout
000C85r 2               ; Modifies: Flags, A, X, Y
000C85r 2               StWaitReadyImpl:
000C85r 2  AD 0D 03       lda HW_PRESENT
000C88r 2  29 08          and #HW_CF
000C8Ar 2  D0 02          bne StWaitReadyPoll           ; Card fitted — poll it
000C8Cr 2  38             sec                           ; No card: fail now rather than spinning out a
000C8Dr 2  60             rts                           ;   65536-iteration timeout per sector.  This is
000C8Er 2                                               ;   the one guard the whole storage stack needs
000C8Er 2                                               ;   — every read, write and directory listing
000C8Er 2                                               ;   comes through here first — so a caller on
000C8Er 2                                               ;   a machine with an empty slot gets carry set
000C8Er 2                                               ;   without carrying a presence check of its
000C8Er 2                                               ;   own.
000C8Er 2               
000C8Er 2               ; StWaitReadyPoll — the same wait without the presence check, for the probe that
000C8Er 2               ; establishes presence in the first place.
000C8Er 2               StWaitReadyPoll:
000C8Er 2  A2 00          ldx #$00                      ; Outer timeout counter (256 × 256 = 65536 iterations)
000C90r 2  A0 00          ldy #$00
000C92r 2               @StWaitBsy:
000C92r 2  AD 07 8C       lda ST_STATUS
000C95r 2  29 80          and #ST_STATUS_BSY            ; Check BSY bit
000C97r 2  F0 08          beq @StCheckRdy               ; BSY clear — check RDY
000C99r 2  88             dey
000C9Ar 2  D0 F6          bne @StWaitBsy
000C9Cr 2  CA             dex
000C9Dr 2  D0 F3          bne @StWaitBsy
000C9Fr 2  38             sec                           ; Timed out — no device
000CA0r 2  60             rts
000CA1r 2               @StCheckRdy:
000CA1r 2  AD 07 8C       lda ST_STATUS
000CA4r 2  29 40          and #ST_STATUS_RDY            ; Check RDY bit
000CA6r 2  D0 08          bne @StCheckErr               ; RDY set — check for errors
000CA8r 2  88             dey
000CA9r 2  D0 E7          bne @StWaitBsy
000CABr 2  CA             dex
000CACr 2  D0 E4          bne @StWaitBsy
000CAEr 2  38             sec                           ; Timed out
000CAFr 2  60             rts
000CB0r 2               @StCheckErr:
000CB0r 2  AD 07 8C       lda ST_STATUS
000CB3r 2  29 01          and #ST_STATUS_ERR            ; Check ERR bit
000CB5r 2  D0 02          bne @StWaitErr
000CB7r 2  18             clc                           ; Ready, no error
000CB8r 2  60             rts
000CB9r 2               @StWaitErr:
000CB9r 2  38             sec                           ; Error condition
000CBAr 2  60             rts
000CBBr 2               
000CBBr 2               ; StWaitDrq — Wait for CompactFlash data request
000CBBr 2               ; Polls ST_STATUS until BSY=0 and DRQ=1, with X/Y timeout (~65536 iterations)
000CBBr 2               ; Output: Carry clear = DRQ active, Carry set = error or timeout
000CBBr 2               ; Modifies: Flags, A, X, Y
000CBBr 2               StWaitDrq:
000CBBr 2  A2 00          ldx #$00                      ; Outer timeout counter (256 × 256 = 65536 iterations)
000CBDr 2  A0 00          ldy #$00
000CBFr 2               @StDrqBsy:
000CBFr 2  AD 07 8C       lda ST_STATUS
000CC2r 2  29 80          and #ST_STATUS_BSY
000CC4r 2  F0 08          beq @StDrqCheckDrq            ; BSY clear — check DRQ
000CC6r 2  88             dey
000CC7r 2  D0 F6          bne @StDrqBsy
000CC9r 2  CA             dex
000CCAr 2  D0 F3          bne @StDrqBsy
000CCCr 2  38             sec                           ; Timed out — no device
000CCDr 2  60             rts
000CCEr 2               @StDrqCheckDrq:
000CCEr 2  AD 07 8C       lda ST_STATUS
000CD1r 2  29 01          and #ST_STATUS_ERR
000CD3r 2  D0 11          bne @StDrqErr
000CD5r 2  AD 07 8C       lda ST_STATUS
000CD8r 2  29 08          and #ST_STATUS_DRQ
000CDAr 2  D0 08          bne @StDrqOk                  ; DRQ set — ready for data
000CDCr 2  88             dey
000CDDr 2  D0 E0          bne @StDrqBsy
000CDFr 2  CA             dex
000CE0r 2  D0 DD          bne @StDrqBsy
000CE2r 2  38             sec                           ; Timed out
000CE3r 2  60             rts
000CE4r 2               @StDrqOk:
000CE4r 2  18             clc
000CE5r 2  60             rts
000CE6r 2               @StDrqErr:
000CE6r 2  38             sec
000CE7r 2  60             rts
000CE8r 2               
000CE8r 2               ; StInit — Initialize CompactFlash for 8-bit data transfers
000CE8r 2               ; Issues Set Features command with subcommand $01 (enable 8-bit I/O)
000CE8r 2               ; Output: Carry clear = success, Carry set = error
000CE8r 2               ; Modifies: Flags, A
000CE8r 2               StInit:
000CE8r 2  20 rr rr       jsr StWaitReadyPoll           ; Not StWaitReady: HW_CF is what this sets, so
000CEBr 2                                               ;   the guarded entry would answer "no card"
000CEBr 2                                               ;   before the card had been asked
000CEBr 2  B0 15          bcs @StInitDone               ; Timeout or error — CF not present
000CEDr 2                 ; CF responded — set presence flag
000CEDr 2  AD 0D 03       lda HW_PRESENT
000CF0r 2  09 08          ora #HW_CF
000CF2r 2  8D 0D 03       sta HW_PRESENT
000CF5r 2  A9 01          lda #ST_FEAT_8BIT             ; Feature: enable 8-bit data I/O
000CF7r 2  8D 01 8C       sta ST_FEATURE
000CFAr 2  A9 EF          lda #ST_CMD_SET_FEAT          ; Set Features command
000CFCr 2  8D 07 8C       sta ST_CMD
000CFFr 2  20 rr rr       jsr StWaitReady               ; Wait for command completion
000D02r 2               @StInitDone:
000D02r 2  60             rts
000D03r 2               
000D03r 2               ; StSetupLba — Set up LBA registers from CF_LBA zero page variables
000D03r 2               ; Also sets sector count to 1 and selects master drive in LBA mode
000D03r 2               ; Modifies: Flags, A
000D03r 2               StSetupLba:
000D03r 2  A9 01          lda #$01
000D05r 2  8D 02 8C       sta ST_SECT_CNT               ; Always 1 sector
000D08r 2                 ; Effective LBA = CF_LBA + CF_DISK * FS_DISK_SECTORS (disk banking base offset).
000D08r 2                 ; base = CF_DISK << 11: byte0=0, byte1=(CF_DISK<<3)&$FF, byte2=CF_DISK>>5, byte3=0.
000D08r 2                 ; Precompute base bits 16-23 (CF_DISK >> 5) into X before any add clobbers carry.
000D08r 2  AD 0F 03       lda CF_DISK
000D0Br 2  4A             lsr a
000D0Cr 2  4A             lsr a
000D0Dr 2  4A             lsr a
000D0Er 2  4A             lsr a
000D0Fr 2  4A             lsr a
000D10r 2  AA             tax                           ; X = CF_DISK >> 5 (disk base, LBA bits 16-23)
000D11r 2  A5 26          lda CF_LBA
000D13r 2  8D 03 8C       sta ST_LBA_0                  ; LBA bits 0-7 (base low byte is 0)
000D16r 2                 ; LBA bits 8-15: CF_LBA+1 + (CF_DISK << 3)
000D16r 2  AD 0F 03       lda CF_DISK
000D19r 2  0A             asl a
000D1Ar 2  0A             asl a
000D1Br 2  0A             asl a                         ; A = (CF_DISK << 3) & $FF
000D1Cr 2  18             clc
000D1Dr 2  65 27          adc CF_LBA + 1
000D1Fr 2  8D 04 8C       sta ST_LBA_1
000D22r 2                 ; LBA bits 16-23: CF_LBA+2 + (CF_DISK >> 5) + carry
000D22r 2  8A             txa
000D23r 2  65 28          adc CF_LBA + 2
000D25r 2  8D 05 8C       sta ST_LBA_2
000D28r 2                 ; LBA bits 24-27: CF_LBA+3 + carry
000D28r 2  A5 29          lda CF_LBA + 3
000D2Ar 2  69 00          adc #$00
000D2Cr 2  29 0F          and #$0F                      ; Mask to 4 bits (LBA 24-27)
000D2Er 2  09 E0          ora #ST_LBA3_MASTER           ; LBA mode, master drive
000D30r 2  8D 06 8C       sta ST_LBA_3
000D33r 2  60             rts
000D34r 2               
000D34r 2               ; StReadSector — Read one 512-byte sector from CompactFlash
000D34r 2               ; Input: CF_LBA ($26-$29) = LBA address, CF_BUF_PTR ($24-$25) = destination pointer
000D34r 2               ; Output: Carry clear = success, Carry set = error
000D34r 2               ;         CF_BUF_PTR advanced by 512 bytes on success
000D34r 2               ; Modifies: Flags, A, X, Y
000D34r 2               StReadSectorImpl:
000D34r 2  20 rr rr       jsr StWaitReady
000D37r 2  B0 1F          bcs @StReadDone
000D39r 2  20 rr rr       jsr StSetupLba
000D3Cr 2  A9 20          lda #ST_CMD_READ              ; Issue read command
000D3Er 2  8D 07 8C       sta ST_CMD
000D41r 2  20 rr rr       jsr StWaitDrq                 ; Wait for data ready
000D44r 2  B0 12          bcs @StReadDone
000D46r 2                 ; Read 512 bytes: 2 pages of 256 bytes
000D46r 2  A0 00          ldy #$00
000D48r 2  A2 02          ldx #$02                      ; 2 pages
000D4Ar 2               @StReadPage:
000D4Ar 2  AD 00 8C       lda ST_DATA                   ; Read byte from CF
000D4Dr 2  91 24          sta (CF_BUF_PTR),y            ; Store to destination
000D4Fr 2  C8             iny
000D50r 2  D0 F8          bne @StReadPage               ; Loop for 256 bytes
000D52r 2  E6 25          inc CF_BUF_PTR + 1            ; Next page
000D54r 2  CA             dex
000D55r 2  D0 F3          bne @StReadPage
000D57r 2  18             clc                           ; Success
000D58r 2               @StReadDone:
000D58r 2  60             rts
000D59r 2               
000D59r 2               ; StWriteSector — Write one 512-byte sector to CompactFlash
000D59r 2               ; Input: CF_LBA ($26-$29) = LBA address, CF_BUF_PTR ($24-$25) = source pointer
000D59r 2               ; Output: Carry clear = success, Carry set = error
000D59r 2               ;         CF_BUF_PTR advanced by 512 bytes on success
000D59r 2               ; Modifies: Flags, A, X, Y
000D59r 2               StWriteSectorImpl:
000D59r 2  20 rr rr       jsr StWaitReady
000D5Cr 2  B0 21          bcs @StWriteDone
000D5Er 2  20 rr rr       jsr StSetupLba
000D61r 2  A9 30          lda #ST_CMD_WRITE             ; Issue write command
000D63r 2  8D 07 8C       sta ST_CMD
000D66r 2  20 rr rr       jsr StWaitDrq                 ; Wait for data request
000D69r 2  B0 14          bcs @StWriteDone
000D6Br 2                 ; Write 512 bytes: 2 pages of 256 bytes
000D6Br 2  A0 00          ldy #$00
000D6Dr 2  A2 02          ldx #$02                      ; 2 pages
000D6Fr 2               @StWritePage:
000D6Fr 2  B1 24          lda (CF_BUF_PTR),y            ; Load from source
000D71r 2  8D 00 8C       sta ST_DATA                   ; Write byte to CF
000D74r 2  C8             iny
000D75r 2  D0 F8          bne @StWritePage              ; Loop for 256 bytes
000D77r 2  E6 25          inc CF_BUF_PTR + 1            ; Next page
000D79r 2  CA             dex
000D7Ar 2  D0 F3          bne @StWritePage
000D7Cr 2  20 rr rr       jsr StWaitReady               ; Wait for write to complete
000D7Fr 2               @StWriteDone:
000D7Fr 2  60             rts
000D80r 2               
000D80r 2               ; === Simple Custom Filesystem ===
000D80r 2               ; Directory at LBA 0: 16 entries x 32 bytes = 512 bytes
000D80r 2               ; Entry format:
000D80r 2               ;   $00-$07: 8-byte filename (space-padded)
000D80r 2               ;   $08-$0A: 3-byte extension (space-padded)
000D80r 2               ;   $0B:     flags (bit 0 = in use)
000D80r 2               ;   $0C-$0D: start sector (little-endian)
000D80r 2               ;   $0E-$0F: file size in bytes (little-endian)
000D80r 2               ;   $10-$1F: reserved (16 bytes)
000D80r 2               
000D80r 2               ; FsParseName — Parse null-terminated filename at STR_PTR into FS_FNAME_BUF
000D80r 2               ; Converts "NAME.EXT" into 8+3 space-padded format
000D80r 2               ; Input: STR_PTR ($02-$03) points to null-terminated filename
000D80r 2               ; Output: FS_FNAME_BUF filled with padded 8+3 name
000D80r 2               ; Modifies: Flags, A, X, Y
000D80r 2               ; The extension is inert: it is split on the dot, padded into the directory
000D80r 2               ; fields, and matched by FsFindFile's flat 11-byte compare.  Nothing anywhere
000D80r 2               ; branches on it, so .PRG / .BAS / .FOO all behave identically — what a file
000D80r 2               ; means is decided by the command that loads it (LOAD vs BLOAD), never by name.
000D80r 2               FsParseName:
000D80r 2                 ; Fill FS_FNAME_BUF with spaces
000D80r 2  A9 20          lda #$20
000D82r 2  A2 0A          ldx #10
000D84r 2               @FsParseClr:
000D84r 2  9D 50 03       sta FS_FNAME_BUF,x
000D87r 2  CA             dex
000D88r 2  10 FA          bpl @FsParseClr
000D8Ar 2                 ; Copy name part (up to 8 chars, stop at '.' or null)
000D8Ar 2  A0 00          ldy #$00                      ; Source index
000D8Cr 2  A2 00          ldx #$00                      ; Dest index (name portion)
000D8Er 2               @FsParseName:
000D8Er 2  B1 02          lda (STR_PTR),y
000D90r 2  F0 35          beq @FsParseDone              ; Null terminator — no extension
000D92r 2  C9 2E          cmp #'.'
000D94r 2  F0 15          beq @FsParseExt               ; Found dot — start extension
000D96r 2  E0 08          cpx #$08
000D98r 2  B0 0E          bcs @FsParseSkipName          ; Already 8 chars, skip extras
000D9Ar 2                 ; Convert lowercase to uppercase
000D9Ar 2  C9 61          cmp #'a'
000D9Cr 2  90 06          bcc @FsStoreNameChar
000D9Er 2  C9 7B          cmp #'z' + 1
000DA0r 2  B0 02          bcs @FsStoreNameChar
000DA2r 2  29 DF          and #$DF                      ; Clear bit 5 to uppercase
000DA4r 2               @FsStoreNameChar:
000DA4r 2  9D 50 03       sta FS_FNAME_BUF,x
000DA7r 2  E8             inx
000DA8r 2               @FsParseSkipName:
000DA8r 2  C8             iny
000DA9r 2  80 E3          bra @FsParseName
000DABr 2               @FsParseExt:
000DABr 2  C8             iny                           ; Skip the dot
000DACr 2  A2 08          ldx #$08                      ; Extension starts at offset 8
000DAEr 2               @FsParseExtLoop:
000DAEr 2  B1 02          lda (STR_PTR),y
000DB0r 2  F0 15          beq @FsParseDone              ; Null terminator
000DB2r 2  E0 0B          cpx #$0B
000DB4r 2  B0 11          bcs @FsParseDone              ; Max 3 ext chars
000DB6r 2                 ; Convert lowercase to uppercase
000DB6r 2  C9 61          cmp #'a'
000DB8r 2  90 06          bcc @FsStoreExtChar
000DBAr 2  C9 7B          cmp #'z' + 1
000DBCr 2  B0 02          bcs @FsStoreExtChar
000DBEr 2  29 DF          and #$DF
000DC0r 2               @FsStoreExtChar:
000DC0r 2  9D 50 03       sta FS_FNAME_BUF,x
000DC3r 2  E8             inx
000DC4r 2  C8             iny
000DC5r 2  80 E7          bra @FsParseExtLoop
000DC7r 2               @FsParseDone:
000DC7r 2  60             rts
000DC8r 2               
000DC8r 2               ; FsReadDir — Read directory sector (LBA 0) into FS_SECTOR_BUF
000DC8r 2               ; Output: Carry clear = success, Carry set = error
000DC8r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
000DC8r 2               FsReadDir:
000DC8r 2  64 26          stz CF_LBA                    ; LBA = 0 (directory sector)
000DCAr 2  64 27          stz CF_LBA + 1
000DCCr 2  64 28          stz CF_LBA + 2
000DCEr 2  64 29          stz CF_LBA + 3
000DD0r 2  A9 00          lda #<FS_SECTOR_BUF
000DD2r 2  85 24          sta CF_BUF_PTR
000DD4r 2  A9 06          lda #>FS_SECTOR_BUF
000DD6r 2  85 25          sta CF_BUF_PTR + 1
000DD8r 2  4C rr rr       jmp StReadSector
000DDBr 2               
000DDBr 2               ; FsWriteDir — Write directory sector from FS_SECTOR_BUF to LBA 0
000DDBr 2               ; Output: Carry clear = success, Carry set = error
000DDBr 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
000DDBr 2               FsWriteDir:
000DDBr 2  64 26          stz CF_LBA
000DDDr 2  64 27          stz CF_LBA + 1
000DDFr 2  64 28          stz CF_LBA + 2
000DE1r 2  64 29          stz CF_LBA + 3
000DE3r 2  A9 00          lda #<FS_SECTOR_BUF
000DE5r 2  85 24          sta CF_BUF_PTR
000DE7r 2  A9 06          lda #>FS_SECTOR_BUF
000DE9r 2  85 25          sta CF_BUF_PTR + 1
000DEBr 2  4C rr rr       jmp StWriteSector
000DEEr 2               
000DEEr 2               ; FsFindFile — Search directory for filename in FS_FNAME_BUF
000DEEr 2               ; Must call FsReadDir first to load directory into FS_SECTOR_BUF
000DEEr 2               ; Output: Carry clear = found, X = entry index (0-15), CF_BUF_PTR points to entry
000DEEr 2               ;         Carry set = not found
000DEEr 2               ; Modifies: Flags, A, X, Y, CF_BUF_PTR
000DEEr 2               FsFindFile:
000DEEr 2  A9 00          lda #<FS_SECTOR_BUF
000DF0r 2  85 24          sta CF_BUF_PTR
000DF2r 2  A9 06          lda #>FS_SECTOR_BUF
000DF4r 2  85 25          sta CF_BUF_PTR + 1
000DF6r 2  A2 00          ldx #$00                      ; Entry index
000DF8r 2               @FsFindLoop:
000DF8r 2                 ; Check if entry is in use
000DF8r 2  A0 0B          ldy #FS_ENTRY_FLAGS
000DFAr 2  B1 24          lda (CF_BUF_PTR),y
000DFCr 2  29 01          and #FS_FLAG_USED
000DFEr 2  F0 13          beq @FsFindNext               ; Skip unused entries
000E00r 2                 ; Compare 11-byte filename
000E00r 2  A0 00          ldy #$00
000E02r 2               @FsFindCmp:
000E02r 2  B1 24          lda (CF_BUF_PTR),y
000E04r 2  D9 50 03       cmp FS_FNAME_BUF,y
000E07r 2  D0 0A          bne @FsFindNext               ; Mismatch
000E09r 2  C8             iny
000E0Ar 2  C0 0B          cpy #11
000E0Cr 2  D0 F4          bne @FsFindCmp
000E0Er 2                 ; Match found
000E0Er 2  8E 4D 03       stx FS_DIR_IDX
000E11r 2  18             clc
000E12r 2  60             rts
000E13r 2               @FsFindNext:
000E13r 2                 ; Advance CF_BUF_PTR by 32 (FS_ENTRY_SIZE)
000E13r 2  A5 24          lda CF_BUF_PTR
000E15r 2  18             clc
000E16r 2  69 20          adc #FS_ENTRY_SIZE
000E18r 2  85 24          sta CF_BUF_PTR
000E1Ar 2  90 02          bcc @FsFindNoCarry
000E1Cr 2  E6 25          inc CF_BUF_PTR + 1
000E1Er 2               @FsFindNoCarry:
000E1Er 2  E8             inx
000E1Fr 2  E0 10          cpx #FS_MAX_FILES
000E21r 2  D0 D5          bne @FsFindLoop
000E23r 2  38             sec                           ; Not found
000E24r 2  60             rts
000E25r 2               
000E25r 2               ; FsFindFree — Find first free directory entry
000E25r 2               ; Must call FsReadDir first
000E25r 2               ; Output: Carry clear = found, X = entry index, CF_BUF_PTR points to entry
000E25r 2               ;         Carry set = directory full
000E25r 2               ; Modifies: Flags, A, X, Y, CF_BUF_PTR
000E25r 2               FsFindFree:
000E25r 2  A9 00          lda #<FS_SECTOR_BUF
000E27r 2  85 24          sta CF_BUF_PTR
000E29r 2  A9 06          lda #>FS_SECTOR_BUF
000E2Br 2  85 25          sta CF_BUF_PTR + 1
000E2Dr 2  A2 00          ldx #$00
000E2Fr 2               @FsFreeLoop:
000E2Fr 2  A0 0B          ldy #FS_ENTRY_FLAGS
000E31r 2  B1 24          lda (CF_BUF_PTR),y
000E33r 2  29 01          and #FS_FLAG_USED
000E35r 2  F0 12          beq @FsFreeFound              ; Found unused entry
000E37r 2                 ; Advance by 32
000E37r 2  A5 24          lda CF_BUF_PTR
000E39r 2  18             clc
000E3Ar 2  69 20          adc #FS_ENTRY_SIZE
000E3Cr 2  85 24          sta CF_BUF_PTR
000E3Er 2  90 02          bcc @FsFreeNoCarry
000E40r 2  E6 25          inc CF_BUF_PTR + 1
000E42r 2               @FsFreeNoCarry:
000E42r 2  E8             inx
000E43r 2  E0 10          cpx #FS_MAX_FILES
000E45r 2  D0 E8          bne @FsFreeLoop
000E47r 2  38             sec                           ; Directory full
000E48r 2  60             rts
000E49r 2               @FsFreeFound:
000E49r 2  8E 4D 03       stx FS_DIR_IDX
000E4Cr 2  18             clc
000E4Dr 2  60             rts
000E4Er 2               
000E4Er 2               ; FsCalcNextSec — Calculate next free sector by scanning all directory entries
000E4Er 2               ; Must call FsReadDir first
000E4Er 2               ; Output: FS_NEXT_SEC = first free sector after all used files
000E4Er 2               ; Modifies: Flags, A, X, Y
000E4Er 2               FsCalcNextSec:
000E4Er 2  A9 01          lda #<FS_DATA_START           ; Start with first data sector
000E50r 2  8D 4E 03       sta FS_NEXT_SEC
000E53r 2  A9 00          lda #>FS_DATA_START
000E55r 2  8D 4F 03       sta FS_NEXT_SEC + 1
000E58r 2                 ; Scan all entries to find highest used sector + file sector count
000E58r 2  A9 00          lda #<FS_SECTOR_BUF
000E5Ar 2  85 24          sta CF_BUF_PTR
000E5Cr 2  A9 06          lda #>FS_SECTOR_BUF
000E5Er 2  85 25          sta CF_BUF_PTR + 1
000E60r 2  A2 00          ldx #$00
000E62r 2               @FsCalcLoop:
000E62r 2  A0 0B          ldy #FS_ENTRY_FLAGS
000E64r 2  B1 24          lda (CF_BUF_PTR),y
000E66r 2  29 01          and #FS_FLAG_USED
000E68r 2  F0 5D          beq @FsCalcNext               ; Skip unused
000E6Ar 2                 ; Get start sector + ceil(size/512)
000E6Ar 2  A0 0C          ldy #FS_ENTRY_START
000E6Cr 2  B1 24          lda (CF_BUF_PTR),y
000E6Er 2  8D 48 03       sta FS_START_SEC
000E71r 2  C8             iny
000E72r 2  B1 24          lda (CF_BUF_PTR),y
000E74r 2  8D 49 03       sta FS_START_SEC + 1
000E77r 2                 ; Get file size
000E77r 2  A0 0E          ldy #FS_ENTRY_FSIZE
000E79r 2  B1 24          lda (CF_BUF_PTR),y
000E7Br 2  8D 4A 03       sta FS_FILE_SIZE
000E7Er 2  C8             iny
000E7Fr 2  B1 24          lda (CF_BUF_PTR),y
000E81r 2  8D 4B 03       sta FS_FILE_SIZE + 1
000E84r 2                 ; Calculate sectors used = (size + 511) / 512 = (size + 511) >> 9
000E84r 2                 ; = (size_hi + 1) if size_lo > 0, else size_hi / 2... simplify:
000E84r 2                 ; sectors = (size >> 9) rounded up = high_byte >> 1, plus 1 if any remainder
000E84r 2  AD 4B 03       lda FS_FILE_SIZE + 1          ; High byte of size
000E87r 2  4A             lsr a                         ; Divide by 2 (each sector = 512 = 2 pages)
000E88r 2  8D 4C 03       sta FS_SEC_COUNT
000E8Br 2                 ; Check if there's a remainder (low byte != 0 or high byte bit 0 was set)
000E8Br 2  AD 4B 03       lda FS_FILE_SIZE + 1
000E8Er 2  29 01          and #$01                      ; Was high byte odd?
000E90r 2  D0 05          bne @FsCalcRound
000E92r 2  AD 4A 03       lda FS_FILE_SIZE              ; Low byte non-zero?
000E95r 2  F0 03          beq @FsCalcNoRound
000E97r 2               @FsCalcRound:
000E97r 2  EE 4C 03       inc FS_SEC_COUNT              ; Round up
000E9Ar 2               @FsCalcNoRound:
000E9Ar 2                 ; End sector = start + sector count.
000E9Ar 2                 ; NOTE: X holds the directory-entry loop counter, so the end sector must
000E9Ar 2                 ; NOT be kept in X (doing so ran the scan off the end of the directory
000E9Ar 2                 ; buffer into program memory, corrupting FS_NEXT_SEC and causing spurious
000E9Ar 2                 ; ?SAVE ERROR after a few files).  Stash it in memory scratch instead:
000E9Ar 2                 ; FS_SEC_COUNT (end low) and FS_DIR_IDX (end high) are both free here.
000E9Ar 2  AD 48 03       lda FS_START_SEC
000E9Dr 2  18             clc
000E9Er 2  6D 4C 03       adc FS_SEC_COUNT
000EA1r 2  8D 4C 03       sta FS_SEC_COUNT              ; end sector low (reuse as scratch)
000EA4r 2  AD 49 03       lda FS_START_SEC + 1
000EA7r 2  69 00          adc #$00
000EA9r 2  8D 4D 03       sta FS_DIR_IDX               ; end sector high (reuse as scratch)
000EACr 2                 ; Compare with FS_NEXT_SEC — keep the larger value
000EACr 2  CD 4F 03       cmp FS_NEXT_SEC + 1
000EAFr 2  90 16          bcc @FsCalcNext               ; End high < FS_NEXT_SEC high, skip
000EB1r 2  D0 08          bne @FsCalcUpdate             ; End high > FS_NEXT_SEC high, update
000EB3r 2  AD 4C 03       lda FS_SEC_COUNT
000EB6r 2  CD 4E 03       cmp FS_NEXT_SEC
000EB9r 2  90 0C          bcc @FsCalcNext               ; End low < FS_NEXT_SEC low, skip
000EBBr 2               @FsCalcUpdate:
000EBBr 2  AD 4C 03       lda FS_SEC_COUNT
000EBEr 2  8D 4E 03       sta FS_NEXT_SEC
000EC1r 2  AD 4D 03       lda FS_DIR_IDX
000EC4r 2  8D 4F 03       sta FS_NEXT_SEC + 1
000EC7r 2               @FsCalcNext:
000EC7r 2                 ; Advance CF_BUF_PTR by 32
000EC7r 2  A5 24          lda CF_BUF_PTR
000EC9r 2  18             clc
000ECAr 2  69 20          adc #FS_ENTRY_SIZE
000ECCr 2  85 24          sta CF_BUF_PTR
000ECEr 2  90 02          bcc @FsCalcNoCarry
000ED0r 2  E6 25          inc CF_BUF_PTR + 1
000ED2r 2               @FsCalcNoCarry:
000ED2r 2  E8             inx
000ED3r 2  E0 10          cpx #FS_MAX_FILES
000ED5r 2  D0 8B          bne @FsCalcLoop
000ED7r 2  60             rts
000ED8r 2               
000ED8r 2               ; FsDirectory — Print directory listing of all used entries
000ED8r 2               ; Output via Chrout (respects current IO_MODE)
000ED8r 2               ; Modifies: Flags, A, X, Y
000ED8r 2               FsDirectory:
000ED8r 2  20 rr rr       jsr FsReadDir                 ; Load directory sector
000EDBr 2  90 01          bcc @FsDirStart
000EDDr 2  60             rts                           ; Error reading directory
000EDEr 2               @FsDirStart:
000EDEr 2  20 rr rr       jsr FsPrintDiskImpl           ; Print "DISK n" header
000EE1r 2  A9 00          lda #<FS_SECTOR_BUF
000EE3r 2  85 24          sta CF_BUF_PTR
000EE5r 2  A9 06          lda #>FS_SECTOR_BUF
000EE7r 2  85 25          sta CF_BUF_PTR + 1
000EE9r 2  A2 00          ldx #$00                      ; Entry counter
000EEBr 2               @FsDirLoop:
000EEBr 2  DA             phx
000EECr 2  A0 0B          ldy #FS_ENTRY_FLAGS
000EEEr 2  B1 24          lda (CF_BUF_PTR),y
000EF0r 2  29 01          and #FS_FLAG_USED
000EF2r 2  F0 3A          beq @FsDirNext                ; Skip unused entries
000EF4r 2                 ; Print filename (8 chars)
000EF4r 2  A0 00          ldy #$00
000EF6r 2               @FsDirName:
000EF6r 2  B1 24          lda (CF_BUF_PTR),y
000EF8r 2  20 rr rr       jsr Chrout
000EFBr 2  C8             iny
000EFCr 2  C0 08          cpy #$08
000EFEr 2  D0 F6          bne @FsDirName
000F00r 2                 ; Print dot separator
000F00r 2  A9 2E          lda #'.'
000F02r 2  20 rr rr       jsr Chrout
000F05r 2                 ; Print extension (3 chars)
000F05r 2               @FsDirExt:
000F05r 2  B1 24          lda (CF_BUF_PTR),y
000F07r 2  20 rr rr       jsr Chrout
000F0Ar 2  C8             iny
000F0Br 2  C0 0B          cpy #$0B
000F0Dr 2  D0 F6          bne @FsDirExt
000F0Fr 2                 ; Print space
000F0Fr 2  A9 20          lda #' '
000F11r 2  20 rr rr       jsr Chrout
000F14r 2                 ; Print file size in decimal
000F14r 2  A0 0E          ldy #FS_ENTRY_FSIZE
000F16r 2  B1 24          lda (CF_BUF_PTR),y
000F18r 2  8D 4A 03       sta FS_FILE_SIZE
000F1Br 2  C8             iny
000F1Cr 2  B1 24          lda (CF_BUF_PTR),y
000F1Er 2  8D 4B 03       sta FS_FILE_SIZE + 1
000F21r 2  20 rr rr       jsr FsPrintSize
000F24r 2                 ; Print newline
000F24r 2  A9 0D          lda #$0D
000F26r 2  20 rr rr       jsr Chrout
000F29r 2  A9 0A          lda #$0A
000F2Br 2  20 rr rr       jsr Chrout
000F2Er 2               @FsDirNext:
000F2Er 2                 ; Advance CF_BUF_PTR by 32
000F2Er 2  A5 24          lda CF_BUF_PTR
000F30r 2  18             clc
000F31r 2  69 20          adc #FS_ENTRY_SIZE
000F33r 2  85 24          sta CF_BUF_PTR
000F35r 2  90 02          bcc @FsDirNoCarry
000F37r 2  E6 25          inc CF_BUF_PTR + 1
000F39r 2               @FsDirNoCarry:
000F39r 2  FA             plx
000F3Ar 2  E8             inx
000F3Br 2  E0 10          cpx #FS_MAX_FILES
000F3Dr 2  D0 AC          bne @FsDirLoop
000F3Fr 2  60             rts
000F40r 2               
000F40r 2               ; PrintDecU16 — Print an unsigned 16-bit value as decimal (no leading zeros).
000F40r 2               ; General-purpose console output; used by BASIC (line numbers) and available
000F40r 2               ; to cartridges.  Shares the FsPrintSize core below.
000F40r 2               ; Input : A = value low, X = value high
000F40r 2               ; Modifies: Flags, A, X, Y, FS_FILE_SIZE (consumed), FS_DIR_IDX
000F40r 2               PrintDecU16Impl:
000F40r 2  8D 4A 03       sta FS_FILE_SIZE
000F43r 2  8E 4B 03       stx FS_FILE_SIZE + 1
000F46r 2                 ; fall through to the shared decimal-print core
000F46r 2               ; FsPrintSize — Print 16-bit value in FS_FILE_SIZE as decimal
000F46r 2               ; Modifies: Flags, A, X, Y
000F46r 2               FsPrintSize:
000F46r 2                 ; Convert 16-bit value to decimal digits (up to 5 digits for 0-65535)
000F46r 2                 ; Use successive subtraction of powers of 10
000F46r 2  A2 00          ldx #$00                      ; Digit index / leading zero suppression
000F48r 2  A0 00          ldy #$00                      ; Power-of-10 table index
000F4Ar 2               @FsPrintSizeLoop:
000F4Ar 2  A9 2F          lda #'0' - 1                  ; Start character below '0'
000F4Cr 2  8D 4D 03       sta FS_DIR_IDX                ; Reuse as digit scratch
000F4Fr 2               @FsPrintSub:
000F4Fr 2  EE 4D 03       inc FS_DIR_IDX
000F52r 2  AD 4A 03       lda FS_FILE_SIZE
000F55r 2  38             sec
000F56r 2  F9 rr rr       sbc @FsPow10Lo,y
000F59r 2  48             pha
000F5Ar 2  AD 4B 03       lda FS_FILE_SIZE + 1
000F5Dr 2  F9 rr rr       sbc @FsPow10Hi,y
000F60r 2  90 09          bcc @FsPrintSizeDig           ; Underflow — done subtracting
000F62r 2  8D 4B 03       sta FS_FILE_SIZE + 1
000F65r 2  68             pla
000F66r 2  8D 4A 03       sta FS_FILE_SIZE
000F69r 2  80 E4          bra @FsPrintSub
000F6Br 2               @FsPrintSizeDig:
000F6Br 2  68             pla                           ; Discard underflowed low byte
000F6Cr 2  AD 4D 03       lda FS_DIR_IDX
000F6Fr 2  C9 30          cmp #'0'
000F71r 2  D0 04          bne @FsPrintSizeOut           ; Non-zero digit
000F73r 2  E0 00          cpx #$00
000F75r 2  F0 04          beq @FsPrintSizeSkip          ; Suppress leading zeros
000F77r 2               @FsPrintSizeOut:
000F77r 2  20 rr rr       jsr Chrout
000F7Ar 2  E8             inx                           ; Mark that we've printed a digit
000F7Br 2               @FsPrintSizeSkip:
000F7Br 2  C8             iny
000F7Cr 2  C0 04          cpy #$04                      ; 4 powers of 10 (10000, 1000, 100, 10)
000F7Er 2  D0 CA          bne @FsPrintSizeLoop
000F80r 2                 ; Always print ones digit
000F80r 2  AD 4A 03       lda FS_FILE_SIZE
000F83r 2  09 30          ora #'0'                      ; Low byte is 0-9 at this point
000F85r 2  20 rr rr       jsr Chrout
000F88r 2  60             rts
000F89r 2  10 E8 64 0A  @FsPow10Lo: .byte <10000, <1000, <100, <10
000F8Dr 2  27 03 00 00  @FsPow10Hi: .byte >10000, >1000, >100, >10
000F91r 2               
000F91r 2               ; FsSetDiskImpl — Select the current CF disk bank
000F91r 2               ; Input: A = disk number (0-255)
000F91r 2               ; Modifies: Flags
000F91r 2               FsSetDiskImpl:
000F91r 2  8D 0F 03       sta CF_DISK
000F94r 2  60             rts
000F95r 2               
000F95r 2               ; FsGetDiskImpl — Get the current CF disk bank
000F95r 2               ; Output: A = current disk number
000F95r 2               ; Modifies: Flags, A
000F95r 2               FsGetDiskImpl:
000F95r 2  AD 0F 03       lda CF_DISK
000F98r 2  60             rts
000F99r 2               
000F99r 2               ; FsFormatDiskImpl — Zero the current disk's directory sector (erases its file list)
000F99r 2               ; Output: Carry clear = success, Carry set = write error
000F99r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
000F99r 2               FsFormatDiskImpl:
000F99r 2  A9 00          lda #<FS_SECTOR_BUF
000F9Br 2  85 24          sta CF_BUF_PTR
000F9Dr 2  A9 06          lda #>FS_SECTOR_BUF
000F9Fr 2  85 25          sta CF_BUF_PTR + 1
000FA1r 2  A0 00          ldy #$00
000FA3r 2  A2 02          ldx #$02                      ; 2 pages = 512 bytes
000FA5r 2  A9 00          lda #$00
000FA7r 2               @FsFormatClr:
000FA7r 2  91 24          sta (CF_BUF_PTR),y
000FA9r 2  C8             iny
000FAAr 2  D0 FB          bne @FsFormatClr
000FACr 2  E6 25          inc CF_BUF_PTR + 1
000FAEr 2  CA             dex
000FAFr 2  D0 F6          bne @FsFormatClr
000FB1r 2  4C rr rr       jmp FsWriteDir                ; Write zeroed directory sector (returns carry status)
000FB4r 2               
000FB4r 2               ; FsPrintDiskImpl — Print "DISK n" (decimal) + CRLF via Chrout
000FB4r 2               ; Modifies: Flags, A, X, Y, FS_FILE_SIZE, FS_DIR_IDX
000FB4r 2               FsPrintDiskImpl:
000FB4r 2  A0 00          ldy #$00
000FB6r 2               @FsPDLbl:
000FB6r 2  B9 rr rr       lda FsDiskLbl,y
000FB9r 2  F0 06          beq @FsPDNum
000FBBr 2  20 rr rr       jsr Chrout
000FBEr 2  C8             iny
000FBFr 2  80 F5          bra @FsPDLbl
000FC1r 2               @FsPDNum:
000FC1r 2  AD 0F 03       lda CF_DISK
000FC4r 2  8D 4A 03       sta FS_FILE_SIZE
000FC7r 2  9C 4B 03       stz FS_FILE_SIZE + 1
000FCAr 2  20 rr rr       jsr FsPrintSize               ; Print CF_DISK as decimal (0-255, no leading zeros)
000FCDr 2  A9 0D          lda #$0D
000FCFr 2  20 rr rr       jsr Chrout
000FD2r 2  A9 0A          lda #$0A
000FD4r 2  4C rr rr       jmp Chrout
000FD7r 2  44 49 53 4B  FsDiskLbl: .byte "DISK ", 0
000FDBr 2  20 00        
000FDDr 2               
000FDDr 2               ; FsLoadFileImpl — Load file from CF into PROGRAM_START ($0800)
000FDDr 2               ; Input: STR_PTR ($02-$03) points to null-terminated filename
000FDDr 2               ; Output: Carry clear = success, FS_FILE_SIZE = bytes loaded
000FDDr 2               ;         Carry set = file not found or read error
000FDDr 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
000FDDr 2               FsLoadFileImpl:
000FDDr 2  A9 00          lda #<PROGRAM_START           ; Default target = PROGRAM_START
000FDFr 2  8D 7F 03       sta FS_IO_ADDR
000FE2r 2  A9 08          lda #>PROGRAM_START
000FE4r 2  8D 80 03       sta FS_IO_ADDR + 1
000FE7r 2               ; FsLoadFileAddrImpl — Load named file to FS_IO_ADDR (caller preset)
000FE7r 2               ; Input: STR_PTR = filename, FS_IO_ADDR = destination address
000FE7r 2               FsLoadFileAddrImpl:
000FE7r 2  20 rr rr       jsr FsOpenFile
000FEAr 2  B0 22          bcs @FsLoadErr
000FECr 2                 ; Set destination pointer from FS_IO_ADDR
000FECr 2  AD 7F 03       lda FS_IO_ADDR
000FEFr 2  85 24          sta CF_BUF_PTR
000FF1r 2  AD 80 03       lda FS_IO_ADDR + 1
000FF4r 2  85 25          sta CF_BUF_PTR + 1
000FF6r 2                 ; Read sectors
000FF6r 2  AE 4C 03       ldx FS_SEC_COUNT
000FF9r 2  F0 10          beq @FsLoadOk                 ; Zero-size file
000FFBr 2               @FsLoadSec:
000FFBr 2  DA             phx
000FFCr 2  20 rr rr       jsr StReadSector              ; Read sector (advances CF_BUF_PTR by 512)
000FFFr 2  B0 0C          bcs @FsLoadSecErr
001001r 2                 ; Increment LBA
001001r 2  E6 26          inc CF_LBA
001003r 2  D0 02          bne @FsLoadSecNext
001005r 2  E6 27          inc CF_LBA + 1
001007r 2               @FsLoadSecNext:
001007r 2  FA             plx
001008r 2  CA             dex
001009r 2  D0 F0          bne @FsLoadSec
00100Br 2               @FsLoadOk:
00100Br 2  18             clc
00100Cr 2  60             rts
00100Dr 2               @FsLoadSecErr:
00100Dr 2  FA             plx                           ; Balance stack
00100Er 2               @FsLoadErr:
00100Er 2  38             sec
00100Fr 2  60             rts
001010r 2               
001010r 2               ; VdpLoadFile — Load a named file from the current disk into VRAM
001010r 2               ; Streams the file through port A to FS_IO_ADDR, anywhere in the 64 KB, and
001010r 2               ; writes exactly its FS_FILE_SIZE bytes: the rest of the last sector is read
001010r 2               ; and dropped, so a table loaded here cannot spill into the one after it.
001010r 2               ; Input: STR_PTR = filename, FS_IO_ADDR = VRAM address
001010r 2               ; Output: Carry clear = loaded, FS_FILE_SIZE = bytes written
001010r 2               ;         Carry set = no video card (nothing read), or not found or read error
001010r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR, XFER_REMAIN, FS_SECTOR_BUF
001010r 2               VdpLoadFileImpl:
001010r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
001013r 2  30 02          bmi @VdpLoadFileCard
001015r 2  38             sec
001016r 2  60             rts
001017r 2               @VdpLoadFileCard:
001017r 2  20 rr rr       jsr FsOpenFile
00101Ar 2  B0 5B          bcs @VdpLoadFileDone
00101Cr 2  AD 4A 03       lda FS_FILE_SIZE              ; Bytes still to write
00101Fr 2  8D 17 03       sta XFER_REMAIN
001022r 2  AD 4B 03       lda FS_FILE_SIZE + 1
001025r 2  8D 18 03       sta XFER_REMAIN + 1
001028r 2  AE 7F 03       ldx FS_IO_ADDR
00102Br 2  AC 80 03       ldy FS_IO_ADDR + 1
00102Er 2  A9 40          lda #$40                      ; Write
001030r 2  20 rr rr       jsr VdpAddress
001033r 2               @VdpLoadFileSector:
001033r 2  AD 17 03       lda XFER_REMAIN
001036r 2  0D 18 03       ora XFER_REMAIN + 1
001039r 2  F0 3B          beq @VdpLoadFileOk            ; Written them all: no more sectors to read
00103Br 2  A9 00          lda #<FS_SECTOR_BUF
00103Dr 2  85 24          sta CF_BUF_PTR
00103Fr 2  A9 06          lda #>FS_SECTOR_BUF
001041r 2  85 25          sta CF_BUF_PTR + 1
001043r 2  20 rr rr       jsr StReadSector
001046r 2  B0 2F          bcs @VdpLoadFileDone
001048r 2  E6 26          inc CF_LBA
00104Ar 2  D0 02          bne @VdpLoadFileCopy
00104Cr 2  E6 27          inc CF_LBA + 1
00104Er 2               @VdpLoadFileCopy:
00104Er 2  C6 25          dec CF_BUF_PTR + 1            ; StReadSector left it 512 bytes on
001050r 2  C6 25          dec CF_BUF_PTR + 1
001052r 2  A0 00          ldy #$00
001054r 2               @VdpLoadFileByte:
001054r 2  AD 17 03       lda XFER_REMAIN
001057r 2  D0 08          bne @VdpLoadFileCount
001059r 2  AD 18 03       lda XFER_REMAIN + 1
00105Cr 2  F0 18          beq @VdpLoadFileOk            ; The file ends inside this sector
00105Er 2  CE 18 03       dec XFER_REMAIN + 1
001061r 2               @VdpLoadFileCount:
001061r 2  CE 17 03       dec XFER_REMAIN
001064r 2  B1 24          lda (CF_BUF_PTR),y
001066r 2  8D 00 9C       sta VC_DATA
001069r 2  C8             iny
00106Ar 2  D0 E8          bne @VdpLoadFileByte
00106Cr 2  E6 25          inc CF_BUF_PTR + 1            ; The sector's second page
00106Er 2  A5 25          lda CF_BUF_PTR + 1
001070r 2  C9 08          cmp #>(FS_SECTOR_BUF + 512)
001072r 2  D0 E0          bne @VdpLoadFileByte
001074r 2  80 BD          bra @VdpLoadFileSector
001076r 2               @VdpLoadFileOk:
001076r 2  18             clc
001077r 2               @VdpLoadFileDone:
001077r 2  60             rts
001078r 2               
001078r 2               ; FsOpenFile — Find a named file and get ready to read it
001078r 2               ; Shared by FsLoadFileAddr and VdpLoadFile.
001078r 2               ; Input: STR_PTR = filename
001078r 2               ; Output: Carry clear = found: FS_FILE_SIZE = its size, FS_SEC_COUNT = the
001078r 2               ;         sectors it spans, CF_LBA = its first sector
001078r 2               ;         Carry set = not found or read error
001078r 2               ; Modifies: Flags, A, X, Y, CF_BUF_PTR, FS_START_SEC
001078r 2               FsOpenFile:
001078r 2  20 rr rr       jsr FsParseName               ; Parse filename into FS_FNAME_BUF
00107Br 2  20 rr rr       jsr FsReadDir                 ; Read directory sector
00107Er 2  B0 44          bcs @FsOpenDone
001080r 2  20 rr rr       jsr FsFindFile                ; Search for filename
001083r 2  B0 3F          bcs @FsOpenDone               ; Not found
001085r 2                 ; Read file metadata from entry
001085r 2  A0 0C          ldy #FS_ENTRY_START
001087r 2  B1 24          lda (CF_BUF_PTR),y
001089r 2  8D 48 03       sta FS_START_SEC
00108Cr 2  C8             iny
00108Dr 2  B1 24          lda (CF_BUF_PTR),y
00108Fr 2  8D 49 03       sta FS_START_SEC + 1
001092r 2  A0 0E          ldy #FS_ENTRY_FSIZE
001094r 2  B1 24          lda (CF_BUF_PTR),y
001096r 2  8D 4A 03       sta FS_FILE_SIZE
001099r 2  C8             iny
00109Ar 2  B1 24          lda (CF_BUF_PTR),y
00109Cr 2  8D 4B 03       sta FS_FILE_SIZE + 1
00109Fr 2                 ; Calculate number of sectors to read
00109Fr 2  AD 4B 03       lda FS_FILE_SIZE + 1
0010A2r 2  4A             lsr a
0010A3r 2  8D 4C 03       sta FS_SEC_COUNT
0010A6r 2  AD 4B 03       lda FS_FILE_SIZE + 1
0010A9r 2  29 01          and #$01
0010ABr 2  D0 05          bne @FsLoadRound
0010ADr 2  AD 4A 03       lda FS_FILE_SIZE
0010B0r 2  F0 03          beq @FsLoadNoRound
0010B2r 2               @FsLoadRound:
0010B2r 2  EE 4C 03       inc FS_SEC_COUNT
0010B5r 2               @FsLoadNoRound:
0010B5r 2                 ; Set up LBA starting at file's start sector
0010B5r 2  AD 48 03       lda FS_START_SEC
0010B8r 2  85 26          sta CF_LBA
0010BAr 2  AD 49 03       lda FS_START_SEC + 1
0010BDr 2  85 27          sta CF_LBA + 1
0010BFr 2  64 28          stz CF_LBA + 2
0010C1r 2  64 29          stz CF_LBA + 3
0010C3r 2  18             clc
0010C4r 2               @FsOpenDone:
0010C4r 2  60             rts
0010C5r 2               
0010C5r 2               ; FsSaveFileImpl — Save data from PROGRAM_START to CF
0010C5r 2               ; Input: STR_PTR ($02-$03) points to null-terminated filename
0010C5r 2               ;        FS_FILE_SIZE ($034A-$034B) = number of bytes to save
0010C5r 2               ; Output: Carry clear = success, Carry set = error (directory full or write error)
0010C5r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
0010C5r 2               FsSaveFileImpl:
0010C5r 2  A9 00          lda #<PROGRAM_START           ; Default source = PROGRAM_START
0010C7r 2  8D 7F 03       sta FS_IO_ADDR
0010CAr 2  A9 08          lda #>PROGRAM_START
0010CCr 2  8D 80 03       sta FS_IO_ADDR + 1
0010CFr 2               ; FsSaveFileAddrImpl — Save FS_FILE_SIZE bytes from FS_IO_ADDR to named file
0010CFr 2               ; Input: STR_PTR = filename, FS_IO_ADDR = source address, FS_FILE_SIZE = byte count
0010CFr 2               FsSaveFileAddrImpl:
0010CFr 2  20 rr rr       jsr FsParseName               ; Parse filename into FS_FNAME_BUF
0010D2r 2  20 rr rr       jsr FsReadDir                 ; Read directory sector
0010D5r 2  90 03          bcc @FsSaveReadOk
0010D7r 2  4C rr rr       jmp @FsSaveErr
0010DAr 2               @FsSaveReadOk:
0010DAr 2                 ; Try to find existing file with same name
0010DAr 2  20 rr rr       jsr FsFindFile
0010DDr 2  90 08          bcc @FsSaveOverwrite
0010DFr 2                 ; Not found — find a free slot
0010DFr 2  20 rr rr       jsr FsFindFree
0010E2r 2  90 11          bcc @FsSaveAlloc
0010E4r 2  4C rr rr       jmp @FsSaveErr                ; Directory full
0010E7r 2               @FsSaveOverwrite:
0010E7r 2                 ; CF_BUF_PTR already points to the existing entry — clear old flags
0010E7r 2  A0 0B          ldy #FS_ENTRY_FLAGS
0010E9r 2  A9 00          lda #$00
0010EBr 2  91 24          sta (CF_BUF_PTR),y            ; Mark old entry as free
0010EDr 2                 ; Find a free slot (could be the one we just freed or another)
0010EDr 2  20 rr rr       jsr FsFindFree
0010F0r 2  90 03          bcc @FsSaveAlloc
0010F2r 2  4C rr rr       jmp @FsSaveErr
0010F5r 2               @FsSaveAlloc:
0010F5r 2                 ; Save CF_BUF_PTR (points to free entry from FsFindFree)
0010F5r 2  A5 24          lda CF_BUF_PTR
0010F7r 2  48             pha
0010F8r 2  A5 25          lda CF_BUF_PTR + 1
0010FAr 2  48             pha
0010FBr 2                 ; Save FS_FILE_SIZE (FsCalcNextSec clobbers it while scanning entries)
0010FBr 2  AD 4A 03       lda FS_FILE_SIZE
0010FEr 2  48             pha
0010FFr 2  AD 4B 03       lda FS_FILE_SIZE + 1
001102r 2  48             pha
001103r 2                 ; Calculate next free sector (clobbers CF_BUF_PTR and FS_FILE_SIZE)
001103r 2  20 rr rr       jsr FsCalcNextSec
001106r 2                 ; Restore FS_FILE_SIZE
001106r 2  68             pla
001107r 2  8D 4B 03       sta FS_FILE_SIZE + 1
00110Ar 2  68             pla
00110Br 2  8D 4A 03       sta FS_FILE_SIZE
00110Er 2                 ; Restore CF_BUF_PTR to the free directory entry
00110Er 2  68             pla
00110Fr 2  85 25          sta CF_BUF_PTR + 1
001111r 2  68             pla
001112r 2  85 24          sta CF_BUF_PTR
001114r 2                 ; Calculate sectors needed
001114r 2  AD 4B 03       lda FS_FILE_SIZE + 1
001117r 2  4A             lsr a
001118r 2  8D 4C 03       sta FS_SEC_COUNT
00111Br 2  AD 4B 03       lda FS_FILE_SIZE + 1
00111Er 2  29 01          and #$01
001120r 2  D0 05          bne @FsSaveRound
001122r 2  AD 4A 03       lda FS_FILE_SIZE
001125r 2  F0 03          beq @FsSaveNoRound
001127r 2               @FsSaveRound:
001127r 2  EE 4C 03       inc FS_SEC_COUNT
00112Ar 2               @FsSaveNoRound:
00112Ar 2                 ; Disk-full guard: reject if the file would spill past this disk's region.
00112Ar 2                 ; end sector = FS_NEXT_SEC + FS_SEC_COUNT must be <= FS_DISK_SECTORS.
00112Ar 2  AD 4E 03       lda FS_NEXT_SEC
00112Dr 2  18             clc
00112Er 2  6D 4C 03       adc FS_SEC_COUNT
001131r 2  A8             tay                           ; Y = end sector low
001132r 2  AD 4F 03       lda FS_NEXT_SEC + 1
001135r 2  69 00          adc #$00                      ; A = end sector high
001137r 2  C9 08          cmp #>FS_DISK_SECTORS
001139r 2  90 08          bcc @FsSaveSpaceOk            ; end high < high(FS_DISK_SECTORS) -> fits
00113Br 2  D0 03          bne @FsSaveDiskFull           ; end high > high(FS_DISK_SECTORS) -> full
00113Dr 2  98             tya                           ; end high equal: OK only if end low == 0
00113Er 2  F0 03          beq @FsSaveSpaceOk
001140r 2               @FsSaveDiskFull:
001140r 2  4C rr rr       jmp @FsSaveErr                ; Disk full
001143r 2               @FsSaveSpaceOk:
001143r 2                 ; Fill in directory entry at CF_BUF_PTR
001143r 2                 ; Copy filename (11 bytes)
001143r 2  A0 00          ldy #$00
001145r 2               @FsSaveCopyName:
001145r 2  B9 50 03       lda FS_FNAME_BUF,y
001148r 2  91 24          sta (CF_BUF_PTR),y
00114Ar 2  C8             iny
00114Br 2  C0 0B          cpy #11
00114Dr 2  D0 F6          bne @FsSaveCopyName
00114Fr 2                 ; Set flags = in use
00114Fr 2  A9 01          lda #FS_FLAG_USED
001151r 2  91 24          sta (CF_BUF_PTR),y            ; Y = 11 = FS_ENTRY_FLAGS
001153r 2                 ; Set start sector
001153r 2  A0 0C          ldy #FS_ENTRY_START
001155r 2  AD 4E 03       lda FS_NEXT_SEC
001158r 2  91 24          sta (CF_BUF_PTR),y
00115Ar 2  8D 48 03       sta FS_START_SEC
00115Dr 2  C8             iny
00115Er 2  AD 4F 03       lda FS_NEXT_SEC + 1
001161r 2  91 24          sta (CF_BUF_PTR),y
001163r 2  8D 49 03       sta FS_START_SEC + 1
001166r 2                 ; Set file size
001166r 2  A0 0E          ldy #FS_ENTRY_FSIZE
001168r 2  AD 4A 03       lda FS_FILE_SIZE
00116Br 2  91 24          sta (CF_BUF_PTR),y
00116Dr 2  C8             iny
00116Er 2  AD 4B 03       lda FS_FILE_SIZE + 1
001171r 2  91 24          sta (CF_BUF_PTR),y
001173r 2                 ; Clear reserved bytes
001173r 2  A0 10          ldy #$10
001175r 2  A9 00          lda #$00
001177r 2               @FsSaveClearRsv:
001177r 2  91 24          sta (CF_BUF_PTR),y
001179r 2  C8             iny
00117Ar 2  C0 20          cpy #FS_ENTRY_SIZE
00117Cr 2  D0 F9          bne @FsSaveClearRsv
00117Er 2                 ; Write updated directory back to CF
00117Er 2  20 rr rr       jsr FsWriteDir
001181r 2  B0 30          bcs @FsSaveErr
001183r 2                 ; Now write file data sectors
001183r 2  AD 48 03       lda FS_START_SEC
001186r 2  85 26          sta CF_LBA
001188r 2  AD 49 03       lda FS_START_SEC + 1
00118Br 2  85 27          sta CF_LBA + 1
00118Dr 2  64 28          stz CF_LBA + 2
00118Fr 2  64 29          stz CF_LBA + 3
001191r 2                 ; Source = FS_IO_ADDR
001191r 2  AD 7F 03       lda FS_IO_ADDR
001194r 2  85 24          sta CF_BUF_PTR
001196r 2  AD 80 03       lda FS_IO_ADDR + 1
001199r 2  85 25          sta CF_BUF_PTR + 1
00119Br 2  AE 4C 03       ldx FS_SEC_COUNT
00119Er 2  F0 10          beq @FsSaveOk                 ; Zero-size file
0011A0r 2               @FsSaveSec:
0011A0r 2  DA             phx
0011A1r 2  20 rr rr       jsr StWriteSector             ; Write sector (advances CF_BUF_PTR by 512)
0011A4r 2  B0 0C          bcs @FsSaveSecErr
0011A6r 2                 ; Increment LBA
0011A6r 2  E6 26          inc CF_LBA
0011A8r 2  D0 02          bne @FsSaveSecNext
0011AAr 2  E6 27          inc CF_LBA + 1
0011ACr 2               @FsSaveSecNext:
0011ACr 2  FA             plx
0011ADr 2  CA             dex
0011AEr 2  D0 F0          bne @FsSaveSec
0011B0r 2               @FsSaveOk:
0011B0r 2  18             clc
0011B1r 2  60             rts
0011B2r 2               @FsSaveSecErr:
0011B2r 2  FA             plx                           ; Balance stack
0011B3r 2               @FsSaveErr:
0011B3r 2  38             sec
0011B4r 2  60             rts
0011B5r 2               
0011B5r 2               ; FsDeleteFile — Delete a file from the CompactFlash filesystem
0011B5r 2               ; Input: STR_PTR ($02-$03) points to null-terminated filename
0011B5r 2               ; Output: Carry clear = success, Carry set = file not found or error
0011B5r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
0011B5r 2               FsDeleteFileImpl:
0011B5r 2  20 rr rr       jsr FsParseName               ; Parse filename into FS_FNAME_BUF
0011B8r 2  20 rr rr       jsr FsReadDir                 ; Read directory sector
0011BBr 2  B0 0F          bcs @FsDelErr
0011BDr 2  20 rr rr       jsr FsFindFile                ; Search for filename
0011C0r 2  B0 0A          bcs @FsDelErr                 ; Not found
0011C2r 2                 ; Clear the flags byte to mark entry as unused
0011C2r 2  A0 0B          ldy #FS_ENTRY_FLAGS
0011C4r 2  A9 00          lda #$00
0011C6r 2  91 24          sta (CF_BUF_PTR),y
0011C8r 2                 ; Write updated directory back to CF
0011C8r 2  20 rr rr       jsr FsWriteDir
0011CBr 2                 ; Carry already set/clear from FsWriteDir
0011CBr 2  60             rts
0011CCr 2               @FsDelErr:
0011CCr 2  38             sec
0011CDr 2  60             rts
0011CEr 2               
0011CEr 2               ; === XModem Serial LOAD/SAVE ===
0011CEr 2               ; Standard XModem protocol over serial (128-byte blocks, checksum)
0011CEr 2               ; Load: receives blocks into memory at caller-supplied XFER_PTR
0011CEr 2               ; Save: sends blocks from memory at caller-supplied XFER_PTR / XFER_REMAIN
0011CEr 2               
0011CEr 2               ; --- Shared XModem Utilities ---
0011CEr 2               
0011CEr 2               ; XModemGetByte — Read one byte from serial with timeout
0011CEr 2               ; Polls SC_STATUS for RDRF directly (bypasses IRQ-driven buffer).
0011CEr 2               ; Caller must disable serial RX IRQ before calling.
0011CEr 2               ; Output: A = byte received, Carry clear = got byte
0011CEr 2               ;         Carry set = timeout
0011CEr 2               ; Preserves: X, Y
0011CEr 2               XModemGetByte:
0011CEr 2  DA             phx
0011CFr 2  5A             phy
0011D0r 2  A2 00          ldx #$00                      ; Outer loop: 256 passes
0011D2r 2               @Outer:
0011D2r 2  A0 00          ldy #$00                      ; Inner loop: 256 polls
0011D4r 2               @Inner:
0011D4r 2  AD 01 90       lda SC_STATUS
0011D7r 2  29 08          and #SC_STATUS_RDRF           ; Received byte waiting?
0011D9r 2  D0 0A          bne @Got
0011DBr 2  88             dey
0011DCr 2  D0 F6          bne @Inner
0011DEr 2  CA             dex
0011DFr 2  D0 F1          bne @Outer
0011E1r 2                 ; Timeout
0011E1r 2  7A             ply
0011E2r 2  FA             plx
0011E3r 2  38             sec
0011E4r 2  60             rts
0011E5r 2               @Got:
0011E5r 2  AD 00 90       lda SC_DATA                   ; Read received byte (clears RDRF)
0011E8r 2  7A             ply
0011E9r 2  FA             plx
0011EAr 2  18             clc
0011EBr 2  60             rts
0011ECr 2               
0011ECr 2               ; XModemPurge — Drain all pending bytes from input buffer and hardware
0011ECr 2               ; Modifies: A, X
0011ECr 2               XModemPurge:
0011ECr 2                 ; Drain software input buffer (bytes captured before IRQ was disabled)
0011ECr 2               @DrainBuf:
0011ECr 2  20 rr rr       jsr BufferSize
0011EFr 2  F0 05          beq @DrainHw
0011F1r 2  20 rr rr       jsr ReadBuffer
0011F4r 2  80 F6          bra @DrainBuf
0011F6r 2               @DrainHw:
0011F6r 2                 ; Drain hardware RDRF
0011F6r 2  AD 01 90       lda SC_STATUS
0011F9r 2  29 08          and #SC_STATUS_RDRF
0011FBr 2  F0 05          beq @Done
0011FDr 2  AD 00 90       lda SC_DATA                   ; Read and discard
001200r 2  80 F4          bra @DrainHw
001202r 2               @Done:
001202r 2  60             rts
001203r 2               
001203r 2               ; --- XModem Load (Receive) ---
001203r 2               
001203r 2               ; XModemLoadImpl — Receive data via standard XModem protocol
001203r 2               ; Input: XFER_PTR = destination address (set by caller)
001203r 2               ; Output: Carry clear = success, XFER_PTR past last byte written
001203r 2               ;         XFER_REMAIN = total bytes received
001203r 2               ;         Carry set = transfer failed
001203r 2               ; Modifies: Flags, A, X, Y
001203r 2               XModemLoadImpl:
001203r 2                 ; Save and switch IO_MODE to serial
001203r 2  AD 06 03       lda IO_MODE
001206r 2  8D 19 03       sta XFER_IO_SAVE
001209r 2  A9 01          lda #$01
00120Br 2  8D 06 03       sta IO_MODE
00120Er 2                 ; Disable serial RX IRQ — XModem polls SC_STATUS directly
00120Er 2  A9 0B          lda #SC_CMD_XMODEM            ; Bit 1 set = RX IRQ disabled, RTSB low, DTR
001210r 2  8D 02 90       sta SC_CMD
001213r 2                 ; Initialize
001213r 2  A9 01          lda #$01
001215r 2  85 36          sta XMODEM_BLK                ; First expected block number
001217r 2  9C 17 03       stz XFER_REMAIN
00121Ar 2  9C 18 03       stz XFER_REMAIN + 1
00121Dr 2  A9 3C          lda #XMODEM_STARTRETRY
00121Fr 2  85 38          sta XMODEM_RETRY
001221r 2                 ; Print status message so user can start the terminal send
001221r 2  A2 00          ldx #0
001223r 2               @PrintMsg:
001223r 2  BD rr rr       lda XModemStrReceive,x
001226r 2  F0 06          beq @PrintDone
001228r 2  20 rr rr       jsr Chrout
00122Br 2  E8             inx
00122Cr 2  80 F5          bra @PrintMsg
00122Er 2               @PrintDone:
00122Er 2  20 rr rr       jsr XModemPurge               ; Drain stale bytes
001231r 2                 ; Send initial NAK to start transfer
001231r 2  A9 15          lda #XMODEM_NAK
001233r 2  20 rr rr       jsr SerialChrout
001236r 2               @RecvWait:
001236r 2  20 rr rr       jsr XModemGetByte
001239r 2  B0 0E          bcs @RecvTimeout
00123Br 2  C9 01          cmp #XMODEM_SOH
00123Dr 2  F0 3E          beq @RecvBlock
00123Fr 2  C9 04          cmp #XMODEM_EOT
001241r 2  F0 11          beq @RecvEOT
001243r 2  C9 18          cmp #XMODEM_CAN
001245r 2  F0 1F          beq @RecvFail
001247r 2  80 ED          bra @RecvWait                 ; Ignore unknown bytes
001249r 2               
001249r 2               @RecvTimeout:
001249r 2  C6 38          dec XMODEM_RETRY
00124Br 2  F0 19          beq @RecvFail
00124Dr 2  A9 15          lda #XMODEM_NAK
00124Fr 2  20 rr rr       jsr SerialChrout
001252r 2  80 E2          bra @RecvWait
001254r 2               
001254r 2               @RecvEOT:
001254r 2  A9 06          lda #XMODEM_ACK
001256r 2  20 rr rr       jsr SerialChrout
001259r 2                 ; Re-enable serial RX IRQ; ScRts takes the pin back over from here
001259r 2  A9 09          lda #SC_CMD_RTS_LOW
00125Br 2  8D 02 90       sta SC_CMD
00125Er 2  AD 19 03       lda XFER_IO_SAVE
001261r 2  8D 06 03       sta IO_MODE
001264r 2  18             clc                           ; Success
001265r 2  60             rts
001266r 2               
001266r 2               @RecvFail:
001266r 2  A9 18          lda #XMODEM_CAN
001268r 2  20 rr rr       jsr SerialChrout
00126Br 2  A9 18          lda #XMODEM_CAN
00126Dr 2  20 rr rr       jsr SerialChrout
001270r 2                 ; Re-enable serial RX IRQ; ScRts takes the pin back over from here
001270r 2  A9 09          lda #SC_CMD_RTS_LOW
001272r 2  8D 02 90       sta SC_CMD
001275r 2  AD 19 03       lda XFER_IO_SAVE
001278r 2  8D 06 03       sta IO_MODE
00127Br 2  38             sec                           ; Failure
00127Cr 2  60             rts
00127Dr 2               
00127Dr 2               @RecvBlock:
00127Dr 2                 ; Reset retry counter on SOH received
00127Dr 2  A9 0A          lda #XMODEM_MAXRETRY
00127Fr 2  85 38          sta XMODEM_RETRY
001281r 2                 ; Read block number
001281r 2  20 rr rr       jsr XModemGetByte
001284r 2  B0 6B          bcs @RecvNAK
001286r 2  85 39          sta XMODEM_RCVBLK
001288r 2                 ; Read complement
001288r 2  20 rr rr       jsr XModemGetByte
00128Br 2  B0 64          bcs @RecvNAK
00128Dr 2                 ; Verify block# + complement = $FF
00128Dr 2  18             clc
00128Er 2  65 39          adc XMODEM_RCVBLK
001290r 2  C9 FF          cmp #$FF
001292r 2  D0 5D          bne @RecvNAK
001294r 2                 ; Receive 128 data bytes into (XFER_PTR), accumulate checksum
001294r 2  64 37          stz XMODEM_CHK
001296r 2  A0 00          ldy #$00
001298r 2               @RecvData:
001298r 2  20 rr rr       jsr XModemGetByte             ; A = byte (X/Y preserved)
00129Br 2  B0 54          bcs @RecvNAK
00129Dr 2  91 2A          sta (XFER_PTR),y              ; Write to destination at offset Y
00129Fr 2  18             clc
0012A0r 2  65 37          adc XMODEM_CHK
0012A2r 2  85 37          sta XMODEM_CHK
0012A4r 2  C8             iny
0012A5r 2  C0 80          cpy #XMODEM_BLKSZ
0012A7r 2  D0 EF          bne @RecvData
0012A9r 2                 ; Read and verify checksum
0012A9r 2  20 rr rr       jsr XModemGetByte
0012ACr 2  B0 43          bcs @RecvNAK
0012AEr 2  C5 37          cmp XMODEM_CHK
0012B0r 2  D0 3F          bne @RecvNAK
0012B2r 2                 ; Verify block number matches expected
0012B2r 2  A5 39          lda XMODEM_RCVBLK
0012B4r 2  C5 36          cmp XMODEM_BLK
0012B6r 2  D0 28          bne @RecvDupChk
0012B8r 2                 ; Good block — advance pointer by 128
0012B8r 2  18             clc
0012B9r 2  A5 2A          lda XFER_PTR
0012BBr 2  69 80          adc #XMODEM_BLKSZ
0012BDr 2  85 2A          sta XFER_PTR
0012BFr 2  A5 2B          lda XFER_PTR + 1
0012C1r 2  69 00          adc #$00
0012C3r 2  85 2B          sta XFER_PTR + 1
0012C5r 2                 ; Update total bytes received
0012C5r 2  18             clc
0012C6r 2  AD 17 03       lda XFER_REMAIN
0012C9r 2  69 80          adc #XMODEM_BLKSZ
0012CBr 2  8D 17 03       sta XFER_REMAIN
0012CEr 2  AD 18 03       lda XFER_REMAIN + 1
0012D1r 2  69 00          adc #$00
0012D3r 2  8D 18 03       sta XFER_REMAIN + 1
0012D6r 2                 ; Increment expected block number (wraps 255→0)
0012D6r 2  E6 36          inc XMODEM_BLK
0012D8r 2                 ; ACK the block
0012D8r 2  A9 06          lda #XMODEM_ACK
0012DAr 2  20 rr rr       jsr SerialChrout
0012DDr 2  4C rr rr       jmp @RecvWait
0012E0r 2               
0012E0r 2               @RecvDupChk:
0012E0r 2                 ; Check if this is a retransmit of the previous block (lost ACK)
0012E0r 2  A5 36          lda XMODEM_BLK
0012E2r 2  38             sec
0012E3r 2  E9 01          sbc #$01
0012E5r 2  C5 39          cmp XMODEM_RCVBLK
0012E7r 2  D0 08          bne @RecvNAK                  ; Not a dup — NAK
0012E9r 2                 ; Duplicate — re-ACK without advancing
0012E9r 2  A9 06          lda #XMODEM_ACK
0012EBr 2  20 rr rr       jsr SerialChrout
0012EEr 2  4C rr rr       jmp @RecvWait
0012F1r 2               
0012F1r 2               @RecvNAK:
0012F1r 2  20 rr rr       jsr XModemPurge               ; Drain any remaining bytes
0012F4r 2  A9 15          lda #XMODEM_NAK
0012F6r 2  20 rr rr       jsr SerialChrout
0012F9r 2  4C rr rr       jmp @RecvWait
0012FCr 2               
0012FCr 2               ; --- XModem Save (Send) ---
0012FCr 2               
0012FCr 2               ; XModemSaveImpl — Send data via standard XModem protocol
0012FCr 2               ; Input: XFER_PTR = source address, XFER_REMAIN = byte count (set by caller)
0012FCr 2               ; Output: Carry clear = success, Carry set = transfer failed
0012FCr 2               ; Modifies: Flags, A, X, Y
0012FCr 2               XModemSaveImpl:
0012FCr 2                 ; Save and switch IO_MODE to serial
0012FCr 2  AD 06 03       lda IO_MODE
0012FFr 2  8D 19 03       sta XFER_IO_SAVE
001302r 2  A9 01          lda #$01
001304r 2  8D 06 03       sta IO_MODE
001307r 2                 ; Disable serial RX IRQ — XModem polls SC_STATUS directly
001307r 2  A9 0B          lda #SC_CMD_XMODEM            ; Bit 1 set = RX IRQ disabled, RTSB low, DTR
001309r 2  8D 02 90       sta SC_CMD
00130Cr 2                 ; Initialize
00130Cr 2  A9 01          lda #$01
00130Er 2  85 36          sta XMODEM_BLK                ; First block number
001310r 2  A9 3C          lda #XMODEM_STARTRETRY
001312r 2  85 38          sta XMODEM_RETRY
001314r 2                 ; Print status message so user can start the terminal receive
001314r 2  A2 00          ldx #0
001316r 2               @PrintMsg:
001316r 2  BD rr rr       lda XModemStrSend,x
001319r 2  F0 06          beq @PrintDone
00131Br 2  20 rr rr       jsr Chrout
00131Er 2  E8             inx
00131Fr 2  80 F5          bra @PrintMsg
001321r 2               @PrintDone:
001321r 2  20 rr rr       jsr XModemPurge               ; Drain stale bytes
001324r 2                 ; Wait for initial NAK (or 'C' for CRC mode) from receiver
001324r 2               @SendWaitNAK:
001324r 2  20 rr rr       jsr XModemGetByte
001327r 2  B0 11          bcs @SendInitTO
001329r 2  C9 15          cmp #XMODEM_NAK
00132Br 2  F0 16          beq @SendLoop
00132Dr 2  C9 43          cmp #'C'                      ; CRC mode request — treat as NAK (send checksum packets)
00132Fr 2  F0 12          beq @SendLoop
001331r 2  C9 18          cmp #XMODEM_CAN
001333r 2  D0 03          bne :+
001335r 2  4C rr rr       jmp @SendFail
001338r 2  80 EA        : bra @SendWaitNAK
00133Ar 2               
00133Ar 2               @SendInitTO:
00133Ar 2  C6 38          dec XMODEM_RETRY
00133Cr 2  D0 03          bne :+
00133Er 2  4C rr rr       jmp @SendFail
001341r 2  80 E1        : bra @SendWaitNAK
001343r 2               
001343r 2               @SendLoop:
001343r 2                 ; Check if any data remains to send
001343r 2  AD 17 03       lda XFER_REMAIN
001346r 2  0D 18 03       ora XFER_REMAIN + 1
001349r 2  D0 03          bne :+
00134Br 2  4C rr rr       jmp @SendEOT                  ; All data sent
00134Er 2               :
00134Er 2                 ; Reset retry counter for this block
00134Er 2  A9 0A          lda #XMODEM_MAXRETRY
001350r 2  85 38          sta XMODEM_RETRY
001352r 2               @SendBlock:
001352r 2                 ; Save XFER_PTR and XFER_REMAIN on stack for retry
001352r 2  A5 2B          lda XFER_PTR + 1
001354r 2  48             pha
001355r 2  A5 2A          lda XFER_PTR
001357r 2  48             pha
001358r 2  AD 18 03       lda XFER_REMAIN + 1
00135Br 2  48             pha
00135Cr 2  AD 17 03       lda XFER_REMAIN
00135Fr 2  48             pha
001360r 2                 ; Send header: SOH, block#, ~block#
001360r 2  A9 01          lda #XMODEM_SOH
001362r 2  20 rr rr       jsr SerialChrout
001365r 2  A5 36          lda XMODEM_BLK
001367r 2  20 rr rr       jsr SerialChrout
00136Ar 2  49 FF          eor #$FF
00136Cr 2  20 rr rr       jsr SerialChrout
00136Fr 2                 ; Send 128 data bytes, computing checksum
00136Fr 2  64 37          stz XMODEM_CHK
001371r 2  A0 00          ldy #$00                      ; Y=0 for (XFER_PTR),y indirect addressing
001373r 2  A2 80          ldx #XMODEM_BLKSZ             ; X = byte counter (128 down to 0)
001375r 2               @SendData:
001375r 2  AD 17 03       lda XFER_REMAIN
001378r 2  0D 18 03       ora XFER_REMAIN + 1
00137Br 2  F0 20          beq @SendPad                  ; No more real data — pad remainder
00137Dr 2  B1 2A          lda (XFER_PTR),y              ; Read source byte
00137Fr 2  20 rr rr       jsr SerialChrout              ; Send it (A preserved by SerialChrout)
001382r 2  18             clc
001383r 2  65 37          adc XMODEM_CHK
001385r 2  85 37          sta XMODEM_CHK
001387r 2                 ; Advance source pointer
001387r 2  E6 2A          inc XFER_PTR
001389r 2  D0 02          bne @SendNoPg
00138Br 2  E6 2B          inc XFER_PTR + 1
00138Dr 2               @SendNoPg:
00138Dr 2                 ; Decrement remaining byte count
00138Dr 2  AD 17 03       lda XFER_REMAIN
001390r 2  D0 03          bne @SendDecLo
001392r 2  CE 18 03       dec XFER_REMAIN + 1
001395r 2               @SendDecLo:
001395r 2  CE 17 03       dec XFER_REMAIN
001398r 2  CA             dex
001399r 2  D0 DA          bne @SendData
00139Br 2  80 0D          bra @SendChk
00139Dr 2               @SendPad:
00139Dr 2                 ; Pad remaining block bytes with SUB ($1A)
00139Dr 2  A9 1A          lda #XMODEM_SUB
00139Fr 2  20 rr rr       jsr SerialChrout
0013A2r 2  18             clc
0013A3r 2  65 37          adc XMODEM_CHK
0013A5r 2  85 37          sta XMODEM_CHK
0013A7r 2  CA             dex
0013A8r 2  D0 F3          bne @SendPad
0013AAr 2               @SendChk:
0013AAr 2                 ; Send checksum byte
0013AAr 2  A5 37          lda XMODEM_CHK
0013ACr 2  20 rr rr       jsr SerialChrout
0013AFr 2                 ; Wait for ACK/NAK response
0013AFr 2  20 rr rr       jsr XModemGetByte
0013B2r 2  B0 08          bcs @SendRetry                ; Timeout — retry
0013B4r 2  C9 06          cmp #XMODEM_ACK
0013B6r 2  F0 19          beq @SendBlockOK
0013B8r 2  C9 18          cmp #XMODEM_CAN
0013BAr 2  F0 1E          beq @SendCancel
0013BCr 2                 ; NAK or unknown — retry
0013BCr 2               @SendRetry:
0013BCr 2                 ; Restore XFER_PTR and XFER_REMAIN from stack
0013BCr 2  68             pla
0013BDr 2  8D 17 03       sta XFER_REMAIN
0013C0r 2  68             pla
0013C1r 2  8D 18 03       sta XFER_REMAIN + 1
0013C4r 2  68             pla
0013C5r 2  85 2A          sta XFER_PTR
0013C7r 2  68             pla
0013C8r 2  85 2B          sta XFER_PTR + 1
0013CAr 2  C6 38          dec XMODEM_RETRY
0013CCr 2  F0 10          beq @SendFail
0013CEr 2  4C rr rr       jmp @SendBlock
0013D1r 2               
0013D1r 2               @SendBlockOK:
0013D1r 2                 ; Discard saved state from stack (4 bytes)
0013D1r 2  68             pla
0013D2r 2  68             pla
0013D3r 2  68             pla
0013D4r 2  68             pla
0013D5r 2                 ; Advance to next block
0013D5r 2  E6 36          inc XMODEM_BLK
0013D7r 2  4C rr rr       jmp @SendLoop
0013DAr 2               
0013DAr 2               @SendCancel:
0013DAr 2                 ; Discard saved state from stack
0013DAr 2  68             pla
0013DBr 2  68             pla
0013DCr 2  68             pla
0013DDr 2  68             pla
0013DEr 2               @SendFail:
0013DEr 2                 ; Re-enable serial RX IRQ; ScRts takes the pin back over from here
0013DEr 2  A9 09          lda #SC_CMD_RTS_LOW
0013E0r 2  8D 02 90       sta SC_CMD
0013E3r 2  AD 19 03       lda XFER_IO_SAVE
0013E6r 2  8D 06 03       sta IO_MODE
0013E9r 2  38             sec                           ; Failure
0013EAr 2  60             rts
0013EBr 2               
0013EBr 2               @SendEOT:
0013EBr 2                 ; All data sent — send EOT
0013EBr 2  A9 04          lda #XMODEM_EOT
0013EDr 2  20 rr rr       jsr SerialChrout
0013F0r 2                 ; Wait for ACK (best-effort; don't fail if timeout)
0013F0r 2  20 rr rr       jsr XModemGetByte
0013F3r 2                 ; Re-enable serial RX IRQ; ScRts takes the pin back over from here
0013F3r 2  A9 09          lda #SC_CMD_RTS_LOW
0013F5r 2  8D 02 90       sta SC_CMD
0013F8r 2  AD 19 03       lda XFER_IO_SAVE
0013FBr 2  8D 06 03       sta IO_MODE
0013FEr 2  18             clc                           ; Success
0013FFr 2  60             rts
001400r 2               
001400r 2               ; XModem status strings
001400r 2               XModemStrReceive:
001400r 2  58 4D 4F 44    .byte "XMODEM RX READY", $0D, $0A, 0
001404r 2  45 4D 20 52  
001408r 2  58 20 52 45  
001412r 2               XModemStrSend:
001412r 2  58 4D 4F 44    .byte "XMODEM TX READY", $0D, $0A, 0
001416r 2  45 4D 20 54  
00141Ar 2  58 20 52 45  
001424r 2               
001424r 2               ; NMI Handler
001424r 2               Nmi:
001424r 2  40             rti
001425r 2               
001425r 2               ; BRK Handler — saves full CPU state, reports it, and warm-starts BASIC
001425r 2               ; On entry from @IrqBrk: A/X/Y are the user's original values (restored by IRQ handler).
001425r 2               ; The CPU's hardware push left P/PCL/PCH on the stack.
001425r 2               ; Prints, on the console IO_MODE names:
001425r 2               ;   BREAK $nn AT $xxxx
001425r 2               ;   A=xx X=xx Y=xx P=xx S=xx
001425r 2               ; xxxx is the BRK opcode's address (BRK_PC - 2), nn the byte after it, and S
001425r 2               ; the stack pointer before the BRK (BRK_SP + 3).  A video console that a
001425r 2               ; program has taken out of the Text console is put back first.  BRK_PTR stays
001425r 2               ; hookable; a cartridge with no BASIC at $C000 must point it elsewhere.
001425r 2               Break:
001425r 2  8D 13 03       sta BRK_A                     ; Save user's A register
001428r 2  8E 14 03       stx BRK_X                     ; Save user's X register
00142Br 2  8C 15 03       sty BRK_Y                     ; Save user's Y register
00142Er 2  BA             tsx                           ; Get current SP
00142Fr 2  8E 16 03       stx BRK_SP                   ; Save SP (points below P/PCL/PCH on stack)
001432r 2  68             pla                           ; Pull saved P
001433r 2  8D 10 03       sta BRK_P
001436r 2  68             pla                           ; Pull saved PCL (PC+2)
001437r 2  8D 11 03       sta BRK_PCL
00143Ar 2  68             pla                           ; Pull saved PCH
00143Br 2  8D 12 03       sta BRK_PCH
00143Er 2  A2 FF          ldx #$FF                      ; BasEntry resets the stack anyway, and a BRK
001440r 2  9A             txs                           ;   reached by running off a full one has no
001441r 2                                               ;   room left to print the report with
001441r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
001444r 2  10 0D          bpl @BreakReport
001446r 2  AD 93 03       lda VID_MODE
001449r 2  C9 01          cmp #$01
00144Br 2  F0 06          beq @BreakReport              ; The Text console is intact
00144Dr 2  20 rr rr       jsr InitVideoImpl             ; A program moved the card on: bring the
001450r 2  20 rr rr       jsr VideoClearNow             ;   console back to print on
001453r 2               @BreakReport:
001453r 2  20 rr rr       jsr PrintCRLF
001456r 2  A9 rr          lda #<KMsgBreak               ; "BREAK $"
001458r 2  A0 rr          ldy #>KMsgBreak
00145Ar 2  20 rr rr       jsr PrintStr
00145Dr 2  AD 11 03       lda BRK_PCL                   ; The opcode's address, BRK_PC - 2
001460r 2  38             sec
001461r 2  E9 02          sbc #2
001463r 2  85 02          sta STR_PTR
001465r 2  AA             tax
001466r 2  AD 12 03       lda BRK_PCH
001469r 2  E9 00          sbc #0
00146Br 2  85 03          sta STR_PTR + 1
00146Dr 2  48             pha                           ; Its high byte, then its low byte, for later
00146Er 2  DA             phx
00146Fr 2  A0 01          ldy #1
001471r 2  B1 02          lda (STR_PTR),y               ; The byte after the BRK
001473r 2  20 rr rr       jsr KPrintHexByte
001476r 2  A9 rr          lda #<KMsgAt                  ; " AT $"
001478r 2  A0 rr          ldy #>KMsgAt
00147Ar 2  20 rr rr       jsr PrintStr
00147Dr 2  68             pla
00147Er 2  AA             tax
00147Fr 2  68             pla
001480r 2  20 rr rr       jsr KPrintHexByte
001483r 2  8A             txa
001484r 2  20 rr rr       jsr KPrintHexByte
001487r 2  20 rr rr       jsr PrintCRLF
00148Ar 2  A2 00          ldx #0                        ; A=xx X=xx Y=xx P=xx S=xx
00148Cr 2               @BreakReg:
00148Cr 2  8A             txa
00148Dr 2  F0 05          beq @BreakRegName
00148Fr 2  A9 20          lda #' '
001491r 2  20 rr rr       jsr Chrout
001494r 2               @BreakRegName:
001494r 2  BD rr rr       lda KBreakRegName,x
001497r 2  20 rr rr       jsr Chrout
00149Ar 2  A9 3D          lda #'='
00149Cr 2  20 rr rr       jsr Chrout
00149Fr 2  BC rr rr       ldy KBreakRegOffset,x
0014A2r 2  B9 10 03       lda BRK_P,y
0014A5r 2  E0 04          cpx #4                        ; S: the stack pointer before the BRK pushed
0014A7r 2  D0 02          bne @BreakRegHex              ;   PCH, PCL and P
0014A9r 2  69 02          adc #2                        ; Carry is set: + 3
0014ABr 2               @BreakRegHex:
0014ABr 2  20 rr rr       jsr KPrintHexByte
0014AEr 2  E8             inx
0014AFr 2  E0 05          cpx #5
0014B1r 2  D0 D9          bne @BreakReg
0014B3r 2  20 rr rr       jsr PrintCRLF
0014B6r 2  4C rr rr       jmp BasEntry                  ; Warm start: the program is kept
0014B9r 2               KMsgBreak:
0014B9r 2  42 52 45 41    .byte "BREAK $", 0
0014BDr 2  4B 20 24 00  
0014C1r 2               KMsgAt:
0014C1r 2  20 41 54 20    .byte " AT $", 0
0014C5r 2  24 00        
0014C7r 2               KBreakRegName:
0014C7r 2  41 58 59 50    .byte "AXYPS"
0014CBr 2  53           
0014CCr 2               KBreakRegOffset:                ; From BRK_P
0014CCr 2  03 04 05 00    .byte BRK_A - BRK_P, BRK_X - BRK_P, BRK_Y - BRK_P, 0, BRK_SP - BRK_P
0014D0r 2  06           
0014D1r 2               
0014D1r 2               ; KPrintHexByte — Print A as two hex digits through Chrout
0014D1r 2               ; Preserves: X, Y
0014D1r 2               ; Modifies: Flags, A
0014D1r 2               KPrintHexByte:
0014D1r 2  48             pha
0014D2r 2  4A             lsr a
0014D3r 2  4A             lsr a
0014D4r 2  4A             lsr a
0014D5r 2  4A             lsr a
0014D6r 2  20 rr rr       jsr @KHexDigit
0014D9r 2  68             pla
0014DAr 2  29 0F          and #$0F
0014DCr 2               @KHexDigit:
0014DCr 2  C9 0A          cmp #10
0014DEr 2  90 02          bcc @KHexDec
0014E0r 2  69 06          adc #6                        ; Carry is set: 'A' - '0' - 10
0014E2r 2               @KHexDec:
0014E2r 2  69 30          adc #'0'
0014E4r 2  4C rr rr       jmp Chrout
0014E7r 2               
0014E7r 2               ; IRQ Handler
0014E7r 2               Irq:
0014E7r 2  48             pha
0014E8r 2  5A             phy
0014E9r 2  DA             phx
0014EAr 2  BA             tsx                           ; Get stack pointer to check saved status register
0014EBr 2  BD 04 01       lda $104,x                    ; Load saved P (SP+4: past X, Y, A we pushed)
0014EEr 2  29 10          and #$10                      ; Test B flag — set by BRK, clear by hardware IRQ
0014F0r 2  D0 3E          bne @IrqBrk                   ; Branch if this was a BRK instruction
0014F2r 2               @IrqSc:
0014F2r 2  AD 0D 03       lda HW_PRESENT
0014F5r 2  29 10          and #HW_SC
0014F7r 2  F0 10          beq @IrqCheckKB               ; Serial not present — skip
0014F9r 2  AD 01 90       lda SC_STATUS
0014FCr 2  29 80          and #SC_STATUS_IRQ            ; Check if serial data caused the interrupt
0014FEr 2  F0 09          beq @IrqCheckKB               ; If not, check keyboard
001500r 2  AD 00 90       lda SC_DATA                   ; Read the data from serial register
001503r 2  20 rr rr       jsr WriteBuffer               ; Store to the input buffer
001506r 2  20 rr rr       jsr ScRts                     ; One more unread byte — RTS may go up
001509r 2                                               ; Fall through to check keyboard — always clear VIA flags
001509r 2               @IrqCheckKB:
001509r 2  AD 0D 03       lda HW_PRESENT
00150Cr 2  29 20          and #HW_GPIO
00150Er 2  F0 1C          beq @IrqExit                  ; GPIO not present — skip
001510r 2  AD 0D 94       lda GPIO_IFR
001513r 2  29 10          and #GPIO_INT_CB1             ; Check if CB1 (matrix keyboard data ready) caused the interrupt
001515r 2  F0 08          beq @IrqCheckPS2              ; If not, check PS/2 keyboard
001517r 2  AD 00 94       lda GPIO_PORTB                ; Read ASCII byte from matrix keyboard (also clears CB1 IFR flag)
00151Ar 2  20 rr rr       jsr WriteBuffer               ; Store to the input buffer
00151Dr 2  80 0D          bra @IrqExit
00151Fr 2               @IrqCheckPS2:
00151Fr 2  AD 0D 94       lda GPIO_IFR
001522r 2  29 02          and #GPIO_INT_CA1             ; Check if CA1 (PS/2 keyboard data ready) caused the interrupt
001524r 2  F0 06          beq @IrqExit                  ; If not, exit
001526r 2  AD 01 94       lda GPIO_PORTA                ; Read ASCII byte from PS/2 keyboard (also clears CA1 IFR flag)
001529r 2  20 rr rr       jsr WriteBuffer               ; Store to the input buffer
00152Cr 2               @IrqExit:
00152Cr 2  FA             plx
00152Dr 2  7A             ply
00152Er 2  68             pla
00152Fr 2  40             rti
001530r 2               @IrqBrk:
001530r 2  FA             plx                           ; Restore saved registers
001531r 2  7A             ply
001532r 2  68             pla
001533r 2  58             cli                           ; Re-enable interrupts — abandoning interrupt context
001534r 2  6C 02 03       jmp (BRK_PTR)                 ; BRK — dispatch with P/PCL/PCH still on stack
001537r 2               
001537r 2               ; NMI Vector
001537r 2               NmiVec:
001537r 2  6C 04 03       jmp (NMI_PTR)                 ; Indirect jump through NMI pointer to the NMI handler
00153Ar 2               
00153Ar 2               ; Reset Vector
00153Ar 2               ResetVec:
00153Ar 2  4C rr rr       jmp Reset                     ; Initialize the system
00153Dr 2               
00153Dr 2               ; IRQ Vector
00153Dr 2               IrqVec:
00153Dr 2  6C 00 03       jmp (IRQ_PTR)                 ; Indirect jump through IRQ pointer to the IRQ handler
001540r 2               
001540r 1               .segment "BASIC"
000000r 1               .include "BASIC.asm"
000000r 2               ; =============================================================================
000000r 2               ; BASIC v2.0  —  5-Byte Floating-Point MSBASIC-Compatible Interpreter
000000r 2               ;                for AC6502 Homebrew Computer
000000r 2               ;
000000r 2               ;   ROM Region  :  $C000-$FEFF  (16,128 bytes / $3F00)
000000r 2               ;   Segment     :  BASIC
000000r 2               ;   Entry point :  BasEntry  (first byte of segment = $C000)
000000r 2               ;   Assembler   :  ca65  (cc65 toolchain)
000000r 2               ;   Linker cfg  :  BIOS.cfg
000000r 2               ;
000000r 2               ;   Coding style :  Match the rest of the BIOS project.
000000r 2               ;                   * Routine / data labels : PascalCase  (e.g. BasEntry,
000000r 2               ;                     FAdd, NormalizeFac1, Lbl367F).
000000r 2               ;                   * Constants / equates    : UPPER_SNAKE_CASE
000000r 2               ;                     (e.g. BAS_TXTPTR, TOK_PRINT, ERR_SYNTAX).
000000r 2               ;                   * Local labels           : @camelCase or @PascalCase.
000000r 2               ;                   * Opcodes are lowercase.
000000r 2               ;
000000r 2               ;   Reference source tree:  msbasic-master/  (read-only; NOT linked).
000000r 2               ; =============================================================================
000000r 2               
000000r 2                       .segment "BASIC"
000000r 2               
000000r 2                       .macpack longbranch     ; jeq/jne/etc. used by ported MSBASIC FP code
000000r 3               .macro  jeq     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                       bne     *+5
000000r 3                       jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               beq     Target
000000r 3                       .else
000000r 3                               bne     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jne     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               beq     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bne     Target
000000r 3                       .else
000000r 3                               beq     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jmi     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bpl     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bmi     Target
000000r 3                       .else
000000r 3                               bpl     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jpl     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bmi     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bpl     Target
000000r 3                       .else
000000r 3                               bmi     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jcs     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bcc     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bcs     Target
000000r 3                       .else
000000r 3                               bcc     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jcc     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bcs     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bcc     Target
000000r 3                       .else
000000r 3                               bcs     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jvs     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bvc     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bvs     Target
000000r 3                       .else
000000r 3                               bvc     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jvc     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bvs     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bvc     Target
000000r 3                       .else
000000r 3                               bvs     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   Z E R O - P A G E   E Q U A T E S
000000r 2               ;
000000r 2               ;   $00-$03   Kernal reserved
000000r 2               ;   $04-$23   BASIC primary workspace
000000r 2               ;   $24-$39   Kernal reserved
000000r 2               ;   $3A-$FF   BASIC spill (FP scratch in later phases)
000000r 2               ; =============================================================================
000000r 2               
000000r 2               BAS_TXTPTR      := $04          ; $04-$05  ChrGet / parse pointer
000000r 2               BAS_CURLINE     := $06          ; $06-$07  Pointer to current executing line
000000r 2               BAS_LINNUM      := $08          ; $08-$09  Parsed line number / scratch (= LINNUM)
000000r 2               
000000r 2               ; ----- Floating-point primary block ($0A-$1B, contiguous) -------------------
000000r 2               ; The MSBASIC float code accesses these via ZP,X with one label as the
000000r 2               ; immediate base (e.g. EXPSGN,X / SHIFTSIGNEXT,X / TMPEXP,X), so this entire
000000r 2               ; block MUST stay contiguous in this exact order.  See msbasic-master/
000000r 2               ; zeropage.s for the reference layout.
000000r 2               BAS_TMPEXP      := $0A          ; $0A      TMPEXP / INDX (alias)
000000r 2               BAS_INDX        := $0A          ; $0A      (alias of TMPEXP per msbasic SMALL)
000000r 2               BAS_EXPON       := $0B          ; $0B      EXPON
000000r 2               BAS_LOWTR       := $0C          ; $0C      LOWTR
000000r 2               BAS_EXPSGN      := $0D          ; $0D      EXPSGN  (== FAC-1 scratch byte)
000000r 2               BAS_FAC         := $0E          ; $0E-$12  FAC  (5 bytes)
000000r 2               BAS_FACSIGN     := $13          ; $13      FACSIGN  (== FAC+5)
000000r 2               BAS_SERLEN      := $14          ; $14      SERLEN
000000r 2               BAS_SHIFTSGN    := $15          ; $15      SHIFTSIGNEXT (== ARG-1 scratch)
000000r 2               BAS_ARG         := $16          ; $16-$1A  ARG  (5 bytes)
000000r 2               BAS_ARGSIGN     := $1B          ; $1B      ARGSIGN  (== ARG+5)
000000r 2               ; ----------------------------------------------------------------------------
000000r 2               
000000r 2               BAS_STRNG1      := $1C          ; $1C-$1D  STRNG1 (= SGNCPR; +1 = FACEXTENSION)
000000r 2               BAS_STRNG2      := $1E          ; $1E-$1F  STRNG2
000000r 2               
000000r 2               BAS_INDEX       := $20          ; $20-$21  General index pointer (line walk + msbasic INDEX)
000000r 2               BAS_DEST        := $22          ; $22-$23  Destination pointer (msbasic DEST)
000000r 2               
000000r 2               ; ----- Spill area: $3A-$67 --------------------------------------------------
000000r 2               BAS_TMP1        := $3A          ; $3A-$3B  General-purpose 16-bit pointer
000000r 2               BAS_TMP2        := $3C          ; $3C-$3D  General-purpose 16-bit pointer
000000r 2               BAS_TMP3        := $3E          ; $3E      Spill scratch byte
000000r 2               BAS_VARPNT      := $3F          ; $3F-$40  Current variable address
000000r 2               BAS_QUOTEFLG    := $41          ; $41      Tokenizer quote-state
000000r 2               BAS_DETOKY      := $42          ; $42      Saved Y across detokenize calls
000000r 2               
000000r 2               ; FP-only scratch registers (single bytes unless noted)
000000r 2               BAS_ARGEXT      := $43          ; ARGEXTENSION
000000r 2               BAS_CHARAC      := $44          ; CHARAC (string-quote/end char tracker)
000000r 2               BAS_CPRMASK     := $45          ; CPRMASK (FComp result mask)
000000r 2               BAS_FORPNT      := $46          ; $46-$47  FORPNT
000000r 2               BAS_RESULT      := $48          ; $48-$4C  RESULT  (5-byte FMult accumulator)
000000r 2               BAS_TEMP1       := $4D          ; $4D-$51  TEMP1  (5-byte FP scratch)
000000r 2               BAS_TEMP2       := $52          ; $52-$56  TEMP2  (5-byte FP scratch)
000000r 2               BAS_TEMP3       := $57          ; $57-$5B  TEMP3  (5-byte FP scratch)
000000r 2               BAS_RNDSEED     := $5C          ; $5C-$60  RNDSEED (5-byte FP value)
000000r 2               BAS_KWPTR       := $61          ; $61-$62  Keyword-table walker pointer
000000r 2               
000000r 2               ; ----- Variable / array / string-heap workspace ($63-$85) -----------------
000000r 2               BAS_DIMFLG      := $63          ; DIM-mode flag (nonzero = called from DIM)
000000r 2               BAS_VALTYP      := $64          ; $64-$65  Value type ($00=numeric, $FF=string)
000000r 2               BAS_EOLPNTR     := $66          ; Array scratch: dim count / pointer
000000r 2               BAS_DATAFLG     := $67          ; GetSpa: GC retry flag
000000r 2               BAS_SUBFLG      := $68          ; PtrGet: $40 from GETARYPT, $80 from DEF FN
000000r 2               BAS_INPUTFLG    := $69          ; INPUT/READ flag
000000r 2               BAS_ENDCHR      := $6A          ; StrLt2 secondary terminator
000000r 2               BAS_TEMPPT      := $6B          ; Top-of-temp-string-stack pointer
000000r 2               BAS_LASTPT      := $6C          ; $6C-$6D  Last temp descriptor allocated
000000r 2               BAS_TEMPST      := $6E          ; $6E-$76  Temp descriptor stack (3 * 3 bytes)
000000r 2               BAS_HIGHDS      := $77          ; $77-$78  Bltu dest end+1
000000r 2               BAS_HIGHTR      := $79          ; $79-$7A  Bltu source end+1
000000r 2               BAS_VARNAM      := $7B          ; $7B-$7C  Variable name pair (with type bits)
000000r 2               BAS_DSCPTR      := $7D          ; $7D-$7E  String descriptor pointer
000000r 2               BAS_DSCLEN      := $7F          ; $7F-$80  String descriptor length / GC scratch
000000r 2               BAS_FNCNAM      := $81          ; $81-$82  GC: highest-string descriptor ptr
000000r 2               BAS_Z52         := $83          ; GC scratch byte
000000r 2               BAS_FRESPC      := $84          ; $84-$85  Free-string-space pointer
000000r 2               ; ----------------------------------------------------------------------------
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; Symbol aliases used by the inlined MSBASIC FP code.  These let the ported
000000r 2               ; routines keep their original names without a global rename pass.
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               FAC             := BAS_FAC
000000r 2               FAC_LAST        := BAS_FAC + 4
000000r 2               FACSIGN         := BAS_FACSIGN
000000r 2               ARG             := BAS_ARG
000000r 2               ARG_LAST        := BAS_ARG + 4
000000r 2               ARGSIGN         := BAS_ARGSIGN
000000r 2               INDEX           := BAS_INDEX
000000r 2               DEST            := BAS_DEST
000000r 2               STRNG1          := BAS_STRNG1
000000r 2               STRNG2          := BAS_STRNG2
000000r 2               SGNCPR          := BAS_STRNG1            ; aliased as in msbasic zeropage.s
000000r 2               FACEXTENSION    := BAS_STRNG1 + 1        ; aliased as in msbasic zeropage.s
000000r 2               TXTPTR          := BAS_TXTPTR
000000r 2               LINNUM          := BAS_LINNUM
000000r 2               CURLIN          := BAS_CURLIN            ; non-ZP ($0369) — only used by InPrt
000000r 2               VARPNT          := BAS_VARPNT
000000r 2               ARGEXTENSION    := BAS_ARGEXT
000000r 2               EXPON           := BAS_EXPON
000000r 2               EXPSGN          := BAS_EXPSGN
000000r 2               LOWTR           := BAS_LOWTR
000000r 2               INDX            := BAS_INDX
000000r 2               TMPEXP          := BAS_TMPEXP
000000r 2               SERLEN          := BAS_SERLEN
000000r 2               SHIFTSIGNEXT    := BAS_SHIFTSGN
000000r 2               CHARAC          := BAS_CHARAC
000000r 2               CPRMASK         := BAS_CPRMASK
000000r 2               FORPNT          := BAS_FORPNT
000000r 2               RESULT          := BAS_RESULT
000000r 2               RESULT_LAST     := BAS_RESULT + 4
000000r 2               TEMP1           := BAS_TEMP1
000000r 2               TEMP2           := BAS_TEMP2
000000r 2               TEMP3           := BAS_TEMP3
000000r 2               RNDSEED         := BAS_RNDSEED
000000r 2               
000000r 2               ; ----- Aliases used by ported msbasic var/array/string code ----------------
000000r 2               DIMFLG          := BAS_DIMFLG
000000r 2               VALTYP          := BAS_VALTYP
000000r 2               EOLPNTR         := BAS_EOLPNTR
000000r 2               DATAFLG         := BAS_DATAFLG
000000r 2               SUBFLG          := BAS_SUBFLG
000000r 2               INPUTFLG        := BAS_INPUTFLG
000000r 2               ENDCHR          := BAS_ENDCHR
000000r 2               TEMPPT          := BAS_TEMPPT
000000r 2               LASTPT          := BAS_LASTPT
000000r 2               TEMPST          := BAS_TEMPST
000000r 2               HIGHDS          := BAS_HIGHDS
000000r 2               HIGHTR          := BAS_HIGHTR
000000r 2               VARNAM          := BAS_VARNAM
000000r 2               DSCPTR          := BAS_DSCPTR
000000r 2               DSCLEN          := BAS_DSCLEN
000000r 2               FNCNAM          := BAS_FNCNAM
000000r 2               Z52             := BAS_Z52
000000r 2               FRESPC          := BAS_FRESPC
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; Constants required by the ported FP code.
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               BYTES_FP        = 5
000000r 2               MANTISSA_BYTES  = 4
000000r 2               MAX_EXPON       = 10
000000r 2               STACK2          = $0100             ; Fout output buffer base (bottom of stack page)
000000r 2               
000000r 2               ; Variable / array layout constants (CONFIG_2 / CBM2-class equivalents).
000000r 2               BYTES_PER_VARIABLE = 7              ; 2 name + 5 value (numeric or descriptor)
000000r 2               BYTES_PER_ELEMENT  = 5              ; numeric array element size
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; Aliases for the runtime pointers that live in $035D+ (defined in BIOS.inc).
000000r 2               ; The msbasic var/array/string code references them by these short names.
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               TXTTAB          := BAS_TXTTAB
000000r 2               VARTAB          := BAS_VARTAB
000000r 2               ARYTAB          := BAS_ARYTAB
000000r 2               STREND          := BAS_STREND
000000r 2               FRETOP          := BAS_FRETOP
000000r 2               MEMSIZ          := BAS_MEMSIZ
000000r 2               
000000r 2               ; ERR_OVERFLOW / ERR_DIVZERO already defined below; alias zerodiv:
000000r 2               ERR_ZERODIV     = 6                 ; matches ERR_DIVZERO
000000r 2               
000000r 2               ; Fin parses these as numeric-prefix tokens.  Final token assignments are
000000r 2               ; wired up when the expression evaluator goes live; until then $00 is fine
000000r 2               ; (will not appear in tokenised input).
000000r 2               TOKEN_PLUS      = $00
000000r 2               TOKEN_MINUS     = $00
000000r 2               
000000r 2               ; Rnd(0) source: 6 stable but variable bytes from kernel vars (IRQ_PTR/BRK_PTR
000000r 2               ; etc.).  Just needs to exist — used only when Rnd is called with arg 0.
000000r 2               ENTROPY         = $0300
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   R A M   L A Y O U T   ( B A S I C   W O R K S P A C E )
000000r 2               ;
000000r 2               ;   $0400-$04FF   Input line buffer (256 bytes)
000000r 2               ;   $0500-$05FF   Tokenized line scratch (256 bytes)
000000r 2               ;
000000r 2               ;   GOSUB / FOR stacks live elsewhere; $0500-$05FF doubles as the
000000r 2               ;   tokenization scratch buffer.  $0600-$07FF overlaps FS_SECTOR_BUF and
000000r 2               ;   is left untouched here.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               BAS_LINBUF      := $0400        ; Raw input line  (NUL-terminated)
000000r 2               BAS_TOKBUF      := $0500        ; Tokenized scratch buffer (NUL-terminated)
000000r 2               
000000r 2               BAS_LINBUF_MAX  = 200           ; Max accepted input length (bytes)
000000r 2               BAS_TOKBUF_MAX  = 250           ; Max tokenized payload bytes
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   P R O G R A M   S T O R A G E
000000r 2               ;
000000r 2               ;   Lines at $0800+ : [next-lo][next-hi][num-lo][num-hi][tokens...][$00]
000000r 2               ;   End-of-program  : a "next-pointer" of $0000.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               BAS_PRG_START   = $0800
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   T O K E N   E Q U A T E S
000000r 2               ;
000000r 2               ;   Tokens are assigned sequentially starting at $80.  KEEP THE TABLE BELOW
000000r 2               ;   IN SYNC WITH THESE EQUATES.  If you reorder or insert keywords, renumber.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               TOK_BASE        = $80
000000r 2               
000000r 2               TOK_END         = $80
000000r 2               TOK_FOR         = $81
000000r 2               TOK_NEXT        = $82
000000r 2               TOK_DATA        = $83
000000r 2               TOK_INPUT       = $84
000000r 2               TOK_DIM         = $85
000000r 2               TOK_READ        = $86
000000r 2               TOK_LET         = $87
000000r 2               TOK_GOTO        = $88
000000r 2               TOK_RUN         = $89
000000r 2               TOK_IF          = $8A
000000r 2               TOK_RESTORE     = $8B
000000r 2               TOK_GOSUB       = $8C
000000r 2               TOK_RETURN      = $8D
000000r 2               TOK_REM         = $8E
000000r 2               TOK_STOP        = $8F
000000r 2               TOK_ON          = $90
000000r 2               TOK_WAIT        = $91
000000r 2               TOK_LOAD        = $92
000000r 2               TOK_SAVE        = $93
000000r 2               TOK_DEF         = $94
000000r 2               TOK_POKE        = $95
000000r 2               TOK_PRINT       = $96
000000r 2               TOK_CONT        = $97
000000r 2               TOK_LIST        = $98
000000r 2               TOK_CLR         = $99
000000r 2               TOK_NEW         = $9A
000000r 2               TOK_TAB         = $9B
000000r 2               TOK_TO          = $9C
000000r 2               TOK_FN          = $9D
000000r 2               TOK_SPC         = $9E
000000r 2               TOK_THEN        = $9F
000000r 2               TOK_NOT         = $A0
000000r 2               TOK_STEP        = $A1
000000r 2               TOK_AND         = $A2
000000r 2               TOK_OR          = $A3
000000r 2               TOK_ELSE        = $A4
000000r 2               TOK_SYS         = $A5
000000r 2               TOK_DIR         = $A6
000000r 2               TOK_DEL         = $A7
000000r 2               TOK_CLS         = $A8
000000r 2               TOK_LOCATE      = $A9
000000r 2               TOK_COLOR       = $AA
000000r 2               TOK_SOUND       = $AB
000000r 2               TOK_VOL         = $AC
000000r 2               TOK_TIME        = $AD
000000r 2               TOK_DATE        = $AE
000000r 2               TOK_SETTIME     = $AF
000000r 2               TOK_SETDATE     = $B0
000000r 2               TOK_NVRAM       = $B1
000000r 2               TOK_PAUSE       = $B2
000000r 2               TOK_BANK        = $B3
000000r 2               TOK_SCREEN      = $B4           ; BRK in 1.x
000000r 2               TOK_MEM         = $B5
000000r 2               TOK_SGN         = $B6
000000r 2               TOK_INT         = $B7
000000r 2               TOK_ABS         = $B8
000000r 2               TOK_FRE         = $B9
000000r 2               TOK_POS         = $BA
000000r 2               TOK_SQR         = $BB
000000r 2               TOK_RND         = $BC
000000r 2               TOK_LOG         = $BD
000000r 2               TOK_EXP         = $BE
000000r 2               TOK_COS         = $BF
000000r 2               TOK_SIN         = $C0
000000r 2               TOK_TAN         = $C1
000000r 2               TOK_ATN         = $C2
000000r 2               TOK_PEEK        = $C3
000000r 2               TOK_LEN         = $C4
000000r 2               TOK_STRSTR      = $C5           ; STR$
000000r 2               TOK_VAL         = $C6
000000r 2               TOK_ASC         = $C7
000000r 2               TOK_CHRSTR      = $C8           ; CHR$
000000r 2               TOK_LEFTSTR     = $C9           ; LEFT$
000000r 2               TOK_RIGHTSTR    = $CA           ; RIGHT$
000000r 2               TOK_MIDSTR      = $CB           ; MID$
000000r 2               TOK_JOY         = $CC
000000r 2               TOK_INKEY       = $CD
000000r 2               TOK_HEX         = $CE
000000r 2               TOK_MIN         = $CF
000000r 2               TOK_MAX         = $D0
000000r 2               TOK_DISK        = $D1           ; select current CF disk bank
000000r 2               TOK_BLOAD       = $D2           ; binary load to address
000000r 2               TOK_BSAVE       = $D3           ; binary save from address
000000r 2               TOK_FORMAT      = $D4           ; erase current disk directory
000000r 2               ; 2.0: the PICOVDP and the save slots.  Statements run on from FORMAT, so one
000000r 2               ; BasExtAddrTbl covers $D1-$DF; the functions follow them.
000000r 2               TOK_VPOKE       = $D5
000000r 2               TOK_VREG        = $D6
000000r 2               TOK_PALETTE     = $D7
000000r 2               TOK_VSYNC       = $D8
000000r 2               TOK_VLOAD       = $D9
000000r 2               TOK_SPRITE      = $DA
000000r 2               TOK_SCROLL      = $DB
000000r 2               TOK_LAYER       = $DC
000000r 2               TOK_NVSAVE      = $DD
000000r 2               TOK_NVLOAD      = $DE
000000r 2               TOK_NVERASE     = $DF
000000r 2               TOK_VPEEK       = $E0
000000r 2               TOK_VSTAT       = $E1
000000r 2               TOK_NVSTAT      = $E2
000000r 2               TOK_NVFIND      = $E3
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   E R R O R   C O D E S
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ERR_SYNTAX      = 0
000000r 2               ERR_OVERFLOW    = 1
000000r 2               ERR_OUTOFMEM    = 2
000000r 2               ERR_UNDEFSTMT   = 3
000000r 2               ERR_BADSUBSCR   = 4
000000r 2               ERR_REDIM       = 5
000000r 2               ERR_DIVZERO     = 6
000000r 2               ERR_ILLDIRECT   = 7
000000r 2               ERR_TYPEMISM    = 8
000000r 2               ERR_LONGSTR     = 9
000000r 2               ERR_FORMULA     = 10
000000r 2               ERR_ILLQUAN     = 11
000000r 2               ERR_RG          = 12            ; RETURN without GOSUB
000000r 2               ERR_NF          = 13            ; NEXT without FOR
000000r 2               ERR_OD          = 14            ; OUT OF DATA
000000r 2               ERR_NODEV       = 15
000000r 2               ERR_CANTCONT    = 16
000000r 2               
000000r 2               ; Aliases used by ported msbasic code.
000000r 2               ERR_BADSUBS     = ERR_BADSUBSCR
000000r 2               ERR_REDIMD      = ERR_REDIM
000000r 2               ERR_FRMCPX      = ERR_FORMULA
000000r 2               ERR_MEMFULL     = ERR_OUTOFMEM
000000r 2               ERR_STRLONG     = ERR_LONGSTR
000000r 2               ERR_ILLQTY      = ERR_ILLQUAN
000000r 2               
000000r 2               ; Lowest stack pointer GOSUB may descend to before raising OUT OF MEMORY.
000000r 2               ; Matches msbasic's GETSTK arithmetic for a GOSUB frame: 3*2 bytes of frame
000000r 2               ; plus a $3E-byte margin left for the interpreter's own JSR nesting (FrmEvl
000000r 2               ; recursion in particular) once the subroutine is running.  Frames cost about
000000r 2               ; 8 bytes apiece with those returns interleaved, so this permits roughly 23
000000r 2               ; levels -- the same working depth as Commodore BASIC.
000000r 2               GOSUB_STACK_MIN = $44
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   B A S E N T R Y   -   $C000
000000r 2               ;
000000r 2               ;   First byte of segment.  Reached from:
000000r 2               ;     * Kernal Reset, which clears BAS_WARM, so every reset is a cold start
000000r 2               ;     * Kernal Break, after a BRK instruction (warm re-entry)
000000r 2               ;     * Wozmon's C000R (warm re-entry)
000000r 2               ;
000000r 2               ;   Cold-vs-warm detection: BAS_WARM holds $A5 once cold init has run.
000000r 2               ;   Re-entry skips the header and goes straight to the OK prompt.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               BasEntry:
000000r 2  A2 FF                ldx     #$FF                    ; reset stack on (re)entry
000002r 2  9A                   txs
000003r 2  8E 75 03             stx     BAS_STKBASE             ; nothing suspended: the READY loop's
000006r 2                                                       ;   baseline is the empty stack
000006r 2  D8                   cld
000007r 2               
000007r 2  AD 6F 03             lda     BAS_WARM
00000Ar 2  C9 A5                cmp     #$A5
00000Cr 2  F0 08                beq     @Warm
00000Er 2               
00000Er 2  20 rr rr             jsr     BasColdInit
000011r 2  20 rr rr             jsr     BasBanner
000014r 2  80 2A                bra     BasReadyLoop
000016r 2               
000016r 2               @Warm:
000016r 2                       ; Warm restart - skip the header; the OK printer will lead with CRLF.
000016r 2                       ; Whatever was running is abandoned, as after an error: back to direct
000016r 2                       ; mode, with nothing for CONT to resume (it tests OLDTEXT's high byte).
000016r 2  A9 FF                lda     #$FF
000018r 2  8D 69 03             sta     BAS_CURLIN
00001Br 2  8D 6A 03             sta     BAS_CURLIN+1
00001Er 2  9C 6E 03             stz     BAS_OLDTEXT+1
000021r 2                       ; A loader outside BASIC may have dropped a new image at $0800 since we
000021r 2                       ; were last here, and said how long it is in PRG_IMAGE_END (see
000021r 2                       ; ProgramEnd).  Adopt it: the old variables describe a program that no
000021r 2                       ; longer exists, so ARYTAB/STREND follow VARTAB exactly as they would on
000021r 2                       ; a fresh LOAD.
000021r 2  AD 8E 03             lda     PRG_IMAGE_END
000024r 2  0D 8F 03             ora     PRG_IMAGE_END+1
000027r 2  F0 17                beq     BasReadyLoop
000029r 2  20 rr rr             jsr     ProgramEnd
00002Cr 2  8D 5F 03             sta     BAS_VARTAB
00002Fr 2  8C 60 03             sty     BAS_VARTAB+1
000032r 2  A2 01                ldx     #1
000034r 2               @adopt:
000034r 2  BD 5F 03             lda     BAS_VARTAB,x
000037r 2  9D 61 03             sta     BAS_ARYTAB,x
00003Ar 2  9D 63 03             sta     BAS_STREND,x
00003Dr 2  CA                   dex
00003Er 2  10 F4                bpl     @adopt
000040r 2               
000040r 2               ; -----------------------------------------------------------------------------
000040r 2               ; BasReadyLoop - REPL: print OK, read a line, dispatch.
000040r 2               ; -----------------------------------------------------------------------------
000040r 2               BasReadyLoop:
000040r 2  20 rr rr             jsr     BasTextConsole          ; the prompt needs the Text console
000043r 2  20 rr rr             jsr     BasPrintOK
000046r 2               @nextline:
000046r 2  20 rr rr             jsr     BasReadLine             ; fills BAS_LINBUF, NUL-terminated
000049r 2  20 rr rr             jsr     BasProcessLine
00004Cr 2  80 F8                bra     @nextline
00004Er 2               
00004Er 2               ; =============================================================================
00004Er 2               ;   B a s C o l d I n i t
00004Er 2               ; =============================================================================
00004Er 2               ; Initialise BASIC runtime variables.  Called once on first entry.
00004Er 2               ; =============================================================================
00004Er 2               BasColdInit:
00004Er 2                       ; ---------------------------------------------------------------------
00004Er 2                       ; Zero the BASIC-owned zero-page workspace first.  On a cold boot RAM
00004Er 2                       ; holds random power-up values, and the inlined MSBASIC math/parse code
00004Er 2                       ; treats several scratch cells as invariant-zero (e.g. SHIFTSIGNEXT,
00004Er 2                       ; FACEXTENSION, ARGEXTENSION) — they are only written on certain code
00004Er 2                       ; paths and assumed already 0 otherwise.  A random value in any of them
00004Er 2                       ; corrupts results; this is what produced the bogus "84405.0911 BYTES
00004Er 2                       ; FREE" banner on real hardware.  Clearing the whole region up front
00004Er 2                       ; eliminates this entire class of uninitialised-read bugs.  The two
00004Er 2                       ; ranges are the BASIC primary workspace ($04-$23) and the FP / var /
00004Er 2                       ; array / string spill ($3A-$85); $24-$39 is Kernal-reserved and left
00004Er 2                       ; untouched.  Specific non-zero values (CURLIN, TEMPPT, RND seed, etc.)
00004Er 2                       ; are written further down, after this clear.
00004Er 2  A9 00                lda     #0
000050r 2  A2 04                ldx     #BAS_TXTPTR             ; $04..$23
000052r 2               @ClrZpLo:
000052r 2  95 00                sta     ZP,x
000054r 2  E8                   inx
000055r 2  E0 24                cpx     #BAS_DEST+2
000057r 2  D0 F9                bne     @ClrZpLo
000059r 2  A2 3A                ldx     #BAS_TMP1               ; $3A..$85
00005Br 2               @ClrZpHi:
00005Br 2  95 00                sta     ZP,x
00005Dr 2  E8                   inx
00005Er 2  E0 86                cpx     #BAS_FRESPC+2
000060r 2  D0 F9                bne     @ClrZpHi
000062r 2               
000062r 2                       ; TXTTAB / MEMSIZ are constants for our memory map.
000062r 2  A9 00                lda     #<BAS_PRG_START
000064r 2  8D 5D 03             sta     BAS_TXTTAB
000067r 2  A9 08                lda     #>BAS_PRG_START
000069r 2  8D 5E 03             sta     BAS_TXTTAB+1
00006Cr 2               
00006Cr 2  A9 00                lda     #<$8000
00006Er 2  8D 67 03             sta     BAS_MEMSIZ
000071r 2  A9 80                lda     #>$8000
000073r 2  8D 68 03             sta     BAS_MEMSIZ+1
000076r 2               
000076r 2                       ; Where does the program already sitting at $0800 end?  The Kernal owns
000076r 2                       ; this: it prefers a byte count recorded by a loader outside BASIC (so a
000076r 2                       ; .prg it placed keeps its machine code), falls back to a chain
000076r 2                       ; walk, and installs an empty program if there is nothing usable.
000076r 2  20 rr rr             jsr     ProgramEnd
000079r 2  8D 5F 03             sta     BAS_VARTAB
00007Cr 2  8C 60 03             sty     BAS_VARTAB+1
00007Fr 2               
00007Fr 2                       ; ARYTAB = STREND = VARTAB; FRETOP = MEMSIZ.
00007Fr 2  AD 5F 03             lda     BAS_VARTAB
000082r 2  8D 61 03             sta     BAS_ARYTAB
000085r 2  8D 63 03             sta     BAS_STREND
000088r 2  AD 60 03             lda     BAS_VARTAB+1
00008Br 2  8D 62 03             sta     BAS_ARYTAB+1
00008Er 2  8D 64 03             sta     BAS_STREND+1
000091r 2  AD 67 03             lda     BAS_MEMSIZ
000094r 2  8D 65 03             sta     BAS_FRETOP
000097r 2  AD 68 03             lda     BAS_MEMSIZ+1
00009Ar 2  8D 66 03             sta     BAS_FRETOP+1
00009Dr 2               
00009Dr 2                       ; CURLIN = $FFFF (direct mode marker).
00009Dr 2  A9 FF                lda     #$FF
00009Fr 2  8D 69 03             sta     BAS_CURLIN
0000A2r 2  8D 6A 03             sta     BAS_CURLIN+1
0000A5r 2               
0000A5r 2                       ; Clear CONT state and pending-key.
0000A5r 2  9C 6B 03             stz     BAS_OLDLIN
0000A8r 2  9C 6C 03             stz     BAS_OLDLIN+1
0000ABr 2  9C 6D 03             stz     BAS_OLDTEXT
0000AEr 2  9C 6E 03             stz     BAS_OLDTEXT+1
0000B1r 2  9C 1A 03             stz     BAS_DATAPTR
0000B4r 2  9C 1B 03             stz     BAS_DATAPTR+1
0000B7r 2  9C 1C 03             stz     BAS_STOPLINE
0000BAr 2  9C 1D 03             stz     BAS_STOPLINE+1
0000BDr 2  9C 1E 03             stz     BAS_STOPTXT
0000C0r 2  9C 1F 03             stz     BAS_STOPTXT+1
0000C3r 2  9C 0E 03             stz     BAS_PENDKEY
0000C6r 2  9C 70 03             stz     BAS_POSX                ; PRINT column counter (non-ZP)
0000C9r 2               
0000C9r 2                       ; ZP runtime flags (QUOTEFLG, DIMFLG, VALTYP, DATAFLG, SUBFLG,
0000C9r 2                       ; INPUTFLG, SHIFTSIGNEXT, ...) are already zeroed by the cold-init
0000C9r 2                       ; clear loop above; only non-zero / non-ZP state is set here.
0000C9r 2               
0000C9r 2                       ; Temp-string descriptor stack: TEMPPT = TEMPST.
0000C9r 2  A9 6E                lda     #BAS_TEMPST
0000CBr 2  85 6B                sta     BAS_TEMPPT
0000CDr 2               
0000CDr 2                       ; Initialise Rnd seed from the embedded constant.
0000CDr 2  A2 04                ldx     #4
0000CFr 2               @SeedCopy:
0000CFr 2  BD rr rr             lda     RndSeedInit,x
0000D2r 2  95 5C                sta     RNDSEED,x
0000D4r 2  CA                   dex
0000D5r 2  10 F8                bpl     @SeedCopy
0000D7r 2               
0000D7r 2                       ; Mark warm-start magic.
0000D7r 2  A9 A5                lda     #$A5
0000D9r 2  8D 6F 03             sta     BAS_WARM
0000DCr 2  60                   rts
0000DDr 2               
0000DDr 2               ; =============================================================================
0000DDr 2               ;   B a s B a n n e r
0000DDr 2               ; =============================================================================
0000DDr 2               BasBanner:
0000DDr 2  20 rr rr             jsr     VideoClear              ; a fresh screen (does nothing without video)
0000E0r 2  20 rr rr             jsr     BasPrintCRLF
0000E3r 2  20 rr rr             jsr     BasLogo                 ; on a video console only
0000E6r 2  A9 rr                lda     #<MsgHeader
0000E8r 2  A0 rr                ldy     #>MsgHeader
0000EAr 2  20 rr rr             jsr     BasPrintStr
0000EDr 2  A9 rr                lda     #<MsgBasicV2
0000EFr 2  A0 rr                ldy     #>MsgBasicV2
0000F1r 2  20 rr rr             jsr     BasPrintStr
0000F4r 2                       ; Print "BASIC v2.0 <n> BYTES FREE" line.
0000F4r 2  38                   sec
0000F5r 2  AD 67 03             lda     BAS_MEMSIZ
0000F8r 2  ED 5F 03             sbc     BAS_VARTAB
0000FBr 2  A8                   tay
0000FCr 2  AD 68 03             lda     BAS_MEMSIZ+1
0000FFr 2  ED 60 03             sbc     BAS_VARTAB+1
000102r 2  20 rr rr             jsr     GivAyf
000105r 2                       ; Print the byte count: Fout always emits a leading sign character
000105r 2                       ; (' ' for positive, '-' for negative).  For the header we skip that
000105r 2                       ; leading space, so one space, MsgBasicV2's, separates the number
000105r 2                       ; from "BASIC v2.0".
000105r 2  20 rr rr             jsr     Fout                    ; (Y,A) -> NUL-terminated buffer
000108r 2  85 20                sta     INDEX
00010Ar 2  84 21                sty     INDEX+1
00010Cr 2  A0 00                ldy     #0
00010Er 2  B1 20                lda     (INDEX),y
000110r 2  C9 20                cmp     #' '
000112r 2  D0 01                bne     @bnLoop
000114r 2  C8                   iny                             ; skip the positive-sign space
000115r 2               @bnLoop:
000115r 2  B1 20                lda     (INDEX),y
000117r 2  F0 06                beq     @bnDone
000119r 2  20 rr rr             jsr     PrintCh
00011Cr 2  C8                   iny
00011Dr 2  D0 F6                bne     @bnLoop
00011Fr 2               @bnDone:
00011Fr 2  A9 rr                lda     #<MsgBytesFreeNL
000121r 2  A0 rr                ldy     #>MsgBytesFreeNL
000123r 2  20 rr rr             jsr     BasPrintStr
000126r 2                       ; The fitted cards, in HW_PRESENT's bit order, one space between names.
000126r 2                       ; Either RAM card prints RAM, so RAM_L is folded into RAM_H's bit and
000126r 2                       ; the seven that remain are shifted out in step with HwNames.
000126r 2  AD 0D 03             lda     HW_PRESENT
000129r 2  4A                   lsr     a                       ; C = RAM_L; bit 0 is now RAM_H
00012Ar 2  90 02                bcc     @hwStart
00012Cr 2  09 01                ora     #$01
00012Er 2               @hwStart:
00012Er 2  A2 00                ldx     #0                      ; X = index into HwNames
000130r 2  A0 00                ldy     #0                      ; Y = 0 until a name has been printed
000132r 2               @hwBit:
000132r 2  4A                   lsr     a                       ; C = this card
000133r 2  48                   pha
000134r 2  90 15                bcc     @hwSkip
000136r 2  98                   tya
000137r 2  F0 05                beq     @hwName
000139r 2  A9 20                lda     #' '
00013Br 2  20 rr rr             jsr     Chrout                  ; Chrout keeps X and Y
00013Er 2               @hwName:
00013Er 2  A0 01                ldy     #1
000140r 2               @hwChar:
000140r 2  E8                   inx
000141r 2  BD rr rr             lda     HwNames-1,x
000144r 2  F0 0B                beq     @hwNext
000146r 2  20 rr rr             jsr     Chrout
000149r 2  80 F5                bra     @hwChar
00014Br 2               @hwSkip:
00014Br 2  E8                   inx
00014Cr 2  BD rr rr             lda     HwNames-1,x
00014Fr 2  D0 FA                bne     @hwSkip
000151r 2               @hwNext:
000151r 2  68                   pla                             ; the cards not yet shifted out
000152r 2  D0 DE                bne     @hwBit
000154r 2  4C rr rr             jmp     BasPrintCRLF
000157r 2               
000157r 2               HwNames:
000157r 2  52 41 4D 00          .byte   "RAM",0,"RTC",0,"CF",0,"SER",0,"VIA",0,"SID",0,"VDP",0
00015Br 2  52 54 43 00  
00015Fr 2  43 46 00 53  
000172r 2               
000172r 2               ; =============================================================================
000172r 2               ;   B a s L o g o
000172r 2               ; =============================================================================
000172r 2               ; The colour "AC6502" above the header, on a video console only: four rows of
000172r 2               ; half-block letters and digits, 23 columns centred in 40, each row in its own
000172r 2               ; colour from palette row 0 on the pen's background, then a blank line.  The
000172r 2               ; pen is put back afterwards.
000172r 2               ;
000172r 2               ; LogoRle, a row at a time: a foreground colour (1-15), then runs of
000172r 2               ; (character index << 6) | count (count 1-63), then $00 to end the row.  A
000172r 2               ; colour of $00 ends the table.  The indices are LogoChars'.
000172r 2               BasLogo:
000172r 2  AD 06 03             lda     IO_MODE
000175r 2  4A                   lsr     a                       ; bit 0: 1 = serial
000176r 2  B0 4A                bcs     @done
000178r 2  2C 0D 03             bit     HW_PRESENT              ; HW_VID is bit 7
00017Br 2  10 45                bpl     @done
00017Dr 2  AD 91 03             lda     VID_PEN
000180r 2  48                   pha
000181r 2  A2 00                ldx     #0
000183r 2               @row:
000183r 2  BD rr rr             lda     LogoRle,x
000186r 2  F0 33                beq     @end
000188r 2  E8                   inx
000189r 2  0A                   asl     a                       ; the band's colour as foreground
00018Ar 2  0A                   asl     a
00018Br 2  0A                   asl     a
00018Cr 2  0A                   asl     a
00018Dr 2  85 20                sta     INDEX
00018Fr 2  68                   pla
000190r 2  48                   pha
000191r 2  29 0F                and     #$0F                    ; on the pen's background
000193r 2  05 20                ora     INDEX
000195r 2  20 rr rr             jsr     VideoSetColor           ; keeps X and Y
000198r 2               @run:
000198r 2  BD rr rr             lda     LogoRle,x
00019Br 2  E8                   inx
00019Cr 2  A8                   tay
00019Dr 2  F0 17                beq     @eol
00019Fr 2  29 3F                and     #$3F
0001A1r 2  85 20                sta     INDEX                   ; the count
0001A3r 2  98                   tya
0001A4r 2  2A                   rol     a                       ; b7:6 round into b1:0
0001A5r 2  2A                   rol     a
0001A6r 2  2A                   rol     a
0001A7r 2  29 03                and     #$03
0001A9r 2  A8                   tay
0001AAr 2  B9 rr rr             lda     LogoChars,y
0001ADr 2               @char:
0001ADr 2  20 rr rr             jsr     VideoChroutRaw          ; keeps A, X and Y
0001B0r 2  C6 20                dec     INDEX
0001B2r 2  D0 F9                bne     @char
0001B4r 2  80 E2                bra     @run
0001B6r 2               @eol:
0001B6r 2  20 rr rr             jsr     BasPrintCRLF            ; Chrout keeps X
0001B9r 2  80 C8                bra     @row
0001BBr 2               @end:
0001BBr 2  68                   pla
0001BCr 2  20 rr rr             jsr     VideoSetColor
0001BFr 2  4C rr rr             jmp     BasPrintCRLF
0001C2r 2               @done:
0001C2r 2  60                   rts
0001C3r 2               
0001C3r 2               LogoChars:
0001C3r 2  20 DB DC DF          .byte   ' ', $DB, $DC, $DF      ; space, full block, lower half, upper half
0001C7r 2               LogoRle:
0001C7r 2  06 08 41 C1          .byte   $06,$08,$41,$C1,$41,$01,$41,$C2,$01,$41,$C2,$01,$41,$C2,$01,$41,$C1,$41,$01,$C2,$41,$00 ; █▀█ █▀▀ █▀▀ █▀▀ █▀█ ▀▀█  dark red
0001CBr 2  41 01 41 C2  
0001CFr 2  01 41 C2 01  
0001DDr 2  08 08 41 81          .byte   $08,$08,$41,$81,$41,$01,$41,$03,$41,$82,$01,$41,$82,$01,$41,$01,$41,$01,$82,$41,$00     ; █▄█ █   █▄▄ █▄▄ █ █ ▄▄█  medium red
0001E1r 2  41 01 41 03  
0001E5r 2  41 82 01 41  
0001F2r 2  0A 08 41 01          .byte   $0A,$08,$41,$01,$41,$01,$41,$03,$41,$01,$41,$03,$41,$01,$41,$01,$41,$01,$41,$00         ; █ █ █   █ █   █ █ █ █    dark yellow
0001F6r 2  41 01 41 03  
0001FAr 2  41 01 41 03  
000206r 2  02 08 41 01          .byte   $02,$08,$41,$01,$41,$01,$41,$82,$01,$41,$81,$41,$01,$82,$41,$01,$41,$81,$41,$01,$41,$82,$00 ; █ █ █▄▄ █▄█ ▄▄█ █▄█ █▄▄  medium green
00020Ar 2  41 01 41 82  
00020Er 2  01 41 81 41  
00021Dr 2  00                   .byte   $00
00021Er 2               
00021Er 2               ; =============================================================================
00021Er 2               ;   B a s P r i n t O K
00021Er 2               ; =============================================================================
00021Er 2               BasPrintOK:
00021Er 2  20 rr rr             jsr     BasPrintCRLF
000221r 2  A9 rr                lda     #<MsgOK
000223r 2  A0 rr                ldy     #>MsgOK
000225r 2  4C rr rr             jmp     BasPrintStr
000228r 2               
000228r 2               ; =============================================================================
000228r 2               ;   B a s P r i n t S t r  /  B a s P r i n t C R L F
000228r 2               ; =============================================================================
000228r 2               ; These were promoted to the KERNAL jump table as PrintStr ($A090) and
000228r 2               ; PrintCRLF ($A093) so cartridges can reuse them and the KERNAL no longer
000228r 2               ; depends on BASIC-segment code.  Keep the old BASIC names as aliases so the
000228r 2               ; existing call sites (and A=lo/Y=hi convention) are unchanged.
000228r 2               BasPrintStr     := PrintStr
000228r 2               BasPrintCRLF    := PrintCRLF
000228r 2               
000228r 2               ; =============================================================================
000228r 2               ;   B a s R e a d L i n e
000228r 2               ; =============================================================================
000228r 2               ; Read a line of input into BAS_LINBUF, NUL-terminated.  Echoes characters
000228r 2               ; manually (does not use Chrin's auto-echo).  Supports CR, BS ($08), ESC
000228r 2               ; ($1B = cancel and restart line).  Caps stored length at BAS_LINBUF_MAX
000228r 2               ; (extra characters are silently dropped from the buffer but still echoed
000228r 2               ; -- acceptable truncation behavior).
000228r 2               ;
000228r 2               ; Output : BAS_LINBUF holds the raw line, terminated with $00.
000228r 2               ; =============================================================================
000228r 2               BasReadLine:
000228r 2  A0 00                ldy     #0
00022Ar 2               @Loop:
00022Ar 2  20 rr rr             jsr     BasReadKey              ; A = next key, blocking
00022Dr 2  C9 0D                cmp     #$0D
00022Fr 2  F0 30                beq     @Done
000231r 2  C9 08                cmp     #$08
000233r 2  F0 19                beq     @Backspace
000235r 2  C9 1B                cmp     #$1B
000237r 2  F0 21                beq     @Cancel
000239r 2  C9 20                cmp     #$20                    ; reject control codes below space
00023Br 2  90 ED                bcc     @Loop
00023Dr 2  C9 7F                cmp     #$7F                    ; reject DEL and 8-bit
00023Fr 2  B0 E9                bcs     @Loop
000241r 2                       ; Printable - store and echo.
000241r 2  C0 C8                cpy     #BAS_LINBUF_MAX
000243r 2  B0 E5                bcs     @Loop                   ; full - drop quietly
000245r 2  99 00 04             sta     BAS_LINBUF,y
000248r 2  C8                   iny
000249r 2  20 rr rr             jsr     Chrout
00024Cr 2  80 DC                bra     @Loop
00024Er 2               
00024Er 2               @Backspace:
00024Er 2  C0 00                cpy     #0
000250r 2  F0 D8                beq     @Loop                   ; nothing to erase
000252r 2  88                   dey
000253r 2  A9 08                lda     #$08                    ; video / serial driver erases on BS
000255r 2  20 rr rr             jsr     Chrout
000258r 2  80 D0                bra     @Loop
00025Ar 2               
00025Ar 2               @Cancel:
00025Ar 2  20 rr rr             jsr     BasPrintCRLF
00025Dr 2  A0 00                ldy     #0
00025Fr 2  80 C9                bra     @Loop
000261r 2               
000261r 2               @Done:
000261r 2  A9 00                lda     #0
000263r 2  99 00 04             sta     BAS_LINBUF,y
000266r 2  20 rr rr             jsr     BasPrintCRLF
000269r 2  60                   rts
00026Ar 2               
00026Ar 2               ; =============================================================================
00026Ar 2               ;   B a s R e a d K e y
00026Ar 2               ; =============================================================================
00026Ar 2               ; Spin until a key is available in the input buffer; return it in A
00026Ar 2               ; (no echo).
00026Ar 2               ; =============================================================================
00026Ar 2               BasReadKey:
00026Ar 2               @Wait:
00026Ar 2  20 rr rr             jsr     BufferSize
00026Dr 2  F0 FB                beq     @Wait
00026Fr 2  4C rr rr             jmp     ReadBuffer              ; tail-call: returns A=byte
000272r 2               
000272r 2               ; =============================================================================
000272r 2               ;   B a s P r o c e s s L i n e
000272r 2               ; =============================================================================
000272r 2               ; Triage BAS_LINBUF after reading: empty, numbered (insert/replace/delete),
000272r 2               ; or immediate command.
000272r 2               ; =============================================================================
000272r 2               BasProcessLine:
000272r 2  A2 00                ldx     #0
000274r 2               @SkipSpaces:
000274r 2  BD 00 04             lda     BAS_LINBUF,x
000277r 2  F0 07                beq     @Empty
000279r 2  C9 20                cmp     #' '
00027Br 2  D0 04                bne     @HasContent
00027Dr 2  E8                   inx
00027Er 2  80 F4                bra     @SkipSpaces
000280r 2               @Empty:
000280r 2  60                   rts                             ; nothing to do; caller will reprompt
000281r 2               
000281r 2               @HasContent:
000281r 2  C9 30                cmp     #'0'
000283r 2  90 1A                bcc     @Immediate
000285r 2  C9 3A                cmp     #'9'+1
000287r 2  B0 16                bcs     @Immediate
000289r 2               
000289r 2               ; --- Numbered line -----------------------------------------------------------
000289r 2  20 rr rr             jsr     BasParseLineNum         ; consumes digits at BAS_LINBUF+X
00028Cr 2                       ; X now points to first non-digit; allow exactly one optional space.
00028Cr 2  BD 00 04             lda     BAS_LINBUF,x
00028Fr 2  C9 20                cmp     #' '
000291r 2  D0 01                bne     @TokenizeRest
000293r 2  E8                   inx
000294r 2               @TokenizeRest:
000294r 2  20 rr rr             jsr     BasCrunch               ; tokenize from BAS_LINBUF+X to BAS_TOKBUF
000297r 2  B0 03                bcs     @StoreLine              ; carry set = success
000299r 2  4C rr rr             jmp     BasErrSyntax
00029Cr 2               
00029Cr 2               @StoreLine:
00029Cr 2  4C rr rr             jmp     BasStoreLine            ; insert/replace/delete by line number
00029Fr 2               
00029Fr 2               @Immediate:
00029Fr 2                       ; Immediate (no line number) - tokenize whole line and dispatch.
00029Fr 2  A2 00                ldx     #0
0002A1r 2  20 rr rr             jsr     BasCrunch
0002A4r 2  B0 03                bcs     @ImmDispatch
0002A6r 2  4C rr rr             jmp     BasErrSyntax
0002A9r 2               @ImmDispatch:
0002A9r 2  20 rr rr             jsr     BasDispatchImmediate
0002ACr 2  4C rr rr             jmp     BasPrintOK              ; MS BASIC: OK only after immediate
0002AFr 2               
0002AFr 2               ; =============================================================================
0002AFr 2               ;   B a s P a r s e L i n e N u m
0002AFr 2               ; =============================================================================
0002AFr 2               ; Parse decimal digits at BAS_LINBUF,X into BAS_LINNUM (16-bit).
0002AFr 2               ; X advances past the digits.  Saturates at $FFFF on overflow.
0002AFr 2               ; =============================================================================
0002AFr 2               BasParseLineNum:
0002AFr 2  64 08                stz     BAS_LINNUM
0002B1r 2  64 09                stz     BAS_LINNUM+1
0002B3r 2               @Loop:
0002B3r 2  BD 00 04             lda     BAS_LINBUF,x
0002B6r 2  C9 30                cmp     #'0'
0002B8r 2  90 35                bcc     @Done
0002BAr 2  C9 3A                cmp     #'9'+1
0002BCr 2  B0 31                bcs     @Done
0002BEr 2                       ; Multiply LINNUM by 10.
0002BEr 2  48                   pha
0002BFr 2  06 08                asl     BAS_LINNUM              ; *2
0002C1r 2  26 09                rol     BAS_LINNUM+1
0002C3r 2  A5 08                lda     BAS_LINNUM
0002C5r 2  85 3A                sta     BAS_TMP1
0002C7r 2  A5 09                lda     BAS_LINNUM+1
0002C9r 2  85 3B                sta     BAS_TMP1+1
0002CBr 2  06 08                asl     BAS_LINNUM              ; *4
0002CDr 2  26 09                rol     BAS_LINNUM+1
0002CFr 2  06 08                asl     BAS_LINNUM              ; *8
0002D1r 2  26 09                rol     BAS_LINNUM+1
0002D3r 2  18                   clc                             ; *8 + *2 = *10
0002D4r 2  A5 08                lda     BAS_LINNUM
0002D6r 2  65 3A                adc     BAS_TMP1
0002D8r 2  85 08                sta     BAS_LINNUM
0002DAr 2  A5 09                lda     BAS_LINNUM+1
0002DCr 2  65 3B                adc     BAS_TMP1+1
0002DEr 2  85 09                sta     BAS_LINNUM+1
0002E0r 2                       ; Add digit value.
0002E0r 2  68                   pla
0002E1r 2  29 0F                and     #$0F
0002E3r 2  18                   clc
0002E4r 2  65 08                adc     BAS_LINNUM
0002E6r 2  85 08                sta     BAS_LINNUM
0002E8r 2  90 02                bcc     @NoCarry
0002EAr 2  E6 09                inc     BAS_LINNUM+1
0002ECr 2               @NoCarry:
0002ECr 2  E8                   inx
0002EDr 2  80 C4                bra     @Loop
0002EFr 2               @Done:
0002EFr 2  60                   rts
0002F0r 2               
0002F0r 2               ; =============================================================================
0002F0r 2               ;   B a s C r u n c h
0002F0r 2               ; =============================================================================
0002F0r 2               ; Tokenize BAS_LINBUF starting at offset X into BAS_TOKBUF.
0002F0r 2               ;
0002F0r 2               ; Tokenization rules:
0002F0r 2               ;   - Outside quoted strings, lowercase a-z are folded to uppercase.
0002F0r 2               ;   - Outside quoted strings, alphabetic runs are matched against the
0002F0r 2               ;     keyword table; on a match the token byte is emitted in place of the
0002F0r 2               ;     keyword characters.
0002F0r 2               ;   - Inside double quotes, characters are copied verbatim until the
0002F0r 2               ;     closing quote (or end of line).
0002F0r 2               ;   - After a REM token, the rest of the line is copied verbatim.
0002F0r 2               ;   - Disallowed punctuation (@, &, [, ], {, }, |, \, `, ~) raises
0002F0r 2               ;     ?SYNTAX ERROR via carry-clear return.
0002F0r 2               ;
0002F0r 2               ; Output : BAS_TOKBUF holds the tokenized line, NUL-terminated.
0002F0r 2               ; Returns: carry SET on success, carry CLEAR on syntax error.
0002F0r 2               ; Clobbers: A, X, Y, BAS_TMP1/TMP2/TMP3.
0002F0r 2               ; =============================================================================
0002F0r 2               BasCrunch:
0002F0r 2                       ; X = src index, Y = dst index
0002F0r 2  A0 00                ldy     #0
0002F2r 2  64 41                stz     BAS_QUOTEFLG
0002F4r 2               @Scan:
0002F4r 2  C0 FA                cpy     #BAS_TOKBUF_MAX
0002F6r 2  B0 0A                bcs     @Overflow
0002F8r 2  BD 00 04             lda     BAS_LINBUF,x
0002FBr 2  D0 07                bne     @NotEnd
0002FDr 2                       ; End of input.
0002FDr 2  99 00 05             sta     BAS_TOKBUF,y            ; A=0
000300r 2  38                   sec
000301r 2  60                   rts
000302r 2               @Overflow:
000302r 2                       ; Tokenized line too long; treat as syntax error.
000302r 2  18                   clc
000303r 2  60                   rts
000304r 2               
000304r 2               @NotEnd:
000304r 2  C9 22                cmp     #'"'
000306r 2  F0 56                beq     @Quote
000308r 2                       ; Lowercase to uppercase outside quotes.
000308r 2  C9 61                cmp     #'a'
00030Ar 2  90 06                bcc     @CheckAlpha
00030Cr 2  C9 7B                cmp     #'z'+1
00030Er 2  B0 02                bcs     @CheckAlpha
000310r 2  29 DF                and     #$DF
000312r 2               @CheckAlpha:
000312r 2                       ; Alphabetic? Try keyword match.
000312r 2  C9 41                cmp     #'A'
000314r 2  90 3A                bcc     @NotAlpha
000316r 2  C9 5B                cmp     #'Z'+1
000318r 2  B0 36                bcs     @NotAlpha
00031Ar 2                       ; Alpha - try matching a keyword starting at BAS_LINBUF,x.
00031Ar 2  20 rr rr             jsr     BasMatchKeyword         ; returns C set (A=token, X advanced) or C clear
00031Dr 2  90 1D                bcc     @CopyAlpha
00031Fr 2                       ; Match: emit token byte.
00031Fr 2  99 00 05             sta     BAS_TOKBUF,y
000322r 2  C8                   iny
000323r 2  C9 8E                cmp     #TOK_REM
000325r 2  D0 CD                bne     @Scan
000327r 2                       ; After REM: copy the remainder verbatim.
000327r 2               @RemCopy:
000327r 2  C0 FA                cpy     #BAS_TOKBUF_MAX
000329r 2  B0 D7                bcs     @Overflow
00032Br 2  BD 00 04             lda     BAS_LINBUF,x
00032Er 2  F0 07                beq     @TermAndExit
000330r 2  99 00 05             sta     BAS_TOKBUF,y
000333r 2  C8                   iny
000334r 2  E8                   inx
000335r 2  80 F0                bra     @RemCopy
000337r 2               @TermAndExit:
000337r 2  99 00 05             sta     BAS_TOKBUF,y            ; A=0
00033Ar 2  38                   sec
00033Br 2  60                   rts
00033Cr 2               
00033Cr 2               @CopyAlpha:
00033Cr 2                       ; No keyword match - copy a single alpha char (re-uppercase here, since
00033Cr 2                       ; BasMatchKeyword returns the original LINBUF byte).
00033Cr 2  BD 00 04             lda     BAS_LINBUF,x
00033Fr 2  C9 61                cmp     #'a'
000341r 2  90 06                bcc     @CASto
000343r 2  C9 7B                cmp     #'z'+1
000345r 2  B0 02                bcs     @CASto
000347r 2  29 DF                and     #$DF
000349r 2               @CASto:
000349r 2  99 00 05             sta     BAS_TOKBUF,y
00034Cr 2  C8                   iny
00034Dr 2  E8                   inx
00034Er 2  80 A4                bra     @Scan
000350r 2               
000350r 2               @NotAlpha:
000350r 2                       ; Punctuation / digit / space.  Validate against the disallowed set.
000350r 2  20 rr rr             jsr     BasValidPunct
000353r 2  90 07                bcc     @SyntaxFail
000355r 2  99 00 05             sta     BAS_TOKBUF,y
000358r 2  C8                   iny
000359r 2  E8                   inx
00035Ar 2  80 98                bra     @Scan
00035Cr 2               @SyntaxFail:
00035Cr 2  18                   clc
00035Dr 2  60                   rts
00035Er 2               
00035Er 2               @Quote:
00035Er 2                       ; Copy opening quote, then everything up to closing quote (or end).
00035Er 2  99 00 05             sta     BAS_TOKBUF,y
000361r 2  C8                   iny
000362r 2  E8                   inx
000363r 2               @QuoteLoop:
000363r 2  C0 FA                cpy     #BAS_TOKBUF_MAX
000365r 2  B0 9B                bcs     @Overflow
000367r 2  BD 00 04             lda     BAS_LINBUF,x
00036Ar 2  F0 CB                beq     @TermAndExit
00036Cr 2  99 00 05             sta     BAS_TOKBUF,y
00036Fr 2  C8                   iny
000370r 2  E8                   inx
000371r 2  C9 22                cmp     #'"'
000373r 2  D0 EE                bne     @QuoteLoop
000375r 2  4C rr rr             jmp     @Scan
000378r 2               
000378r 2               ; =============================================================================
000378r 2               ;   B a s V a l i d P u n c t
000378r 2               ; =============================================================================
000378r 2               ; Verify A is an acceptable non-keyword character.
000378r 2               ; Carry SET = OK, carry CLEAR = illegal.
000378r 2               ; Allowed: anything in $20-$7E EXCEPT @, &, [, ], {, }, |, \, `, ~.
000378r 2               ; =============================================================================
000378r 2               BasValidPunct:
000378r 2  C9 40                cmp     #'@'
00037Ar 2  F0 26                beq     @Bad
00037Cr 2  C9 26                cmp     #'&'
00037Er 2  F0 22                beq     @Bad
000380r 2  C9 5B                cmp     #'['
000382r 2  F0 1E                beq     @Bad
000384r 2  C9 5D                cmp     #']'
000386r 2  F0 1A                beq     @Bad
000388r 2  C9 7B                cmp     #'{'
00038Ar 2  F0 16                beq     @Bad
00038Cr 2  C9 7D                cmp     #'}'
00038Er 2  F0 12                beq     @Bad
000390r 2  C9 7C                cmp     #'|'
000392r 2  F0 0E                beq     @Bad
000394r 2  C9 5C                cmp     #'\'
000396r 2  F0 0A                beq     @Bad
000398r 2  C9 60                cmp     #'`'
00039Ar 2  F0 06                beq     @Bad
00039Cr 2  C9 7E                cmp     #'~'
00039Er 2  F0 02                beq     @Bad
0003A0r 2  38                   sec
0003A1r 2  60                   rts
0003A2r 2               @Bad:
0003A2r 2  18                   clc
0003A3r 2  60                   rts
0003A4r 2               
0003A4r 2               ; =============================================================================
0003A4r 2               ;   B a s M a t c h K e y w o r d
0003A4r 2               ; =============================================================================
0003A4r 2               ; Try to match a keyword from KeywordTbl starting at BAS_LINBUF,X.
0003A4r 2               ;
0003A4r 2               ; On match  : carry SET, A = token byte, X advanced past the matched
0003A4r 2               ;             keyword characters in BAS_LINBUF.
0003A4r 2               ; On miss   : carry CLEAR, X unchanged, A = original character at LINBUF,X.
0003A4r 2               ;
0003A4r 2               ; Match algorithm:
0003A4r 2               ;   - Walk KeywordTbl, comparing characters (folding LINBUF lowercase to
0003A4r 2               ;     uppercase) to each keyword in turn.  A keyword's last byte has bit 7
0003A4r 2               ;     set; the byte after the table's final keyword is $00.
0003A4r 2               ;   - Token value = TOK_BASE + (index of keyword in table).
0003A4r 2               ;   - The LONGEST match wins, not the first one found.  Taking the first would
0003A4r 2               ;     make a keyword unreachable whenever an earlier one is a prefix of it:
0003A4r 2               ;     FOR ($81) comes before FORMAT ($D4), so FORMAT crunched to FOR + "MAT"
0003A4r 2               ;     and the statement could not be typed at all.  Scanning to the end of the
0003A4r 2               ;     table costs a little time on each keyword, and buys a tokenizer whose
0003A4r 2               ;     result does not depend on the table's order.
0003A4r 2               ; =============================================================================
0003A4r 2               BasMatchKeyword:
0003A4r 2                       ; Save initial X for rollback on miss; preserve caller's Y (BasCrunch
0003A4r 2                       ; uses Y as the TOKBUF destination index).
0003A4r 2  86 3E                stx     BAS_TMP3
0003A6r 2  5A                   phy
0003A7r 2                       ; Walk the keyword table via a 16-bit ZP pointer (BAS_KWPTR), since
0003A7r 2                       ; the table is larger than 256 bytes.  Y is held at 0 throughout and
0003A7r 2                       ; we advance BAS_KWPTR byte-by-byte instead of relying on Y.
0003A7r 2  A9 rr                lda     #<KeywordTbl
0003A9r 2  85 61                sta     BAS_KWPTR
0003ABr 2  A9 rr                lda     #>KeywordTbl
0003ADr 2  85 62                sta     BAS_KWPTR+1
0003AFr 2  A9 80                lda     #TOK_BASE
0003B1r 2  85 3A                sta     BAS_TMP1                ; current candidate token
0003B3r 2                       ; Best match so far, both zero until one is found: BAS_TMP1+1 is its
0003B3r 2                       ; token (no token is $00) and BAS_TMP2+1 the input index just past it.
0003B3r 2                       ; Both are the spare halves of pointers this routine only uses a byte
0003B3r 2                       ; of, and neither outlives the call.
0003B3r 2  64 3B                stz     BAS_TMP1+1
0003B5r 2  64 3D                stz     BAS_TMP2+1
0003B7r 2  A0 00                ldy     #0
0003B9r 2               @KeywordLoop:
0003B9r 2                       ; Restore X to start of input keyword.
0003B9r 2  A6 3E                ldx     BAS_TMP3
0003BBr 2               @CharLoop:
0003BBr 2  B1 61                lda     (BAS_KWPTR),y           ; Y == 0
0003BDr 2  F0 5D                beq     @NoMatch                ; reached table terminator
0003BFr 2  48                   pha
0003C0r 2  29 7F                and     #$7F
0003C2r 2  85 3C                sta     BAS_TMP2                ; expected char (uppercase)
0003C4r 2                       ; Read input char and uppercase it.
0003C4r 2  BD 00 04             lda     BAS_LINBUF,x
0003C7r 2  C9 61                cmp     #'a'
0003C9r 2  90 06                bcc     @InpCmp
0003CBr 2  C9 7B                cmp     #'z'+1
0003CDr 2  B0 02                bcs     @InpCmp
0003CFr 2  29 DF                and     #$DF
0003D1r 2               @InpCmp:
0003D1r 2  C5 3C                cmp     BAS_TMP2
0003D3r 2  D0 0C                bne     @CharMismatch
0003D5r 2  68                   pla                             ; restore raw table byte
0003D6r 2                       ; Match - is this the last char of the keyword?
0003D6r 2  30 1C                bmi     @WholeMatch             ; bit 7 set -> full keyword matched
0003D8r 2                       ; Advance both pointers and continue.
0003D8r 2  E6 61                inc     BAS_KWPTR
0003DAr 2  D0 02                bne     @CharNoCarry
0003DCr 2  E6 62                inc     BAS_KWPTR+1
0003DEr 2               @CharNoCarry:
0003DEr 2  E8                   inx
0003DFr 2  80 DA                bra     @CharLoop
0003E1r 2               
0003E1r 2               @CharMismatch:
0003E1r 2  68                   pla
0003E2r 2                       ; Skip ahead to start of next keyword in table.  Walk byte-by-byte
0003E2r 2                       ; until we consume a byte with bit 7 set (last char of this keyword)
0003E2r 2                       ; or hit the $00 terminator.
0003E2r 2               @SkipKeyword:
0003E2r 2  B1 61                lda     (BAS_KWPTR),y           ; Y == 0
0003E4r 2  F0 36                beq     @NoMatch                ; hit table terminator
0003E6r 2  E6 61                inc     BAS_KWPTR
0003E8r 2  D0 02                bne     @SkipNoCarry
0003EAr 2  E6 62                inc     BAS_KWPTR+1
0003ECr 2               @SkipNoCarry:
0003ECr 2  C9 80                cmp     #$80                    ; carry set iff loaded byte >= $80
0003EEr 2  90 F2                bcc     @SkipKeyword
0003F0r 2                       ; Fall through: byte had bit 7 set => end of keyword.
0003F0r 2               @AdvanceTok:
0003F0r 2  E6 3A                inc     BAS_TMP1
0003F2r 2  80 C5                bra     @KeywordLoop
0003F4r 2               
0003F4r 2               @WholeMatch:
0003F4r 2                       ; X points at the LAST matched char in input; advance past it.
0003F4r 2  E8                   inx
0003F5r 2                       ; A candidate, not an answer: a keyword further down the table may match
0003F5r 2                       ; more of the input.  Keep it only if it does, and carry on scanning.
0003F5r 2  E4 3D                cpx     BAS_TMP2+1
0003F7r 2  90 06                bcc     @Extendable             ; a longer match is already held
0003F9r 2  86 3D                stx     BAS_TMP2+1
0003FBr 2  A5 3A                lda     BAS_TMP1
0003FDr 2  85 3B                sta     BAS_TMP1+1
0003FFr 2               @Extendable:
0003FFr 2                       ; Only a letter or '$' appears in a keyword, so unless the input
0003FFr 2                       ; continues with one, nothing longer can match and the rest of the
0003FFr 2                       ; table is not worth walking.  This is what keeps ordinary typing at
0003FFr 2                       ; the speed it had when the first match won outright: at 19200 baud the
0003FFr 2                       ; crunch of one line runs while the next is arriving, and a slower one
0003FFr 2                       ; drops characters out of the input buffer.
0003FFr 2  A6 3D                ldx     BAS_TMP2+1
000401r 2  BD 00 04             lda     BAS_LINBUF,x
000404r 2  C9 24                cmp     #'$'
000406r 2  F0 DA                beq     @SkipKeyword
000408r 2  C9 61                cmp     #'a'
00040Ar 2  90 06                bcc     @ExtAlpha
00040Cr 2  C9 7B                cmp     #'z'+1
00040Er 2  B0 02                bcs     @ExtAlpha
000410r 2  29 DF                and     #$DF
000412r 2               @ExtAlpha:
000412r 2  C9 41                cmp     #'A'
000414r 2  90 0A                bcc     @TakeBest
000416r 2  C9 5B                cmp     #'Z'+1
000418r 2  B0 06                bcs     @TakeBest
00041Ar 2  80 C6                bra     @SkipKeyword
00041Cr 2               
00041Cr 2               @NoMatch:
00041Cr 2                       ; End of the table.  Anything found along the way is the longest there
00041Cr 2                       ; is, since nothing after it matched at all.
00041Cr 2  A5 3B                lda     BAS_TMP1+1
00041Er 2  F0 07                beq     @NoneAtAll
000420r 2               @TakeBest:
000420r 2  A6 3D                ldx     BAS_TMP2+1              ; input index past the longest match
000422r 2  A5 3B                lda     BAS_TMP1+1
000424r 2  7A                   ply                             ; restore caller's Y
000425r 2  38                   sec
000426r 2  60                   rts
000427r 2               @NoneAtAll:
000427r 2  A6 3E                ldx     BAS_TMP3                ; restore caller's X
000429r 2  7A                   ply                             ; restore caller's Y
00042Ar 2  BD 00 04             lda     BAS_LINBUF,x
00042Dr 2  18                   clc
00042Er 2  60                   rts
00042Fr 2               
00042Fr 2               ; =============================================================================
00042Fr 2               ;   B a s S t o r e L i n e
00042Fr 2               ; =============================================================================
00042Fr 2               ; Insert or replace BAS_LINNUM in the program with the tokenized payload in
00042Fr 2               ; BAS_TOKBUF.  If BAS_TOKBUF is empty, delete the existing line.
00042Fr 2               ;
00042Fr 2               ; Algorithm:
00042Fr 2               ;   1. Find existing line number (or insertion point).
00042Fr 2               ;   2. If exact match, delete that line (close the gap, decrement VARTAB).
00042Fr 2               ;   3. If payload non-empty, splice in [next][num][payload][$00].
00042Fr 2               ;   4. Relink all next-pointers.
00042Fr 2               ; =============================================================================
00042Fr 2               BasStoreLine:
00042Fr 2                       ; Locate insertion point.  BAS_INDEX <- pointer; carry set = exact match.
00042Fr 2  20 rr rr             jsr     BasFindLine
000432r 2               
000432r 2  90 03                bcc     @NoExisting
000434r 2                       ; Line exists - delete it first.
000434r 2  20 rr rr             jsr     BasDeleteAtIndex
000437r 2               @NoExisting:
000437r 2                       ; If tokbuf is empty, we're done (delete-only operation).
000437r 2  AD 00 05             lda     BAS_TOKBUF
00043Ar 2  D0 04                bne     @InsertNew
00043Cr 2  20 rr rr             jsr     BasRelink
00043Fr 2  60                   rts
000440r 2               
000440r 2               @InsertNew:
000440r 2  20 rr rr             jsr     BasInsertAtIndex
000443r 2  90 04                bcc     @NoMem
000445r 2  20 rr rr             jsr     BasRelink
000448r 2  60                   rts
000449r 2               @NoMem:
000449r 2  A9 02                lda     #ERR_OUTOFMEM
00044Br 2  4C rr rr             jmp     BasError
00044Er 2               
00044Er 2               ; =============================================================================
00044Er 2               ;   B a s F i n d L i n e
00044Er 2               ; =============================================================================
00044Er 2               ; Locate BAS_LINNUM in the program list.
00044Er 2               ;
00044Er 2               ; On entry : BAS_LINNUM = target line number.
00044Er 2               ; On exit  : BAS_INDEX = pointer to start of either the matching line or the
00044Er 2               ;            first line whose number > target (or end-marker).
00044Er 2               ;            Carry SET if exact match, CLEAR otherwise.
00044Er 2               ; =============================================================================
00044Er 2               BasFindLine:
00044Er 2  AD 5D 03             lda     BAS_TXTTAB
000451r 2  85 20                sta     BAS_INDEX
000453r 2  AD 5E 03             lda     BAS_TXTTAB+1
000456r 2  85 21                sta     BAS_INDEX+1
000458r 2               @Loop:
000458r 2  A0 01                ldy     #1
00045Ar 2  B1 20                lda     (BAS_INDEX),y
00045Cr 2  F0 25                beq     @NotFound               ; end-marker (next-hi = 0)
00045Er 2               
00045Er 2                       ; Compare line numbers: (INDEX+2/+3) vs LINNUM.
00045Er 2  A0 03                ldy     #3
000460r 2  B1 20                lda     (BAS_INDEX),y
000462r 2  C5 09                cmp     BAS_LINNUM+1
000464r 2  90 0D                bcc     @Advance                ; line < target
000466r 2  D0 1B                bne     @TooHigh                ; line > target -> insertion point
000468r 2  88                   dey
000469r 2  B1 20                lda     (BAS_INDEX),y
00046Br 2  C5 08                cmp     BAS_LINNUM
00046Dr 2  90 04                bcc     @Advance
00046Fr 2  D0 12                bne     @TooHigh
000471r 2                       ; Exact match.
000471r 2  38                   sec
000472r 2  60                   rts
000473r 2               
000473r 2               @Advance:
000473r 2                       ; Follow next-pointer.
000473r 2  A0 00                ldy     #0
000475r 2  B1 20                lda     (BAS_INDEX),y
000477r 2  48                   pha
000478r 2  A0 01                ldy     #1
00047Ar 2  B1 20                lda     (BAS_INDEX),y
00047Cr 2  85 21                sta     BAS_INDEX+1
00047Er 2  68                   pla
00047Fr 2  85 20                sta     BAS_INDEX
000481r 2  80 D5                bra     @Loop
000483r 2               
000483r 2               @NotFound:
000483r 2               @TooHigh:
000483r 2  18                   clc
000484r 2  60                   rts
000485r 2               
000485r 2               ; =============================================================================
000485r 2               ;   B a s D e l e t e A t I n d e x
000485r 2               ; =============================================================================
000485r 2               ; Delete the line whose start is at BAS_INDEX.
000485r 2               ; Closes the gap by copying [next-line .. VARTAB-1] down to (BAS_INDEX...)
000485r 2               ; and decrements VARTAB by the deleted size.
000485r 2               ; =============================================================================
000485r 2               BasDeleteAtIndex:
000485r 2                       ; BAS_TMP1 = next-line address (read from current line's next ptr).
000485r 2  A0 00                ldy     #0
000487r 2  B1 20                lda     (BAS_INDEX),y
000489r 2  85 3A                sta     BAS_TMP1
00048Br 2  C8                   iny
00048Cr 2  B1 20                lda     (BAS_INDEX),y
00048Er 2  85 3B                sta     BAS_TMP1+1
000490r 2               
000490r 2                       ; gap-size = TMP1 - INDEX  (positive)
000490r 2                       ; Copy from TMP1 to INDEX, byte by byte, until TMP1 reaches VARTAB.
000490r 2                       ; BAS_DEST = INDEX (write cursor); BAS_TMP2 = src cursor (= TMP1).
000490r 2  A5 20                lda     BAS_INDEX
000492r 2  85 22                sta     BAS_DEST
000494r 2  A5 21                lda     BAS_INDEX+1
000496r 2  85 23                sta     BAS_DEST+1
000498r 2               
000498r 2               @CopyLoop:
000498r 2                       ; Done when TMP1 == VARTAB.
000498r 2  A5 3A                lda     BAS_TMP1
00049Ar 2  CD 5F 03             cmp     BAS_VARTAB
00049Dr 2  A5 3B                lda     BAS_TMP1+1
00049Fr 2  ED 60 03             sbc     BAS_VARTAB+1
0004A2r 2  B0 14                bcs     @CopyDone
0004A4r 2               
0004A4r 2  A0 00                ldy     #0
0004A6r 2  B1 3A                lda     (BAS_TMP1),y
0004A8r 2  91 22                sta     (BAS_DEST),y
0004AAr 2               
0004AAr 2  E6 3A                inc     BAS_TMP1
0004ACr 2  D0 02                bne     @IncDest
0004AEr 2  E6 3B                inc     BAS_TMP1+1
0004B0r 2               @IncDest:
0004B0r 2  E6 22                inc     BAS_DEST
0004B2r 2  D0 E4                bne     @CopyLoop
0004B4r 2  E6 23                inc     BAS_DEST+1
0004B6r 2  80 E0                bra     @CopyLoop
0004B8r 2               
0004B8r 2               @CopyDone:
0004B8r 2                       ; VARTAB = DEST.
0004B8r 2  A5 22                lda     BAS_DEST
0004BAr 2  8D 5F 03             sta     BAS_VARTAB
0004BDr 2  A5 23                lda     BAS_DEST+1
0004BFr 2  8D 60 03             sta     BAS_VARTAB+1
0004C2r 2                       ; Mirror to ARYTAB/STREND (vars/arrays empty after edit; keep them
0004C2r 2                       ; tracking VARTAB).
0004C2r 2  8D 62 03             sta     BAS_ARYTAB+1
0004C5r 2  8D 64 03             sta     BAS_STREND+1
0004C8r 2  AD 5F 03             lda     BAS_VARTAB
0004CBr 2  8D 61 03             sta     BAS_ARYTAB
0004CEr 2  8D 63 03             sta     BAS_STREND
0004D1r 2  60                   rts
0004D2r 2               
0004D2r 2               ; =============================================================================
0004D2r 2               ;   B a s I n s e r t A t I n d e x
0004D2r 2               ; =============================================================================
0004D2r 2               ; Splice a new line ([next-placeholder][num-lo][num-hi][payload][$00]) in
0004D2r 2               ; at BAS_INDEX, shifting following bytes upward.
0004D2r 2               ;
0004D2r 2               ; On entry : BAS_INDEX = insertion address, BAS_LINNUM = line number,
0004D2r 2               ;            BAS_TOKBUF = NUL-terminated payload (non-empty).
0004D2r 2               ; On exit  : Carry SET on success, CLEAR if not enough memory.
0004D2r 2               ;            VARTAB / ARYTAB / STREND advanced to new end-of-program.
0004D2r 2               ;
0004D2r 2               ; This is why a .prg's BASIC stub cannot be edited: the shift moves everything
0004D2r 2               ; up to VARTAB, and the new pointers come from the chain alone, so attached
0004D2r 2               ; machine code is both relocated and dropped from VARTAB's view.  Its addresses
0004D2r 2               ; are absolute, so it would break either way — the C64 has the same constraint.
0004D2r 2               ; =============================================================================
0004D2r 2               BasInsertAtIndex:
0004D2r 2                       ; Compute payload length L (excluding NUL): scan TOKBUF.
0004D2r 2  A0 00                ldy     #0
0004D4r 2               @LenScan:
0004D4r 2  B9 00 05             lda     BAS_TOKBUF,y
0004D7r 2  F0 03                beq     @LenDone
0004D9r 2  C8                   iny
0004DAr 2  D0 F8                bne     @LenScan
0004DCr 2               @LenDone:
0004DCr 2                       ; Total line size = 4 (header) + L + 1 (terminator) = L + 5.
0004DCr 2                       ; Store size in BAS_TMP3 (assumes <= 250+5 = 255, fits in one byte).
0004DCr 2  98                   tya
0004DDr 2  18                   clc
0004DEr 2  69 05                adc     #5
0004E0r 2  85 3E                sta     BAS_TMP3                ; line size in bytes (<=255)
0004E2r 2               
0004E2r 2                       ; Memory check: VARTAB + size <= MEMSIZ.
0004E2r 2  18                   clc
0004E3r 2  AD 5F 03             lda     BAS_VARTAB
0004E6r 2  65 3E                adc     BAS_TMP3
0004E8r 2  85 3A                sta     BAS_TMP1
0004EAr 2  AD 60 03             lda     BAS_VARTAB+1
0004EDr 2  69 00                adc     #0
0004EFr 2  85 3B                sta     BAS_TMP1+1
0004F1r 2  A5 3A                lda     BAS_TMP1
0004F3r 2  CD 67 03             cmp     BAS_MEMSIZ
0004F6r 2  A5 3B                lda     BAS_TMP1+1
0004F8r 2  ED 68 03             sbc     BAS_MEMSIZ+1
0004FBr 2  90 02                bcc     @SizeOK
0004FDr 2  18                   clc                             ; out of memory
0004FEr 2  60                   rts
0004FFr 2               @SizeOK:
0004FFr 2                       ; Shift bytes [INDEX .. VARTAB-1] up by TMP3.
0004FFr 2                       ; Copy from high-to-low to avoid overlap clobber.
0004FFr 2                       ; src  = VARTAB-1
0004FFr 2                       ; dst  = VARTAB-1 + TMP3
0004FFr 2  AD 5F 03             lda     BAS_VARTAB
000502r 2  38                   sec
000503r 2  E9 01                sbc     #1
000505r 2  85 3A                sta     BAS_TMP1                ; src
000507r 2  AD 60 03             lda     BAS_VARTAB+1
00050Ar 2  E9 00                sbc     #0
00050Cr 2  85 3B                sta     BAS_TMP1+1
00050Er 2  18                   clc
00050Fr 2  A5 3A                lda     BAS_TMP1
000511r 2  65 3E                adc     BAS_TMP3
000513r 2  85 22                sta     BAS_DEST                ; dst
000515r 2  A5 3B                lda     BAS_TMP1+1
000517r 2  69 00                adc     #0
000519r 2  85 23                sta     BAS_DEST+1
00051Br 2               @Shift:
00051Br 2                       ; Stop when TMP1 < INDEX (i.e. INDEX-1 reached -> done).
00051Br 2  A5 3A                lda     BAS_TMP1
00051Dr 2  C5 20                cmp     BAS_INDEX
00051Fr 2  A5 3B                lda     BAS_TMP1+1
000521r 2  E5 21                sbc     BAS_INDEX+1
000523r 2  90 18                bcc     @ShiftDone
000525r 2               
000525r 2  A0 00                ldy     #0
000527r 2  B1 3A                lda     (BAS_TMP1),y
000529r 2  91 22                sta     (BAS_DEST),y
00052Br 2               
00052Br 2                       ; dec TMP1
00052Br 2  A5 3A                lda     BAS_TMP1
00052Dr 2  D0 02                bne     @T1NoBorrow
00052Fr 2  C6 3B                dec     BAS_TMP1+1
000531r 2               @T1NoBorrow:
000531r 2  C6 3A                dec     BAS_TMP1
000533r 2                       ; dec DEST
000533r 2  A5 22                lda     BAS_DEST
000535r 2  D0 02                bne     @DNoBorrow
000537r 2  C6 23                dec     BAS_DEST+1
000539r 2               @DNoBorrow:
000539r 2  C6 22                dec     BAS_DEST
00053Br 2  80 DE                bra     @Shift
00053Dr 2               
00053Dr 2               @ShiftDone:
00053Dr 2                       ; Write new line header at BAS_INDEX.
00053Dr 2  A0 00                ldy     #0
00053Fr 2  A9 FF                lda     #$FF                    ; placeholder next-ptr (Relink fixes)
000541r 2  91 20                sta     (BAS_INDEX),y
000543r 2  C8                   iny
000544r 2  91 20                sta     (BAS_INDEX),y
000546r 2  C8                   iny
000547r 2  A5 08                lda     BAS_LINNUM
000549r 2  91 20                sta     (BAS_INDEX),y
00054Br 2  C8                   iny
00054Cr 2  A5 09                lda     BAS_LINNUM+1
00054Er 2  91 20                sta     (BAS_INDEX),y
000550r 2  C8                   iny
000551r 2               
000551r 2                       ; Copy payload from BAS_TOKBUF (NUL terminator included).
000551r 2  A2 00                ldx     #0
000553r 2               @PayloadCopy:
000553r 2  BD 00 05             lda     BAS_TOKBUF,x
000556r 2  91 20                sta     (BAS_INDEX),y
000558r 2  F0 04                beq     @PayloadDone
00055Ar 2  E8                   inx
00055Br 2  C8                   iny
00055Cr 2  80 F5                bra     @PayloadCopy
00055Er 2               @PayloadDone:
00055Er 2                       ; Update VARTAB.
00055Er 2  18                   clc
00055Fr 2  AD 5F 03             lda     BAS_VARTAB
000562r 2  65 3E                adc     BAS_TMP3
000564r 2  8D 5F 03             sta     BAS_VARTAB
000567r 2  AD 60 03             lda     BAS_VARTAB+1
00056Ar 2  69 00                adc     #0
00056Cr 2  8D 60 03             sta     BAS_VARTAB+1
00056Fr 2                       ; Mirror to ARYTAB/STREND.
00056Fr 2  AD 5F 03             lda     BAS_VARTAB
000572r 2  8D 61 03             sta     BAS_ARYTAB
000575r 2  8D 63 03             sta     BAS_STREND
000578r 2  AD 60 03             lda     BAS_VARTAB+1
00057Br 2  8D 62 03             sta     BAS_ARYTAB+1
00057Er 2  8D 64 03             sta     BAS_STREND+1
000581r 2               
000581r 2  38                   sec
000582r 2  60                   rts
000583r 2               
000583r 2               ; =============================================================================
000583r 2               ;   B a s R e l i n k
000583r 2               ; =============================================================================
000583r 2               ; Walk the program list and rewrite every next-pointer to the address of
000583r 2               ; the following line (computed by scanning forward to the line's NUL
000583r 2               ; terminator).  Stops when a next-pointer's high byte is already 0
000583r 2               ; (the [00][00] end-marker, which is left untouched).
000583r 2               ; =============================================================================
000583r 2               BasRelink:
000583r 2  AD 5D 03             lda     BAS_TXTTAB
000586r 2  85 20                sta     BAS_INDEX
000588r 2  AD 5E 03             lda     BAS_TXTTAB+1
00058Br 2  85 21                sta     BAS_INDEX+1
00058Dr 2               @Loop:
00058Dr 2  A0 01                ldy     #1
00058Fr 2  B1 20                lda     (BAS_INDEX),y
000591r 2  F0 2B                beq     @Done                   ; end-marker reached
000593r 2               
000593r 2                       ; Find the NUL terminator at INDEX + Y for some Y >= 4.
000593r 2  A0 04                ldy     #4
000595r 2               @Scan:
000595r 2  B1 20                lda     (BAS_INDEX),y
000597r 2  F0 03                beq     @Found
000599r 2  C8                   iny
00059Ar 2  D0 F9                bne     @Scan
00059Cr 2               @Found:
00059Cr 2  C8                   iny                             ; one past NUL = next line address
00059Dr 2                       ; next = INDEX + Y
00059Dr 2  98                   tya
00059Er 2  18                   clc
00059Fr 2  65 20                adc     BAS_INDEX
0005A1r 2  85 3A                sta     BAS_TMP1
0005A3r 2  A5 21                lda     BAS_INDEX+1
0005A5r 2  69 00                adc     #0
0005A7r 2  85 3B                sta     BAS_TMP1+1
0005A9r 2               
0005A9r 2                       ; Write new next-pointer at (INDEX),0/1.
0005A9r 2  A0 00                ldy     #0
0005ABr 2  A5 3A                lda     BAS_TMP1
0005ADr 2  91 20                sta     (BAS_INDEX),y
0005AFr 2  C8                   iny
0005B0r 2  A5 3B                lda     BAS_TMP1+1
0005B2r 2  91 20                sta     (BAS_INDEX),y
0005B4r 2               
0005B4r 2                       ; Advance INDEX = TMP1.
0005B4r 2  A5 3A                lda     BAS_TMP1
0005B6r 2  85 20                sta     BAS_INDEX
0005B8r 2  A5 3B                lda     BAS_TMP1+1
0005BAr 2  85 21                sta     BAS_INDEX+1
0005BCr 2  80 CF                bra     @Loop
0005BEr 2               @Done:
0005BEr 2  60                   rts
0005BFr 2               
0005BFr 2               ; =============================================================================
0005BFr 2               ;   B a s D i s p a t c h I m m e d i a t e
0005BFr 2               ; =============================================================================
0005BFr 2               ; Execute a tokenized line (BAS_TOKBUF) in immediate mode by entering the
0005BFr 2               ; statement loop (BasNewstt) with TXTPTR pointing one byte before the first
0005BFr 2               ; tokenized byte.  Re-anchors the CPU stack so that FOR / GOSUB frames
0005BFr 2               ; stored on the stack can be located by the scanners.
0005BFr 2               ; =============================================================================
0005BFr 2               BasDispatchImmediate:
0005BFr 2                       ; Write a ':' sentinel just before BAS_TOKBUF so NEWSTT's initial
0005BFr 2                       ; (TXTPTR),y read takes the @nextStmt path and CHRGETs the first token.
0005BFr 2  A9 3A                lda     #':'
0005C1r 2  8D FF 04             sta     BAS_TOKBUF-1
0005C4r 2  A9 FF                lda     #<(BAS_TOKBUF-1)
0005C6r 2  85 04                sta     TXTPTR
0005C8r 2  A9 04                lda     #>(BAS_TOKBUF-1)
0005CAr 2  85 05                sta     TXTPTR+1
0005CCr 2  9C 70 03             stz     BAS_POSX
0005CFr 2                       ; Direct mode: CURLIN = $FFFF (msbasic convention).
0005CFr 2  A9 FF                lda     #$FF
0005D1r 2  8D 69 03             sta     BAS_CURLIN
0005D4r 2  8D 6A 03             sta     BAS_CURLIN+1
0005D7r 2                       ; Re-anchor the CPU stack to the baseline, so the FOR / GOSUB frame
0005D7r 2                       ; scanners start from a known depth and nothing a previous direct line
0005D7r 2                       ; abandoned is still lying there.  The baseline is $FF with no program
0005D7r 2                       ; suspended, and the broken program's statement boundary after a
0005D7r 2                       ; STOP/END/Ctrl+C -- so its frames sit above this line's stack and are
0005D7r 2                       ; still there when CONT hands the program back.
0005D7r 2  AE 75 03             ldx     BAS_STKBASE
0005DAr 2  9A                   txs
0005DBr 2  4C rr rr             jmp     BasNewstt
0005DEr 2               
0005DEr 2               ; =============================================================================
0005DEr 2               ;   B a s C m d N e w
0005DEr 2               ; =============================================================================
0005DEr 2               ; Reset program storage to empty: write [00][00] at $0800 and reset the
0005DEr 2               ; runtime pointers.
0005DEr 2               ; =============================================================================
0005DEr 2               BasCmdNew:
0005DEr 2  9C 00 08             stz     BAS_PRG_START
0005E1r 2  9C 01 08             stz     BAS_PRG_START+1
0005E4r 2  A9 02                lda     #<(BAS_PRG_START+2)
0005E6r 2  8D 5F 03             sta     BAS_VARTAB
0005E9r 2  8D 61 03             sta     BAS_ARYTAB
0005ECr 2  8D 63 03             sta     BAS_STREND
0005EFr 2  A9 08                lda     #>(BAS_PRG_START+2)
0005F1r 2  8D 60 03             sta     BAS_VARTAB+1
0005F4r 2  8D 62 03             sta     BAS_ARYTAB+1
0005F7r 2  8D 64 03             sta     BAS_STREND+1
0005FAr 2  AD 67 03             lda     BAS_MEMSIZ
0005FDr 2  8D 65 03             sta     BAS_FRETOP
000600r 2  AD 68 03             lda     BAS_MEMSIZ+1
000603r 2  8D 66 03             sta     BAS_FRETOP+1
000606r 2                       ; And fall into CLR, as msbasic's SCRTCH does: the program that CONT
000606r 2                       ; would have resumed into has just been erased, so the saved position
000606r 2                       ; and the frames behind it have to go with it.
000606r 2  4C rr rr             jmp     BasCmdClr
000609r 2               
000609r 2               ; =============================================================================
000609r 2               ;   B a s C m d L i s t
000609r 2               ; =============================================================================
000609r 2               ; Print every stored line in order.  Each line: decimal line number, single
000609r 2               ; space, detokenized payload, CRLF.
000609r 2               ; =============================================================================
000609r 2               BasCmdList:
000609r 2  AD 5D 03             lda     BAS_TXTTAB
00060Cr 2  85 20                sta     BAS_INDEX
00060Er 2  AD 5E 03             lda     BAS_TXTTAB+1
000611r 2  85 21                sta     BAS_INDEX+1
000613r 2               @LineLoop:
000613r 2  A0 01                ldy     #1
000615r 2  B1 20                lda     (BAS_INDEX),y
000617r 2  F0 3D                beq     @Done                   ; end-marker
000619r 2                       ; Print line number.
000619r 2  A0 02                ldy     #2
00061Br 2  B1 20                lda     (BAS_INDEX),y
00061Dr 2  85 08                sta     BAS_LINNUM
00061Fr 2  C8                   iny
000620r 2  B1 20                lda     (BAS_INDEX),y
000622r 2  85 09                sta     BAS_LINNUM+1
000624r 2  20 rr rr             jsr     BasPrintLineNum
000627r 2  A9 20                lda     #' '
000629r 2  20 rr rr             jsr     Chrout
00062Cr 2               
00062Cr 2                       ; Detokenize from offset 4 to the NUL terminator.
00062Cr 2  A0 04                ldy     #4
00062Er 2               @DetokLoop:
00062Er 2  B1 20                lda     (BAS_INDEX),y
000630r 2  F0 12                beq     @LineEnd
000632r 2  30 06                bmi     @Token
000634r 2  20 rr rr             jsr     Chrout
000637r 2  C8                   iny
000638r 2  80 F4                bra     @DetokLoop
00063Ar 2               @Token:
00063Ar 2  84 42                sty     BAS_DETOKY
00063Cr 2  20 rr rr             jsr     BasPrintKeyword         ; preserves nothing useful
00063Fr 2  A4 42                ldy     BAS_DETOKY
000641r 2  C8                   iny
000642r 2  80 EA                bra     @DetokLoop
000644r 2               @LineEnd:
000644r 2  20 rr rr             jsr     BasPrintCRLF
000647r 2                       ; Advance INDEX via next-pointer.
000647r 2  A0 00                ldy     #0
000649r 2  B1 20                lda     (BAS_INDEX),y
00064Br 2  48                   pha
00064Cr 2  C8                   iny
00064Dr 2  B1 20                lda     (BAS_INDEX),y
00064Fr 2  85 21                sta     BAS_INDEX+1
000651r 2  68                   pla
000652r 2  85 20                sta     BAS_INDEX
000654r 2  80 BD                bra     @LineLoop
000656r 2               @Done:
000656r 2  60                   rts
000657r 2               
000657r 2               ; =============================================================================
000657r 2               ;   B a s P r i n t L i n e N u m
000657r 2               ; =============================================================================
000657r 2               ; Print BAS_LINNUM (16-bit unsigned) as decimal (no leading zeros, no sign).
000657r 2               ; Thin shim over the KERNAL PrintDecU16 ($A096); the decimal-print core now
000657r 2               ; lives once in the KERNAL (shared with FsPrintSize).
000657r 2               ; Clobbers : A, X, Y, FS_FILE_SIZE, FS_DIR_IDX.
000657r 2               ; =============================================================================
000657r 2               BasPrintLineNum:
000657r 2  A5 08                lda     BAS_LINNUM
000659r 2  A6 09                ldx     BAS_LINNUM+1
00065Br 2  4C rr rr             jmp     PrintDecU16
00065Er 2               
00065Er 2               ; =============================================================================
00065Er 2               ;   B a s C m d P r i n t
00065Er 2               ; =============================================================================
00065Er 2               ; Immediate-mode PRINT.  X on entry = offset into BAS_TOKBUF where the
00065Er 2               ; PRINT token sits.  Items separated by ';' (no separator) or ',' (advance
00065Er 2               ; to next 14-column print zone).  Trailing ';' or ',' suppresses CRLF.
00065Er 2               ;
00065Er 2               ; Special-cased token: HEX(n) -> emit "$XXXX" hex form (does not call
00065Er 2               ; FrmEvl; consumes the token + parens here).
00065Er 2               ; =============================================================================
00065Er 2               BasCmdPrint:
00065Er 2                       ; TXTPTR is positioned with ChrGot returning TOK_PRINT.  Advance
00065Er 2                       ; past the token; col counter is reset by the dispatcher's outer loop.
00065Er 2  20 rr rr             jsr     ChrGet                  ; consume PRINT token
000661r 2               
000661r 2               BasPrLoop:
000661r 2  20 rr rr             jsr     ChrGot
000664r 2  D0 03 4C rr          jeq     BasPrEndNl
000668r 2  rr           
000669r 2  C9 3A                cmp     #':'
00066Br 2  D0 03 4C rr          jeq     BasPrEndNl
00066Fr 2  rr           
000670r 2  C9 A4                cmp     #TOK_ELSE
000672r 2  D0 03 4C rr          jeq     BasPrEndNl
000676r 2  rr           
000677r 2  C9 3B                cmp     #';'
000679r 2  D0 03 4C rr          jeq     BasPrSep
00067Dr 2  rr           
00067Er 2  C9 2C                cmp     #','
000680r 2  D0 03 4C rr          jeq     BasPrComma
000684r 2  rr           
000685r 2  C9 CE                cmp     #TOK_HEX
000687r 2  D0 17                bne     @chkTab
000689r 2                       ; HEX(n) in PRINT context: emit "$XXXX".
000689r 2  20 rr rr             jsr     ChrGet                  ; consume HEX
00068Cr 2  20 rr rr             jsr     ChkOpn
00068Fr 2  20 rr rr             jsr     FrmEvl
000692r 2  20 rr rr             jsr     ChkNum
000695r 2  20 rr rr             jsr     ChkCls
000698r 2                       ; Unsigned: AyInt is the signed conversion and rejects anything at or
000698r 2                       ; above 32768, so PRINT HEX() of any address in the top half of the
000698r 2                       ; map -- $8000, the RAM bank window the README documents -- raised
000698r 2                       ; ILLEGAL QUANTITY. A four-digit $xxxx covers 0..65535, and FacToU16
000698r 2                       ; leaves its result in the same FAC+3/FAC+4 PrintHex16 reads.
000698r 2  20 rr rr             jsr     FacToU16
00069Br 2  20 rr rr             jsr     PrintHex16
00069Er 2  80 6A                bra     BasPrAfter
0006A0r 2               @chkTab:
0006A0r 2  C9 9B                cmp     #TOK_TAB
0006A2r 2  D0 2D                bne     @chkSpc
0006A4r 2  20 rr rr             jsr     ChrGet                  ; consume TAB
0006A7r 2  20 rr rr             jsr     ChkOpn
0006AAr 2  20 rr rr             jsr     FrmNum
0006ADr 2  20 rr rr             jsr     ChkCls
0006B0r 2  20 rr rr             jsr     AyInt
0006B3r 2  A5 11                lda     FAC+3                   ; column count must fit in a byte
0006B5r 2  D0 53                bne     BasPrAfter
0006B7r 2  A5 12                lda     FAC+4
0006B9r 2  CD 70 03             cmp     BAS_POSX
0006BCr 2  90 4C                bcc     BasPrAfter              ; already at/past target column
0006BEr 2  38                   sec
0006BFr 2  ED 70 03             sbc     BAS_POSX
0006C2r 2  A8                   tay
0006C3r 2  F0 45                beq     BasPrAfter
0006C5r 2               @tabLoop:
0006C5r 2  5A                   phy
0006C6r 2  A9 20                lda     #' '
0006C8r 2  20 rr rr             jsr     PrintCh
0006CBr 2  7A                   ply
0006CCr 2  88                   dey
0006CDr 2  D0 F6                bne     @tabLoop
0006CFr 2  80 39                bra     BasPrAfter
0006D1r 2               @chkSpc:
0006D1r 2  C9 9E                cmp     #TOK_SPC
0006D3r 2  D0 23                bne     @expr
0006D5r 2  20 rr rr             jsr     ChrGet                  ; consume SPC
0006D8r 2  20 rr rr             jsr     ChkOpn
0006DBr 2  20 rr rr             jsr     FrmNum
0006DEr 2  20 rr rr             jsr     ChkCls
0006E1r 2  20 rr rr             jsr     AyInt
0006E4r 2  A5 11                lda     FAC+3
0006E6r 2  D0 22                bne     BasPrAfter
0006E8r 2  A4 12                ldy     FAC+4
0006EAr 2  F0 1E                beq     BasPrAfter
0006ECr 2               @spcLoop:
0006ECr 2  5A                   phy
0006EDr 2  A9 20                lda     #' '
0006EFr 2  20 rr rr             jsr     PrintCh
0006F2r 2  7A                   ply
0006F3r 2  88                   dey
0006F4r 2  D0 F6                bne     @spcLoop
0006F6r 2  80 12                bra     BasPrAfter
0006F8r 2               @expr:
0006F8r 2  20 rr rr             jsr     FrmEvl
0006FBr 2  24 64                bit     VALTYP
0006FDr 2  30 05                bmi     @prStr
0006FFr 2  20 rr rr             jsr     PrintNum
000702r 2  80 06                bra     BasPrAfter
000704r 2               @prStr:
000704r 2  20 rr rr             jsr     PrintStrFAC
000707r 2  20 rr rr             jsr     FreFac
00070Ar 2               BasPrAfter:
00070Ar 2  20 rr rr             jsr     ChrGot
00070Dr 2  D0 03 4C rr          jeq     BasPrEndNl
000711r 2  rr           
000712r 2  C9 3A                cmp     #':'
000714r 2  D0 03 4C rr          jeq     BasPrEndNl
000718r 2  rr           
000719r 2  C9 A4                cmp     #TOK_ELSE
00071Br 2  D0 03 4C rr          jeq     BasPrEndNl
00071Fr 2  rr           
000720r 2  C9 3B                cmp     #';'
000722r 2  D0 03 4C rr          jeq     BasPrSep
000726r 2  rr           
000727r 2  C9 2C                cmp     #','
000729r 2  D0 03 4C rr          jeq     BasPrComma
00072Dr 2  rr           
00072Er 2  4C rr rr             jmp     SynErr
000731r 2               BasPrSep:
000731r 2  20 rr rr             jsr     ChrGet                  ; consume ;
000734r 2  20 rr rr             jsr     ChrGot
000737r 2  F0 40                beq     BasPrEndNoNl            ; trailing ; -> no CRLF
000739r 2  C9 3A                cmp     #':'
00073Br 2  F0 3C                beq     BasPrEndNoNl
00073Dr 2  4C rr rr             jmp     BasPrLoop
000740r 2               BasPrComma:
000740r 2  20 rr rr             jsr     ChrGet
000743r 2                       ; Pad to next multiple of 14 (MS-BASIC 14-column zone).
000743r 2                       ; col_mod = BAS_POSX mod 14; if 0 already at zone, else emit (14-col_mod) spaces.
000743r 2  AD 70 03             lda     BAS_POSX
000746r 2  85 3A                sta     BAS_TMP1
000748r 2               @modA:
000748r 2  A5 3A                lda     BAS_TMP1
00074Ar 2  C9 0E                cmp     #14
00074Cr 2  90 07                bcc     @modB
00074Er 2  38                   sec
00074Fr 2  E9 0E                sbc     #14
000751r 2  85 3A                sta     BAS_TMP1
000753r 2  80 F3                bra     @modA
000755r 2               @modB:
000755r 2  C9 00                cmp     #0
000757r 2  F0 0D                beq     @padDone
000759r 2               @padSp:
000759r 2  A9 20                lda     #' '
00075Br 2  20 rr rr             jsr     PrintCh
00075Er 2  E6 3A                inc     BAS_TMP1
000760r 2  A5 3A                lda     BAS_TMP1
000762r 2  C9 0E                cmp     #14
000764r 2  D0 F3                bne     @padSp
000766r 2               @padDone:
000766r 2  20 rr rr             jsr     ChrGot
000769r 2  F0 0E                beq     BasPrEndNoNl
00076Br 2  C9 3A                cmp     #':'
00076Dr 2  F0 0A                beq     BasPrEndNoNl
00076Fr 2  4C rr rr             jmp     BasPrLoop
000772r 2               BasPrEndNl:
000772r 2  20 rr rr             jsr     BasPrintCRLF
000775r 2  9C 70 03             stz     BAS_POSX
000778r 2  60                   rts
000779r 2               BasPrEndNoNl:
000779r 2  60                   rts
00077Ar 2               
00077Ar 2               ; ---------------------------------------------------------------------------
00077Ar 2               ; PrintCh -- emit A through Chrout, maintaining BAS_POSX (CR resets it).
00077Ar 2               ; ---------------------------------------------------------------------------
00077Ar 2               PrintCh:
00077Ar 2  C9 0D                cmp     #$0D
00077Cr 2  F0 0C                beq     @cr
00077Er 2  C9 0A                cmp     #$0A
000780r 2  F0 08                beq     @cr
000782r 2  48                   pha
000783r 2  EE 70 03             inc     BAS_POSX
000786r 2  68                   pla
000787r 2  4C rr rr             jmp     Chrout
00078Ar 2               @cr:
00078Ar 2  9C 70 03             stz     BAS_POSX
00078Dr 2  4C rr rr             jmp     Chrout
000790r 2               
000790r 2               ; ---------------------------------------------------------------------------
000790r 2               ; PrintNum -- emit FAC as ASCII via Fout, tracking column.
000790r 2               ; ---------------------------------------------------------------------------
000790r 2               PrintNum:
000790r 2  20 rr rr             jsr     Fout                    ; (Y,A) = NUL-terminated buffer
000793r 2  85 20                sta     INDEX
000795r 2  84 21                sty     INDEX+1
000797r 2  A0 00                ldy     #0
000799r 2               @loop:
000799r 2  B1 20                lda     (INDEX),y
00079Br 2  F0 06                beq     @done
00079Dr 2  20 rr rr             jsr     PrintCh
0007A0r 2  C8                   iny
0007A1r 2  D0 F6                bne     @loop
0007A3r 2               @done:
0007A3r 2  60                   rts
0007A4r 2               
0007A4r 2               ; ---------------------------------------------------------------------------
0007A4r 2               ; PrintStrFAC -- emit string-descriptor at FAC..FAC+2.
0007A4r 2               ; ---------------------------------------------------------------------------
0007A4r 2               PrintStrFAC:
0007A4r 2  A5 0F                lda     FAC+1
0007A6r 2  85 20                sta     INDEX
0007A8r 2  A5 10                lda     FAC+2
0007AAr 2  85 21                sta     INDEX+1
0007ACr 2  A0 00                ldy     #0
0007AEr 2               @loop:
0007AEr 2  C4 0E                cpy     FAC
0007B0r 2  F0 08                beq     @done
0007B2r 2  B1 20                lda     (INDEX),y
0007B4r 2  20 rr rr             jsr     PrintCh
0007B7r 2  C8                   iny
0007B8r 2  80 F4                bra     @loop
0007BAr 2               @done:
0007BAr 2  60                   rts
0007BBr 2               
0007BBr 2               ; ---------------------------------------------------------------------------
0007BBr 2               ; PrintHex16 -- emit FAC+3,FAC+4 (lo,hi) as "$XXXX".
0007BBr 2               ; ---------------------------------------------------------------------------
0007BBr 2               PrintHex16:
0007BBr 2  A9 24                lda     #'$'
0007BDr 2  20 rr rr             jsr     PrintCh
0007C0r 2  A5 11                lda     FAC+3
0007C2r 2  20 rr rr             jsr     PrintHexByte
0007C5r 2  A5 12                lda     FAC+4
0007C7r 2                       ; fall through
0007C7r 2               PrintHexByte:
0007C7r 2  48                   pha
0007C8r 2  4A                   lsr     a
0007C9r 2  4A                   lsr     a
0007CAr 2  4A                   lsr     a
0007CBr 2  4A                   lsr     a
0007CCr 2  20 rr rr             jsr     @nib
0007CFr 2  68                   pla
0007D0r 2  29 0F                and     #$0F
0007D2r 2               @nib:
0007D2r 2  C9 0A                cmp     #10
0007D4r 2  90 02                bcc     @dig
0007D6r 2  69 06                adc     #'A'-'9'-2              ; +'A'-10-1 (carry already set)
0007D8r 2               @dig:
0007D8r 2  69 30                adc     #'0'
0007DAr 2  4C rr rr             jmp     PrintCh
0007DDr 2               
0007DDr 2               ; =============================================================================
0007DDr 2               ;   B a s P r i n t K e y w o r d
0007DDr 2               ; =============================================================================
0007DDr 2               ; Print the keyword whose token byte is in A (bit 7 set).
0007DDr 2               ; Walks the keyword table to find entry (A - TOK_BASE) and prints its chars.
0007DDr 2               ; =============================================================================
0007DDr 2               BasPrintKeyword:
0007DDr 2  38                   sec
0007DEr 2  E9 80                sbc     #TOK_BASE               ; A = index
0007E0r 2  AA                   tax
0007E1r 2                       ; Walk via 16-bit BAS_KWPTR since the table is > 256 bytes.
0007E1r 2  A9 rr                lda     #<KeywordTbl
0007E3r 2  85 61                sta     BAS_KWPTR
0007E5r 2  A9 rr                lda     #>KeywordTbl
0007E7r 2  85 62                sta     BAS_KWPTR+1
0007E9r 2  A0 00                ldy     #0
0007EBr 2               @FindLoop:
0007EBr 2  E0 00                cpx     #0
0007EDr 2  F0 0F                beq     @PrintIt
0007EFr 2                       ; Skip current keyword: walk byte-by-byte until we consume a byte
0007EFr 2                       ; whose bit 7 is set (last char of the keyword).
0007EFr 2               @Skip:
0007EFr 2  B1 61                lda     (BAS_KWPTR),y           ; Y == 0
0007F1r 2  E6 61                inc     BAS_KWPTR
0007F3r 2  D0 02                bne     @SkipNoCarry
0007F5r 2  E6 62                inc     BAS_KWPTR+1
0007F7r 2               @SkipNoCarry:
0007F7r 2  C9 80                cmp     #$80                    ; C set iff loaded byte >= $80
0007F9r 2  90 F4                bcc     @Skip
0007FBr 2               @SkipEnd:
0007FBr 2  CA                   dex
0007FCr 2  80 ED                bra     @FindLoop
0007FEr 2               @PrintIt:
0007FEr 2               @PrintLoop:
0007FEr 2  B1 61                lda     (BAS_KWPTR),y           ; Y == 0
000800r 2  E6 61                inc     BAS_KWPTR
000802r 2  D0 02                bne     @PrintNoCarry
000804r 2  E6 62                inc     BAS_KWPTR+1
000806r 2               @PrintNoCarry:
000806r 2  48                   pha
000807r 2  29 7F                and     #$7F
000809r 2  20 rr rr             jsr     Chrout
00080Cr 2  68                   pla
00080Dr 2  10 EF                bpl     @PrintLoop
00080Fr 2  60                   rts
000810r 2               
000810r 2               ; =============================================================================
000810r 2               ;   E R R O R   H A N D L I N G
000810r 2               ; =============================================================================
000810r 2               
000810r 2               BasErrSyntax:
000810r 2  A9 00                lda     #ERR_SYNTAX
000812r 2                       ; fall through
000812r 2               
000812r 2               ; BasError - print "?<msg> ERROR[ IN nnnn]" and return to the REPL.
000812r 2               ;   Input: A = error code (index into ErrorMessages).
000812r 2               ;   Resets the stack, prints, and jumps to BasReadyLoop.
000812r 2               BasError:
000812r 2  85 3E                sta     BAS_TMP3                ; stash code (stack reset wipes A on stack)
000814r 2  A2 FF                ldx     #$FF
000816r 2  9A                   txs
000817r 2  8E 75 03             stx     BAS_STKBASE
00081Ar 2                       ; An error can strike anywhere -- part-way through an expression, deep
00081Ar 2                       ; in a string function -- so unlike a STOP there is no boundary to
00081Ar 2                       ; unwind to and the FOR/GOSUB frames go with it.  Saying CAN'T CONTINUE
00081Ar 2                       ; is then the honest answer: resuming onto a frame that is no longer
00081Ar 2                       ; there is how ?NEXT WITHOUT FOR turns up two statements later.
00081Ar 2  9C 6E 03             stz     BAS_OLDTEXT+1
00081Dr 2  20 rr rr             jsr     BasTextCRLF
000820r 2  A9 3F                lda     #'?'
000822r 2  20 rr rr             jsr     Chrout
000825r 2  A5 3E                lda     BAS_TMP3
000827r 2                       ; A = error code; print the matching message.
000827r 2  20 rr rr             jsr     BasPrintErrorMsg
00082Ar 2                       ; Append " ERROR" and (if not direct mode) line number.
00082Ar 2  A9 rr                lda     #<MsgErrorWord
00082Cr 2  A0 rr                ldy     #>MsgErrorWord
00082Er 2  20 rr rr             jsr     BasPrintStr
000831r 2  4C rr rr             jmp     BasStopAtLine
000834r 2               
000834r 2               ; BasStopAtLine / BasStopDirect - the tail every "stop and go back to the
000834r 2               ;   prompt" path shares: an error, a STOP, a Ctrl+C break.
000834r 2               ;
000834r 2               ;   BasStopAtLine appends " IN nnnn" when a program is running and says nothing
000834r 2               ;   in direct mode; BasStopDirect skips straight past that, for the caller that
000834r 2               ;   has already decided there is no line to name.  Both then mark direct mode
000834r 2               ;   and bounce to the REPL.
000834r 2               ;
000834r 2               ;   Entered with a jmp, never a jsr - it does not come back, and every caller
000834r 2               ;   has already put the stack pointer where it belongs: an error resets it to
000834r 2               ;   $FF, a STOP or a break winds it back to BAS_STKBASE so the program's FOR
000834r 2               ;   and GOSUB frames are still there for CONT.
000834r 2               BasStopAtLine:
000834r 2  AD 6A 03             lda     BAS_CURLIN+1
000837r 2  C9 FF                cmp     #$FF
000839r 2  F0 14                beq     BasStopDirect
00083Br 2  A9 rr                lda     #<MsgInWord
00083Dr 2  A0 rr                ldy     #>MsgInWord
00083Fr 2  20 rr rr             jsr     BasPrintStr
000842r 2  AD 69 03             lda     BAS_CURLIN
000845r 2  85 08                sta     BAS_LINNUM
000847r 2  AD 6A 03             lda     BAS_CURLIN+1
00084Ar 2  85 09                sta     BAS_LINNUM+1
00084Cr 2  20 rr rr             jsr     BasPrintLineNum
00084Fr 2               BasStopDirect:
00084Fr 2                       ; Mark direct mode and bounce back to REPL.
00084Fr 2  A9 FF                lda     #$FF
000851r 2  8D 69 03             sta     BAS_CURLIN
000854r 2  8D 6A 03             sta     BAS_CURLIN+1
000857r 2  4C rr rr             jmp     BasReadyLoop
00085Ar 2               
00085Ar 2               ; BasTextCRLF - BasTextConsole, then a CRLF: how an error, a STOP and a Ctrl+C
00085Ar 2               ;   break start their message, so it lands on a screen that can show it.
00085Ar 2               BasTextCRLF:
00085Ar 2  20 rr rr             jsr     BasTextConsole
00085Dr 2  4C rr rr             jmp     BasPrintCRLF
000860r 2               
000860r 2               ; BasTextConsole - put the Text console back once a program has stopped.
000860r 2               ;   A program that left the card in another mode (SCREEN 1-3, VREG 13, SPRITE,
000860r 2               ;   SCROLL, LAYER -- anything that took VID_MODE off $01) would otherwise get
000860r 2               ;   its error, its BREAK and the OK prompt written into a name table nobody can
000860r 2               ;   read.  InitVideo + CLS, only then: VPOKE and PALETTE leave VID_MODE alone,
000860r 2               ;   so glyphs a program redefined in Text mode survive END.  No card: nothing.
000860r 2               BasTextConsole:
000860r 2  2C 0D 03             bit     HW_PRESENT              ; Video is bit 7
000863r 2  10 0D                bpl     @done
000865r 2  AD 93 03             lda     VID_MODE
000868r 2  C9 01                cmp     #$01
00086Ar 2  F0 06                beq     @done
00086Cr 2  20 rr rr             jsr     InitVideo
00086Fr 2  4C rr rr             jmp     VideoClear
000872r 2               @done:
000872r 2  60                   rts
000873r 2               
000873r 2               ; BasPrintErrorMsg - print message #A from the error-message table.
000873r 2               ;   Each message is NUL-terminated; the table is a sequence of those.
000873r 2               BasPrintErrorMsg:
000873r 2  AA                   tax
000874r 2  A9 rr                lda     #<ErrorMessages
000876r 2  85 3A                sta     BAS_TMP1
000878r 2  A9 rr                lda     #>ErrorMessages
00087Ar 2  85 3B                sta     BAS_TMP1+1
00087Cr 2               @Skip:
00087Cr 2  E0 00                cpx     #0
00087Er 2  F0 17                beq     @Print
000880r 2                       ; Walk past one message (advance until NUL, then one more).
000880r 2               @SkipLoop:
000880r 2  A0 00                ldy     #0
000882r 2  B1 3A                lda     (BAS_TMP1),y
000884r 2  F0 08                beq     @SkipDone
000886r 2  E6 3A                inc     BAS_TMP1
000888r 2  D0 F6                bne     @SkipLoop
00088Ar 2  E6 3B                inc     BAS_TMP1+1
00088Cr 2  80 F2                bra     @SkipLoop
00088Er 2               @SkipDone:
00088Er 2  E6 3A                inc     BAS_TMP1
000890r 2  D0 02                bne     @SkippedHi
000892r 2  E6 3B                inc     BAS_TMP1+1
000894r 2               @SkippedHi:
000894r 2  CA                   dex
000895r 2  80 E5                bra     @Skip
000897r 2               @Print:
000897r 2  A5 3A                lda     BAS_TMP1
000899r 2  A4 3B                ldy     BAS_TMP1+1
00089Br 2  4C rr rr             jmp     BasPrintStr
00089Er 2               
00089Er 2               
00089Er 2               ; =============================================================================
00089Er 2               ;   F L O A T I N G - P O I N T   R U N T I M E
00089Er 2               ;
00089Er 2               ;   Externals required by the inlined MSBASIC FP code:
00089Er 2               ;     ChrGet   - advance TXTPTR and load next non-space tokenized char
00089Er 2               ;                (used by Fin; never exercised by the FP tests).
00089Er 2               ;     BasErrorVec    - error vector; X = error code
00089Er 2               ;     IqErr    - "?ILLEGAL QUANTITY" entry
00089Er 2               ;     STROUT   - print NUL-terminated string at (A=lo, Y=hi)
00089Er 2               ;     QtIn    - the literal " IN " string (used only by InPrt)
00089Er 2               ; =============================================================================
00089Er 2               
00089Er 2               ; --- ChrGet / ChrGot --------------------------------------------------------
00089Er 2               ; Real implementation (ROM, not ZP self-modifying).  Increments TXTPTR and
00089Er 2               ; returns the next non-space byte at (TXTPTR) in A, with carry CLEAR if the
00089Er 2               ; byte is a digit '0'-'9'.  ChrGot re-reads the current byte without
00089Er 2               ; advancing first.  Both clobber only A and flags.
00089Er 2               ;
00089Er 2               ; Side effects on flags after the routine returns:
00089Er 2               ;   Z=1  if A == $00 or A is a tokenized/keyword byte that wraps to zero
00089Er 2               ;        (used by callers checking end-of-statement).
00089Er 2               ;   C=0  if A is a digit ('0'-'9'); else C=1.
00089Er 2               ;
00089Er 2               ; Implementation matches msbasic-master/chrget.s.
00089Er 2               ChrGet:
00089Er 2  E6 04                inc     TXTPTR
0008A0r 2  D0 02                bne     ChrGot
0008A2r 2  E6 05                inc     TXTPTR+1
0008A4r 2               ChrGot:
0008A4r 2  B2 04                lda     (TXTPTR)
0008A6r 2  C9 3A                cmp     #':'
0008A8r 2  B0 0A                bcs     @out
0008AAr 2  C9 20                cmp     #' '
0008ACr 2  F0 F0                beq     ChrGet
0008AEr 2  38                   sec
0008AFr 2  E9 30                sbc     #'0'
0008B1r 2  38                   sec
0008B2r 2  E9 D0                sbc     #$D0                    ; restore A; sets C=0 iff digit
0008B4r 2               @out:
0008B4r 2  60                   rts
0008B5r 2               
0008B5r 2               ; --- Error trampolines ------------------------------------------------------
0008B5r 2               ; The MSBASIC convention is "ldx #code / jmp ERROR".  Our BasError takes
0008B5r 2               ; the code in A, so translate.
0008B5r 2               BasErrorVec:
0008B5r 2  8A                   txa
0008B6r 2  4C rr rr             jmp     BasError
0008B9r 2               
0008B9r 2               IqErr:
0008B9r 2  A2 0B                ldx     #ERR_ILLQUAN
0008BBr 2  4C rr rr             jmp     BasErrorVec
0008BEr 2               
0008BEr 2               ; --- String output ----------------------------------------------------------
0008BEr 2               ; FP code calls STROUT with (A=lo, Y=hi).  BasPrintStr matches that ABI.
0008BEr 2               STROUT          := BasPrintStr
0008BEr 2               
0008BEr 2               ; --- "IN " literal (referenced by InPrt) ----------------------------------
0008BEr 2               QtIn:
0008BEr 2  20 49 4E 20          .byte   " IN ",0
0008C2r 2  00           
0008C3r 2               
0008C3r 2               ; --- Shared RTS targets used by branches in the FP code --------------------
0008C3r 2               ; The original MSBASIC defines Rts3 in poke.s (which we don't include).
0008C3r 2               ; Provide a single shared RTS landing pad here.
0008C3r 2               Rts3:
0008C3r 2  60                   rts
0008C4r 2               
0008C4r 2               ; =============================================================================
0008C4r 2               ;   F L O A T I N G - P O I N T   R U N T I M E   ( P h a s e   2 )
0008C4r 2               ;
0008C4r 2               ;   Inline-ported from msbasic-master/{float,trig,rnd}.s.  Symbol aliases for
0008C4r 2               ;   FAC, ARG, INDEX, etc. are defined at the top of this file.  External hooks
0008C4r 2               ;   (ChrGet, BasErrorVec, IqErr, STROUT, QtIn) are stubbed below.
0008C4r 2               ; =============================================================================
0008C4r 2               
0008C4r 2               ; ===== from msbasic-master/float.s =====
0008C4r 2               ; (.segment removed - inlined into BASIC)
0008C4r 2               
0008C4r 2               TEMP1X = TEMP1+(5-BYTES_FP)
0008C4r 2               
