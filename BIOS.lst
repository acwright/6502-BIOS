000EC8r 2  rr rr          .word DisOpAbx             ; AM_ABX  = 7
000ECAr 2  rr rr          .word DisOpAby             ; AM_ABY  = 8
000ECCr 2  rr rr          .word DisOpInd             ; AM_IND  = 9
000ECEr 2  rr rr          .word DisOpIzx             ; AM_IZX  = 10
000ED0r 2  rr rr          .word DisOpIzy             ; AM_IZY  = 11
