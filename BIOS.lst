0017DCr 2  B0 1A                bcs     CheckBump
0017DEr 2               @inrange:
0017DEr 2  C5 0D                cmp     LOWTR+1
0017E0r 2  90 16                bcc     CheckBump
0017E2r 2  D0 04                bne     @higher
0017E4r 2  E4 0C                cpx     LOWTR
0017E6r 2  90 10                bcc     CheckBump
0017E8r 2               @higher:
0017E8r 2  86 0C                stx     LOWTR
0017EAr 2  85 0D                sta     LOWTR+1
0017ECr 2  A5 20                lda     INDEX
0017EEr 2  A6 21                ldx     INDEX+1
0017F0r 2  85 81                sta     FNCNAM
0017F2r 2  86 82                stx     FNCNAM+1
0017F4r 2  A5 7F                lda     DSCLEN
0017F6r 2  85 83                sta     Z52
0017F8r 2               
0017F8r 2               CheckBump:
0017F8r 2  A5 7F                lda     DSCLEN
0017FAr 2  18                   clc
0017FBr 2  65 20                adc     INDEX
0017FDr 2  85 20                sta     INDEX
0017FFr 2  90 02                bcc     @nb
001801r 2  E6 21                inc     INDEX+1
001803r 2               @nb:
001803r 2  A6 21                ldx     INDEX+1
001805r 2  A0 00                ldy     #$00
001807r 2  60                   rts
001808r 2               
001808r 2               MoveHighestStringToTop:
001808r 2  A5 82                lda     FNCNAM+1
00180Ar 2  05 81                ora     FNCNAM
00180Cr 2  F0 33                beq     @nb
00180Er 2  A5 83                lda     Z52
001810r 2  E9 03                sbc     #$03
001812r 2  4A                   lsr     a
001813r 2  A8                   tay
001814r 2  85 83                sta     Z52
001816r 2  B1 81                lda     (FNCNAM),y
001818r 2  65 0C                adc     LOWTR
00181Ar 2  85 79                sta     HIGHTR
00181Cr 2  A5 0D                lda     LOWTR+1
00181Er 2  69 00                adc     #$00
001820r 2  85 7A                sta     HIGHTR+1
001822r 2  AD 65 03             lda     FRETOP
001825r 2  AE 66 03             ldx     FRETOP+1
001828r 2  85 77                sta     HIGHDS
00182Ar 2  86 78                stx     HIGHDS+1
00182Cr 2  20 rr rr             jsr     Bltu2
00182Fr 2  A4 83                ldy     Z52
001831r 2  C8                   iny
001832r 2  A5 77                lda     HIGHDS
001834r 2  91 81                sta     (FNCNAM),y
001836r 2  AA                   tax
001837r 2  E6 78                inc     HIGHDS+1
001839r 2  A5 78                lda     HIGHDS+1
