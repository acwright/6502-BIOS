002302r 2               
002302r 2               ; ---------------------------------------------------------------------------
002302r 2               ; Statement: INPUT [<"prompt">{,;}] var[,var,...]
002302r 2               ;   Prompts user for input, reads a line, parses it into the variable list.
002302r 2               ;   "abc";VAR  prints  abc?    (question + space appended)
002302r 2               ;   "abc",VAR  prints  abc      (no question mark)
002302r 2               ;   no prompt: prints  ?
002302r 2               ;   On bad numeric input or premature end-of-line: "?REDO FROM START"
002302r 2               ;   and reprompt.  Trailing un-consumed input: "?EXTRA IGNORED".
002302r 2               ; ---------------------------------------------------------------------------
002302r 2               BasCmdInput:
002302r 2                       ; INPUT is illegal in direct mode.
002302r 2  AD 6A 03             lda     BAS_CURLIN+1
002305r 2  C9 FF                cmp     #$FF
002307r 2  D0 05                bne     @notDirect
002309r 2  A2 07                ldx     #ERR_ILLDIRECT
00230Br 2  4C rr rr             jmp     BasErrorVec
00230Er 2               @notDirect:
00230Er 2                       ; ChrGot returns first char after the INPUT token.
00230Er 2  20 rr rr             jsr     ChrGot
002311r 2  C9 22                cmp     #'"'
002313r 2  D0 27                bne     @noPrompt
002315r 2                       ; Parse string literal & print it; FrmEvl will leave descriptor in FAC.
002315r 2  20 rr rr             jsr     FrmEvl
002318r 2  20 rr rr             jsr     ChkStr
00231Br 2  20 rr rr             jsr     PrintStrFAC
00231Er 2  20 rr rr             jsr     FreFac
002321r 2  20 rr rr             jsr     ChrGot
002324r 2  C9 3B                cmp     #';'
002326r 2  F0 09                beq     @semi
002328r 2  C9 2C                cmp     #','
00232Ar 2  D0 0D                bne     @badPrompt
00232Cr 2  20 rr rr             jsr     ChrGet                  ; consume ','
00232Fr 2  80 0E                bra     @afterPrompt
002331r 2               @semi:
002331r 2  20 rr rr             jsr     ChrGet                  ; consume ';'
002334r 2  20 rr rr             jsr     BasInpQues              ; '? '
002337r 2  80 06                bra     @afterPrompt
002339r 2               @badPrompt:
002339r 2  4C rr rr             jmp     SynErr
00233Cr 2               @noPrompt:
00233Cr 2  20 rr rr             jsr     BasInpQues              ; '? '
00233Fr 2               @afterPrompt:
00233Fr 2                       ; Save program TXTPTR (start of var-list) for REDO retry.
00233Fr 2  A5 04                lda     TXTPTR
002341r 2  8D 71 03             sta     BAS_INPSAV
002344r 2  A5 05                lda     TXTPTR+1
002346r 2  8D 72 03             sta     BAS_INPSAV+1
002349r 2               @retry:
002349r 2  20 rr rr             jsr     BasReadLine             ; reads to BAS_LINBUF, NUL-terminated, prints CRLF
00234Cr 2                       ; Set up data pointer with leading ',' sentinel just before LINBUF.
00234Cr 2  A9 2C                lda     #','
00234Er 2  8D FF 03             sta     BAS_LINBUF-1
002351r 2  A9 FF                lda     #<(BAS_LINBUF-1)
002353r 2  85 3A                sta     BAS_TMP1
002355r 2  A9 03                lda     #>(BAS_LINBUF-1)
002357r 2  85 3B                sta     BAS_TMP1+1
002359r 2                       ; Restore program TXTPTR.
002359r 2  AD 71 03             lda     BAS_INPSAV
00235Cr 2  85 04                sta     TXTPTR
00235Er 2  AD 72 03             lda     BAS_INPSAV+1
002361r 2  85 05                sta     TXTPTR+1
002363r 2  64 69                stz     BAS_INPUTFLG            ; INPUT mode ($00)
002365r 2               @nextVar:
002365r 2  20 rr rr             jsr     PtrGet                  ; advance program TXTPTR past var name
002368r 2  85 46                sta     BAS_FORPNT
00236Ar 2  84 47                sty     BAS_FORPNT+1
00236Cr 2                       ; Save program TXTPTR; switch to data side.
00236Cr 2  A5 05                lda     TXTPTR+1
00236Er 2  48                   pha
00236Fr 2  A5 04                lda     TXTPTR
002371r 2  48                   pha
002372r 2  A5 3A                lda     BAS_TMP1
002374r 2  85 04                sta     TXTPTR
002376r 2  A5 3B                lda     BAS_TMP1+1
002378r 2  85 05                sta     TXTPTR+1
00237Ar 2  20 rr rr             jsr     ChrGot
00237Dr 2  D0 05                bne     @gotData
00237Fr 2                       ; Out of input data before var list exhausted -> REDO.
00237Fr 2  68                   pla
002380r 2  68                   pla
002381r 2  4C rr rr             jmp     @doRedo
002384r 2               @gotData:
002384r 2  20 rr rr             jsr     ChrGet                  ; consume the separator/sentinel
002387r 2  24 64                bit     VALTYP
002389r 2  30 2E                bmi     @inpStr
00238Br 2                       ; Numeric: must start with digit, '+', '-' or '.'; else REDO.
00238Br 2  20 rr rr             jsr     ChrGot
00238Er 2  90 11                bcc     @numOk                  ; carry clear == digit
002390r 2  C9 2D                cmp     #'-'
002392r 2  F0 0D                beq     @numOk
002394r 2  C9 2B                cmp     #'+'
002396r 2  F0 09                beq     @numOk
002398r 2  C9 2E                cmp     #'.'
00239Ar 2  F0 05                beq     @numOk
00239Cr 2                       ; bad numeric
00239Cr 2  68                   pla
00239Dr 2  68                   pla
00239Er 2  4C rr rr             jmp     @doRedo
0023A1r 2               @numOk:
0023A1r 2  20 rr rr             jsr     Fin
0023A4r 2  A6 46                ldx     BAS_FORPNT
0023A6r 2  A4 47                ldy     BAS_FORPNT+1
0023A8r 2  20 rr rr             jsr     StoreFacAtYxRounded
0023ABr 2                       ; After Fin, ChrGot result must be NUL or ',' (Fin/ChrGot skips spaces).
0023ABr 2  20 rr rr             jsr     ChrGot
0023AEr 2  F0 0E                beq     @afterStore
0023B0r 2  C9 2C                cmp     #','
0023B2r 2  F0 0A                beq     @afterStore
0023B4r 2                       ; Garbage trailing the number -> REDO.
0023B4r 2  68                   pla
0023B5r 2  68                   pla
0023B6r 2  4C rr rr             jmp     @doRedo
0023B9r 2               @inpStr:
0023B9r 2  A2 00                ldx     #0                      ; INPUT stops an unquoted item at ',' only
0023BBr 2  20 rr rr             jsr     BasStrItem
0023BEr 2               @afterStore:
0023BEr 2                       ; Save data ptr; restore program TXTPTR.
0023BEr 2  A5 04                lda     TXTPTR
0023C0r 2  85 3A                sta     BAS_TMP1
0023C2r 2  A5 05                lda     TXTPTR+1
0023C4r 2  85 3B                sta     BAS_TMP1+1
0023C6r 2  68                   pla
0023C7r 2  85 04                sta     TXTPTR
0023C9r 2  68                   pla
0023CAr 2  85 05                sta     TXTPTR+1
0023CCr 2                       ; More variables?
0023CCr 2  20 rr rr             jsr     ChrGot
0023CFr 2  C9 2C                cmp     #','
0023D1r 2  D0 06                bne     @doneVars
0023D3r 2  20 rr rr             jsr     ChrGet                  ; consume ','
0023D6r 2  4C rr rr             jmp     @nextVar
0023D9r 2               @doneVars:
0023D9r 2                       ; Check for un-consumed input (EXTRA IGNORED).
0023D9r 2  A0 00                ldy     #0
0023DBr 2  B1 3A                lda     (BAS_TMP1),y
0023DDr 2  F0 12                beq     @inpDone
0023DFr 2                       ; Skip leading spaces; anything else is "extra".
0023DFr 2               @chkExtra:
0023DFr 2  B1 3A                lda     (BAS_TMP1),y
0023E1r 2  F0 0E                beq     @inpDone
0023E3r 2  C9 20                cmp     #' '
0023E5r 2  D0 03                bne     @hasExtra
0023E7r 2  C8                   iny
0023E8r 2  D0 F5                bne     @chkExtra
0023EAr 2               @hasExtra:
0023EAr 2  A9 rr                lda     #<MsgExtra
0023ECr 2  A0 rr                ldy     #>MsgExtra
0023EEr 2  20 rr rr             jsr     BasPrintStr
0023F1r 2               @inpDone:
0023F1r 2  60                   rts
0023F2r 2               @doRedo:
0023F2r 2  A9 rr                lda     #<MsgRedo
0023F4r 2  A0 rr                ldy     #>MsgRedo
0023F6r 2  20 rr rr             jsr     BasPrintStr
0023F9r 2  4C rr rr             jmp     @retry
0023FCr 2               
0023FCr 2               ; Print "? " prompt (used by INPUT and the ';' prompt-suffix path).
0023FCr 2               BasInpQues:
0023FCr 2  A9 3F                lda     #'?'
0023FEr 2  20 rr rr             jsr     PrintCh
002401r 2  A9 20                lda     #' '
002403r 2  4C rr rr             jmp     PrintCh
002406r 2               
002406r 2               MsgRedo:
002406r 2  3F 52 45 44          .byte   "?REDO FROM START", $0D, $0A, 0
00240Ar 2  4F 20 46 52  
00240Er 2  4F 4D 20 53  
002419r 2               MsgExtra:
002419r 2  3F 45 58 54          .byte   "?EXTRA IGNORED", $0D, $0A, 0
00241Dr 2  52 41 20 49  
002421r 2  47 4E 4F 52  
00242Ar 2               
00242Ar 2               ; ---------------------------------------------------------------------------
00242Ar 2               ; Statement: READ var[,var,...] -- pull next DATA item from BAS_DATAPTR
00242Ar 2               ; into the variable pointed to by PtrGet.
00242Ar 2               ; ---------------------------------------------------------------------------
00242Ar 2               ; ---------------------------------------------------------------------------
00242Ar 2               ; BasStrItem -- read one string item at TXTPTR into the variable BAS_FORPNT
00242Ar 2               ; points at.  Shared by INPUT and READ, which differ only in what ends an
00242Ar 2               ; unquoted item: INPUT stops at ',' or NUL, READ also stops at ':' because a
00242Ar 2               ; DATA statement can be followed by another statement on the same line.
00242Ar 2               ;
00242Ar 2               ; On entry : X        = the extra unquoted terminator (StrLt2's CHARAC)
00242Ar 2               ;            TXTPTR   = first character of the item
00242Ar 2               ;            FORPNT   = the variable's 3-byte descriptor slot
00242Ar 2               ; On exit  : TXTPTR advanced past the item, descriptor stored, temp popped.
00242Ar 2               ; ---------------------------------------------------------------------------
00242Ar 2               BasStrItem:
00242Ar 2                       ; A '"' here means quote-mode (terminator '"' or NUL); anything else
00242Ar 2                       ; is a bare item running to X, ',' or NUL.
00242Ar 2  A0 00                ldy     #0
00242Cr 2  B1 04                lda     (TXTPTR),y
00242Er 2  C9 22                cmp     #'"'
002430r 2  F0 0C                beq     @quoted
002432r 2  86 44                stx     CHARAC
002434r 2  A9 2C                lda     #','
002436r 2  85 6A                sta     ENDCHR
002438r 2  A5 04                lda     TXTPTR                  ; StrLt2's source = TXTPTR
00243Ar 2  A4 05                ldy     TXTPTR+1
00243Cr 2  80 0E                bra     @call
00243Er 2               @quoted:
00243Er 2  85 44                sta     CHARAC                  ; A is still '"' from the compare
002440r 2  85 6A                sta     ENDCHR
002442r 2  18                   clc                             ; skip it: source = TXTPTR + 1
002443r 2  A5 04                lda     TXTPTR
002445r 2  69 01                adc     #1
002447r 2  A4 05                ldy     TXTPTR+1
002449r 2  90 01                bcc     @call
00244Br 2  C8                   iny
00244Cr 2               @call:
00244Cr 2  20 rr rr             jsr     StrLt2
00244Fr 2                       ; StrLt2 leaves STRNG2 past the text it consumed -- at the terminator
00244Fr 2                       ; for an unquoted item, just past the closing '"' for a quoted one.
00244Fr 2                       ; TXTPTR has to follow it: for INPUT so the trailing-extra check sees
00244Fr 2                       ; only what really remained on the line, and for READ so the next one
00244Fr 2                       ; doesn't start again in the middle of the item this one took.
00244Fr 2  A5 1E                lda     STRNG2
002451r 2  85 04                sta     TXTPTR
002453r 2  A5 1F                lda     STRNG2+1
002455r 2  85 05                sta     TXTPTR+1
002457r 2  A0 00                ldy     #0
002459r 2  A5 0E                lda     FAC
00245Br 2  91 46                sta     (BAS_FORPNT),y
00245Dr 2  C8                   iny
00245Er 2  A5 0F                lda     FAC+1
002460r 2  91 46                sta     (BAS_FORPNT),y
002462r 2  C8                   iny
002463r 2  A5 10                lda     FAC+2
002465r 2  91 46                sta     (BAS_FORPNT),y
002467r 2                       ; StrLt2 pushed a temporary descriptor via PutNew.  The variable owns
002467r 2                       ; the heap copy now, so pop the temp -- do NOT use FreFac, which would
002467r 2                       ; reclaim the heap we just handed over.  Leaving temps unfreed leaks
002467r 2                       ; the 3-slot temp stack, both overflowing it (?FORMULA TOO COMPLEX)
002467r 2                       ; and corrupting later strings via stale descriptor pointers.
002467r 2  A5 11                lda     FAC+3
002469r 2  A4 12                ldy     FAC+4
00246Br 2  4C rr rr             jmp     FreTms
00246Er 2               
00246Er 2               BasCmdRead:
00246Er 2  AE 1A 03             ldx     BAS_DATAPTR
002471r 2  AC 1B 03             ldy     BAS_DATAPTR+1
002474r 2  A9 98                lda     #$98                    ; INPUTFLG = $98 means READ mode
002476r 2  2C                   .byte   $2C
002477r 2               BasInpDoit:
002477r 2  A9 00                lda     #0
002479r 2  85 69                sta     BAS_INPUTFLG
00247Br 2  86 3A                stx     BAS_TMP1                ; TMP1 = data pointer
00247Dr 2  84 3B                sty     BAS_TMP1+1
00247Fr 2               @nextVar:
00247Fr 2                       ; TXTPTR currently points into program at variable name.
00247Fr 2  20 rr rr             jsr     PtrGet                  ; advances TXTPTR past var name
002482r 2  85 46                sta     BAS_FORPNT
002484r 2  84 47                sty     BAS_FORPNT+1
002486r 2                       ; Save program TXTPTR on hw stack, switch TXTPTR to data ptr.
002486r 2  A5 05                lda     TXTPTR+1
002488r 2  48                   pha
002489r 2  A5 04                lda     TXTPTR
00248Br 2  48                   pha
00248Cr 2  A5 3A                lda     BAS_TMP1
00248Er 2  85 04                sta     TXTPTR
002490r 2  A5 3B                lda     BAS_TMP1+1
002492r 2  85 05                sta     TXTPTR+1
002494r 2  20 rr rr             jsr     ChrGot
002497r 2  D0 08                bne     @gotData
002499r 2                       ; Out of items on this line - find next DATA.
002499r 2  20 rr rr             jsr     BasFindData
00249Cr 2  90 03                bcc     @gotData
00249Er 2  4C rr rr             jmp     @oodata
0024A1r 2               @gotData:
0024A1r 2                       ; Advance past separator (',' between items, ' ' after DATA token,
0024A1r 2                       ; or quote-delimiter for strings).  ChrGet also skips spaces.
0024A1r 2  20 rr rr             jsr     ChrGet
0024A4r 2                       ; Parse value at TXTPTR (data side).
0024A4r 2  24 64                bit     VALTYP
0024A6r 2  30 0C                bmi     @readStr
0024A8r 2                       ; Numeric.
0024A8r 2  20 rr rr             jsr     Fin
0024ABr 2  A6 46                ldx     BAS_FORPNT
0024ADr 2  A4 47                ldy     BAS_FORPNT+1
0024AFr 2  20 rr rr             jsr     StoreFacAtYxRounded
0024B2r 2  80 05                bra     @afterStore
0024B4r 2               @readStr:
0024B4r 2                       ; Previously this called StrLt2 without setting up its (A,Y) source
0024B4r 2                       ; argument at all, so every DATA string pointed into zero page: an
0024B4r 2                       ; unquoted item read back empty and a quoted one read back as garbage
0024B4r 2                       ; from $0022.  BasStrItem is INPUT's path, which had it right.
0024B4r 2  A2 3A                ldx     #':'                    ; a DATA item also ends at a statement break
0024B6r 2  20 rr rr             jsr     BasStrItem
0024B9r 2               @afterStore:
0024B9r 2                       ; Save updated data ptr.
0024B9r 2  A5 04                lda     TXTPTR
0024BBr 2  85 3A                sta     BAS_TMP1
0024BDr 2  A5 05                lda     TXTPTR+1
0024BFr 2  85 3B                sta     BAS_TMP1+1
0024C1r 2                       ; Restore program TXTPTR.
0024C1r 2  68                   pla
0024C2r 2  85 04                sta     TXTPTR
0024C4r 2  68                   pla
0024C5r 2  85 05                sta     TXTPTR+1
0024C7r 2                       ; If next program byte is ',', another variable follows.
0024C7r 2  20 rr rr             jsr     ChrGot
0024CAr 2  C9 2C                cmp     #','
0024CCr 2  D0 05                bne     @done
0024CEr 2  20 rr rr             jsr     ChrGet
0024D1r 2  80 AC                bra     @nextVar
0024D3r 2               @done:
0024D3r 2                       ; Persist data ptr.
0024D3r 2  A5 3A                lda     BAS_TMP1
0024D5r 2  8D 1A 03             sta     BAS_DATAPTR
0024D8r 2  A5 3B                lda     BAS_TMP1+1
0024DAr 2  8D 1B 03             sta     BAS_DATAPTR+1
0024DDr 2  60                   rts
0024DEr 2               @oodata:
0024DEr 2  A2 0E                ldx     #ERR_OD
0024E0r 2  4C rr rr             jmp     BasErrorVec
0024E3r 2               
0024E3r 2               ; ---------------------------------------------------------------------------
0024E3r 2               ; BasFindData -- starting from TXTPTR (positioned somewhere within a line's
0024E3r 2               ; payload), advance to the byte after the next DATA token in the program.
0024E3r 2               ; Returns carry SET on out-of-data, carry CLEAR with TXTPTR at first byte
0024E3r 2               ; AFTER the DATA token (i.e. at the first DATA item).
0024E3r 2               ; ---------------------------------------------------------------------------
0024E3r 2               BasFindData:
0024E3r 2               @scanByte:
0024E3r 2  A0 00                ldy     #0
0024E5r 2  B1 04                lda     (TXTPTR),y
0024E7r 2  F0 1F                beq     @atEnd
0024E9r 2  C9 83                cmp     #TOK_DATA
0024EBr 2  F0 2E                beq     @found
0024EDr 2  C9 22                cmp     #'"'
0024EFr 2  D0 12                bne     @advance1
0024F1r 2                       ; Skip quoted string (advance TXTPTR past closing quote or NUL).
0024F1r 2  20 rr rr             jsr     @incTxt
0024F4r 2               @inStr:
0024F4r 2  A0 00                ldy     #0
0024F6r 2  B1 04                lda     (TXTPTR),y
0024F8r 2  F0 0E                beq     @atEnd
0024FAr 2  20 rr rr             jsr     @incTxt
0024FDr 2  C9 22                cmp     #'"'
0024FFr 2  D0 F3                bne     @inStr
002501r 2  80 E0                bra     @scanByte
002503r 2               @advance1:
002503r 2  20 rr rr             jsr     @incTxt
002506r 2  80 DB                bra     @scanByte
002508r 2               @atEnd:
002508r 2                       ; (TXTPTR) is on the line's $00 terminator.  Bytes immediately after
002508r 2                       ; are the next line's [next-lo][next-hi][num-lo][num-hi][payload..].
002508r 2                       ; Check next-pointer at offset +2 (next-hi); if 0, end of program.
002508r 2  A0 02                ldy     #2
00250Ar 2  B1 04                lda     (TXTPTR),y
00250Cr 2  F0 0F                beq     @oodata
00250Er 2                       ; Advance TXTPTR by 5: past terminator (1) + line header (4).
00250Er 2  18                   clc
00250Fr 2  A5 04                lda     TXTPTR
002511r 2  69 05                adc     #5
002513r 2  85 04                sta     TXTPTR
002515r 2  90 CC                bcc     @scanByte
002517r 2  E6 05                inc     TXTPTR+1
002519r 2  80 C8                bra     @scanByte
00251Br 2               @found:
00251Br 2                       ; TXTPTR is left AT the TOK_DATA byte; caller's CHRGET advances past.
00251Br 2  18                   clc
00251Cr 2  60                   rts
00251Dr 2               @oodata:
00251Dr 2  38                   sec
00251Er 2  60                   rts
00251Fr 2               @incTxt:
00251Fr 2  E6 04                inc     TXTPTR
002521r 2  D0 02                bne     @r
002523r 2  E6 05                inc     TXTPTR+1
002525r 2               @r:
002525r 2  60                   rts
002526r 2               
002526r 2               ; ---------------------------------------------------------------------------
002526r 2               ; Statement: FOR var = expr1 TO expr2 [STEP expr3]
002526r 2               ; Pushes 18-byte frame on CPU stack:
002526r 2               ;   [tag $81][VAR-lo][VAR-hi][STEP-FP (5)][STEP-sign][CURLIN-lo][CURLIN-hi]
002526r 2               ;   [TXTPTR-lo][TXTPTR-hi][LIMIT-FP (5)]
002526r 2               ; ---------------------------------------------------------------------------
002526r 2               BasCmdFor:
002526r 2                       ; Set SUBFLG so PtrGet doesn't recurse on FN.
002526r 2  A9 80                lda     #$80
002528r 2  85 68                sta     SUBFLG
00252Ar 2  20 rr rr             jsr     BasCmdLet               ; consumes "var = expr"
00252Dr 2                       ; PtrGet (inside LET) saved VARPNT in FORPNT (hopefully). Re-fetch
00252Dr 2                       ; FORPNT from the assignment, but BasCmdLet doesn't set FORPNT in
00252Dr 2                       ; our impl.  Re-parse the variable name by rewinding TXTPTR via
00252Dr 2                       ; CURLIN scan.  Cheat: BasCmdLet leaves VARPNT current.
00252Dr 2  A5 3F                lda     VARPNT
00252Fr 2  85 46                sta     BAS_FORPNT
002531r 2  A5 40                lda     VARPNT+1
002533r 2  85 47                sta     BAS_FORPNT+1
002535r 2                       ; Discard any prior FOR frame for the same variable to avoid leak.
002535r 2  20 rr rr             jsr     GtForPnt
002538r 2  90 00                bcc     @noOld                  ; carry clear -> no matching frame
00253Ar 2                       ; The prior-frame pop is still skipped: the runtime tolerates one stray
00253Ar 2                       ; frame, and msbasic re-uses the slot only when an explicit FOR with a
00253Ar 2                       ; matching variable already exists, which is rare. GtForPnt does now
00253Ar 2                       ; report found/not-found in carry (Z was ambiguous and unusable), so
00253Ar 2                       ; this branch is at least honest about which case it is in.
00253Ar 2               @noOld:
00253Ar 2                       ; Discard our caller's (BasExecuteStatement's) return address so
00253Ar 2                       ; that the FOR frame sits on the stack with no other junk above it.
00253Ar 2                       ; We will JMP BasNewstt at the end instead of RTSing.
00253Ar 2  68                   pla
00253Br 2  68                   pla
00253Cr 2                       ; Push limit (will be parsed below) -- we lay out the frame as:
00253Cr 2                       ;   pushed first (deepest): TXTPTR, CURLIN, LIMIT (5), STEP-sign,
00253Cr 2                       ;   STEP (5), VAR-addr, $81-tag.
00253Cr 2                       ; We don't know LIMIT/STEP yet; we push placeholders and patch.
00253Cr 2                       ; Easier: parse limit & step first, then push frame in one go.
00253Cr 2  A9 9C                lda     #TOK_TO
00253Er 2  20 rr rr             jsr     SynChr
002541r 2  20 rr rr             jsr     FrmNum
002544r 2                       ; Strip sign info on limit (msbasic stores limit unsigned-magnitude
002544r 2                       ; with sign packed).  Pack FACSIGN bit 7 -> FAC+1 bit 7.
002544r 2  A5 13                lda     FACSIGN
002546r 2  09 7F                ora     #$7F
002548r 2  25 0F                and     FAC+1
00254Ar 2  85 0F                sta     FAC+1
00254Cr 2                       ; Save LIMIT temporarily in BAS_TEMP1..+4 (5 bytes).
00254Cr 2  A2 04                ldx     #4
00254Er 2               @saveLimit:
00254Er 2  B5 0E                lda     FAC,x
002550r 2  95 4D                sta     BAS_TEMP1,x
002552r 2  CA                   dex
002553r 2  10 F9                bpl     @saveLimit
002555r 2                       ; STEP: default 1, or evaluate after TOK_STEP.
002555r 2  20 rr rr             jsr     ChrGot
002558r 2  C9 A1                cmp     #TOK_STEP
00255Ar 2  D0 08                bne     @defStep
00255Cr 2  20 rr rr             jsr     ChrGet
00255Fr 2  20 rr rr             jsr     FrmNum
002562r 2  80 07                bra     @gotStep
002564r 2               @defStep:
002564r 2  A9 rr                lda     #<ConstOne
002566r 2  A0 rr                ldy     #>ConstOne
002568r 2  20 rr rr             jsr     LoadFacFromYa
00256Br 2               @gotStep:
00256Br 2  20 rr rr             jsr     Sign                    ; A = step sign byte (-1/0/1)
00256Er 2  85 52                sta     BAS_TEMP2               ; stash step sign
002570r 2                       ; Pack sign of FAC into FAC+1 bit7 then save STEP into BAS_TEMP2+1..+5.
002570r 2  A5 13                lda     FACSIGN
002572r 2  09 7F                ora     #$7F
002574r 2  25 0F                and     FAC+1
002576r 2  85 0F                sta     FAC+1
002578r 2  A2 04                ldx     #4
00257Ar 2               @saveStep:
00257Ar 2  B5 0E                lda     FAC,x
00257Cr 2  95 53                sta     BAS_TEMP2+1,x
00257Er 2  CA                   dex
00257Fr 2  10 F9                bpl     @saveStep
002581r 2                       ; Now push the frame on stack (deepest first):
002581r 2                       ;   TXTPTR-hi, TXTPTR-lo, CURLIN-hi, CURLIN-lo,
002581r 2                       ;   LIMIT[4..0]   (deepest=LIMIT[4], so LIMIT[0] ends at $010A,x),
002581r 2                       ;   STEP-sign,
002581r 2                       ;   STEP[4..0]    (deepest=STEP[4], so STEP[0]  ends at $0104,x),
002581r 2                       ;   VAR-hi, VAR-lo, $81
002581r 2  A5 05                lda     TXTPTR+1
002583r 2  48                   pha
002584r 2  A5 04                lda     TXTPTR
002586r 2  48                   pha
002587r 2  AD 6A 03             lda     BAS_CURLIN+1
00258Ar 2  48                   pha
00258Br 2  AD 69 03             lda     BAS_CURLIN
00258Er 2  48                   pha
00258Fr 2  A2 04                ldx     #4
002591r 2               @pushLim:
002591r 2  B5 4D                lda     BAS_TEMP1,x
002593r 2  48                   pha
002594r 2  CA                   dex
002595r 2  10 FA                bpl     @pushLim
002597r 2  A5 52                lda     BAS_TEMP2               ; step sign
002599r 2  48                   pha
00259Ar 2  A2 05                ldx     #5
00259Cr 2               @pushStep:
00259Cr 2  B5 52                lda     BAS_TEMP2,x
00259Er 2  48                   pha
00259Fr 2  CA                   dex
0025A0r 2  D0 FA                bne     @pushStep
0025A2r 2  A5 47                lda     BAS_FORPNT+1
0025A4r 2  48                   pha
0025A5r 2  A5 46                lda     BAS_FORPNT
0025A7r 2  48                   pha
0025A8r 2  A9 81                lda     #TOK_FOR
0025AAr 2  48                   pha
0025ABr 2  4C rr rr             jmp     BasNewstt               ; resume statement loop with frame in place
0025AEr 2               
0025AEr 2               ConstOne:
0025AEr 2  81 00 00 00          .byte   $81,$00,$00,$00,$00     ; FP +1.0
0025B2r 2  00           
0025B3r 2               
0025B3r 2               ; ---------------------------------------------------------------------------
0025B3r 2               ; Statement: NEXT [var]
0025B3r 2               ; Locate matching FOR frame, increment var by step, test against limit,
0025B3r 2               ; loop back if more iterations remain, else discard frame and continue.
0025B3r 2               ; ---------------------------------------------------------------------------
0025B3r 2               BasCmdNext:
0025B3r 2  20 rr rr             jsr     ChrGot
0025B6r 2  F0 0D                beq     @anyVar
0025B8r 2  C9 3A                cmp     #':'
0025BAr 2  F0 09                beq     @anyVar
0025BCr 2  20 rr rr             jsr     PtrGet
0025BFr 2  85 46                sta     BAS_FORPNT
0025C1r 2  84 47                sty     BAS_FORPNT+1
0025C3r 2  80 06                bra     @find
0025C5r 2               @anyVar:
0025C5r 2                       ; "NEXT" without a variable: set FORPNT = 0 so GtForPnt copies the
0025C5r 2                       ; stack-frame's var address into FORPNT and then trivially matches
0025C5r 2                       ; (any FOR frame is acceptable).
0025C5r 2  A9 00                lda     #0
0025C7r 2  85 46                sta     BAS_FORPNT
0025C9r 2  85 47                sta     BAS_FORPNT+1
0025CBr 2               @find:
0025CBr 2                       ; Carry, not Z: GtForPnt's not-found paths end in `lda #0`, which sets
0025CBr 2                       ; Z, so testing `beq` here read "no frame" as "found" -- a bare NEXT
0025CBr 2                       ; then did `txs` onto a garbage offset and died as ?SYNTAX ERROR IN 0
0025CBr 2                       ; instead of ?NEXT WITHOUT FOR.
0025CBr 2  20 rr rr             jsr     GtForPnt
0025CEr 2  B0 05                bcs     @found
0025D0r 2  A2 0D                ldx     #ERR_NF
0025D2r 2  4C rr rr             jmp     BasErrorVec
0025D5r 2               @found:
0025D5r 2                       ; X = stack offset of (tag - 1).  txs makes SP = X so the frame
0025D5r 2                       ; sits at $101+X..$112+X.  All subsequent accesses use $0101+offset,x
0025D5r 2                       ; just like msbasic.
0025D5r 2  9A                   txs
0025D6r 2                       ; Frame layout (tag at $0101+X):
0025D6r 2                       ;   $0101+X = $81 tag
0025D6r 2                       ;   $0102+X = VAR-lo
0025D6r 2                       ;   $0103+X = VAR-hi
0025D6r 2                       ;   $0104+X..$0108+X = STEP (5 bytes FP, FAC[0..4] ascending)
0025D6r 2                       ;   $0109+X = STEP-sign
0025D6r 2                       ;   $010A+X..$010E+X = LIMIT (5 bytes FP, FAC[0..4] ascending)
0025D6r 2                       ;   $010F+X = CURLIN-lo
0025D6r 2                       ;   $0110+X = CURLIN-hi
0025D6r 2                       ;   $0111+X = TXTPTR-lo
0025D6r 2                       ;   $0112+X = TXTPTR-hi
0025D6r 2                       ; Load STEP into FAC.
0025D6r 2  A9 01                lda     #$01
0025D8r 2  85 3B                sta     BAS_TMP1+1
0025DAr 2  8A                   txa
0025DBr 2  18                   clc
0025DCr 2  69 04                adc     #$04
0025DEr 2  85 3A                sta     BAS_TMP1                ; TMP1 -> STEP[0] at $0104,x
0025E0r 2  A5 3A                lda     BAS_TMP1
0025E2r 2  A4 3B                ldy     BAS_TMP1+1
0025E4r 2  20 rr rr             jsr     LoadFacFromYa
0025E7r 2                       ; FACSIGN := step sign byte at $0109,x.
0025E7r 2  BD 09 01             lda     $0109,x
0025EAr 2  85 13                sta     FACSIGN
0025ECr 2                       ; FAC += variable.
0025ECr 2  BD 02 01             lda     $0102,x
0025EFr 2  BC 03 01             ldy     $0103,x
0025F2r 2  85 46                sta     BAS_FORPNT
0025F4r 2  84 47                sty     BAS_FORPNT+1
0025F6r 2  20 rr rr             jsr     FAdd
0025F9r 2  20 rr rr             jsr     SetFor
0025FCr 2                       ; Compare FAC with LIMIT (at $010A,x).
0025FCr 2  BA                   tsx                             ; reload x (FAdd may have used it)
0025FDr 2  8A                   txa
0025FEr 2  18                   clc
0025FFr 2  69 0A                adc     #$0A
002601r 2  85 3A                sta     BAS_TMP1
002603r 2  A9 01                lda     #$01
002605r 2  85 3B                sta     BAS_TMP1+1
002607r 2  A5 3A                lda     BAS_TMP1
002609r 2  A4 3B                ldy     BAS_TMP1+1
00260Br 2  20 rr rr             jsr     FComp
00260Er 2  BA                   tsx
00260Fr 2  38                   sec
002610r 2  FD 09 01             sbc     $0109,x                 ; A - step-sign
002613r 2  F0 19                beq     @loopDone
002615r 2                       ; Continue: restore CURLIN/TXTPTR from frame, JMP NEWSTT (don't RTS).
002615r 2  BD 0F 01             lda     $010F,x
002618r 2  8D 69 03             sta     BAS_CURLIN
00261Br 2  BD 10 01             lda     $0110,x
00261Er 2  8D 6A 03             sta     BAS_CURLIN+1
002621r 2  BD 11 01             lda     $0111,x
002624r 2  85 04                sta     TXTPTR
002626r 2  BD 12 01             lda     $0112,x
002629r 2  85 05                sta     TXTPTR+1
00262Br 2  4C rr rr             jmp     BasNewstt
00262Er 2               @loopDone:
00262Er 2                       ; Discard frame: SP := X + 18.
00262Er 2  8A                   txa
00262Fr 2  18                   clc
002630r 2  69 12                adc     #18
002632r 2  AA                   tax
002633r 2  9A                   txs
002634r 2                       ; Allow ", var" to chain into another NEXT.
002634r 2  20 rr rr             jsr     ChrGot
002637r 2  C9 2C                cmp     #','
002639r 2  D0 06                bne     @retNewstt
00263Br 2  20 rr rr             jsr     ChrGet
00263Er 2  4C rr rr             jmp     BasCmdNext
002641r 2               @retNewstt:
002641r 2  4C rr rr             jmp     BasNewstt
002644r 2               
002644r 2               ; ---------------------------------------------------------------------------
002644r 2               ; Statement: DEF FN A(X) = expr
002644r 2               ; Stored in the variable's 5 value bytes:
002644r 2               ;   [TXTPTR-of-expr-lo][TXTPTR-of-expr-hi][param-name-lo][param-name-hi][0]
002644r 2               ; ---------------------------------------------------------------------------
002644r 2               BasCmdDef:
002644r 2                       ; Expect: FN <name>(<param>) = <expr>
002644r 2  A9 9D                lda     #TOK_FN
002646r 2  20 rr rr             jsr     SynChr
002649r 2  09 80                ora     #$80
00264Br 2  85 68                sta     SUBFLG                  ; tell PtrGet "this is a DEF FN var"
00264Dr 2  20 rr rr             jsr     PtrGet
002650r 2                       ; VARPNT = address of FN var slot.
002650r 2  85 81                sta     BAS_FNCNAM
002652r 2  84 82                sty     BAS_FNCNAM+1
002654r 2  20 rr rr             jsr     ChkNum
002657r 2                       ; Expect '(' name ')' = expr
002657r 2                       ; Param name parsed by recursive PtrGet inside FrmEvl on call;
002657r 2                       ; here we just record (param-name) by parsing it ourselves.
002657r 2  A9 28                lda     #'('
002659r 2  20 rr rr             jsr     SynChr
00265Cr 2  A9 80                lda     #$80
00265Er 2  85 68                sta     SUBFLG
002660r 2  20 rr rr             jsr     PtrGet
002663r 2                       ; VARPNT = param var addr.  Save it.
002663r 2  A5 3F                lda     VARPNT
002665r 2  85 3A                sta     BAS_TMP1
002667r 2  A5 40                lda     VARPNT+1
002669r 2  85 3B                sta     BAS_TMP1+1
00266Br 2  20 rr rr             jsr     ChkNum
00266Er 2  A9 29                lda     #')'
002670r 2  20 rr rr             jsr     SynChr
002673r 2  A9 3D                lda     #'='
002675r 2  20 rr rr             jsr     SynChr
002678r 2                       ; Reject in direct mode.
002678r 2  AD 6A 03             lda     BAS_CURLIN+1
00267Br 2  C9 FF                cmp     #$FF
00267Dr 2  D0 05                bne     @ok
00267Fr 2  A2 07                ldx     #ERR_ILLDIRECT
002681r 2  4C rr rr             jmp     BasErrorVec
002684r 2               @ok:
002684r 2                       ; Store [TXTPTR][param][0] in FN var.
002684r 2  A0 00                ldy     #0
002686r 2  A5 04                lda     TXTPTR
002688r 2  91 81                sta     (BAS_FNCNAM),y
00268Ar 2  C8                   iny
00268Br 2  A5 05                lda     TXTPTR+1
00268Dr 2  91 81                sta     (BAS_FNCNAM),y
00268Fr 2  C8                   iny
002690r 2  A5 3A                lda     BAS_TMP1
002692r 2  91 81                sta     (BAS_FNCNAM),y
002694r 2  C8                   iny
002695r 2  A5 3B                lda     BAS_TMP1+1
002697r 2  91 81                sta     (BAS_FNCNAM),y
002699r 2  C8                   iny
00269Ar 2  A9 00                lda     #0
00269Cr 2  91 81                sta     (BAS_FNCNAM),y
00269Er 2                       ; Skip past expression body.
00269Er 2  20 rr rr             jsr     BasDatan
0026A1r 2  4C rr rr             jmp     BasAddon
0026A4r 2               
0026A4r 2               ; ---------------------------------------------------------------------------
0026A4r 2               ; FnCall -- evaluator-side handler for "FN A(expr)".
0026A4r 2               ; Called by FrmEvl when it sees TOK_FN.  Evaluates argument, swaps in the
0026A4r 2               ; param's stored value, executes the FN expression, and restores the param.
0026A4r 2               ; ---------------------------------------------------------------------------
0026A4r 2               FnCall:
0026A4r 2  20 rr rr             jsr     ChrGet                  ; consume FN
0026A7r 2  09 80                ora     #$80
0026A9r 2  85 68                sta     SUBFLG
0026ABr 2  20 rr rr             jsr     PtrGet                  ; locate FN var
0026AEr 2  8D 73 03             sta     BAS_FNPTR               ; durable copy: FNCNAM lives in ZP and
0026B1r 2  8C 74 03             sty     BAS_FNPTR+1             ; is scratch for Garbag
0026B4r 2  85 81                sta     BAS_FNCNAM
0026B6r 2  84 82                sty     BAS_FNCNAM+1
0026B8r 2  20 rr rr             jsr     ChkNum
0026BBr 2                       ; Read param ptr from FN slot.
0026BBr 2  A0 02                ldy     #2
0026BDr 2  B1 81                lda     (BAS_FNCNAM),y
0026BFr 2  85 3F                sta     VARPNT
0026C1r 2  F0 57                beq     @undef
0026C3r 2  C8                   iny
0026C4r 2  B1 81                lda     (BAS_FNCNAM),y
0026C6r 2  85 40                sta     VARPNT+1
0026C8r 2                       ; Evaluate '(arg)'
0026C8r 2  A9 28                lda     #'('
0026CAr 2  20 rr rr             jsr     SynChr
0026CDr 2                       ; Save param's current FP value (5 bytes) on stack.
0026CDr 2  A0 04                ldy     #4
0026CFr 2               @savep:
0026CFr 2  B1 3F                lda     (VARPNT),y
0026D1r 2  48                   pha
0026D2r 2  88                   dey
0026D3r 2  10 FA                bpl     @savep
0026D5r 2                       ; Evaluate argument -> FAC.
0026D5r 2  20 rr rr             jsr     FrmNum
0026D8r 2  A9 29                lda     #')'
0026DAr 2  20 rr rr             jsr     SynChr
0026DDr 2                       ; Any variable reference in the argument re-pointed VARPNT (and Garbag
0026DDr 2                       ; may have eaten FNCNAM) — reload both before storing the argument.
0026DDr 2  20 rr rr             jsr     @reload
0026E0r 2                       ; Store FAC into param slot.
0026E0r 2  A6 3F                ldx     VARPNT
0026E2r 2  A4 40                ldy     VARPNT+1
0026E4r 2  20 rr rr             jsr     StoreFacAtYxRounded
0026E7r 2                       ; Save current TXTPTR.
0026E7r 2  A5 05                lda     TXTPTR+1
0026E9r 2  48                   pha
0026EAr 2  A5 04                lda     TXTPTR
0026ECr 2  48                   pha
0026EDr 2                       ; Switch TXTPTR to FN expression body.
0026EDr 2  A0 00                ldy     #0
0026EFr 2  B1 81                lda     (BAS_FNCNAM),y
0026F1r 2  85 04                sta     TXTPTR
0026F3r 2  C8                   iny
0026F4r 2  B1 81                lda     (BAS_FNCNAM),y
0026F6r 2  85 05                sta     TXTPTR+1
0026F8r 2                       ; Body TXTPTR is positioned at the first byte; we need it positioned
0026F8r 2                       ; one BEFORE so FrmNum's first ChrGet loads the first byte.  Decrement.
0026F8r 2  A5 04                lda     TXTPTR
0026FAr 2  D0 02                bne     @noBor
0026FCr 2  C6 05                dec     TXTPTR+1
0026FEr 2               @noBor:
0026FEr 2  C6 04                dec     TXTPTR
002700r 2                       ; Evaluate the FN expression body.
002700r 2  20 rr rr             jsr     ChrGet
002703r 2  20 rr rr             jsr     FrmNum
002706r 2                       ; Restore TXTPTR.
002706r 2  68                   pla
002707r 2  85 04                sta     TXTPTR
002709r 2  68                   pla
00270Ar 2  85 05                sta     TXTPTR+1
00270Cr 2                       ; Restore param.  VARPNT may have been clobbered; reload.
00270Cr 2  20 rr rr             jsr     @reload
00270Fr 2  A0 00                ldy     #0
002711r 2               @restp:
002711r 2  68                   pla
002712r 2  91 3F                sta     (VARPNT),y
002714r 2  C8                   iny
002715r 2  C0 05                cpy     #5
002717r 2  D0 F8                bne     @restp
002719r 2  60                   rts
00271Ar 2               @undef:
00271Ar 2  A2 03                ldx     #ERR_UNDEFSTMT
00271Cr 2  4C rr rr             jmp     BasErrorVec
00271Fr 2               ; Re-seed FNCNAM from BAS_FNPTR and VARPNT from the FN slot's param pointer.
00271Fr 2               ; Preserves FAC (touches A and Y only).
00271Fr 2               @reload:
00271Fr 2  AD 73 03             lda     BAS_FNPTR
002722r 2  85 81                sta     BAS_FNCNAM
002724r 2  AD 74 03             lda     BAS_FNPTR+1
002727r 2  85 82                sta     BAS_FNCNAM+1
002729r 2  A0 02                ldy     #2
00272Br 2  B1 81                lda     (BAS_FNCNAM),y
00272Dr 2  85 3F                sta     VARPNT
00272Fr 2  C8                   iny
002730r 2  B1 81                lda     (BAS_FNCNAM),y
002732r 2  85 40                sta     VARPNT+1
002734r 2  60                   rts
002735r 2               
002735r 2               ; ---------------------------------------------------------------------------
002735r 2               ; BasCmdDim -- DIM statement.  Dimension one or more arrays.
002735r 2               ;   On entry ChrGet has advanced past the DIM token, so A = first char of the
002735r 2               ;   first variable name.  For each name we call PtrGet2 with the from-DIM flag
002735r 2               ;   ($40) set in X; the '(' branch runs Array -> MakeNewArray, which allocates
002735r 2               ;   the array using the subscripts as sizes (0..N) and returns without looking
002735r 2               ;   up an element (DIMFLG nonzero).  Names are separated by commas.
002735r 2               ; ---------------------------------------------------------------------------
002735r 2               BasCmdDim:
002735r 2  A2 40                ldx     #$40                    ; from-DIM flag (bit 6)
002737r 2  20 rr rr             jsr     PtrGet2                 ; A = name char; create/dimension array
00273Ar 2  20 rr rr             jsr     ChrGot
00273Dr 2  C9 2C                cmp     #','
00273Fr 2  D0 05                bne     @done
002741r 2  20 rr rr             jsr     ChrGet                  ; consume comma, advance to next name
002744r 2  80 EF                bra     BasCmdDim
002746r 2               @done:
002746r 2  60                   rts
002747r 2               
002747r 2               ; ===========================================================================
002747r 2               ;   H A R D W A R E - E X T E N S I O N   S T A T E M E N T S
002747r 2               ; ===========================================================================
002747r 2               
002747r 2               ; --- Helpers --------------------------------------------------------------
002747r 2               
002747r 2               ; Raise ?NO DEVICE error.
002747r 2               NoDevErr:
002747r 2  A2 0F                ldx     #ERR_NODEV
002749r 2  4C rr rr             jmp     BasErrorVec
00274Cr 2               
00274Cr 2               ; Require A bits in HW_PRESENT (else ?NO DEVICE).
00274Cr 2               ;   Input : A = mask
00274Cr 2               ;   Output: A preserved on success
00274Cr 2               ReqHw:
00274Cr 2  2D 0D 03             and     HW_PRESENT
00274Fr 2  F0 F6                beq     NoDevErr
002751r 2  60                   rts
002752r 2               
002752r 2               ; Evaluate expression -> A in 0..255.
002752r 2               ;   On entry: ChrGot positioned at first byte of expression.
002752r 2               ;   On exit : A = byte, ChrGot returns char following expression.
002752r 2               EvalU8:
002752r 2  20 rr rr             jsr     GetByt                  ; X = byte, jmp ChrGot
002755r 2  8A                   txa
002756r 2  60                   rts
002757r 2               
002757r 2               ; Evaluate expression as 16-bit signed -> FAC+3 (hi), FAC+4 (lo).
002757r 2               EvalU16:
002757r 2  20 rr rr             jsr     FrmNum
00275Ar 2  20 rr rr             jsr     AyInt
00275Dr 2  4C rr rr             jmp     ChrGot
002760r 2               
002760r 2               ; Evaluate expression as 16-bit unsigned address (0..65535)
002760r 2               ;   -> FAC+3 (hi), FAC+4 (lo).  Used by SYS, POKE, PEEK, WAIT so the full
002760r 2               ;   6502 address space is reachable with positive decimal literals.
002760r 2               ;   Truncates fractional part.  Negative or >= 65536 raises ?ILLEGAL QUANTITY.
002760r 2               EvalAddrU16:
002760r 2  20 rr rr             jsr     FrmNum
002763r 2  20 rr rr             jsr     FacToU16
002766r 2  4C rr rr             jmp     ChrGot
002769r 2               
002769r 2               ; FacToU16 -- Convert FAC (must be 0..65535) to FAC+3 (hi), FAC+4 (lo).
002769r 2               ;   Negative or >= 65536 raises ?ILLEGAL QUANTITY.  Truncates fractional part.
002769r 2               FacToU16:
002769r 2  24 13                bit     FACSIGN
00276Br 2  30 34                bmi     @illqty
00276Dr 2  A5 0E                lda     FAC                     ; exponent byte (0 = value is zero)
00276Fr 2  F0 2B                beq     @zero
002771r 2  C9 91                cmp     #$91                    ; exp >= $91 means value >= 65536
002773r 2  B0 2C                bcs     @illqty
002775r 2                       ; Reconstruct top 16 bits of mantissa (with hidden 1 bit).
002775r 2  48                   pha                             ; save exponent byte
002776r 2  A5 0F                lda     FAC+1
002778r 2  09 80                ora     #$80                    ; restore hidden bit
00277Ar 2  85 3B                sta     BAS_TMP1+1              ; hi
00277Cr 2  A5 10                lda     FAC+2
00277Er 2  85 3A                sta     BAS_TMP1                ; lo
002780r 2                       ; Shift count = $90 - exp_byte (0..15).
002780r 2  68                   pla
002781r 2  38                   sec
002782r 2  E9 90                sbc     #$90
002784r 2  49 FF                eor     #$FF
002786r 2  18                   clc
002787r 2  69 01                adc     #1                      ; A = $90 - exp
002789r 2  F0 08                beq     @store                  ; zero shifts: already aligned
00278Br 2  AA                   tax
00278Cr 2               @shloop:
00278Cr 2  46 3B                lsr     BAS_TMP1+1
00278Er 2  66 3A                ror     BAS_TMP1
002790r 2  CA                   dex
002791r 2  D0 F9                bne     @shloop
002793r 2               @store:
002793r 2  A5 3B                lda     BAS_TMP1+1
002795r 2  85 11                sta     FAC+3
002797r 2  A5 3A                lda     BAS_TMP1
002799r 2  85 12                sta     FAC+4
00279Br 2  60                   rts
00279Cr 2               @zero:
00279Cr 2  64 11                stz     FAC+3
00279Er 2  64 12                stz     FAC+4
0027A0r 2  60                   rts
0027A1r 2               @illqty:
0027A1r 2  4C rr rr             jmp     IqErr
0027A4r 2               
0027A4r 2               ; Evaluate string expression -> copy up to 12 chars to BAS_FNAME,
0027A4r 2               ; null-terminate, set STR_PTR := BAS_FNAME, free temp string.
0027A4r 2               ; 12 = full 8.3 form ("NAME.EXT" = 8 name + '.' + 3 ext).
0027A4r 2               EvalString:
0027A4r 2  20 rr rr             jsr     FrmEvl
0027A7r 2  20 rr rr             jsr     ChkStr
0027AAr 2  A5 0F                lda     FAC+1
0027ACr 2  85 20                sta     INDEX
0027AEr 2  A5 10                lda     FAC+2
0027B0r 2  85 21                sta     INDEX+1
0027B2r 2  A0 00                ldy     #0
0027B4r 2  A6 0E                ldx     FAC                     ; length
0027B6r 2               @cpy:
0027B6r 2  C0 0C                cpy     #12
0027B8r 2  F0 0D                beq     @done
0027BAr 2  E0 00                cpx     #0
0027BCr 2  F0 09                beq     @done
0027BEr 2  B1 20                lda     (INDEX),y
0027C0r 2  99 81 03             sta     BAS_FNAME,y
0027C3r 2  C8                   iny
0027C4r 2  CA                   dex
0027C5r 2  80 EF                bra     @cpy
0027C7r 2               @done:
0027C7r 2  A9 00                lda     #0
0027C9r 2  99 81 03             sta     BAS_FNAME,y
0027CCr 2  A9 81                lda     #<BAS_FNAME
0027CEr 2  85 02                sta     STR_PTR
0027D0r 2  A9 03                lda     #>BAS_FNAME
0027D2r 2  85 03                sta     STR_PTR+1
0027D4r 2  4C rr rr             jmp     FreFac
0027D7r 2               
0027D7r 2               ; Print A as 2-digit decimal with leading zero (used by TIME/DATE).
0027D7r 2               BasPr2D:
