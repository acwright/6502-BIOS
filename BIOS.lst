0017F8r 2               ; (Removed in Phase 8: _VARTEST debug harness lived here.)
0017F8r 2               VT_SetTxt:
0017F8r 2                       ; Set TXTPTR = VT_TXTPTR_TMP - 1 then ChrGet to load first char.
0017F8r 2                       ; Actually simpler: caller passes (Y,A) = pointer; we set TXTPTR =
0017F8r 2                       ; (Y,A) - 1 and call ChrGet to land on (Y,A).
0017F8r 2                       sta     TXTPTR
0017F8r 2                       sty     TXTPTR+1
0017F8r 2                       lda     TXTPTR
0017F8r 2                       bne     @nb
0017F8r 2                       dec     TXTPTR+1
0017F8r 2               @nb:
0017F8r 2                       dec     TXTPTR
0017F8r 2                       jmp     ChrGet
0017F8r 2               
0017F8r 2               VT_StoreFAC:
0017F8r 2                       ; Round and store FAC at (VARPNT).
0017F8r 2                       ldx     VARPNT
0017F8r 2                       ldy     VARPNT+1
0017F8r 2                       jmp     StoreFacAtYxRounded
0017F8r 2               
0017F8r 2               VT_LoadFAC:
0017F8r 2                       ; Load FAC from (VARPNT).
0017F8r 2                       lda     VARPNT
0017F8r 2                       ldy     VARPNT+1
0017F8r 2                       jmp     LoadFacFromYa
0017F8r 2               
0017F8r 2               VT_VPSAVE       = $86           ; 2-byte ZP VARPNT save (_VARTEST debug)
0017F8r 2               
0017F8r 2               BasCmdVarTest:
0017F8r 2                       jsr     BasCmdClr
0017F8r 2               
0017F8r 2                       ; --- Test 1: A=3.14, B=A*2 ---
0017F8r 2                       lda     #<VT_NameA
0017F8r 2                       ldy     #>VT_NameA
0017F8r 2                       jsr     VT_SetTxt
0017F8r 2                       jsr     PtrGet                  ; creates A; VARPNT -> A's value
0017F8r 2                       ; FAC = 3.14
0017F8r 2                       lda     #<VT_pi
0017F8r 2                       ldy     #>VT_pi
0017F8r 2                       jsr     LoadFacFromYa
0017F8r 2                       jsr     VT_StoreFAC
0017F8r 2               
0017F8r 2                       lda     #<VT_NameB
0017F8r 2                       ldy     #>VT_NameB
0017F8r 2                       jsr     VT_SetTxt
0017F8r 2                       jsr     PtrGet                  ; creates B
0017F8r 2                       ; Save B's VARPNT.
0017F8r 2                       lda     VARPNT
0017F8r 2                       sta     VT_VPSAVE
0017F8r 2                       lda     VARPNT+1
0017F8r 2                       sta     VT_VPSAVE+1
0017F8r 2               
0017F8r 2                       ; Look up A again (already exists).
0017F8r 2                       lda     #<VT_NameA
0017F8r 2                       ldy     #>VT_NameA
0017F8r 2                       jsr     VT_SetTxt
0017F8r 2                       jsr     PtrGet
0017F8r 2                       jsr     VT_LoadFAC              ; FAC = A = 3.14
0017F8r 2                       ; Multiply by 2.
0017F8r 2                       lda     #<FpC2
0017F8r 2                       ldy     #>FpC2
0017F8r 2                       jsr     FMult                   ; FAC = 2 * FAC = 6.28
0017F8r 2                       ; Store into B.
0017F8r 2                       ldx     VT_VPSAVE
0017F8r 2                       ldy     VT_VPSAVE+1
0017F8r 2                       jsr     StoreFacAtYxRounded
0017F8r 2               
0017F8r 2                       ; Print result.
0017F8r 2                       lda     #<MsgVT_A
0017F8r 2                       ldy     #>MsgVT_A
0017F8r 2                       jsr     BasPrintStr
0017F8r 2                       ; Reload B and print.
0017F8r 2                       lda     VT_VPSAVE
0017F8r 2                       ldy     VT_VPSAVE+1
0017F8r 2                       jsr     LoadFacFromYa
0017F8r 2                       jsr     BasPrintFAC
0017F8r 2                       jsr     BasPrintCRLF
0017F8r 2               
0017F8r 2                       ; --- Test 2: A$="HELLO" ---
0017F8r 2                       lda     #<VT_NameAS
0017F8r 2                       ldy     #>VT_NameAS
0017F8r 2                       jsr     VT_SetTxt
0017F8r 2                       jsr     PtrGet                  ; creates A$
0017F8r 2                       ; Save VARPNT (A$ descriptor address).
0017F8r 2                       lda     VARPNT
0017F8r 2                       sta     VT_VPSAVE
0017F8r 2                       lda     VARPNT+1
0017F8r 2                       sta     VT_VPSAVE+1
0017F8r 2                       ; Allocate space, copy "HELLO" via StrLit.
0017F8r 2                       lda     #<VT_HelloLit
0017F8r 2                       ldy     #>VT_HelloLit
0017F8r 2                       jsr     StrLit                  ; FAC has descriptor, in temp stack
0017F8r 2                       ; Now copy descriptor (3 bytes from temp stack entry) to A$ var.
0017F8r 2                       ; FAC+3,4 points at the temp descriptor; FAC = length, FAC+1/2 = addr.
0017F8r 2                       ; The descriptor lives in TEMPST.  We just write [len][lo][hi] into
0017F8r 2                       ; (VARPNT) so the variable now references the heap copy.
0017F8r 2                       lda     FAC
0017F8r 2                       ldy     #$00
0017F8r 2                       sta     (VT_VPSAVE),y           ; length
0017F8r 2                       lda     FAC+1
0017F8r 2                       iny
0017F8r 2                       sta     (VT_VPSAVE),y           ; addr lo
0017F8r 2                       lda     FAC+2
0017F8r 2                       iny
0017F8r 2                       sta     (VT_VPSAVE),y           ; addr hi
0017F8r 2                       ; Print length.
0017F8r 2                       lda     #<MsgVT_AS
0017F8r 2                       ldy     #>MsgVT_AS
0017F8r 2                       jsr     BasPrintStr
0017F8r 2                       ldy     #$00
0017F8r 2                       lda     (VT_VPSAVE),y
0017F8r 2                       tay
0017F8r 2                       jsr     SngFlt
0017F8r 2                       jsr     BasPrintFAC
0017F8r 2                       jsr     BasPrintCRLF
0017F8r 2               
0017F8r 2                       ; --- Test 3: DIM N(10), N(5)=42 ---
0017F8r 2                       ; Build TXTPTR pointing at "N(10) " and call MakInt-equivalent path.
0017F8r 2                       ; Easier: directly construct array via PtrGet3 + Array by simulating
0017F8r 2                       ; a 1-D DIM of size 11 (indices 0..10).  We emulate the parser:
0017F8r 2                       ;   1. Set DIMFLG = $40, VARNAM = ('N','N'), call PtrGet3 with X=1?
0017F8r 2                       ;   2. Or: just do PtrGet3 entry by hand then jmp Array.
0017F8r 2                       ; Simplest: set TXTPTR at "N(10) ", DIMFLG <- $40 (from DIM
0017F8r 2                       ; statement), then PtrGet3 with VARNAM letter, jmp to '(' branch.
0017F8r 2                       lda     #<VT_DimN10
0017F8r 2                       ldy     #>VT_DimN10
0017F8r 2                       jsr     VT_SetTxt               ; A = 'N'
0017F8r 2                       ldx     #$40                    ; from-DIM flag (bit 6)
0017F8r 2                       jsr     PtrGet2                 ; will hit '(' -> Array -> create
0017F8r 2                       ; Now N(5)=42.  Re-parse "N(5)" to find element.
0017F8r 2                       lda     #<VT_DimN5
0017F8r 2                       ldy     #>VT_DimN5
0017F8r 2                       jsr     VT_SetTxt
0017F8r 2                       jsr     PtrGet                  ; element address in VARPNT
0017F8r 2                       ; Save VARPNT.
0017F8r 2                       lda     VARPNT
0017F8r 2                       sta     VT_VPSAVE
0017F8r 2                       lda     VARPNT+1
0017F8r 2                       sta     VT_VPSAVE+1
0017F8r 2                       ; FAC = 42.
0017F8r 2                       lda     #<Vt42
0017F8r 2                       ldy     #>Vt42
0017F8r 2                       jsr     LoadFacFromYa
0017F8r 2                       ldx     VT_VPSAVE
0017F8r 2                       ldy     VT_VPSAVE+1
0017F8r 2                       jsr     StoreFacAtYxRounded
0017F8r 2                       ; Read it back and print.
0017F8r 2                       lda     #<MsgVT_NewArr
0017F8r 2                       ldy     #>MsgVT_NewArr
0017F8r 2                       jsr     BasPrintStr
0017F8r 2                       lda     VT_VPSAVE
0017F8r 2                       ldy     VT_VPSAVE+1
0017F8r 2                       jsr     LoadFacFromYa
0017F8r 2                       jsr     BasPrintFAC
0017F8r 2                       jsr     BasPrintCRLF
0017F8r 2               
0017F8r 2                       ; --- Test 4: 8 string allocations + GC ---
0017F8r 2                       ldx     #8
0017F8r 2               @galloc:
0017F8r 2                       phx
0017F8r 2                       lda     #16
0017F8r 2                       jsr     StrSpa                  ; consumes 16 bytes; FAC has descriptor
0017F8r 2                       plx
0017F8r 2                       dex
0017F8r 2                       bne     @galloc
0017F8r 2                       ; Force GC (TEMPPT got bumped by StrSpa-via-StrIni? StrSpa itself
0017F8r 2                       ; doesn't call PutNew, so temp stack untouched here.)
0017F8r 2                       jsr     Garbag
0017F8r 2                       lda     #<MsgVT_GC
0017F8r 2                       ldy     #>MsgVT_GC
0017F8r 2                       jsr     BasPrintStr
0017F8r 2                       lda     FRETOP+1
0017F8r 2                       ldy     FRETOP
0017F8r 2                       jsr     GivAyf
0017F8r 2                       jsr     BasPrintFAC
0017F8r 2                       jsr     BasPrintCRLF
0017F8r 2               
0017F8r 2                       rts
0017F8r 2               .endif
0017F8r 2               
0017F8r 2               ; =============================================================================
0017F8r 2               ;   E X P R E S S I O N   E V A L U A T O R
0017F8r 2               ;
0017F8r 2               ;   Recursive-descent precedence climber.  Operates on tokenized text at
0017F8r 2               ;   TXTPTR (advanced via ChrGet/ChrGot).  Result lands in FAC (numeric)
0017F8r 2               ;   or as a 3-byte string descriptor at FAC..FAC+2 (string).  VALTYP
0017F8r 2               ;   selects: $00 = numeric, $FF = string.
0017F8r 2               ;
0017F8r 2               ;   Precedence (lowest -> highest):
0017F8r 2               ;     OR
0017F8r 2               ;     AND
0017F8r 2               ;     NOT  (right-assoc unary)
0017F8r 2               ;     comparison (= <> < > <= >=)
0017F8r 2               ;     + -
0017F8r 2               ;     * /
0017F8r 2               ;     ^    (right-assoc)
0017F8r 2               ;     unary -, unary +
0017F8r 2               ;     atom: number, variable, string-literal, "(" expr ")", function call
0017F8r 2               ; =============================================================================
0017F8r 2               
0017F8r 2               ; ---------------------------------------------------------------------------
0017F8r 2               ; ZP scratch used only during expression evaluation.
0017F8r 2               ;   BAS_LVTYP = saved VALTYP of left operand around binary ops
0017F8r 2               ; ---------------------------------------------------------------------------
0017F8r 2               BAS_LVTYP       := $86
0017F8r 2               
0017F8r 2               ; ---------------------------------------------------------------------------
0017F8r 2               ; FrmEvl -- top-level entry.  TXTPTR positioned so ChrGot returns the first
0017F8r 2               ; byte of the expression.  On exit TXTPTR is at the first byte AFTER the
0017F8r 2               ; expression.  Result in FAC + VALTYP.
0017F8r 2               ; ---------------------------------------------------------------------------
0017F8r 2               FrmEvl:
0017F8r 2  4C rr rr             jmp     EvalOr
0017FBr 2               
0017FBr 2               ; ---------------------------------------------------------------------------
0017FBr 2               ; PushFac -- push the current FAC + VALTYP onto the CPU stack (8 bytes).
0017FBr 2               ; Order pushed: VALTYP, FAC, FAC+1, FAC+2, FAC+3, FAC+4, FACSIGN, FACEXTENSION
0017FBr 2               ; (FACEXTENSION pushed last so it's pulled first by PullArg.)
0017FBr 2               ; Preserves the return address.
0017FBr 2               ; ---------------------------------------------------------------------------
0017FBr 2               PushFac:
0017FBr 2  68                   pla
0017FCr 2  A8                   tay                             ; Y = ret-addr lo
0017FDr 2  68                   pla
0017FEr 2  AA                   tax                             ; X = ret-addr hi
0017FFr 2  A5 64                lda     VALTYP
001801r 2  48                   pha
001802r 2  A5 0E                lda     FAC
001804r 2  48                   pha
001805r 2  A5 0F                lda     FAC+1
001807r 2  48                   pha
001808r 2  A5 10                lda     FAC+2
00180Ar 2  48                   pha
00180Br 2  A5 11                lda     FAC+3
00180Dr 2  48                   pha
00180Er 2  A5 12                lda     FAC+4
001810r 2  48                   pha
001811r 2  A5 13                lda     FACSIGN
001813r 2  48                   pha
001814r 2  A5 1D                lda     FACEXTENSION
001816r 2  48                   pha
001817r 2  8A                   txa
001818r 2  48                   pha
001819r 2  98                   tya
00181Ar 2  48                   pha
00181Br 2  60                   rts
00181Cr 2               
00181Cr 2               ; ---------------------------------------------------------------------------
00181Cr 2               ; PullArg -- pop the previously-pushed FAC into ARG (signed FP value or
00181Cr 2               ; string descriptor in ARG..ARG+2/sign).  Sets BAS_LVTYP to the saved
00181Cr 2               ; left-operand VALTYP.  Preserves return address.
00181Cr 2               ; ---------------------------------------------------------------------------
00181Cr 2               PullArg:
00181Cr 2  68                   pla
00181Dr 2  A8                   tay                             ; Y = ret-addr lo
00181Er 2  68                   pla
00181Fr 2  AA                   tax                             ; X = ret-addr hi
001820r 2  68                   pla
001821r 2  85 43                sta     ARGEXTENSION
001823r 2  68                   pla
001824r 2  85 1B                sta     ARGSIGN
001826r 2  68                   pla
001827r 2  85 1A                sta     ARG+4
001829r 2  68                   pla
00182Ar 2  85 19                sta     ARG+3
00182Cr 2  68                   pla
00182Dr 2  85 18                sta     ARG+2
00182Fr 2  68                   pla
001830r 2  85 17                sta     ARG+1
001832r 2  68                   pla
001833r 2  85 16                sta     ARG
001835r 2  68                   pla
001836r 2  85 86                sta     BAS_LVTYP
001838r 2  8A                   txa
001839r 2  48                   pha
00183Ar 2  98                   tya
00183Br 2  48                   pha
00183Cr 2  60                   rts
00183Dr 2               
00183Dr 2               ; ---------------------------------------------------------------------------
00183Dr 2               ; PullFac -- pop pushed FAC back into FAC (used to discard right side and
00183Dr 2               ; restore left, e.g. unused).
00183Dr 2               ; ---------------------------------------------------------------------------
00183Dr 2               PullFac:
00183Dr 2  68                   pla
00183Er 2  A8                   tay
00183Fr 2  68                   pla
001840r 2  AA                   tax
001841r 2  68                   pla
001842r 2  85 1D                sta     FACEXTENSION
001844r 2  68                   pla
001845r 2  85 13                sta     FACSIGN
001847r 2  68                   pla
001848r 2  85 12                sta     FAC+4
00184Ar 2  68                   pla
00184Br 2  85 11                sta     FAC+3
00184Dr 2  68                   pla
00184Er 2  85 10                sta     FAC+2
001850r 2  68                   pla
001851r 2  85 0F                sta     FAC+1
001853r 2  68                   pla
001854r 2  85 0E                sta     FAC
001856r 2  68                   pla
001857r 2  85 64                sta     VALTYP
001859r 2  8A                   txa
00185Ar 2  48                   pha
00185Br 2  98                   tya
00185Cr 2  48                   pha
00185Dr 2  60                   rts
00185Er 2               
00185Er 2               ; ---------------------------------------------------------------------------
00185Er 2               ; TypeMismatch helper.
00185Er 2               ; ---------------------------------------------------------------------------
00185Er 2               EvalTypeErr:
00185Er 2  A2 08                ldx     #ERR_TYPEMISM
001860r 2  4C rr rr             jmp     BasErrorVec
001863r 2               
001863r 2               ; ===========================================================================
001863r 2               ;   L E V E L 0  --  O R
001863r 2               ; ===========================================================================
001863r 2               EvalOr:
001863r 2  20 rr rr             jsr     EvalAnd
001866r 2               @loop:
001866r 2  20 rr rr             jsr     ChrGot
001869r 2  C9 A3                cmp     #TOK_OR
00186Br 2  D0 17                bne     @done
00186Dr 2  20 rr rr             jsr     ChkNum                  ; left must be numeric
001870r 2  20 rr rr             jsr     ChrGet                  ; consume OR
001873r 2  20 rr rr             jsr     PushFac
001876r 2  20 rr rr             jsr     EvalAnd
001879r 2  20 rr rr             jsr     ChkNum                  ; right must be numeric
00187Cr 2  20 rr rr             jsr     PullArg
00187Fr 2  20 rr rr             jsr     OrOp
001882r 2  80 E2                bra     @loop
001884r 2               @done:
001884r 2  60                   rts
001885r 2               
001885r 2               ; ===========================================================================
001885r 2               ;   L E V E L 1  --  A N D
001885r 2               ; ===========================================================================
001885r 2               EvalAnd:
001885r 2  20 rr rr             jsr     EvalNot
001888r 2               @loop:
001888r 2  20 rr rr             jsr     ChrGot
00188Br 2  C9 A2                cmp     #TOK_AND
00188Dr 2  D0 17                bne     @done
00188Fr 2  20 rr rr             jsr     ChkNum
001892r 2  20 rr rr             jsr     ChrGet
001895r 2  20 rr rr             jsr     PushFac
001898r 2  20 rr rr             jsr     EvalNot
00189Br 2  20 rr rr             jsr     ChkNum
00189Er 2  20 rr rr             jsr     PullArg
0018A1r 2  20 rr rr             jsr     AndOp
0018A4r 2  80 E2                bra     @loop
0018A6r 2               @done:
0018A6r 2  60                   rts
0018A7r 2               
0018A7r 2               ; ===========================================================================
0018A7r 2               ;   L E V E L 2  --  N O T   (right-assoc unary prefix)
0018A7r 2               ; ===========================================================================
0018A7r 2               EvalNot:
0018A7r 2  20 rr rr             jsr     ChrGot
0018AAr 2  C9 A0                cmp     #TOK_NOT
0018ACr 2  D0 0C                bne     EvalCmp
0018AEr 2  20 rr rr             jsr     ChrGet
0018B1r 2  20 rr rr             jsr     EvalNot
0018B4r 2  20 rr rr             jsr     ChkNum
0018B7r 2  4C rr rr             jmp     NotOp
0018BAr 2               
0018BAr 2               ; ===========================================================================
0018BAr 2               ;   L E V E L 3  --  C O M P A R I S O N
0018BAr 2               ;   Reads up to two of {<, =, >} forming a relop; if none, no-op.
0018BAr 2               ;   Mask:  bit 0 = '>' present, bit 1 = '=' present, bit 2 = '<' present
0018BAr 2               ; ===========================================================================
0018BAr 2               EvalCmp:
0018BAr 2  20 rr rr             jsr     EvalAdd
0018BDr 2  A2 00                ldx     #0                      ; relop mask
0018BFr 2               @scan:
0018BFr 2  20 rr rr             jsr     ChrGot
0018C2r 2  C9 3D                cmp     #'='
0018C4r 2  F0 0A                beq     @gotEq
0018C6r 2  C9 3C                cmp     #'<'
0018C8r 2  F0 0A                beq     @gotLt
0018CAr 2  C9 3E                cmp     #'>'
0018CCr 2  F0 0A                beq     @gotGt
0018CEr 2  80 1D                bra     @done
0018D0r 2               @gotEq:
0018D0r 2  A0 02                ldy     #2
0018D2r 2  80 06                bra     @setbit
0018D4r 2               @gotLt:
0018D4r 2  A0 04                ldy     #4
0018D6r 2  80 02                bra     @setbit
0018D8r 2               @gotGt:
0018D8r 2  A0 01                ldy     #1
0018DAr 2               @setbit:
0018DAr 2  84 45                sty     CPRMASK                 ; reuse as scratch
0018DCr 2  8A                   txa
0018DDr 2  25 45                and     CPRMASK
0018DFr 2  D0 09                bne     @synErr                 ; same char twice (e.g. "==")
0018E1r 2  8A                   txa
0018E2r 2  05 45                ora     CPRMASK
0018E4r 2  AA                   tax
0018E5r 2  20 rr rr             jsr     ChrGet
0018E8r 2  80 D5                bra     @scan
0018EAr 2               @synErr:
0018EAr 2  4C rr rr             jmp     SynErr
0018EDr 2               @done:
0018EDr 2  E0 00                cpx     #0
0018EFr 2  D0 01                bne     @doCmp
0018F1r 2  60                   rts
0018F2r 2               @doCmp:
0018F2r 2  86 45                stx     CPRMASK
0018F4r 2                       ; Save left operand, evaluate right
0018F4r 2  20 rr rr             jsr     PushFac
0018F7r 2  20 rr rr             jsr     EvalAdd
0018FAr 2  20 rr rr             jsr     PullArg                 ; ARG = left, BAS_LVTYP = left's type
0018FDr 2                       ; Type compatibility check.
0018FDr 2  A5 86                lda     BAS_LVTYP
0018FFr 2  45 64                eor     VALTYP
001901r 2  10 03 4C rr          jmi     EvalTypeErr             ; one numeric, one string -> mismatch
001905r 2  rr           
001906r 2  24 64                bit     VALTYP
001908r 2  30 03                bmi     @strCmp
00190Ar 2                       ; Numeric comparison.
00190Ar 2  4C rr rr             jmp     RelOpsNum
00190Dr 2               @strCmp:
00190Dr 2  4C rr rr             jmp     RelOpsStr
001910r 2               
001910r 2               ; ---------------------------------------------------------------------------
001910r 2               ; RelOpsNum -- numeric comparison.
001910r 2               ; Inputs: ARG = left, FAC = right, CPRMASK = relop mask (bit 0=>, 1==, 2=<).
001910r 2               ; Output: FAC = -1 if (ARG <op> FAC) is true, else 0.  VALTYP = numeric.
001910r 2               ; ---------------------------------------------------------------------------
001910r 2               RelOpsNum:
001910r 2                       ; Replicate msbasic ARG-pre-relop fixup: clear ARG+1 high bit, then
001910r 2                       ; set it from ARGSIGN's MSB.  This rebuilds the implicit-1 mantissa
001910r 2                       ; for FCOMP's signed comparison path.
001910r 2  A5 1B                lda     ARGSIGN
001912r 2  09 7F                ora     #$7F
001914r 2  25 17                and     ARG+1
001916r 2  85 17                sta     ARG+1
001918r 2  A9 16                lda     #<ARG
00191Ar 2  A0 00                ldy     #$00
00191Cr 2  20 rr rr             jsr     FComp                   ; A = sign(FAC - ARG)
00191Fr 2                       ; Map A to bit position:
00191Fr 2                       ;   FAC<ARG (A=$FF): ARG>FAC  -> bit 0 (mask 1)
00191Fr 2                       ;   FAC=ARG (A=$00):           -> bit 1 (mask 2)
00191Fr 2                       ;   FAC>ARG (A=$01): ARG<FAC  -> bit 2 (mask 4)
00191Fr 2  AA                   tax
001920r 2  30 06                bmi     @lt
001922r 2  F0 08                beq     @eq
001924r 2  A9 04                lda     #4
001926r 2  80 06                bra     @check
001928r 2               @lt:
001928r 2  A9 01                lda     #1
00192Ar 2  80 02                bra     @check
00192Cr 2               @eq:
00192Cr 2  A9 02                lda     #2
00192Er 2               @check:
00192Er 2  25 45                and     CPRMASK
001930r 2  F0 07                beq     @false
001932r 2  A9 FF                lda     #$FF
001934r 2  A0 FF                ldy     #$FF
001936r 2  4C rr rr             jmp     GivAyf
001939r 2               @false:
001939r 2  A9 00                lda     #0
00193Br 2  A8                   tay
00193Cr 2  4C rr rr             jmp     GivAyf
00193Fr 2               
00193Fr 2               ; ---------------------------------------------------------------------------
00193Fr 2               ; RelOpsStr -- bytewise string comparison.
00193Fr 2               ; ARG = left descriptor (ARG=len, ARG+1=lo, ARG+2=hi, ARGSIGN, ARGEXT pushed).
00193Fr 2               ; FAC = right descriptor.  CPRMASK as above.
00193Fr 2               ; ---------------------------------------------------------------------------
00193Fr 2               RelOpsStr:
00193Fr 2                       ; INDEX = left ptr, BAS_TMP1 = right ptr, BAS_TMP2 lo = left len,
00193Fr 2                       ; BAS_TMP2 hi = right len.
00193Fr 2  A5 17                lda     ARG+1
001941r 2  85 20                sta     INDEX
001943r 2  A5 18                lda     ARG+2
001945r 2  85 21                sta     INDEX+1
001947r 2  A5 0F                lda     FAC+1
001949r 2  85 3A                sta     BAS_TMP1
00194Br 2  A5 10                lda     FAC+2
00194Dr 2  85 3B                sta     BAS_TMP1+1
00194Fr 2  A5 16                lda     ARG
001951r 2  85 3C                sta     BAS_TMP2                ; left len
001953r 2  A5 0E                lda     FAC
001955r 2  85 3D                sta     BAS_TMP2+1              ; right len
001957r 2                       ; Compare byte-by-byte up to min length.
001957r 2  A0 00                ldy     #0
001959r 2               @cmp:
001959r 2                       ; Has either side ended?
001959r 2  C4 3C                cpy     BAS_TMP2
00195Br 2  F0 17                beq     @leftEnd
00195Dr 2  C4 3D                cpy     BAS_TMP2+1
00195Fr 2  F0 1B                beq     @rightEnd               ; right ended first -> left > right
001961r 2  B1 20                lda     (INDEX),y
001963r 2  D1 3A                cmp     (BAS_TMP1),y
001965r 2  F0 0A                beq     @next
001967r 2  90 04                bcc     @lt                     ; left < right
001969r 2                       ; left > right
001969r 2  A9 01                lda     #1
00196Br 2  80 15                bra     @decide
00196Dr 2               @lt:
00196Dr 2  A9 04                lda     #4
00196Fr 2  80 11                bra     @decide
001971r 2               @next:
001971r 2  C8                   iny
001972r 2  80 E5                bra     @cmp
001974r 2               @leftEnd:
001974r 2                       ; Left ran out; check right
001974r 2  C4 3D                cpy     BAS_TMP2+1
001976r 2  F0 08                beq     @equal
001978r 2                       ; left < right (left is prefix)
001978r 2  A9 04                lda     #4
00197Ar 2  80 06                bra     @decide
00197Cr 2               @rightEnd:
00197Cr 2                       ; right ran out, left has more; left > right
00197Cr 2  A9 01                lda     #1
00197Er 2  80 02                bra     @decide
001980r 2               @equal:
001980r 2  A9 02                lda     #2
001982r 2               @decide:
001982r 2  25 45                and     CPRMASK
001984r 2  F0 05                beq     @false
001986r 2  A9 FF                lda     #$FF
001988r 2  A8                   tay
001989r 2  80 03                bra     @ret
00198Br 2               @false:
00198Br 2  A9 00                lda     #0
00198Dr 2  A8                   tay
00198Er 2               @ret:
00198Er 2                       ; Free temp strings before returning.  Save A,Y first.
00198Er 2  48                   pha
00198Fr 2  5A                   phy
001990r 2                       ; Free FAC's temp string (right operand).
001990r 2  24 64                bit     VALTYP
001992r 2  10 03                bpl     @noFreeR
001994r 2  20 rr rr             jsr     FreFac
001997r 2               @noFreeR:
001997r 2                       ; Free ARG's temp string (left operand): manually restore VALTYP=$FF
001997r 2                       ; and FAC := ARG, then FreFac.  (We don't always know if ARG is a
001997r 2                       ; temp; FreTms inside FreTmp checks.)
001997r 2  A5 16                lda     ARG
001999r 2  85 0E                sta     FAC
00199Br 2  A5 17                lda     ARG+1
00199Dr 2  85 0F                sta     FAC+1
00199Fr 2  A5 18                lda     ARG+2
0019A1r 2  85 10                sta     FAC+2
0019A3r 2                       ; +3/+4 are the descriptor's own address, which is what FreFac frees
0019A3r 2                       ; by -- copying only the len/lo/hi above left FreFac looking at the
0019A3r 2                       ; right operand's slot, already popped, so it never matched LASTPT and
0019A3r 2                       ; the left temp was never reclaimed.  PushFac/PullArg carry these two
0019A3r 2                       ; bytes through for exactly this.  One leaked slot per comparison, and
0019A3r 2                       ; the third string compare in a program hit ?FORMULA TOO COMPLEX.
0019A3r 2  A5 19                lda     ARG+3
0019A5r 2  85 11                sta     FAC+3
0019A7r 2  A5 1A                lda     ARG+4
0019A9r 2  85 12                sta     FAC+4
0019ABr 2  A9 FF                lda     #$FF
0019ADr 2  85 64                sta     VALTYP
0019AFr 2  20 rr rr             jsr     FreFac
0019B2r 2  7A                   ply
0019B3r 2  68                   pla
0019B4r 2  4C rr rr             jmp     GivAyf
0019B7r 2               
0019B7r 2               ; ===========================================================================
0019B7r 2               ;   L E V E L 4  --  + / -
0019B7r 2               ; ===========================================================================
0019B7r 2               EvalAdd:
0019B7r 2  20 rr rr             jsr     EvalMul
0019BAr 2               @loop:
0019BAr 2  20 rr rr             jsr     ChrGot
0019BDr 2  C9 2B                cmp     #'+'
0019BFr 2  F0 05                beq     @plus
0019C1r 2  C9 2D                cmp     #'-'
0019C3r 2  F0 27                beq     @minus
0019C5r 2  60                   rts
0019C6r 2               @plus:
0019C6r 2  20 rr rr             jsr     ChrGet
0019C9r 2  20 rr rr             jsr     PushFac
0019CCr 2  20 rr rr             jsr     EvalMul
0019CFr 2  20 rr rr             jsr     PullArg
0019D2r 2                       ; Type dispatch.
0019D2r 2  A5 86                lda     BAS_LVTYP
0019D4r 2  45 64                eor     VALTYP
0019D6r 2  10 03 4C rr          jmi     EvalTypeErr
0019DAr 2  rr           
0019DBr 2  24 64                bit     VALTYP
0019DDr 2  30 28                bmi     @cat
0019DFr 2                       ; numeric add: FAC = ARG + FAC
0019DFr 2                       ; FAddT expects: ARG is the operand, A=FAC's exponent on entry.
0019DFr 2                       ; Use entry "FAddT" preceded by sign work: msbasic does
0019DFr 2                       ;   bne <continue>; jmp CopyArgToFac
0019DFr 2                       ; But our FAddT entry already handles that.  We need to set
0019DFr 2                       ; SGNCPR = ARGSIGN ^ FACSIGN before FAddT.
0019DFr 2  A5 1B                lda     ARGSIGN
0019E1r 2  45 13                eor     FACSIGN
0019E3r 2  85 1C                sta     SGNCPR
0019E5r 2  A5 0E                lda     FAC
0019E7r 2  20 rr rr             jsr     FAddT
0019EAr 2  80 CE                bra     @loop
0019ECr 2               @minus:
0019ECr 2  20 rr rr             jsr     ChrGet
0019EFr 2  20 rr rr             jsr     PushFac
0019F2r 2  20 rr rr             jsr     EvalMul
0019F5r 2  20 rr rr             jsr     ChkNum
0019F8r 2                       ; left was pushed; check pushed type via TOS-byte? Easier: we already
0019F8r 2                       ; verified left is numeric on first iteration.  But left might have
0019F8r 2                       ; been a string from concatenation; require numeric here:
0019F8r 2  20 rr rr             jsr     PullArg
0019FBr 2  A5 86                lda     BAS_LVTYP
0019FDr 2  10 03 4C rr          jmi     EvalTypeErr
001A01r 2  rr           
001A02r 2                       ; FAC = ARG - FAC
001A02r 2                       ; FSubT does: FACSIGN ^= $FF; SGNCPR = FACSIGN^ARGSIGN; jmp FAddT
001A02r 2                       ; We need to call FSubT directly.
001A02r 2  20 rr rr             jsr     FSubT
001A05r 2  80 B3                bra     @loop
001A07r 2               @cat:
001A07r 2  20 rr rr             jsr     CatStr
001A0Ar 2  80 AE                bra     @loop
001A0Cr 2               
001A0Cr 2               ; ---------------------------------------------------------------------------
001A0Cr 2               ; CatStr -- concatenate ARG (left) + FAC (right), result in FAC.
001A0Cr 2               ; ---------------------------------------------------------------------------
001A0Cr 2               CatStr:
001A0Cr 2                       ; Stash right's length+addr before we overwrite FAC.
001A0Cr 2  A5 0E                lda     FAC
001A0Er 2  85 4D                sta     BAS_TEMP1               ; right len
001A10r 2  A5 0F                lda     FAC+1
001A12r 2  85 4E                sta     BAS_TEMP1+1
001A14r 2  A5 10                lda     FAC+2
001A16r 2  85 4F                sta     BAS_TEMP1+2
001A18r 2                       ; Total length = ARG + FAC; abort if > 255.
001A18r 2  18                   clc
001A19r 2  A5 16                lda     ARG
001A1Br 2  65 4D                adc     BAS_TEMP1
001A1Dr 2  B0 40                bcs     @tooLong
001A1Fr 2  85 50                sta     BAS_TEMP1+3             ; total length
001A21r 2                       ; Free both source temps before allocating result -- otherwise we
001A21r 2                       ; pile up to 3 temps and the next PutNew throws ?FRMCPX.
001A21r 2  20 rr rr             jsr     FreeBothTemps
001A24r 2                       ; Allocate.
001A24r 2  A5 50                lda     BAS_TEMP1+3             ; total length
001A26r 2  20 rr rr             jsr     GetSpa                  ; A=total, FRESPC=buf
001A29r 2                       ; Copy left bytes (ARG -> FRESPC).
001A29r 2  A5 17                lda     ARG+1
001A2Br 2  85 20                sta     INDEX
001A2Dr 2  A5 18                lda     ARG+2
001A2Fr 2  85 21                sta     INDEX+1
001A31r 2  A5 16                lda     ARG
001A33r 2  F0 03                beq     @right
001A35r 2  20 rr rr             jsr     MovStr1                 ; advances FRESPC by len
001A38r 2               @right:
001A38r 2                       ; Copy right bytes.
001A38r 2  A5 4E                lda     BAS_TEMP1+1
001A3Ar 2  85 20                sta     INDEX
001A3Cr 2  A5 4F                lda     BAS_TEMP1+2
001A3Er 2  85 21                sta     INDEX+1
001A40r 2  A5 4D                lda     BAS_TEMP1
001A42r 2  F0 03                beq     @desc
001A44r 2  20 rr rr             jsr     MovStr1
001A47r 2               @desc:
001A47r 2                       ; Descriptor: FAC := total len, FAC+1/2 := FRESPC - total.
001A47r 2  A5 50                lda     BAS_TEMP1+3
001A49r 2  85 0E                sta     FAC
001A4Br 2  38                   sec
001A4Cr 2  A5 84                lda     FRESPC
001A4Er 2  E5 50                sbc     BAS_TEMP1+3
001A50r 2  85 0F                sta     FAC+1
001A52r 2  A5 85                lda     FRESPC+1
001A54r 2  E9 00                sbc     #0
001A56r 2  85 10                sta     FAC+2
001A58r 2  A9 FF                lda     #$FF
001A5Ar 2  85 64                sta     VALTYP
001A5Cr 2  4C rr rr             jmp     PutNew
001A5Fr 2               @tooLong:
001A5Fr 2  A2 09                ldx     #ERR_STRLONG
001A61r 2  4C rr rr             jmp     BasErrorVec
001A64r 2               
001A64r 2               ; ===========================================================================
001A64r 2               ;   L E V E L 5  --  * / /
001A64r 2               ; ===========================================================================
001A64r 2               EvalMul:
001A64r 2  20 rr rr             jsr     EvalPow
001A67r 2               @loop:
001A67r 2  20 rr rr             jsr     ChrGot
001A6Ar 2  C9 2A                cmp     #'*'
001A6Cr 2  F0 05                beq     @mul
001A6Er 2  C9 2F                cmp     #'/'
001A70r 2  F0 27                beq     @div
001A72r 2  60                   rts
001A73r 2               @mul:
001A73r 2  20 rr rr             jsr     ChkNum
001A76r 2  20 rr rr             jsr     ChrGet
001A79r 2  20 rr rr             jsr     PushFac
001A7Cr 2  20 rr rr             jsr     EvalPow
001A7Fr 2  20 rr rr             jsr     ChkNum
001A82r 2  20 rr rr             jsr     PullArg
001A85r 2  A5 86                lda     BAS_LVTYP
001A87r 2  10 03 4C rr          jmi     EvalTypeErr
001A8Br 2  rr           
001A8Cr 2                       ; FAC = ARG * FAC: FMultT expects ARG + sign work.  See msbasic.
001A8Cr 2  A5 1B                lda     ARGSIGN
001A8Er 2  45 13                eor     FACSIGN
001A90r 2  85 1C                sta     SGNCPR
001A92r 2  A5 0E                lda     FAC
001A94r 2  20 rr rr             jsr     FMultT
001A97r 2  80 CE                bra     @loop
001A99r 2               @div:
001A99r 2  20 rr rr             jsr     ChkNum
001A9Cr 2  20 rr rr             jsr     ChrGet
001A9Fr 2  20 rr rr             jsr     PushFac
001AA2r 2  20 rr rr             jsr     EvalPow
001AA5r 2  20 rr rr             jsr     ChkNum
001AA8r 2  20 rr rr             jsr     PullArg
001AABr 2  A5 86                lda     BAS_LVTYP
001AADr 2  10 03 4C rr          jmi     EvalTypeErr
001AB1r 2  rr           
001AB2r 2                       ; FAC = ARG / FAC: FDivT.
001AB2r 2  A5 1B                lda     ARGSIGN
001AB4r 2  45 13                eor     FACSIGN
001AB6r 2  85 1C                sta     SGNCPR
001AB8r 2  A5 0E                lda     FAC
001ABAr 2  20 rr rr             jsr     FDivT
001ABDr 2  80 A8                bra     @loop
001ABFr 2               
001ABFr 2               ; ===========================================================================
001ABFr 2               ;   L E V E L 6  --  ^   (right-associative)
001ABFr 2               ; ===========================================================================
001ABFr 2               EvalPow:
001ABFr 2  20 rr rr             jsr     EvalUnary
001AC2r 2               @loop:
001AC2r 2  20 rr rr             jsr     ChrGot
001AC5r 2  C9 5E                cmp     #'^'
001AC7r 2  D0 20                bne     @done
001AC9r 2  20 rr rr             jsr     ChkNum
001ACCr 2  20 rr rr             jsr     ChrGet
001ACFr 2  20 rr rr             jsr     PushFac
001AD2r 2                       ; Right-associative, which means the right-hand side is evaluated at
001AD2r 2                       ; this level rather than the one below: recursing into EvalPow lets
001AD2r 2                       ; the RHS take the rest of the chain, so 2^3^2 is 2^(3^2) = 512.
001AD2r 2                       ; Calling EvalUnary here instead made it (2^3)^2 = 64 -- left-assoc,
001AD2r 2                       ; contradicting this level's own heading.  EvalUnary still runs first
001AD2r 2                       ; inside the recursion, so a term is always consumed and the recursion
001AD2r 2                       ; is bounded by the length of the chain.
001AD2r 2  20 rr rr             jsr     EvalPow
001AD5r 2  20 rr rr             jsr     ChkNum
001AD8r 2  20 rr rr             jsr     PullArg
001ADBr 2  A5 86                lda     BAS_LVTYP
001ADDr 2  10 03 4C rr          jmi     EvalTypeErr
001AE1r 2  rr           
001AE2r 2                       ; FPwrt computes ARG ^ FAC.  Our ported FPwrt expects ARG = base,
001AE2r 2                       ; FAC = exponent, and A = FAC's exponent byte (FPwrt's first
001AE2r 2                       ; instruction is `beq Exp` to short-circuit FAC==0 -> 1).
001AE2r 2  A5 0E                lda     FAC
001AE4r 2  20 rr rr             jsr     FPwrt
001AE7r 2  80 D9                bra     @loop
001AE9r 2               @done:
001AE9r 2  60                   rts
001AEAr 2               
001AEAr 2               ; ===========================================================================
001AEAr 2               ;   L E V E L 7  --  U N A R Y
001AEAr 2               ; ===========================================================================
001AEAr 2               EvalUnary:
001AEAr 2  20 rr rr             jsr     ChrGot
001AEDr 2  C9 2D                cmp     #'-'
001AEFr 2  F0 07                beq     @neg
001AF1r 2  C9 2B                cmp     #'+'
001AF3r 2  F0 13                beq     @pos
001AF5r 2  4C rr rr             jmp     EvalAtom
001AF8r 2               @neg:
001AF8r 2  20 rr rr             jsr     ChrGet
001AFBr 2                       ; Evaluate the operand at the power level, not this one: the README
001AFBr 2                       ; puts `^` above unary `-`, so -2^2 is -(2^2) = -4.  Recursing into
001AFBr 2                       ; EvalUnary here bound the minus to the atom first and gave (-2)^2 = 4.
001AFBr 2                       ; The '-' is consumed above, so a term is always taken before this
001AFBr 2                       ; recurses and the depth is bounded by the run of signs.
001AFBr 2  20 rr rr             jsr     EvalPow
001AFEr 2  20 rr rr             jsr     ChkNum
001B01r 2                       ; Negate FAC: flip FACSIGN bit 7.
001B01r 2  A5 13                lda     FACSIGN
001B03r 2  49 FF                eor     #$FF
001B05r 2  85 13                sta     FACSIGN
001B07r 2  60                   rts
001B08r 2               @pos:
001B08r 2  20 rr rr             jsr     ChrGet
001B0Br 2  4C rr rr             jmp     EvalUnary
001B0Er 2               
001B0Er 2               ; ===========================================================================
001B0Er 2               ;   L E V E L 8  --  A T O M
001B0Er 2               ; ===========================================================================
001B0Er 2               EvalAtom:
001B0Er 2  64 64                stz     VALTYP                  ; default to numeric; string paths override
001B10r 2  20 rr rr             jsr     ChrGot
001B13r 2  90 2A                bcc     @num                    ; digit
001B15r 2  C9 2E                cmp     #'.'
001B17r 2  F0 26                beq     @num
001B19r 2  C9 22                cmp     #'"'
001B1Br 2  F0 25                beq     @str
001B1Dr 2  C9 28                cmp     #'('
001B1Fr 2  F0 39                beq     @paren
001B21r 2                       ; Letter? -> variable
001B21r 2  20 rr rr             jsr     IsLetC
001B24r 2  B0 3D                bcs     @var
001B26r 2                       ; Function token?
001B26r 2  C9 CD                cmp     #TOK_INKEY
001B28r 2  F0 60                beq     FnInkey
001B2Ar 2  C9 9D                cmp     #TOK_FN
001B2Cr 2  F0 0E                beq     @fnCall                 ; FN A(...) — user-defined function
001B2Er 2                       ; Hex literal in PRINT context: not here (no '$' literal supported).
001B2Er 2                       ; NVRAM is dual-role (statement at $B1, function via FnTable);
001B2Er 2                       ; allow it through even though it sits below TOK_SGN.
001B2Er 2  C9 B1                cmp     #TOK_NVRAM
001B30r 2  F0 04                beq     @fnDisp
001B32r 2                       ; Try function dispatch.  Every token from SGN up goes to FnDispatch,
001B32r 2                       ; whose table holds $B6-$D0 and $E0-$E3: anything else it is handed --
001B32r 2                       ; the statements $D1-$DF in between -- is not in it, and is a SYNTAX
001B32r 2                       ; ERROR there.
001B32r 2  C9 B6                cmp     #TOK_SGN
001B34r 2  90 03                bcc     @synErr
001B36r 2               @fnDisp:
001B36r 2  4C rr rr             jmp     FnDispatch
001B39r 2               @synErr:
001B39r 2  4C rr rr             jmp     SynErr
001B3Cr 2               @fnCall:
001B3Cr 2  4C rr rr             jmp     FnCall
001B3Fr 2               @num:
001B3Fr 2                       ; ASCII numeric: jump to Fin.  Fin uses ChrGet to consume.
001B3Fr 2  4C rr rr             jmp     Fin
001B42r 2               @str:
001B42r 2                       ; '"' string literal.  Advance past the opening quote WITHOUT ChrGet:
001B42r 2                       ; ChrGet skips spaces, which would strip leading spaces inside the
001B42r 2                       ; string literal (e.g. PRINT "   X").  Bump TXTPTR by one byte instead.
001B42r 2  E6 04                inc     TXTPTR
001B44r 2  D0 02                bne     @strsrc
001B46r 2  E6 05                inc     TXTPTR+1
001B48r 2               @strsrc:
001B48r 2                       ; StrLit expects (Y,A) = src.  Source = TXTPTR.
001B48r 2  A5 04                lda     TXTPTR
001B4Ar 2  A4 05                ldy     TXTPTR+1
001B4Cr 2  20 rr rr             jsr     StrLit
001B4Fr 2                       ; StrLit advances internal pointer; we need to update TXTPTR.
001B4Fr 2                       ; StrLit reads until $00 or '"' from (STRNG1)+y; FAC has length.
001B4Fr 2                       ; Compute new TXTPTR = STRNG2 (which StrLit set), or TXTPTR + len + maybe-quote.
001B4Fr 2                       ; STRNG2 = STRNG1 + len + (1 if hit quote else 0).  Use STRNG2.
001B4Fr 2  A5 1E                lda     STRNG2
001B51r 2  85 04                sta     TXTPTR
001B53r 2  A5 1F                lda     STRNG2+1
001B55r 2  85 05                sta     TXTPTR+1
001B57r 2                       ; If we stopped at a closing quote, TXTPTR is past it (StrLit's
001B57r 2                       ; @endquote path: tya/adc STRNG1 with carry set since cmp set C);
001B57r 2                       ; if we ran into NUL, TXTPTR sits on the NUL (clc path).  Either
001B57r 2                       ; is correct for ChrGot.
001B57r 2  4C rr rr             jmp     ChrGot                  ; preload next char (for caller chains)
001B5Ar 2               @paren:
001B5Ar 2  20 rr rr             jsr     ChrGet                  ; consume '('
001B5Dr 2  20 rr rr             jsr     FrmEvl
001B60r 2  4C rr rr             jmp     ChkCls                  ; expects ')'; consumes via ChrGet
001B63r 2               @var:
001B63r 2                       ; Variable lookup.  PtrGet uses CHRGET internally and leaves
001B63r 2                       ; (A,Y) = VARPNT.  VALTYP is set to $00 or $FF.
001B63r 2  20 rr rr             jsr     PtrGet
001B66r 2                       ; Fetch value into FAC.
001B66r 2  24 64                bit     VALTYP
001B68r 2  30 07                bmi     @loadStr
001B6Ar 2                       ; numeric: FAC = (VARPNT)
001B6Ar 2  A5 3F                lda     VARPNT
001B6Cr 2  A4 40                ldy     VARPNT+1
001B6Er 2  4C rr rr             jmp     LoadFacFromYa
001B71r 2               @loadStr:
001B71r 2                       ; string: copy descriptor [len][lo][hi] into FAC..FAC+2.
001B71r 2  A0 00                ldy     #0
001B73r 2  B1 3F                lda     (VARPNT),y
001B75r 2  85 0E                sta     FAC
001B77r 2  C8                   iny
001B78r 2  B1 3F                lda     (VARPNT),y
001B7Ar 2  85 0F                sta     FAC+1
001B7Cr 2  C8                   iny
001B7Dr 2  B1 3F                lda     (VARPNT),y
001B7Fr 2  85 10                sta     FAC+2
001B81r 2                       ; Record the descriptor's address (= VARPNT) in FAC+3/FAC+4 so the
001B81r 2                       ; temp-free logic (FreFac/FreTms) can tell this is a variable, not a
001B81r 2                       ; temp: VARPNT's high byte is nonzero (vars live at $08xx) so it can
001B81r 2                       ; never match a temp-stack slot (all in zero page) and will not be
001B81r 2                       ; freed or reclaimed.  Without this, a stale FAC+3/FAC+4 can spuriously
001B81r 2                       ; match LASTPT and free/reclaim a live string.
001B81r 2  A5 3F                lda     VARPNT
001B83r 2  85 11                sta     FAC+3
001B85r 2  A5 40                lda     VARPNT+1
001B87r 2  85 12                sta     FAC+4
001B89r 2  60                   rts
001B8Ar 2               
001B8Ar 2               ; ---------------------------------------------------------------------------
001B8Ar 2               ; FnInkey -- INKEY (no parens).  Reads BAS_PENDKEY first; else BufferSize/
001B8Ar 2               ; ReadBuffer; else 0.  Result is unsigned 8-bit FP value.
001B8Ar 2               ; ---------------------------------------------------------------------------
001B8Ar 2               FnInkey:
001B8Ar 2  20 rr rr             jsr     ChrGet                  ; consume INKEY token
001B8Dr 2  AD 0E 03             lda     BAS_PENDKEY
001B90r 2  F0 09                beq     @noPend
001B92r 2                       ; consume pending key.
001B92r 2  A0 00                ldy     #0
001B94r 2  8C 0E 03             sty     BAS_PENDKEY
001B97r 2  A8                   tay
001B98r 2  4C rr rr             jmp     SngFlt
001B9Br 2               @noPend:
001B9Br 2  20 rr rr             jsr     BufferSize
001B9Er 2  F0 07                beq     @zero
001BA0r 2  20 rr rr             jsr     ReadBuffer
001BA3r 2  A8                   tay
001BA4r 2  4C rr rr             jmp     SngFlt
001BA7r 2               @zero:
001BA7r 2  A0 00                ldy     #0
001BA9r 2  4C rr rr             jmp     SngFlt
001BACr 2               
001BACr 2               ; ---------------------------------------------------------------------------
001BACr 2               ; FnDispatch -- A holds a token from TOK_SGN up.  Dispatch via FnTable, which
001BACr 2               ; pairs (token, handler-1); a token the table does not hold is a SYNTAX ERROR.
001BACr 2               ; ---------------------------------------------------------------------------
001BACr 2               FnDispatch:
001BACr 2  A2 00                ldx     #0
001BAEr 2               @find:
001BAEr 2  BD rr rr             lda     FnTable,x
001BB1r 2  F0 14                beq     @synErr                 ; reached terminator
001BB3r 2  D2 04                cmp     (TXTPTR)
001BB5r 2  F0 05                beq     @match
001BB7r 2  E8                   inx
001BB8r 2  E8                   inx
001BB9r 2  E8                   inx
001BBAr 2  80 F2                bra     @find
001BBCr 2               @match:
001BBCr 2                       ; Push handler-1 onto stack so RTS jumps to it after ChrGet.
001BBCr 2  BD rr rr             lda     FnTable+2,x
001BBFr 2  48                   pha
001BC0r 2  BD rr rr             lda     FnTable+1,x
001BC3r 2  48                   pha
001BC4r 2  4C rr rr             jmp     ChrGet                  ; consume token, return into handler
001BC7r 2               @synErr:
001BC7r 2  4C rr rr             jmp     SynErr
001BCAr 2               
001BCAr 2               ; ---------------------------------------------------------------------------
001BCAr 2               ; FnTable -- (token, handler-1) triples, $00-terminated.
001BCAr 2               ; "handler-1" because we push it through RTS which adds 1.
001BCAr 2               ; ---------------------------------------------------------------------------
001BCAr 2               FnTable:
001BCAr 2  B6                   .byte   TOK_SGN
001BCBr 2  rr rr                .word   FnSgn-1
001BCDr 2  B7                   .byte   TOK_INT
001BCEr 2  rr rr                .word   FnInt-1
001BD0r 2  B8                   .byte   TOK_ABS
001BD1r 2  rr rr                .word   FnAbs-1
001BD3r 2  B9                   .byte   TOK_FRE
001BD4r 2  rr rr                .word   FnFre-1
001BD6r 2  BA                   .byte   TOK_POS
001BD7r 2  rr rr                .word   FnPos-1
001BD9r 2  BB                   .byte   TOK_SQR
001BDAr 2  rr rr                .word   FnSqr-1
001BDCr 2  BC                   .byte   TOK_RND
001BDDr 2  rr rr                .word   FnRnd-1
001BDFr 2  BD                   .byte   TOK_LOG
001BE0r 2  rr rr                .word   FnLog-1
001BE2r 2  BE                   .byte   TOK_EXP
001BE3r 2  rr rr                .word   FnExp-1
001BE5r 2  BF                   .byte   TOK_COS
001BE6r 2  rr rr                .word   FnCos-1
001BE8r 2  C0                   .byte   TOK_SIN
001BE9r 2  rr rr                .word   FnSin-1
001BEBr 2  C1                   .byte   TOK_TAN
001BECr 2  rr rr                .word   FnTan-1
001BEEr 2  C2                   .byte   TOK_ATN
001BEFr 2  rr rr                .word   FnAtn-1
001BF1r 2  C3                   .byte   TOK_PEEK
001BF2r 2  rr rr                .word   FnPeek-1
001BF4r 2  C4                   .byte   TOK_LEN
001BF5r 2  rr rr                .word   FnLen-1
001BF7r 2  C5                   .byte   TOK_STRSTR
001BF8r 2  rr rr                .word   FnStrStr-1
001BFAr 2  C6                   .byte   TOK_VAL
001BFBr 2  rr rr                .word   FnVal-1
001BFDr 2  C7                   .byte   TOK_ASC
001BFEr 2  rr rr                .word   FnAsc-1
001C00r 2  C8                   .byte   TOK_CHRSTR
001C01r 2  rr rr                .word   FnChrStr-1
001C03r 2  C9                   .byte   TOK_LEFTSTR
001C04r 2  rr rr                .word   FnLeftStr-1
001C06r 2  CA                   .byte   TOK_RIGHTSTR
001C07r 2  rr rr                .word   FnRightStr-1
001C09r 2  CB                   .byte   TOK_MIDSTR
001C0Ar 2  rr rr                .word   FnMidStr-1
001C0Cr 2  CC                   .byte   TOK_JOY
001C0Dr 2  rr rr                .word   FnJoy-1
001C0Fr 2  B1                   .byte   TOK_NVRAM
001C10r 2  rr rr                .word   FnNvram-1
001C12r 2  CE                   .byte   TOK_HEX
001C13r 2  rr rr                .word   FnHex-1
001C15r 2  CF                   .byte   TOK_MIN
001C16r 2  rr rr                .word   FnMin-1
001C18r 2  D0                   .byte   TOK_MAX
001C19r 2  rr rr                .word   FnMax-1
001C1Br 2  E0                   .byte   TOK_VPEEK
001C1Cr 2  rr rr                .word   FnVpeek-1
001C1Er 2  E1                   .byte   TOK_VSTAT
001C1Fr 2  rr rr                .word   FnVstat-1
001C21r 2  E2                   .byte   TOK_NVSTAT
001C22r 2  rr rr                .word   FnNvstat-1
001C24r 2  E3                   .byte   TOK_NVFIND
001C25r 2  rr rr                .word   FnNvfind-1
001C27r 2  00                   .byte   0
001C28r 2               
001C28r 2               ; ---------------------------------------------------------------------------
001C28r 2               ; Numeric-arg helpers.
001C28r 2               ; ParenNum    -- expects "(" expr ")" with numeric result.  FAC = result.
001C28r 2               ; ParenStr    -- expects "(" expr ")" with string result.
001C28r 2               ; ParenU8     -- expects "(" expr ")" -> A = byte (0..255), or ?ILLQTY.
001C28r 2               ; ParenU16    -- expects "(" expr ")" -> AyInt result in FAC+3,+4.
001C28r 2               ; ---------------------------------------------------------------------------
001C28r 2               ParenNum:
001C28r 2  20 rr rr             jsr     ChkOpn
001C2Br 2  20 rr rr             jsr     FrmEvl
001C2Er 2  20 rr rr             jsr     ChkNum
001C31r 2  4C rr rr             jmp     ChkCls
001C34r 2               ParenStr:
001C34r 2  20 rr rr             jsr     ChkOpn
001C37r 2  20 rr rr             jsr     FrmEvl
001C3Ar 2  20 rr rr             jsr     ChkStr
001C3Dr 2  4C rr rr             jmp     ChkCls
001C40r 2               ParenU8:
001C40r 2  20 rr rr             jsr     ParenNum
001C43r 2  20 rr rr             jsr     AyInt
001C46r 2  A5 11                lda     FAC+3                   ; high byte must be 0
001C48r 2  D0 03                bne     @bad
001C4Ar 2  A5 12                lda     FAC+4                   ; low byte = result
001C4Cr 2  60                   rts
001C4Dr 2               @bad:
001C4Dr 2  4C rr rr             jmp     IqErr
001C50r 2               
001C50r 2               ; ---------------------------------------------------------------------------
001C50r 2               ; Unary numeric functions (single-arg "(" num ")") -- shared body.
001C50r 2               ; Each entry sets up A = handler entry to call after ChkOpn/FrmEvl/ChkNum/ChkCls.
001C50r 2               ; ---------------------------------------------------------------------------
001C50r 2               FnSgn:
001C50r 2  20 rr rr             jsr     ParenNum
001C53r 2  4C rr rr             jmp     Sgn
001C56r 2               FnInt:
001C56r 2  20 rr rr             jsr     ParenNum
001C59r 2  4C rr rr             jmp     Int
001C5Cr 2               FnAbs:
001C5Cr 2  20 rr rr             jsr     ParenNum
001C5Fr 2  4C rr rr             jmp     Abs
001C62r 2               FnSqr:
001C62r 2  20 rr rr             jsr     ParenNum
001C65r 2  4C rr rr             jmp     Sqr
001C68r 2               FnLog:
001C68r 2  20 rr rr             jsr     ParenNum
001C6Br 2  4C rr rr             jmp     Log
001C6Er 2               FnExp:
001C6Er 2  20 rr rr             jsr     ParenNum
001C71r 2  4C rr rr             jmp     Exp
001C74r 2               FnCos:
001C74r 2  20 rr rr             jsr     ParenNum
001C77r 2  4C rr rr             jmp     Cos
001C7Ar 2               FnSin:
001C7Ar 2  20 rr rr             jsr     ParenNum
001C7Dr 2  4C rr rr             jmp     Sin
001C80r 2               FnTan:
001C80r 2  20 rr rr             jsr     ParenNum
001C83r 2  4C rr rr             jmp     Tan
001C86r 2               FnAtn:
001C86r 2  20 rr rr             jsr     ParenNum
001C89r 2  4C rr rr             jmp     Atn
001C8Cr 2               FnRnd:
001C8Cr 2  20 rr rr             jsr     ParenNum
001C8Fr 2  4C rr rr             jmp     Rnd
001C92r 2               FnHex:
001C92r 2                       ; In expression context: identity.
001C92r 2  4C rr rr             jmp     ParenNum
001C95r 2               
001C95r 2               ; ---------------------------------------------------------------------------
001C95r 2               ; FnFre -- FRE(n): returns FRETOP - STREND (free string heap).
001C95r 2               ; Argument is parsed and ignored.
001C95r 2               ; ---------------------------------------------------------------------------
001C95r 2               FnFre:
001C95r 2  20 rr rr             jsr     ParenNum
001C98r 2  38                   sec
001C99r 2  AD 65 03             lda     FRETOP
001C9Cr 2  ED 63 03             sbc     STREND
001C9Fr 2  A8                   tay
001CA0r 2  AD 66 03             lda     FRETOP+1
001CA3r 2  ED 64 03             sbc     STREND+1
001CA6r 2  4C rr rr             jmp     GivAyf
001CA9r 2               
001CA9r 2               ; ---------------------------------------------------------------------------
001CA9r 2               ; FnPos -- POS(n): current print column.  Argument is parsed and ignored.
001CA9r 2               ; ---------------------------------------------------------------------------
001CA9r 2               FnPos:
001CA9r 2  20 rr rr             jsr     ParenNum
001CACr 2                       ; BAS_POSX is the live column PrintCh maintains and TAB and the comma
001CACr 2                       ; zones already read.  This returned a hardcoded 0 -- the column was
001CACr 2                       ; being tracked all along, POS just never looked at it.
001CACr 2  AC 70 03             ldy     BAS_POSX
001CAFr 2  4C rr rr             jmp     SngFlt
001CB2r 2               
001CB2r 2               ; ---------------------------------------------------------------------------
001CB2r 2               ; FnPeek -- PEEK(addr): byte at addr -> FP.
001CB2r 2               ; ---------------------------------------------------------------------------
001CB2r 2               FnPeek:
001CB2r 2  20 rr rr             jsr     ParenNum
001CB5r 2  20 rr rr             jsr     FacToU16
001CB8r 2  A5 12                lda     FAC+4                   ; lo byte
001CBAr 2  85 20                sta     INDEX
001CBCr 2  A5 11                lda     FAC+3                   ; hi byte
001CBEr 2  85 21                sta     INDEX+1
001CC0r 2  A0 00                ldy     #0
001CC2r 2  B1 20                lda     (INDEX),y
001CC4r 2  A8                   tay
001CC5r 2  4C rr rr             jmp     SngFlt
001CC8r 2               
001CC8r 2               ; ---------------------------------------------------------------------------
001CC8r 2               ; FnJoy -- JOY(n): 1 or 2.  If GPIO absent, returns 0.
001CC8r 2               ; ---------------------------------------------------------------------------
001CC8r 2               FnJoy:
001CC8r 2  20 rr rr             jsr     ParenU8
001CCBr 2  48                   pha
001CCCr 2  AD 0D 03             lda     HW_PRESENT
001CCFr 2  29 20                and     #HW_GPIO
001CD1r 2  F0 1C                beq     @absent
001CD3r 2  68                   pla
001CD4r 2  C9 01                cmp     #1
001CD6r 2  F0 09                beq     @j1
001CD8r 2  C9 02                cmp     #2
001CDAr 2  F0 0C                beq     @j2
001CDCr 2  A2 0B                ldx     #ERR_ILLQUAN
001CDEr 2  4C rr rr             jmp     BasErrorVec
001CE1r 2               @j1:
001CE1r 2  20 rr rr             jsr     ReadJoystick1
001CE4r 2  A8                   tay
001CE5r 2  4C rr rr             jmp     SngFlt
001CE8r 2               @j2:
001CE8r 2  20 rr rr             jsr     ReadJoystick2
001CEBr 2  A8                   tay
001CECr 2  4C rr rr             jmp     SngFlt
001CEFr 2               @absent:
001CEFr 2  68                   pla
001CF0r 2                       ; $FF, not 0.  The ports are active low -- pulled high through 1K, and
001CF0r 2                       ; the stick's switches ground them -- so JOY returns the port raw and 0
001CF0r 2                       ; means every direction and button is held at once.  Reporting 0 for a
001CF0r 2                       ; machine with no VIA fitted told the caller exactly that; $FF is what
001CF0r 2                       ; an untouched stick reads, and so the honest answer for one that is
001CF0r 2                       ; not there at all.
001CF0r 2  A0 FF                ldy     #$FF
001CF2r 2  4C rr rr             jmp     SngFlt
001CF5r 2               
001CF5r 2               ; ---------------------------------------------------------------------------
001CF5r 2               ; FnNvram -- NVRAM(addr): if RTC absent, return 0.
001CF5r 2               ; ---------------------------------------------------------------------------
001CF5r 2               FnNvram:
001CF5r 2  20 rr rr             jsr     ParenU8
001CF8r 2  48                   pha
001CF9r 2  AD 0D 03             lda     HW_PRESENT
001CFCr 2  29 04                and     #HW_RTC
001CFEr 2  F0 09                beq     @absent
001D00r 2  68                   pla
001D01r 2  AA                   tax
001D02r 2  20 rr rr             jsr     RtcReadNVRAM
001D05r 2  A8                   tay
001D06r 2  4C rr rr             jmp     SngFlt
001D09r 2               @absent:
001D09r 2  68                   pla
001D0Ar 2  A0 00                ldy     #0
001D0Cr 2  4C rr rr             jmp     SngFlt
001D0Fr 2               
001D0Fr 2               ; ---------------------------------------------------------------------------
001D0Fr 2               ; FnMin / FnMax -- two numeric args, smaller / larger.
001D0Fr 2               ; ---------------------------------------------------------------------------
001D0Fr 2               FnMin:
001D0Fr 2  20 rr rr             jsr     MinMaxArgs              ; ARG = a, FAC = b, BAS_TMP3 = sign(b-a)
001D12r 2                       ; Want smaller: if b>=a return a (ARG); else return b (FAC).
001D12r 2  10 01                bpl     @retArg                 ; sign>=0 means b>=a
001D14r 2  60                   rts                             ; FAC already = b
001D15r 2               @retArg:
001D15r 2  4C rr rr             jmp     CopyArgToFac
001D18r 2               FnMax:
001D18r 2  20 rr rr             jsr     MinMaxArgs
001D1Br 2                       ; Want larger: if b>=a return b (FAC); else return a (ARG).
001D1Br 2  10 03                bpl     @retFac
001D1Dr 2  4C rr rr             jmp     CopyArgToFac
001D20r 2               @retFac:
001D20r 2  60                   rts
001D21r 2               
001D21r 2               ; MinMaxArgs -- consume "(" a "," b ")" with numerics; ARG=a, FAC=b.
001D21r 2               ; Returns A = sign(b - a) (FF/00/01) and N flag set accordingly.
001D21r 2               MinMaxArgs:
001D21r 2  20 rr rr             jsr     ChkOpn
001D24r 2  20 rr rr             jsr     FrmEvl
001D27r 2  20 rr rr             jsr     ChkNum
001D2Ar 2  20 rr rr             jsr     PushFac                 ; save a
001D2Dr 2  20 rr rr             jsr     ChkCom
001D30r 2  20 rr rr             jsr     FrmEvl
001D33r 2  20 rr rr             jsr     ChkNum
001D36r 2  20 rr rr             jsr     ChkCls
001D39r 2  20 rr rr             jsr     PullArg                 ; ARG = a, FAC = b
001D3Cr 2                       ; Stash ARG so we can restore after FComp's destructive sign-pack.
001D3Cr 2  A5 16                lda     ARG
001D3Er 2  85 4D                sta     BAS_TEMP1
001D40r 2  A5 17                lda     ARG+1
001D42r 2  85 4E                sta     BAS_TEMP1+1
001D44r 2  A5 18                lda     ARG+2
001D46r 2  85 4F                sta     BAS_TEMP1+2
001D48r 2  A5 19                lda     ARG+3
001D4Ar 2  85 50                sta     BAS_TEMP1+3
001D4Cr 2  A5 1A                lda     ARG+4
001D4Er 2  85 51                sta     BAS_TEMP1+4
001D50r 2  A5 1B                lda     ARGSIGN
001D52r 2  85 52                sta     BAS_TEMP1+5
001D54r 2                       ; Pack ARGSIGN into bit 7 of ARG+1 so FComp reads it correctly.
001D54r 2  A5 1B                lda     ARGSIGN
001D56r 2  09 7F                ora     #$7F
001D58r 2  25 17                and     ARG+1
001D5Ar 2  85 17                sta     ARG+1
001D5Cr 2  A9 16                lda     #<ARG
001D5Er 2  A0 00                ldy     #$00
001D60r 2  20 rr rr             jsr     FComp                   ; A = sign(FAC - ARG)
001D63r 2  48                   pha
001D64r 2                       ; Restore ARG.
001D64r 2  A5 4D                lda     BAS_TEMP1
001D66r 2  85 16                sta     ARG
001D68r 2  A5 4E                lda     BAS_TEMP1+1
001D6Ar 2  85 17                sta     ARG+1
001D6Cr 2  A5 4F                lda     BAS_TEMP1+2
001D6Er 2  85 18                sta     ARG+2
001D70r 2  A5 50                lda     BAS_TEMP1+3
001D72r 2  85 19                sta     ARG+3
001D74r 2  A5 51                lda     BAS_TEMP1+4
001D76r 2  85 1A                sta     ARG+4
001D78r 2  A5 52                lda     BAS_TEMP1+5
001D7Ar 2  85 1B                sta     ARGSIGN
001D7Cr 2  68                   pla                             ; restore A, sets N/Z flags
001D7Dr 2  60                   rts
001D7Er 2               
001D7Er 2               ; ---------------------------------------------------------------------------
001D7Er 2               ; FnLen -- LEN(s$): length of string.
001D7Er 2               ; ---------------------------------------------------------------------------
001D7Er 2               FnLen:
001D7Er 2  20 rr rr             jsr     ParenStr
001D81r 2  A5 0E                lda     FAC                     ; length
001D83r 2  48                   pha                             ; FreFac returns with Y = descriptor hi
001D84r 2  20 rr rr             jsr     FreFac                  ; release temp string if any
001D87r 2  68                   pla
001D88r 2  A8                   tay
001D89r 2  4C rr rr             jmp     SngFlt
001D8Cr 2               
001D8Cr 2               ; ---------------------------------------------------------------------------
001D8Cr 2               ; FnAsc -- ASC(s$): code of first char; ?ILLQTY if empty.
001D8Cr 2               ; ---------------------------------------------------------------------------
001D8Cr 2               FnAsc:
001D8Cr 2  20 rr rr             jsr     ParenStr
001D8Fr 2  A5 0E                lda     FAC
001D91r 2  F0 15                beq     @bad
001D93r 2                       ; Read first byte of string.
001D93r 2  A5 0F                lda     FAC+1
001D95r 2  85 20                sta     INDEX
001D97r 2  A5 10                lda     FAC+2
001D99r 2  85 21                sta     INDEX+1
001D9Br 2  A0 00                ldy     #0
001D9Dr 2  B1 20                lda     (INDEX),y
001D9Fr 2  48                   pha
001DA0r 2  20 rr rr             jsr     FreFac
001DA3r 2  68                   pla
001DA4r 2  A8                   tay
001DA5r 2  4C rr rr             jmp     SngFlt
001DA8r 2               @bad:
001DA8r 2  4C rr rr             jmp     IqErr
001DABr 2               
001DABr 2               ; ---------------------------------------------------------------------------
001DABr 2               ; FnChrStr -- CHR$(n): 1-char string.
001DABr 2               ; ---------------------------------------------------------------------------
001DABr 2               FnChrStr:
001DABr 2  20 rr rr             jsr     ParenU8
001DAEr 2  48                   pha
001DAFr 2  A9 01                lda     #1
001DB1r 2  20 rr rr             jsr     GetSpa                  ; (Y,X) = addr; A unchanged
001DB4r 2  68                   pla
001DB5r 2  A0 00                ldy     #0
001DB7r 2  91 84                sta     (FRESPC),y
001DB9r 2                       ; Build descriptor in FAC.
001DB9r 2  A9 01                lda     #1
001DBBr 2  85 0E                sta     FAC
001DBDr 2  A5 84                lda     FRESPC
001DBFr 2  85 0F                sta     FAC+1
001DC1r 2  A5 85                lda     FRESPC+1
001DC3r 2  85 10                sta     FAC+2
001DC5r 2                       ; Advance FRESPC past the byte we just wrote.
001DC5r 2  E6 84                inc     FRESPC
001DC7r 2  D0 02                bne     @nb
001DC9r 2  E6 85                inc     FRESPC+1
001DCBr 2               @nb:
001DCBr 2  4C rr rr             jmp     PutNew
001DCEr 2               
001DCEr 2               ; ---------------------------------------------------------------------------
001DCEr 2               ; FnStrStr -- STR$(n): convert numeric to string.
001DCEr 2               ; ---------------------------------------------------------------------------
001DCEr 2               FnStrStr:
001DCEr 2  20 rr rr             jsr     ParenNum
001DD1r 2  20 rr rr             jsr     Fout                    ; A=lo, Y=hi -> NUL-terminated buffer
001DD4r 2                       ; (A,Y) = pointer to NUL-terminated ASCII number string in STACK2.
001DD4r 2  20 rr rr             jsr     StrLit                  ; allocates + copies + PutNew
001DD7r 2  60                   rts
001DD8r 2               
001DD8r 2               ; ---------------------------------------------------------------------------
001DD8r 2               ; FnVal -- VAL(s$): parse leading numeric from string.
001DD8r 2               ; Temporarily NUL-terminates the string in place, redirects TXTPTR, calls
001DD8r 2               ; Fin, then restores.
001DD8r 2               ; ---------------------------------------------------------------------------
001DD8r 2               FnVal:
001DD8r 2  20 rr rr             jsr     ParenStr
001DDBr 2  A5 0E                lda     FAC
001DDDr 2  D0 08                bne     @nz
001DDFr 2                       ; empty string -> 0
001DDFr 2  20 rr rr             jsr     FreFac
001DE2r 2  64 64                stz     VALTYP                  ; result is numeric (ParenStr set $FF)
001DE4r 2  4C rr rr             jmp     ZeroFac
001DE7r 2               @nz:
001DE7r 2                       ; Stash length, address into TEMP1..TEMP1+2.
001DE7r 2  85 4D                sta     TEMP1                   ; length
001DE9r 2  A5 0F                lda     FAC+1
001DEBr 2  85 4E                sta     TEMP1+1
001DEDr 2  A5 10                lda     FAC+2
001DEFr 2  85 4F                sta     TEMP1+2
001DF1r 2                       ; Reclaim the argument's temp now, while FAC still holds its
001DF1r 2                       ; descriptor -- msbasic's VAL frees before parsing for the same
001DF1r 2                       ; reason.  It cannot wait until after Fin: FAC+3/+4 are the two bytes
001DF1r 2                       ; FreFac frees by, and by then they are mantissa of the parsed number.
001DF1r 2                       ; Freeing only releases the heap for reuse and nothing allocates
001DF1r 2                       ; between here and Fin, so the characters stay intact to parse.
001DF1r 2                       ; Without it the temp leaked: the empty-string path above frees, the
001DF1r 2                       ; parsing path did not, and three VALs of a literal in one program
001DF1r 2                       ; exhausted the 3-slot temp stack with ?FORMULA TOO COMPLEX.
001DF1r 2  20 rr rr             jsr     FreFac
001DF4r 2                       ; Save the byte at offset = length and replace with $00.
001DF4r 2  A5 4E                lda     TEMP1+1
001DF6r 2  85 20                sta     INDEX
001DF8r 2  A5 4F                lda     TEMP1+2
001DFAr 2  85 21                sta     INDEX+1
001DFCr 2  A4 4D                ldy     TEMP1
001DFEr 2  B1 20                lda     (INDEX),y
001E00r 2  85 50                sta     TEMP1+3                 ; saved byte
001E02r 2  A9 00                lda     #0
001E04r 2  91 20                sta     (INDEX),y
001E06r 2                       ; Save TXTPTR.
001E06r 2  A5 04                lda     TXTPTR
001E08r 2  48                   pha
001E09r 2  A5 05                lda     TXTPTR+1
001E0Br 2  48                   pha
001E0Cr 2                       ; TXTPTR := INDEX - 1, then ChrGet to load first char.
001E0Cr 2  A5 4E                lda     TEMP1+1
001E0Er 2  85 04                sta     TXTPTR
001E10r 2  A5 4F                lda     TEMP1+2
001E12r 2  85 05                sta     TXTPTR+1
001E14r 2  A5 04                lda     TXTPTR
001E16r 2  D0 02                bne     @nb
001E18r 2  C6 05                dec     TXTPTR+1
001E1Ar 2               @nb:
001E1Ar 2  C6 04                dec     TXTPTR
001E1Cr 2  20 rr rr             jsr     ChrGet                  ; first char
001E1Fr 2  20 rr rr             jsr     Fin                     ; FAC := value
001E22r 2                       ; Restore the saved byte.
001E22r 2  A5 4E                lda     TEMP1+1
001E24r 2  85 20                sta     INDEX
001E26r 2  A5 4F                lda     TEMP1+2
001E28r 2  85 21                sta     INDEX+1
001E2Ar 2  A4 4D                ldy     TEMP1
001E2Cr 2  A5 50                lda     TEMP1+3
001E2Er 2  91 20                sta     (INDEX),y
001E30r 2                       ; Restore TXTPTR.
001E30r 2  68                   pla
001E31r 2  85 05                sta     TXTPTR+1
001E33r 2  68                   pla
001E34r 2  85 04                sta     TXTPTR
001E36r 2  64 64                stz     VALTYP                  ; Fin left VALTYP = $FF from ParenStr
001E38r 2  60                   rts
001E39r 2               
001E39r 2               ; ---------------------------------------------------------------------------
001E39r 2               ; FnLeftStr -- LEFT$(s$, n): leftmost n chars.
001E39r 2               ; ---------------------------------------------------------------------------
001E39r 2               FnLeftStr:
001E39r 2  20 rr rr             jsr     ChkOpn
001E3Cr 2  20 rr rr             jsr     FrmEvl
001E3Fr 2  20 rr rr             jsr     ChkStr
001E42r 2  20 rr rr             jsr     ChkCom
001E45r 2  20 rr rr             jsr     PushFac                 ; save string descriptor
001E48r 2  20 rr rr             jsr     FrmEvl
001E4Br 2  20 rr rr             jsr     ChkNum
001E4Er 2  20 rr rr             jsr     ChkCls
001E51r 2  20 rr rr             jsr     AyInt
001E54r 2  20 rr rr             jsr     PullArg                 ; ARG = string descriptor (BAS_TMP1 clobbered)
001E57r 2                       ; FAC still holds the integer n; check range and copy now.
001E57r 2  A5 11                lda     FAC+3
001E59r 2  D0 16                bne     @bad
001E5Br 2  A5 12                lda     FAC+4
001E5Dr 2  85 3B                sta     BAS_TMP1+1              ; n
001E5Fr 2                       ; Clamp n to ARG (length).
001E5Fr 2  A5 3B                lda     BAS_TMP1+1
001E61r 2  C5 16                cmp     ARG
001E63r 2  90 02                bcc     @ok
001E65r 2  A5 16                lda     ARG
001E67r 2               @ok:
001E67r 2  85 3B                sta     BAS_TMP1+1
001E69r 2                       ; Free the source temp BEFORE allocating result so the slot frees up.
001E69r 2  20 rr rr             jsr     FreeArgString
001E6Cr 2                       ; Offset = 0 for LEFT$.
001E6Cr 2  64 3A                stz     BAS_TMP1
001E6Er 2                       ; Allocate, copy first n bytes.
001E6Er 2  4C rr rr             jmp     SubstrCommon            ; tail-call (rts to caller)
001E71r 2               @bad:
001E71r 2  4C rr rr             jmp     IqErr
001E74r 2               
001E74r 2               ; ---------------------------------------------------------------------------
001E74r 2               ; FnRightStr -- RIGHT$(s$, n): rightmost n chars.
001E74r 2               ; ---------------------------------------------------------------------------
001E74r 2               FnRightStr:
001E74r 2  20 rr rr             jsr     ChkOpn
001E77r 2  20 rr rr             jsr     FrmEvl
001E7Ar 2  20 rr rr             jsr     ChkStr
001E7Dr 2  20 rr rr             jsr     ChkCom
001E80r 2  20 rr rr             jsr     PushFac
001E83r 2  20 rr rr             jsr     FrmEvl
001E86r 2  20 rr rr             jsr     ChkNum
001E89r 2  20 rr rr             jsr     ChkCls
001E8Cr 2  20 rr rr             jsr     AyInt
001E8Fr 2  20 rr rr             jsr     PullArg                 ; ARG = string descriptor (BAS_TMP1 clobbered)
001E92r 2  A5 11                lda     FAC+3
001E94r 2  D0 1B                bne     @bad
001E96r 2  A5 12                lda     FAC+4
001E98r 2  85 3B                sta     BAS_TMP1+1              ; n
001E9Ar 2                       ; Clamp n.
001E9Ar 2  A5 3B                lda     BAS_TMP1+1
001E9Cr 2  C5 16                cmp     ARG
001E9Er 2  90 02                bcc     @ok
001EA0r 2  A5 16                lda     ARG
001EA2r 2               @ok:
001EA2r 2  85 3B                sta     BAS_TMP1+1
001EA4r 2                       ; offset = ARG - n.
001EA4r 2  A5 16                lda     ARG
001EA6r 2  38                   sec
001EA7r 2  E5 3B                sbc     BAS_TMP1+1
001EA9r 2  85 3A                sta     BAS_TMP1                ; start offset
001EABr 2  20 rr rr             jsr     FreeArgString
001EAEr 2  4C rr rr             jmp     SubstrCommon
001EB1r 2               @bad:
001EB1r 2  4C rr rr             jmp     IqErr
001EB4r 2               
001EB4r 2               ; ---------------------------------------------------------------------------
001EB4r 2               ; FnMidStr -- MID$(s$, m [, n]): substring starting at m (1-based).
001EB4r 2               ; ---------------------------------------------------------------------------
001EB4r 2               FnMidStr:
001EB4r 2  20 rr rr             jsr     ChkOpn
001EB7r 2  20 rr rr             jsr     FrmEvl
001EBAr 2  20 rr rr             jsr     ChkStr
001EBDr 2  20 rr rr             jsr     ChkCom
001EC0r 2  20 rr rr             jsr     PushFac
001EC3r 2                       ; Read m.
001EC3r 2  20 rr rr             jsr     FrmEvl
001EC6r 2  20 rr rr             jsr     ChkNum
001EC9r 2  20 rr rr             jsr     AyInt
001ECCr 2  A5 11                lda     FAC+3
001ECEr 2  D0 4B                bne     @bad
001ED0r 2  A5 12                lda     FAC+4
001ED2r 2  F0 47                beq     @bad                    ; m must be >= 1
001ED4r 2  38                   sec
001ED5r 2  E9 01                sbc     #1
001ED7r 2  48                   pha                             ; offset = m-1; FrmEvl below would
001ED8r 2                                                       ; clobber BAS_TMP1, so park it here
001ED8r 2                       ; Optional ", n".
001ED8r 2  20 rr rr             jsr     ChrGot
001EDBr 2  C9 2C                cmp     #','
001EDDr 2  F0 04                beq     @hasN
001EDFr 2                       ; No n: take rest -> n = 255 (will clamp).
001EDFr 2  A9 FF                lda     #255
001EE1r 2  80 12                bra     @gotN
001EE3r 2               @hasN:
001EE3r 2  20 rr rr             jsr     ChrGet
001EE6r 2  20 rr rr             jsr     FrmEvl
001EE9r 2  20 rr rr             jsr     ChkNum
001EECr 2  20 rr rr             jsr     AyInt
001EEFr 2  A5 11                lda     FAC+3
001EF1r 2  D0 28                bne     @bad
001EF3r 2  A5 12                lda     FAC+4
001EF5r 2               @gotN:
001EF5r 2  85 3B                sta     BAS_TMP1+1
001EF7r 2  68                   pla
001EF8r 2  85 3A                sta     BAS_TMP1
001EFAr 2  20 rr rr             jsr     ChkCls
001EFDr 2  20 rr rr             jsr     PullArg                 ; ARG = string
001F00r 2                       ; Clamp offset to length.
001F00r 2  A5 3A                lda     BAS_TMP1
001F02r 2  C5 16                cmp     ARG
001F04r 2  90 04                bcc     @offOk
001F06r 2  A5 16                lda     ARG                     ; offset = length -> empty result
001F08r 2  85 3A                sta     BAS_TMP1
001F0Ar 2               @offOk:
001F0Ar 2                       ; Clamp n to (length - offset).
001F0Ar 2  38                   sec
001F0Br 2  A5 16                lda     ARG
001F0Dr 2  E5 3A                sbc     BAS_TMP1
001F0Fr 2  C5 3B                cmp     BAS_TMP1+1
001F11r 2  B0 02                bcs     @nOk
001F13r 2  85 3B                sta     BAS_TMP1+1
001F15r 2               @nOk:
001F15r 2  20 rr rr             jsr     FreeArgString
001F18r 2  4C rr rr             jmp     SubstrCommon
001F1Br 2               @bad:
001F1Br 2  4C rr rr             jmp     IqErr
001F1Er 2               
001F1Er 2               ; ---------------------------------------------------------------------------
001F1Er 2               ; SubstrCommon -- copy BAS_TMP1+1 bytes from ARG-string at offset BAS_TMP1
001F1Er 2               ; into a new heap allocation; result descriptor in FAC; PutNew.
001F1Er 2               ; ---------------------------------------------------------------------------
001F1Er 2               SubstrCommon:
001F1Er 2                       ; Allocate.
001F1Er 2  A5 3B                lda     BAS_TMP1+1
001F20r 2  20 rr rr             jsr     GetSpa                  ; FRESPC = new buffer
001F23r 2                       ; Source pointer = ARG+1 (lo/hi) + BAS_TMP1.
001F23r 2  18                   clc
001F24r 2  A5 17                lda     ARG+1
001F26r 2  65 3A                adc     BAS_TMP1
001F28r 2  85 20                sta     INDEX
001F2Ar 2  A5 18                lda     ARG+2
001F2Cr 2  69 00                adc     #0
001F2Er 2  85 21                sta     INDEX+1
001F30r 2                       ; Copy BAS_TMP1+1 bytes from (INDEX) to (FRESPC).
001F30r 2  A4 3B                ldy     BAS_TMP1+1
001F32r 2  F0 0B                beq     @done
001F34r 2  A0 00                ldy     #0
001F36r 2               @cp:
001F36r 2  B1 20                lda     (INDEX),y
001F38r 2  91 84                sta     (FRESPC),y
001F3Ar 2  C8                   iny
001F3Br 2  C4 3B                cpy     BAS_TMP1+1
001F3Dr 2  D0 F7                bne     @cp
001F3Fr 2               @done:
001F3Fr 2                       ; Build descriptor.
001F3Fr 2  A5 3B                lda     BAS_TMP1+1
001F41r 2  85 0E                sta     FAC
001F43r 2  A5 84                lda     FRESPC
001F45r 2  85 0F                sta     FAC+1
001F47r 2  A5 85                lda     FRESPC+1
001F49r 2  85 10                sta     FAC+2
001F4Br 2                       ; Advance FRESPC by length consumed.
001F4Br 2  18                   clc
001F4Cr 2  A5 84                lda     FRESPC
001F4Er 2  65 3B                adc     BAS_TMP1+1
001F50r 2  85 84                sta     FRESPC
001F52r 2  90 02                bcc     @nb
001F54r 2  E6 85                inc     FRESPC+1
001F56r 2               @nb:
001F56r 2  4C rr rr             jmp     PutNew
001F59r 2               
001F59r 2               ; FreeArgString -- if ARG holds a temp string descriptor (most-recent
001F59r 2               ; on TEMPST), pop just the descriptor.  Heap is left intact so callers
001F59r 2               ; that still need the source bytes can copy them safely; orphaned heap
001F59r 2               ; will be reclaimed by Garbag.
001F59r 2               FreeArgString:
001F59r 2  A5 19                lda     ARG+3                   ; descriptor address lo
001F5Br 2  A4 1A                ldy     ARG+4                   ; descriptor address hi (always $00)
001F5Dr 2  4C rr rr             jmp     FreTms
001F60r 2               
001F60r 2               ; Cleanup that releases both ARG's and FAC's temp descriptors (called from
001F60r 2               ; CatStr after content has been stashed but before new allocation).
001F60r 2               FreeBothTemps:
001F60r 2                       ; Free FAC's temp first (it is currently LASTPT).
001F60r 2  A5 11                lda     FAC+3
001F62r 2  A4 12                ldy     FAC+4
001F64r 2  20 rr rr             jsr     FreTms
001F67r 2                       ; Then ARG's (now LASTPT after FAC's removal).
001F67r 2  A5 19                lda     ARG+3
001F69r 2  A4 1A                ldy     ARG+4
001F6Br 2  4C rr rr             jmp     FreTms
001F6Er 2  60                   rts
001F6Fr 2               
001F6Fr 2               ; ===========================================================================
001F6Fr 2               ;   E V A L U A T O R   -   B I N A R Y   O P E R A T O R   H E L P E R S
001F6Fr 2               ; ===========================================================================
001F6Fr 2               
001F6Fr 2               ; ---------------------------------------------------------------------------
001F6Fr 2               ; AndOp -- FAC = ARG AND FAC (bitwise on 16-bit signed ints).
001F6Fr 2               ; ---------------------------------------------------------------------------
001F6Fr 2               AndOp:
001F6Fr 2  20 rr rr             jsr     AyInt                   ; FAC -> int (FAC+3=hi, FAC+4=lo)
001F72r 2  A5 11                lda     FAC+3
001F74r 2  85 3A                sta     BAS_TMP1                ; saved hi
001F76r 2  A5 12                lda     FAC+4
001F78r 2  85 3B                sta     BAS_TMP1+1              ; saved lo
001F7Ar 2  20 rr rr             jsr     CopyArgToFac
001F7Dr 2  20 rr rr             jsr     AyInt
001F80r 2  A5 12                lda     FAC+4
001F82r 2  25 3B                and     BAS_TMP1+1
001F84r 2  A8                   tay                             ; Y = lo result
001F85r 2  A5 11                lda     FAC+3
001F87r 2  25 3A                and     BAS_TMP1                ; A = hi result
001F89r 2  4C rr rr             jmp     GivAyf
001F8Cr 2               
001F8Cr 2               ; ---------------------------------------------------------------------------
001F8Cr 2               ; OrOp -- FAC = ARG OR FAC.
001F8Cr 2               ; ---------------------------------------------------------------------------
001F8Cr 2               OrOp:
001F8Cr 2  20 rr rr             jsr     AyInt
001F8Fr 2  A5 11                lda     FAC+3
001F91r 2  85 3A                sta     BAS_TMP1                ; saved hi
001F93r 2  A5 12                lda     FAC+4
001F95r 2  85 3B                sta     BAS_TMP1+1              ; saved lo
001F97r 2  20 rr rr             jsr     CopyArgToFac
001F9Ar 2  20 rr rr             jsr     AyInt
001F9Dr 2  A5 12                lda     FAC+4
001F9Fr 2  05 3B                ora     BAS_TMP1+1
001FA1r 2  A8                   tay                             ; Y = lo
001FA2r 2  A5 11                lda     FAC+3
001FA4r 2  05 3A                ora     BAS_TMP1                ; A = hi
001FA6r 2  4C rr rr             jmp     GivAyf
001FA9r 2               
001FA9r 2               ; ---------------------------------------------------------------------------
001FA9r 2               ; NotOp -- FAC = NOT FAC (bitwise complement of 16-bit signed int).
001FA9r 2               ; ---------------------------------------------------------------------------
001FA9r 2               NotOp:
001FA9r 2  20 rr rr             jsr     AyInt
001FACr 2  A5 12                lda     FAC+4
001FAEr 2  49 FF                eor     #$FF
001FB0r 2  A8                   tay                             ; Y = lo
001FB1r 2  A5 11                lda     FAC+3
001FB3r 2  49 FF                eor     #$FF                    ; A = hi
001FB5r 2  4C rr rr             jmp     GivAyf
001FB8r 2               
001FB8r 2               ; ---------------------------------------------------------------------------
001FB8r 2               ; BasCmdLet -- minimal LET (assignment).  Entered with ChrGot returning
001FB8r 2               ; the first letter of the variable name.  No `LET` keyword required.
001FB8r 2               ; ---------------------------------------------------------------------------
001FB8r 2               BasCmdLet:
001FB8r 2  20 rr rr             jsr     PtrGet                  ; VARPNT, VALTYP set; TXTPTR past name
001FBBr 2                       ; Save VARPNT and the variable's VALTYP across FrmEvl.
001FBBr 2  A5 3F                lda     VARPNT
001FBDr 2  48                   pha
001FBEr 2  A5 40                lda     VARPNT+1
001FC0r 2  48                   pha
001FC1r 2  A5 64                lda     VALTYP
001FC3r 2  48                   pha
001FC4r 2  20 rr rr             jsr     ChrGot
001FC7r 2  C9 3D                cmp     #'='
001FC9r 2  D0 36                bne     @synErr
001FCBr 2  20 rr rr             jsr     ChrGet
001FCEr 2  20 rr rr             jsr     FrmEvl
001FD1r 2  68                   pla                             ; saved variable VALTYP
001FD2r 2  85 3E                sta     BAS_TMP3
001FD4r 2  45 64                eor     VALTYP
001FD6r 2  30 2F                bmi     @typeErr
001FD8r 2  68                   pla
001FD9r 2  85 40                sta     VARPNT+1
001FDBr 2  68                   pla
001FDCr 2  85 3F                sta     VARPNT
001FDEr 2  24 3E                bit     BAS_TMP3
001FE0r 2  30 07                bmi     @storeStr
001FE2r 2                       ; Numeric: store FAC into (VARPNT) (5 bytes).
001FE2r 2  A6 3F                ldx     VARPNT
001FE4r 2  A4 40                ldy     VARPNT+1
001FE6r 2  4C rr rr             jmp     StoreFacAtYxRounded
001FE9r 2               @storeStr:
001FE9r 2  A0 00                ldy     #0
001FEBr 2  A5 0E                lda     FAC
001FEDr 2  91 3F                sta     (VARPNT),y
001FEFr 2  C8                   iny
001FF0r 2  A5 0F                lda     FAC+1
001FF2r 2  91 3F                sta     (VARPNT),y
001FF4r 2  C8                   iny
001FF5r 2  A5 10                lda     FAC+2
001FF7r 2  91 3F                sta     (VARPNT),y
001FF9r 2                       ; If the RHS was a temporary string (StrLt2/PutNew pushed it and left
001FF9r 2                       ; its descriptor address in FAC+3/FAC+4 == LASTPT), pop it now that
001FF9r 2                       ; the variable owns the heap copy.  Pop only (FreTms), never FreFac --
001FF9r 2                       ; reclaiming would free the string we just stored.  For a plain
001FF9r 2                       ; variable RHS, @loadStr set FAC+3/FAC+4 to that variable's address
001FF9r 2                       ; (nonzero high byte), which cannot match a temp slot, so FreTms is a
001FF9r 2                       ; no-op.  Without this, >3 consecutive string LETs leak the 3-slot
001FF9r 2                       ; temp stack (?FORMULA TOO COMPLEX).
001FF9r 2  A5 11                lda     FAC+3
001FFBr 2  A4 12                ldy     FAC+4
001FFDr 2  20 rr rr             jsr     FreTms
002000r 2  60                   rts
002001r 2               @synErr:
002001r 2  68                   pla
002002r 2  68                   pla
002003r 2  68                   pla
002004r 2  4C rr rr             jmp     SynErr
002007r 2               @typeErr:
002007r 2  68                   pla
002008r 2  68                   pla
002009r 2  A2 08                ldx     #ERR_TYPEMISM
00200Br 2  4C rr rr             jmp     BasErrorVec
00200Er 2               
00200Er 2               ; =============================================================================
00200Er 2               ;   C O N T R O L   F L O W   /   S T A T E M E N T   L O O P
00200Er 2               ;
00200Er 2               ;   BasNewstt drives execution for both direct mode (TXTPTR in BAS_TOKBUF)
00200Er 2               ;   and run mode (TXTPTR walks program lines from BAS_TXTTAB).  Statement
00200Er 2               ;   dispatch follows the msbasic convention: push (routine_addr - 1) and
00200Er 2               ;   tail-jump through ChrGet, so the routine entry is reached via RTS.
00200Er 2               ;
00200Er 2               ;   FOR and GOSUB store frames on the CPU stack and JMP back to BasNewstt;
00200Er 2               ;   NEXT and RETURN scan the stack for a matching tag, then TXS to discard
00200Er 2               ;   the frame and resume.
00200Er 2               ; =============================================================================
00200Er 2               
00200Er 2               NUM_STMT_TOKENS = TOK_MEM + 1 - TOK_BASE       ; $36 entries
00200Er 2               
00200Er 2               BasNewstt:
00200Er 2  20 rr rr             jsr     BasCheckBreak
002011r 2                       ; Save TXTPTR -> OLDTEXT for CONT, except in direct mode.
002011r 2  AD 6A 03             lda     BAS_CURLIN+1
002014r 2  C9 FF                cmp     #$FF
002016r 2  F0 0E                beq     @noSave
002018r 2  A5 04                lda     TXTPTR
00201Ar 2  8D 6D 03             sta     BAS_OLDTEXT
00201Dr 2  A5 05                lda     TXTPTR+1
00201Fr 2  8D 6E 03             sta     BAS_OLDTEXT+1
002022r 2                       ; And the stack depth this statement starts at: FOR and GOSUB frames
002022r 2                       ; are below it, anything a statement pushes is above.  A break restores
002022r 2                       ; SP to here, so the frames survive it and the half-finished statement
002022r 2                       ; does not -- which is what lets CONT resume inside a loop.  Recorded
002022r 2                       ; only in run mode: a direct-mode line must not move the baseline it is
002022r 2                       ; itself being run from.
002022r 2  BA                   tsx
002023r 2  8E 75 03             stx     BAS_STKBASE
002026r 2               @noSave:
002026r 2  A0 00                ldy     #0
002028r 2  B1 04                lda     (TXTPTR),y
00202Ar 2  F0 10                beq     @endLine
00202Cr 2  C9 A4                cmp     #TOK_ELSE
00202Er 2  F0 07                beq     @skipElse               ; THEN-branch ran; skip ELSE clause to EOL
002030r 2  C9 3A                cmp     #':'
002032r 2  F0 37                beq     @nextStmt
002034r 2  4C rr rr             jmp     SynErr
002037r 2               @skipElse:
002037r 2                       ; Advance TXTPTR until we land on a $00 terminator.
002037r 2               @skLoop:
002037r 2  20 rr rr             jsr     ChrGet
00203Ar 2  D0 FB                bne     @skLoop
00203Cr 2                       ; Fall through to @endLine with TXTPTR at $00.
00203Cr 2               @endLine:
00203Cr 2                       ; Direct mode: end of buffer -> back to REPL.
00203Cr 2  AD 6A 03             lda     BAS_CURLIN+1
00203Fr 2  C9 FF                cmp     #$FF
002041r 2  D0 03                bne     @walkNext
002043r 2  4C rr rr             jmp     BasReadyLoop            ; OK is printed by BasReadyLoop
002046r 2               @walkNext:
002046r 2                       ; Run mode: examine next-pointer at offsets +1,+2.
002046r 2  A0 02                ldy     #2
002048r 2  B1 04                lda     (TXTPTR),y
00204Ar 2  D0 09                bne     @loadLine               ; nonzero hi -> next line exists
00204Cr 2                       ; End of program -> halt and return to REPL.  The program ran off its
00204Cr 2                       ; last line rather than stopping, so its frames are finished with.
00204Cr 2  A2 FF                ldx     #$FF
00204Er 2  9A                   txs
00204Fr 2  8E 75 03             stx     BAS_STKBASE
002052r 2  4C rr rr             jmp     BasReadyLoop
002055r 2               @loadLine:
002055r 2  C8                   iny                             ; y=3
002056r 2  B1 04                lda     (TXTPTR),y
002058r 2  8D 69 03             sta     BAS_CURLIN
00205Br 2  C8                   iny                             ; y=4
00205Cr 2  B1 04                lda     (TXTPTR),y
00205Er 2  8D 6A 03             sta     BAS_CURLIN+1
002061r 2  98                   tya                             ; A=4
002062r 2  18                   clc
002063r 2  65 04                adc     TXTPTR
002065r 2  85 04                sta     TXTPTR
002067r 2  90 02                bcc     @nextStmt
002069r 2  E6 05                inc     TXTPTR+1
00206Br 2               @nextStmt:
00206Br 2  20 rr rr             jsr     ChrGet
00206Er 2  20 rr rr             jsr     BasExecuteStatement
002071r 2  4C rr rr             jmp     BasNewstt
002074r 2               
002074r 2               ; ---------------------------------------------------------------------------
002074r 2               ; BasExecuteStatement -- A = current tokenized byte (loaded by ChrGet).
002074r 2               ;   * A = 0  -> RTS (no-op; end of statement chain).
002074r 2               ;   * A < $80 (letter) -> JMP BasCmdLet.
002074r 2               ;   * A is a statement token ($80..TOK_MEM) -> dispatch via BasTokenAddrTbl.
002074r 2               ;   * Otherwise -> ?SYNTAX ERROR.
002074r 2               ; ---------------------------------------------------------------------------
002074r 2               BasExecuteStatement:
002074r 2  F0 30                beq     @ret
002076r 2  38                   sec
002077r 2  E9 80                sbc     #TOK_BASE
002079r 2  90 25                bcc     @doLet
00207Br 2  C9 36                cmp     #NUM_STMT_TOKENS
00207Dr 2  B0 0D                bcs     @ext
00207Fr 2  0A                   asl     a
002080r 2  A8                   tay
002081r 2  B9 rr rr             lda     BasTokenAddrTbl+1,y
002084r 2  48                   pha
002085r 2  B9 rr rr             lda     BasTokenAddrTbl,y
002088r 2  48                   pha
002089r 2  4C rr rr             jmp     ChrGet
00208Cr 2               @ext:
00208Cr 2                       ; Extended statement tokens DISK through NVERASE ($D1-$DF),
00208Cr 2                       ; dispatched through BasExtAddrTbl.
00208Cr 2  38                   sec
00208Dr 2  E9 51                sbc     #(TOK_DISK - TOK_BASE)
00208Fr 2  C9 0F                cmp     #(TOK_NVERASE + 1 - TOK_DISK)
002091r 2  B0 10                bcs     @synErr
002093r 2  0A                   asl     a
002094r 2  A8                   tay
002095r 2  B9 rr rr             lda     BasExtAddrTbl+1,y
002098r 2  48                   pha
002099r 2  B9 rr rr             lda     BasExtAddrTbl,y
00209Cr 2  48                   pha
00209Dr 2  4C rr rr             jmp     ChrGet
0020A0r 2               @doLet:
0020A0r 2  4C rr rr             jmp     BasCmdLet
0020A3r 2               @synErr:
0020A3r 2  4C rr rr             jmp     SynErr
0020A6r 2               @ret:
0020A6r 2  60                   rts
0020A7r 2               
0020A7r 2               ; ---------------------------------------------------------------------------
0020A7r 2               ; BasCheckBreak -- poll input buffer for Ctrl-C / ESC.  On break, save
0020A7r 2               ; CONT context and bounce to REPL.  Other keys are stashed in BAS_PENDKEY
0020A7r 2               ; for INKEY to retrieve.
0020A7r 2               ; ---------------------------------------------------------------------------
0020A7r 2               BasCheckBreak:
0020A7r 2                       ; In direct mode (CURLIN hi == $FF) skip the break check entirely;
0020A7r 2                       ; otherwise we would drain pending REPL keystrokes and corrupt the
0020A7r 2                       ; next BasReadLine input.  Break is only meaningful while RUNning.
0020A7r 2  AD 6A 03             lda     BAS_CURLIN+1
0020AAr 2  C9 FF                cmp     #$FF
0020ACr 2  F0 13                beq     @no
0020AEr 2  20 rr rr             jsr     BufferSize
0020B1r 2  F0 0E                beq     @no
0020B3r 2  20 rr rr             jsr     ReadBuffer
0020B6r 2  C9 03                cmp     #$03
0020B8r 2  F0 08                beq     @break
0020BAr 2  C9 1B                cmp     #$1B
0020BCr 2  F0 04                beq     @break
0020BEr 2  8D 0E 03             sta     BAS_PENDKEY
0020C1r 2               @no:
0020C1r 2  60                   rts
0020C2r 2               @break:
0020C2r 2                       ; OLDLIN/OLDTEXT already track the executing line.  Make sure the
0020C2r 2                       ; saved values reflect the current line so CONT can resume.
0020C2r 2  AD 69 03             lda     BAS_CURLIN
0020C5r 2  8D 6B 03             sta     BAS_OLDLIN
0020C8r 2  AD 6A 03             lda     BAS_CURLIN+1
0020CBr 2  8D 6C 03             sta     BAS_OLDLIN+1
0020CEr 2  AE 75 03             ldx     BAS_STKBASE             ; Back to the statement boundary, not to
0020D1r 2  9A                   txs                             ;   an empty stack: the loop this broke
0020D2r 2                                                       ;   out of is meant to still be there
0020D2r 2  20 rr rr             jsr     BasTextCRLF
0020D5r 2  A9 rr                lda     #<MsgBreak
0020D7r 2  A0 rr                ldy     #>MsgBreak
0020D9r 2  20 rr rr             jsr     BasPrintStr
0020DCr 2  4C rr rr             jmp     BasStopAtLine
0020DFr 2               
0020DFr 2  42 52 45 41  MsgBreak: .byte "BREAK",0
0020E3r 2  4B 00        
0020E5r 2               
0020E5r 2               ; ---------------------------------------------------------------------------
0020E5r 2               ; LinGet -- parse decimal digits at TXTPTR into BAS_LINNUM (16-bit).
0020E5r 2               ; Caller has set carry conditions appropriate to ChrGet entry.  TXTPTR
0020E5r 2               ; ends pointing at the first non-digit.
0020E5r 2               ; ---------------------------------------------------------------------------
0020E5r 2               LinGet:
0020E5r 2  A2 00                ldx     #0
0020E7r 2  86 08                stx     BAS_LINNUM
0020E9r 2  86 09                stx     BAS_LINNUM+1
0020EBr 2               @loop:
0020EBr 2  B0 3A                bcs     @done
0020EDr 2  E9 2F                sbc     #$2F                    ; carry already set
0020EFr 2  85 44                sta     CHARAC
0020F1r 2                       ; LINNUM *= 10
0020F1r 2  A5 08                lda     BAS_LINNUM
0020F3r 2  85 3A                sta     BAS_TMP1
0020F5r 2  A5 09                lda     BAS_LINNUM+1
0020F7r 2  85 3B                sta     BAS_TMP1+1
0020F9r 2  C9 19                cmp     #$19
0020FBr 2  B0 2B                bcs     @ovf
0020FDr 2  06 08                asl     BAS_LINNUM
0020FFr 2  26 09                rol     BAS_LINNUM+1
002101r 2  06 08                asl     BAS_LINNUM
002103r 2  26 09                rol     BAS_LINNUM+1
002105r 2  18                   clc
002106r 2  A5 08                lda     BAS_LINNUM
002108r 2  65 3A                adc     BAS_TMP1
00210Ar 2  85 08                sta     BAS_LINNUM
00210Cr 2  A5 09                lda     BAS_LINNUM+1
00210Er 2  65 3B                adc     BAS_TMP1+1
002110r 2  85 09                sta     BAS_LINNUM+1
002112r 2  06 08                asl     BAS_LINNUM
002114r 2  26 09                rol     BAS_LINNUM+1
002116r 2  18                   clc
002117r 2  A5 08                lda     BAS_LINNUM
002119r 2  65 44                adc     CHARAC
00211Br 2  85 08                sta     BAS_LINNUM
00211Dr 2  90 02                bcc     @nextDigit
00211Fr 2  E6 09                inc     BAS_LINNUM+1
002121r 2               @nextDigit:
002121r 2  20 rr rr             jsr     ChrGet
002124r 2  4C rr rr             jmp     @loop
002127r 2               @done:
002127r 2  60                   rts
002128r 2               @ovf:
002128r 2  A2 00                ldx     #ERR_SYNTAX
00212Ar 2  4C rr rr             jmp     BasErrorVec
00212Dr 2               
00212Dr 2               ; ---------------------------------------------------------------------------
00212Dr 2               ; FndLin -- find program line whose number matches BAS_LINNUM.
00212Dr 2               ;   On success: carry SET, BAS_TMP1 (LOWTR alias) = address of line.
00212Dr 2               ;   On failure: carry CLEAR, BAS_TMP1 = address where line would belong.
00212Dr 2               ; ---------------------------------------------------------------------------
00212Dr 2               FndLin:
00212Dr 2  AD 5D 03             lda     BAS_TXTTAB
002130r 2  AE 5E 03             ldx     BAS_TXTTAB+1
002133r 2               @walk:
002133r 2  85 3A                sta     BAS_TMP1
002135r 2  86 3B                stx     BAS_TMP1+1
002137r 2  A0 01                ldy     #1
002139r 2  B1 3A                lda     (BAS_TMP1),y
00213Br 2  F0 20                beq     @notFound               ; next-hi=0 -> end of program
00213Dr 2  A0 03                ldy     #3                      ; line-num-lo offset
00213Fr 2  A5 09                lda     BAS_LINNUM+1
002141r 2  D1 3A                cmp     (BAS_TMP1),y            ; compare hi byte at +3? need iny
002143r 2                       ; Actually format: +0 next-lo, +1 next-hi, +2 num-lo, +3 num-hi
002143r 2  90 18                bcc     @notFound               ; LINNUM-hi < line-hi -> miss
002145r 2  D0 09                bne     @advance                ; LINNUM-hi > line-hi -> next line
002147r 2  88                   dey                             ; y=2 = num-lo
002148r 2  A5 08                lda     BAS_LINNUM
00214Ar 2  D1 3A                cmp     (BAS_TMP1),y
00214Cr 2  90 0F                bcc     @notFound
00214Er 2  F0 0F                beq     @found
002150r 2               @advance:
002150r 2  A0 00                ldy     #0
002152r 2  B1 3A                lda     (BAS_TMP1),y
002154r 2  48                   pha
002155r 2  A0 01                ldy     #1
002157r 2  B1 3A                lda     (BAS_TMP1),y
002159r 2  AA                   tax
00215Ar 2  68                   pla
00215Br 2  B0 D6                bcs     @walk                   ; carry=1 means continue (always)
00215Dr 2               @notFound:
00215Dr 2  18                   clc
00215Er 2  60                   rts
00215Fr 2               @found:
00215Fr 2  38                   sec
002160r 2  60                   rts
002161r 2               
002161r 2               ; ---------------------------------------------------------------------------
002161r 2               ; BasCmdGoto -- TXTPTR points at line-number digits.
002161r 2               ; ---------------------------------------------------------------------------
002161r 2               BasCmdGoto:
002161r 2  20 rr rr             jsr     LinGet
002164r 2  20 rr rr             jsr     BasRemn                 ; skip remainder of statement
002167r 2  20 rr rr             jsr     FndLin
00216Ar 2  90 0E                bcc     @undef
00216Cr 2                       ; LOWTR (BAS_TMP1) = target line addr.  TXTPTR = LOWTR - 1
00216Cr 2                       ; (so NEWSTT sees the previous line's $00 terminator at offset 0).
00216Cr 2  38                   sec
00216Dr 2  A5 3A                lda     BAS_TMP1
00216Fr 2  E9 01                sbc     #1
002171r 2  85 04                sta     TXTPTR
002173r 2  A5 3B                lda     BAS_TMP1+1
002175r 2  E9 00                sbc     #0
002177r 2  85 05                sta     TXTPTR+1
002179r 2  60                   rts
00217Ar 2               @undef:
00217Ar 2  A2 03                ldx     #ERR_UNDEFSTMT
00217Cr 2  4C rr rr             jmp     BasErrorVec
00217Fr 2               
00217Fr 2               ; ---------------------------------------------------------------------------
00217Fr 2               ; BasCmdGosub -- push 5-byte frame on stack, then GOTO target.
00217Fr 2               ; Frame layout (top-down): [tag $8C][CURLIN-lo][CURLIN-hi][TXTPTR-lo][TXTPTR-hi]
00217Fr 2               ; ---------------------------------------------------------------------------
00217Fr 2               BasCmdGosub:
00217Fr 2                       ; Refuse to nest deeper than page 1 can hold.  msbasic guards every
00217Fr 2                       ; stack-frame push with GETSTK; this is that check specialised to
00217Fr 2                       ; GOSUB's fixed frame (msbasic's `LDA #3 : JSR GETSTK`, i.e. 3*2
00217Fr 2                       ; bytes of frame plus GETSTK's $3E-byte margin for the interpreter's
00217Fr 2                       ; own JSR nesting inside the subroutine).  Without it the frames run
00217Fr 2                       ; off the bottom of the stack and corrupt page 1 instead of raising
00217Fr 2                       ; an error.
00217Fr 2  BA                   tsx
002180r 2  E0 44                cpx     #GOSUB_STACK_MIN
002182r 2  90 1A                bcc     @outOfMemory
002184r 2  A5 05                lda     TXTPTR+1
002186r 2  48                   pha
002187r 2  A5 04                lda     TXTPTR
002189r 2  48                   pha
00218Ar 2  AD 6A 03             lda     BAS_CURLIN+1
00218Dr 2  48                   pha
00218Er 2  AD 69 03             lda     BAS_CURLIN
002191r 2  48                   pha
002192r 2  A9 8C                lda     #TOK_GOSUB
002194r 2  48                   pha
002195r 2  20 rr rr             jsr     ChrGot
002198r 2  20 rr rr             jsr     BasCmdGoto
00219Br 2  4C rr rr             jmp     BasNewstt
00219Er 2               @outOfMemory:
00219Er 2  A9 02                lda     #ERR_OUTOFMEM
0021A0r 2  4C rr rr             jmp     BasError
0021A3r 2               
0021A3r 2               ; ---------------------------------------------------------------------------
0021A3r 2               ; BasCmdReturn -- locate GOSUB frame on stack and resume at saved TXTPTR.
0021A3r 2               ; Per msbasic: scan the CPU stack from SP+5 (skipping return-routine's caller
0021A3r 2               ; return + this scan's own JSR return).  RTS at end pops the leaked
0021A3r 2               ; EXEC-return that GOSUB left behind.
0021A3r 2               ; ---------------------------------------------------------------------------
0021A3r 2               BasCmdReturn:
0021A3r 2  20 rr rr             jsr     GtForPnt
0021A6r 2                       ; X now points to the slot just BELOW a frame tag (or end of stack).
0021A6r 2  9A                   txs
0021A7r 2  C9 8C                cmp     #TOK_GOSUB
0021A9r 2  F0 05                beq     @ok
0021ABr 2  A2 0C                ldx     #ERR_RG
0021ADr 2  4C rr rr             jmp     BasErrorVec
0021B0r 2               @ok:
0021B0r 2  68                   pla                             ; tag (already in A, this discards)
0021B1r 2  68                   pla
0021B2r 2  8D 69 03             sta     BAS_CURLIN
0021B5r 2  68                   pla
0021B6r 2  8D 6A 03             sta     BAS_CURLIN+1
0021B9r 2  68                   pla
0021BAr 2  85 04                sta     TXTPTR
0021BCr 2  68                   pla
0021BDr 2  85 05                sta     TXTPTR+1
0021BFr 2                       ; Skip remainder of GOSUB-target statement (DATAN-style).
0021BFr 2  20 rr rr             jsr     BasDatan
0021C2r 2                       ; Advance TXTPTR by Y (number of bytes to terminator).
0021C2r 2  98                   tya
0021C3r 2  18                   clc
0021C4r 2  65 04                adc     TXTPTR
0021C6r 2  85 04                sta     TXTPTR
0021C8r 2  90 02                bcc     @noinc
0021CAr 2  E6 05                inc     TXTPTR+1
0021CCr 2               @noinc:
0021CCr 2  60                   rts
0021CDr 2               
0021CDr 2               ; ---------------------------------------------------------------------------
0021CDr 2               ; GtForPnt -- scan CPU stack for FOR/GOSUB frames.
0021CDr 2               ;   On entry: BAS_FORPNT (FORPNT) = $FFxx for "match any tag".
0021CDr 2               ;   Returns: X = stack pointer where the matching frame's tag-1 lives,
0021CDr 2               ;            A = tag byte found (or 0 if end-of-stack).  Z=1 if found tag,
0021CDr 2               ;            Z=0 (A=0) if no frame found.
0021CDr 2               ; ---------------------------------------------------------------------------
0021CDr 2               GtForPnt:
0021CDr 2  BA                   tsx
0021CEr 2  E8                   inx
0021CFr 2  E8                   inx
0021D0r 2  E8                   inx
0021D1r 2  E8                   inx
0021D2r 2               @scan:
0021D2r 2  BD 01 01             lda     $0101,x                 ; tag candidate
0021D5r 2  C9 81                cmp     #TOK_FOR
0021D7r 2  D0 25                bne     @notFor
0021D9r 2                       ; Compare frame's variable address to FORPNT.
0021D9r 2  A5 47                lda     BAS_FORPNT+1
0021DBr 2  D0 0A                bne     @skipVar                ; FORPNT+1 = $FF -> skip variable test
0021DDr 2  BD 02 01             lda     $0102,x
0021E0r 2  85 46                sta     BAS_FORPNT
0021E2r 2  BD 03 01             lda     $0103,x
0021E5r 2  85 47                sta     BAS_FORPNT+1
0021E7r 2               @skipVar:
0021E7r 2  DD 03 01             cmp     $0103,x
0021EAr 2  D0 07                bne     @advance
0021ECr 2  A5 46                lda     BAS_FORPNT
0021EEr 2  DD 02 01             cmp     $0102,x
0021F1r 2  F0 13                beq     @found
0021F3r 2               @advance:
0021F3r 2  8A                   txa
0021F4r 2  18                   clc
0021F5r 2  69 12                adc     #18                     ; BYTES_PER_FRAME (FOR)
0021F7r 2  AA                   tax
0021F8r 2  D0 D8                bne     @scan
0021FAr 2                       ; Walked off stack
0021FAr 2  A9 00                lda     #0
0021FCr 2  18                   clc                             ; not found
0021FDr 2  60                   rts
0021FEr 2               @notFor:
0021FEr 2  C9 8C                cmp     #TOK_GOSUB
002200r 2  F0 04                beq     @found
002202r 2  A9 00                lda     #0
002204r 2  18                   clc                             ; not found
002205r 2  60                   rts
002206r 2               @found:
002206r 2  38                   sec                             ; found; A still holds the tag or FORPNT
002207r 2  60                   rts
002208r 2               
002208r 2               ; ---------------------------------------------------------------------------
002208r 2               ; BasRemn -- scan TXTPTR forward to next ':' or end-of-line.
002208r 2               ; Sets Y to byte offset of terminator from current TXTPTR.  Honours quotes.
002208r 2               ; ---------------------------------------------------------------------------
002208r 2               BasDatan:
002208r 2  A2 3A                ldx     #':'
00220Ar 2  2C                   .byte   $2C                     ; BIT abs absorbs next 2-byte LDX
00220Br 2               BasRemn:
00220Br 2  A2 00                ldx     #0
00220Dr 2  86 44                stx     CHARAC
00220Fr 2  A0 00                ldy     #0
002211r 2  84 6A                sty     ENDCHR
002213r 2               @swap:
002213r 2  A5 6A                lda     ENDCHR
002215r 2  A6 44                ldx     CHARAC
002217r 2  85 44                sta     CHARAC
002219r 2  86 6A                stx     ENDCHR
00221Br 2               @scan:
00221Br 2  B1 04                lda     (TXTPTR),y
00221Dr 2  F0 0B                beq     @done
00221Fr 2  C5 6A                cmp     ENDCHR
002221r 2  F0 07                beq     @done
002223r 2  C8                   iny
002224r 2  C9 22                cmp     #'"'
002226r 2  F0 EB                beq     @swap
002228r 2  D0 F1                bne     @scan
00222Ar 2               @done:
00222Ar 2  60                   rts
00222Br 2               
00222Br 2               ; ---------------------------------------------------------------------------
00222Br 2               ; Statement: REM -- skip to end of line.
00222Br 2               ; Statement: DATA -- treated like REM at execution time (just skip).
00222Br 2               ; ---------------------------------------------------------------------------
00222Br 2               BasCmdRem:
00222Br 2  20 rr rr             jsr     BasRemn
00222Er 2  80 03                bra     BasAddon
002230r 2               BasCmdData:
002230r 2  20 rr rr             jsr     BasDatan
002233r 2               BasAddon:
002233r 2  98                   tya
002234r 2  18                   clc
002235r 2  65 04                adc     TXTPTR
002237r 2  85 04                sta     TXTPTR
002239r 2  90 02                bcc     @done
00223Br 2  E6 05                inc     TXTPTR+1
00223Dr 2               @done:
00223Dr 2  60                   rts
00223Er 2               
00223Er 2               ; ---------------------------------------------------------------------------
00223Er 2               ; Statement: IF expr THEN (linenum | stmt) [ELSE stmt]
00223Er 2               ;   IF expr GOTO linenum is also accepted.
00223Er 2               ;   If expr is false, skip rest of line (REM-style).
00223Er 2               ;   ELSE: scan ahead for TOK_ELSE on this line.
00223Er 2               ; ---------------------------------------------------------------------------
00223Er 2               BasCmdIf:
00223Er 2  20 rr rr             jsr     FrmEvl
002241r 2  20 rr rr             jsr     ChrGot
002244r 2  C9 88                cmp     #TOK_GOTO
002246r 2  F0 05                beq     @testTrue
002248r 2  A9 9F                lda     #TOK_THEN
00224Ar 2  20 rr rr             jsr     SynChr
00224Dr 2               @testTrue:
00224Dr 2  A5 0E                lda     FAC
00224Fr 2  D0 1E                bne     @true
002251r 2                       ; FALSE: scan to end-of-line OR a TOK_ELSE; if ELSE found, advance
002251r 2                       ; TXTPTR past it and resume execution there.
002251r 2  A0 00                ldy     #0
002253r 2               @searchElse:
002253r 2  B1 04                lda     (TXTPTR),y
002255r 2  F0 07                beq     @noElse
002257r 2  C9 A4                cmp     #TOK_ELSE
002259r 2  F0 09                beq     @gotElse
00225Br 2  C8                   iny
00225Cr 2  D0 F5                bne     @searchElse
00225Er 2               @noElse:
00225Er 2                       ; Skip remainder of line (no ELSE).
00225Er 2  20 rr rr             jsr     BasRemn
002261r 2  4C rr rr             jmp     BasAddon
002264r 2               @gotElse:
002264r 2                       ; Advance TXTPTR past ELSE token, then run the ELSE branch as a
002264r 2                       ; statement.  Falling through to @true's tail is deliberate: the
002264r 2                       ; branch after ELSE is dispatched exactly like the one after THEN,
002264r 2                       ; so `ELSE <linenum>` is an implicit GOTO too.  Returning here
002264r 2                       ; instead would leave TXTPTR mid-statement and the interpreter loop
002264r 2                       ; would report ?SYNTAX ERROR.
002264r 2  C8                   iny
002265r 2  98                   tya
002266r 2  18                   clc
002267r 2  65 04                adc     TXTPTR
002269r 2  85 04                sta     TXTPTR
00226Br 2  90 02                bcc     @true
00226Dr 2  E6 05                inc     TXTPTR+1
00226Fr 2               @true:
00226Fr 2                       ; TRUE: if next is a digit, IF expr THEN <linenum> -> implicit GOTO.
00226Fr 2  20 rr rr             jsr     ChrGot
002272r 2  90 03                bcc     @goto                   ; carry CLEAR -> digit
002274r 2                       ; Otherwise dispatch as a statement (msbasic: jmp EXECUTE_STATEMENT).
002274r 2  4C rr rr             jmp     BasExecuteStatement
002277r 2               @goto:
002277r 2  4C rr rr             jmp     BasCmdGoto
00227Ar 2               
00227Ar 2               ; ---------------------------------------------------------------------------
00227Ar 2               ; Statement: ON expr GOTO/GOSUB linenum,linenum,...
00227Ar 2               ; ---------------------------------------------------------------------------
00227Ar 2               BasCmdOn:
00227Ar 2  20 rr rr             jsr     GetByt                  ; X = expr byte (1..255)
00227Dr 2  48                   pha                             ; save GOTO/GOSUB token byte
00227Er 2  C9 8C                cmp     #TOK_GOSUB
002280r 2  F0 04                beq     @loop
002282r 2  C9 88                cmp     #TOK_GOTO
002284r 2  D0 14                bne     @synErr
002286r 2               @loop:
002286r 2  C6 12                dec     FAC+4
002288r 2  D0 04                bne     @next
00228Ar 2  68                   pla
00228Br 2                       ; Re-dispatch through statement table so trampoline ChrGet skips the
00228Br 2                       ; current separator (',' or 0) before the GOTO/GOSUB handler runs.
00228Br 2  4C rr rr             jmp     BasExecuteStatement
00228Er 2               @next:
00228Er 2  20 rr rr             jsr     ChrGet
002291r 2  20 rr rr             jsr     LinGet
002294r 2  C9 2C                cmp     #','
002296r 2  F0 EE                beq     @loop
002298r 2  68                   pla
002299r 2  60                   rts
00229Ar 2               @synErr:
00229Ar 2  68                   pla
00229Br 2  4C rr rr             jmp     SynErr
00229Er 2               
00229Er 2               ; ---------------------------------------------------------------------------
00229Er 2               ; GetByt / GtByteCom -- evaluate expression in TXTPTR to byte 0..255 in X.
00229Er 2               ;   GetByt: TXTPTR is at first byte of expression.
00229Er 2               ;   GtByteCom: consume comma first.
00229Er 2               ; ---------------------------------------------------------------------------
00229Er 2               GtByteCom:
00229Er 2  20 rr rr             jsr     ChrGet
0022A1r 2               GetByt:
0022A1r 2  20 rr rr             jsr     FrmNum
0022A4r 2  20 rr rr             jsr     MkInt
0022A7r 2  A6 11                ldx     FAC+3
0022A9r 2  D0 05                bne     @ovf
0022ABr 2  A6 12                ldx     FAC+4
0022ADr 2  4C rr rr             jmp     ChrGot
0022B0r 2               @ovf:
0022B0r 2  4C rr rr             jmp     IqErr
0022B3r 2               
0022B3r 2               ; ---------------------------------------------------------------------------
0022B3r 2               ; Statement: RUN [linenum]
0022B3r 2               ; ---------------------------------------------------------------------------
0022B3r 2               BasCmdRun:
0022B3r 2  20 rr rr             jsr     ChrGot
0022B6r 2  D0 21                bne     @withLine
0022B8r 2  20 rr rr             jsr     BasCmdClr
0022BBr 2                       ; Set TXTPTR = TXTTAB - 1 ; ensure that byte = 0.
0022BBr 2  38                   sec
0022BCr 2  AD 5D 03             lda     BAS_TXTTAB
0022BFr 2  E9 01                sbc     #1
0022C1r 2  85 04                sta     TXTPTR
0022C3r 2  AD 5E 03             lda     BAS_TXTTAB+1
0022C6r 2  E9 00                sbc     #0
0022C8r 2  85 05                sta     TXTPTR+1
0022CAr 2                       ; Force the byte at TXTTAB-1 to be zero so NEWSTT walks the chain.
0022CAr 2  A9 00                lda     #0
0022CCr 2  A0 00                ldy     #0
0022CEr 2  91 04                sta     (TXTPTR),y
0022D0r 2                       ; Leave direct-mode (CURLIN+1=$FF); @loadLine will set real value.
0022D0r 2  9C 69 03             stz     BAS_CURLIN
0022D3r 2  9C 6A 03             stz     BAS_CURLIN+1
0022D6r 2                       ; Straight back into the statement loop rather than RTS, as msbasic's
0022D6r 2                       ; RUN does: CLR above has just reset the stack, so the return address
0022D6r 2                       ; this was dispatched with is no longer on it -- which is the point.  A
0022D6r 2                       ; program that starts on top of a suspended one's FOR frames is a
0022D6r 2                       ; program whose first NEXT can find the wrong loop.
0022D6r 2  4C rr rr             jmp     BasNewstt
0022D9r 2               @withLine:
0022D9r 2  20 rr rr             jsr     BasCmdClr
0022DCr 2  20 rr rr             jsr     ChrGot
0022DFr 2  20 rr rr             jsr     BasCmdGoto              ; does not return if the line is undefined
0022E2r 2                       ; Leave direct mode, exactly as the bare RUN path above does.
0022E2r 2                       ; BasCmdGoto only moves TXTPTR; while CURLIN+1 is still $FF, BasNewstt
0022E2r 2                       ; treats the branch target as an immediate-mode statement and returns
0022E2r 2                       ; to the READY loop after it -- so `RUN 20` printed nothing at all.
0022E2r 2                       ; Set after the branch, not before, so an undefined line still reports
0022E2r 2                       ; `?UNDEF'D STATEMENT ERROR` with no spurious `IN 0` line number.
0022E2r 2  9C 69 03             stz     BAS_CURLIN
0022E5r 2  9C 6A 03             stz     BAS_CURLIN+1
0022E8r 2  4C rr rr             jmp     BasNewstt               ; as the bare path above: CLR reset the
0022EBr 2                                                       ;   stack this was dispatched from
0022EBr 2               
0022EBr 2               ; ---------------------------------------------------------------------------
0022EBr 2               ; Statement: END / STOP -- save CONT context and return to REPL.
0022EBr 2               ; ---------------------------------------------------------------------------
0022EBr 2               BasCmdEnd:
0022EBr 2  18                   clc
0022ECr 2  24                   .byte   $24                     ; BIT zp -> skip next byte (sec)
0022EDr 2               BasCmdStop:
0022EDr 2  38                   sec
0022EEr 2                       ; Save the END/STOP flag (carry) before ChrGot clobbers it.
0022EEr 2  08                   php
0022EFr 2  20 rr rr             jsr     ChrGot
0022F2r 2  D0 2D                bne     @synErrPlp
0022F4r 2  28                   plp
0022F5r 2                       ; Save CONT state.
0022F5r 2  A5 04                lda     TXTPTR
0022F7r 2  8D 6D 03             sta     BAS_OLDTEXT
0022FAr 2  A5 05                lda     TXTPTR+1
0022FCr 2  8D 6E 03             sta     BAS_OLDTEXT+1
0022FFr 2  AD 69 03             lda     BAS_CURLIN
002302r 2  8D 6B 03             sta     BAS_OLDLIN
002305r 2  AD 6A 03             lda     BAS_CURLIN+1
002308r 2  8D 6C 03             sta     BAS_OLDLIN+1
00230Br 2  AE 75 03             ldx     BAS_STKBASE             ; As with a Ctrl+C break: keep the FOR
00230Er 2  9A                   txs                             ;   and GOSUB frames for CONT
00230Fr 2  90 0D                bcc     @end
002311r 2                       ; STOP path: print "BREAK[ IN nnnn]".
002311r 2  20 rr rr             jsr     BasTextCRLF
002314r 2  A9 rr                lda     #<MsgBreak
002316r 2  A0 rr                ldy     #>MsgBreak
002318r 2  20 rr rr             jsr     BasPrintStr
00231Br 2  4C rr rr             jmp     BasStopAtLine
00231Er 2               @end:
00231Er 2  4C rr rr             jmp     BasStopDirect
002321r 2               @synErrPlp:
002321r 2  28                   plp
002322r 2               @synErr:
002322r 2  4C rr rr             jmp     SynErr
002325r 2               
002325r 2               ; ---------------------------------------------------------------------------
002325r 2               ; Statement: CONT -- resume execution from saved OLDTEXT/OLDLIN.
002325r 2               ; ---------------------------------------------------------------------------
002325r 2               BasCmdCont:
002325r 2  20 rr rr             jsr     ChrGot
002328r 2  D0 21                bne     @synErr
00232Ar 2  AD 6E 03             lda     BAS_OLDTEXT+1
00232Dr 2  D0 05                bne     @canCont
00232Fr 2  A2 10                ldx     #ERR_CANTCONT
002331r 2  4C rr rr             jmp     BasErrorVec
002334r 2               @canCont:
002334r 2  AD 6D 03             lda     BAS_OLDTEXT
002337r 2  85 04                sta     TXTPTR
002339r 2  AD 6E 03             lda     BAS_OLDTEXT+1
00233Cr 2  85 05                sta     TXTPTR+1
00233Er 2  AD 6B 03             lda     BAS_OLDLIN
002341r 2  8D 69 03             sta     BAS_CURLIN
002344r 2  AD 6C 03             lda     BAS_OLDLIN+1
002347r 2  8D 6A 03             sta     BAS_CURLIN+1
00234Ar 2  60                   rts
00234Br 2               @synErr:
00234Br 2  4C rr rr             jmp     SynErr
00234Er 2               
00234Er 2               ; ---------------------------------------------------------------------------
00234Er 2               ; Statement: RESTORE -- DATAPTR := TXTTAB - 1.
00234Er 2               ; ---------------------------------------------------------------------------
00234Er 2               BasCmdRestore:
00234Er 2  38                   sec
00234Fr 2  AD 5D 03             lda     BAS_TXTTAB
002352r 2  E9 01                sbc     #1
002354r 2  8D 1A 03             sta     BAS_DATAPTR
002357r 2  AD 5E 03             lda     BAS_TXTTAB+1
00235Ar 2  E9 00                sbc     #0
00235Cr 2  8D 1B 03             sta     BAS_DATAPTR+1
00235Fr 2  60                   rts
002360r 2               
002360r 2               ; ---------------------------------------------------------------------------
002360r 2               ; Statement: INPUT [<"prompt">{,;}] var[,var,...]
002360r 2               ;   Prompts user for input, reads a line, parses it into the variable list.
002360r 2               ;   "abc";VAR  prints  abc?    (question + space appended)
002360r 2               ;   "abc",VAR  prints  abc      (no question mark)
002360r 2               ;   no prompt: prints  ?
002360r 2               ;   On bad numeric input or premature end-of-line: "?REDO FROM START"
002360r 2               ;   and reprompt.  Trailing un-consumed input: "?EXTRA IGNORED".
002360r 2               ; ---------------------------------------------------------------------------
002360r 2               BasCmdInput:
002360r 2                       ; INPUT is illegal in direct mode.
002360r 2  AD 6A 03             lda     BAS_CURLIN+1
002363r 2  C9 FF                cmp     #$FF
002365r 2  D0 05                bne     @notDirect
002367r 2  A2 07                ldx     #ERR_ILLDIRECT
002369r 2  4C rr rr             jmp     BasErrorVec
00236Cr 2               @notDirect:
00236Cr 2                       ; ChrGot returns first char after the INPUT token.
00236Cr 2  20 rr rr             jsr     ChrGot
00236Fr 2  C9 22                cmp     #'"'
002371r 2  D0 27                bne     @noPrompt
002373r 2                       ; Parse string literal & print it; FrmEvl will leave descriptor in FAC.
002373r 2  20 rr rr             jsr     FrmEvl
002376r 2  20 rr rr             jsr     ChkStr
002379r 2  20 rr rr             jsr     PrintStrFAC
00237Cr 2  20 rr rr             jsr     FreFac
00237Fr 2  20 rr rr             jsr     ChrGot
002382r 2  C9 3B                cmp     #';'
002384r 2  F0 09                beq     @semi
002386r 2  C9 2C                cmp     #','
002388r 2  D0 0D                bne     @badPrompt
00238Ar 2  20 rr rr             jsr     ChrGet                  ; consume ','
00238Dr 2  80 0E                bra     @afterPrompt
00238Fr 2               @semi:
00238Fr 2  20 rr rr             jsr     ChrGet                  ; consume ';'
002392r 2  20 rr rr             jsr     BasInpQues              ; '? '
002395r 2  80 06                bra     @afterPrompt
002397r 2               @badPrompt:
002397r 2  4C rr rr             jmp     SynErr
00239Ar 2               @noPrompt:
00239Ar 2  20 rr rr             jsr     BasInpQues              ; '? '
00239Dr 2               @afterPrompt:
00239Dr 2                       ; Save program TXTPTR (start of var-list) for REDO retry.
00239Dr 2  A5 04                lda     TXTPTR
00239Fr 2  8D 71 03             sta     BAS_INPSAV
0023A2r 2  A5 05                lda     TXTPTR+1
0023A4r 2  8D 72 03             sta     BAS_INPSAV+1
0023A7r 2               @retry:
0023A7r 2  20 rr rr             jsr     BasReadLine             ; reads to BAS_LINBUF, NUL-terminated, prints CRLF
0023AAr 2                       ; Set up data pointer with leading ',' sentinel just before LINBUF.
0023AAr 2  A9 2C                lda     #','
