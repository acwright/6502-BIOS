002A0Dr 2  68                   pla
002A0Er 2  85 21                sta     INDEX+1
002A10r 2  8A                   txa
002A11r 2  A0 00                ldy     #0
002A13r 2  91 20                sta     (INDEX),y
002A15r 2  60                   rts
002A16r 2               
002A16r 2               ; LOAD ["name"] / LOAD (bare) / LOAD "name"
002A16r 2               BasCmdLoad:
002A16r 2  20 rr rr             jsr     ChrGot
002A19r 2  F0 02                beq     @bare
002A1Br 2  80 19                bra     @cf                     ; any argument is a filename expression
002A1Dr 2               @bare:
002A1Dr 2  A9 10                lda     #HW_SC
002A1Fr 2  20 rr rr             jsr     ReqHw
002A22r 2  A9 00                lda     #<PROGRAM_START
002A24r 2  85 2A                sta     XFER_PTR
002A26r 2  A9 08                lda     #>PROGRAM_START
002A28r 2  85 2B                sta     XFER_PTR+1
002A2Ar 2  20 rr rr             jsr     XModemLoad
002A2Dr 2                       ; XMODEM rounds up to a 128-byte block, so this can overshoot the true
002A2Dr 2                       ; end by up to 127 bytes: it wastes a little variable space, never
002A2Dr 2                       ; truncates.
002A2Dr 2  AD 17 03             lda     XFER_REMAIN
002A30r 2  AC 18 03             ldy     XFER_REMAIN+1
002A33r 2  4C rr rr             jmp     BasFixChain
002A36r 2               @cf:
002A36r 2  A9 08                lda     #HW_CF
002A38r 2  20 rr rr             jsr     ReqHw
002A3Br 2  20 rr rr             jsr     EvalString
002A3Er 2  20 rr rr             jsr     FsLoadFile
002A41r 2  B0 09                bcs     @err
002A43r 2  AD 4A 03             lda     FS_FILE_SIZE
002A46r 2  AC 4B 03             ldy     FS_FILE_SIZE+1
002A49r 2  4C rr rr             jmp     BasFixChain
002A4Cr 2               @err:
002A4Cr 2  A9 rr                lda     #<MsgLoadErr
002A4Er 2  A0 rr                ldy     #>MsgLoadErr
002A50r 2  4C rr rr             jmp     BasPrintStr
002A53r 2               
002A53r 2               ; SAVE / SAVE "name"
002A53r 2               BasCmdSave:
002A53r 2  20 rr rr             jsr     ChrGot
002A56r 2  F0 02                beq     @bare
002A58r 2  80 21                bra     @cf                     ; any argument is a filename expression
002A5Ar 2               @bare:
002A5Ar 2  A9 10                lda     #HW_SC
002A5Cr 2  20 rr rr             jsr     ReqHw
002A5Fr 2  A9 00                lda     #<PROGRAM_START
002A61r 2  85 2A                sta     XFER_PTR
002A63r 2  A9 08                lda     #>PROGRAM_START
002A65r 2  85 2B                sta     XFER_PTR+1
002A67r 2  38                   sec
002A68r 2  AD 5F 03             lda     BAS_VARTAB
002A6Br 2  E9 00                sbc     #<PROGRAM_START
002A6Dr 2  8D 17 03             sta     XFER_REMAIN
002A70r 2  AD 60 03             lda     BAS_VARTAB+1
002A73r 2  E9 08                sbc     #>PROGRAM_START
002A75r 2  8D 18 03             sta     XFER_REMAIN+1
002A78r 2  4C rr rr             jmp     XModemSave
002A7Br 2               @cf:
002A7Br 2  A9 08                lda     #HW_CF
002A7Dr 2  20 rr rr             jsr     ReqHw
002A80r 2  20 rr rr             jsr     EvalString
002A83r 2  38                   sec
002A84r 2  AD 5F 03             lda     BAS_VARTAB
002A87r 2  E9 00                sbc     #<PROGRAM_START
002A89r 2  8D 4A 03             sta     FS_FILE_SIZE
002A8Cr 2  AD 60 03             lda     BAS_VARTAB+1
002A8Fr 2  E9 08                sbc     #>PROGRAM_START
002A91r 2  8D 4B 03             sta     FS_FILE_SIZE+1
002A94r 2  20 rr rr             jsr     FsSaveFile
002A97r 2  B0 01                bcs     @err
002A99r 2  60                   rts
002A9Ar 2               @err:
002A9Ar 2  A9 rr                lda     #<MsgSaveErr
002A9Cr 2  A0 rr                ldy     #>MsgSaveErr
002A9Er 2  4C rr rr             jmp     BasPrintStr
002AA1r 2               
002AA1r 2               ; DIR
002AA1r 2               BasCmdDir:
002AA1r 2  A9 08                lda     #HW_CF
002AA3r 2  20 rr rr             jsr     ReqHw
002AA6r 2  4C rr rr             jmp     FsDirectory
002AA9r 2               
002AA9r 2               ; DEL "name"
002AA9r 2               BasCmdDel:
002AA9r 2  A9 08                lda     #HW_CF
002AABr 2  20 rr rr             jsr     ReqHw
002AAEr 2  20 rr rr             jsr     EvalString
002AB1r 2  20 rr rr             jsr     FsDeleteFile
002AB4r 2  B0 01                bcs     @err
002AB6r 2  60                   rts
002AB7r 2               @err:
002AB7r 2  A9 rr                lda     #<MsgDelErr
002AB9r 2  A0 rr                ldy     #>MsgDelErr
002ABBr 2  4C rr rr             jmp     BasPrintStr
002ABEr 2               
002ABEr 2               ; MEM -- print "nnnnn BYTES FREE  HW=$xx"
002ABEr 2               BasCmdMem:
002ABEr 2                       ; Free bytes = MEMSIZ - VARTAB
002ABEr 2  38                   sec
002ABFr 2  AD 67 03             lda     BAS_MEMSIZ
002AC2r 2  ED 5F 03             sbc     BAS_VARTAB
002AC5r 2  A8                   tay
002AC6r 2  AD 68 03             lda     BAS_MEMSIZ+1
002AC9r 2  ED 60 03             sbc     BAS_VARTAB+1
002ACCr 2  20 rr rr             jsr     GivAyf                  ; FAC = unsigned int from (Y,A)
002ACFr 2                       ; Wait: GivAyf is signed.  For this simple display, OK if < 32768.
002ACFr 2  20 rr rr             jsr     PrintNum
002AD2r 2  A9 rr                lda     #<MsgFree
002AD4r 2  A0 rr                ldy     #>MsgFree
002AD6r 2  20 rr rr             jsr     BasPrintStr
002AD9r 2  A9 24                lda     #'$'
002ADBr 2  20 rr rr             jsr     Chrout
002ADEr 2  AD 0D 03             lda     HW_PRESENT
002AE1r 2  20 rr rr             jsr     PrintHexByte
002AE4r 2  20 rr rr             jsr     BasPrintCRLF
002AE7r 2  4C rr rr             jmp     FsPrintDisk             ; print "DISK n" line
002AEAr 2               
002AEAr 2  20 42 59 54  MsgFree:        .byte   " BYTES FREE  HW=",0
002AEEr 2  45 53 20 46  
002AF2r 2  52 45 45 20  
002AFBr 2  3F 4C 4F 41  MsgLoadErr:     .byte   "?LOAD ERROR",$0D,$0A,0
002AFFr 2  44 20 45 52  
002B03r 2  52 4F 52 0D  
