00188Dr 2               ; (Removed in Phase 8: _VARTEST debug harness lived here.)
00188Dr 2               VT_SetTxt:
00188Dr 2                       ; Set TXTPTR = VT_TXTPTR_TMP - 1 then ChrGet to load first char.
00188Dr 2                       ; Actually simpler: caller passes (Y,A) = pointer; we set TXTPTR =
00188Dr 2                       ; (Y,A) - 1 and call ChrGet to land on (Y,A).
00188Dr 2                       sta     TXTPTR
00188Dr 2                       sty     TXTPTR+1
00188Dr 2                       lda     TXTPTR
00188Dr 2                       bne     @nb
00188Dr 2                       dec     TXTPTR+1
00188Dr 2               @nb:
00188Dr 2                       dec     TXTPTR
00188Dr 2                       jmp     ChrGet
00188Dr 2               
00188Dr 2               VT_StoreFAC:
00188Dr 2                       ; Round and store FAC at (VARPNT).
00188Dr 2                       ldx     VARPNT
00188Dr 2                       ldy     VARPNT+1
00188Dr 2                       jmp     StoreFacAtYxRounded
00188Dr 2               
00188Dr 2               VT_LoadFAC:
00188Dr 2                       ; Load FAC from (VARPNT).
00188Dr 2                       lda     VARPNT
00188Dr 2                       ldy     VARPNT+1
00188Dr 2                       jmp     LoadFacFromYa
00188Dr 2               
00188Dr 2               VT_VPSAVE       = $86           ; 2-byte ZP VARPNT save (_VARTEST debug)
00188Dr 2               
00188Dr 2               BasCmdVarTest:
00188Dr 2                       jsr     BasCmdClr
00188Dr 2               
00188Dr 2                       ; --- Test 1: A=3.14, B=A*2 ---
00188Dr 2                       lda     #<VT_NameA
00188Dr 2                       ldy     #>VT_NameA
00188Dr 2                       jsr     VT_SetTxt
00188Dr 2                       jsr     PtrGet                  ; creates A; VARPNT -> A's value
00188Dr 2                       ; FAC = 3.14
00188Dr 2                       lda     #<VT_pi
00188Dr 2                       ldy     #>VT_pi
00188Dr 2                       jsr     LoadFacFromYa
00188Dr 2                       jsr     VT_StoreFAC
00188Dr 2               
00188Dr 2                       lda     #<VT_NameB
00188Dr 2                       ldy     #>VT_NameB
00188Dr 2                       jsr     VT_SetTxt
00188Dr 2                       jsr     PtrGet                  ; creates B
00188Dr 2                       ; Save B's VARPNT.
00188Dr 2                       lda     VARPNT
00188Dr 2                       sta     VT_VPSAVE
00188Dr 2                       lda     VARPNT+1
00188Dr 2                       sta     VT_VPSAVE+1
00188Dr 2               
00188Dr 2                       ; Look up A again (already exists).
00188Dr 2                       lda     #<VT_NameA
00188Dr 2                       ldy     #>VT_NameA
00188Dr 2                       jsr     VT_SetTxt
00188Dr 2                       jsr     PtrGet
00188Dr 2                       jsr     VT_LoadFAC              ; FAC = A = 3.14
00188Dr 2                       ; Multiply by 2.
00188Dr 2                       lda     #<FpC2
00188Dr 2                       ldy     #>FpC2
00188Dr 2                       jsr     FMult                   ; FAC = 2 * FAC = 6.28
00188Dr 2                       ; Store into B.
00188Dr 2                       ldx     VT_VPSAVE
00188Dr 2                       ldy     VT_VPSAVE+1
00188Dr 2                       jsr     StoreFacAtYxRounded
00188Dr 2               
00188Dr 2                       ; Print result.
00188Dr 2                       lda     #<MsgVT_A
00188Dr 2                       ldy     #>MsgVT_A
00188Dr 2                       jsr     BasPrintStr
00188Dr 2                       ; Reload B and print.
00188Dr 2                       lda     VT_VPSAVE
00188Dr 2                       ldy     VT_VPSAVE+1
00188Dr 2                       jsr     LoadFacFromYa
00188Dr 2                       jsr     BasPrintFAC
00188Dr 2                       jsr     BasPrintCRLF
00188Dr 2               
00188Dr 2                       ; --- Test 2: A$="HELLO" ---
00188Dr 2                       lda     #<VT_NameAS
00188Dr 2                       ldy     #>VT_NameAS
00188Dr 2                       jsr     VT_SetTxt
00188Dr 2                       jsr     PtrGet                  ; creates A$
00188Dr 2                       ; Save VARPNT (A$ descriptor address).
00188Dr 2                       lda     VARPNT
00188Dr 2                       sta     VT_VPSAVE
00188Dr 2                       lda     VARPNT+1
00188Dr 2                       sta     VT_VPSAVE+1
00188Dr 2                       ; Allocate space, copy "HELLO" via StrLit.
00188Dr 2                       lda     #<VT_HelloLit
00188Dr 2                       ldy     #>VT_HelloLit
00188Dr 2                       jsr     StrLit                  ; FAC has descriptor, in temp stack
00188Dr 2                       ; Now copy descriptor (3 bytes from temp stack entry) to A$ var.
00188Dr 2                       ; FAC+3,4 points at the temp descriptor; FAC = length, FAC+1/2 = addr.
00188Dr 2                       ; The descriptor lives in TEMPST.  We just write [len][lo][hi] into
00188Dr 2                       ; (VARPNT) so the variable now references the heap copy.
00188Dr 2                       lda     FAC
00188Dr 2                       ldy     #$00
00188Dr 2                       sta     (VT_VPSAVE),y           ; length
00188Dr 2                       lda     FAC+1
00188Dr 2                       iny
00188Dr 2                       sta     (VT_VPSAVE),y           ; addr lo
00188Dr 2                       lda     FAC+2
00188Dr 2                       iny
00188Dr 2                       sta     (VT_VPSAVE),y           ; addr hi
00188Dr 2                       ; Print length.
00188Dr 2                       lda     #<MsgVT_AS
00188Dr 2                       ldy     #>MsgVT_AS
00188Dr 2                       jsr     BasPrintStr
00188Dr 2                       ldy     #$00
00188Dr 2                       lda     (VT_VPSAVE),y
00188Dr 2                       tay
00188Dr 2                       jsr     SngFlt
00188Dr 2                       jsr     BasPrintFAC
00188Dr 2                       jsr     BasPrintCRLF
00188Dr 2               
00188Dr 2                       ; --- Test 3: DIM N(10), N(5)=42 ---
00188Dr 2                       ; Build TXTPTR pointing at "N(10) " and call MakInt-equivalent path.
00188Dr 2                       ; Easier: directly construct array via PtrGet3 + Array by simulating
00188Dr 2                       ; a 1-D DIM of size 11 (indices 0..10).  We emulate the parser:
00188Dr 2                       ;   1. Set DIMFLG = $40, VARNAM = ('N','N'), call PtrGet3 with X=1?
00188Dr 2                       ;   2. Or: just do PtrGet3 entry by hand then jmp Array.
00188Dr 2                       ; Simplest: set TXTPTR at "N(10) ", DIMFLG <- $40 (from DIM
00188Dr 2                       ; statement), then PtrGet3 with VARNAM letter, jmp to '(' branch.
00188Dr 2                       lda     #<VT_DimN10
00188Dr 2                       ldy     #>VT_DimN10
00188Dr 2                       jsr     VT_SetTxt               ; A = 'N'
00188Dr 2                       ldx     #$40                    ; from-DIM flag (bit 6)
00188Dr 2                       jsr     PtrGet2                 ; will hit '(' -> Array -> create
00188Dr 2                       ; Now N(5)=42.  Re-parse "N(5)" to find element.
00188Dr 2                       lda     #<VT_DimN5
00188Dr 2                       ldy     #>VT_DimN5
00188Dr 2                       jsr     VT_SetTxt
00188Dr 2                       jsr     PtrGet                  ; element address in VARPNT
00188Dr 2                       ; Save VARPNT.
00188Dr 2                       lda     VARPNT
00188Dr 2                       sta     VT_VPSAVE
00188Dr 2                       lda     VARPNT+1
00188Dr 2                       sta     VT_VPSAVE+1
00188Dr 2                       ; FAC = 42.
00188Dr 2                       lda     #<Vt42
00188Dr 2                       ldy     #>Vt42
00188Dr 2                       jsr     LoadFacFromYa
00188Dr 2                       ldx     VT_VPSAVE
00188Dr 2                       ldy     VT_VPSAVE+1
00188Dr 2                       jsr     StoreFacAtYxRounded
00188Dr 2                       ; Read it back and print.
00188Dr 2                       lda     #<MsgVT_NewArr
00188Dr 2                       ldy     #>MsgVT_NewArr
00188Dr 2                       jsr     BasPrintStr
00188Dr 2                       lda     VT_VPSAVE
00188Dr 2                       ldy     VT_VPSAVE+1
00188Dr 2                       jsr     LoadFacFromYa
00188Dr 2                       jsr     BasPrintFAC
00188Dr 2                       jsr     BasPrintCRLF
00188Dr 2               
00188Dr 2                       ; --- Test 4: 8 string allocations + GC ---
00188Dr 2                       ldx     #8
00188Dr 2               @galloc:
00188Dr 2                       phx
00188Dr 2                       lda     #16
00188Dr 2                       jsr     StrSpa                  ; consumes 16 bytes; FAC has descriptor
00188Dr 2                       plx
00188Dr 2                       dex
00188Dr 2                       bne     @galloc
00188Dr 2                       ; Force GC (TEMPPT got bumped by StrSpa-via-StrIni? StrSpa itself
00188Dr 2                       ; doesn't call PutNew, so temp stack untouched here.)
00188Dr 2                       jsr     Garbag
00188Dr 2                       lda     #<MsgVT_GC
00188Dr 2                       ldy     #>MsgVT_GC
00188Dr 2                       jsr     BasPrintStr
00188Dr 2                       lda     FRETOP+1
00188Dr 2                       ldy     FRETOP
00188Dr 2                       jsr     GivAyf
00188Dr 2                       jsr     BasPrintFAC
00188Dr 2                       jsr     BasPrintCRLF
00188Dr 2               
00188Dr 2                       rts
00188Dr 2               .endif
00188Dr 2               
00188Dr 2               ; =============================================================================
00188Dr 2               ;   E X P R E S S I O N   E V A L U A T O R
00188Dr 2               ;
00188Dr 2               ;   Recursive-descent precedence climber.  Operates on tokenized text at
00188Dr 2               ;   TXTPTR (advanced via ChrGet/ChrGot).  Result lands in FAC (numeric)
00188Dr 2               ;   or as a 3-byte string descriptor at FAC..FAC+2 (string).  VALTYP
00188Dr 2               ;   selects: $00 = numeric, $FF = string.
00188Dr 2               ;
00188Dr 2               ;   Precedence (lowest -> highest):
00188Dr 2               ;     OR
00188Dr 2               ;     AND
00188Dr 2               ;     NOT  (right-assoc unary)
00188Dr 2               ;     comparison (= <> < > <= >=)
00188Dr 2               ;     + -
00188Dr 2               ;     * /
00188Dr 2               ;     ^    (right-assoc)
00188Dr 2               ;     unary -, unary +
00188Dr 2               ;     atom: number, variable, string-literal, "(" expr ")", function call
00188Dr 2               ; =============================================================================
00188Dr 2               
00188Dr 2               ; ---------------------------------------------------------------------------
00188Dr 2               ; ZP scratch used only during expression evaluation.
00188Dr 2               ;   BAS_LVTYP = saved VALTYP of left operand around binary ops
00188Dr 2               ; ---------------------------------------------------------------------------
00188Dr 2               BAS_LVTYP       := $86
00188Dr 2               
00188Dr 2               ; ---------------------------------------------------------------------------
00188Dr 2               ; FrmEvl -- top-level entry.  TXTPTR positioned so ChrGot returns the first
00188Dr 2               ; byte of the expression.  On exit TXTPTR is at the first byte AFTER the
00188Dr 2               ; expression.  Result in FAC + VALTYP.
00188Dr 2               ; ---------------------------------------------------------------------------
00188Dr 2               FrmEvl:
00188Dr 2  4C rr rr             jmp     EvalOr
001890r 2               
001890r 2               ; ---------------------------------------------------------------------------
001890r 2               ; PushFac -- push the current FAC + VALTYP onto the CPU stack (8 bytes).
001890r 2               ; Order pushed: VALTYP, FAC, FAC+1, FAC+2, FAC+3, FAC+4, FACSIGN, FACEXTENSION
001890r 2               ; (FACEXTENSION pushed last so it's pulled first by PullArg.)
001890r 2               ; Preserves the return address.
001890r 2               ; ---------------------------------------------------------------------------
001890r 2               PushFac:
001890r 2  68                   pla
001891r 2  A8                   tay                             ; Y = ret-addr lo
001892r 2  68                   pla
001893r 2  AA                   tax                             ; X = ret-addr hi
001894r 2  A5 64                lda     VALTYP
001896r 2  48                   pha
001897r 2  A5 0E                lda     FAC
001899r 2  48                   pha
00189Ar 2  A5 0F                lda     FAC+1
00189Cr 2  48                   pha
00189Dr 2  A5 10                lda     FAC+2
00189Fr 2  48                   pha
0018A0r 2  A5 11                lda     FAC+3
0018A2r 2  48                   pha
0018A3r 2  A5 12                lda     FAC+4
0018A5r 2  48                   pha
0018A6r 2  A5 13                lda     FACSIGN
0018A8r 2  48                   pha
0018A9r 2  A5 1D                lda     FACEXTENSION
0018ABr 2  48                   pha
0018ACr 2  8A                   txa
0018ADr 2  48                   pha
0018AEr 2  98                   tya
0018AFr 2  48                   pha
0018B0r 2  60                   rts
0018B1r 2               
0018B1r 2               ; ---------------------------------------------------------------------------
0018B1r 2               ; PullArg -- pop the previously-pushed FAC into ARG (signed FP value or
0018B1r 2               ; string descriptor in ARG..ARG+2/sign).  Sets BAS_LVTYP to the saved
0018B1r 2               ; left-operand VALTYP.  Preserves return address.
0018B1r 2               ; ---------------------------------------------------------------------------
0018B1r 2               PullArg:
0018B1r 2  68                   pla
0018B2r 2  A8                   tay                             ; Y = ret-addr lo
0018B3r 2  68                   pla
0018B4r 2  AA                   tax                             ; X = ret-addr hi
0018B5r 2  68                   pla
0018B6r 2  85 43                sta     ARGEXTENSION
0018B8r 2  68                   pla
0018B9r 2  85 1B                sta     ARGSIGN
0018BBr 2  68                   pla
0018BCr 2  85 1A                sta     ARG+4
0018BEr 2  68                   pla
0018BFr 2  85 19                sta     ARG+3
0018C1r 2  68                   pla
0018C2r 2  85 18                sta     ARG+2
0018C4r 2  68                   pla
0018C5r 2  85 17                sta     ARG+1
0018C7r 2  68                   pla
0018C8r 2  85 16                sta     ARG
0018CAr 2  68                   pla
0018CBr 2  85 86                sta     BAS_LVTYP
0018CDr 2  8A                   txa
0018CEr 2  48                   pha
0018CFr 2  98                   tya
0018D0r 2  48                   pha
0018D1r 2  60                   rts
0018D2r 2               
0018D2r 2               ; ---------------------------------------------------------------------------
0018D2r 2               ; PullFac -- pop pushed FAC back into FAC (used to discard right side and
0018D2r 2               ; restore left, e.g. unused).
0018D2r 2               ; ---------------------------------------------------------------------------
0018D2r 2               PullFac:
0018D2r 2  68                   pla
0018D3r 2  A8                   tay
0018D4r 2  68                   pla
0018D5r 2  AA                   tax
0018D6r 2  68                   pla
0018D7r 2  85 1D                sta     FACEXTENSION
0018D9r 2  68                   pla
0018DAr 2  85 13                sta     FACSIGN
0018DCr 2  68                   pla
0018DDr 2  85 12                sta     FAC+4
0018DFr 2  68                   pla
0018E0r 2  85 11                sta     FAC+3
0018E2r 2  68                   pla
0018E3r 2  85 10                sta     FAC+2
0018E5r 2  68                   pla
0018E6r 2  85 0F                sta     FAC+1
0018E8r 2  68                   pla
0018E9r 2  85 0E                sta     FAC
0018EBr 2  68                   pla
0018ECr 2  85 64                sta     VALTYP
0018EEr 2  8A                   txa
0018EFr 2  48                   pha
0018F0r 2  98                   tya
0018F1r 2  48                   pha
0018F2r 2  60                   rts
0018F3r 2               
0018F3r 2               ; ---------------------------------------------------------------------------
0018F3r 2               ; TypeMismatch helper.
0018F3r 2               ; ---------------------------------------------------------------------------
0018F3r 2               EvalTypeErr:
0018F3r 2  A2 08                ldx     #ERR_TYPEMISM
0018F5r 2  4C rr rr             jmp     BasErrorVec
0018F8r 2               
0018F8r 2               ; ===========================================================================
0018F8r 2               ;   L E V E L 0  --  O R
0018F8r 2               ; ===========================================================================
0018F8r 2               EvalOr:
0018F8r 2  20 rr rr             jsr     EvalAnd
0018FBr 2               @loop:
0018FBr 2  20 rr rr             jsr     ChrGot
0018FEr 2  C9 A3                cmp     #TOK_OR
001900r 2  D0 17                bne     @done
001902r 2  20 rr rr             jsr     ChkNum                  ; left must be numeric
001905r 2  20 rr rr             jsr     ChrGet                  ; consume OR
001908r 2  20 rr rr             jsr     PushFac
00190Br 2  20 rr rr             jsr     EvalAnd
00190Er 2  20 rr rr             jsr     ChkNum                  ; right must be numeric
001911r 2  20 rr rr             jsr     PullArg
001914r 2  20 rr rr             jsr     OrOp
001917r 2  80 E2                bra     @loop
001919r 2               @done:
001919r 2  60                   rts
00191Ar 2               
00191Ar 2               ; ===========================================================================
00191Ar 2               ;   L E V E L 1  --  A N D
00191Ar 2               ; ===========================================================================
00191Ar 2               EvalAnd:
00191Ar 2  20 rr rr             jsr     EvalNot
00191Dr 2               @loop:
00191Dr 2  20 rr rr             jsr     ChrGot
001920r 2  C9 A2                cmp     #TOK_AND
001922r 2  D0 17                bne     @done
001924r 2  20 rr rr             jsr     ChkNum
001927r 2  20 rr rr             jsr     ChrGet
00192Ar 2  20 rr rr             jsr     PushFac
00192Dr 2  20 rr rr             jsr     EvalNot
001930r 2  20 rr rr             jsr     ChkNum
001933r 2  20 rr rr             jsr     PullArg
001936r 2  20 rr rr             jsr     AndOp
001939r 2  80 E2                bra     @loop
00193Br 2               @done:
00193Br 2  60                   rts
00193Cr 2               
00193Cr 2               ; ===========================================================================
00193Cr 2               ;   L E V E L 2  --  N O T   (right-assoc unary prefix)
00193Cr 2               ; ===========================================================================
00193Cr 2               EvalNot:
00193Cr 2  20 rr rr             jsr     ChrGot
00193Fr 2  C9 A0                cmp     #TOK_NOT
001941r 2  D0 0C                bne     EvalCmp
001943r 2  20 rr rr             jsr     ChrGet
001946r 2  20 rr rr             jsr     EvalNot
001949r 2  20 rr rr             jsr     ChkNum
00194Cr 2  4C rr rr             jmp     NotOp
00194Fr 2               
00194Fr 2               ; ===========================================================================
00194Fr 2               ;   L E V E L 3  --  C O M P A R I S O N
00194Fr 2               ;   Reads up to two of {<, =, >} forming a relop; if none, no-op.
00194Fr 2               ;   Mask:  bit 0 = '>' present, bit 1 = '=' present, bit 2 = '<' present
00194Fr 2               ; ===========================================================================
00194Fr 2               EvalCmp:
00194Fr 2  20 rr rr             jsr     EvalAdd
001952r 2  A2 00                ldx     #0                      ; relop mask
001954r 2               @scan:
001954r 2  20 rr rr             jsr     ChrGot
001957r 2  C9 3D                cmp     #'='
001959r 2  F0 0A                beq     @gotEq
00195Br 2  C9 3C                cmp     #'<'
00195Dr 2  F0 0A                beq     @gotLt
00195Fr 2  C9 3E                cmp     #'>'
001961r 2  F0 0A                beq     @gotGt
001963r 2  80 1D                bra     @done
001965r 2               @gotEq:
001965r 2  A0 02                ldy     #2
001967r 2  80 06                bra     @setbit
001969r 2               @gotLt:
001969r 2  A0 04                ldy     #4
00196Br 2  80 02                bra     @setbit
00196Dr 2               @gotGt:
00196Dr 2  A0 01                ldy     #1
00196Fr 2               @setbit:
00196Fr 2  84 45                sty     CPRMASK                 ; reuse as scratch
001971r 2  8A                   txa
001972r 2  25 45                and     CPRMASK
001974r 2  D0 09                bne     @synErr                 ; same char twice (e.g. "==")
001976r 2  8A                   txa
001977r 2  05 45                ora     CPRMASK
001979r 2  AA                   tax
00197Ar 2  20 rr rr             jsr     ChrGet
00197Dr 2  80 D5                bra     @scan
00197Fr 2               @synErr:
00197Fr 2  4C rr rr             jmp     SynErr
001982r 2               @done:
001982r 2  E0 00                cpx     #0
001984r 2  D0 01                bne     @doCmp
001986r 2  60                   rts
001987r 2               @doCmp:
001987r 2  86 45                stx     CPRMASK
001989r 2                       ; Save left operand, evaluate right
001989r 2  20 rr rr             jsr     PushFac
00198Cr 2  20 rr rr             jsr     EvalAdd
00198Fr 2  20 rr rr             jsr     PullArg                 ; ARG = left, BAS_LVTYP = left's type
001992r 2                       ; Type compatibility check.
001992r 2  A5 86                lda     BAS_LVTYP
001994r 2  45 64                eor     VALTYP
001996r 2  10 03 4C rr          jmi     EvalTypeErr             ; one numeric, one string -> mismatch
00199Ar 2  rr           
00199Br 2  24 64                bit     VALTYP
00199Dr 2  30 03                bmi     @strCmp
00199Fr 2                       ; Numeric comparison.
00199Fr 2  4C rr rr             jmp     RelOpsNum
0019A2r 2               @strCmp:
0019A2r 2  4C rr rr             jmp     RelOpsStr
0019A5r 2               
0019A5r 2               ; ---------------------------------------------------------------------------
0019A5r 2               ; RelOpsNum -- numeric comparison.
0019A5r 2               ; Inputs: ARG = left, FAC = right, CPRMASK = relop mask (bit 0=>, 1==, 2=<).
0019A5r 2               ; Output: FAC = -1 if (ARG <op> FAC) is true, else 0.  VALTYP = numeric.
0019A5r 2               ; ---------------------------------------------------------------------------
0019A5r 2               RelOpsNum:
0019A5r 2                       ; Replicate msbasic ARG-pre-relop fixup: clear ARG+1 high bit, then
0019A5r 2                       ; set it from ARGSIGN's MSB.  This rebuilds the implicit-1 mantissa
0019A5r 2                       ; for FCOMP's signed comparison path.
0019A5r 2  A5 1B                lda     ARGSIGN
0019A7r 2  09 7F                ora     #$7F
0019A9r 2  25 17                and     ARG+1
0019ABr 2  85 17                sta     ARG+1
0019ADr 2  A9 16                lda     #<ARG
0019AFr 2  A0 00                ldy     #$00
0019B1r 2  20 rr rr             jsr     FComp                   ; A = sign(FAC - ARG)
0019B4r 2                       ; Map A to bit position:
0019B4r 2                       ;   FAC<ARG (A=$FF): ARG>FAC  -> bit 0 (mask 1)
0019B4r 2                       ;   FAC=ARG (A=$00):           -> bit 1 (mask 2)
0019B4r 2                       ;   FAC>ARG (A=$01): ARG<FAC  -> bit 2 (mask 4)
0019B4r 2  AA                   tax
0019B5r 2  30 06                bmi     @lt
0019B7r 2  F0 08                beq     @eq
0019B9r 2  A9 04                lda     #4
0019BBr 2  80 06                bra     @check
0019BDr 2               @lt:
0019BDr 2  A9 01                lda     #1
0019BFr 2  80 02                bra     @check
0019C1r 2               @eq:
0019C1r 2  A9 02                lda     #2
0019C3r 2               @check:
0019C3r 2  25 45                and     CPRMASK
0019C5r 2  F0 07                beq     @false
0019C7r 2  A9 FF                lda     #$FF
0019C9r 2  A0 FF                ldy     #$FF
0019CBr 2  4C rr rr             jmp     GivAyf
0019CEr 2               @false:
0019CEr 2  A9 00                lda     #0
0019D0r 2  A8                   tay
0019D1r 2  4C rr rr             jmp     GivAyf
0019D4r 2               
0019D4r 2               ; ---------------------------------------------------------------------------
0019D4r 2               ; RelOpsStr -- bytewise string comparison.
0019D4r 2               ; ARG = left descriptor (ARG=len, ARG+1=lo, ARG+2=hi, ARGSIGN, ARGEXT pushed).
0019D4r 2               ; FAC = right descriptor.  CPRMASK as above.
0019D4r 2               ; ---------------------------------------------------------------------------
0019D4r 2               RelOpsStr:
0019D4r 2                       ; INDEX = left ptr, BAS_TMP1 = right ptr, BAS_TMP2 lo = left len,
0019D4r 2                       ; BAS_TMP2 hi = right len.
0019D4r 2  A5 17                lda     ARG+1
0019D6r 2  85 20                sta     INDEX
0019D8r 2  A5 18                lda     ARG+2
0019DAr 2  85 21                sta     INDEX+1
0019DCr 2  A5 0F                lda     FAC+1
0019DEr 2  85 3A                sta     BAS_TMP1
0019E0r 2  A5 10                lda     FAC+2
0019E2r 2  85 3B                sta     BAS_TMP1+1
0019E4r 2  A5 16                lda     ARG
0019E6r 2  85 3C                sta     BAS_TMP2                ; left len
0019E8r 2  A5 0E                lda     FAC
0019EAr 2  85 3D                sta     BAS_TMP2+1              ; right len
0019ECr 2                       ; Compare byte-by-byte up to min length.
0019ECr 2  A0 00                ldy     #0
0019EEr 2               @cmp:
0019EEr 2                       ; Has either side ended?
0019EEr 2  C4 3C                cpy     BAS_TMP2
0019F0r 2  F0 17                beq     @leftEnd
0019F2r 2  C4 3D                cpy     BAS_TMP2+1
0019F4r 2  F0 1B                beq     @rightEnd               ; right ended first -> left > right
0019F6r 2  B1 20                lda     (INDEX),y
0019F8r 2  D1 3A                cmp     (BAS_TMP1),y
0019FAr 2  F0 0A                beq     @next
0019FCr 2  90 04                bcc     @lt                     ; left < right
0019FEr 2                       ; left > right
0019FEr 2  A9 01                lda     #1
001A00r 2  80 15                bra     @decide
001A02r 2               @lt:
001A02r 2  A9 04                lda     #4
001A04r 2  80 11                bra     @decide
001A06r 2               @next:
001A06r 2  C8                   iny
001A07r 2  80 E5                bra     @cmp
001A09r 2               @leftEnd:
001A09r 2                       ; Left ran out; check right
001A09r 2  C4 3D                cpy     BAS_TMP2+1
001A0Br 2  F0 08                beq     @equal
001A0Dr 2                       ; left < right (left is prefix)
001A0Dr 2  A9 04                lda     #4
001A0Fr 2  80 06                bra     @decide
001A11r 2               @rightEnd:
001A11r 2                       ; right ran out, left has more; left > right
001A11r 2  A9 01                lda     #1
001A13r 2  80 02                bra     @decide
001A15r 2               @equal:
001A15r 2  A9 02                lda     #2
001A17r 2               @decide:
001A17r 2  25 45                and     CPRMASK
001A19r 2  F0 05                beq     @false
001A1Br 2  A9 FF                lda     #$FF
001A1Dr 2  A8                   tay
001A1Er 2  80 03                bra     @ret
001A20r 2               @false:
001A20r 2  A9 00                lda     #0
001A22r 2  A8                   tay
001A23r 2               @ret:
001A23r 2                       ; Free temp strings before returning.  Save A,Y first.
001A23r 2  48                   pha
001A24r 2  5A                   phy
001A25r 2                       ; Free FAC's temp string (right operand).
001A25r 2  24 64                bit     VALTYP
001A27r 2  10 03                bpl     @noFreeR
001A29r 2  20 rr rr             jsr     FreFac
001A2Cr 2               @noFreeR:
001A2Cr 2                       ; Free ARG's temp string (left operand): manually restore VALTYP=$FF
001A2Cr 2                       ; and FAC := ARG, then FreFac.  (We don't always know if ARG is a
001A2Cr 2                       ; temp; FreTms inside FreTmp checks.)
001A2Cr 2  A5 16                lda     ARG
001A2Er 2  85 0E                sta     FAC
001A30r 2  A5 17                lda     ARG+1
001A32r 2  85 0F                sta     FAC+1
001A34r 2  A5 18                lda     ARG+2
001A36r 2  85 10                sta     FAC+2
001A38r 2                       ; +3/+4 are the descriptor's own address, which is what FreFac frees
001A38r 2                       ; by -- copying only the len/lo/hi above left FreFac looking at the
001A38r 2                       ; right operand's slot, already popped, so it never matched LASTPT and
001A38r 2                       ; the left temp was never reclaimed.  PushFac/PullArg carry these two
001A38r 2                       ; bytes through for exactly this.  One leaked slot per comparison, and
001A38r 2                       ; the third string compare in a program hit ?FORMULA TOO COMPLEX.
001A38r 2  A5 19                lda     ARG+3
001A3Ar 2  85 11                sta     FAC+3
001A3Cr 2  A5 1A                lda     ARG+4
001A3Er 2  85 12                sta     FAC+4
001A40r 2  A9 FF                lda     #$FF
001A42r 2  85 64                sta     VALTYP
001A44r 2  20 rr rr             jsr     FreFac
001A47r 2  7A                   ply
001A48r 2  68                   pla
001A49r 2  4C rr rr             jmp     GivAyf
001A4Cr 2               
001A4Cr 2               ; ===========================================================================
001A4Cr 2               ;   L E V E L 4  --  + / -
001A4Cr 2               ; ===========================================================================
001A4Cr 2               EvalAdd:
001A4Cr 2  20 rr rr             jsr     EvalMul
001A4Fr 2               @loop:
001A4Fr 2  20 rr rr             jsr     ChrGot
001A52r 2  C9 2B                cmp     #'+'
001A54r 2  F0 05                beq     @plus
001A56r 2  C9 2D                cmp     #'-'
001A58r 2  F0 27                beq     @minus
001A5Ar 2  60                   rts
001A5Br 2               @plus:
001A5Br 2  20 rr rr             jsr     ChrGet
001A5Er 2  20 rr rr             jsr     PushFac
001A61r 2  20 rr rr             jsr     EvalMul
001A64r 2  20 rr rr             jsr     PullArg
001A67r 2                       ; Type dispatch.
001A67r 2  A5 86                lda     BAS_LVTYP
001A69r 2  45 64                eor     VALTYP
001A6Br 2  10 03 4C rr          jmi     EvalTypeErr
001A6Fr 2  rr           
001A70r 2  24 64                bit     VALTYP
001A72r 2  30 28                bmi     @cat
001A74r 2                       ; numeric add: FAC = ARG + FAC
001A74r 2                       ; FAddT expects: ARG is the operand, A=FAC's exponent on entry.
001A74r 2                       ; Use entry "FAddT" preceded by sign work: msbasic does
001A74r 2                       ;   bne <continue>; jmp CopyArgToFac
001A74r 2                       ; But our FAddT entry already handles that.  We need to set
001A74r 2                       ; SGNCPR = ARGSIGN ^ FACSIGN before FAddT.
001A74r 2  A5 1B                lda     ARGSIGN
001A76r 2  45 13                eor     FACSIGN
001A78r 2  85 1C                sta     SGNCPR
001A7Ar 2  A5 0E                lda     FAC
001A7Cr 2  20 rr rr             jsr     FAddT
001A7Fr 2  80 CE                bra     @loop
001A81r 2               @minus:
001A81r 2  20 rr rr             jsr     ChrGet
001A84r 2  20 rr rr             jsr     PushFac
001A87r 2  20 rr rr             jsr     EvalMul
001A8Ar 2  20 rr rr             jsr     ChkNum
001A8Dr 2                       ; left was pushed; check pushed type via TOS-byte? Easier: we already
001A8Dr 2                       ; verified left is numeric on first iteration.  But left might have
001A8Dr 2                       ; been a string from concatenation; require numeric here:
001A8Dr 2  20 rr rr             jsr     PullArg
001A90r 2  A5 86                lda     BAS_LVTYP
001A92r 2  10 03 4C rr          jmi     EvalTypeErr
001A96r 2  rr           
001A97r 2                       ; FAC = ARG - FAC
001A97r 2                       ; FSubT does: FACSIGN ^= $FF; SGNCPR = FACSIGN^ARGSIGN; jmp FAddT
001A97r 2                       ; We need to call FSubT directly.
001A97r 2  20 rr rr             jsr     FSubT
001A9Ar 2  80 B3                bra     @loop
001A9Cr 2               @cat:
001A9Cr 2  20 rr rr             jsr     CatStr
001A9Fr 2  80 AE                bra     @loop
001AA1r 2               
001AA1r 2               ; ---------------------------------------------------------------------------
001AA1r 2               ; CatStr -- concatenate ARG (left) + FAC (right), result in FAC.
001AA1r 2               ; ---------------------------------------------------------------------------
001AA1r 2               CatStr:
001AA1r 2                       ; Stash right's length+addr before we overwrite FAC.
001AA1r 2  A5 0E                lda     FAC
001AA3r 2  85 4D                sta     BAS_TEMP1               ; right len
001AA5r 2  A5 0F                lda     FAC+1
001AA7r 2  85 4E                sta     BAS_TEMP1+1
001AA9r 2  A5 10                lda     FAC+2
001AABr 2  85 4F                sta     BAS_TEMP1+2
001AADr 2                       ; Total length = ARG + FAC; abort if > 255.
001AADr 2  18                   clc
001AAEr 2  A5 16                lda     ARG
001AB0r 2  65 4D                adc     BAS_TEMP1
001AB2r 2  B0 40                bcs     @tooLong
001AB4r 2  85 50                sta     BAS_TEMP1+3             ; total length
001AB6r 2                       ; Free both source temps before allocating result -- otherwise we
001AB6r 2                       ; pile up to 3 temps and the next PutNew throws ?FRMCPX.
001AB6r 2  20 rr rr             jsr     FreeBothTemps
001AB9r 2                       ; Allocate.
001AB9r 2  A5 50                lda     BAS_TEMP1+3             ; total length
001ABBr 2  20 rr rr             jsr     GetSpa                  ; A=total, FRESPC=buf
001ABEr 2                       ; Copy left bytes (ARG -> FRESPC).
001ABEr 2  A5 17                lda     ARG+1
001AC0r 2  85 20                sta     INDEX
001AC2r 2  A5 18                lda     ARG+2
001AC4r 2  85 21                sta     INDEX+1
001AC6r 2  A5 16                lda     ARG
001AC8r 2  F0 03                beq     @right
001ACAr 2  20 rr rr             jsr     MovStr1                 ; advances FRESPC by len
001ACDr 2               @right:
001ACDr 2                       ; Copy right bytes.
001ACDr 2  A5 4E                lda     BAS_TEMP1+1
001ACFr 2  85 20                sta     INDEX
001AD1r 2  A5 4F                lda     BAS_TEMP1+2
001AD3r 2  85 21                sta     INDEX+1
001AD5r 2  A5 4D                lda     BAS_TEMP1
001AD7r 2  F0 03                beq     @desc
001AD9r 2  20 rr rr             jsr     MovStr1
001ADCr 2               @desc:
001ADCr 2                       ; Descriptor: FAC := total len, FAC+1/2 := FRESPC - total.
001ADCr 2  A5 50                lda     BAS_TEMP1+3
001ADEr 2  85 0E                sta     FAC
001AE0r 2  38                   sec
001AE1r 2  A5 84                lda     FRESPC
001AE3r 2  E5 50                sbc     BAS_TEMP1+3
001AE5r 2  85 0F                sta     FAC+1
001AE7r 2  A5 85                lda     FRESPC+1
001AE9r 2  E9 00                sbc     #0
001AEBr 2  85 10                sta     FAC+2
001AEDr 2  A9 FF                lda     #$FF
001AEFr 2  85 64                sta     VALTYP
001AF1r 2  4C rr rr             jmp     PutNew
001AF4r 2               @tooLong:
001AF4r 2  A2 09                ldx     #ERR_STRLONG
001AF6r 2  4C rr rr             jmp     BasErrorVec
001AF9r 2               
001AF9r 2               ; ===========================================================================
001AF9r 2               ;   L E V E L 5  --  * / /
001AF9r 2               ; ===========================================================================
001AF9r 2               EvalMul:
001AF9r 2  20 rr rr             jsr     EvalPow
001AFCr 2               @loop:
001AFCr 2  20 rr rr             jsr     ChrGot
001AFFr 2  C9 2A                cmp     #'*'
001B01r 2  F0 05                beq     @mul
001B03r 2  C9 2F                cmp     #'/'
001B05r 2  F0 27                beq     @div
001B07r 2  60                   rts
001B08r 2               @mul:
001B08r 2  20 rr rr             jsr     ChkNum
001B0Br 2  20 rr rr             jsr     ChrGet
001B0Er 2  20 rr rr             jsr     PushFac
001B11r 2  20 rr rr             jsr     EvalPow
001B14r 2  20 rr rr             jsr     ChkNum
001B17r 2  20 rr rr             jsr     PullArg
001B1Ar 2  A5 86                lda     BAS_LVTYP
001B1Cr 2  10 03 4C rr          jmi     EvalTypeErr
001B20r 2  rr           
001B21r 2                       ; FAC = ARG * FAC: FMultT expects ARG + sign work.  See msbasic.
001B21r 2  A5 1B                lda     ARGSIGN
001B23r 2  45 13                eor     FACSIGN
001B25r 2  85 1C                sta     SGNCPR
001B27r 2  A5 0E                lda     FAC
001B29r 2  20 rr rr             jsr     FMultT
001B2Cr 2  80 CE                bra     @loop
001B2Er 2               @div:
001B2Er 2  20 rr rr             jsr     ChkNum
001B31r 2  20 rr rr             jsr     ChrGet
001B34r 2  20 rr rr             jsr     PushFac
001B37r 2  20 rr rr             jsr     EvalPow
001B3Ar 2  20 rr rr             jsr     ChkNum
001B3Dr 2  20 rr rr             jsr     PullArg
001B40r 2  A5 86                lda     BAS_LVTYP
001B42r 2  10 03 4C rr          jmi     EvalTypeErr
001B46r 2  rr           
001B47r 2                       ; FAC = ARG / FAC: FDivT.
001B47r 2  A5 1B                lda     ARGSIGN
001B49r 2  45 13                eor     FACSIGN
001B4Br 2  85 1C                sta     SGNCPR
001B4Dr 2  A5 0E                lda     FAC
001B4Fr 2  20 rr rr             jsr     FDivT
001B52r 2  80 A8                bra     @loop
001B54r 2               
001B54r 2               ; ===========================================================================
001B54r 2               ;   L E V E L 6  --  ^   (right-associative)
001B54r 2               ; ===========================================================================
001B54r 2               EvalPow:
001B54r 2  20 rr rr             jsr     EvalUnary
001B57r 2               @loop:
001B57r 2  20 rr rr             jsr     ChrGot
001B5Ar 2  C9 5E                cmp     #'^'
001B5Cr 2  D0 20                bne     @done
001B5Er 2  20 rr rr             jsr     ChkNum
001B61r 2  20 rr rr             jsr     ChrGet
001B64r 2  20 rr rr             jsr     PushFac
001B67r 2                       ; Right-associative, which means the right-hand side is evaluated at
001B67r 2                       ; this level rather than the one below: recursing into EvalPow lets
001B67r 2                       ; the RHS take the rest of the chain, so 2^3^2 is 2^(3^2) = 512.
001B67r 2                       ; Calling EvalUnary here instead made it (2^3)^2 = 64 -- left-assoc,
001B67r 2                       ; contradicting this level's own heading.  EvalUnary still runs first
001B67r 2                       ; inside the recursion, so a term is always consumed and the recursion
001B67r 2                       ; is bounded by the length of the chain.
001B67r 2  20 rr rr             jsr     EvalPow
001B6Ar 2  20 rr rr             jsr     ChkNum
001B6Dr 2  20 rr rr             jsr     PullArg
001B70r 2  A5 86                lda     BAS_LVTYP
001B72r 2  10 03 4C rr          jmi     EvalTypeErr
001B76r 2  rr           
001B77r 2                       ; FPwrt computes ARG ^ FAC.  Our ported FPwrt expects ARG = base,
001B77r 2                       ; FAC = exponent, and A = FAC's exponent byte (FPwrt's first
001B77r 2                       ; instruction is `beq Exp` to short-circuit FAC==0 -> 1).
001B77r 2  A5 0E                lda     FAC
001B79r 2  20 rr rr             jsr     FPwrt
001B7Cr 2  80 D9                bra     @loop
001B7Er 2               @done:
001B7Er 2  60                   rts
001B7Fr 2               
001B7Fr 2               ; ===========================================================================
001B7Fr 2               ;   L E V E L 7  --  U N A R Y
001B7Fr 2               ; ===========================================================================
001B7Fr 2               EvalUnary:
001B7Fr 2  20 rr rr             jsr     ChrGot
001B82r 2  C9 2D                cmp     #'-'
001B84r 2  F0 07                beq     @neg
001B86r 2  C9 2B                cmp     #'+'
001B88r 2  F0 13                beq     @pos
001B8Ar 2  4C rr rr             jmp     EvalAtom
001B8Dr 2               @neg:
001B8Dr 2  20 rr rr             jsr     ChrGet
001B90r 2                       ; Evaluate the operand at the power level, not this one: the README
001B90r 2                       ; puts `^` above unary `-`, so -2^2 is -(2^2) = -4.  Recursing into
001B90r 2                       ; EvalUnary here bound the minus to the atom first and gave (-2)^2 = 4.
001B90r 2                       ; The '-' is consumed above, so a term is always taken before this
001B90r 2                       ; recurses and the depth is bounded by the run of signs.
001B90r 2  20 rr rr             jsr     EvalPow
001B93r 2  20 rr rr             jsr     ChkNum
001B96r 2                       ; Negate FAC: flip FACSIGN bit 7.
001B96r 2  A5 13                lda     FACSIGN
001B98r 2  49 FF                eor     #$FF
001B9Ar 2  85 13                sta     FACSIGN
001B9Cr 2  60                   rts
001B9Dr 2               @pos:
001B9Dr 2  20 rr rr             jsr     ChrGet
001BA0r 2  4C rr rr             jmp     EvalUnary
001BA3r 2               
001BA3r 2               ; ===========================================================================
001BA3r 2               ;   L E V E L 8  --  A T O M
001BA3r 2               ; ===========================================================================
001BA3r 2               EvalAtom:
001BA3r 2  64 64                stz     VALTYP                  ; default to numeric; string paths override
001BA5r 2  20 rr rr             jsr     ChrGot
001BA8r 2  90 2A                bcc     @num                    ; digit
001BAAr 2  C9 2E                cmp     #'.'
001BACr 2  F0 26                beq     @num
001BAEr 2  C9 22                cmp     #'"'
001BB0r 2  F0 25                beq     @str
001BB2r 2  C9 28                cmp     #'('
001BB4r 2  F0 39                beq     @paren
001BB6r 2                       ; Letter? -> variable
001BB6r 2  20 rr rr             jsr     IsLetC
001BB9r 2  B0 3D                bcs     @var
001BBBr 2                       ; Function token?
001BBBr 2  C9 CD                cmp     #TOK_INKEY
001BBDr 2  F0 60                beq     FnInkey
001BBFr 2  C9 9D                cmp     #TOK_FN
001BC1r 2  F0 0E                beq     @fnCall                 ; FN A(...) — user-defined function
001BC3r 2                       ; Hex literal in PRINT context: not here (no '$' literal supported).
001BC3r 2                       ; NVRAM is dual-role (statement at $B1, function via FnTable);
001BC3r 2                       ; allow it through even though it sits below TOK_SGN.
001BC3r 2  C9 B1                cmp     #TOK_NVRAM
001BC5r 2  F0 04                beq     @fnDisp
001BC7r 2                       ; Try function dispatch.  Every token from SGN up goes to FnDispatch,
001BC7r 2                       ; whose table holds $B6-$D0 and $E0-$E3: anything else it is handed --
001BC7r 2                       ; the statements $D1-$DF in between -- is not in it, and is a SYNTAX
001BC7r 2                       ; ERROR there.
001BC7r 2  C9 B6                cmp     #TOK_SGN
001BC9r 2  90 03                bcc     @synErr
001BCBr 2               @fnDisp:
001BCBr 2  4C rr rr             jmp     FnDispatch
001BCEr 2               @synErr:
001BCEr 2  4C rr rr             jmp     SynErr
001BD1r 2               @fnCall:
001BD1r 2  4C rr rr             jmp     FnCall
001BD4r 2               @num:
001BD4r 2                       ; ASCII numeric: jump to Fin.  Fin uses ChrGet to consume.
001BD4r 2  4C rr rr             jmp     Fin
001BD7r 2               @str:
001BD7r 2                       ; '"' string literal.  Advance past the opening quote WITHOUT ChrGet:
001BD7r 2                       ; ChrGet skips spaces, which would strip leading spaces inside the
001BD7r 2                       ; string literal (e.g. PRINT "   X").  Bump TXTPTR by one byte instead.
001BD7r 2  E6 04                inc     TXTPTR
001BD9r 2  D0 02                bne     @strsrc
001BDBr 2  E6 05                inc     TXTPTR+1
001BDDr 2               @strsrc:
001BDDr 2                       ; StrLit expects (Y,A) = src.  Source = TXTPTR.
001BDDr 2  A5 04                lda     TXTPTR
001BDFr 2  A4 05                ldy     TXTPTR+1
001BE1r 2  20 rr rr             jsr     StrLit
001BE4r 2                       ; StrLit advances internal pointer; we need to update TXTPTR.
001BE4r 2                       ; StrLit reads until $00 or '"' from (STRNG1)+y; FAC has length.
001BE4r 2                       ; Compute new TXTPTR = STRNG2 (which StrLit set), or TXTPTR + len + maybe-quote.
001BE4r 2                       ; STRNG2 = STRNG1 + len + (1 if hit quote else 0).  Use STRNG2.
001BE4r 2  A5 1E                lda     STRNG2
001BE6r 2  85 04                sta     TXTPTR
001BE8r 2  A5 1F                lda     STRNG2+1
001BEAr 2  85 05                sta     TXTPTR+1
001BECr 2                       ; If we stopped at a closing quote, TXTPTR is past it (StrLit's
001BECr 2                       ; @endquote path: tya/adc STRNG1 with carry set since cmp set C);
001BECr 2                       ; if we ran into NUL, TXTPTR sits on the NUL (clc path).  Either
001BECr 2                       ; is correct for ChrGot.
001BECr 2  4C rr rr             jmp     ChrGot                  ; preload next char (for caller chains)
001BEFr 2               @paren:
001BEFr 2  20 rr rr             jsr     ChrGet                  ; consume '('
001BF2r 2  20 rr rr             jsr     FrmEvl
001BF5r 2  4C rr rr             jmp     ChkCls                  ; expects ')'; consumes via ChrGet
001BF8r 2               @var:
001BF8r 2                       ; Variable lookup.  PtrGet uses CHRGET internally and leaves
001BF8r 2                       ; (A,Y) = VARPNT.  VALTYP is set to $00 or $FF.
001BF8r 2  20 rr rr             jsr     PtrGet
001BFBr 2                       ; Fetch value into FAC.
001BFBr 2  24 64                bit     VALTYP
001BFDr 2  30 07                bmi     @loadStr
001BFFr 2                       ; numeric: FAC = (VARPNT)
001BFFr 2  A5 3F                lda     VARPNT
001C01r 2  A4 40                ldy     VARPNT+1
001C03r 2  4C rr rr             jmp     LoadFacFromYa
001C06r 2               @loadStr:
001C06r 2                       ; string: copy descriptor [len][lo][hi] into FAC..FAC+2.
001C06r 2  A0 00                ldy     #0
001C08r 2  B1 3F                lda     (VARPNT),y
001C0Ar 2  85 0E                sta     FAC
001C0Cr 2  C8                   iny
001C0Dr 2  B1 3F                lda     (VARPNT),y
001C0Fr 2  85 0F                sta     FAC+1
001C11r 2  C8                   iny
001C12r 2  B1 3F                lda     (VARPNT),y
001C14r 2  85 10                sta     FAC+2
001C16r 2                       ; Record the descriptor's address (= VARPNT) in FAC+3/FAC+4 so the
001C16r 2                       ; temp-free logic (FreFac/FreTms) can tell this is a variable, not a
001C16r 2                       ; temp: VARPNT's high byte is nonzero (vars live at $08xx) so it can
001C16r 2                       ; never match a temp-stack slot (all in zero page) and will not be
001C16r 2                       ; freed or reclaimed.  Without this, a stale FAC+3/FAC+4 can spuriously
001C16r 2                       ; match LASTPT and free/reclaim a live string.
001C16r 2  A5 3F                lda     VARPNT
001C18r 2  85 11                sta     FAC+3
001C1Ar 2  A5 40                lda     VARPNT+1
001C1Cr 2  85 12                sta     FAC+4
001C1Er 2  60                   rts
001C1Fr 2               
001C1Fr 2               ; ---------------------------------------------------------------------------
001C1Fr 2               ; FnInkey -- INKEY (no parens).  Reads BAS_PENDKEY first; else BufferSize/
001C1Fr 2               ; ReadBuffer; else 0.  Result is unsigned 8-bit FP value.
001C1Fr 2               ; ---------------------------------------------------------------------------
001C1Fr 2               FnInkey:
001C1Fr 2  20 rr rr             jsr     ChrGet                  ; consume INKEY token
001C22r 2  AD 0E 03             lda     BAS_PENDKEY
001C25r 2  F0 09                beq     @noPend
001C27r 2                       ; consume pending key.
001C27r 2  A0 00                ldy     #0
001C29r 2  8C 0E 03             sty     BAS_PENDKEY
001C2Cr 2  A8                   tay
001C2Dr 2  4C rr rr             jmp     SngFlt
001C30r 2               @noPend:
001C30r 2  20 rr rr             jsr     BufferSize
001C33r 2  F0 07                beq     @zero
001C35r 2  20 rr rr             jsr     ReadBuffer
001C38r 2  A8                   tay
001C39r 2  4C rr rr             jmp     SngFlt
001C3Cr 2               @zero:
001C3Cr 2  A0 00                ldy     #0
001C3Er 2  4C rr rr             jmp     SngFlt
001C41r 2               
001C41r 2               ; ---------------------------------------------------------------------------
001C41r 2               ; FnDispatch -- A holds a token from TOK_SGN up.  Dispatch via FnTable, which
001C41r 2               ; pairs (token, handler-1); a token the table does not hold is a SYNTAX ERROR.
001C41r 2               ; ---------------------------------------------------------------------------
001C41r 2               FnDispatch:
001C41r 2  A2 00                ldx     #0
001C43r 2               @find:
001C43r 2  BD rr rr             lda     FnTable,x
001C46r 2  F0 14                beq     @synErr                 ; reached terminator
001C48r 2  D2 04                cmp     (TXTPTR)
001C4Ar 2  F0 05                beq     @match
001C4Cr 2  E8                   inx
001C4Dr 2  E8                   inx
001C4Er 2  E8                   inx
001C4Fr 2  80 F2                bra     @find
001C51r 2               @match:
001C51r 2                       ; Push handler-1 onto stack so RTS jumps to it after ChrGet.
001C51r 2  BD rr rr             lda     FnTable+2,x
001C54r 2  48                   pha
001C55r 2  BD rr rr             lda     FnTable+1,x
001C58r 2  48                   pha
001C59r 2  4C rr rr             jmp     ChrGet                  ; consume token, return into handler
001C5Cr 2               @synErr:
001C5Cr 2  4C rr rr             jmp     SynErr
001C5Fr 2               
001C5Fr 2               ; ---------------------------------------------------------------------------
001C5Fr 2               ; FnTable -- (token, handler-1) triples, $00-terminated.
001C5Fr 2               ; "handler-1" because we push it through RTS which adds 1.
001C5Fr 2               ; ---------------------------------------------------------------------------
001C5Fr 2               FnTable:
001C5Fr 2  B6                   .byte   TOK_SGN
001C60r 2  rr rr                .word   FnSgn-1
001C62r 2  B7                   .byte   TOK_INT
001C63r 2  rr rr                .word   FnInt-1
001C65r 2  B8                   .byte   TOK_ABS
001C66r 2  rr rr                .word   FnAbs-1
001C68r 2  B9                   .byte   TOK_FRE
001C69r 2  rr rr                .word   FnFre-1
001C6Br 2  BA                   .byte   TOK_POS
001C6Cr 2  rr rr                .word   FnPos-1
001C6Er 2  BB                   .byte   TOK_SQR
001C6Fr 2  rr rr                .word   FnSqr-1
001C71r 2  BC                   .byte   TOK_RND
001C72r 2  rr rr                .word   FnRnd-1
001C74r 2  BD                   .byte   TOK_LOG
001C75r 2  rr rr                .word   FnLog-1
001C77r 2  BE                   .byte   TOK_EXP
001C78r 2  rr rr                .word   FnExp-1
001C7Ar 2  BF                   .byte   TOK_COS
001C7Br 2  rr rr                .word   FnCos-1
001C7Dr 2  C0                   .byte   TOK_SIN
001C7Er 2  rr rr                .word   FnSin-1
001C80r 2  C1                   .byte   TOK_TAN
001C81r 2  rr rr                .word   FnTan-1
001C83r 2  C2                   .byte   TOK_ATN
001C84r 2  rr rr                .word   FnAtn-1
001C86r 2  C3                   .byte   TOK_PEEK
001C87r 2  rr rr                .word   FnPeek-1
001C89r 2  C4                   .byte   TOK_LEN
001C8Ar 2  rr rr                .word   FnLen-1
001C8Cr 2  C5                   .byte   TOK_STRSTR
001C8Dr 2  rr rr                .word   FnStrStr-1
001C8Fr 2  C6                   .byte   TOK_VAL
001C90r 2  rr rr                .word   FnVal-1
001C92r 2  C7                   .byte   TOK_ASC
001C93r 2  rr rr                .word   FnAsc-1
001C95r 2  C8                   .byte   TOK_CHRSTR
001C96r 2  rr rr                .word   FnChrStr-1
001C98r 2  C9                   .byte   TOK_LEFTSTR
001C99r 2  rr rr                .word   FnLeftStr-1
001C9Br 2  CA                   .byte   TOK_RIGHTSTR
001C9Cr 2  rr rr                .word   FnRightStr-1
001C9Er 2  CB                   .byte   TOK_MIDSTR
001C9Fr 2  rr rr                .word   FnMidStr-1
001CA1r 2  CC                   .byte   TOK_JOY
001CA2r 2  rr rr                .word   FnJoy-1
001CA4r 2  B1                   .byte   TOK_NVRAM
001CA5r 2  rr rr                .word   FnNvram-1
001CA7r 2  CE                   .byte   TOK_HEX
001CA8r 2  rr rr                .word   FnHex-1
001CAAr 2  CF                   .byte   TOK_MIN
001CABr 2  rr rr                .word   FnMin-1
001CADr 2  D0                   .byte   TOK_MAX
001CAEr 2  rr rr                .word   FnMax-1
001CB0r 2  E0                   .byte   TOK_VPEEK
001CB1r 2  rr rr                .word   FnVpeek-1
001CB3r 2  E1                   .byte   TOK_VSTAT
001CB4r 2  rr rr                .word   FnVstat-1
001CB6r 2  E2                   .byte   TOK_NVSTAT
001CB7r 2  rr rr                .word   FnNvstat-1
001CB9r 2  E3                   .byte   TOK_NVFIND
001CBAr 2  rr rr                .word   FnNvfind-1
001CBCr 2  00                   .byte   0
001CBDr 2               
001CBDr 2               ; ---------------------------------------------------------------------------
001CBDr 2               ; Numeric-arg helpers.
001CBDr 2               ; ParenNum    -- expects "(" expr ")" with numeric result.  FAC = result.
001CBDr 2               ; ParenStr    -- expects "(" expr ")" with string result.
001CBDr 2               ; ParenU8     -- expects "(" expr ")" -> A = byte (0..255), or ?ILLQTY.
001CBDr 2               ; ParenU16    -- expects "(" expr ")" -> AyInt result in FAC+3,+4.
001CBDr 2               ; ---------------------------------------------------------------------------
001CBDr 2               ParenNum:
001CBDr 2  20 rr rr             jsr     ChkOpn
001CC0r 2  20 rr rr             jsr     FrmEvl
001CC3r 2  20 rr rr             jsr     ChkNum
001CC6r 2  4C rr rr             jmp     ChkCls
001CC9r 2               ParenStr:
001CC9r 2  20 rr rr             jsr     ChkOpn
001CCCr 2  20 rr rr             jsr     FrmEvl
001CCFr 2  20 rr rr             jsr     ChkStr
001CD2r 2  4C rr rr             jmp     ChkCls
001CD5r 2               ParenU8:
001CD5r 2  20 rr rr             jsr     ParenNum
001CD8r 2  20 rr rr             jsr     AyInt
001CDBr 2  A5 11                lda     FAC+3                   ; high byte must be 0
001CDDr 2  D0 03                bne     @bad
001CDFr 2  A5 12                lda     FAC+4                   ; low byte = result
001CE1r 2  60                   rts
001CE2r 2               @bad:
001CE2r 2  4C rr rr             jmp     IqErr
001CE5r 2               
001CE5r 2               ; ---------------------------------------------------------------------------
001CE5r 2               ; Unary numeric functions (single-arg "(" num ")") -- shared body.
001CE5r 2               ; Each entry sets up A = handler entry to call after ChkOpn/FrmEvl/ChkNum/ChkCls.
001CE5r 2               ; ---------------------------------------------------------------------------
001CE5r 2               FnSgn:
001CE5r 2  20 rr rr             jsr     ParenNum
001CE8r 2  4C rr rr             jmp     Sgn
001CEBr 2               FnInt:
001CEBr 2  20 rr rr             jsr     ParenNum
001CEEr 2  4C rr rr             jmp     Int
001CF1r 2               FnAbs:
001CF1r 2  20 rr rr             jsr     ParenNum
001CF4r 2  4C rr rr             jmp     Abs
001CF7r 2               FnSqr:
001CF7r 2  20 rr rr             jsr     ParenNum
001CFAr 2  4C rr rr             jmp     Sqr
001CFDr 2               FnLog:
001CFDr 2  20 rr rr             jsr     ParenNum
001D00r 2  4C rr rr             jmp     Log
001D03r 2               FnExp:
001D03r 2  20 rr rr             jsr     ParenNum
001D06r 2  4C rr rr             jmp     Exp
001D09r 2               FnCos:
001D09r 2  20 rr rr             jsr     ParenNum
001D0Cr 2  4C rr rr             jmp     Cos
001D0Fr 2               FnSin:
001D0Fr 2  20 rr rr             jsr     ParenNum
001D12r 2  4C rr rr             jmp     Sin
001D15r 2               FnTan:
001D15r 2  20 rr rr             jsr     ParenNum
001D18r 2  4C rr rr             jmp     Tan
001D1Br 2               FnAtn:
001D1Br 2  20 rr rr             jsr     ParenNum
001D1Er 2  4C rr rr             jmp     Atn
001D21r 2               FnRnd:
001D21r 2  20 rr rr             jsr     ParenNum
001D24r 2  4C rr rr             jmp     Rnd
001D27r 2               FnHex:
001D27r 2                       ; In expression context: identity.
001D27r 2  4C rr rr             jmp     ParenNum
001D2Ar 2               
001D2Ar 2               ; ---------------------------------------------------------------------------
001D2Ar 2               ; FnFre -- FRE(n): returns FRETOP - STREND (free string heap).
001D2Ar 2               ; Argument is parsed and ignored.
001D2Ar 2               ; ---------------------------------------------------------------------------
001D2Ar 2               FnFre:
001D2Ar 2  20 rr rr             jsr     ParenNum
001D2Dr 2  38                   sec
001D2Er 2  AD 65 03             lda     FRETOP
001D31r 2  ED 63 03             sbc     STREND
001D34r 2  A8                   tay
001D35r 2  AD 66 03             lda     FRETOP+1
001D38r 2  ED 64 03             sbc     STREND+1
001D3Br 2  4C rr rr             jmp     GivAyf
001D3Er 2               
001D3Er 2               ; ---------------------------------------------------------------------------
001D3Er 2               ; FnPos -- POS(n): current print column.  Argument is parsed and ignored.
001D3Er 2               ; ---------------------------------------------------------------------------
001D3Er 2               FnPos:
001D3Er 2  20 rr rr             jsr     ParenNum
001D41r 2                       ; BAS_POSX is the live column PrintCh maintains and TAB and the comma
001D41r 2                       ; zones already read.  This returned a hardcoded 0 -- the column was
001D41r 2                       ; being tracked all along, POS just never looked at it.
001D41r 2  AC 70 03             ldy     BAS_POSX
001D44r 2  4C rr rr             jmp     SngFlt
001D47r 2               
001D47r 2               ; ---------------------------------------------------------------------------
001D47r 2               ; FnPeek -- PEEK(addr): byte at addr -> FP.
001D47r 2               ; ---------------------------------------------------------------------------
001D47r 2               FnPeek:
001D47r 2  20 rr rr             jsr     ParenNum
001D4Ar 2  20 rr rr             jsr     FacToU16
001D4Dr 2  A5 12                lda     FAC+4                   ; lo byte
001D4Fr 2  85 20                sta     INDEX
001D51r 2  A5 11                lda     FAC+3                   ; hi byte
001D53r 2  85 21                sta     INDEX+1
001D55r 2  A0 00                ldy     #0
001D57r 2  B1 20                lda     (INDEX),y
001D59r 2  A8                   tay
001D5Ar 2  4C rr rr             jmp     SngFlt
001D5Dr 2               
001D5Dr 2               ; ---------------------------------------------------------------------------
001D5Dr 2               ; FnJoy -- JOY(n): 1 or 2.  If GPIO absent, returns 0.
001D5Dr 2               ; ---------------------------------------------------------------------------
001D5Dr 2               FnJoy:
001D5Dr 2  20 rr rr             jsr     ParenU8
001D60r 2  48                   pha
001D61r 2  AD 0D 03             lda     HW_PRESENT
001D64r 2  29 20                and     #HW_GPIO
001D66r 2  F0 1C                beq     @absent
001D68r 2  68                   pla
001D69r 2  C9 01                cmp     #1
001D6Br 2  F0 09                beq     @j1
001D6Dr 2  C9 02                cmp     #2
001D6Fr 2  F0 0C                beq     @j2
001D71r 2  A2 0B                ldx     #ERR_ILLQUAN
001D73r 2  4C rr rr             jmp     BasErrorVec
001D76r 2               @j1:
001D76r 2  20 rr rr             jsr     ReadJoystick1
001D79r 2  A8                   tay
001D7Ar 2  4C rr rr             jmp     SngFlt
001D7Dr 2               @j2:
001D7Dr 2  20 rr rr             jsr     ReadJoystick2
001D80r 2  A8                   tay
001D81r 2  4C rr rr             jmp     SngFlt
001D84r 2               @absent:
001D84r 2  68                   pla
001D85r 2                       ; $FF, not 0.  The ports are active low -- pulled high through 1K, and
001D85r 2                       ; the stick's switches ground them -- so JOY returns the port raw and 0
001D85r 2                       ; means every direction and button is held at once.  Reporting 0 for a
001D85r 2                       ; machine with no VIA fitted told the caller exactly that; $FF is what
001D85r 2                       ; an untouched stick reads, and so the honest answer for one that is
001D85r 2                       ; not there at all.
001D85r 2  A0 FF                ldy     #$FF
001D87r 2  4C rr rr             jmp     SngFlt
001D8Ar 2               
001D8Ar 2               ; ---------------------------------------------------------------------------
001D8Ar 2               ; FnNvram -- NVRAM(addr): if RTC absent, return 0.
001D8Ar 2               ; ---------------------------------------------------------------------------
001D8Ar 2               FnNvram:
001D8Ar 2  20 rr rr             jsr     ParenU8
001D8Dr 2  48                   pha
001D8Er 2  AD 0D 03             lda     HW_PRESENT
001D91r 2  29 04                and     #HW_RTC
001D93r 2  F0 09                beq     @absent
001D95r 2  68                   pla
001D96r 2  AA                   tax
001D97r 2  20 rr rr             jsr     RtcReadNVRAM
001D9Ar 2  A8                   tay
001D9Br 2  4C rr rr             jmp     SngFlt
001D9Er 2               @absent:
001D9Er 2  68                   pla
001D9Fr 2  A0 00                ldy     #0
001DA1r 2  4C rr rr             jmp     SngFlt
001DA4r 2               
001DA4r 2               ; ---------------------------------------------------------------------------
001DA4r 2               ; FnMin / FnMax -- two numeric args, smaller / larger.
001DA4r 2               ; ---------------------------------------------------------------------------
001DA4r 2               FnMin:
001DA4r 2  20 rr rr             jsr     MinMaxArgs              ; ARG = a, FAC = b, BAS_TMP3 = sign(b-a)
001DA7r 2                       ; Want smaller: if b>=a return a (ARG); else return b (FAC).
001DA7r 2  10 01                bpl     @retArg                 ; sign>=0 means b>=a
001DA9r 2  60                   rts                             ; FAC already = b
001DAAr 2               @retArg:
001DAAr 2  4C rr rr             jmp     CopyArgToFac
001DADr 2               FnMax:
001DADr 2  20 rr rr             jsr     MinMaxArgs
001DB0r 2                       ; Want larger: if b>=a return b (FAC); else return a (ARG).
001DB0r 2  10 03                bpl     @retFac
001DB2r 2  4C rr rr             jmp     CopyArgToFac
001DB5r 2               @retFac:
001DB5r 2  60                   rts
001DB6r 2               
001DB6r 2               ; MinMaxArgs -- consume "(" a "," b ")" with numerics; ARG=a, FAC=b.
001DB6r 2               ; Returns A = sign(b - a) (FF/00/01) and N flag set accordingly.
001DB6r 2               MinMaxArgs:
001DB6r 2  20 rr rr             jsr     ChkOpn
001DB9r 2  20 rr rr             jsr     FrmEvl
001DBCr 2  20 rr rr             jsr     ChkNum
001DBFr 2  20 rr rr             jsr     PushFac                 ; save a
001DC2r 2  20 rr rr             jsr     ChkCom
001DC5r 2  20 rr rr             jsr     FrmEvl
001DC8r 2  20 rr rr             jsr     ChkNum
001DCBr 2  20 rr rr             jsr     ChkCls
001DCEr 2  20 rr rr             jsr     PullArg                 ; ARG = a, FAC = b
001DD1r 2                       ; Stash ARG so we can restore after FComp's destructive sign-pack.
001DD1r 2  A5 16                lda     ARG
001DD3r 2  85 4D                sta     BAS_TEMP1
001DD5r 2  A5 17                lda     ARG+1
001DD7r 2  85 4E                sta     BAS_TEMP1+1
001DD9r 2  A5 18                lda     ARG+2
001DDBr 2  85 4F                sta     BAS_TEMP1+2
001DDDr 2  A5 19                lda     ARG+3
001DDFr 2  85 50                sta     BAS_TEMP1+3
001DE1r 2  A5 1A                lda     ARG+4
001DE3r 2  85 51                sta     BAS_TEMP1+4
001DE5r 2  A5 1B                lda     ARGSIGN
001DE7r 2  85 52                sta     BAS_TEMP1+5
001DE9r 2                       ; Pack ARGSIGN into bit 7 of ARG+1 so FComp reads it correctly.
001DE9r 2  A5 1B                lda     ARGSIGN
001DEBr 2  09 7F                ora     #$7F
001DEDr 2  25 17                and     ARG+1
001DEFr 2  85 17                sta     ARG+1
001DF1r 2  A9 16                lda     #<ARG
001DF3r 2  A0 00                ldy     #$00
001DF5r 2  20 rr rr             jsr     FComp                   ; A = sign(FAC - ARG)
001DF8r 2  48                   pha
001DF9r 2                       ; Restore ARG.
001DF9r 2  A5 4D                lda     BAS_TEMP1
001DFBr 2  85 16                sta     ARG
001DFDr 2  A5 4E                lda     BAS_TEMP1+1
001DFFr 2  85 17                sta     ARG+1
001E01r 2  A5 4F                lda     BAS_TEMP1+2
001E03r 2  85 18                sta     ARG+2
001E05r 2  A5 50                lda     BAS_TEMP1+3
001E07r 2  85 19                sta     ARG+3
001E09r 2  A5 51                lda     BAS_TEMP1+4
001E0Br 2  85 1A                sta     ARG+4
001E0Dr 2  A5 52                lda     BAS_TEMP1+5
001E0Fr 2  85 1B                sta     ARGSIGN
001E11r 2  68                   pla                             ; restore A, sets N/Z flags
001E12r 2  60                   rts
001E13r 2               
001E13r 2               ; ---------------------------------------------------------------------------
001E13r 2               ; FnLen -- LEN(s$): length of string.
001E13r 2               ; ---------------------------------------------------------------------------
001E13r 2               FnLen:
001E13r 2  20 rr rr             jsr     ParenStr
001E16r 2  A5 0E                lda     FAC                     ; length
001E18r 2  48                   pha                             ; FreFac returns with Y = descriptor hi
001E19r 2  20 rr rr             jsr     FreFac                  ; release temp string if any
001E1Cr 2  68                   pla
001E1Dr 2  A8                   tay
001E1Er 2  4C rr rr             jmp     SngFlt
001E21r 2               
001E21r 2               ; ---------------------------------------------------------------------------
001E21r 2               ; FnAsc -- ASC(s$): code of first char; ?ILLQTY if empty.
001E21r 2               ; ---------------------------------------------------------------------------
001E21r 2               FnAsc:
001E21r 2  20 rr rr             jsr     ParenStr
001E24r 2  A5 0E                lda     FAC
001E26r 2  F0 15                beq     @bad
001E28r 2                       ; Read first byte of string.
001E28r 2  A5 0F                lda     FAC+1
001E2Ar 2  85 20                sta     INDEX
001E2Cr 2  A5 10                lda     FAC+2
001E2Er 2  85 21                sta     INDEX+1
001E30r 2  A0 00                ldy     #0
001E32r 2  B1 20                lda     (INDEX),y
001E34r 2  48                   pha
001E35r 2  20 rr rr             jsr     FreFac
001E38r 2  68                   pla
001E39r 2  A8                   tay
001E3Ar 2  4C rr rr             jmp     SngFlt
001E3Dr 2               @bad:
001E3Dr 2  4C rr rr             jmp     IqErr
001E40r 2               
001E40r 2               ; ---------------------------------------------------------------------------
001E40r 2               ; FnChrStr -- CHR$(n): 1-char string.
001E40r 2               ; ---------------------------------------------------------------------------
001E40r 2               FnChrStr:
001E40r 2  20 rr rr             jsr     ParenU8
001E43r 2  48                   pha
001E44r 2  A9 01                lda     #1
001E46r 2  20 rr rr             jsr     GetSpa                  ; (Y,X) = addr; A unchanged
001E49r 2  68                   pla
001E4Ar 2  A0 00                ldy     #0
001E4Cr 2  91 84                sta     (FRESPC),y
001E4Er 2                       ; Build descriptor in FAC.
001E4Er 2  A9 01                lda     #1
001E50r 2  85 0E                sta     FAC
001E52r 2  A5 84                lda     FRESPC
001E54r 2  85 0F                sta     FAC+1
001E56r 2  A5 85                lda     FRESPC+1
001E58r 2  85 10                sta     FAC+2
001E5Ar 2                       ; Advance FRESPC past the byte we just wrote.
001E5Ar 2  E6 84                inc     FRESPC
001E5Cr 2  D0 02                bne     @nb
001E5Er 2  E6 85                inc     FRESPC+1
001E60r 2               @nb:
001E60r 2  4C rr rr             jmp     PutNew
001E63r 2               
001E63r 2               ; ---------------------------------------------------------------------------
001E63r 2               ; FnStrStr -- STR$(n): convert numeric to string.
001E63r 2               ; ---------------------------------------------------------------------------
001E63r 2               FnStrStr:
001E63r 2  20 rr rr             jsr     ParenNum
001E66r 2  20 rr rr             jsr     Fout                    ; A=lo, Y=hi -> NUL-terminated buffer
001E69r 2                       ; (A,Y) = pointer to NUL-terminated ASCII number string in STACK2.
001E69r 2  20 rr rr             jsr     StrLit                  ; allocates + copies + PutNew
001E6Cr 2  60                   rts
001E6Dr 2               
001E6Dr 2               ; ---------------------------------------------------------------------------
001E6Dr 2               ; FnVal -- VAL(s$): parse leading numeric from string.
001E6Dr 2               ; Temporarily NUL-terminates the string in place, redirects TXTPTR, calls
001E6Dr 2               ; Fin, then restores.
001E6Dr 2               ; ---------------------------------------------------------------------------
001E6Dr 2               FnVal:
001E6Dr 2  20 rr rr             jsr     ParenStr
001E70r 2  A5 0E                lda     FAC
001E72r 2  D0 08                bne     @nz
001E74r 2                       ; empty string -> 0
001E74r 2  20 rr rr             jsr     FreFac
001E77r 2  64 64                stz     VALTYP                  ; result is numeric (ParenStr set $FF)
001E79r 2  4C rr rr             jmp     ZeroFac
001E7Cr 2               @nz:
001E7Cr 2                       ; Stash length, address into TEMP1..TEMP1+2.
001E7Cr 2  85 4D                sta     TEMP1                   ; length
001E7Er 2  A5 0F                lda     FAC+1
001E80r 2  85 4E                sta     TEMP1+1
001E82r 2  A5 10                lda     FAC+2
001E84r 2  85 4F                sta     TEMP1+2
001E86r 2                       ; Reclaim the argument's temp now, while FAC still holds its
001E86r 2                       ; descriptor -- msbasic's VAL frees before parsing for the same
001E86r 2                       ; reason.  It cannot wait until after Fin: FAC+3/+4 are the two bytes
001E86r 2                       ; FreFac frees by, and by then they are mantissa of the parsed number.
001E86r 2                       ; Freeing only releases the heap for reuse and nothing allocates
001E86r 2                       ; between here and Fin, so the characters stay intact to parse.
001E86r 2                       ; Without it the temp leaked: the empty-string path above frees, the
001E86r 2                       ; parsing path did not, and three VALs of a literal in one program
001E86r 2                       ; exhausted the 3-slot temp stack with ?FORMULA TOO COMPLEX.
001E86r 2  20 rr rr             jsr     FreFac
001E89r 2                       ; Save the byte at offset = length and replace with $00.
001E89r 2  A5 4E                lda     TEMP1+1
001E8Br 2  85 20                sta     INDEX
001E8Dr 2  A5 4F                lda     TEMP1+2
001E8Fr 2  85 21                sta     INDEX+1
001E91r 2  A4 4D                ldy     TEMP1
001E93r 2  B1 20                lda     (INDEX),y
001E95r 2  85 50                sta     TEMP1+3                 ; saved byte
001E97r 2  A9 00                lda     #0
001E99r 2  91 20                sta     (INDEX),y
001E9Br 2                       ; Save TXTPTR.
001E9Br 2  A5 04                lda     TXTPTR
001E9Dr 2  48                   pha
001E9Er 2  A5 05                lda     TXTPTR+1
001EA0r 2  48                   pha
001EA1r 2                       ; TXTPTR := INDEX - 1, then ChrGet to load first char.
001EA1r 2  A5 4E                lda     TEMP1+1
001EA3r 2  85 04                sta     TXTPTR
001EA5r 2  A5 4F                lda     TEMP1+2
001EA7r 2  85 05                sta     TXTPTR+1
001EA9r 2  A5 04                lda     TXTPTR
001EABr 2  D0 02                bne     @nb
001EADr 2  C6 05                dec     TXTPTR+1
001EAFr 2               @nb:
001EAFr 2  C6 04                dec     TXTPTR
001EB1r 2  20 rr rr             jsr     ChrGet                  ; first char
001EB4r 2  20 rr rr             jsr     Fin                     ; FAC := value
001EB7r 2                       ; Restore the saved byte.
001EB7r 2  A5 4E                lda     TEMP1+1
001EB9r 2  85 20                sta     INDEX
001EBBr 2  A5 4F                lda     TEMP1+2
001EBDr 2  85 21                sta     INDEX+1
001EBFr 2  A4 4D                ldy     TEMP1
001EC1r 2  A5 50                lda     TEMP1+3
001EC3r 2  91 20                sta     (INDEX),y
001EC5r 2                       ; Restore TXTPTR.
001EC5r 2  68                   pla
001EC6r 2  85 05                sta     TXTPTR+1
001EC8r 2  68                   pla
001EC9r 2  85 04                sta     TXTPTR
001ECBr 2  64 64                stz     VALTYP                  ; Fin left VALTYP = $FF from ParenStr
001ECDr 2  60                   rts
001ECEr 2               
001ECEr 2               ; ---------------------------------------------------------------------------
001ECEr 2               ; FnLeftStr -- LEFT$(s$, n): leftmost n chars.
001ECEr 2               ; ---------------------------------------------------------------------------
001ECEr 2               FnLeftStr:
001ECEr 2  20 rr rr             jsr     ChkOpn
001ED1r 2  20 rr rr             jsr     FrmEvl
001ED4r 2  20 rr rr             jsr     ChkStr
001ED7r 2  20 rr rr             jsr     ChkCom
001EDAr 2  20 rr rr             jsr     PushFac                 ; save string descriptor
001EDDr 2  20 rr rr             jsr     FrmEvl
001EE0r 2  20 rr rr             jsr     ChkNum
001EE3r 2  20 rr rr             jsr     ChkCls
001EE6r 2  20 rr rr             jsr     AyInt
001EE9r 2  20 rr rr             jsr     PullArg                 ; ARG = string descriptor (BAS_TMP1 clobbered)
001EECr 2                       ; FAC still holds the integer n; check range and copy now.
001EECr 2  A5 11                lda     FAC+3
001EEEr 2  D0 16                bne     @bad
001EF0r 2  A5 12                lda     FAC+4
001EF2r 2  85 3B                sta     BAS_TMP1+1              ; n
001EF4r 2                       ; Clamp n to ARG (length).
001EF4r 2  A5 3B                lda     BAS_TMP1+1
001EF6r 2  C5 16                cmp     ARG
001EF8r 2  90 02                bcc     @ok
001EFAr 2  A5 16                lda     ARG
001EFCr 2               @ok:
001EFCr 2  85 3B                sta     BAS_TMP1+1
001EFEr 2                       ; Free the source temp BEFORE allocating result so the slot frees up.
001EFEr 2  20 rr rr             jsr     FreeArgString
001F01r 2                       ; Offset = 0 for LEFT$.
001F01r 2  64 3A                stz     BAS_TMP1
001F03r 2                       ; Allocate, copy first n bytes.
001F03r 2  4C rr rr             jmp     SubstrCommon            ; tail-call (rts to caller)
001F06r 2               @bad:
001F06r 2  4C rr rr             jmp     IqErr
001F09r 2               
001F09r 2               ; ---------------------------------------------------------------------------
001F09r 2               ; FnRightStr -- RIGHT$(s$, n): rightmost n chars.
001F09r 2               ; ---------------------------------------------------------------------------
001F09r 2               FnRightStr:
001F09r 2  20 rr rr             jsr     ChkOpn
001F0Cr 2  20 rr rr             jsr     FrmEvl
001F0Fr 2  20 rr rr             jsr     ChkStr
001F12r 2  20 rr rr             jsr     ChkCom
001F15r 2  20 rr rr             jsr     PushFac
001F18r 2  20 rr rr             jsr     FrmEvl
001F1Br 2  20 rr rr             jsr     ChkNum
001F1Er 2  20 rr rr             jsr     ChkCls
001F21r 2  20 rr rr             jsr     AyInt
001F24r 2  20 rr rr             jsr     PullArg                 ; ARG = string descriptor (BAS_TMP1 clobbered)
001F27r 2  A5 11                lda     FAC+3
001F29r 2  D0 1B                bne     @bad
001F2Br 2  A5 12                lda     FAC+4
001F2Dr 2  85 3B                sta     BAS_TMP1+1              ; n
001F2Fr 2                       ; Clamp n.
001F2Fr 2  A5 3B                lda     BAS_TMP1+1
001F31r 2  C5 16                cmp     ARG
001F33r 2  90 02                bcc     @ok
001F35r 2  A5 16                lda     ARG
001F37r 2               @ok:
001F37r 2  85 3B                sta     BAS_TMP1+1
001F39r 2                       ; offset = ARG - n.
001F39r 2  A5 16                lda     ARG
001F3Br 2  38                   sec
001F3Cr 2  E5 3B                sbc     BAS_TMP1+1
001F3Er 2  85 3A                sta     BAS_TMP1                ; start offset
001F40r 2  20 rr rr             jsr     FreeArgString
001F43r 2  4C rr rr             jmp     SubstrCommon
001F46r 2               @bad:
001F46r 2  4C rr rr             jmp     IqErr
001F49r 2               
001F49r 2               ; ---------------------------------------------------------------------------
001F49r 2               ; FnMidStr -- MID$(s$, m [, n]): substring starting at m (1-based).
001F49r 2               ; ---------------------------------------------------------------------------
001F49r 2               FnMidStr:
001F49r 2  20 rr rr             jsr     ChkOpn
001F4Cr 2  20 rr rr             jsr     FrmEvl
001F4Fr 2  20 rr rr             jsr     ChkStr
001F52r 2  20 rr rr             jsr     ChkCom
001F55r 2  20 rr rr             jsr     PushFac
001F58r 2                       ; Read m.
001F58r 2  20 rr rr             jsr     FrmEvl
001F5Br 2  20 rr rr             jsr     ChkNum
001F5Er 2  20 rr rr             jsr     AyInt
001F61r 2  A5 11                lda     FAC+3
001F63r 2  D0 4B                bne     @bad
001F65r 2  A5 12                lda     FAC+4
001F67r 2  F0 47                beq     @bad                    ; m must be >= 1
001F69r 2  38                   sec
001F6Ar 2  E9 01                sbc     #1
001F6Cr 2  48                   pha                             ; offset = m-1; FrmEvl below would
001F6Dr 2                                                       ; clobber BAS_TMP1, so park it here
001F6Dr 2                       ; Optional ", n".
001F6Dr 2  20 rr rr             jsr     ChrGot
001F70r 2  C9 2C                cmp     #','
001F72r 2  F0 04                beq     @hasN
001F74r 2                       ; No n: take rest -> n = 255 (will clamp).
001F74r 2  A9 FF                lda     #255
001F76r 2  80 12                bra     @gotN
001F78r 2               @hasN:
001F78r 2  20 rr rr             jsr     ChrGet
001F7Br 2  20 rr rr             jsr     FrmEvl
001F7Er 2  20 rr rr             jsr     ChkNum
001F81r 2  20 rr rr             jsr     AyInt
001F84r 2  A5 11                lda     FAC+3
001F86r 2  D0 28                bne     @bad
001F88r 2  A5 12                lda     FAC+4
001F8Ar 2               @gotN:
001F8Ar 2  85 3B                sta     BAS_TMP1+1
001F8Cr 2  68                   pla
001F8Dr 2  85 3A                sta     BAS_TMP1
001F8Fr 2  20 rr rr             jsr     ChkCls
001F92r 2  20 rr rr             jsr     PullArg                 ; ARG = string
001F95r 2                       ; Clamp offset to length.
001F95r 2  A5 3A                lda     BAS_TMP1
001F97r 2  C5 16                cmp     ARG
001F99r 2  90 04                bcc     @offOk
001F9Br 2  A5 16                lda     ARG                     ; offset = length -> empty result
001F9Dr 2  85 3A                sta     BAS_TMP1
001F9Fr 2               @offOk:
001F9Fr 2                       ; Clamp n to (length - offset).
001F9Fr 2  38                   sec
001FA0r 2  A5 16                lda     ARG
001FA2r 2  E5 3A                sbc     BAS_TMP1
001FA4r 2  C5 3B                cmp     BAS_TMP1+1
001FA6r 2  B0 02                bcs     @nOk
001FA8r 2  85 3B                sta     BAS_TMP1+1
001FAAr 2               @nOk:
001FAAr 2  20 rr rr             jsr     FreeArgString
001FADr 2  4C rr rr             jmp     SubstrCommon
001FB0r 2               @bad:
001FB0r 2  4C rr rr             jmp     IqErr
001FB3r 2               
001FB3r 2               ; ---------------------------------------------------------------------------
001FB3r 2               ; SubstrCommon -- copy BAS_TMP1+1 bytes from ARG-string at offset BAS_TMP1
001FB3r 2               ; into a new heap allocation; result descriptor in FAC; PutNew.
001FB3r 2               ; ---------------------------------------------------------------------------
001FB3r 2               SubstrCommon:
001FB3r 2                       ; Allocate.
001FB3r 2  A5 3B                lda     BAS_TMP1+1
001FB5r 2  20 rr rr             jsr     GetSpa                  ; FRESPC = new buffer
001FB8r 2                       ; Source pointer = ARG+1 (lo/hi) + BAS_TMP1.
001FB8r 2  18                   clc
001FB9r 2  A5 17                lda     ARG+1
001FBBr 2  65 3A                adc     BAS_TMP1
001FBDr 2  85 20                sta     INDEX
001FBFr 2  A5 18                lda     ARG+2
001FC1r 2  69 00                adc     #0
001FC3r 2  85 21                sta     INDEX+1
001FC5r 2                       ; Copy BAS_TMP1+1 bytes from (INDEX) to (FRESPC).
001FC5r 2  A4 3B                ldy     BAS_TMP1+1
001FC7r 2  F0 0B                beq     @done
001FC9r 2  A0 00                ldy     #0
001FCBr 2               @cp:
001FCBr 2  B1 20                lda     (INDEX),y
001FCDr 2  91 84                sta     (FRESPC),y
001FCFr 2  C8                   iny
001FD0r 2  C4 3B                cpy     BAS_TMP1+1
001FD2r 2  D0 F7                bne     @cp
001FD4r 2               @done:
001FD4r 2                       ; Build descriptor.
001FD4r 2  A5 3B                lda     BAS_TMP1+1
001FD6r 2  85 0E                sta     FAC
001FD8r 2  A5 84                lda     FRESPC
001FDAr 2  85 0F                sta     FAC+1
001FDCr 2  A5 85                lda     FRESPC+1
001FDEr 2  85 10                sta     FAC+2
001FE0r 2                       ; Advance FRESPC by length consumed.
001FE0r 2  18                   clc
001FE1r 2  A5 84                lda     FRESPC
001FE3r 2  65 3B                adc     BAS_TMP1+1
001FE5r 2  85 84                sta     FRESPC
001FE7r 2  90 02                bcc     @nb
001FE9r 2  E6 85                inc     FRESPC+1
001FEBr 2               @nb:
001FEBr 2  4C rr rr             jmp     PutNew
001FEEr 2               
001FEEr 2               ; FreeArgString -- if ARG holds a temp string descriptor (most-recent
001FEEr 2               ; on TEMPST), pop just the descriptor.  Heap is left intact so callers
001FEEr 2               ; that still need the source bytes can copy them safely; orphaned heap
001FEEr 2               ; will be reclaimed by Garbag.
001FEEr 2               FreeArgString:
001FEEr 2  A5 19                lda     ARG+3                   ; descriptor address lo
001FF0r 2  A4 1A                ldy     ARG+4                   ; descriptor address hi (always $00)
001FF2r 2  4C rr rr             jmp     FreTms
001FF5r 2               
001FF5r 2               ; Cleanup that releases both ARG's and FAC's temp descriptors (called from
001FF5r 2               ; CatStr after content has been stashed but before new allocation).
001FF5r 2               FreeBothTemps:
001FF5r 2                       ; Free FAC's temp first (it is currently LASTPT).
001FF5r 2  A5 11                lda     FAC+3
001FF7r 2  A4 12                ldy     FAC+4
001FF9r 2  20 rr rr             jsr     FreTms
001FFCr 2                       ; Then ARG's (now LASTPT after FAC's removal).
001FFCr 2  A5 19                lda     ARG+3
001FFEr 2  A4 1A                ldy     ARG+4
002000r 2  4C rr rr             jmp     FreTms
002003r 2  60                   rts
002004r 2               
002004r 2               ; ===========================================================================
002004r 2               ;   E V A L U A T O R   -   B I N A R Y   O P E R A T O R   H E L P E R S
002004r 2               ; ===========================================================================
002004r 2               
002004r 2               ; ---------------------------------------------------------------------------
002004r 2               ; AndOp -- FAC = ARG AND FAC (bitwise on 16-bit signed ints).
002004r 2               ; ---------------------------------------------------------------------------
002004r 2               AndOp:
002004r 2  20 rr rr             jsr     AyInt                   ; FAC -> int (FAC+3=hi, FAC+4=lo)
002007r 2  A5 11                lda     FAC+3
002009r 2  85 3A                sta     BAS_TMP1                ; saved hi
00200Br 2  A5 12                lda     FAC+4
00200Dr 2  85 3B                sta     BAS_TMP1+1              ; saved lo
00200Fr 2  20 rr rr             jsr     CopyArgToFac
002012r 2  20 rr rr             jsr     AyInt
002015r 2  A5 12                lda     FAC+4
002017r 2  25 3B                and     BAS_TMP1+1
002019r 2  A8                   tay                             ; Y = lo result
00201Ar 2  A5 11                lda     FAC+3
00201Cr 2  25 3A                and     BAS_TMP1                ; A = hi result
00201Er 2  4C rr rr             jmp     GivAyf
002021r 2               
002021r 2               ; ---------------------------------------------------------------------------
002021r 2               ; OrOp -- FAC = ARG OR FAC.
002021r 2               ; ---------------------------------------------------------------------------
002021r 2               OrOp:
002021r 2  20 rr rr             jsr     AyInt
002024r 2  A5 11                lda     FAC+3
002026r 2  85 3A                sta     BAS_TMP1                ; saved hi
002028r 2  A5 12                lda     FAC+4
00202Ar 2  85 3B                sta     BAS_TMP1+1              ; saved lo
00202Cr 2  20 rr rr             jsr     CopyArgToFac
00202Fr 2  20 rr rr             jsr     AyInt
002032r 2  A5 12                lda     FAC+4
002034r 2  05 3B                ora     BAS_TMP1+1
002036r 2  A8                   tay                             ; Y = lo
002037r 2  A5 11                lda     FAC+3
002039r 2  05 3A                ora     BAS_TMP1                ; A = hi
00203Br 2  4C rr rr             jmp     GivAyf
00203Er 2               
00203Er 2               ; ---------------------------------------------------------------------------
00203Er 2               ; NotOp -- FAC = NOT FAC (bitwise complement of 16-bit signed int).
00203Er 2               ; ---------------------------------------------------------------------------
00203Er 2               NotOp:
00203Er 2  20 rr rr             jsr     AyInt
002041r 2  A5 12                lda     FAC+4
002043r 2  49 FF                eor     #$FF
002045r 2  A8                   tay                             ; Y = lo
002046r 2  A5 11                lda     FAC+3
002048r 2  49 FF                eor     #$FF                    ; A = hi
00204Ar 2  4C rr rr             jmp     GivAyf
00204Dr 2               
00204Dr 2               ; ---------------------------------------------------------------------------
00204Dr 2               ; BasCmdLet -- minimal LET (assignment).  Entered with ChrGot returning
00204Dr 2               ; the first letter of the variable name.  No `LET` keyword required.
00204Dr 2               ; ---------------------------------------------------------------------------
00204Dr 2               BasCmdLet:
00204Dr 2  20 rr rr             jsr     PtrGet                  ; VARPNT, VALTYP set; TXTPTR past name
002050r 2                       ; Save VARPNT and the variable's VALTYP across FrmEvl.
002050r 2  A5 3F                lda     VARPNT
002052r 2  48                   pha
002053r 2  A5 40                lda     VARPNT+1
002055r 2  48                   pha
002056r 2  A5 64                lda     VALTYP
002058r 2  48                   pha
002059r 2  20 rr rr             jsr     ChrGot
00205Cr 2  C9 3D                cmp     #'='
00205Er 2  D0 36                bne     @synErr
002060r 2  20 rr rr             jsr     ChrGet
002063r 2  20 rr rr             jsr     FrmEvl
002066r 2  68                   pla                             ; saved variable VALTYP
002067r 2  85 3E                sta     BAS_TMP3
002069r 2  45 64                eor     VALTYP
00206Br 2  30 2F                bmi     @typeErr
00206Dr 2  68                   pla
00206Er 2  85 40                sta     VARPNT+1
002070r 2  68                   pla
002071r 2  85 3F                sta     VARPNT
002073r 2  24 3E                bit     BAS_TMP3
002075r 2  30 07                bmi     @storeStr
002077r 2                       ; Numeric: store FAC into (VARPNT) (5 bytes).
002077r 2  A6 3F                ldx     VARPNT
002079r 2  A4 40                ldy     VARPNT+1
00207Br 2  4C rr rr             jmp     StoreFacAtYxRounded
00207Er 2               @storeStr:
00207Er 2  A0 00                ldy     #0
002080r 2  A5 0E                lda     FAC
002082r 2  91 3F                sta     (VARPNT),y
002084r 2  C8                   iny
002085r 2  A5 0F                lda     FAC+1
002087r 2  91 3F                sta     (VARPNT),y
002089r 2  C8                   iny
00208Ar 2  A5 10                lda     FAC+2
00208Cr 2  91 3F                sta     (VARPNT),y
00208Er 2                       ; If the RHS was a temporary string (StrLt2/PutNew pushed it and left
00208Er 2                       ; its descriptor address in FAC+3/FAC+4 == LASTPT), pop it now that
00208Er 2                       ; the variable owns the heap copy.  Pop only (FreTms), never FreFac --
00208Er 2                       ; reclaiming would free the string we just stored.  For a plain
00208Er 2                       ; variable RHS, @loadStr set FAC+3/FAC+4 to that variable's address
00208Er 2                       ; (nonzero high byte), which cannot match a temp slot, so FreTms is a
00208Er 2                       ; no-op.  Without this, >3 consecutive string LETs leak the 3-slot
00208Er 2                       ; temp stack (?FORMULA TOO COMPLEX).
00208Er 2  A5 11                lda     FAC+3
002090r 2  A4 12                ldy     FAC+4
002092r 2  20 rr rr             jsr     FreTms
002095r 2  60                   rts
002096r 2               @synErr:
002096r 2  68                   pla
002097r 2  68                   pla
002098r 2  68                   pla
002099r 2  4C rr rr             jmp     SynErr
00209Cr 2               @typeErr:
00209Cr 2  68                   pla
00209Dr 2  68                   pla
00209Er 2  A2 08                ldx     #ERR_TYPEMISM
0020A0r 2  4C rr rr             jmp     BasErrorVec
0020A3r 2               
0020A3r 2               ; =============================================================================
0020A3r 2               ;   C O N T R O L   F L O W   /   S T A T E M E N T   L O O P
0020A3r 2               ;
0020A3r 2               ;   BasNewstt drives execution for both direct mode (TXTPTR in BAS_TOKBUF)
0020A3r 2               ;   and run mode (TXTPTR walks program lines from BAS_TXTTAB).  Statement
0020A3r 2               ;   dispatch follows the msbasic convention: push (routine_addr - 1) and
0020A3r 2               ;   tail-jump through ChrGet, so the routine entry is reached via RTS.
0020A3r 2               ;
0020A3r 2               ;   FOR and GOSUB store frames on the CPU stack and JMP back to BasNewstt;
0020A3r 2               ;   NEXT and RETURN scan the stack for a matching tag, then TXS to discard
0020A3r 2               ;   the frame and resume.
0020A3r 2               ; =============================================================================
0020A3r 2               
0020A3r 2               NUM_STMT_TOKENS = TOK_MEM + 1 - TOK_BASE       ; $36 entries
0020A3r 2               
0020A3r 2               BasNewstt:
0020A3r 2  20 rr rr             jsr     BasCheckBreak
0020A6r 2                       ; Save TXTPTR -> OLDTEXT for CONT, except in direct mode.
0020A6r 2  AD 6A 03             lda     BAS_CURLIN+1
0020A9r 2  C9 FF                cmp     #$FF
0020ABr 2  F0 0E                beq     @noSave
0020ADr 2  A5 04                lda     TXTPTR
0020AFr 2  8D 6D 03             sta     BAS_OLDTEXT
0020B2r 2  A5 05                lda     TXTPTR+1
0020B4r 2  8D 6E 03             sta     BAS_OLDTEXT+1
0020B7r 2                       ; And the stack depth this statement starts at: FOR and GOSUB frames
0020B7r 2                       ; are below it, anything a statement pushes is above.  A break restores
0020B7r 2                       ; SP to here, so the frames survive it and the half-finished statement
0020B7r 2                       ; does not -- which is what lets CONT resume inside a loop.  Recorded
0020B7r 2                       ; only in run mode: a direct-mode line must not move the baseline it is
0020B7r 2                       ; itself being run from.
0020B7r 2  BA                   tsx
0020B8r 2  8E 75 03             stx     BAS_STKBASE
0020BBr 2               @noSave:
0020BBr 2  A0 00                ldy     #0
0020BDr 2  B1 04                lda     (TXTPTR),y
0020BFr 2  F0 10                beq     @endLine
0020C1r 2  C9 A4                cmp     #TOK_ELSE
0020C3r 2  F0 07                beq     @skipElse               ; THEN-branch ran; skip ELSE clause to EOL
0020C5r 2  C9 3A                cmp     #':'
0020C7r 2  F0 37                beq     @nextStmt
0020C9r 2  4C rr rr             jmp     SynErr
0020CCr 2               @skipElse:
0020CCr 2                       ; Advance TXTPTR until we land on a $00 terminator.
0020CCr 2               @skLoop:
0020CCr 2  20 rr rr             jsr     ChrGet
0020CFr 2  D0 FB                bne     @skLoop
0020D1r 2                       ; Fall through to @endLine with TXTPTR at $00.
0020D1r 2               @endLine:
0020D1r 2                       ; Direct mode: end of buffer -> back to REPL.
0020D1r 2  AD 6A 03             lda     BAS_CURLIN+1
0020D4r 2  C9 FF                cmp     #$FF
0020D6r 2  D0 03                bne     @walkNext
0020D8r 2  4C rr rr             jmp     BasReadyLoop            ; OK is printed by BasReadyLoop
0020DBr 2               @walkNext:
0020DBr 2                       ; Run mode: examine next-pointer at offsets +1,+2.
0020DBr 2  A0 02                ldy     #2
0020DDr 2  B1 04                lda     (TXTPTR),y
0020DFr 2  D0 09                bne     @loadLine               ; nonzero hi -> next line exists
0020E1r 2                       ; End of program -> halt and return to REPL.  The program ran off its
0020E1r 2                       ; last line rather than stopping, so its frames are finished with.
0020E1r 2  A2 FF                ldx     #$FF
0020E3r 2  9A                   txs
0020E4r 2  8E 75 03             stx     BAS_STKBASE
0020E7r 2  4C rr rr             jmp     BasReadyLoop
0020EAr 2               @loadLine:
0020EAr 2  C8                   iny                             ; y=3
0020EBr 2  B1 04                lda     (TXTPTR),y
0020EDr 2  8D 69 03             sta     BAS_CURLIN
0020F0r 2  C8                   iny                             ; y=4
0020F1r 2  B1 04                lda     (TXTPTR),y
0020F3r 2  8D 6A 03             sta     BAS_CURLIN+1
0020F6r 2  98                   tya                             ; A=4
0020F7r 2  18                   clc
0020F8r 2  65 04                adc     TXTPTR
0020FAr 2  85 04                sta     TXTPTR
0020FCr 2  90 02                bcc     @nextStmt
0020FEr 2  E6 05                inc     TXTPTR+1
002100r 2               @nextStmt:
002100r 2  20 rr rr             jsr     ChrGet
002103r 2  20 rr rr             jsr     BasExecuteStatement
002106r 2  4C rr rr             jmp     BasNewstt
002109r 2               
002109r 2               ; ---------------------------------------------------------------------------
002109r 2               ; BasExecuteStatement -- A = current tokenized byte (loaded by ChrGet).
002109r 2               ;   * A = 0  -> RTS (no-op; end of statement chain).
002109r 2               ;   * A < $80 (letter) -> JMP BasCmdLet.
002109r 2               ;   * A is a statement token ($80..TOK_MEM) -> dispatch via BasTokenAddrTbl.
002109r 2               ;   * Otherwise -> ?SYNTAX ERROR.
002109r 2               ; ---------------------------------------------------------------------------
002109r 2               BasExecuteStatement:
002109r 2  F0 30                beq     @ret
00210Br 2  38                   sec
00210Cr 2  E9 80                sbc     #TOK_BASE
00210Er 2  90 25                bcc     @doLet
002110r 2  C9 36                cmp     #NUM_STMT_TOKENS
002112r 2  B0 0D                bcs     @ext
002114r 2  0A                   asl     a
002115r 2  A8                   tay
002116r 2  B9 rr rr             lda     BasTokenAddrTbl+1,y
002119r 2  48                   pha
00211Ar 2  B9 rr rr             lda     BasTokenAddrTbl,y
00211Dr 2  48                   pha
00211Er 2  4C rr rr             jmp     ChrGet
002121r 2               @ext:
002121r 2                       ; Extended statement tokens DISK through NVERASE ($D1-$DF),
002121r 2                       ; dispatched through BasExtAddrTbl.
002121r 2  38                   sec
002122r 2  E9 51                sbc     #(TOK_DISK - TOK_BASE)
002124r 2  C9 0F                cmp     #(TOK_NVERASE + 1 - TOK_DISK)
002126r 2  B0 10                bcs     @synErr
002128r 2  0A                   asl     a
002129r 2  A8                   tay
00212Ar 2  B9 rr rr             lda     BasExtAddrTbl+1,y
00212Dr 2  48                   pha
00212Er 2  B9 rr rr             lda     BasExtAddrTbl,y
002131r 2  48                   pha
002132r 2  4C rr rr             jmp     ChrGet
002135r 2               @doLet:
002135r 2  4C rr rr             jmp     BasCmdLet
002138r 2               @synErr:
002138r 2  4C rr rr             jmp     SynErr
00213Br 2               @ret:
00213Br 2  60                   rts
00213Cr 2               
00213Cr 2               ; ---------------------------------------------------------------------------
00213Cr 2               ; BasCheckBreak -- poll input buffer for Ctrl-C / ESC.  On break, save
00213Cr 2               ; CONT context and bounce to REPL.  Other keys are stashed in BAS_PENDKEY
00213Cr 2               ; for INKEY to retrieve.
00213Cr 2               ; ---------------------------------------------------------------------------
00213Cr 2               BasCheckBreak:
00213Cr 2                       ; In direct mode (CURLIN hi == $FF) skip the break check entirely;
00213Cr 2                       ; otherwise we would drain pending REPL keystrokes and corrupt the
00213Cr 2                       ; next BasReadLine input.  Break is only meaningful while RUNning.
00213Cr 2  AD 6A 03             lda     BAS_CURLIN+1
00213Fr 2  C9 FF                cmp     #$FF
002141r 2  F0 13                beq     @no
002143r 2  20 rr rr             jsr     BufferSize
002146r 2  F0 0E                beq     @no
002148r 2  20 rr rr             jsr     ReadBuffer
00214Br 2  C9 03                cmp     #$03
00214Dr 2  F0 08                beq     @break
00214Fr 2  C9 1B                cmp     #$1B
002151r 2  F0 04                beq     @break
002153r 2  8D 0E 03             sta     BAS_PENDKEY
002156r 2               @no:
002156r 2  60                   rts
002157r 2               @break:
002157r 2                       ; OLDLIN/OLDTEXT already track the executing line.  Make sure the
002157r 2                       ; saved values reflect the current line so CONT can resume.
002157r 2  AD 69 03             lda     BAS_CURLIN
00215Ar 2  8D 6B 03             sta     BAS_OLDLIN
00215Dr 2  AD 6A 03             lda     BAS_CURLIN+1
002160r 2  8D 6C 03             sta     BAS_OLDLIN+1
002163r 2  AE 75 03             ldx     BAS_STKBASE             ; Back to the statement boundary, not to
002166r 2  9A                   txs                             ;   an empty stack: the loop this broke
002167r 2                                                       ;   out of is meant to still be there
002167r 2  20 rr rr             jsr     BasTextCRLF
00216Ar 2  A9 rr                lda     #<MsgBreak
00216Cr 2  A0 rr                ldy     #>MsgBreak
00216Er 2  20 rr rr             jsr     BasPrintStr
002171r 2  4C rr rr             jmp     BasStopAtLine
002174r 2               
002174r 2  42 52 45 41  MsgBreak: .byte "BREAK",0
002178r 2  4B 00        
00217Ar 2               
00217Ar 2               ; ---------------------------------------------------------------------------
00217Ar 2               ; LinGet -- parse decimal digits at TXTPTR into BAS_LINNUM (16-bit).
00217Ar 2               ; Caller has set carry conditions appropriate to ChrGet entry.  TXTPTR
00217Ar 2               ; ends pointing at the first non-digit.
00217Ar 2               ; ---------------------------------------------------------------------------
00217Ar 2               LinGet:
00217Ar 2  A2 00                ldx     #0
00217Cr 2  86 08                stx     BAS_LINNUM
00217Er 2  86 09                stx     BAS_LINNUM+1
002180r 2               @loop:
002180r 2  B0 3A                bcs     @done
002182r 2  E9 2F                sbc     #$2F                    ; carry already set
002184r 2  85 44                sta     CHARAC
002186r 2                       ; LINNUM *= 10
002186r 2  A5 08                lda     BAS_LINNUM
002188r 2  85 3A                sta     BAS_TMP1
00218Ar 2  A5 09                lda     BAS_LINNUM+1
00218Cr 2  85 3B                sta     BAS_TMP1+1
00218Er 2  C9 19                cmp     #$19
002190r 2  B0 2B                bcs     @ovf
002192r 2  06 08                asl     BAS_LINNUM
002194r 2  26 09                rol     BAS_LINNUM+1
002196r 2  06 08                asl     BAS_LINNUM
002198r 2  26 09                rol     BAS_LINNUM+1
00219Ar 2  18                   clc
00219Br 2  A5 08                lda     BAS_LINNUM
00219Dr 2  65 3A                adc     BAS_TMP1
00219Fr 2  85 08                sta     BAS_LINNUM
0021A1r 2  A5 09                lda     BAS_LINNUM+1
0021A3r 2  65 3B                adc     BAS_TMP1+1
0021A5r 2  85 09                sta     BAS_LINNUM+1
0021A7r 2  06 08                asl     BAS_LINNUM
0021A9r 2  26 09                rol     BAS_LINNUM+1
0021ABr 2  18                   clc
0021ACr 2  A5 08                lda     BAS_LINNUM
0021AEr 2  65 44                adc     CHARAC
0021B0r 2  85 08                sta     BAS_LINNUM
0021B2r 2  90 02                bcc     @nextDigit
0021B4r 2  E6 09                inc     BAS_LINNUM+1
0021B6r 2               @nextDigit:
0021B6r 2  20 rr rr             jsr     ChrGet
0021B9r 2  4C rr rr             jmp     @loop
0021BCr 2               @done:
0021BCr 2  60                   rts
0021BDr 2               @ovf:
0021BDr 2  A2 00                ldx     #ERR_SYNTAX
0021BFr 2  4C rr rr             jmp     BasErrorVec
0021C2r 2               
0021C2r 2               ; ---------------------------------------------------------------------------
0021C2r 2               ; FndLin -- find program line whose number matches BAS_LINNUM.
0021C2r 2               ;   On success: carry SET, BAS_TMP1 (LOWTR alias) = address of line.
0021C2r 2               ;   On failure: carry CLEAR, BAS_TMP1 = address where line would belong.
0021C2r 2               ; ---------------------------------------------------------------------------
0021C2r 2               FndLin:
0021C2r 2  AD 5D 03             lda     BAS_TXTTAB
0021C5r 2  AE 5E 03             ldx     BAS_TXTTAB+1
0021C8r 2               @walk:
0021C8r 2  85 3A                sta     BAS_TMP1
0021CAr 2  86 3B                stx     BAS_TMP1+1
0021CCr 2  A0 01                ldy     #1
0021CEr 2  B1 3A                lda     (BAS_TMP1),y
0021D0r 2  F0 20                beq     @notFound               ; next-hi=0 -> end of program
0021D2r 2  A0 03                ldy     #3                      ; line-num-lo offset
0021D4r 2  A5 09                lda     BAS_LINNUM+1
0021D6r 2  D1 3A                cmp     (BAS_TMP1),y            ; compare hi byte at +3? need iny
0021D8r 2                       ; Actually format: +0 next-lo, +1 next-hi, +2 num-lo, +3 num-hi
0021D8r 2  90 18                bcc     @notFound               ; LINNUM-hi < line-hi -> miss
0021DAr 2  D0 09                bne     @advance                ; LINNUM-hi > line-hi -> next line
0021DCr 2  88                   dey                             ; y=2 = num-lo
0021DDr 2  A5 08                lda     BAS_LINNUM
0021DFr 2  D1 3A                cmp     (BAS_TMP1),y
0021E1r 2  90 0F                bcc     @notFound
0021E3r 2  F0 0F                beq     @found
0021E5r 2               @advance:
0021E5r 2  A0 00                ldy     #0
0021E7r 2  B1 3A                lda     (BAS_TMP1),y
0021E9r 2  48                   pha
0021EAr 2  A0 01                ldy     #1
0021ECr 2  B1 3A                lda     (BAS_TMP1),y
0021EEr 2  AA                   tax
0021EFr 2  68                   pla
0021F0r 2  B0 D6                bcs     @walk                   ; carry=1 means continue (always)
0021F2r 2               @notFound:
0021F2r 2  18                   clc
0021F3r 2  60                   rts
0021F4r 2               @found:
0021F4r 2  38                   sec
0021F5r 2  60                   rts
0021F6r 2               
0021F6r 2               ; ---------------------------------------------------------------------------
0021F6r 2               ; BasCmdGoto -- TXTPTR points at line-number digits.
0021F6r 2               ; ---------------------------------------------------------------------------
0021F6r 2               BasCmdGoto:
0021F6r 2  20 rr rr             jsr     LinGet
0021F9r 2  20 rr rr             jsr     BasRemn                 ; skip remainder of statement
0021FCr 2  20 rr rr             jsr     FndLin
0021FFr 2  90 0E                bcc     @undef
002201r 2                       ; LOWTR (BAS_TMP1) = target line addr.  TXTPTR = LOWTR - 1
002201r 2                       ; (so NEWSTT sees the previous line's $00 terminator at offset 0).
002201r 2  38                   sec
002202r 2  A5 3A                lda     BAS_TMP1
002204r 2  E9 01                sbc     #1
002206r 2  85 04                sta     TXTPTR
002208r 2  A5 3B                lda     BAS_TMP1+1
00220Ar 2  E9 00                sbc     #0
00220Cr 2  85 05                sta     TXTPTR+1
00220Er 2  60                   rts
00220Fr 2               @undef:
00220Fr 2  A2 03                ldx     #ERR_UNDEFSTMT
002211r 2  4C rr rr             jmp     BasErrorVec
002214r 2               
002214r 2               ; ---------------------------------------------------------------------------
002214r 2               ; BasCmdGosub -- push 5-byte frame on stack, then GOTO target.
002214r 2               ; Frame layout (top-down): [tag $8C][CURLIN-lo][CURLIN-hi][TXTPTR-lo][TXTPTR-hi]
002214r 2               ; ---------------------------------------------------------------------------
002214r 2               BasCmdGosub:
002214r 2                       ; Refuse to nest deeper than page 1 can hold.  msbasic guards every
002214r 2                       ; stack-frame push with GETSTK; this is that check specialised to
002214r 2                       ; GOSUB's fixed frame (msbasic's `LDA #3 : JSR GETSTK`, i.e. 3*2
002214r 2                       ; bytes of frame plus GETSTK's $3E-byte margin for the interpreter's
002214r 2                       ; own JSR nesting inside the subroutine).  Without it the frames run
002214r 2                       ; off the bottom of the stack and corrupt page 1 instead of raising
002214r 2                       ; an error.
002214r 2  BA                   tsx
002215r 2  E0 44                cpx     #GOSUB_STACK_MIN
002217r 2  90 1A                bcc     @outOfMemory
002219r 2  A5 05                lda     TXTPTR+1
00221Br 2  48                   pha
00221Cr 2  A5 04                lda     TXTPTR
00221Er 2  48                   pha
00221Fr 2  AD 6A 03             lda     BAS_CURLIN+1
002222r 2  48                   pha
002223r 2  AD 69 03             lda     BAS_CURLIN
002226r 2  48                   pha
002227r 2  A9 8C                lda     #TOK_GOSUB
002229r 2  48                   pha
00222Ar 2  20 rr rr             jsr     ChrGot
00222Dr 2  20 rr rr             jsr     BasCmdGoto
002230r 2  4C rr rr             jmp     BasNewstt
002233r 2               @outOfMemory:
002233r 2  A9 02                lda     #ERR_OUTOFMEM
002235r 2  4C rr rr             jmp     BasError
002238r 2               
002238r 2               ; ---------------------------------------------------------------------------
002238r 2               ; BasCmdReturn -- locate GOSUB frame on stack and resume at saved TXTPTR.
002238r 2               ; Per msbasic: scan the CPU stack from SP+5 (skipping return-routine's caller
002238r 2               ; return + this scan's own JSR return).  RTS at end pops the leaked
002238r 2               ; EXEC-return that GOSUB left behind.
002238r 2               ; ---------------------------------------------------------------------------
002238r 2               BasCmdReturn:
002238r 2  20 rr rr             jsr     GtForPnt
00223Br 2                       ; X now points to the slot just BELOW a frame tag (or end of stack).
00223Br 2  9A                   txs
00223Cr 2  C9 8C                cmp     #TOK_GOSUB
00223Er 2  F0 05                beq     @ok
002240r 2  A2 0C                ldx     #ERR_RG
002242r 2  4C rr rr             jmp     BasErrorVec
002245r 2               @ok:
002245r 2  68                   pla                             ; tag (already in A, this discards)
002246r 2  68                   pla
002247r 2  8D 69 03             sta     BAS_CURLIN
00224Ar 2  68                   pla
00224Br 2  8D 6A 03             sta     BAS_CURLIN+1
00224Er 2  68                   pla
00224Fr 2  85 04                sta     TXTPTR
002251r 2  68                   pla
002252r 2  85 05                sta     TXTPTR+1
002254r 2                       ; Skip remainder of GOSUB-target statement (DATAN-style).
002254r 2  20 rr rr             jsr     BasDatan
002257r 2                       ; Advance TXTPTR by Y (number of bytes to terminator).
002257r 2  98                   tya
002258r 2  18                   clc
002259r 2  65 04                adc     TXTPTR
00225Br 2  85 04                sta     TXTPTR
00225Dr 2  90 02                bcc     @noinc
00225Fr 2  E6 05                inc     TXTPTR+1
002261r 2               @noinc:
002261r 2  60                   rts
002262r 2               
002262r 2               ; ---------------------------------------------------------------------------
002262r 2               ; GtForPnt -- scan CPU stack for FOR/GOSUB frames.
002262r 2               ;   On entry: BAS_FORPNT (FORPNT) = $FFxx for "match any tag".
002262r 2               ;   Returns: X = stack pointer where the matching frame's tag-1 lives,
002262r 2               ;            A = tag byte found (or 0 if end-of-stack).  Z=1 if found tag,
002262r 2               ;            Z=0 (A=0) if no frame found.
002262r 2               ; ---------------------------------------------------------------------------
002262r 2               GtForPnt:
002262r 2  BA                   tsx
002263r 2  E8                   inx
002264r 2  E8                   inx
002265r 2  E8                   inx
002266r 2  E8                   inx
002267r 2               @scan:
002267r 2  BD 01 01             lda     $0101,x                 ; tag candidate
00226Ar 2  C9 81                cmp     #TOK_FOR
00226Cr 2  D0 25                bne     @notFor
00226Er 2                       ; Compare frame's variable address to FORPNT.
00226Er 2  A5 47                lda     BAS_FORPNT+1
002270r 2  D0 0A                bne     @skipVar                ; FORPNT+1 = $FF -> skip variable test
002272r 2  BD 02 01             lda     $0102,x
002275r 2  85 46                sta     BAS_FORPNT
002277r 2  BD 03 01             lda     $0103,x
00227Ar 2  85 47                sta     BAS_FORPNT+1
00227Cr 2               @skipVar:
00227Cr 2  DD 03 01             cmp     $0103,x
00227Fr 2  D0 07                bne     @advance
002281r 2  A5 46                lda     BAS_FORPNT
002283r 2  DD 02 01             cmp     $0102,x
002286r 2  F0 13                beq     @found
002288r 2               @advance:
002288r 2  8A                   txa
002289r 2  18                   clc
00228Ar 2  69 12                adc     #18                     ; BYTES_PER_FRAME (FOR)
00228Cr 2  AA                   tax
00228Dr 2  D0 D8                bne     @scan
00228Fr 2                       ; Walked off stack
00228Fr 2  A9 00                lda     #0
002291r 2  18                   clc                             ; not found
002292r 2  60                   rts
002293r 2               @notFor:
002293r 2  C9 8C                cmp     #TOK_GOSUB
002295r 2  F0 04                beq     @found
002297r 2  A9 00                lda     #0
002299r 2  18                   clc                             ; not found
00229Ar 2  60                   rts
00229Br 2               @found:
00229Br 2  38                   sec                             ; found; A still holds the tag or FORPNT
00229Cr 2  60                   rts
00229Dr 2               
00229Dr 2               ; ---------------------------------------------------------------------------
00229Dr 2               ; BasRemn -- scan TXTPTR forward to next ':' or end-of-line.
00229Dr 2               ; Sets Y to byte offset of terminator from current TXTPTR.  Honours quotes.
00229Dr 2               ; ---------------------------------------------------------------------------
00229Dr 2               BasDatan:
00229Dr 2  A2 3A                ldx     #':'
00229Fr 2  2C                   .byte   $2C                     ; BIT abs absorbs next 2-byte LDX
0022A0r 2               BasRemn:
0022A0r 2  A2 00                ldx     #0
0022A2r 2  86 44                stx     CHARAC
0022A4r 2  A0 00                ldy     #0
0022A6r 2  84 6A                sty     ENDCHR
0022A8r 2               @swap:
0022A8r 2  A5 6A                lda     ENDCHR
0022AAr 2  A6 44                ldx     CHARAC
0022ACr 2  85 44                sta     CHARAC
0022AEr 2  86 6A                stx     ENDCHR
0022B0r 2               @scan:
0022B0r 2  B1 04                lda     (TXTPTR),y
0022B2r 2  F0 0B                beq     @done
0022B4r 2  C5 6A                cmp     ENDCHR
0022B6r 2  F0 07                beq     @done
0022B8r 2  C8                   iny
0022B9r 2  C9 22                cmp     #'"'
0022BBr 2  F0 EB                beq     @swap
0022BDr 2  D0 F1                bne     @scan
0022BFr 2               @done:
0022BFr 2  60                   rts
0022C0r 2               
0022C0r 2               ; ---------------------------------------------------------------------------
0022C0r 2               ; Statement: REM -- skip to end of line.
0022C0r 2               ; Statement: DATA -- treated like REM at execution time (just skip).
0022C0r 2               ; ---------------------------------------------------------------------------
0022C0r 2               BasCmdRem:
0022C0r 2  20 rr rr             jsr     BasRemn
0022C3r 2  80 03                bra     BasAddon
0022C5r 2               BasCmdData:
0022C5r 2  20 rr rr             jsr     BasDatan
0022C8r 2               BasAddon:
0022C8r 2  98                   tya
0022C9r 2  18                   clc
0022CAr 2  65 04                adc     TXTPTR
0022CCr 2  85 04                sta     TXTPTR
0022CEr 2  90 02                bcc     @done
0022D0r 2  E6 05                inc     TXTPTR+1
0022D2r 2               @done:
0022D2r 2  60                   rts
0022D3r 2               
0022D3r 2               ; ---------------------------------------------------------------------------
0022D3r 2               ; Statement: IF expr THEN (linenum | stmt) [ELSE stmt]
0022D3r 2               ;   IF expr GOTO linenum is also accepted.
0022D3r 2               ;   If expr is false, skip rest of line (REM-style).
0022D3r 2               ;   ELSE: scan ahead for TOK_ELSE on this line.
0022D3r 2               ; ---------------------------------------------------------------------------
0022D3r 2               BasCmdIf:
0022D3r 2  20 rr rr             jsr     FrmEvl
0022D6r 2  20 rr rr             jsr     ChrGot
0022D9r 2  C9 88                cmp     #TOK_GOTO
0022DBr 2  F0 05                beq     @testTrue
0022DDr 2  A9 9F                lda     #TOK_THEN
0022DFr 2  20 rr rr             jsr     SynChr
0022E2r 2               @testTrue:
0022E2r 2  A5 0E                lda     FAC
0022E4r 2  D0 1E                bne     @true
0022E6r 2                       ; FALSE: scan to end-of-line OR a TOK_ELSE; if ELSE found, advance
0022E6r 2                       ; TXTPTR past it and resume execution there.
0022E6r 2  A0 00                ldy     #0
0022E8r 2               @searchElse:
0022E8r 2  B1 04                lda     (TXTPTR),y
0022EAr 2  F0 07                beq     @noElse
0022ECr 2  C9 A4                cmp     #TOK_ELSE
0022EEr 2  F0 09                beq     @gotElse
0022F0r 2  C8                   iny
0022F1r 2  D0 F5                bne     @searchElse
0022F3r 2               @noElse:
0022F3r 2                       ; Skip remainder of line (no ELSE).
0022F3r 2  20 rr rr             jsr     BasRemn
0022F6r 2  4C rr rr             jmp     BasAddon
0022F9r 2               @gotElse:
0022F9r 2                       ; Advance TXTPTR past ELSE token, then run the ELSE branch as a
0022F9r 2                       ; statement.  Falling through to @true's tail is deliberate: the
0022F9r 2                       ; branch after ELSE is dispatched exactly like the one after THEN,
0022F9r 2                       ; so `ELSE <linenum>` is an implicit GOTO too.  Returning here
0022F9r 2                       ; instead would leave TXTPTR mid-statement and the interpreter loop
0022F9r 2                       ; would report ?SYNTAX ERROR.
0022F9r 2  C8                   iny
0022FAr 2  98                   tya
0022FBr 2  18                   clc
0022FCr 2  65 04                adc     TXTPTR
0022FEr 2  85 04                sta     TXTPTR
002300r 2  90 02                bcc     @true
002302r 2  E6 05                inc     TXTPTR+1
002304r 2               @true:
002304r 2                       ; TRUE: if next is a digit, IF expr THEN <linenum> -> implicit GOTO.
002304r 2  20 rr rr             jsr     ChrGot
002307r 2  90 03                bcc     @goto                   ; carry CLEAR -> digit
002309r 2                       ; Otherwise dispatch as a statement (msbasic: jmp EXECUTE_STATEMENT).
002309r 2  4C rr rr             jmp     BasExecuteStatement
00230Cr 2               @goto:
00230Cr 2  4C rr rr             jmp     BasCmdGoto
00230Fr 2               
00230Fr 2               ; ---------------------------------------------------------------------------
00230Fr 2               ; Statement: ON expr GOTO/GOSUB linenum,linenum,...
00230Fr 2               ; ---------------------------------------------------------------------------
00230Fr 2               BasCmdOn:
00230Fr 2  20 rr rr             jsr     GetByt                  ; X = expr byte (1..255)
002312r 2  48                   pha                             ; save GOTO/GOSUB token byte
002313r 2  C9 8C                cmp     #TOK_GOSUB
002315r 2  F0 04                beq     @loop
002317r 2  C9 88                cmp     #TOK_GOTO
002319r 2  D0 14                bne     @synErr
00231Br 2               @loop:
00231Br 2  C6 12                dec     FAC+4
00231Dr 2  D0 04                bne     @next
00231Fr 2  68                   pla
002320r 2                       ; Re-dispatch through statement table so trampoline ChrGet skips the
002320r 2                       ; current separator (',' or 0) before the GOTO/GOSUB handler runs.
002320r 2  4C rr rr             jmp     BasExecuteStatement
002323r 2               @next:
002323r 2  20 rr rr             jsr     ChrGet
002326r 2  20 rr rr             jsr     LinGet
002329r 2  C9 2C                cmp     #','
00232Br 2  F0 EE                beq     @loop
00232Dr 2  68                   pla
00232Er 2  60                   rts
00232Fr 2               @synErr:
00232Fr 2  68                   pla
002330r 2  4C rr rr             jmp     SynErr
002333r 2               
002333r 2               ; ---------------------------------------------------------------------------
002333r 2               ; GetByt / GtByteCom -- evaluate expression in TXTPTR to byte 0..255 in X.
002333r 2               ;   GetByt: TXTPTR is at first byte of expression.
002333r 2               ;   GtByteCom: consume comma first.
002333r 2               ; ---------------------------------------------------------------------------
002333r 2               GtByteCom:
002333r 2  20 rr rr             jsr     ChrGet
002336r 2               GetByt:
002336r 2  20 rr rr             jsr     FrmNum
002339r 2  20 rr rr             jsr     MkInt
00233Cr 2  A6 11                ldx     FAC+3
00233Er 2  D0 05                bne     @ovf
002340r 2  A6 12                ldx     FAC+4
002342r 2  4C rr rr             jmp     ChrGot
002345r 2               @ovf:
002345r 2  4C rr rr             jmp     IqErr
002348r 2               
002348r 2               ; ---------------------------------------------------------------------------
002348r 2               ; Statement: RUN [linenum]
002348r 2               ; ---------------------------------------------------------------------------
002348r 2               BasCmdRun:
002348r 2  20 rr rr             jsr     ChrGot
00234Br 2  D0 21                bne     @withLine
00234Dr 2  20 rr rr             jsr     BasCmdClr
002350r 2                       ; Set TXTPTR = TXTTAB - 1 ; ensure that byte = 0.
002350r 2  38                   sec
002351r 2  AD 5D 03             lda     BAS_TXTTAB
002354r 2  E9 01                sbc     #1
002356r 2  85 04                sta     TXTPTR
002358r 2  AD 5E 03             lda     BAS_TXTTAB+1
00235Br 2  E9 00                sbc     #0
00235Dr 2  85 05                sta     TXTPTR+1
00235Fr 2                       ; Force the byte at TXTTAB-1 to be zero so NEWSTT walks the chain.
00235Fr 2  A9 00                lda     #0
002361r 2  A0 00                ldy     #0
002363r 2  91 04                sta     (TXTPTR),y
002365r 2                       ; Leave direct-mode (CURLIN+1=$FF); @loadLine will set real value.
002365r 2  9C 69 03             stz     BAS_CURLIN
002368r 2  9C 6A 03             stz     BAS_CURLIN+1
00236Br 2                       ; Straight back into the statement loop rather than RTS, as msbasic's
00236Br 2                       ; RUN does: CLR above has just reset the stack, so the return address
00236Br 2                       ; this was dispatched with is no longer on it -- which is the point.  A
00236Br 2                       ; program that starts on top of a suspended one's FOR frames is a
00236Br 2                       ; program whose first NEXT can find the wrong loop.
00236Br 2  4C rr rr             jmp     BasNewstt
00236Er 2               @withLine:
00236Er 2  20 rr rr             jsr     BasCmdClr
002371r 2  20 rr rr             jsr     ChrGot
002374r 2  20 rr rr             jsr     BasCmdGoto              ; does not return if the line is undefined
002377r 2                       ; Leave direct mode, exactly as the bare RUN path above does.
002377r 2                       ; BasCmdGoto only moves TXTPTR; while CURLIN+1 is still $FF, BasNewstt
002377r 2                       ; treats the branch target as an immediate-mode statement and returns
002377r 2                       ; to the READY loop after it -- so `RUN 20` printed nothing at all.
002377r 2                       ; Set after the branch, not before, so an undefined line still reports
002377r 2                       ; `?UNDEF'D STATEMENT ERROR` with no spurious `IN 0` line number.
002377r 2  9C 69 03             stz     BAS_CURLIN
00237Ar 2  9C 6A 03             stz     BAS_CURLIN+1
00237Dr 2  4C rr rr             jmp     BasNewstt               ; as the bare path above: CLR reset the
002380r 2                                                       ;   stack this was dispatched from
002380r 2               
002380r 2               ; ---------------------------------------------------------------------------
002380r 2               ; Statement: END / STOP -- save CONT context and return to REPL.
002380r 2               ; ---------------------------------------------------------------------------
002380r 2               BasCmdEnd:
002380r 2  18                   clc
002381r 2  24                   .byte   $24                     ; BIT zp -> skip next byte (sec)
002382r 2               BasCmdStop:
002382r 2  38                   sec
002383r 2                       ; Save the END/STOP flag (carry) before ChrGot clobbers it.
002383r 2  08                   php
002384r 2  20 rr rr             jsr     ChrGot
002387r 2  D0 2D                bne     @synErrPlp
002389r 2  28                   plp
00238Ar 2                       ; Save CONT state.
00238Ar 2  A5 04                lda     TXTPTR
00238Cr 2  8D 6D 03             sta     BAS_OLDTEXT
00238Fr 2  A5 05                lda     TXTPTR+1
002391r 2  8D 6E 03             sta     BAS_OLDTEXT+1
002394r 2  AD 69 03             lda     BAS_CURLIN
002397r 2  8D 6B 03             sta     BAS_OLDLIN
00239Ar 2  AD 6A 03             lda     BAS_CURLIN+1
00239Dr 2  8D 6C 03             sta     BAS_OLDLIN+1
0023A0r 2  AE 75 03             ldx     BAS_STKBASE             ; As with a Ctrl+C break: keep the FOR
0023A3r 2  9A                   txs                             ;   and GOSUB frames for CONT
0023A4r 2  90 0D                bcc     @end
0023A6r 2                       ; STOP path: print "BREAK[ IN nnnn]".
0023A6r 2  20 rr rr             jsr     BasTextCRLF
0023A9r 2  A9 rr                lda     #<MsgBreak
0023ABr 2  A0 rr                ldy     #>MsgBreak
0023ADr 2  20 rr rr             jsr     BasPrintStr
