002B0Dr 2  45 20 45 52  
002B11r 2  52 4F 52 0D  
002B17r 2  3F 44 45 4C  MsgDelErr:      .byte   "?DEL ERROR",$0D,$0A,0
002B1Br 2  20 45 52 52  
002B1Fr 2  4F 52 0D 0A  
002B24r 2               
002B24r 2               ; Wrappers so the dispatch table can call existing routines that expect
002B24r 2               ; TXTPTR positioned already.
002B24r 2               BasCmdPrintW:
002B24r 2                       ; We were entered via the dispatch trampoline, so TXTPTR is already
002B24r 2                       ; past the PRINT token (ChrGet was tail-called).  But BasCmdPrint
002B24r 2                       ; expects to consume the token itself with its first ChrGet; rewind.
002B24r 2                       ; Easier: BasCmdPrint reads via ChrGet; here ChrGet was called before
002B24r 2                       ; routine entry, so TXTPTR currently points at first arg.  Just call
002B24r 2                       ; an internal entry that skips the leading ChrGet.
002B24r 2  4C rr rr             jmp     BasPrLoop
002B27r 2               
002B27r 2               ; ---------------------------------------------------------------------------
002B27r 2               ; Token-address dispatch table.  Indexed by (token - $80).  Each entry is
002B27r 2               ; (routine_address - 1) since the dispatcher PHA-pushes it and uses the
002B27r 2               ; "JMP ChrGet -> RTS" trick to enter.
002B27r 2               ; ---------------------------------------------------------------------------
002B27r 2               BasTokenAddrTbl:
