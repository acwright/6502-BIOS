002465r 2  2C                   .byte   $2C
002466r 2               BasInpDoit:
002466r 2  A9 00                lda     #0
002468r 2  85 69                sta     BAS_INPUTFLG
00246Ar 2  86 3A                stx     BAS_TMP1                ; TMP1 = data pointer
00246Cr 2  84 3B                sty     BAS_TMP1+1
00246Er 2               @nextVar:
00246Er 2                       ; TXTPTR currently points into program at variable name.
00246Er 2  20 rr rr             jsr     PtrGet                  ; advances TXTPTR past var name
002471r 2  85 46                sta     BAS_FORPNT
002473r 2  84 47                sty     BAS_FORPNT+1
002475r 2                       ; Save program TXTPTR on hw stack, switch TXTPTR to data ptr.
002475r 2  A5 05                lda     TXTPTR+1
002477r 2  48                   pha
002478r 2  A5 04                lda     TXTPTR
00247Ar 2  48                   pha
00247Br 2  A5 3A                lda     BAS_TMP1
00247Dr 2  85 04                sta     TXTPTR
00247Fr 2  A5 3B                lda     BAS_TMP1+1
002481r 2  85 05                sta     TXTPTR+1
002483r 2  20 rr rr             jsr     ChrGot
002486r 2  D0 08                bne     @gotData
002488r 2                       ; Out of items on this line - find next DATA.
002488r 2  20 rr rr             jsr     BasFindData
00248Br 2  90 03                bcc     @gotData
00248Dr 2  4C rr rr             jmp     @oodata
002490r 2               @gotData:
002490r 2                       ; Advance past separator (',' between items, ' ' after DATA token,
002490r 2                       ; or quote-delimiter for strings).  ChrGet also skips spaces.
002490r 2  20 rr rr             jsr     ChrGet
002493r 2                       ; Parse value at TXTPTR (data side).
002493r 2  24 64                bit     VALTYP
002495r 2  30 0C                bmi     @readStr
002497r 2                       ; Numeric.
002497r 2  20 rr rr             jsr     Fin
00249Ar 2  A6 46                ldx     BAS_FORPNT
00249Cr 2  A4 47                ldy     BAS_FORPNT+1
00249Er 2  20 rr rr             jsr     StoreFacAtYxRounded
0024A1r 2  80 29                bra     @afterStore
0024A3r 2               @readStr:
0024A3r 2                       ; String.
0024A3r 2  A9 22                lda     #'"'
0024A5r 2  85 44                sta     CHARAC
0024A7r 2  85 6A                sta     ENDCHR
0024A9r 2  A0 00                ldy     #0
0024ABr 2  B1 04                lda     (TXTPTR),y
0024ADr 2  C9 22                cmp     #'"'
0024AFr 2  F0 08                beq     @quoted
0024B1r 2  A9 3A                lda     #':'
0024B3r 2  85 44                sta     CHARAC
0024B5r 2  A9 2C                lda     #','
0024B7r 2  85 6A                sta     ENDCHR
0024B9r 2               @quoted:
0024B9r 2  20 rr rr             jsr     StrLt2
0024BCr 2  A0 00                ldy     #0
0024BEr 2  A5 0E                lda     FAC
0024C0r 2  91 46                sta     (BAS_FORPNT),y
0024C2r 2  C8                   iny
0024C3r 2  A5 0F                lda     FAC+1
0024C5r 2  91 46                sta     (BAS_FORPNT),y
0024C7r 2  C8                   iny
0024C8r 2  A5 10                lda     FAC+2
0024CAr 2  91 46                sta     (BAS_FORPNT),y
0024CCr 2               @afterStore:
0024CCr 2                       ; Save updated data ptr.
0024CCr 2  A5 04                lda     TXTPTR
0024CEr 2  85 3A                sta     BAS_TMP1
0024D0r 2  A5 05                lda     TXTPTR+1
0024D2r 2  85 3B                sta     BAS_TMP1+1
0024D4r 2                       ; Restore program TXTPTR.
0024D4r 2  68                   pla
0024D5r 2  85 04                sta     TXTPTR
0024D7r 2  68                   pla
0024D8r 2  85 05                sta     TXTPTR+1
0024DAr 2                       ; If next program byte is ',', another variable follows.
0024DAr 2  20 rr rr             jsr     ChrGot
0024DDr 2  C9 2C                cmp     #','
0024DFr 2  D0 05                bne     @done
0024E1r 2  20 rr rr             jsr     ChrGet
0024E4r 2  80 88                bra     @nextVar
0024E6r 2               @done:
0024E6r 2                       ; Persist data ptr.
0024E6r 2  A5 3A                lda     BAS_TMP1
0024E8r 2  8D 1A 03             sta     BAS_DATAPTR
0024EBr 2  A5 3B                lda     BAS_TMP1+1
0024EDr 2  8D 1B 03             sta     BAS_DATAPTR+1
0024F0r 2  60                   rts
0024F1r 2               @oodata:
0024F1r 2  A2 0E                ldx     #ERR_OD
0024F3r 2  4C rr rr             jmp     BasErrorVec
0024F6r 2               
0024F6r 2               ; ---------------------------------------------------------------------------
0024F6r 2               ; BasFindData -- starting from TXTPTR (positioned somewhere within a line's
0024F6r 2               ; payload), advance to the byte after the next DATA token in the program.
0024F6r 2               ; Returns carry SET on out-of-data, carry CLEAR with TXTPTR at first byte
0024F6r 2               ; AFTER the DATA token (i.e. at the first DATA item).
0024F6r 2               ; ---------------------------------------------------------------------------
0024F6r 2               BasFindData:
0024F6r 2               @scanByte:
0024F6r 2  A0 00                ldy     #0
0024F8r 2  B1 04                lda     (TXTPTR),y
0024FAr 2  F0 1F                beq     @atEnd
0024FCr 2  C9 83                cmp     #TOK_DATA
0024FEr 2  F0 2E                beq     @found
002500r 2  C9 22                cmp     #'"'
002502r 2  D0 12                bne     @advance1
002504r 2                       ; Skip quoted string (advance TXTPTR past closing quote or NUL).
002504r 2  20 rr rr             jsr     @incTxt
002507r 2               @inStr:
002507r 2  A0 00                ldy     #0
002509r 2  B1 04                lda     (TXTPTR),y
00250Br 2  F0 0E                beq     @atEnd
00250Dr 2  20 rr rr             jsr     @incTxt
002510r 2  C9 22                cmp     #'"'
002512r 2  D0 F3                bne     @inStr
002514r 2  80 E0                bra     @scanByte
002516r 2               @advance1:
002516r 2  20 rr rr             jsr     @incTxt
002519r 2  80 DB                bra     @scanByte
00251Br 2               @atEnd:
00251Br 2                       ; (TXTPTR) is on the line's $00 terminator.  Bytes immediately after
00251Br 2                       ; are the next line's [next-lo][next-hi][num-lo][num-hi][payload..].
00251Br 2                       ; Check next-pointer at offset +2 (next-hi); if 0, end of program.
00251Br 2  A0 02                ldy     #2
00251Dr 2  B1 04                lda     (TXTPTR),y
00251Fr 2  F0 0F                beq     @oodata
002521r 2                       ; Advance TXTPTR by 5: past terminator (1) + line header (4).
002521r 2  18                   clc
002522r 2  A5 04                lda     TXTPTR
002524r 2  69 05                adc     #5
002526r 2  85 04                sta     TXTPTR
002528r 2  90 CC                bcc     @scanByte
00252Ar 2  E6 05                inc     TXTPTR+1
00252Cr 2  80 C8                bra     @scanByte
00252Er 2               @found:
00252Er 2                       ; TXTPTR is left AT the TOK_DATA byte; caller's CHRGET advances past.
00252Er 2  18                   clc
00252Fr 2  60                   rts
002530r 2               @oodata:
002530r 2  38                   sec
002531r 2  60                   rts
002532r 2               @incTxt:
002532r 2  E6 04                inc     TXTPTR
002534r 2  D0 02                bne     @r
002536r 2  E6 05                inc     TXTPTR+1
002538r 2               @r:
002538r 2  60                   rts
002539r 2               
002539r 2               ; ---------------------------------------------------------------------------
002539r 2               ; Statement: FOR var = expr1 TO expr2 [STEP expr3]
002539r 2               ; Pushes 18-byte frame on CPU stack:
002539r 2               ;   [tag $81][VAR-lo][VAR-hi][STEP-FP (5)][STEP-sign][CURLIN-lo][CURLIN-hi]
002539r 2               ;   [TXTPTR-lo][TXTPTR-hi][LIMIT-FP (5)]
002539r 2               ; ---------------------------------------------------------------------------
002539r 2               BasCmdFor:
002539r 2                       ; Set SUBFLG so PtrGet doesn't recurse on FN.
002539r 2  A9 80                lda     #$80
00253Br 2  85 68                sta     SUBFLG
00253Dr 2  20 rr rr             jsr     BasCmdLet               ; consumes "var = expr"
002540r 2                       ; PtrGet (inside LET) saved VARPNT in FORPNT (hopefully). Re-fetch
002540r 2                       ; FORPNT from the assignment, but BasCmdLet doesn't set FORPNT in
002540r 2                       ; our impl.  Re-parse the variable name by rewinding TXTPTR via
002540r 2                       ; CURLIN scan.  Cheat: BasCmdLet leaves VARPNT current.
002540r 2  A5 3F                lda     VARPNT
002542r 2  85 46                sta     BAS_FORPNT
002544r 2  A5 40                lda     VARPNT+1
002546r 2  85 47                sta     BAS_FORPNT+1
002548r 2                       ; Discard any prior FOR frame for the same variable to avoid leak.
002548r 2  20 rr rr             jsr     GtForPnt
00254Br 2  D0 00                bne     @noOld                  ; Z=0 -> not found (lda #0 sets Z=1; we invert below)
00254Dr 2                       ; Actually GtForPnt's "not found" path also ends with `lda #0;rts` (Z=1).
00254Dr 2                       ; So the BEQ/BNE distinction can't be used. Skip the prior-frame
00254Dr 2                       ; pop entirely; the runtime can tolerate one stray frame and msbasic
00254Dr 2                       ; FOR re-uses the same slot only when an explicit FOR with a matching
00254Dr 2                       ; variable already exists, which is rare.
00254Dr 2               @noOld:
00254Dr 2                       ; Discard our caller's (BasExecuteStatement's) return address so
00254Dr 2                       ; that the FOR frame sits on the stack with no other junk above it.
00254Dr 2                       ; We will JMP BasNewstt at the end instead of RTSing.
00254Dr 2  68                   pla
00254Er 2  68                   pla
00254Fr 2                       ; Push limit (will be parsed below) -- we lay out the frame as:
00254Fr 2                       ;   pushed first (deepest): TXTPTR, CURLIN, LIMIT (5), STEP-sign,
00254Fr 2                       ;   STEP (5), VAR-addr, $81-tag.
00254Fr 2                       ; We don't know LIMIT/STEP yet; we push placeholders and patch.
00254Fr 2                       ; Easier: parse limit & step first, then push frame in one go.
00254Fr 2  A9 9C                lda     #TOK_TO
002551r 2  20 rr rr             jsr     SynChr
002554r 2  20 rr rr             jsr     FrmNum
002557r 2                       ; Strip sign info on limit (msbasic stores limit unsigned-magnitude
002557r 2                       ; with sign packed).  Pack FACSIGN bit 7 -> FAC+1 bit 7.
002557r 2  A5 13                lda     FACSIGN
002559r 2  09 7F                ora     #$7F
00255Br 2  25 0F                and     FAC+1
00255Dr 2  85 0F                sta     FAC+1
00255Fr 2                       ; Save LIMIT temporarily in BAS_TEMP1..+4 (5 bytes).
00255Fr 2  A2 04                ldx     #4
002561r 2               @saveLimit:
002561r 2  B5 0E                lda     FAC,x
002563r 2  95 4D                sta     BAS_TEMP1,x
002565r 2  CA                   dex
002566r 2  10 F9                bpl     @saveLimit
002568r 2                       ; STEP: default 1, or evaluate after TOK_STEP.
002568r 2  20 rr rr             jsr     ChrGot
00256Br 2  C9 A1                cmp     #TOK_STEP
00256Dr 2  D0 08                bne     @defStep
00256Fr 2  20 rr rr             jsr     ChrGet
002572r 2  20 rr rr             jsr     FrmNum
002575r 2  80 07                bra     @gotStep
002577r 2               @defStep:
002577r 2  A9 rr                lda     #<ConstOne
002579r 2  A0 rr                ldy     #>ConstOne
00257Br 2  20 rr rr             jsr     LoadFacFromYa
00257Er 2               @gotStep:
00257Er 2  20 rr rr             jsr     Sign                    ; A = step sign byte (-1/0/1)
002581r 2  85 52                sta     BAS_TEMP2               ; stash step sign
002583r 2                       ; Pack sign of FAC into FAC+1 bit7 then save STEP into BAS_TEMP2+1..+5.
002583r 2  A5 13                lda     FACSIGN
002585r 2  09 7F                ora     #$7F
002587r 2  25 0F                and     FAC+1
002589r 2  85 0F                sta     FAC+1
00258Br 2  A2 04                ldx     #4
00258Dr 2               @saveStep:
00258Dr 2  B5 0E                lda     FAC,x
00258Fr 2  95 53                sta     BAS_TEMP2+1,x
002591r 2  CA                   dex
002592r 2  10 F9                bpl     @saveStep
002594r 2                       ; Now push the frame on stack (deepest first):
002594r 2                       ;   TXTPTR-hi, TXTPTR-lo, CURLIN-hi, CURLIN-lo,
002594r 2                       ;   LIMIT[4..0]   (deepest=LIMIT[4], so LIMIT[0] ends at $010A,x),
002594r 2                       ;   STEP-sign,
002594r 2                       ;   STEP[4..0]    (deepest=STEP[4], so STEP[0]  ends at $0104,x),
002594r 2                       ;   VAR-hi, VAR-lo, $81
002594r 2  A5 05                lda     TXTPTR+1
002596r 2  48                   pha
002597r 2  A5 04                lda     TXTPTR
002599r 2  48                   pha
00259Ar 2  AD 6A 03             lda     BAS_CURLIN+1
00259Dr 2  48                   pha
00259Er 2  AD 69 03             lda     BAS_CURLIN
0025A1r 2  48                   pha
0025A2r 2  A2 04                ldx     #4
0025A4r 2               @pushLim:
0025A4r 2  B5 4D                lda     BAS_TEMP1,x
0025A6r 2  48                   pha
0025A7r 2  CA                   dex
0025A8r 2  10 FA                bpl     @pushLim
0025AAr 2  A5 52                lda     BAS_TEMP2               ; step sign
0025ACr 2  48                   pha
0025ADr 2  A2 05                ldx     #5
0025AFr 2               @pushStep:
0025AFr 2  B5 52                lda     BAS_TEMP2,x
0025B1r 2  48                   pha
0025B2r 2  CA                   dex
0025B3r 2  D0 FA                bne     @pushStep
0025B5r 2  A5 47                lda     BAS_FORPNT+1
0025B7r 2  48                   pha
0025B8r 2  A5 46                lda     BAS_FORPNT
0025BAr 2  48                   pha
0025BBr 2  A9 81                lda     #TOK_FOR
0025BDr 2  48                   pha
0025BEr 2  4C rr rr             jmp     BasNewstt               ; resume statement loop with frame in place
0025C1r 2               
0025C1r 2               ConstOne:
0025C1r 2  81 00 00 00          .byte   $81,$00,$00,$00,$00     ; FP +1.0
0025C5r 2  00           
0025C6r 2               
0025C6r 2               ; ---------------------------------------------------------------------------
0025C6r 2               ; Statement: NEXT [var]
0025C6r 2               ; Locate matching FOR frame, increment var by step, test against limit,
0025C6r 2               ; loop back if more iterations remain, else discard frame and continue.
0025C6r 2               ; ---------------------------------------------------------------------------
0025C6r 2               BasCmdNext:
0025C6r 2  20 rr rr             jsr     ChrGot
0025C9r 2  F0 0D                beq     @anyVar
0025CBr 2  C9 3A                cmp     #':'
0025CDr 2  F0 09                beq     @anyVar
0025CFr 2  20 rr rr             jsr     PtrGet
0025D2r 2  85 46                sta     BAS_FORPNT
0025D4r 2  84 47                sty     BAS_FORPNT+1
0025D6r 2  80 06                bra     @find
0025D8r 2               @anyVar:
0025D8r 2                       ; "NEXT" without a variable: set FORPNT = 0 so GtForPnt copies the
0025D8r 2                       ; stack-frame's var address into FORPNT and then trivially matches
0025D8r 2                       ; (any FOR frame is acceptable).
0025D8r 2  A9 00                lda     #0
0025DAr 2  85 46                sta     BAS_FORPNT
0025DCr 2  85 47                sta     BAS_FORPNT+1
0025DEr 2               @find:
0025DEr 2  20 rr rr             jsr     GtForPnt
0025E1r 2  F0 05                beq     @found
0025E3r 2  A2 0D                ldx     #ERR_NF
0025E5r 2  4C rr rr             jmp     BasErrorVec
0025E8r 2               @found:
0025E8r 2                       ; X = stack offset of (tag - 1).  txs makes SP = X so the frame
0025E8r 2                       ; sits at $101+X..$112+X.  All subsequent accesses use $0101+offset,x
0025E8r 2                       ; just like msbasic.
0025E8r 2  9A                   txs
0025E9r 2                       ; Frame layout (tag at $0101+X):
0025E9r 2                       ;   $0101+X = $81 tag
0025E9r 2                       ;   $0102+X = VAR-lo
0025E9r 2                       ;   $0103+X = VAR-hi
0025E9r 2                       ;   $0104+X..$0108+X = STEP (5 bytes FP, FAC[0..4] ascending)
0025E9r 2                       ;   $0109+X = STEP-sign
0025E9r 2                       ;   $010A+X..$010E+X = LIMIT (5 bytes FP, FAC[0..4] ascending)
0025E9r 2                       ;   $010F+X = CURLIN-lo
0025E9r 2                       ;   $0110+X = CURLIN-hi
0025E9r 2                       ;   $0111+X = TXTPTR-lo
0025E9r 2                       ;   $0112+X = TXTPTR-hi
0025E9r 2                       ; Load STEP into FAC.
0025E9r 2  A9 01                lda     #$01
0025EBr 2  85 3B                sta     BAS_TMP1+1
0025EDr 2  8A                   txa
0025EEr 2  18                   clc
0025EFr 2  69 04                adc     #$04
0025F1r 2  85 3A                sta     BAS_TMP1                ; TMP1 -> STEP[0] at $0104,x
0025F3r 2  A5 3A                lda     BAS_TMP1
0025F5r 2  A4 3B                ldy     BAS_TMP1+1
0025F7r 2  20 rr rr             jsr     LoadFacFromYa
0025FAr 2                       ; FACSIGN := step sign byte at $0109,x.
0025FAr 2  BD 09 01             lda     $0109,x
0025FDr 2  85 13                sta     FACSIGN
0025FFr 2                       ; FAC += variable.
0025FFr 2  BD 02 01             lda     $0102,x
002602r 2  BC 03 01             ldy     $0103,x
002605r 2  85 46                sta     BAS_FORPNT
002607r 2  84 47                sty     BAS_FORPNT+1
002609r 2  20 rr rr             jsr     FAdd
00260Cr 2  20 rr rr             jsr     SetFor
00260Fr 2                       ; Compare FAC with LIMIT (at $010A,x).
00260Fr 2  BA                   tsx                             ; reload x (FAdd may have used it)
002610r 2  8A                   txa
002611r 2  18                   clc
002612r 2  69 0A                adc     #$0A
002614r 2  85 3A                sta     BAS_TMP1
002616r 2  A9 01                lda     #$01
002618r 2  85 3B                sta     BAS_TMP1+1
00261Ar 2  A5 3A                lda     BAS_TMP1
00261Cr 2  A4 3B                ldy     BAS_TMP1+1
00261Er 2  20 rr rr             jsr     FComp
002621r 2  BA                   tsx
002622r 2  38                   sec
002623r 2  FD 09 01             sbc     $0109,x                 ; A - step-sign
002626r 2  F0 19                beq     @loopDone
002628r 2                       ; Continue: restore CURLIN/TXTPTR from frame, JMP NEWSTT (don't RTS).
002628r 2  BD 0F 01             lda     $010F,x
00262Br 2  8D 69 03             sta     BAS_CURLIN
00262Er 2  BD 10 01             lda     $0110,x
002631r 2  8D 6A 03             sta     BAS_CURLIN+1
002634r 2  BD 11 01             lda     $0111,x
002637r 2  85 04                sta     TXTPTR
002639r 2  BD 12 01             lda     $0112,x
00263Cr 2  85 05                sta     TXTPTR+1
00263Er 2  4C rr rr             jmp     BasNewstt
002641r 2               @loopDone:
002641r 2                       ; Discard frame: SP := X + 18.
002641r 2  8A                   txa
002642r 2  18                   clc
002643r 2  69 12                adc     #18
002645r 2  AA                   tax
002646r 2  9A                   txs
002647r 2                       ; Allow ", var" to chain into another NEXT.
002647r 2  20 rr rr             jsr     ChrGot
00264Ar 2  C9 2C                cmp     #','
00264Cr 2  D0 06                bne     @retNewstt
00264Er 2  20 rr rr             jsr     ChrGet
002651r 2  4C rr rr             jmp     BasCmdNext
002654r 2               @retNewstt:
002654r 2  4C rr rr             jmp     BasNewstt
002657r 2               
002657r 2               ; ---------------------------------------------------------------------------
002657r 2               ; Statement: DEF FN A(X) = expr
002657r 2               ; Stored in the variable's 5 value bytes:
002657r 2               ;   [TXTPTR-of-expr-lo][TXTPTR-of-expr-hi][param-name-lo][param-name-hi][0]
002657r 2               ; ---------------------------------------------------------------------------
002657r 2               BasCmdDef:
002657r 2                       ; Expect: FN <name>(<param>) = <expr>
002657r 2  A9 9D                lda     #TOK_FN
002659r 2  20 rr rr             jsr     SynChr
00265Cr 2  09 80                ora     #$80
00265Er 2  85 68                sta     SUBFLG                  ; tell PtrGet "this is a DEF FN var"
002660r 2  20 rr rr             jsr     PtrGet
002663r 2                       ; VARPNT = address of FN var slot.
002663r 2  85 81                sta     BAS_FNCNAM
002665r 2  84 82                sty     BAS_FNCNAM+1
002667r 2  20 rr rr             jsr     ChkNum
00266Ar 2                       ; Expect '(' name ')' = expr
00266Ar 2                       ; Param name parsed by recursive PtrGet inside FrmEvl on call;
00266Ar 2                       ; here we just record (param-name) by parsing it ourselves.
00266Ar 2  A9 28                lda     #'('
00266Cr 2  20 rr rr             jsr     SynChr
00266Fr 2  A9 80                lda     #$80
002671r 2  85 68                sta     SUBFLG
002673r 2  20 rr rr             jsr     PtrGet
002676r 2                       ; VARPNT = param var addr.  Save it.
002676r 2  A5 3F                lda     VARPNT
002678r 2  85 3A                sta     BAS_TMP1
00267Ar 2  A5 40                lda     VARPNT+1
00267Cr 2  85 3B                sta     BAS_TMP1+1
00267Er 2  20 rr rr             jsr     ChkNum
002681r 2  A9 29                lda     #')'
002683r 2  20 rr rr             jsr     SynChr
002686r 2  A9 3D                lda     #'='
002688r 2  20 rr rr             jsr     SynChr
00268Br 2                       ; Reject in direct mode.
00268Br 2  AD 6A 03             lda     BAS_CURLIN+1
00268Er 2  C9 FF                cmp     #$FF
002690r 2  D0 05                bne     @ok
002692r 2  A2 07                ldx     #ERR_ILLDIRECT
002694r 2  4C rr rr             jmp     BasErrorVec
002697r 2               @ok:
002697r 2                       ; Store [TXTPTR][param][0] in FN var.
002697r 2  A0 00                ldy     #0
002699r 2  A5 04                lda     TXTPTR
00269Br 2  91 81                sta     (BAS_FNCNAM),y
00269Dr 2  C8                   iny
00269Er 2  A5 05                lda     TXTPTR+1
0026A0r 2  91 81                sta     (BAS_FNCNAM),y
0026A2r 2  C8                   iny
0026A3r 2  A5 3A                lda     BAS_TMP1
0026A5r 2  91 81                sta     (BAS_FNCNAM),y
0026A7r 2  C8                   iny
0026A8r 2  A5 3B                lda     BAS_TMP1+1
0026AAr 2  91 81                sta     (BAS_FNCNAM),y
0026ACr 2  C8                   iny
0026ADr 2  A9 00                lda     #0
0026AFr 2  91 81                sta     (BAS_FNCNAM),y
0026B1r 2                       ; Skip past expression body.
0026B1r 2  20 rr rr             jsr     BasDatan
0026B4r 2  4C rr rr             jmp     BasAddon
0026B7r 2               
0026B7r 2               ; ---------------------------------------------------------------------------
0026B7r 2               ; FnCall -- evaluator-side handler for "FN A(expr)".
0026B7r 2               ; Called by FrmEvl when it sees TOK_FN.  Evaluates argument, swaps in the
0026B7r 2               ; param's stored value, executes the FN expression, and restores the param.
0026B7r 2               ; ---------------------------------------------------------------------------
0026B7r 2               FnCall:
0026B7r 2  20 rr rr             jsr     ChrGet                  ; consume FN
0026BAr 2  09 80                ora     #$80
0026BCr 2  85 68                sta     SUBFLG
0026BEr 2  20 rr rr             jsr     PtrGet                  ; locate FN var
0026C1r 2  85 81                sta     BAS_FNCNAM
0026C3r 2  84 82                sty     BAS_FNCNAM+1
0026C5r 2  20 rr rr             jsr     ChkNum
0026C8r 2                       ; Read param ptr from FN slot.
0026C8r 2  A0 02                ldy     #2
0026CAr 2  B1 81                lda     (BAS_FNCNAM),y
0026CCr 2  85 3F                sta     VARPNT
0026CEr 2  F0 5C                beq     @undef
0026D0r 2  C8                   iny
0026D1r 2  B1 81                lda     (BAS_FNCNAM),y
0026D3r 2  85 40                sta     VARPNT+1
0026D5r 2                       ; Evaluate '(arg)'
0026D5r 2  A9 28                lda     #'('
0026D7r 2  20 rr rr             jsr     SynChr
0026DAr 2                       ; Save param's current FP value (5 bytes) on stack.
0026DAr 2  A0 04                ldy     #4
0026DCr 2               @savep:
0026DCr 2  B1 3F                lda     (VARPNT),y
0026DEr 2  48                   pha
0026DFr 2  88                   dey
0026E0r 2  10 FA                bpl     @savep
0026E2r 2                       ; Evaluate argument -> FAC.
0026E2r 2  20 rr rr             jsr     FrmNum
0026E5r 2  A9 29                lda     #')'
0026E7r 2  20 rr rr             jsr     SynChr
0026EAr 2                       ; Store FAC into param slot.
0026EAr 2  A6 3F                ldx     VARPNT
0026ECr 2  A4 40                ldy     VARPNT+1
0026EEr 2  20 rr rr             jsr     StoreFacAtYxRounded
0026F1r 2                       ; Save current TXTPTR.
0026F1r 2  A5 05                lda     TXTPTR+1
0026F3r 2  48                   pha
0026F4r 2  A5 04                lda     TXTPTR
0026F6r 2  48                   pha
0026F7r 2                       ; Switch TXTPTR to FN expression body.
0026F7r 2  A0 00                ldy     #0
0026F9r 2  B1 81                lda     (BAS_FNCNAM),y
0026FBr 2  85 04                sta     TXTPTR
0026FDr 2  C8                   iny
0026FEr 2  B1 81                lda     (BAS_FNCNAM),y
002700r 2  85 05                sta     TXTPTR+1
002702r 2                       ; Body TXTPTR is positioned at the first byte; we need it positioned
002702r 2                       ; one BEFORE so FrmNum's first ChrGet loads the first byte.  Decrement.
002702r 2  A5 04                lda     TXTPTR
002704r 2  D0 02                bne     @noBor
002706r 2  C6 05                dec     TXTPTR+1
002708r 2               @noBor:
002708r 2  C6 04                dec     TXTPTR
00270Ar 2                       ; Evaluate the FN expression body.
00270Ar 2  20 rr rr             jsr     ChrGet
00270Dr 2  20 rr rr             jsr     FrmNum
002710r 2                       ; Restore TXTPTR.
002710r 2  68                   pla
002711r 2  85 04                sta     TXTPTR
002713r 2  68                   pla
002714r 2  85 05                sta     TXTPTR+1
002716r 2                       ; Restore param.  VARPNT may have been clobbered; reload.
002716r 2  A0 02                ldy     #2
002718r 2  B1 81                lda     (BAS_FNCNAM),y
00271Ar 2  85 3F                sta     VARPNT
00271Cr 2  C8                   iny
00271Dr 2  B1 81                lda     (BAS_FNCNAM),y
00271Fr 2  85 40                sta     VARPNT+1
002721r 2  A0 00                ldy     #0
002723r 2               @restp:
002723r 2  68                   pla
002724r 2  91 3F                sta     (VARPNT),y
002726r 2  C8                   iny
002727r 2  C0 05                cpy     #5
002729r 2  D0 F8                bne     @restp
00272Br 2  60                   rts
00272Cr 2               @undef:
00272Cr 2  A2 03                ldx     #ERR_UNDEFSTMT
00272Er 2  4C rr rr             jmp     BasErrorVec
002731r 2               
002731r 2               ; ---------------------------------------------------------------------------
002731r 2               ; BasCmdDim -- DIM statement.  Dimension one or more arrays.
002731r 2               ;   On entry ChrGet has advanced past the DIM token, so A = first char of the
002731r 2               ;   first variable name.  For each name we call PtrGet2 with the from-DIM flag
002731r 2               ;   ($40) set in X; the '(' branch runs Array -> MakeNewArray, which allocates
002731r 2               ;   the array using the subscripts as sizes (0..N) and returns without looking
002731r 2               ;   up an element (DIMFLG nonzero).  Names are separated by commas.
002731r 2               ; ---------------------------------------------------------------------------
002731r 2               BasCmdDim:
002731r 2  A2 40                ldx     #$40                    ; from-DIM flag (bit 6)
002733r 2  20 rr rr             jsr     PtrGet2                 ; A = name char; create/dimension array
002736r 2  20 rr rr             jsr     ChrGot
002739r 2  C9 2C                cmp     #','
00273Br 2  D0 05                bne     @done
00273Dr 2  20 rr rr             jsr     ChrGet                  ; consume comma, advance to next name
002740r 2  80 EF                bra     BasCmdDim
002742r 2               @done:
002742r 2  60                   rts
002743r 2               
002743r 2               ; ===========================================================================
002743r 2               ;   H A R D W A R E - E X T E N S I O N   S T A T E M E N T S
002743r 2               ; ===========================================================================
002743r 2               
002743r 2               ; --- Helpers --------------------------------------------------------------
002743r 2               
002743r 2               ; Raise ?NO DEVICE error.
002743r 2               NoDevErr:
002743r 2  A2 0F                ldx     #ERR_NODEV
002745r 2  4C rr rr             jmp     BasErrorVec
002748r 2               
002748r 2               ; Require A bits in HW_PRESENT (else ?NO DEVICE).
002748r 2               ;   Input : A = mask
002748r 2               ;   Output: A preserved on success
002748r 2               ReqHw:
002748r 2  2D 0D 03             and     HW_PRESENT
00274Br 2  F0 F6                beq     NoDevErr
00274Dr 2  60                   rts
00274Er 2               
00274Er 2               ; Evaluate expression -> A in 0..255.
00274Er 2               ;   On entry: ChrGot positioned at first byte of expression.
00274Er 2               ;   On exit : A = byte, ChrGot returns char following expression.
00274Er 2               EvalU8:
00274Er 2  20 rr rr             jsr     GetByt                  ; X = byte, jmp ChrGot
002751r 2  8A                   txa
002752r 2  60                   rts
002753r 2               
002753r 2               ; Evaluate expression as 16-bit signed -> FAC+3 (hi), FAC+4 (lo).
002753r 2               EvalU16:
002753r 2  20 rr rr             jsr     FrmNum
002756r 2  20 rr rr             jsr     AyInt
002759r 2  4C rr rr             jmp     ChrGot
00275Cr 2               
00275Cr 2               ; Evaluate expression as 16-bit unsigned address (0..65535)
00275Cr 2               ;   -> FAC+3 (hi), FAC+4 (lo).  Used by SYS, POKE, PEEK, WAIT so the full
00275Cr 2               ;   6502 address space is reachable with positive decimal literals.
00275Cr 2               ;   Truncates fractional part.  Negative or >= 65536 raises ?ILLEGAL QUANTITY.
00275Cr 2               EvalAddrU16:
00275Cr 2  20 rr rr             jsr     FrmNum
00275Fr 2  20 rr rr             jsr     FacToU16
002762r 2  4C rr rr             jmp     ChrGot
002765r 2               
002765r 2               ; FacToU16 -- Convert FAC (must be 0..65535) to FAC+3 (hi), FAC+4 (lo).
002765r 2               ;   Negative or >= 65536 raises ?ILLEGAL QUANTITY.  Truncates fractional part.
002765r 2               FacToU16:
002765r 2  24 13                bit     FACSIGN
002767r 2  30 34                bmi     @illqty
002769r 2  A5 0E                lda     FAC                     ; exponent byte (0 = value is zero)
00276Br 2  F0 2B                beq     @zero
00276Dr 2  C9 91                cmp     #$91                    ; exp >= $91 means value >= 65536
00276Fr 2  B0 2C                bcs     @illqty
002771r 2                       ; Reconstruct top 16 bits of mantissa (with hidden 1 bit).
002771r 2  48                   pha                             ; save exponent byte
002772r 2  A5 0F                lda     FAC+1
002774r 2  09 80                ora     #$80                    ; restore hidden bit
002776r 2  85 3B                sta     BAS_TMP1+1              ; hi
002778r 2  A5 10                lda     FAC+2
00277Ar 2  85 3A                sta     BAS_TMP1                ; lo
00277Cr 2                       ; Shift count = $90 - exp_byte (0..15).
00277Cr 2  68                   pla
00277Dr 2  38                   sec
00277Er 2  E9 90                sbc     #$90
002780r 2  49 FF                eor     #$FF
002782r 2  18                   clc
002783r 2  69 01                adc     #1                      ; A = $90 - exp
002785r 2  F0 08                beq     @store                  ; zero shifts: already aligned
002787r 2  AA                   tax
002788r 2               @shloop:
002788r 2  46 3B                lsr     BAS_TMP1+1
00278Ar 2  66 3A                ror     BAS_TMP1
00278Cr 2  CA                   dex
00278Dr 2  D0 F9                bne     @shloop
00278Fr 2               @store:
00278Fr 2  A5 3B                lda     BAS_TMP1+1
002791r 2  85 11                sta     FAC+3
002793r 2  A5 3A                lda     BAS_TMP1
002795r 2  85 12                sta     FAC+4
002797r 2  60                   rts
002798r 2               @zero:
002798r 2  64 11                stz     FAC+3
00279Ar 2  64 12                stz     FAC+4
00279Cr 2  60                   rts
00279Dr 2               @illqty:
00279Dr 2  4C rr rr             jmp     IqErr
0027A0r 2               
0027A0r 2               ; Evaluate string expression -> copy up to 12 chars to BAS_FNAME,
0027A0r 2               ; null-terminate, set STR_PTR := BAS_FNAME, free temp string.
0027A0r 2               ; 12 = full 8.3 form ("NAME.EXT" = 8 name + '.' + 3 ext).
0027A0r 2               EvalString:
0027A0r 2  20 rr rr             jsr     FrmEvl
0027A3r 2  20 rr rr             jsr     ChkStr
0027A6r 2  A5 0F                lda     FAC+1
0027A8r 2  85 20                sta     INDEX
0027AAr 2  A5 10                lda     FAC+2
0027ACr 2  85 21                sta     INDEX+1
0027AEr 2  A0 00                ldy     #0
0027B0r 2  A6 0E                ldx     FAC                     ; length
0027B2r 2               @cpy:
0027B2r 2  C0 0C                cpy     #12
0027B4r 2  F0 0D                beq     @done
0027B6r 2  E0 00                cpx     #0
0027B8r 2  F0 09                beq     @done
0027BAr 2  B1 20                lda     (INDEX),y
0027BCr 2  99 81 03             sta     BAS_FNAME,y
0027BFr 2  C8                   iny
0027C0r 2  CA                   dex
0027C1r 2  80 EF                bra     @cpy
0027C3r 2               @done:
0027C3r 2  A9 00                lda     #0
0027C5r 2  99 81 03             sta     BAS_FNAME,y
0027C8r 2  A9 81                lda     #<BAS_FNAME
0027CAr 2  85 02                sta     STR_PTR
0027CCr 2  A9 03                lda     #>BAS_FNAME
0027CEr 2  85 03                sta     STR_PTR+1
0027D0r 2  4C rr rr             jmp     FreFac
0027D3r 2               
0027D3r 2               ; Print A as 2-digit decimal with leading zero (used by TIME/DATE).
0027D3r 2               BasPr2D:
0027D3r 2  A2 00                ldx     #0
0027D5r 2               @loop:
0027D5r 2  C9 0A                cmp     #10
0027D7r 2  90 05                bcc     @done
0027D9r 2  E9 0A                sbc     #10
0027DBr 2  E8                   inx
0027DCr 2  80 F7                bra     @loop
0027DEr 2               @done:
0027DEr 2  48                   pha
0027DFr 2  8A                   txa
0027E0r 2  09 30                ora     #'0'
0027E2r 2  20 rr rr             jsr     Chrout
0027E5r 2  68                   pla
0027E6r 2  09 30                ora     #'0'
0027E8r 2  4C rr rr             jmp     Chrout
0027EBr 2               
0027EBr 2               ; Walk program chain after LOAD to recompute BAS_VARTAB.
0027EBr 2               ;   On entry: ChrGot any.
0027EBr 2               BasFixChain:
0027EBr 2  A9 00                lda     #<PROGRAM_START
0027EDr 2  85 20                sta     INDEX
0027EFr 2  A9 08                lda     #>PROGRAM_START
0027F1r 2  85 21                sta     INDEX+1
0027F3r 2               @walk:
0027F3r 2  A0 00                ldy     #0
0027F5r 2  B1 20                lda     (INDEX),y
0027F7r 2  85 3A                sta     BAS_TMP1
0027F9r 2  C8                   iny
0027FAr 2  B1 20                lda     (INDEX),y
0027FCr 2  85 3B                sta     BAS_TMP1+1
0027FEr 2  05 3A                ora     BAS_TMP1
002800r 2  F0 0A                beq     @end
002802r 2  A5 3A                lda     BAS_TMP1
002804r 2  85 20                sta     INDEX
002806r 2  A5 3B                lda     BAS_TMP1+1
002808r 2  85 21                sta     INDEX+1
00280Ar 2  80 E7                bra     @walk
00280Cr 2               @end:
00280Cr 2                       ; INDEX points at terminator ($00 $00).  VARTAB = INDEX + 2.
00280Cr 2  18                   clc
00280Dr 2  A5 20                lda     INDEX
00280Fr 2  69 02                adc     #2
002811r 2  8D 5F 03             sta     BAS_VARTAB
002814r 2  A5 21                lda     INDEX+1
002816r 2  69 00                adc     #0
002818r 2  8D 60 03             sta     BAS_VARTAB+1
00281Br 2  60                   rts
00281Cr 2               
00281Cr 2               ; --- Statements -----------------------------------------------------------
00281Cr 2               
00281Cr 2               ; SYS addr -- jump indirectly to address (RTS returns to caller).
00281Cr 2               BasCmdSys:
00281Cr 2  20 rr rr             jsr     EvalAddrU16
00281Fr 2  A5 12                lda     FAC+4
002821r 2  85 20                sta     INDEX
002823r 2  A5 11                lda     FAC+3
002825r 2  85 21                sta     INDEX+1
002827r 2  6C 20 00             jmp     (INDEX)
00282Ar 2               
00282Ar 2               ; CLS
00282Ar 2               BasCmdCls:
00282Ar 2  A9 80                lda     #HW_VID
00282Cr 2  20 rr rr             jsr     ReqHw
00282Fr 2  4C rr rr             jmp     VideoClear
002832r 2               
002832r 2               ; LOCATE row, col
002832r 2               BasCmdLocate:
002832r 2  A9 80                lda     #HW_VID
002834r 2  20 rr rr             jsr     ReqHw
002837r 2  20 rr rr             jsr     GetByt                  ; X = row
00283Ar 2  DA                   phx
00283Br 2  20 rr rr             jsr     ChkCom
00283Er 2  20 rr rr             jsr     GetByt                  ; X = col
002841r 2  7A                   ply                             ; Y = row
002842r 2  4C rr rr             jmp     VideoSetCursor
002845r 2               
002845r 2               ; COLOR fg, bg
002845r 2               BasCmdColor:
002845r 2  A9 80                lda     #HW_VID
002847r 2  20 rr rr             jsr     ReqHw
00284Ar 2  20 rr rr             jsr     GetByt                  ; X = fg
00284Dr 2  8A                   txa
00284Er 2  0A                   asl     a
00284Fr 2  0A                   asl     a
002850r 2  0A                   asl     a
002851r 2  0A                   asl     a
002852r 2  85 3A                sta     BAS_TMP1
002854r 2  20 rr rr             jsr     ChkCom
002857r 2  20 rr rr             jsr     GetByt                  ; X = bg
00285Ar 2  8A                   txa
00285Br 2  29 0F                and     #$0F
00285Dr 2  05 3A                ora     BAS_TMP1
00285Fr 2  4C rr rr             jmp     VideoSetColor
002862r 2               
002862r 2               ; VOL n
002862r 2               BasCmdVol:
002862r 2  A9 40                lda     #HW_SID
002864r 2  20 rr rr             jsr     ReqHw
002867r 2  20 rr rr             jsr     GetByt                  ; X = vol
00286Ar 2  8A                   txa
00286Br 2  4C rr rr             jmp     SidSetVolume
00286Er 2               
00286Er 2               ; SOUND voice, freq, dur (freq=Hz, dur=centisec)
00286Er 2               ;   Hz -> SID register: reg = Hz * 16.75 ≈ Hz<<4 + Hz - Hz/4
00286Er 2               BasCmdSound:
00286Er 2  A9 40                lda     #HW_SID
002870r 2  20 rr rr             jsr     ReqHw
002873r 2  20 rr rr             jsr     GetByt                  ; X = voice (1..3)
002876r 2  CA                   dex
002877r 2  DA                   phx                             ; voice (0-indexed) on stack
002878r 2  20 rr rr             jsr     ChkCom
00287Br 2  20 rr rr             jsr     EvalU16                 ; freq Hz: hi=FAC+3, lo=FAC+4
00287Er 2                       ; Compute reg = Hz<<4 + Hz - Hz/4
00287Er 2  A5 12                lda     FAC+4
002880r 2  85 3A                sta     BAS_TMP1
002882r 2  A5 11                lda     FAC+3
002884r 2  85 3B                sta     BAS_TMP1+1
002886r 2  A5 3A                lda     BAS_TMP1
002888r 2  85 3C                sta     BAS_TMP2
00288Ar 2  A5 3B                lda     BAS_TMP1+1
00288Cr 2  85 3D                sta     BAS_TMP2+1
00288Er 2  A2 04                ldx     #4
002890r 2               @shl:
002890r 2  06 3A                asl     BAS_TMP1
002892r 2  26 3B                rol     BAS_TMP1+1
002894r 2  CA                   dex
002895r 2  D0 F9                bne     @shl
002897r 2  18                   clc
002898r 2  A5 3A                lda     BAS_TMP1
00289Ar 2  65 3C                adc     BAS_TMP2
00289Cr 2  85 3A                sta     BAS_TMP1
00289Er 2  A5 3B                lda     BAS_TMP1+1
0028A0r 2  65 3D                adc     BAS_TMP2+1
0028A2r 2  85 3B                sta     BAS_TMP1+1
0028A4r 2  46 3D                lsr     BAS_TMP2+1
0028A6r 2  66 3C                ror     BAS_TMP2
0028A8r 2  46 3D                lsr     BAS_TMP2+1
0028AAr 2  66 3C                ror     BAS_TMP2
0028ACr 2  38                   sec
0028ADr 2  A5 3A                lda     BAS_TMP1
0028AFr 2  E5 3C                sbc     BAS_TMP2
0028B1r 2  48                   pha                             ; freqLo
0028B2r 2  A5 3B                lda     BAS_TMP1+1
0028B4r 2  E5 3D                sbc     BAS_TMP2+1
0028B6r 2  48                   pha                             ; freqHi
0028B7r 2  20 rr rr             jsr     ChkCom
0028BAr 2  20 rr rr             jsr     EvalU16                 ; dur in FAC+3/+4
0028BDr 2                       ; Stack (top-down): freqHi, freqLo, voice
0028BDr 2  7A                   ply                             ; Y = freqHi
0028BEr 2  FA                   plx                             ; X = freqLo
0028BFr 2  68                   pla                             ; A = voice
0028C0r 2  20 rr rr             jsr     SidPlayNote
0028C3r 2  A5 12                lda     FAC+4
0028C5r 2  A6 11                ldx     FAC+3
0028C7r 2  20 rr rr             jsr     SysDelay
0028CAr 2  4C rr rr             jmp     SidSilence
0028CDr 2               
0028CDr 2               ; TIME
0028CDr 2               BasCmdTime:
0028CDr 2  A9 04                lda     #HW_RTC
0028CFr 2  20 rr rr             jsr     ReqHw
0028D2r 2  20 rr rr             jsr     RtcReadTime             ; A=hours, X=min, Y=sec
0028D5r 2  5A                   phy
0028D6r 2  DA                   phx
0028D7r 2  20 rr rr             jsr     BasPr2D                 ; print hours
0028DAr 2  A9 3A                lda     #':'
0028DCr 2  20 rr rr             jsr     Chrout
0028DFr 2  68                   pla
0028E0r 2  20 rr rr             jsr     BasPr2D
0028E3r 2  A9 3A                lda     #':'
0028E5r 2  20 rr rr             jsr     Chrout
0028E8r 2  68                   pla
0028E9r 2  20 rr rr             jsr     BasPr2D
0028ECr 2  4C rr rr             jmp     BasPrintCRLF
0028EFr 2               
0028EFr 2               ; DATE
0028EFr 2               BasCmdDate:
0028EFr 2  A9 04                lda     #HW_RTC
0028F1r 2  20 rr rr             jsr     ReqHw
0028F4r 2  20 rr rr             jsr     RtcReadDate             ; A=day, X=month, Y=year
0028F7r 2  48                   pha
0028F8r 2  DA                   phx
0028F9r 2  5A                   phy
0028FAr 2  AD 0B 03             lda     RTC_BUF_CENT
0028FDr 2  20 rr rr             jsr     BasPr2D
002900r 2  68                   pla
002901r 2  20 rr rr             jsr     BasPr2D
002904r 2  A9 2D                lda     #'-'
002906r 2  20 rr rr             jsr     Chrout
002909r 2  68                   pla
00290Ar 2  20 rr rr             jsr     BasPr2D
00290Dr 2  A9 2D                lda     #'-'
00290Fr 2  20 rr rr             jsr     Chrout
002912r 2  68                   pla
002913r 2  20 rr rr             jsr     BasPr2D
002916r 2  4C rr rr             jmp     BasPrintCRLF
002919r 2               
002919r 2               ; SETTIME h, m, s
002919r 2               BasCmdSettime:
002919r 2  A9 04                lda     #HW_RTC
00291Br 2  20 rr rr             jsr     ReqHw
