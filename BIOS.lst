002890r 2  8A                   txa
002891r 2  0A                   asl     a
002892r 2  0A                   asl     a
002893r 2  0A                   asl     a
002894r 2  0A                   asl     a
002895r 2  48                   pha                             ; fg must survive FrmEvl -> stack, not ZP
002896r 2  20 rr rr             jsr     ChkCom
