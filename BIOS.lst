002862r 2  8A                   txa
002863r 2  0A                   asl     a
002864r 2  0A                   asl     a
002865r 2  0A                   asl     a
002866r 2  0A                   asl     a
002867r 2  48                   pha                             ; fg must survive FrmEvl -> stack, not ZP
002868r 2  20 rr rr             jsr     ChkCom
00286Br 2  20 rr rr             jsr     GetByt                  ; X = bg
00286Er 2  8A                   txa
00286Fr 2  29 0F                and     #$0F
002871r 2  85 3A                sta     BAS_TMP1
002873r 2  68                   pla
002874r 2  05 3A                ora     BAS_TMP1
