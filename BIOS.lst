001733r 2               .if 0
001733r 2               ; (Removed in Phase 8: _VARTEST debug harness lived here.)
001733r 2               VT_SetTxt:
001733r 2                       ; Set TXTPTR = VT_TXTPTR_TMP - 1 then ChrGet to load first char.
001733r 2                       ; Actually simpler: caller passes (Y,A) = pointer; we set TXTPTR =
001733r 2                       ; (Y,A) - 1 and call ChrGet to land on (Y,A).
001733r 2                       sta     TXTPTR
001733r 2                       sty     TXTPTR+1
001733r 2                       lda     TXTPTR
001733r 2                       bne     @nb
001733r 2                       dec     TXTPTR+1
001733r 2               @nb:
001733r 2                       dec     TXTPTR
001733r 2                       jmp     ChrGet
001733r 2               
001733r 2               VT_StoreFAC:
001733r 2                       ; Round and store FAC at (VARPNT).
001733r 2                       ldx     VARPNT
001733r 2                       ldy     VARPNT+1
001733r 2                       jmp     StoreFacAtYxRounded
001733r 2               
001733r 2               VT_LoadFAC:
001733r 2                       ; Load FAC from (VARPNT).
001733r 2                       lda     VARPNT
001733r 2                       ldy     VARPNT+1
001733r 2                       jmp     LoadFacFromYa
001733r 2               
001733r 2               VT_VPSAVE       = $86           ; 2-byte ZP VARPNT save (_VARTEST debug)
001733r 2               
001733r 2               BasCmdVarTest:
001733r 2                       jsr     BasCmdClr
001733r 2               
001733r 2                       ; --- Test 1: A=3.14, B=A*2 ---
001733r 2                       lda     #<VT_NameA
001733r 2                       ldy     #>VT_NameA
001733r 2                       jsr     VT_SetTxt
001733r 2                       jsr     PtrGet                  ; creates A; VARPNT -> A's value
001733r 2                       ; FAC = 3.14
001733r 2                       lda     #<VT_pi
001733r 2                       ldy     #>VT_pi
001733r 2                       jsr     LoadFacFromYa
001733r 2                       jsr     VT_StoreFAC
001733r 2               
001733r 2                       lda     #<VT_NameB
001733r 2                       ldy     #>VT_NameB
001733r 2                       jsr     VT_SetTxt
001733r 2                       jsr     PtrGet                  ; creates B
001733r 2                       ; Save B's VARPNT.
001733r 2                       lda     VARPNT
001733r 2                       sta     VT_VPSAVE
001733r 2                       lda     VARPNT+1
001733r 2                       sta     VT_VPSAVE+1
001733r 2               
001733r 2                       ; Look up A again (already exists).
001733r 2                       lda     #<VT_NameA
001733r 2                       ldy     #>VT_NameA
001733r 2                       jsr     VT_SetTxt
001733r 2                       jsr     PtrGet
001733r 2                       jsr     VT_LoadFAC              ; FAC = A = 3.14
001733r 2                       ; Multiply by 2.
001733r 2                       lda     #<FpC2
001733r 2                       ldy     #>FpC2
001733r 2                       jsr     FMult                   ; FAC = 2 * FAC = 6.28
001733r 2                       ; Store into B.
001733r 2                       ldx     VT_VPSAVE
001733r 2                       ldy     VT_VPSAVE+1
001733r 2                       jsr     StoreFacAtYxRounded
001733r 2               
001733r 2                       ; Print result.
001733r 2                       lda     #<MsgVT_A
001733r 2                       ldy     #>MsgVT_A
001733r 2                       jsr     BasPrintStr
001733r 2                       ; Reload B and print.
001733r 2                       lda     VT_VPSAVE
001733r 2                       ldy     VT_VPSAVE+1
001733r 2                       jsr     LoadFacFromYa
001733r 2                       jsr     BasPrintFAC
001733r 2                       jsr     BasPrintCRLF
001733r 2               
001733r 2                       ; --- Test 2: A$="HELLO" ---
001733r 2                       lda     #<VT_NameAS
001733r 2                       ldy     #>VT_NameAS
001733r 2                       jsr     VT_SetTxt
001733r 2                       jsr     PtrGet                  ; creates A$
001733r 2                       ; Save VARPNT (A$ descriptor address).
001733r 2                       lda     VARPNT
001733r 2                       sta     VT_VPSAVE
001733r 2                       lda     VARPNT+1
001733r 2                       sta     VT_VPSAVE+1
001733r 2                       ; Allocate space, copy "HELLO" via StrLit.
001733r 2                       lda     #<VT_HelloLit
001733r 2                       ldy     #>VT_HelloLit
001733r 2                       jsr     StrLit                  ; FAC has descriptor, in temp stack
001733r 2                       ; Now copy descriptor (3 bytes from temp stack entry) to A$ var.
001733r 2                       ; FAC+3,4 points at the temp descriptor; FAC = length, FAC+1/2 = addr.
001733r 2                       ; The descriptor lives in TEMPST.  We just write [len][lo][hi] into
001733r 2                       ; (VARPNT) so the variable now references the heap copy.
001733r 2                       lda     FAC
001733r 2                       ldy     #$00
001733r 2                       sta     (VT_VPSAVE),y           ; length
001733r 2                       lda     FAC+1
001733r 2                       iny
001733r 2                       sta     (VT_VPSAVE),y           ; addr lo
001733r 2                       lda     FAC+2
001733r 2                       iny
001733r 2                       sta     (VT_VPSAVE),y           ; addr hi
001733r 2                       ; Print length.
001733r 2                       lda     #<MsgVT_AS
001733r 2                       ldy     #>MsgVT_AS
001733r 2                       jsr     BasPrintStr
001733r 2                       ldy     #$00
001733r 2                       lda     (VT_VPSAVE),y
001733r 2                       tay
001733r 2                       jsr     SngFlt
001733r 2                       jsr     BasPrintFAC
001733r 2                       jsr     BasPrintCRLF
001733r 2               
001733r 2                       ; --- Test 3: DIM N(10), N(5)=42 ---
001733r 2                       ; Build TXTPTR pointing at "N(10) " and call MakInt-equivalent path.
001733r 2                       ; Easier: directly construct array via PtrGet3 + Array by simulating
001733r 2                       ; a 1-D DIM of size 11 (indices 0..10).  We emulate the parser:
001733r 2                       ;   1. Set DIMFLG = $40, VARNAM = ('N','N'), call PtrGet3 with X=1?
001733r 2                       ;   2. Or: just do PtrGet3 entry by hand then jmp Array.
001733r 2                       ; Simplest: set TXTPTR at "N(10) ", DIMFLG <- $40 (from DIM
001733r 2                       ; statement), then PtrGet3 with VARNAM letter, jmp to '(' branch.
001733r 2                       lda     #<VT_DimN10
001733r 2                       ldy     #>VT_DimN10
001733r 2                       jsr     VT_SetTxt               ; A = 'N'
001733r 2                       ldx     #$40                    ; from-DIM flag (bit 6)
001733r 2                       jsr     PtrGet2                 ; will hit '(' -> Array -> create
001733r 2                       ; Now N(5)=42.  Re-parse "N(5)" to find element.
001733r 2                       lda     #<VT_DimN5
001733r 2                       ldy     #>VT_DimN5
001733r 2                       jsr     VT_SetTxt
001733r 2                       jsr     PtrGet                  ; element address in VARPNT
001733r 2                       ; Save VARPNT.
001733r 2                       lda     VARPNT
001733r 2                       sta     VT_VPSAVE
001733r 2                       lda     VARPNT+1
001733r 2                       sta     VT_VPSAVE+1
001733r 2                       ; FAC = 42.
001733r 2                       lda     #<Vt42
001733r 2                       ldy     #>Vt42
001733r 2                       jsr     LoadFacFromYa
001733r 2                       ldx     VT_VPSAVE
001733r 2                       ldy     VT_VPSAVE+1
001733r 2                       jsr     StoreFacAtYxRounded
001733r 2                       ; Read it back and print.
001733r 2                       lda     #<MsgVT_NewArr
001733r 2                       ldy     #>MsgVT_NewArr
001733r 2                       jsr     BasPrintStr
001733r 2                       lda     VT_VPSAVE
001733r 2                       ldy     VT_VPSAVE+1
001733r 2                       jsr     LoadFacFromYa
001733r 2                       jsr     BasPrintFAC
001733r 2                       jsr     BasPrintCRLF
001733r 2               
001733r 2                       ; --- Test 4: 8 string allocations + GC ---
001733r 2                       ldx     #8
001733r 2               @galloc:
001733r 2                       phx
001733r 2                       lda     #16
001733r 2                       jsr     StrSpa                  ; consumes 16 bytes; FAC has descriptor
001733r 2                       plx
001733r 2                       dex
001733r 2                       bne     @galloc
001733r 2                       ; Force GC (TEMPPT got bumped by StrSpa-via-StrIni? StrSpa itself
001733r 2                       ; doesn't call PutNew, so temp stack untouched here.)
001733r 2                       jsr     Garbag
001733r 2                       lda     #<MsgVT_GC
001733r 2                       ldy     #>MsgVT_GC
001733r 2                       jsr     BasPrintStr
001733r 2                       lda     FRETOP+1
001733r 2                       ldy     FRETOP
001733r 2                       jsr     GivAyf
001733r 2                       jsr     BasPrintFAC
001733r 2                       jsr     BasPrintCRLF
001733r 2               
001733r 2                       rts
001733r 2               .endif
001733r 2               
001733r 2               ; =============================================================================
001733r 2               ;   E X P R E S S I O N   E V A L U A T O R
001733r 2               ;
001733r 2               ;   Recursive-descent precedence climber.  Operates on tokenized text at
001733r 2               ;   TXTPTR (advanced via ChrGet/ChrGot).  Result lands in FAC (numeric)
001733r 2               ;   or as a 3-byte string descriptor at FAC..FAC+2 (string).  VALTYP
001733r 2               ;   selects: $00 = numeric, $FF = string.
001733r 2               ;
001733r 2               ;   Precedence (lowest -> highest):
001733r 2               ;     OR
001733r 2               ;     AND
001733r 2               ;     NOT  (right-assoc unary)
001733r 2               ;     comparison (= <> < > <= >=)
001733r 2               ;     + -
001733r 2               ;     * /
001733r 2               ;     ^    (right-assoc)
001733r 2               ;     unary -, unary +
001733r 2               ;     atom: number, variable, string-literal, "(" expr ")", function call
001733r 2               ; =============================================================================
001733r 2               
001733r 2               ; ---------------------------------------------------------------------------
001733r 2               ; ZP scratch used only during expression evaluation.
001733r 2               ;   BAS_LVTYP = saved VALTYP of left operand around binary ops
001733r 2               ; ---------------------------------------------------------------------------
001733r 2               BAS_LVTYP       := $86
001733r 2               
001733r 2               ; ---------------------------------------------------------------------------
001733r 2               ; FrmEvl -- top-level entry.  TXTPTR positioned so ChrGot returns the first
001733r 2               ; byte of the expression.  On exit TXTPTR is at the first byte AFTER the
001733r 2               ; expression.  Result in FAC + VALTYP.
001733r 2               ; ---------------------------------------------------------------------------
001733r 2               FrmEvl:
001733r 2  4C rr rr             jmp     EvalOr
001736r 2               
001736r 2               ; ---------------------------------------------------------------------------
001736r 2               ; PushFac -- push the current FAC + VALTYP onto the CPU stack (8 bytes).
001736r 2               ; Order pushed: VALTYP, FAC, FAC+1, FAC+2, FAC+3, FAC+4, FACSIGN, FACEXTENSION
001736r 2               ; (FACEXTENSION pushed last so it's pulled first by PullArg.)
001736r 2               ; Preserves the return address.
001736r 2               ; ---------------------------------------------------------------------------
001736r 2               PushFac:
001736r 2  68                   pla
001737r 2  A8                   tay                             ; Y = ret-addr lo
001738r 2  68                   pla
001739r 2  AA                   tax                             ; X = ret-addr hi
00173Ar 2  A5 64                lda     VALTYP
00173Cr 2  48                   pha
00173Dr 2  A5 0E                lda     FAC
00173Fr 2  48                   pha
001740r 2  A5 0F                lda     FAC+1
001742r 2  48                   pha
001743r 2  A5 10                lda     FAC+2
001745r 2  48                   pha
001746r 2  A5 11                lda     FAC+3
001748r 2  48                   pha
001749r 2  A5 12                lda     FAC+4
00174Br 2  48                   pha
00174Cr 2  A5 13                lda     FACSIGN
00174Er 2  48                   pha
00174Fr 2  A5 1D                lda     FACEXTENSION
001751r 2  48                   pha
001752r 2  8A                   txa
001753r 2  48                   pha
001754r 2  98                   tya
001755r 2  48                   pha
001756r 2  60                   rts
001757r 2               
001757r 2               ; ---------------------------------------------------------------------------
001757r 2               ; PullArg -- pop the previously-pushed FAC into ARG (signed FP value or
001757r 2               ; string descriptor in ARG..ARG+2/sign).  Sets BAS_LVTYP to the saved
001757r 2               ; left-operand VALTYP.  Preserves return address.
001757r 2               ; ---------------------------------------------------------------------------
001757r 2               PullArg:
001757r 2  68                   pla
001758r 2  A8                   tay                             ; Y = ret-addr lo
001759r 2  68                   pla
00175Ar 2  AA                   tax                             ; X = ret-addr hi
00175Br 2  68                   pla
00175Cr 2  85 43                sta     ARGEXTENSION
00175Er 2  68                   pla
00175Fr 2  85 1B                sta     ARGSIGN
001761r 2  68                   pla
001762r 2  85 1A                sta     ARG+4
001764r 2  68                   pla
001765r 2  85 19                sta     ARG+3
001767r 2  68                   pla
001768r 2  85 18                sta     ARG+2
00176Ar 2  68                   pla
00176Br 2  85 17                sta     ARG+1
00176Dr 2  68                   pla
00176Er 2  85 16                sta     ARG
001770r 2  68                   pla
001771r 2  85 86                sta     BAS_LVTYP
001773r 2  8A                   txa
001774r 2  48                   pha
001775r 2  98                   tya
001776r 2  48                   pha
001777r 2  60                   rts
001778r 2               
001778r 2               ; ---------------------------------------------------------------------------
001778r 2               ; PullFac -- pop pushed FAC back into FAC (used to discard right side and
001778r 2               ; restore left, e.g. unused).
001778r 2               ; ---------------------------------------------------------------------------
001778r 2               PullFac:
001778r 2  68                   pla
001779r 2  A8                   tay
00177Ar 2  68                   pla
00177Br 2  AA                   tax
00177Cr 2  68                   pla
00177Dr 2  85 1D                sta     FACEXTENSION
00177Fr 2  68                   pla
001780r 2  85 13                sta     FACSIGN
001782r 2  68                   pla
001783r 2  85 12                sta     FAC+4
001785r 2  68                   pla
001786r 2  85 11                sta     FAC+3
001788r 2  68                   pla
001789r 2  85 10                sta     FAC+2
00178Br 2  68                   pla
00178Cr 2  85 0F                sta     FAC+1
00178Er 2  68                   pla
00178Fr 2  85 0E                sta     FAC
001791r 2  68                   pla
001792r 2  85 64                sta     VALTYP
001794r 2  8A                   txa
001795r 2  48                   pha
001796r 2  98                   tya
001797r 2  48                   pha
001798r 2  60                   rts
001799r 2               
001799r 2               ; ---------------------------------------------------------------------------
001799r 2               ; TypeMismatch helper.
001799r 2               ; ---------------------------------------------------------------------------
001799r 2               EvalTypeErr:
001799r 2  A2 08                ldx     #ERR_TYPEMISM
00179Br 2  4C rr rr             jmp     BasErrorVec
00179Er 2               
00179Er 2               ; ===========================================================================
00179Er 2               ;   L E V E L 0  --  O R
00179Er 2               ; ===========================================================================
00179Er 2               EvalOr:
00179Er 2  20 rr rr             jsr     EvalAnd
0017A1r 2               @loop:
0017A1r 2  20 rr rr             jsr     ChrGot
0017A4r 2  C9 A3                cmp     #TOK_OR
0017A6r 2  D0 17                bne     @done
0017A8r 2  20 rr rr             jsr     ChkNum                  ; left must be numeric
0017ABr 2  20 rr rr             jsr     ChrGet                  ; consume OR
0017AEr 2  20 rr rr             jsr     PushFac
0017B1r 2  20 rr rr             jsr     EvalAnd
0017B4r 2  20 rr rr             jsr     ChkNum                  ; right must be numeric
0017B7r 2  20 rr rr             jsr     PullArg
0017BAr 2  20 rr rr             jsr     OrOp
0017BDr 2  80 E2                bra     @loop
0017BFr 2               @done:
0017BFr 2  60                   rts
0017C0r 2               
0017C0r 2               ; ===========================================================================
0017C0r 2               ;   L E V E L 1  --  A N D
0017C0r 2               ; ===========================================================================
0017C0r 2               EvalAnd:
0017C0r 2  20 rr rr             jsr     EvalNot
0017C3r 2               @loop:
0017C3r 2  20 rr rr             jsr     ChrGot
0017C6r 2  C9 A2                cmp     #TOK_AND
0017C8r 2  D0 17                bne     @done
0017CAr 2  20 rr rr             jsr     ChkNum
0017CDr 2  20 rr rr             jsr     ChrGet
0017D0r 2  20 rr rr             jsr     PushFac
0017D3r 2  20 rr rr             jsr     EvalNot
0017D6r 2  20 rr rr             jsr     ChkNum
0017D9r 2  20 rr rr             jsr     PullArg
0017DCr 2  20 rr rr             jsr     AndOp
0017DFr 2  80 E2                bra     @loop
0017E1r 2               @done:
0017E1r 2  60                   rts
0017E2r 2               
0017E2r 2               ; ===========================================================================
0017E2r 2               ;   L E V E L 2  --  N O T   (right-assoc unary prefix)
0017E2r 2               ; ===========================================================================
0017E2r 2               EvalNot:
0017E2r 2  20 rr rr             jsr     ChrGot
0017E5r 2  C9 A0                cmp     #TOK_NOT
0017E7r 2  D0 0C                bne     EvalCmp
0017E9r 2  20 rr rr             jsr     ChrGet
0017ECr 2  20 rr rr             jsr     EvalNot
0017EFr 2  20 rr rr             jsr     ChkNum
0017F2r 2  4C rr rr             jmp     NotOp
0017F5r 2               
0017F5r 2               ; ===========================================================================
0017F5r 2               ;   L E V E L 3  --  C O M P A R I S O N
0017F5r 2               ;   Reads up to two of {<, =, >} forming a relop; if none, no-op.
0017F5r 2               ;   Mask:  bit 0 = '>' present, bit 1 = '=' present, bit 2 = '<' present
0017F5r 2               ; ===========================================================================
0017F5r 2               EvalCmp:
0017F5r 2  20 rr rr             jsr     EvalAdd
0017F8r 2  A2 00                ldx     #0                      ; relop mask
0017FAr 2               @scan:
0017FAr 2  20 rr rr             jsr     ChrGot
0017FDr 2  C9 3D                cmp     #'='
0017FFr 2  F0 0A                beq     @gotEq
001801r 2  C9 3C                cmp     #'<'
001803r 2  F0 0A                beq     @gotLt
001805r 2  C9 3E                cmp     #'>'
001807r 2  F0 0A                beq     @gotGt
001809r 2  80 1D                bra     @done
00180Br 2               @gotEq:
00180Br 2  A0 02                ldy     #2
00180Dr 2  80 06                bra     @setbit
00180Fr 2               @gotLt:
00180Fr 2  A0 04                ldy     #4
001811r 2  80 02                bra     @setbit
001813r 2               @gotGt:
001813r 2  A0 01                ldy     #1
001815r 2               @setbit:
001815r 2  84 45                sty     CPRMASK                 ; reuse as scratch
001817r 2  8A                   txa
001818r 2  25 45                and     CPRMASK
00181Ar 2  D0 09                bne     @synErr                 ; same char twice (e.g. "==")
00181Cr 2  8A                   txa
00181Dr 2  05 45                ora     CPRMASK
00181Fr 2  AA                   tax
001820r 2  20 rr rr             jsr     ChrGet
001823r 2  80 D5                bra     @scan
001825r 2               @synErr:
001825r 2  4C rr rr             jmp     SynErr
001828r 2               @done:
001828r 2  E0 00                cpx     #0
00182Ar 2  D0 01                bne     @doCmp
00182Cr 2  60                   rts
00182Dr 2               @doCmp:
00182Dr 2  86 45                stx     CPRMASK
00182Fr 2                       ; Save left operand, evaluate right
00182Fr 2  20 rr rr             jsr     PushFac
001832r 2  20 rr rr             jsr     EvalAdd
001835r 2  20 rr rr             jsr     PullArg                 ; ARG = left, BAS_LVTYP = left's type
001838r 2                       ; Type compatibility check.
001838r 2  A5 86                lda     BAS_LVTYP
00183Ar 2  45 64                eor     VALTYP
00183Cr 2  10 03 4C rr          jmi     EvalTypeErr             ; one numeric, one string -> mismatch
001840r 2  rr           
001841r 2  24 64                bit     VALTYP
001843r 2  30 03                bmi     @strCmp
001845r 2                       ; Numeric comparison.
001845r 2  4C rr rr             jmp     RelOpsNum
001848r 2               @strCmp:
001848r 2  4C rr rr             jmp     RelOpsStr
00184Br 2               
00184Br 2               ; ---------------------------------------------------------------------------
00184Br 2               ; RelOpsNum -- numeric comparison.
00184Br 2               ; Inputs: ARG = left, FAC = right, CPRMASK = relop mask (bit 0=>, 1==, 2=<).
00184Br 2               ; Output: FAC = -1 if (ARG <op> FAC) is true, else 0.  VALTYP = numeric.
00184Br 2               ; ---------------------------------------------------------------------------
00184Br 2               RelOpsNum:
00184Br 2                       ; Replicate msbasic ARG-pre-relop fixup: clear ARG+1 high bit, then
00184Br 2                       ; set it from ARGSIGN's MSB.  This rebuilds the implicit-1 mantissa
00184Br 2                       ; for FCOMP's signed comparison path.
00184Br 2  A5 1B                lda     ARGSIGN
00184Dr 2  09 7F                ora     #$7F
00184Fr 2  25 17                and     ARG+1
001851r 2  85 17                sta     ARG+1
001853r 2  A9 16                lda     #<ARG
001855r 2  A0 00                ldy     #$00
001857r 2  20 rr rr             jsr     FComp                   ; A = sign(FAC - ARG)
00185Ar 2                       ; Map A to bit position:
00185Ar 2                       ;   FAC<ARG (A=$FF): ARG>FAC  -> bit 0 (mask 1)
00185Ar 2                       ;   FAC=ARG (A=$00):           -> bit 1 (mask 2)
00185Ar 2                       ;   FAC>ARG (A=$01): ARG<FAC  -> bit 2 (mask 4)
00185Ar 2  AA                   tax
00185Br 2  30 06                bmi     @lt
00185Dr 2  F0 08                beq     @eq
00185Fr 2  A9 04                lda     #4
001861r 2  80 06                bra     @check
001863r 2               @lt:
001863r 2  A9 01                lda     #1
001865r 2  80 02                bra     @check
001867r 2               @eq:
001867r 2  A9 02                lda     #2
001869r 2               @check:
001869r 2  25 45                and     CPRMASK
00186Br 2  F0 07                beq     @false
00186Dr 2  A9 FF                lda     #$FF
00186Fr 2  A0 FF                ldy     #$FF
001871r 2  4C rr rr             jmp     GivAyf
001874r 2               @false:
001874r 2  A9 00                lda     #0
001876r 2  A8                   tay
001877r 2  4C rr rr             jmp     GivAyf
00187Ar 2               
00187Ar 2               ; ---------------------------------------------------------------------------
00187Ar 2               ; RelOpsStr -- bytewise string comparison.
00187Ar 2               ; ARG = left descriptor (ARG=len, ARG+1=lo, ARG+2=hi, ARGSIGN, ARGEXT pushed).
00187Ar 2               ; FAC = right descriptor.  CPRMASK as above.
00187Ar 2               ; ---------------------------------------------------------------------------
00187Ar 2               RelOpsStr:
00187Ar 2                       ; INDEX = left ptr, BAS_TMP1 = right ptr, BAS_TMP2 lo = left len,
00187Ar 2                       ; BAS_TMP2 hi = right len.
00187Ar 2  A5 17                lda     ARG+1
00187Cr 2  85 20                sta     INDEX
00187Er 2  A5 18                lda     ARG+2
001880r 2  85 21                sta     INDEX+1
001882r 2  A5 0F                lda     FAC+1
001884r 2  85 3A                sta     BAS_TMP1
001886r 2  A5 10                lda     FAC+2
001888r 2  85 3B                sta     BAS_TMP1+1
00188Ar 2  A5 16                lda     ARG
00188Cr 2  85 3C                sta     BAS_TMP2                ; left len
00188Er 2  A5 0E                lda     FAC
001890r 2  85 3D                sta     BAS_TMP2+1              ; right len
001892r 2                       ; Compare byte-by-byte up to min length.
001892r 2  A0 00                ldy     #0
001894r 2               @cmp:
001894r 2                       ; Has either side ended?
001894r 2  C4 3C                cpy     BAS_TMP2
001896r 2  F0 17                beq     @leftEnd
001898r 2  C4 3D                cpy     BAS_TMP2+1
00189Ar 2  F0 1B                beq     @rightEnd               ; right ended first -> left > right
00189Cr 2  B1 20                lda     (INDEX),y
00189Er 2  D1 3A                cmp     (BAS_TMP1),y
0018A0r 2  F0 0A                beq     @next
0018A2r 2  90 04                bcc     @lt                     ; left < right
0018A4r 2                       ; left > right
0018A4r 2  A9 01                lda     #1
0018A6r 2  80 15                bra     @decide
0018A8r 2               @lt:
0018A8r 2  A9 04                lda     #4
0018AAr 2  80 11                bra     @decide
0018ACr 2               @next:
0018ACr 2  C8                   iny
0018ADr 2  80 E5                bra     @cmp
0018AFr 2               @leftEnd:
0018AFr 2                       ; Left ran out; check right
0018AFr 2  C4 3D                cpy     BAS_TMP2+1
0018B1r 2  F0 08                beq     @equal
0018B3r 2                       ; left < right (left is prefix)
0018B3r 2  A9 04                lda     #4
0018B5r 2  80 06                bra     @decide
0018B7r 2               @rightEnd:
0018B7r 2                       ; right ran out, left has more; left > right
0018B7r 2  A9 01                lda     #1
0018B9r 2  80 02                bra     @decide
0018BBr 2               @equal:
0018BBr 2  A9 02                lda     #2
0018BDr 2               @decide:
0018BDr 2  25 45                and     CPRMASK
0018BFr 2  F0 05                beq     @false
0018C1r 2  A9 FF                lda     #$FF
0018C3r 2  A8                   tay
0018C4r 2  80 03                bra     @ret
0018C6r 2               @false:
0018C6r 2  A9 00                lda     #0
0018C8r 2  A8                   tay
0018C9r 2               @ret:
0018C9r 2                       ; Free temp strings before returning.  Save A,Y first.
0018C9r 2  48                   pha
0018CAr 2  5A                   phy
0018CBr 2                       ; Free FAC's temp string (right operand).
0018CBr 2  24 64                bit     VALTYP
0018CDr 2  10 03                bpl     @noFreeR
0018CFr 2  20 rr rr             jsr     FreFac
0018D2r 2               @noFreeR:
0018D2r 2                       ; Free ARG's temp string (left operand): manually restore VALTYP=$FF
0018D2r 2                       ; and FAC := ARG, then FreFac.  (We don't always know if ARG is a
0018D2r 2                       ; temp; FreTms inside FreTmp checks.)
0018D2r 2  A5 16                lda     ARG
0018D4r 2  85 0E                sta     FAC
0018D6r 2  A5 17                lda     ARG+1
0018D8r 2  85 0F                sta     FAC+1
0018DAr 2  A5 18                lda     ARG+2
0018DCr 2  85 10                sta     FAC+2
0018DEr 2                       ; +3/+4 are the descriptor's own address, which is what FreFac frees
0018DEr 2                       ; by -- copying only the len/lo/hi above left FreFac looking at the
0018DEr 2                       ; right operand's slot, already popped, so it never matched LASTPT and
0018DEr 2                       ; the left temp was never reclaimed.  PushFac/PullArg carry these two
0018DEr 2                       ; bytes through for exactly this.  One leaked slot per comparison, and
0018DEr 2                       ; the third string compare in a program hit ?FORMULA TOO COMPLEX.
0018DEr 2  A5 19                lda     ARG+3
0018E0r 2  85 11                sta     FAC+3
0018E2r 2  A5 1A                lda     ARG+4
0018E4r 2  85 12                sta     FAC+4
0018E6r 2  A9 FF                lda     #$FF
0018E8r 2  85 64                sta     VALTYP
0018EAr 2  20 rr rr             jsr     FreFac
0018EDr 2  7A                   ply
0018EEr 2  68                   pla
0018EFr 2  4C rr rr             jmp     GivAyf
0018F2r 2               
0018F2r 2               ; ===========================================================================
0018F2r 2               ;   L E V E L 4  --  + / -
0018F2r 2               ; ===========================================================================
0018F2r 2               EvalAdd:
0018F2r 2  20 rr rr             jsr     EvalMul
0018F5r 2               @loop:
0018F5r 2  20 rr rr             jsr     ChrGot
0018F8r 2  C9 2B                cmp     #'+'
0018FAr 2  F0 05                beq     @plus
0018FCr 2  C9 2D                cmp     #'-'
0018FEr 2  F0 27                beq     @minus
001900r 2  60                   rts
001901r 2               @plus:
001901r 2  20 rr rr             jsr     ChrGet
001904r 2  20 rr rr             jsr     PushFac
001907r 2  20 rr rr             jsr     EvalMul
00190Ar 2  20 rr rr             jsr     PullArg
00190Dr 2                       ; Type dispatch.
00190Dr 2  A5 86                lda     BAS_LVTYP
00190Fr 2  45 64                eor     VALTYP
001911r 2  10 03 4C rr          jmi     EvalTypeErr
001915r 2  rr           
001916r 2  24 64                bit     VALTYP
001918r 2  30 28                bmi     @cat
00191Ar 2                       ; numeric add: FAC = ARG + FAC
00191Ar 2                       ; FAddT expects: ARG is the operand, A=FAC's exponent on entry.
00191Ar 2                       ; Use entry "FAddT" preceded by sign work: msbasic does
00191Ar 2                       ;   bne <continue>; jmp CopyArgToFac
00191Ar 2                       ; But our FAddT entry already handles that.  We need to set
00191Ar 2                       ; SGNCPR = ARGSIGN ^ FACSIGN before FAddT.
00191Ar 2  A5 1B                lda     ARGSIGN
00191Cr 2  45 13                eor     FACSIGN
00191Er 2  85 1C                sta     SGNCPR
001920r 2  A5 0E                lda     FAC
001922r 2  20 rr rr             jsr     FAddT
001925r 2  80 CE                bra     @loop
001927r 2               @minus:
001927r 2  20 rr rr             jsr     ChrGet
00192Ar 2  20 rr rr             jsr     PushFac
00192Dr 2  20 rr rr             jsr     EvalMul
001930r 2  20 rr rr             jsr     ChkNum
001933r 2                       ; left was pushed; check pushed type via TOS-byte? Easier: we already
001933r 2                       ; verified left is numeric on first iteration.  But left might have
001933r 2                       ; been a string from concatenation; require numeric here:
001933r 2  20 rr rr             jsr     PullArg
001936r 2  A5 86                lda     BAS_LVTYP
001938r 2  10 03 4C rr          jmi     EvalTypeErr
00193Cr 2  rr           
00193Dr 2                       ; FAC = ARG - FAC
00193Dr 2                       ; FSubT does: FACSIGN ^= $FF; SGNCPR = FACSIGN^ARGSIGN; jmp FAddT
00193Dr 2                       ; We need to call FSubT directly.
00193Dr 2  20 rr rr             jsr     FSubT
001940r 2  80 B3                bra     @loop
001942r 2               @cat:
001942r 2  20 rr rr             jsr     CatStr
001945r 2  80 AE                bra     @loop
001947r 2               
001947r 2               ; ---------------------------------------------------------------------------
001947r 2               ; CatStr -- concatenate ARG (left) + FAC (right), result in FAC.
001947r 2               ; ---------------------------------------------------------------------------
001947r 2               CatStr:
001947r 2                       ; Stash right's length+addr before we overwrite FAC.
001947r 2  A5 0E                lda     FAC
001949r 2  85 4D                sta     BAS_TEMP1               ; right len
00194Br 2  A5 0F                lda     FAC+1
00194Dr 2  85 4E                sta     BAS_TEMP1+1
00194Fr 2  A5 10                lda     FAC+2
001951r 2  85 4F                sta     BAS_TEMP1+2
001953r 2                       ; Total length = ARG + FAC; abort if > 255.
001953r 2  18                   clc
001954r 2  A5 16                lda     ARG
001956r 2  65 4D                adc     BAS_TEMP1
001958r 2  B0 40                bcs     @tooLong
00195Ar 2  85 50                sta     BAS_TEMP1+3             ; total length
00195Cr 2                       ; Free both source temps before allocating result -- otherwise we
00195Cr 2                       ; pile up to 3 temps and the next PutNew throws ?FRMCPX.
00195Cr 2  20 rr rr             jsr     FreeBothTemps
00195Fr 2                       ; Allocate.
00195Fr 2  A5 50                lda     BAS_TEMP1+3             ; total length
001961r 2  20 rr rr             jsr     GetSpa                  ; A=total, FRESPC=buf
001964r 2                       ; Copy left bytes (ARG -> FRESPC).
001964r 2  A5 17                lda     ARG+1
001966r 2  85 20                sta     INDEX
001968r 2  A5 18                lda     ARG+2
00196Ar 2  85 21                sta     INDEX+1
00196Cr 2  A5 16                lda     ARG
00196Er 2  F0 03                beq     @right
001970r 2  20 rr rr             jsr     MovStr1                 ; advances FRESPC by len
001973r 2               @right:
001973r 2                       ; Copy right bytes.
001973r 2  A5 4E                lda     BAS_TEMP1+1
001975r 2  85 20                sta     INDEX
001977r 2  A5 4F                lda     BAS_TEMP1+2
001979r 2  85 21                sta     INDEX+1
00197Br 2  A5 4D                lda     BAS_TEMP1
00197Dr 2  F0 03                beq     @desc
00197Fr 2  20 rr rr             jsr     MovStr1
001982r 2               @desc:
001982r 2                       ; Descriptor: FAC := total len, FAC+1/2 := FRESPC - total.
001982r 2  A5 50                lda     BAS_TEMP1+3
001984r 2  85 0E                sta     FAC
001986r 2  38                   sec
001987r 2  A5 84                lda     FRESPC
001989r 2  E5 50                sbc     BAS_TEMP1+3
00198Br 2  85 0F                sta     FAC+1
00198Dr 2  A5 85                lda     FRESPC+1
00198Fr 2  E9 00                sbc     #0
001991r 2  85 10                sta     FAC+2
001993r 2  A9 FF                lda     #$FF
001995r 2  85 64                sta     VALTYP
001997r 2  4C rr rr             jmp     PutNew
00199Ar 2               @tooLong:
00199Ar 2  A2 09                ldx     #ERR_STRLONG
00199Cr 2  4C rr rr             jmp     BasErrorVec
00199Fr 2               
00199Fr 2               ; ===========================================================================
00199Fr 2               ;   L E V E L 5  --  * / /
00199Fr 2               ; ===========================================================================
00199Fr 2               EvalMul:
00199Fr 2  20 rr rr             jsr     EvalPow
0019A2r 2               @loop:
0019A2r 2  20 rr rr             jsr     ChrGot
0019A5r 2  C9 2A                cmp     #'*'
0019A7r 2  F0 05                beq     @mul
0019A9r 2  C9 2F                cmp     #'/'
0019ABr 2  F0 27                beq     @div
0019ADr 2  60                   rts
0019AEr 2               @mul:
0019AEr 2  20 rr rr             jsr     ChkNum
0019B1r 2  20 rr rr             jsr     ChrGet
0019B4r 2  20 rr rr             jsr     PushFac
0019B7r 2  20 rr rr             jsr     EvalPow
0019BAr 2  20 rr rr             jsr     ChkNum
0019BDr 2  20 rr rr             jsr     PullArg
0019C0r 2  A5 86                lda     BAS_LVTYP
0019C2r 2  10 03 4C rr          jmi     EvalTypeErr
0019C6r 2  rr           
0019C7r 2                       ; FAC = ARG * FAC: FMultT expects ARG + sign work.  See msbasic.
0019C7r 2  A5 1B                lda     ARGSIGN
0019C9r 2  45 13                eor     FACSIGN
0019CBr 2  85 1C                sta     SGNCPR
0019CDr 2  A5 0E                lda     FAC
0019CFr 2  20 rr rr             jsr     FMultT
0019D2r 2  80 CE                bra     @loop
0019D4r 2               @div:
0019D4r 2  20 rr rr             jsr     ChkNum
0019D7r 2  20 rr rr             jsr     ChrGet
0019DAr 2  20 rr rr             jsr     PushFac
0019DDr 2  20 rr rr             jsr     EvalPow
0019E0r 2  20 rr rr             jsr     ChkNum
0019E3r 2  20 rr rr             jsr     PullArg
0019E6r 2  A5 86                lda     BAS_LVTYP
0019E8r 2  10 03 4C rr          jmi     EvalTypeErr
0019ECr 2  rr           
0019EDr 2                       ; FAC = ARG / FAC: FDivT.
0019EDr 2  A5 1B                lda     ARGSIGN
0019EFr 2  45 13                eor     FACSIGN
0019F1r 2  85 1C                sta     SGNCPR
0019F3r 2  A5 0E                lda     FAC
0019F5r 2  20 rr rr             jsr     FDivT
0019F8r 2  80 A8                bra     @loop
0019FAr 2               
0019FAr 2               ; ===========================================================================
0019FAr 2               ;   L E V E L 6  --  ^   (right-associative)
0019FAr 2               ; ===========================================================================
0019FAr 2               EvalPow:
0019FAr 2  20 rr rr             jsr     EvalUnary
0019FDr 2               @loop:
0019FDr 2  20 rr rr             jsr     ChrGot
001A00r 2  C9 5E                cmp     #'^'
001A02r 2  D0 20                bne     @done
001A04r 2  20 rr rr             jsr     ChkNum
001A07r 2  20 rr rr             jsr     ChrGet
001A0Ar 2  20 rr rr             jsr     PushFac
001A0Dr 2                       ; Right-associative, which means the right-hand side is evaluated at
001A0Dr 2                       ; this level rather than the one below: recursing into EvalPow lets
001A0Dr 2                       ; the RHS take the rest of the chain, so 2^3^2 is 2^(3^2) = 512.
001A0Dr 2                       ; Calling EvalUnary here instead made it (2^3)^2 = 64 -- left-assoc,
001A0Dr 2                       ; contradicting this level's own heading.  EvalUnary still runs first
001A0Dr 2                       ; inside the recursion, so a term is always consumed and the recursion
001A0Dr 2                       ; is bounded by the length of the chain.
001A0Dr 2  20 rr rr             jsr     EvalPow
001A10r 2  20 rr rr             jsr     ChkNum
001A13r 2  20 rr rr             jsr     PullArg
001A16r 2  A5 86                lda     BAS_LVTYP
001A18r 2  10 03 4C rr          jmi     EvalTypeErr
001A1Cr 2  rr           
001A1Dr 2                       ; FPwrt computes ARG ^ FAC.  Our ported FPwrt expects ARG = base,
001A1Dr 2                       ; FAC = exponent, and A = FAC's exponent byte (FPwrt's first
001A1Dr 2                       ; instruction is `beq Exp` to short-circuit FAC==0 -> 1).
001A1Dr 2  A5 0E                lda     FAC
001A1Fr 2  20 rr rr             jsr     FPwrt
001A22r 2  80 D9                bra     @loop
001A24r 2               @done:
001A24r 2  60                   rts
001A25r 2               
001A25r 2               ; ===========================================================================
001A25r 2               ;   L E V E L 7  --  U N A R Y
001A25r 2               ; ===========================================================================
001A25r 2               EvalUnary:
001A25r 2  20 rr rr             jsr     ChrGot
001A28r 2  C9 2D                cmp     #'-'
001A2Ar 2  F0 07                beq     @neg
001A2Cr 2  C9 2B                cmp     #'+'
001A2Er 2  F0 13                beq     @pos
001A30r 2  4C rr rr             jmp     EvalAtom
001A33r 2               @neg:
001A33r 2  20 rr rr             jsr     ChrGet
001A36r 2                       ; Evaluate the operand at the power level, not this one: the README
001A36r 2                       ; puts `^` above unary `-`, so -2^2 is -(2^2) = -4.  Recursing into
001A36r 2                       ; EvalUnary here bound the minus to the atom first and gave (-2)^2 = 4.
001A36r 2                       ; The '-' is consumed above, so a term is always taken before this
001A36r 2                       ; recurses and the depth is bounded by the run of signs.
001A36r 2  20 rr rr             jsr     EvalPow
001A39r 2  20 rr rr             jsr     ChkNum
001A3Cr 2                       ; Negate FAC: flip FACSIGN bit 7.
001A3Cr 2  A5 13                lda     FACSIGN
001A3Er 2  49 FF                eor     #$FF
001A40r 2  85 13                sta     FACSIGN
001A42r 2  60                   rts
001A43r 2               @pos:
001A43r 2  20 rr rr             jsr     ChrGet
001A46r 2  4C rr rr             jmp     EvalUnary
001A49r 2               
001A49r 2               ; ===========================================================================
001A49r 2               ;   L E V E L 8  --  A T O M
001A49r 2               ; ===========================================================================
001A49r 2               EvalAtom:
001A49r 2  64 64                stz     VALTYP                  ; default to numeric; string paths override
001A4Br 2  20 rr rr             jsr     ChrGot
001A4Er 2  90 2E                bcc     @num                    ; digit
001A50r 2  C9 2E                cmp     #'.'
001A52r 2  F0 2A                beq     @num
001A54r 2  C9 22                cmp     #'"'
001A56r 2  F0 29                beq     @str
001A58r 2  C9 28                cmp     #'('
001A5Ar 2  F0 3D                beq     @paren
001A5Cr 2                       ; Letter? -> variable
001A5Cr 2  20 rr rr             jsr     IsLetC
001A5Fr 2  B0 41                bcs     @var
001A61r 2                       ; Function token?
001A61r 2  C9 CD                cmp     #TOK_INKEY
001A63r 2  F0 64                beq     FnInkey
001A65r 2  C9 9D                cmp     #TOK_FN
001A67r 2  F0 12                beq     @fnCall                 ; FN A(...) — user-defined function
001A69r 2                       ; Hex literal in PRINT context: not here (no '$' literal supported).
001A69r 2                       ; NVRAM is dual-role (statement at $B1, function via FnTable);
001A69r 2                       ; allow it through even though it sits below TOK_SGN.
001A69r 2  C9 B1                cmp     #TOK_NVRAM
001A6Br 2  F0 08                beq     @fnDisp
001A6Dr 2                       ; Try function dispatch.
001A6Dr 2  C9 B6                cmp     #TOK_SGN
001A6Fr 2  90 07                bcc     @synErr
001A71r 2  C9 D1                cmp     #TOK_MAX+1
001A73r 2  B0 03                bcs     @synErr
001A75r 2               @fnDisp:
001A75r 2  4C rr rr             jmp     FnDispatch
001A78r 2               @synErr:
001A78r 2  4C rr rr             jmp     SynErr
001A7Br 2               @fnCall:
001A7Br 2  4C rr rr             jmp     FnCall
001A7Er 2               @num:
001A7Er 2                       ; ASCII numeric: jump to Fin.  Fin uses ChrGet to consume.
001A7Er 2  4C rr rr             jmp     Fin
001A81r 2               @str:
001A81r 2                       ; '"' string literal.  Advance past the opening quote WITHOUT ChrGet:
001A81r 2                       ; ChrGet skips spaces, which would strip leading spaces inside the
001A81r 2                       ; string literal (e.g. PRINT "   X").  Bump TXTPTR by one byte instead.
001A81r 2  E6 04                inc     TXTPTR
001A83r 2  D0 02                bne     @strsrc
001A85r 2  E6 05                inc     TXTPTR+1
001A87r 2               @strsrc:
001A87r 2                       ; StrLit expects (Y,A) = src.  Source = TXTPTR.
001A87r 2  A5 04                lda     TXTPTR
001A89r 2  A4 05                ldy     TXTPTR+1
001A8Br 2  20 rr rr             jsr     StrLit
001A8Er 2                       ; StrLit advances internal pointer; we need to update TXTPTR.
001A8Er 2                       ; StrLit reads until $00 or '"' from (STRNG1)+y; FAC has length.
001A8Er 2                       ; Compute new TXTPTR = STRNG2 (which StrLit set), or TXTPTR + len + maybe-quote.
001A8Er 2                       ; STRNG2 = STRNG1 + len + (1 if hit quote else 0).  Use STRNG2.
001A8Er 2  A5 1E                lda     STRNG2
001A90r 2  85 04                sta     TXTPTR
001A92r 2  A5 1F                lda     STRNG2+1
001A94r 2  85 05                sta     TXTPTR+1
001A96r 2                       ; If we stopped at a closing quote, TXTPTR is past it (StrLit's
001A96r 2                       ; @endquote path: tya/adc STRNG1 with carry set since cmp set C);
001A96r 2                       ; if we ran into NUL, TXTPTR sits on the NUL (clc path).  Either
001A96r 2                       ; is correct for ChrGot.
001A96r 2  4C rr rr             jmp     ChrGot                  ; preload next char (for caller chains)
001A99r 2               @paren:
001A99r 2  20 rr rr             jsr     ChrGet                  ; consume '('
001A9Cr 2  20 rr rr             jsr     FrmEvl
001A9Fr 2  4C rr rr             jmp     ChkCls                  ; expects ')'; consumes via ChrGet
001AA2r 2               @var:
001AA2r 2                       ; Variable lookup.  PtrGet uses CHRGET internally and leaves
001AA2r 2                       ; (A,Y) = VARPNT.  VALTYP is set to $00 or $FF.
001AA2r 2  20 rr rr             jsr     PtrGet
001AA5r 2                       ; Fetch value into FAC.
001AA5r 2  24 64                bit     VALTYP
001AA7r 2  30 07                bmi     @loadStr
001AA9r 2                       ; numeric: FAC = (VARPNT)
001AA9r 2  A5 3F                lda     VARPNT
001AABr 2  A4 40                ldy     VARPNT+1
001AADr 2  4C rr rr             jmp     LoadFacFromYa
001AB0r 2               @loadStr:
001AB0r 2                       ; string: copy descriptor [len][lo][hi] into FAC..FAC+2.
001AB0r 2  A0 00                ldy     #0
001AB2r 2  B1 3F                lda     (VARPNT),y
001AB4r 2  85 0E                sta     FAC
001AB6r 2  C8                   iny
001AB7r 2  B1 3F                lda     (VARPNT),y
001AB9r 2  85 0F                sta     FAC+1
001ABBr 2  C8                   iny
001ABCr 2  B1 3F                lda     (VARPNT),y
001ABEr 2  85 10                sta     FAC+2
001AC0r 2                       ; Record the descriptor's address (= VARPNT) in FAC+3/FAC+4 so the
001AC0r 2                       ; temp-free logic (FreFac/FreTms) can tell this is a variable, not a
001AC0r 2                       ; temp: VARPNT's high byte is nonzero (vars live at $08xx) so it can
001AC0r 2                       ; never match a temp-stack slot (all in zero page) and will not be
001AC0r 2                       ; freed or reclaimed.  Without this, a stale FAC+3/FAC+4 can spuriously
001AC0r 2                       ; match LASTPT and free/reclaim a live string.
001AC0r 2  A5 3F                lda     VARPNT
001AC2r 2  85 11                sta     FAC+3
001AC4r 2  A5 40                lda     VARPNT+1
001AC6r 2  85 12                sta     FAC+4
001AC8r 2  60                   rts
001AC9r 2               
001AC9r 2               ; ---------------------------------------------------------------------------
001AC9r 2               ; FnInkey -- INKEY (no parens).  Reads BAS_PENDKEY first; else BufferSize/
001AC9r 2               ; ReadBuffer; else 0.  Result is unsigned 8-bit FP value.
001AC9r 2               ; ---------------------------------------------------------------------------
001AC9r 2               FnInkey:
001AC9r 2  20 rr rr             jsr     ChrGet                  ; consume INKEY token
001ACCr 2  AD 0E 03             lda     BAS_PENDKEY
001ACFr 2  F0 09                beq     @noPend
001AD1r 2                       ; consume pending key.
001AD1r 2  A0 00                ldy     #0
001AD3r 2  8C 0E 03             sty     BAS_PENDKEY
001AD6r 2  A8                   tay
001AD7r 2  4C rr rr             jmp     SngFlt
001ADAr 2               @noPend:
001ADAr 2  20 rr rr             jsr     BufferSize
001ADDr 2  F0 07                beq     @zero
001ADFr 2  20 rr rr             jsr     ReadBuffer
001AE2r 2  A8                   tay
001AE3r 2  4C rr rr             jmp     SngFlt
001AE6r 2               @zero:
001AE6r 2  A0 00                ldy     #0
001AE8r 2  4C rr rr             jmp     SngFlt
001AEBr 2               
001AEBr 2               ; ---------------------------------------------------------------------------
001AEBr 2               ; FnDispatch -- A holds a function token in [TOK_SGN..TOK_MAX].  Dispatch
001AEBr 2               ; via FnTable, which pairs (token, handler-1).
001AEBr 2               ; ---------------------------------------------------------------------------
001AEBr 2               FnDispatch:
001AEBr 2  A2 00                ldx     #0
001AEDr 2               @find:
001AEDr 2  BD rr rr             lda     FnTable,x
001AF0r 2  F0 14                beq     @synErr                 ; reached terminator
001AF2r 2  D2 04                cmp     (TXTPTR)
001AF4r 2  F0 05                beq     @match
001AF6r 2  E8                   inx
001AF7r 2  E8                   inx
001AF8r 2  E8                   inx
001AF9r 2  80 F2                bra     @find
001AFBr 2               @match:
001AFBr 2                       ; Push handler-1 onto stack so RTS jumps to it after ChrGet.
001AFBr 2  BD rr rr             lda     FnTable+2,x
001AFEr 2  48                   pha
001AFFr 2  BD rr rr             lda     FnTable+1,x
001B02r 2  48                   pha
001B03r 2  4C rr rr             jmp     ChrGet                  ; consume token, return into handler
001B06r 2               @synErr:
001B06r 2  4C rr rr             jmp     SynErr
001B09r 2               
001B09r 2               ; ---------------------------------------------------------------------------
001B09r 2               ; FnTable -- (token, handler-1) triples, $00-terminated.
001B09r 2               ; "handler-1" because we push it through RTS which adds 1.
001B09r 2               ; ---------------------------------------------------------------------------
001B09r 2               FnTable:
001B09r 2  B6                   .byte   TOK_SGN
001B0Ar 2  rr rr                .word   FnSgn-1
001B0Cr 2  B7                   .byte   TOK_INT
001B0Dr 2  rr rr                .word   FnInt-1
001B0Fr 2  B8                   .byte   TOK_ABS
001B10r 2  rr rr                .word   FnAbs-1
001B12r 2  B9                   .byte   TOK_FRE
001B13r 2  rr rr                .word   FnFre-1
001B15r 2  BA                   .byte   TOK_POS
001B16r 2  rr rr                .word   FnPos-1
001B18r 2  BB                   .byte   TOK_SQR
001B19r 2  rr rr                .word   FnSqr-1
001B1Br 2  BC                   .byte   TOK_RND
001B1Cr 2  rr rr                .word   FnRnd-1
001B1Er 2  BD                   .byte   TOK_LOG
001B1Fr 2  rr rr                .word   FnLog-1
001B21r 2  BE                   .byte   TOK_EXP
001B22r 2  rr rr                .word   FnExp-1
001B24r 2  BF                   .byte   TOK_COS
001B25r 2  rr rr                .word   FnCos-1
001B27r 2  C0                   .byte   TOK_SIN
001B28r 2  rr rr                .word   FnSin-1
001B2Ar 2  C1                   .byte   TOK_TAN
001B2Br 2  rr rr                .word   FnTan-1
001B2Dr 2  C2                   .byte   TOK_ATN
001B2Er 2  rr rr                .word   FnAtn-1
001B30r 2  C3                   .byte   TOK_PEEK
001B31r 2  rr rr                .word   FnPeek-1
001B33r 2  C4                   .byte   TOK_LEN
001B34r 2  rr rr                .word   FnLen-1
001B36r 2  C5                   .byte   TOK_STRSTR
001B37r 2  rr rr                .word   FnStrStr-1
001B39r 2  C6                   .byte   TOK_VAL
001B3Ar 2  rr rr                .word   FnVal-1
001B3Cr 2  C7                   .byte   TOK_ASC
001B3Dr 2  rr rr                .word   FnAsc-1
001B3Fr 2  C8                   .byte   TOK_CHRSTR
001B40r 2  rr rr                .word   FnChrStr-1
001B42r 2  C9                   .byte   TOK_LEFTSTR
001B43r 2  rr rr                .word   FnLeftStr-1
001B45r 2  CA                   .byte   TOK_RIGHTSTR
001B46r 2  rr rr                .word   FnRightStr-1
001B48r 2  CB                   .byte   TOK_MIDSTR
001B49r 2  rr rr                .word   FnMidStr-1
001B4Br 2  CC                   .byte   TOK_JOY
001B4Cr 2  rr rr                .word   FnJoy-1
001B4Er 2  B1                   .byte   TOK_NVRAM
001B4Fr 2  rr rr                .word   FnNvram-1
001B51r 2  CE                   .byte   TOK_HEX
001B52r 2  rr rr                .word   FnHex-1
001B54r 2  CF                   .byte   TOK_MIN
001B55r 2  rr rr                .word   FnMin-1
001B57r 2  D0                   .byte   TOK_MAX
001B58r 2  rr rr                .word   FnMax-1
001B5Ar 2  00                   .byte   0
001B5Br 2               
001B5Br 2               ; ---------------------------------------------------------------------------
001B5Br 2               ; Numeric-arg helpers.
001B5Br 2               ; ParenNum    -- expects "(" expr ")" with numeric result.  FAC = result.
001B5Br 2               ; ParenStr    -- expects "(" expr ")" with string result.
001B5Br 2               ; ParenU8     -- expects "(" expr ")" -> A = byte (0..255), or ?ILLQTY.
001B5Br 2               ; ParenU16    -- expects "(" expr ")" -> AyInt result in FAC+3,+4.
001B5Br 2               ; ---------------------------------------------------------------------------
001B5Br 2               ParenNum:
001B5Br 2  20 rr rr             jsr     ChkOpn
001B5Er 2  20 rr rr             jsr     FrmEvl
001B61r 2  20 rr rr             jsr     ChkNum
001B64r 2  4C rr rr             jmp     ChkCls
001B67r 2               ParenStr:
001B67r 2  20 rr rr             jsr     ChkOpn
001B6Ar 2  20 rr rr             jsr     FrmEvl
001B6Dr 2  20 rr rr             jsr     ChkStr
001B70r 2  4C rr rr             jmp     ChkCls
001B73r 2               ParenU8:
001B73r 2  20 rr rr             jsr     ParenNum
001B76r 2  20 rr rr             jsr     AyInt
001B79r 2  A5 11                lda     FAC+3                   ; high byte must be 0
001B7Br 2  D0 03                bne     @bad
001B7Dr 2  A5 12                lda     FAC+4                   ; low byte = result
001B7Fr 2  60                   rts
001B80r 2               @bad:
001B80r 2  4C rr rr             jmp     IqErr
001B83r 2               
001B83r 2               ; ---------------------------------------------------------------------------
001B83r 2               ; Unary numeric functions (single-arg "(" num ")") -- shared body.
001B83r 2               ; Each entry sets up A = handler entry to call after ChkOpn/FrmEvl/ChkNum/ChkCls.
001B83r 2               ; ---------------------------------------------------------------------------
001B83r 2               FnSgn:
001B83r 2  20 rr rr             jsr     ParenNum
001B86r 2  4C rr rr             jmp     Sgn
001B89r 2               FnInt:
001B89r 2  20 rr rr             jsr     ParenNum
001B8Cr 2  4C rr rr             jmp     Int
001B8Fr 2               FnAbs:
001B8Fr 2  20 rr rr             jsr     ParenNum
001B92r 2  4C rr rr             jmp     Abs
001B95r 2               FnSqr:
001B95r 2  20 rr rr             jsr     ParenNum
001B98r 2  4C rr rr             jmp     Sqr
001B9Br 2               FnLog:
001B9Br 2  20 rr rr             jsr     ParenNum
001B9Er 2  4C rr rr             jmp     Log
001BA1r 2               FnExp:
001BA1r 2  20 rr rr             jsr     ParenNum
001BA4r 2  4C rr rr             jmp     Exp
001BA7r 2               FnCos:
001BA7r 2  20 rr rr             jsr     ParenNum
001BAAr 2  4C rr rr             jmp     Cos
001BADr 2               FnSin:
001BADr 2  20 rr rr             jsr     ParenNum
001BB0r 2  4C rr rr             jmp     Sin
001BB3r 2               FnTan:
001BB3r 2  20 rr rr             jsr     ParenNum
001BB6r 2  4C rr rr             jmp     Tan
001BB9r 2               FnAtn:
001BB9r 2  20 rr rr             jsr     ParenNum
001BBCr 2  4C rr rr             jmp     Atn
001BBFr 2               FnRnd:
001BBFr 2  20 rr rr             jsr     ParenNum
001BC2r 2  4C rr rr             jmp     Rnd
001BC5r 2               FnHex:
001BC5r 2                       ; In expression context: identity.
001BC5r 2  4C rr rr             jmp     ParenNum
001BC8r 2               
001BC8r 2               ; ---------------------------------------------------------------------------
001BC8r 2               ; FnFre -- FRE(n): returns FRETOP - STREND (free string heap).
001BC8r 2               ; Argument is parsed and ignored.
001BC8r 2               ; ---------------------------------------------------------------------------
001BC8r 2               FnFre:
001BC8r 2  20 rr rr             jsr     ParenNum
001BCBr 2  38                   sec
001BCCr 2  AD 65 03             lda     FRETOP
001BCFr 2  ED 63 03             sbc     STREND
001BD2r 2  A8                   tay
001BD3r 2  AD 66 03             lda     FRETOP+1
001BD6r 2  ED 64 03             sbc     STREND+1
001BD9r 2  4C rr rr             jmp     GivAyf
001BDCr 2               
001BDCr 2               ; ---------------------------------------------------------------------------
001BDCr 2               ; FnPos -- POS(n): current print column.  Argument is parsed and ignored.
001BDCr 2               ; ---------------------------------------------------------------------------
001BDCr 2               FnPos:
001BDCr 2  20 rr rr             jsr     ParenNum
001BDFr 2                       ; BAS_POSX is the live column PrintCh maintains and TAB and the comma
001BDFr 2                       ; zones already read.  This returned a hardcoded 0 -- the column was
001BDFr 2                       ; being tracked all along, POS just never looked at it.
001BDFr 2  AC 70 03             ldy     BAS_POSX
001BE2r 2  4C rr rr             jmp     SngFlt
001BE5r 2               
001BE5r 2               ; ---------------------------------------------------------------------------
001BE5r 2               ; FnPeek -- PEEK(addr): byte at addr -> FP.
001BE5r 2               ; ---------------------------------------------------------------------------
001BE5r 2               FnPeek:
001BE5r 2  20 rr rr             jsr     ParenNum
001BE8r 2  20 rr rr             jsr     FacToU16
001BEBr 2  A5 12                lda     FAC+4                   ; lo byte
001BEDr 2  85 20                sta     INDEX
001BEFr 2  A5 11                lda     FAC+3                   ; hi byte
001BF1r 2  85 21                sta     INDEX+1
001BF3r 2  A0 00                ldy     #0
001BF5r 2  B1 20                lda     (INDEX),y
001BF7r 2  A8                   tay
001BF8r 2  4C rr rr             jmp     SngFlt
001BFBr 2               
001BFBr 2               ; ---------------------------------------------------------------------------
001BFBr 2               ; FnJoy -- JOY(n): 1 or 2.  If GPIO absent, returns 0.
001BFBr 2               ; ---------------------------------------------------------------------------
001BFBr 2               FnJoy:
001BFBr 2  20 rr rr             jsr     ParenU8
001BFEr 2  48                   pha
001BFFr 2  AD 0D 03             lda     HW_PRESENT
001C02r 2  29 20                and     #HW_GPIO
001C04r 2  F0 1C                beq     @absent
001C06r 2  68                   pla
001C07r 2  C9 01                cmp     #1
001C09r 2  F0 09                beq     @j1
001C0Br 2  C9 02                cmp     #2
001C0Dr 2  F0 0C                beq     @j2
001C0Fr 2  A2 0B                ldx     #ERR_ILLQUAN
001C11r 2  4C rr rr             jmp     BasErrorVec
001C14r 2               @j1:
001C14r 2  20 rr rr             jsr     ReadJoystick1
001C17r 2  A8                   tay
001C18r 2  4C rr rr             jmp     SngFlt
001C1Br 2               @j2:
001C1Br 2  20 rr rr             jsr     ReadJoystick2
001C1Er 2  A8                   tay
001C1Fr 2  4C rr rr             jmp     SngFlt
001C22r 2               @absent:
001C22r 2  68                   pla
001C23r 2                       ; $FF, not 0.  The ports are active low -- pulled high through 1K, and
001C23r 2                       ; the stick's switches ground them -- so JOY returns the port raw and 0
001C23r 2                       ; means every direction and button is held at once.  Reporting 0 for a
001C23r 2                       ; machine with no VIA fitted told the caller exactly that; $FF is what
001C23r 2                       ; an untouched stick reads, and so the honest answer for one that is
001C23r 2                       ; not there at all.
001C23r 2  A0 FF                ldy     #$FF
001C25r 2  4C rr rr             jmp     SngFlt
001C28r 2               
001C28r 2               ; ---------------------------------------------------------------------------
001C28r 2               ; FnNvram -- NVRAM(addr): if RTC absent, return 0.
001C28r 2               ; ---------------------------------------------------------------------------
001C28r 2               FnNvram:
001C28r 2  20 rr rr             jsr     ParenU8
001C2Br 2  48                   pha
001C2Cr 2  AD 0D 03             lda     HW_PRESENT
001C2Fr 2  29 04                and     #HW_RTC
001C31r 2  F0 09                beq     @absent
001C33r 2  68                   pla
001C34r 2  AA                   tax
001C35r 2  20 rr rr             jsr     RtcReadNVRAM
001C38r 2  A8                   tay
001C39r 2  4C rr rr             jmp     SngFlt
001C3Cr 2               @absent:
001C3Cr 2  68                   pla
001C3Dr 2  A0 00                ldy     #0
001C3Fr 2  4C rr rr             jmp     SngFlt
001C42r 2               
001C42r 2               ; ---------------------------------------------------------------------------
001C42r 2               ; FnMin / FnMax -- two numeric args, smaller / larger.
001C42r 2               ; ---------------------------------------------------------------------------
001C42r 2               FnMin:
001C42r 2  20 rr rr             jsr     MinMaxArgs              ; ARG = a, FAC = b, BAS_TMP3 = sign(b-a)
001C45r 2                       ; Want smaller: if b>=a return a (ARG); else return b (FAC).
001C45r 2  10 01                bpl     @retArg                 ; sign>=0 means b>=a
001C47r 2  60                   rts                             ; FAC already = b
001C48r 2               @retArg:
001C48r 2  4C rr rr             jmp     CopyArgToFac
001C4Br 2               FnMax:
001C4Br 2  20 rr rr             jsr     MinMaxArgs
001C4Er 2                       ; Want larger: if b>=a return b (FAC); else return a (ARG).
001C4Er 2  10 03                bpl     @retFac
001C50r 2  4C rr rr             jmp     CopyArgToFac
001C53r 2               @retFac:
001C53r 2  60                   rts
001C54r 2               
001C54r 2               ; MinMaxArgs -- consume "(" a "," b ")" with numerics; ARG=a, FAC=b.
001C54r 2               ; Returns A = sign(b - a) (FF/00/01) and N flag set accordingly.
001C54r 2               MinMaxArgs:
001C54r 2  20 rr rr             jsr     ChkOpn
001C57r 2  20 rr rr             jsr     FrmEvl
001C5Ar 2  20 rr rr             jsr     ChkNum
001C5Dr 2  20 rr rr             jsr     PushFac                 ; save a
001C60r 2  20 rr rr             jsr     ChkCom
001C63r 2  20 rr rr             jsr     FrmEvl
001C66r 2  20 rr rr             jsr     ChkNum
001C69r 2  20 rr rr             jsr     ChkCls
001C6Cr 2  20 rr rr             jsr     PullArg                 ; ARG = a, FAC = b
001C6Fr 2                       ; Stash ARG so we can restore after FComp's destructive sign-pack.
001C6Fr 2  A5 16                lda     ARG
001C71r 2  85 4D                sta     BAS_TEMP1
001C73r 2  A5 17                lda     ARG+1
001C75r 2  85 4E                sta     BAS_TEMP1+1
001C77r 2  A5 18                lda     ARG+2
001C79r 2  85 4F                sta     BAS_TEMP1+2
001C7Br 2  A5 19                lda     ARG+3
001C7Dr 2  85 50                sta     BAS_TEMP1+3
001C7Fr 2  A5 1A                lda     ARG+4
001C81r 2  85 51                sta     BAS_TEMP1+4
001C83r 2  A5 1B                lda     ARGSIGN
001C85r 2  85 52                sta     BAS_TEMP1+5
001C87r 2                       ; Pack ARGSIGN into bit 7 of ARG+1 so FComp reads it correctly.
001C87r 2  A5 1B                lda     ARGSIGN
001C89r 2  09 7F                ora     #$7F
001C8Br 2  25 17                and     ARG+1
001C8Dr 2  85 17                sta     ARG+1
001C8Fr 2  A9 16                lda     #<ARG
001C91r 2  A0 00                ldy     #$00
001C93r 2  20 rr rr             jsr     FComp                   ; A = sign(FAC - ARG)
001C96r 2  48                   pha
001C97r 2                       ; Restore ARG.
001C97r 2  A5 4D                lda     BAS_TEMP1
001C99r 2  85 16                sta     ARG
001C9Br 2  A5 4E                lda     BAS_TEMP1+1
001C9Dr 2  85 17                sta     ARG+1
001C9Fr 2  A5 4F                lda     BAS_TEMP1+2
001CA1r 2  85 18                sta     ARG+2
001CA3r 2  A5 50                lda     BAS_TEMP1+3
001CA5r 2  85 19                sta     ARG+3
001CA7r 2  A5 51                lda     BAS_TEMP1+4
001CA9r 2  85 1A                sta     ARG+4
001CABr 2  A5 52                lda     BAS_TEMP1+5
001CADr 2  85 1B                sta     ARGSIGN
001CAFr 2  68                   pla                             ; restore A, sets N/Z flags
001CB0r 2  60                   rts
001CB1r 2               
001CB1r 2               ; ---------------------------------------------------------------------------
001CB1r 2               ; FnLen -- LEN(s$): length of string.
001CB1r 2               ; ---------------------------------------------------------------------------
001CB1r 2               FnLen:
001CB1r 2  20 rr rr             jsr     ParenStr
001CB4r 2  A5 0E                lda     FAC                     ; length
001CB6r 2  48                   pha                             ; FreFac returns with Y = descriptor hi
001CB7r 2  20 rr rr             jsr     FreFac                  ; release temp string if any
001CBAr 2  68                   pla
001CBBr 2  A8                   tay
001CBCr 2  4C rr rr             jmp     SngFlt
001CBFr 2               
001CBFr 2               ; ---------------------------------------------------------------------------
001CBFr 2               ; FnAsc -- ASC(s$): code of first char; ?ILLQTY if empty.
001CBFr 2               ; ---------------------------------------------------------------------------
001CBFr 2               FnAsc:
001CBFr 2  20 rr rr             jsr     ParenStr
001CC2r 2  A5 0E                lda     FAC
001CC4r 2  F0 15                beq     @bad
001CC6r 2                       ; Read first byte of string.
001CC6r 2  A5 0F                lda     FAC+1
001CC8r 2  85 20                sta     INDEX
001CCAr 2  A5 10                lda     FAC+2
001CCCr 2  85 21                sta     INDEX+1
001CCEr 2  A0 00                ldy     #0
001CD0r 2  B1 20                lda     (INDEX),y
001CD2r 2  48                   pha
001CD3r 2  20 rr rr             jsr     FreFac
001CD6r 2  68                   pla
001CD7r 2  A8                   tay
001CD8r 2  4C rr rr             jmp     SngFlt
001CDBr 2               @bad:
001CDBr 2  4C rr rr             jmp     IqErr
001CDEr 2               
001CDEr 2               ; ---------------------------------------------------------------------------
001CDEr 2               ; FnChrStr -- CHR$(n): 1-char string.
001CDEr 2               ; ---------------------------------------------------------------------------
001CDEr 2               FnChrStr:
001CDEr 2  20 rr rr             jsr     ParenU8
001CE1r 2  48                   pha
001CE2r 2  A9 01                lda     #1
001CE4r 2  20 rr rr             jsr     GetSpa                  ; (Y,X) = addr; A unchanged
001CE7r 2  68                   pla
001CE8r 2  A0 00                ldy     #0
001CEAr 2  91 84                sta     (FRESPC),y
001CECr 2                       ; Build descriptor in FAC.
001CECr 2  A9 01                lda     #1
001CEEr 2  85 0E                sta     FAC
001CF0r 2  A5 84                lda     FRESPC
001CF2r 2  85 0F                sta     FAC+1
001CF4r 2  A5 85                lda     FRESPC+1
001CF6r 2  85 10                sta     FAC+2
001CF8r 2                       ; Advance FRESPC past the byte we just wrote.
001CF8r 2  E6 84                inc     FRESPC
001CFAr 2  D0 02                bne     @nb
001CFCr 2  E6 85                inc     FRESPC+1
001CFEr 2               @nb:
001CFEr 2  4C rr rr             jmp     PutNew
001D01r 2               
001D01r 2               ; ---------------------------------------------------------------------------
001D01r 2               ; FnStrStr -- STR$(n): convert numeric to string.
001D01r 2               ; ---------------------------------------------------------------------------
001D01r 2               FnStrStr:
001D01r 2  20 rr rr             jsr     ParenNum
001D04r 2  20 rr rr             jsr     Fout                    ; A=lo, Y=hi -> NUL-terminated buffer
001D07r 2                       ; (A,Y) = pointer to NUL-terminated ASCII number string in STACK2.
001D07r 2  20 rr rr             jsr     StrLit                  ; allocates + copies + PutNew
001D0Ar 2  60                   rts
001D0Br 2               
001D0Br 2               ; ---------------------------------------------------------------------------
001D0Br 2               ; FnVal -- VAL(s$): parse leading numeric from string.
001D0Br 2               ; Temporarily NUL-terminates the string in place, redirects TXTPTR, calls
001D0Br 2               ; Fin, then restores.
001D0Br 2               ; ---------------------------------------------------------------------------
001D0Br 2               FnVal:
001D0Br 2  20 rr rr             jsr     ParenStr
001D0Er 2  A5 0E                lda     FAC
001D10r 2  D0 08                bne     @nz
001D12r 2                       ; empty string -> 0
001D12r 2  20 rr rr             jsr     FreFac
001D15r 2  64 64                stz     VALTYP                  ; result is numeric (ParenStr set $FF)
001D17r 2  4C rr rr             jmp     ZeroFac
001D1Ar 2               @nz:
001D1Ar 2                       ; Stash length, address into TEMP1..TEMP1+2.
001D1Ar 2  85 4D                sta     TEMP1                   ; length
001D1Cr 2  A5 0F                lda     FAC+1
001D1Er 2  85 4E                sta     TEMP1+1
001D20r 2  A5 10                lda     FAC+2
001D22r 2  85 4F                sta     TEMP1+2
001D24r 2                       ; Reclaim the argument's temp now, while FAC still holds its
001D24r 2                       ; descriptor -- msbasic's VAL frees before parsing for the same
001D24r 2                       ; reason.  It cannot wait until after Fin: FAC+3/+4 are the two bytes
001D24r 2                       ; FreFac frees by, and by then they are mantissa of the parsed number.
001D24r 2                       ; Freeing only releases the heap for reuse and nothing allocates
001D24r 2                       ; between here and Fin, so the characters stay intact to parse.
001D24r 2                       ; Without it the temp leaked: the empty-string path above frees, the
001D24r 2                       ; parsing path did not, and three VALs of a literal in one program
001D24r 2                       ; exhausted the 3-slot temp stack with ?FORMULA TOO COMPLEX.
001D24r 2  20 rr rr             jsr     FreFac
001D27r 2                       ; Save the byte at offset = length and replace with $00.
001D27r 2  A5 4E                lda     TEMP1+1
001D29r 2  85 20                sta     INDEX
001D2Br 2  A5 4F                lda     TEMP1+2
001D2Dr 2  85 21                sta     INDEX+1
001D2Fr 2  A4 4D                ldy     TEMP1
001D31r 2  B1 20                lda     (INDEX),y
001D33r 2  85 50                sta     TEMP1+3                 ; saved byte
001D35r 2  A9 00                lda     #0
001D37r 2  91 20                sta     (INDEX),y
001D39r 2                       ; Save TXTPTR.
001D39r 2  A5 04                lda     TXTPTR
001D3Br 2  48                   pha
001D3Cr 2  A5 05                lda     TXTPTR+1
001D3Er 2  48                   pha
001D3Fr 2                       ; TXTPTR := INDEX - 1, then ChrGet to load first char.
001D3Fr 2  A5 4E                lda     TEMP1+1
001D41r 2  85 04                sta     TXTPTR
001D43r 2  A5 4F                lda     TEMP1+2
001D45r 2  85 05                sta     TXTPTR+1
001D47r 2  A5 04                lda     TXTPTR
001D49r 2  D0 02                bne     @nb
001D4Br 2  C6 05                dec     TXTPTR+1
001D4Dr 2               @nb:
001D4Dr 2  C6 04                dec     TXTPTR
001D4Fr 2  20 rr rr             jsr     ChrGet                  ; first char
001D52r 2  20 rr rr             jsr     Fin                     ; FAC := value
001D55r 2                       ; Restore the saved byte.
001D55r 2  A5 4E                lda     TEMP1+1
001D57r 2  85 20                sta     INDEX
001D59r 2  A5 4F                lda     TEMP1+2
001D5Br 2  85 21                sta     INDEX+1
001D5Dr 2  A4 4D                ldy     TEMP1
001D5Fr 2  A5 50                lda     TEMP1+3
001D61r 2  91 20                sta     (INDEX),y
001D63r 2                       ; Restore TXTPTR.
001D63r 2  68                   pla
001D64r 2  85 05                sta     TXTPTR+1
001D66r 2  68                   pla
001D67r 2  85 04                sta     TXTPTR
001D69r 2  64 64                stz     VALTYP                  ; Fin left VALTYP = $FF from ParenStr
001D6Br 2  60                   rts
001D6Cr 2               
001D6Cr 2               ; ---------------------------------------------------------------------------
001D6Cr 2               ; FnLeftStr -- LEFT$(s$, n): leftmost n chars.
001D6Cr 2               ; ---------------------------------------------------------------------------
001D6Cr 2               FnLeftStr:
001D6Cr 2  20 rr rr             jsr     ChkOpn
001D6Fr 2  20 rr rr             jsr     FrmEvl
001D72r 2  20 rr rr             jsr     ChkStr
001D75r 2  20 rr rr             jsr     ChkCom
001D78r 2  20 rr rr             jsr     PushFac                 ; save string descriptor
001D7Br 2  20 rr rr             jsr     FrmEvl
001D7Er 2  20 rr rr             jsr     ChkNum
001D81r 2  20 rr rr             jsr     ChkCls
001D84r 2  20 rr rr             jsr     AyInt
001D87r 2  20 rr rr             jsr     PullArg                 ; ARG = string descriptor (BAS_TMP1 clobbered)
001D8Ar 2                       ; FAC still holds the integer n; check range and copy now.
001D8Ar 2  A5 11                lda     FAC+3
001D8Cr 2  D0 16                bne     @bad
001D8Er 2  A5 12                lda     FAC+4
001D90r 2  85 3B                sta     BAS_TMP1+1              ; n
001D92r 2                       ; Clamp n to ARG (length).
001D92r 2  A5 3B                lda     BAS_TMP1+1
001D94r 2  C5 16                cmp     ARG
001D96r 2  90 02                bcc     @ok
001D98r 2  A5 16                lda     ARG
001D9Ar 2               @ok:
001D9Ar 2  85 3B                sta     BAS_TMP1+1
001D9Cr 2                       ; Free the source temp BEFORE allocating result so the slot frees up.
001D9Cr 2  20 rr rr             jsr     FreeArgString
001D9Fr 2                       ; Offset = 0 for LEFT$.
001D9Fr 2  64 3A                stz     BAS_TMP1
001DA1r 2                       ; Allocate, copy first n bytes.
001DA1r 2  4C rr rr             jmp     SubstrCommon            ; tail-call (rts to caller)
001DA4r 2               @bad:
001DA4r 2  4C rr rr             jmp     IqErr
001DA7r 2               
001DA7r 2               ; ---------------------------------------------------------------------------
001DA7r 2               ; FnRightStr -- RIGHT$(s$, n): rightmost n chars.
001DA7r 2               ; ---------------------------------------------------------------------------
001DA7r 2               FnRightStr:
001DA7r 2  20 rr rr             jsr     ChkOpn
001DAAr 2  20 rr rr             jsr     FrmEvl
001DADr 2  20 rr rr             jsr     ChkStr
001DB0r 2  20 rr rr             jsr     ChkCom
001DB3r 2  20 rr rr             jsr     PushFac
001DB6r 2  20 rr rr             jsr     FrmEvl
001DB9r 2  20 rr rr             jsr     ChkNum
001DBCr 2  20 rr rr             jsr     ChkCls
001DBFr 2  20 rr rr             jsr     AyInt
001DC2r 2  20 rr rr             jsr     PullArg                 ; ARG = string descriptor (BAS_TMP1 clobbered)
001DC5r 2  A5 11                lda     FAC+3
001DC7r 2  D0 1B                bne     @bad
001DC9r 2  A5 12                lda     FAC+4
001DCBr 2  85 3B                sta     BAS_TMP1+1              ; n
001DCDr 2                       ; Clamp n.
001DCDr 2  A5 3B                lda     BAS_TMP1+1
001DCFr 2  C5 16                cmp     ARG
001DD1r 2  90 02                bcc     @ok
001DD3r 2  A5 16                lda     ARG
001DD5r 2               @ok:
001DD5r 2  85 3B                sta     BAS_TMP1+1
001DD7r 2                       ; offset = ARG - n.
001DD7r 2  A5 16                lda     ARG
001DD9r 2  38                   sec
001DDAr 2  E5 3B                sbc     BAS_TMP1+1
001DDCr 2  85 3A                sta     BAS_TMP1                ; start offset
001DDEr 2  20 rr rr             jsr     FreeArgString
001DE1r 2  4C rr rr             jmp     SubstrCommon
001DE4r 2               @bad:
001DE4r 2  4C rr rr             jmp     IqErr
001DE7r 2               
001DE7r 2               ; ---------------------------------------------------------------------------
001DE7r 2               ; FnMidStr -- MID$(s$, m [, n]): substring starting at m (1-based).
001DE7r 2               ; ---------------------------------------------------------------------------
001DE7r 2               FnMidStr:
001DE7r 2  20 rr rr             jsr     ChkOpn
001DEAr 2  20 rr rr             jsr     FrmEvl
001DEDr 2  20 rr rr             jsr     ChkStr
001DF0r 2  20 rr rr             jsr     ChkCom
001DF3r 2  20 rr rr             jsr     PushFac
001DF6r 2                       ; Read m.
001DF6r 2  20 rr rr             jsr     FrmEvl
001DF9r 2  20 rr rr             jsr     ChkNum
001DFCr 2  20 rr rr             jsr     AyInt
001DFFr 2  A5 11                lda     FAC+3
001E01r 2  D0 4B                bne     @bad
001E03r 2  A5 12                lda     FAC+4
001E05r 2  F0 47                beq     @bad                    ; m must be >= 1
001E07r 2  38                   sec
001E08r 2  E9 01                sbc     #1
001E0Ar 2  48                   pha                             ; offset = m-1; FrmEvl below would
001E0Br 2                                                       ; clobber BAS_TMP1, so park it here
001E0Br 2                       ; Optional ", n".
001E0Br 2  20 rr rr             jsr     ChrGot
001E0Er 2  C9 2C                cmp     #','
001E10r 2  F0 04                beq     @hasN
001E12r 2                       ; No n: take rest -> n = 255 (will clamp).
001E12r 2  A9 FF                lda     #255
001E14r 2  80 12                bra     @gotN
001E16r 2               @hasN:
001E16r 2  20 rr rr             jsr     ChrGet
001E19r 2  20 rr rr             jsr     FrmEvl
001E1Cr 2  20 rr rr             jsr     ChkNum
001E1Fr 2  20 rr rr             jsr     AyInt
001E22r 2  A5 11                lda     FAC+3
001E24r 2  D0 28                bne     @bad
001E26r 2  A5 12                lda     FAC+4
001E28r 2               @gotN:
001E28r 2  85 3B                sta     BAS_TMP1+1
001E2Ar 2  68                   pla
001E2Br 2  85 3A                sta     BAS_TMP1
001E2Dr 2  20 rr rr             jsr     ChkCls
001E30r 2  20 rr rr             jsr     PullArg                 ; ARG = string
001E33r 2                       ; Clamp offset to length.
001E33r 2  A5 3A                lda     BAS_TMP1
001E35r 2  C5 16                cmp     ARG
001E37r 2  90 04                bcc     @offOk
001E39r 2  A5 16                lda     ARG                     ; offset = length -> empty result
001E3Br 2  85 3A                sta     BAS_TMP1
001E3Dr 2               @offOk:
001E3Dr 2                       ; Clamp n to (length - offset).
001E3Dr 2  38                   sec
001E3Er 2  A5 16                lda     ARG
001E40r 2  E5 3A                sbc     BAS_TMP1
001E42r 2  C5 3B                cmp     BAS_TMP1+1
001E44r 2  B0 02                bcs     @nOk
001E46r 2  85 3B                sta     BAS_TMP1+1
001E48r 2               @nOk:
001E48r 2  20 rr rr             jsr     FreeArgString
001E4Br 2  4C rr rr             jmp     SubstrCommon
001E4Er 2               @bad:
001E4Er 2  4C rr rr             jmp     IqErr
001E51r 2               
001E51r 2               ; ---------------------------------------------------------------------------
001E51r 2               ; SubstrCommon -- copy BAS_TMP1+1 bytes from ARG-string at offset BAS_TMP1
001E51r 2               ; into a new heap allocation; result descriptor in FAC; PutNew.
001E51r 2               ; ---------------------------------------------------------------------------
001E51r 2               SubstrCommon:
001E51r 2                       ; Allocate.
001E51r 2  A5 3B                lda     BAS_TMP1+1
001E53r 2  20 rr rr             jsr     GetSpa                  ; FRESPC = new buffer
001E56r 2                       ; Source pointer = ARG+1 (lo/hi) + BAS_TMP1.
001E56r 2  18                   clc
001E57r 2  A5 17                lda     ARG+1
001E59r 2  65 3A                adc     BAS_TMP1
001E5Br 2  85 20                sta     INDEX
001E5Dr 2  A5 18                lda     ARG+2
001E5Fr 2  69 00                adc     #0
001E61r 2  85 21                sta     INDEX+1
001E63r 2                       ; Copy BAS_TMP1+1 bytes from (INDEX) to (FRESPC).
001E63r 2  A4 3B                ldy     BAS_TMP1+1
001E65r 2  F0 0B                beq     @done
001E67r 2  A0 00                ldy     #0
001E69r 2               @cp:
001E69r 2  B1 20                lda     (INDEX),y
001E6Br 2  91 84                sta     (FRESPC),y
001E6Dr 2  C8                   iny
001E6Er 2  C4 3B                cpy     BAS_TMP1+1
001E70r 2  D0 F7                bne     @cp
001E72r 2               @done:
001E72r 2                       ; Build descriptor.
001E72r 2  A5 3B                lda     BAS_TMP1+1
001E74r 2  85 0E                sta     FAC
001E76r 2  A5 84                lda     FRESPC
001E78r 2  85 0F                sta     FAC+1
001E7Ar 2  A5 85                lda     FRESPC+1
001E7Cr 2  85 10                sta     FAC+2
001E7Er 2                       ; Advance FRESPC by length consumed.
001E7Er 2  18                   clc
001E7Fr 2  A5 84                lda     FRESPC
001E81r 2  65 3B                adc     BAS_TMP1+1
001E83r 2  85 84                sta     FRESPC
001E85r 2  90 02                bcc     @nb
001E87r 2  E6 85                inc     FRESPC+1
001E89r 2               @nb:
001E89r 2  4C rr rr             jmp     PutNew
001E8Cr 2               
001E8Cr 2               ; FreeArgString -- if ARG holds a temp string descriptor (most-recent
001E8Cr 2               ; on TEMPST), pop just the descriptor.  Heap is left intact so callers
001E8Cr 2               ; that still need the source bytes can copy them safely; orphaned heap
001E8Cr 2               ; will be reclaimed by Garbag.
001E8Cr 2               FreeArgString:
001E8Cr 2  A5 19                lda     ARG+3                   ; descriptor address lo
001E8Er 2  A4 1A                ldy     ARG+4                   ; descriptor address hi (always $00)
001E90r 2  4C rr rr             jmp     FreTms
001E93r 2               
001E93r 2               ; Cleanup that releases both ARG's and FAC's temp descriptors (called from
001E93r 2               ; CatStr after content has been stashed but before new allocation).
001E93r 2               FreeBothTemps:
001E93r 2                       ; Free FAC's temp first (it is currently LASTPT).
001E93r 2  A5 11                lda     FAC+3
001E95r 2  A4 12                ldy     FAC+4
001E97r 2  20 rr rr             jsr     FreTms
001E9Ar 2                       ; Then ARG's (now LASTPT after FAC's removal).
001E9Ar 2  A5 19                lda     ARG+3
001E9Cr 2  A4 1A                ldy     ARG+4
001E9Er 2  4C rr rr             jmp     FreTms
001EA1r 2  60                   rts
001EA2r 2               
001EA2r 2               ; ===========================================================================
001EA2r 2               ;   E V A L U A T O R   -   B I N A R Y   O P E R A T O R   H E L P E R S
001EA2r 2               ; ===========================================================================
001EA2r 2               
001EA2r 2               ; ---------------------------------------------------------------------------
001EA2r 2               ; AndOp -- FAC = ARG AND FAC (bitwise on 16-bit signed ints).
001EA2r 2               ; ---------------------------------------------------------------------------
001EA2r 2               AndOp:
001EA2r 2  20 rr rr             jsr     AyInt                   ; FAC -> int (FAC+3=hi, FAC+4=lo)
001EA5r 2  A5 11                lda     FAC+3
001EA7r 2  85 3A                sta     BAS_TMP1                ; saved hi
001EA9r 2  A5 12                lda     FAC+4
001EABr 2  85 3B                sta     BAS_TMP1+1              ; saved lo
001EADr 2  20 rr rr             jsr     CopyArgToFac
001EB0r 2  20 rr rr             jsr     AyInt
001EB3r 2  A5 12                lda     FAC+4
001EB5r 2  25 3B                and     BAS_TMP1+1
001EB7r 2  A8                   tay                             ; Y = lo result
001EB8r 2  A5 11                lda     FAC+3
001EBAr 2  25 3A                and     BAS_TMP1                ; A = hi result
001EBCr 2  4C rr rr             jmp     GivAyf
001EBFr 2               
001EBFr 2               ; ---------------------------------------------------------------------------
001EBFr 2               ; OrOp -- FAC = ARG OR FAC.
001EBFr 2               ; ---------------------------------------------------------------------------
001EBFr 2               OrOp:
001EBFr 2  20 rr rr             jsr     AyInt
001EC2r 2  A5 11                lda     FAC+3
001EC4r 2  85 3A                sta     BAS_TMP1                ; saved hi
001EC6r 2  A5 12                lda     FAC+4
001EC8r 2  85 3B                sta     BAS_TMP1+1              ; saved lo
001ECAr 2  20 rr rr             jsr     CopyArgToFac
001ECDr 2  20 rr rr             jsr     AyInt
001ED0r 2  A5 12                lda     FAC+4
001ED2r 2  05 3B                ora     BAS_TMP1+1
001ED4r 2  A8                   tay                             ; Y = lo
001ED5r 2  A5 11                lda     FAC+3
001ED7r 2  05 3A                ora     BAS_TMP1                ; A = hi
001ED9r 2  4C rr rr             jmp     GivAyf
001EDCr 2               
001EDCr 2               ; ---------------------------------------------------------------------------
001EDCr 2               ; NotOp -- FAC = NOT FAC (bitwise complement of 16-bit signed int).
001EDCr 2               ; ---------------------------------------------------------------------------
001EDCr 2               NotOp:
001EDCr 2  20 rr rr             jsr     AyInt
001EDFr 2  A5 12                lda     FAC+4
001EE1r 2  49 FF                eor     #$FF
001EE3r 2  A8                   tay                             ; Y = lo
001EE4r 2  A5 11                lda     FAC+3
001EE6r 2  49 FF                eor     #$FF                    ; A = hi
001EE8r 2  4C rr rr             jmp     GivAyf
001EEBr 2               
001EEBr 2               ; ---------------------------------------------------------------------------
001EEBr 2               ; BasCmdLet -- minimal LET (assignment).  Entered with ChrGot returning
001EEBr 2               ; the first letter of the variable name.  No `LET` keyword required.
001EEBr 2               ; ---------------------------------------------------------------------------
001EEBr 2               BasCmdLet:
001EEBr 2  20 rr rr             jsr     PtrGet                  ; VARPNT, VALTYP set; TXTPTR past name
001EEEr 2                       ; Save VARPNT and the variable's VALTYP across FrmEvl.
001EEEr 2  A5 3F                lda     VARPNT
001EF0r 2  48                   pha
001EF1r 2  A5 40                lda     VARPNT+1
001EF3r 2  48                   pha
001EF4r 2  A5 64                lda     VALTYP
001EF6r 2  48                   pha
001EF7r 2  20 rr rr             jsr     ChrGot
001EFAr 2  C9 3D                cmp     #'='
001EFCr 2  D0 36                bne     @synErr
001EFEr 2  20 rr rr             jsr     ChrGet
001F01r 2  20 rr rr             jsr     FrmEvl
001F04r 2  68                   pla                             ; saved variable VALTYP
001F05r 2  85 3E                sta     BAS_TMP3
001F07r 2  45 64                eor     VALTYP
001F09r 2  30 2F                bmi     @typeErr
001F0Br 2  68                   pla
001F0Cr 2  85 40                sta     VARPNT+1
001F0Er 2  68                   pla
001F0Fr 2  85 3F                sta     VARPNT
001F11r 2  24 3E                bit     BAS_TMP3
001F13r 2  30 07                bmi     @storeStr
001F15r 2                       ; Numeric: store FAC into (VARPNT) (5 bytes).
001F15r 2  A6 3F                ldx     VARPNT
001F17r 2  A4 40                ldy     VARPNT+1
001F19r 2  4C rr rr             jmp     StoreFacAtYxRounded
001F1Cr 2               @storeStr:
001F1Cr 2  A0 00                ldy     #0
001F1Er 2  A5 0E                lda     FAC
001F20r 2  91 3F                sta     (VARPNT),y
001F22r 2  C8                   iny
001F23r 2  A5 0F                lda     FAC+1
001F25r 2  91 3F                sta     (VARPNT),y
001F27r 2  C8                   iny
001F28r 2  A5 10                lda     FAC+2
001F2Ar 2  91 3F                sta     (VARPNT),y
001F2Cr 2                       ; If the RHS was a temporary string (StrLt2/PutNew pushed it and left
001F2Cr 2                       ; its descriptor address in FAC+3/FAC+4 == LASTPT), pop it now that
001F2Cr 2                       ; the variable owns the heap copy.  Pop only (FreTms), never FreFac --
001F2Cr 2                       ; reclaiming would free the string we just stored.  For a plain
001F2Cr 2                       ; variable RHS, @loadStr set FAC+3/FAC+4 to that variable's address
001F2Cr 2                       ; (nonzero high byte), which cannot match a temp slot, so FreTms is a
001F2Cr 2                       ; no-op.  Without this, >3 consecutive string LETs leak the 3-slot
001F2Cr 2                       ; temp stack (?FORMULA TOO COMPLEX).
001F2Cr 2  A5 11                lda     FAC+3
001F2Er 2  A4 12                ldy     FAC+4
001F30r 2  20 rr rr             jsr     FreTms
001F33r 2  60                   rts
001F34r 2               @synErr:
001F34r 2  68                   pla
001F35r 2  68                   pla
001F36r 2  68                   pla
001F37r 2  4C rr rr             jmp     SynErr
001F3Ar 2               @typeErr:
001F3Ar 2  68                   pla
001F3Br 2  68                   pla
001F3Cr 2  A2 08                ldx     #ERR_TYPEMISM
001F3Er 2  4C rr rr             jmp     BasErrorVec
001F41r 2               
001F41r 2               ; =============================================================================
001F41r 2               ;   C O N T R O L   F L O W   /   S T A T E M E N T   L O O P
001F41r 2               ;
001F41r 2               ;   BasNewstt drives execution for both direct mode (TXTPTR in BAS_TOKBUF)
001F41r 2               ;   and run mode (TXTPTR walks program lines from BAS_TXTTAB).  Statement
001F41r 2               ;   dispatch follows the msbasic convention: push (routine_addr - 1) and
001F41r 2               ;   tail-jump through ChrGet, so the routine entry is reached via RTS.
001F41r 2               ;
001F41r 2               ;   FOR and GOSUB store frames on the CPU stack and JMP back to BasNewstt;
001F41r 2               ;   NEXT and RETURN scan the stack for a matching tag, then TXS to discard
001F41r 2               ;   the frame and resume.
001F41r 2               ; =============================================================================
001F41r 2               
001F41r 2               NUM_STMT_TOKENS = TOK_MEM + 1 - TOK_BASE       ; $36 entries
001F41r 2               
001F41r 2               BasNewstt:
001F41r 2  20 rr rr             jsr     BasCheckBreak
001F44r 2                       ; Save TXTPTR -> OLDTEXT for CONT, except in direct mode.
001F44r 2  AD 6A 03             lda     BAS_CURLIN+1
001F47r 2  C9 FF                cmp     #$FF
001F49r 2  F0 0A                beq     @noSave
001F4Br 2  A5 04                lda     TXTPTR
001F4Dr 2  8D 6D 03             sta     BAS_OLDTEXT
001F50r 2  A5 05                lda     TXTPTR+1
001F52r 2  8D 6E 03             sta     BAS_OLDTEXT+1
001F55r 2               @noSave:
001F55r 2  A0 00                ldy     #0
001F57r 2  B1 04                lda     (TXTPTR),y
001F59r 2  F0 10                beq     @endLine
001F5Br 2  C9 A4                cmp     #TOK_ELSE
001F5Dr 2  F0 07                beq     @skipElse               ; THEN-branch ran; skip ELSE clause to EOL
001F5Fr 2  C9 3A                cmp     #':'
001F61r 2  F0 34                beq     @nextStmt
001F63r 2  4C rr rr             jmp     SynErr
001F66r 2               @skipElse:
001F66r 2                       ; Advance TXTPTR until we land on a $00 terminator.
001F66r 2               @skLoop:
001F66r 2  20 rr rr             jsr     ChrGet
001F69r 2  D0 FB                bne     @skLoop
001F6Br 2                       ; Fall through to @endLine with TXTPTR at $00.
001F6Br 2               @endLine:
001F6Br 2                       ; Direct mode: end of buffer -> back to REPL.
001F6Br 2  AD 6A 03             lda     BAS_CURLIN+1
001F6Er 2  C9 FF                cmp     #$FF
001F70r 2  D0 03                bne     @walkNext
001F72r 2  4C rr rr             jmp     BasReadyLoop            ; OK is printed by BasReadyLoop
001F75r 2               @walkNext:
001F75r 2                       ; Run mode: examine next-pointer at offsets +1,+2.
001F75r 2  A0 02                ldy     #2
001F77r 2  B1 04                lda     (TXTPTR),y
001F79r 2  D0 06                bne     @loadLine               ; nonzero hi -> next line exists
001F7Br 2                       ; End of program -> halt and return to REPL.
001F7Br 2  A2 FF                ldx     #$FF
001F7Dr 2  9A                   txs
001F7Er 2  4C rr rr             jmp     BasReadyLoop
001F81r 2               @loadLine:
001F81r 2  C8                   iny                             ; y=3
001F82r 2  B1 04                lda     (TXTPTR),y
001F84r 2  8D 69 03             sta     BAS_CURLIN
001F87r 2  C8                   iny                             ; y=4
001F88r 2  B1 04                lda     (TXTPTR),y
001F8Ar 2  8D 6A 03             sta     BAS_CURLIN+1
001F8Dr 2  98                   tya                             ; A=4
001F8Er 2  18                   clc
001F8Fr 2  65 04                adc     TXTPTR
001F91r 2  85 04                sta     TXTPTR
001F93r 2  90 02                bcc     @nextStmt
001F95r 2  E6 05                inc     TXTPTR+1
001F97r 2               @nextStmt:
001F97r 2  20 rr rr             jsr     ChrGet
001F9Ar 2  20 rr rr             jsr     BasExecuteStatement
001F9Dr 2  4C rr rr             jmp     BasNewstt
001FA0r 2               
001FA0r 2               ; ---------------------------------------------------------------------------
001FA0r 2               ; BasExecuteStatement -- A = current tokenized byte (loaded by ChrGet).
001FA0r 2               ;   * A = 0  -> RTS (no-op; end of statement chain).
001FA0r 2               ;   * A < $80 (letter) -> JMP BasCmdLet.
001FA0r 2               ;   * A is a statement token ($80..TOK_MEM) -> dispatch via BasTokenAddrTbl.
001FA0r 2               ;   * Otherwise -> ?SYNTAX ERROR.
001FA0r 2               ; ---------------------------------------------------------------------------
001FA0r 2               BasExecuteStatement:
001FA0r 2  F0 30                beq     @ret
001FA2r 2  38                   sec
001FA3r 2  E9 80                sbc     #TOK_BASE
001FA5r 2  90 25                bcc     @doLet
001FA7r 2  C9 36                cmp     #NUM_STMT_TOKENS
001FA9r 2  B0 0D                bcs     @ext
001FABr 2  0A                   asl     a
001FACr 2  A8                   tay
001FADr 2  B9 rr rr             lda     BasTokenAddrTbl+1,y
001FB0r 2  48                   pha
001FB1r 2  B9 rr rr             lda     BasTokenAddrTbl,y
001FB4r 2  48                   pha
001FB5r 2  4C rr rr             jmp     ChrGet
001FB8r 2               @ext:
001FB8r 2                       ; Extended statement tokens DISK/BLOAD/BSAVE/FORMAT ($D1-$D4).
001FB8r 2                       ; Bodies live in the Kernal via BasExtAddrTbl (thin-BASIC strategy).
001FB8r 2  38                   sec
001FB9r 2  E9 51                sbc     #(TOK_DISK - TOK_BASE)
001FBBr 2  C9 04                cmp     #4
001FBDr 2  B0 10                bcs     @synErr
001FBFr 2  0A                   asl     a
001FC0r 2  A8                   tay
001FC1r 2  B9 rr rr             lda     BasExtAddrTbl+1,y
001FC4r 2  48                   pha
001FC5r 2  B9 rr rr             lda     BasExtAddrTbl,y
001FC8r 2  48                   pha
001FC9r 2  4C rr rr             jmp     ChrGet
001FCCr 2               @doLet:
001FCCr 2  4C rr rr             jmp     BasCmdLet
001FCFr 2               @synErr:
001FCFr 2  4C rr rr             jmp     SynErr
001FD2r 2               @ret:
001FD2r 2  60                   rts
001FD3r 2               
001FD3r 2               ; ---------------------------------------------------------------------------
001FD3r 2               ; BasCheckBreak -- poll input buffer for Ctrl-C / ESC.  On break, save
001FD3r 2               ; CONT context and bounce to REPL.  Other keys are stashed in BAS_PENDKEY
001FD3r 2               ; for INKEY to retrieve.
001FD3r 2               ; ---------------------------------------------------------------------------
001FD3r 2               BasCheckBreak:
001FD3r 2                       ; In direct mode (CURLIN hi == $FF) skip the break check entirely;
001FD3r 2                       ; otherwise we would drain pending REPL keystrokes and corrupt the
001FD3r 2                       ; next BasReadLine input.  Break is only meaningful while RUNning.
001FD3r 2  AD 6A 03             lda     BAS_CURLIN+1
001FD6r 2  C9 FF                cmp     #$FF
001FD8r 2  F0 13                beq     @no
001FDAr 2  20 rr rr             jsr     BufferSize
001FDDr 2  F0 0E                beq     @no
001FDFr 2  20 rr rr             jsr     ReadBuffer
001FE2r 2  C9 03                cmp     #$03
001FE4r 2  F0 08                beq     @break
001FE6r 2  C9 1B                cmp     #$1B
001FE8r 2  F0 04                beq     @break
001FEAr 2  8D 0E 03             sta     BAS_PENDKEY
001FEDr 2               @no:
001FEDr 2  60                   rts
001FEEr 2               @break:
001FEEr 2                       ; OLDLIN/OLDTEXT already track the executing line.  Make sure the
001FEEr 2                       ; saved values reflect the current line so CONT can resume.
001FEEr 2  AD 69 03             lda     BAS_CURLIN
001FF1r 2  8D 6B 03             sta     BAS_OLDLIN
001FF4r 2  AD 6A 03             lda     BAS_CURLIN+1
001FF7r 2  8D 6C 03             sta     BAS_OLDLIN+1
001FFAr 2  A2 FF                ldx     #$FF
001FFCr 2  9A                   txs
001FFDr 2  20 rr rr             jsr     BasPrintCRLF
002000r 2  A9 rr                lda     #<MsgBreak
002002r 2  A0 rr                ldy     #>MsgBreak
002004r 2  20 rr rr             jsr     BasPrintStr
002007r 2  AD 6A 03             lda     BAS_CURLIN+1
00200Ar 2  C9 FF                cmp     #$FF
00200Cr 2  F0 14                beq     @noLine
00200Er 2  A9 rr                lda     #<MsgInWord
002010r 2  A0 rr                ldy     #>MsgInWord
002012r 2  20 rr rr             jsr     BasPrintStr
002015r 2  AD 69 03             lda     BAS_CURLIN
002018r 2  85 08                sta     BAS_LINNUM
00201Ar 2  AD 6A 03             lda     BAS_CURLIN+1
00201Dr 2  85 09                sta     BAS_LINNUM+1
00201Fr 2  20 rr rr             jsr     BasPrintLineNum
002022r 2               @noLine:
002022r 2  A9 FF                lda     #$FF
002024r 2  8D 69 03             sta     BAS_CURLIN
002027r 2  8D 6A 03             sta     BAS_CURLIN+1
00202Ar 2  4C rr rr             jmp     BasReadyLoop
00202Dr 2               
00202Dr 2  42 52 45 41  MsgBreak: .byte "BREAK",0
002031r 2  4B 00        
002033r 2               
002033r 2               ; ---------------------------------------------------------------------------
002033r 2               ; LinGet -- parse decimal digits at TXTPTR into BAS_LINNUM (16-bit).
002033r 2               ; Caller has set carry conditions appropriate to ChrGet entry.  TXTPTR
002033r 2               ; ends pointing at the first non-digit.
002033r 2               ; ---------------------------------------------------------------------------
002033r 2               LinGet:
002033r 2  A2 00                ldx     #0
002035r 2  86 08                stx     BAS_LINNUM
002037r 2  86 09                stx     BAS_LINNUM+1
002039r 2               @loop:
002039r 2  B0 3A                bcs     @done
00203Br 2  E9 2F                sbc     #$2F                    ; carry already set
00203Dr 2  85 44                sta     CHARAC
00203Fr 2                       ; LINNUM *= 10
00203Fr 2  A5 08                lda     BAS_LINNUM
002041r 2  85 3A                sta     BAS_TMP1
002043r 2  A5 09                lda     BAS_LINNUM+1
002045r 2  85 3B                sta     BAS_TMP1+1
002047r 2  C9 19                cmp     #$19
002049r 2  B0 2B                bcs     @ovf
00204Br 2  06 08                asl     BAS_LINNUM
00204Dr 2  26 09                rol     BAS_LINNUM+1
00204Fr 2  06 08                asl     BAS_LINNUM
002051r 2  26 09                rol     BAS_LINNUM+1
002053r 2  18                   clc
002054r 2  A5 08                lda     BAS_LINNUM
002056r 2  65 3A                adc     BAS_TMP1
002058r 2  85 08                sta     BAS_LINNUM
00205Ar 2  A5 09                lda     BAS_LINNUM+1
00205Cr 2  65 3B                adc     BAS_TMP1+1
00205Er 2  85 09                sta     BAS_LINNUM+1
002060r 2  06 08                asl     BAS_LINNUM
002062r 2  26 09                rol     BAS_LINNUM+1
002064r 2  18                   clc
002065r 2  A5 08                lda     BAS_LINNUM
002067r 2  65 44                adc     CHARAC
002069r 2  85 08                sta     BAS_LINNUM
00206Br 2  90 02                bcc     @nextDigit
00206Dr 2  E6 09                inc     BAS_LINNUM+1
00206Fr 2               @nextDigit:
00206Fr 2  20 rr rr             jsr     ChrGet
002072r 2  4C rr rr             jmp     @loop
002075r 2               @done:
002075r 2  60                   rts
002076r 2               @ovf:
002076r 2  A2 00                ldx     #ERR_SYNTAX
002078r 2  4C rr rr             jmp     BasErrorVec
00207Br 2               
00207Br 2               ; ---------------------------------------------------------------------------
00207Br 2               ; FndLin -- find program line whose number matches BAS_LINNUM.
00207Br 2               ;   On success: carry SET, BAS_TMP1 (LOWTR alias) = address of line.
00207Br 2               ;   On failure: carry CLEAR, BAS_TMP1 = address where line would belong.
00207Br 2               ; ---------------------------------------------------------------------------
00207Br 2               FndLin:
00207Br 2  AD 5D 03             lda     BAS_TXTTAB
00207Er 2  AE 5E 03             ldx     BAS_TXTTAB+1
002081r 2               @walk:
002081r 2  85 3A                sta     BAS_TMP1
002083r 2  86 3B                stx     BAS_TMP1+1
002085r 2  A0 01                ldy     #1
002087r 2  B1 3A                lda     (BAS_TMP1),y
002089r 2  F0 20                beq     @notFound               ; next-hi=0 -> end of program
00208Br 2  A0 03                ldy     #3                      ; line-num-lo offset
00208Dr 2  A5 09                lda     BAS_LINNUM+1
00208Fr 2  D1 3A                cmp     (BAS_TMP1),y            ; compare hi byte at +3? need iny
002091r 2                       ; Actually format: +0 next-lo, +1 next-hi, +2 num-lo, +3 num-hi
002091r 2  90 18                bcc     @notFound               ; LINNUM-hi < line-hi -> miss
002093r 2  D0 09                bne     @advance                ; LINNUM-hi > line-hi -> next line
002095r 2  88                   dey                             ; y=2 = num-lo
002096r 2  A5 08                lda     BAS_LINNUM
002098r 2  D1 3A                cmp     (BAS_TMP1),y
00209Ar 2  90 0F                bcc     @notFound
00209Cr 2  F0 0F                beq     @found
00209Er 2               @advance:
00209Er 2  A0 00                ldy     #0
0020A0r 2  B1 3A                lda     (BAS_TMP1),y
0020A2r 2  48                   pha
0020A3r 2  A0 01                ldy     #1
0020A5r 2  B1 3A                lda     (BAS_TMP1),y
0020A7r 2  AA                   tax
0020A8r 2  68                   pla
0020A9r 2  B0 D6                bcs     @walk                   ; carry=1 means continue (always)
0020ABr 2               @notFound:
0020ABr 2  18                   clc
0020ACr 2  60                   rts
0020ADr 2               @found:
0020ADr 2  38                   sec
0020AEr 2  60                   rts
0020AFr 2               
0020AFr 2               ; ---------------------------------------------------------------------------
0020AFr 2               ; BasCmdGoto -- TXTPTR points at line-number digits.
0020AFr 2               ; ---------------------------------------------------------------------------
0020AFr 2               BasCmdGoto:
0020AFr 2  20 rr rr             jsr     LinGet
0020B2r 2  20 rr rr             jsr     BasRemn                 ; skip remainder of statement
0020B5r 2  20 rr rr             jsr     FndLin
0020B8r 2  90 0E                bcc     @undef
0020BAr 2                       ; LOWTR (BAS_TMP1) = target line addr.  TXTPTR = LOWTR - 1
0020BAr 2                       ; (so NEWSTT sees the previous line's $00 terminator at offset 0).
0020BAr 2  38                   sec
0020BBr 2  A5 3A                lda     BAS_TMP1
0020BDr 2  E9 01                sbc     #1
0020BFr 2  85 04                sta     TXTPTR
0020C1r 2  A5 3B                lda     BAS_TMP1+1
0020C3r 2  E9 00                sbc     #0
0020C5r 2  85 05                sta     TXTPTR+1
0020C7r 2  60                   rts
0020C8r 2               @undef:
0020C8r 2  A2 03                ldx     #ERR_UNDEFSTMT
0020CAr 2  4C rr rr             jmp     BasErrorVec
0020CDr 2               
0020CDr 2               ; ---------------------------------------------------------------------------
0020CDr 2               ; BasCmdGosub -- push 5-byte frame on stack, then GOTO target.
0020CDr 2               ; Frame layout (top-down): [tag $8C][CURLIN-lo][CURLIN-hi][TXTPTR-lo][TXTPTR-hi]
0020CDr 2               ; ---------------------------------------------------------------------------
0020CDr 2               BasCmdGosub:
0020CDr 2                       ; Refuse to nest deeper than page 1 can hold.  msbasic guards every
0020CDr 2                       ; stack-frame push with GETSTK; this is that check specialised to
0020CDr 2                       ; GOSUB's fixed frame (msbasic's `LDA #3 : JSR GETSTK`, i.e. 3*2
0020CDr 2                       ; bytes of frame plus GETSTK's $3E-byte margin for the interpreter's
0020CDr 2                       ; own JSR nesting inside the subroutine).  Without it the frames run
0020CDr 2                       ; off the bottom of the stack and corrupt page 1 instead of raising
0020CDr 2                       ; an error.
0020CDr 2  BA                   tsx
0020CEr 2  E0 44                cpx     #GOSUB_STACK_MIN
0020D0r 2  90 1A                bcc     @outOfMemory
0020D2r 2  A5 05                lda     TXTPTR+1
0020D4r 2  48                   pha
0020D5r 2  A5 04                lda     TXTPTR
0020D7r 2  48                   pha
0020D8r 2  AD 6A 03             lda     BAS_CURLIN+1
0020DBr 2  48                   pha
0020DCr 2  AD 69 03             lda     BAS_CURLIN
0020DFr 2  48                   pha
0020E0r 2  A9 8C                lda     #TOK_GOSUB
0020E2r 2  48                   pha
0020E3r 2  20 rr rr             jsr     ChrGot
0020E6r 2  20 rr rr             jsr     BasCmdGoto
0020E9r 2  4C rr rr             jmp     BasNewstt
0020ECr 2               @outOfMemory:
0020ECr 2  A9 02                lda     #ERR_OUTOFMEM
0020EEr 2  4C rr rr             jmp     BasError
0020F1r 2               
0020F1r 2               ; ---------------------------------------------------------------------------
0020F1r 2               ; BasCmdReturn -- locate GOSUB frame on stack and resume at saved TXTPTR.
0020F1r 2               ; Per msbasic: scan the CPU stack from SP+5 (skipping return-routine's caller
0020F1r 2               ; return + this scan's own JSR return).  RTS at end pops the leaked
0020F1r 2               ; EXEC-return that GOSUB left behind.
0020F1r 2               ; ---------------------------------------------------------------------------
0020F1r 2               BasCmdReturn:
0020F1r 2  20 rr rr             jsr     GtForPnt
0020F4r 2                       ; X now points to the slot just BELOW a frame tag (or end of stack).
0020F4r 2  9A                   txs
0020F5r 2  C9 8C                cmp     #TOK_GOSUB
0020F7r 2  F0 05                beq     @ok
0020F9r 2  A2 0C                ldx     #ERR_RG
0020FBr 2  4C rr rr             jmp     BasErrorVec
0020FEr 2               @ok:
0020FEr 2  68                   pla                             ; tag (already in A, this discards)
0020FFr 2  68                   pla
002100r 2  8D 69 03             sta     BAS_CURLIN
002103r 2  68                   pla
002104r 2  8D 6A 03             sta     BAS_CURLIN+1
002107r 2  68                   pla
002108r 2  85 04                sta     TXTPTR
00210Ar 2  68                   pla
00210Br 2  85 05                sta     TXTPTR+1
00210Dr 2                       ; Skip remainder of GOSUB-target statement (DATAN-style).
00210Dr 2  20 rr rr             jsr     BasDatan
002110r 2                       ; Advance TXTPTR by Y (number of bytes to terminator).
002110r 2  98                   tya
002111r 2  18                   clc
002112r 2  65 04                adc     TXTPTR
002114r 2  85 04                sta     TXTPTR
002116r 2  90 02                bcc     @noinc
002118r 2  E6 05                inc     TXTPTR+1
00211Ar 2               @noinc:
00211Ar 2  60                   rts
00211Br 2               
00211Br 2               ; ---------------------------------------------------------------------------
00211Br 2               ; GtForPnt -- scan CPU stack for FOR/GOSUB frames.
00211Br 2               ;   On entry: BAS_FORPNT (FORPNT) = $FFxx for "match any tag".
00211Br 2               ;   Returns: X = stack pointer where the matching frame's tag-1 lives,
00211Br 2               ;            A = tag byte found (or 0 if end-of-stack).  Z=1 if found tag,
00211Br 2               ;            Z=0 (A=0) if no frame found.
00211Br 2               ; ---------------------------------------------------------------------------
00211Br 2               GtForPnt:
00211Br 2  BA                   tsx
00211Cr 2  E8                   inx
00211Dr 2  E8                   inx
00211Er 2  E8                   inx
00211Fr 2  E8                   inx
002120r 2               @scan:
002120r 2  BD 01 01             lda     $0101,x                 ; tag candidate
002123r 2  C9 81                cmp     #TOK_FOR
002125r 2  D0 25                bne     @notFor
002127r 2                       ; Compare frame's variable address to FORPNT.
002127r 2  A5 47                lda     BAS_FORPNT+1
002129r 2  D0 0A                bne     @skipVar                ; FORPNT+1 = $FF -> skip variable test
00212Br 2  BD 02 01             lda     $0102,x
00212Er 2  85 46                sta     BAS_FORPNT
002130r 2  BD 03 01             lda     $0103,x
002133r 2  85 47                sta     BAS_FORPNT+1
002135r 2               @skipVar:
002135r 2  DD 03 01             cmp     $0103,x
002138r 2  D0 07                bne     @advance
00213Ar 2  A5 46                lda     BAS_FORPNT
00213Cr 2  DD 02 01             cmp     $0102,x
00213Fr 2  F0 13                beq     @found
002141r 2               @advance:
002141r 2  8A                   txa
002142r 2  18                   clc
002143r 2  69 12                adc     #18                     ; BYTES_PER_FRAME (FOR)
002145r 2  AA                   tax
002146r 2  D0 D8                bne     @scan
002148r 2                       ; Walked off stack
002148r 2  A9 00                lda     #0
00214Ar 2  18                   clc                             ; not found
00214Br 2  60                   rts
00214Cr 2               @notFor:
00214Cr 2  C9 8C                cmp     #TOK_GOSUB
00214Er 2  F0 04                beq     @found
002150r 2  A9 00                lda     #0
002152r 2  18                   clc                             ; not found
002153r 2  60                   rts
002154r 2               @found:
002154r 2  38                   sec                             ; found; A still holds the tag or FORPNT
002155r 2  60                   rts
002156r 2               
002156r 2               ; ---------------------------------------------------------------------------
002156r 2               ; BasRemn -- scan TXTPTR forward to next ':' or end-of-line.
002156r 2               ; Sets Y to byte offset of terminator from current TXTPTR.  Honours quotes.
002156r 2               ; ---------------------------------------------------------------------------
002156r 2               BasDatan:
002156r 2  A2 3A                ldx     #':'
002158r 2  2C                   .byte   $2C                     ; BIT abs absorbs next 2-byte LDX
002159r 2               BasRemn:
002159r 2  A2 00                ldx     #0
00215Br 2  86 44                stx     CHARAC
00215Dr 2  A0 00                ldy     #0
00215Fr 2  84 6A                sty     ENDCHR
002161r 2               @swap:
002161r 2  A5 6A                lda     ENDCHR
002163r 2  A6 44                ldx     CHARAC
002165r 2  85 44                sta     CHARAC
002167r 2  86 6A                stx     ENDCHR
002169r 2               @scan:
002169r 2  B1 04                lda     (TXTPTR),y
00216Br 2  F0 0B                beq     @done
00216Dr 2  C5 6A                cmp     ENDCHR
00216Fr 2  F0 07                beq     @done
002171r 2  C8                   iny
002172r 2  C9 22                cmp     #'"'
002174r 2  F0 EB                beq     @swap
002176r 2  D0 F1                bne     @scan
002178r 2               @done:
002178r 2  60                   rts
002179r 2               
002179r 2               ; ---------------------------------------------------------------------------
002179r 2               ; Statement: REM -- skip to end of line.
002179r 2               ; Statement: DATA -- treated like REM at execution time (just skip).
002179r 2               ; ---------------------------------------------------------------------------
002179r 2               BasCmdRem:
002179r 2  20 rr rr             jsr     BasRemn
00217Cr 2  80 03                bra     BasAddon
00217Er 2               BasCmdData:
00217Er 2  20 rr rr             jsr     BasDatan
002181r 2               BasAddon:
002181r 2  98                   tya
002182r 2  18                   clc
002183r 2  65 04                adc     TXTPTR
002185r 2  85 04                sta     TXTPTR
002187r 2  90 02                bcc     @done
002189r 2  E6 05                inc     TXTPTR+1
00218Br 2               @done:
00218Br 2  60                   rts
00218Cr 2               
00218Cr 2               ; ---------------------------------------------------------------------------
00218Cr 2               ; Statement: IF expr THEN (linenum | stmt) [ELSE stmt]
00218Cr 2               ;   IF expr GOTO linenum is also accepted.
00218Cr 2               ;   If expr is false, skip rest of line (REM-style).
00218Cr 2               ;   ELSE: scan ahead for TOK_ELSE on this line.
00218Cr 2               ; ---------------------------------------------------------------------------
00218Cr 2               BasCmdIf:
00218Cr 2  20 rr rr             jsr     FrmEvl
00218Fr 2  20 rr rr             jsr     ChrGot
002192r 2  C9 88                cmp     #TOK_GOTO
002194r 2  F0 05                beq     @testTrue
002196r 2  A9 9F                lda     #TOK_THEN
002198r 2  20 rr rr             jsr     SynChr
00219Br 2               @testTrue:
00219Br 2  A5 0E                lda     FAC
00219Dr 2  D0 1E                bne     @true
00219Fr 2                       ; FALSE: scan to end-of-line OR a TOK_ELSE; if ELSE found, advance
00219Fr 2                       ; TXTPTR past it and resume execution there.
00219Fr 2  A0 00                ldy     #0
0021A1r 2               @searchElse:
0021A1r 2  B1 04                lda     (TXTPTR),y
0021A3r 2  F0 07                beq     @noElse
0021A5r 2  C9 A4                cmp     #TOK_ELSE
0021A7r 2  F0 09                beq     @gotElse
0021A9r 2  C8                   iny
0021AAr 2  D0 F5                bne     @searchElse
0021ACr 2               @noElse:
0021ACr 2                       ; Skip remainder of line (no ELSE).
0021ACr 2  20 rr rr             jsr     BasRemn
0021AFr 2  4C rr rr             jmp     BasAddon
0021B2r 2               @gotElse:
0021B2r 2                       ; Advance TXTPTR past ELSE token, then run the ELSE branch as a
0021B2r 2                       ; statement.  Falling through to @true's tail is deliberate: the
0021B2r 2                       ; branch after ELSE is dispatched exactly like the one after THEN,
0021B2r 2                       ; so `ELSE <linenum>` is an implicit GOTO too.  Returning here
0021B2r 2                       ; instead would leave TXTPTR mid-statement and the interpreter loop
0021B2r 2                       ; would report ?SYNTAX ERROR.
0021B2r 2  C8                   iny
0021B3r 2  98                   tya
0021B4r 2  18                   clc
0021B5r 2  65 04                adc     TXTPTR
0021B7r 2  85 04                sta     TXTPTR
0021B9r 2  90 02                bcc     @true
0021BBr 2  E6 05                inc     TXTPTR+1
0021BDr 2               @true:
0021BDr 2                       ; TRUE: if next is a digit, IF expr THEN <linenum> -> implicit GOTO.
0021BDr 2  20 rr rr             jsr     ChrGot
0021C0r 2  90 03                bcc     @goto                   ; carry CLEAR -> digit
0021C2r 2                       ; Otherwise dispatch as a statement (msbasic: jmp EXECUTE_STATEMENT).
0021C2r 2  4C rr rr             jmp     BasExecuteStatement
0021C5r 2               @goto:
0021C5r 2  4C rr rr             jmp     BasCmdGoto
0021C8r 2               
0021C8r 2               ; ---------------------------------------------------------------------------
0021C8r 2               ; Statement: ON expr GOTO/GOSUB linenum,linenum,...
0021C8r 2               ; ---------------------------------------------------------------------------
0021C8r 2               BasCmdOn:
0021C8r 2  20 rr rr             jsr     GetByt                  ; X = expr byte (1..255)
0021CBr 2  48                   pha                             ; save GOTO/GOSUB token byte
0021CCr 2  C9 8C                cmp     #TOK_GOSUB
0021CEr 2  F0 04                beq     @loop
0021D0r 2  C9 88                cmp     #TOK_GOTO
0021D2r 2  D0 14                bne     @synErr
0021D4r 2               @loop:
0021D4r 2  C6 12                dec     FAC+4
0021D6r 2  D0 04                bne     @next
0021D8r 2  68                   pla
0021D9r 2                       ; Re-dispatch through statement table so trampoline ChrGet skips the
0021D9r 2                       ; current separator (',' or 0) before the GOTO/GOSUB handler runs.
0021D9r 2  4C rr rr             jmp     BasExecuteStatement
0021DCr 2               @next:
0021DCr 2  20 rr rr             jsr     ChrGet
0021DFr 2  20 rr rr             jsr     LinGet
0021E2r 2  C9 2C                cmp     #','
0021E4r 2  F0 EE                beq     @loop
0021E6r 2  68                   pla
0021E7r 2  60                   rts
0021E8r 2               @synErr:
0021E8r 2  68                   pla
0021E9r 2  4C rr rr             jmp     SynErr
0021ECr 2               
0021ECr 2               ; ---------------------------------------------------------------------------
0021ECr 2               ; GetByt / GtByteCom -- evaluate expression in TXTPTR to byte 0..255 in X.
0021ECr 2               ;   GetByt: TXTPTR is at first byte of expression.
0021ECr 2               ;   GtByteCom: consume comma first.
0021ECr 2               ; ---------------------------------------------------------------------------
0021ECr 2               GtByteCom:
0021ECr 2  20 rr rr             jsr     ChrGet
0021EFr 2               GetByt:
0021EFr 2  20 rr rr             jsr     FrmNum
0021F2r 2  20 rr rr             jsr     MkInt
0021F5r 2  A6 11                ldx     FAC+3
0021F7r 2  D0 05                bne     @ovf
0021F9r 2  A6 12                ldx     FAC+4
0021FBr 2  4C rr rr             jmp     ChrGot
0021FEr 2               @ovf:
0021FEr 2  4C rr rr             jmp     IqErr
002201r 2               
002201r 2               ; ---------------------------------------------------------------------------
002201r 2               ; Statement: RUN [linenum]
002201r 2               ; ---------------------------------------------------------------------------
002201r 2               BasCmdRun:
002201r 2  20 rr rr             jsr     ChrGot
002204r 2  D0 1F                bne     @withLine
002206r 2  20 rr rr             jsr     BasCmdClr
002209r 2                       ; Set TXTPTR = TXTTAB - 1 ; ensure that byte = 0.
002209r 2  38                   sec
00220Ar 2  AD 5D 03             lda     BAS_TXTTAB
00220Dr 2  E9 01                sbc     #1
00220Fr 2  85 04                sta     TXTPTR
002211r 2  AD 5E 03             lda     BAS_TXTTAB+1
002214r 2  E9 00                sbc     #0
002216r 2  85 05                sta     TXTPTR+1
002218r 2                       ; Force the byte at TXTTAB-1 to be zero so NEWSTT walks the chain.
002218r 2  A9 00                lda     #0
00221Ar 2  A0 00                ldy     #0
00221Cr 2  91 04                sta     (TXTPTR),y
00221Er 2                       ; Leave direct-mode (CURLIN+1=$FF); @loadLine will set real value.
00221Er 2  9C 69 03             stz     BAS_CURLIN
002221r 2  9C 6A 03             stz     BAS_CURLIN+1
002224r 2  60                   rts
002225r 2               @withLine:
002225r 2  20 rr rr             jsr     BasCmdClr
002228r 2  20 rr rr             jsr     ChrGot
00222Br 2  20 rr rr             jsr     BasCmdGoto              ; does not return if the line is undefined
00222Er 2                       ; Leave direct mode, exactly as the bare RUN path above does.
00222Er 2                       ; BasCmdGoto only moves TXTPTR; while CURLIN+1 is still $FF, BasNewstt
00222Er 2                       ; treats the branch target as an immediate-mode statement and returns
00222Er 2                       ; to the READY loop after it -- so `RUN 20` printed nothing at all.
00222Er 2                       ; Set after the branch, not before, so an undefined line still reports
00222Er 2                       ; `?UNDEF'D STATEMENT ERROR` with no spurious `IN 0` line number.
00222Er 2  9C 69 03             stz     BAS_CURLIN
002231r 2  9C 6A 03             stz     BAS_CURLIN+1
002234r 2  60                   rts
002235r 2               
002235r 2               ; ---------------------------------------------------------------------------
002235r 2               ; Statement: END / STOP -- save CONT context and return to REPL.
002235r 2               ; ---------------------------------------------------------------------------
002235r 2               BasCmdEnd:
002235r 2  18                   clc
002236r 2  24                   .byte   $24                     ; BIT zp -> skip next byte (sec)
002237r 2               BasCmdStop:
002237r 2  38                   sec
002238r 2                       ; Save the END/STOP flag (carry) before ChrGot clobbers it.
002238r 2  08                   php
002239r 2  20 rr rr             jsr     ChrGot
00223Cr 2  D0 57                bne     @synErrPlp
00223Er 2  28                   plp
00223Fr 2                       ; Save CONT state.
00223Fr 2  A5 04                lda     TXTPTR
002241r 2  8D 6D 03             sta     BAS_OLDTEXT
002244r 2  A5 05                lda     TXTPTR+1
002246r 2  8D 6E 03             sta     BAS_OLDTEXT+1
002249r 2  AD 69 03             lda     BAS_CURLIN
00224Cr 2  8D 6B 03             sta     BAS_OLDLIN
00224Fr 2  AD 6A 03             lda     BAS_CURLIN+1
002252r 2  8D 6C 03             sta     BAS_OLDLIN+1
002255r 2  A2 FF                ldx     #$FF
002257r 2  9A                   txs
002258r 2  90 30                bcc     @end
00225Ar 2                       ; STOP path: print "BREAK[ IN nnnn]".
00225Ar 2  20 rr rr             jsr     BasPrintCRLF
00225Dr 2  A9 rr                lda     #<MsgBreak
00225Fr 2  A0 rr                ldy     #>MsgBreak
002261r 2  20 rr rr             jsr     BasPrintStr
002264r 2  AD 6A 03             lda     BAS_CURLIN+1
002267r 2  C9 FF                cmp     #$FF
002269r 2  F0 14                beq     @endNoLine
00226Br 2  A9 rr                lda     #<MsgInWord
00226Dr 2  A0 rr                ldy     #>MsgInWord
00226Fr 2  20 rr rr             jsr     BasPrintStr
002272r 2  AD 69 03             lda     BAS_CURLIN
002275r 2  85 08                sta     BAS_LINNUM
002277r 2  AD 6A 03             lda     BAS_CURLIN+1
00227Ar 2  85 09                sta     BAS_LINNUM+1
00227Cr 2  20 rr rr             jsr     BasPrintLineNum
00227Fr 2               @endNoLine:
00227Fr 2  A9 FF                lda     #$FF
002281r 2  8D 69 03             sta     BAS_CURLIN
002284r 2  8D 6A 03             sta     BAS_CURLIN+1
002287r 2  4C rr rr             jmp     BasReadyLoop
00228Ar 2               @end:
00228Ar 2  A9 FF                lda     #$FF
00228Cr 2  8D 69 03             sta     BAS_CURLIN
00228Fr 2  8D 6A 03             sta     BAS_CURLIN+1
002292r 2  4C rr rr             jmp     BasReadyLoop
002295r 2               @synErrPlp:
002295r 2  28                   plp
002296r 2               @synErr:
002296r 2  4C rr rr             jmp     SynErr
002299r 2               
002299r 2               ; ---------------------------------------------------------------------------
002299r 2               ; Statement: CONT -- resume execution from saved OLDTEXT/OLDLIN.
002299r 2               ; ---------------------------------------------------------------------------
002299r 2               BasCmdCont:
002299r 2  20 rr rr             jsr     ChrGot
00229Cr 2  D0 21                bne     @synErr
00229Er 2  AD 6E 03             lda     BAS_OLDTEXT+1
0022A1r 2  D0 05                bne     @canCont
0022A3r 2  A2 10                ldx     #ERR_CANTCONT
0022A5r 2  4C rr rr             jmp     BasErrorVec
0022A8r 2               @canCont:
0022A8r 2  AD 6D 03             lda     BAS_OLDTEXT
0022ABr 2  85 04                sta     TXTPTR
0022ADr 2  AD 6E 03             lda     BAS_OLDTEXT+1
0022B0r 2  85 05                sta     TXTPTR+1
0022B2r 2  AD 6B 03             lda     BAS_OLDLIN
0022B5r 2  8D 69 03             sta     BAS_CURLIN
0022B8r 2  AD 6C 03             lda     BAS_OLDLIN+1
0022BBr 2  8D 6A 03             sta     BAS_CURLIN+1
0022BEr 2  60                   rts
0022BFr 2               @synErr:
0022BFr 2  4C rr rr             jmp     SynErr
0022C2r 2               
0022C2r 2               ; ---------------------------------------------------------------------------
0022C2r 2               ; Statement: RESTORE -- DATAPTR := TXTTAB - 1.
0022C2r 2               ; ---------------------------------------------------------------------------
0022C2r 2               BasCmdRestore:
0022C2r 2  38                   sec
0022C3r 2  AD 5D 03             lda     BAS_TXTTAB
0022C6r 2  E9 01                sbc     #1
0022C8r 2  8D 1A 03             sta     BAS_DATAPTR
0022CBr 2  AD 5E 03             lda     BAS_TXTTAB+1
0022CEr 2  E9 00                sbc     #0
0022D0r 2  8D 1B 03             sta     BAS_DATAPTR+1
0022D3r 2  60                   rts
0022D4r 2               
0022D4r 2               ; ---------------------------------------------------------------------------
0022D4r 2               ; Statement: INPUT [<"prompt">{,;}] var[,var,...]
0022D4r 2               ;   Prompts user for input, reads a line, parses it into the variable list.
0022D4r 2               ;   "abc";VAR  prints  abc?    (question + space appended)
0022D4r 2               ;   "abc",VAR  prints  abc      (no question mark)
0022D4r 2               ;   no prompt: prints  ?
0022D4r 2               ;   On bad numeric input or premature end-of-line: "?REDO FROM START"
0022D4r 2               ;   and reprompt.  Trailing un-consumed input: "?EXTRA IGNORED".
0022D4r 2               ; ---------------------------------------------------------------------------
0022D4r 2               BasCmdInput:
0022D4r 2                       ; INPUT is illegal in direct mode.
0022D4r 2  AD 6A 03             lda     BAS_CURLIN+1
0022D7r 2  C9 FF                cmp     #$FF
0022D9r 2  D0 05                bne     @notDirect
0022DBr 2  A2 07                ldx     #ERR_ILLDIRECT
0022DDr 2  4C rr rr             jmp     BasErrorVec
0022E0r 2               @notDirect:
0022E0r 2                       ; ChrGot returns first char after the INPUT token.
0022E0r 2  20 rr rr             jsr     ChrGot
0022E3r 2  C9 22                cmp     #'"'
0022E5r 2  D0 27                bne     @noPrompt
0022E7r 2                       ; Parse string literal & print it; FrmEvl will leave descriptor in FAC.
