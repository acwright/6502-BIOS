0009BEr 2  20 rr rr       jsr DisOpZp
0009C1r 2  A9 2C          lda #','
0009C3r 2  20 rr rr       jsr Chrout
0009C6r 2  A9 58          lda #'X'
0009C8r 2  20 rr rr       jsr Chrout
0009CBr 2  A9 29          lda #')'
