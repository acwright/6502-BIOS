0023C8r 2  84 47                sty     BAS_FORPNT+1
0023CAr 2                       ; Save program TXTPTR; switch to data side.
0023CAr 2  A5 05                lda     TXTPTR+1
0023CCr 2  48                   pha
0023CDr 2  A5 04                lda     TXTPTR
0023CFr 2  48                   pha
0023D0r 2  A5 3A                lda     BAS_TMP1
0023D2r 2  85 04                sta     TXTPTR
