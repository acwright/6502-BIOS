002488r 2               
002488r 2               ; ---------------------------------------------------------------------------
002488r 2               ; Statement: READ var[,var,...] -- pull next DATA item from BAS_DATAPTR
002488r 2               ; into the variable pointed to by PtrGet.
002488r 2               ; ---------------------------------------------------------------------------
002488r 2               ; ---------------------------------------------------------------------------
002488r 2               ; BasStrItem -- read one string item at TXTPTR into the variable BAS_FORPNT
002488r 2               ; points at.  Shared by INPUT and READ, which differ only in what ends an
002488r 2               ; unquoted item: INPUT stops at ',' or NUL, READ also stops at ':' because a
002488r 2               ; DATA statement can be followed by another statement on the same line.
002488r 2               ;
002488r 2               ; On entry : X        = the extra unquoted terminator (StrLt2's CHARAC)
002488r 2               ;            TXTPTR   = first character of the item
002488r 2               ;            FORPNT   = the variable's 3-byte descriptor slot
002488r 2               ; On exit  : TXTPTR advanced past the item, descriptor stored, temp popped.
002488r 2               ; ---------------------------------------------------------------------------
002488r 2               BasStrItem:
002488r 2                       ; A '"' here means quote-mode (terminator '"' or NUL); anything else
002488r 2                       ; is a bare item running to X, ',' or NUL.
002488r 2  A0 00                ldy     #0
00248Ar 2  B1 04                lda     (TXTPTR),y
00248Cr 2  C9 22                cmp     #'"'
00248Er 2  F0 0C                beq     @quoted
002490r 2  86 44                stx     CHARAC
002492r 2  A9 2C                lda     #','
002494r 2  85 6A                sta     ENDCHR
002496r 2  A5 04                lda     TXTPTR                  ; StrLt2's source = TXTPTR
002498r 2  A4 05                ldy     TXTPTR+1
00249Ar 2  80 0E                bra     @call
00249Cr 2               @quoted:
00249Cr 2  85 44                sta     CHARAC                  ; A is still '"' from the compare
00249Er 2  85 6A                sta     ENDCHR
0024A0r 2  18                   clc                             ; skip it: source = TXTPTR + 1
0024A1r 2  A5 04                lda     TXTPTR
0024A3r 2  69 01                adc     #1
0024A5r 2  A4 05                ldy     TXTPTR+1
0024A7r 2  90 01                bcc     @call
0024A9r 2  C8                   iny
0024AAr 2               @call:
0024AAr 2  20 rr rr             jsr     StrLt2
0024ADr 2                       ; StrLt2 leaves STRNG2 past the text it consumed -- at the terminator
0024ADr 2                       ; for an unquoted item, just past the closing '"' for a quoted one.
0024ADr 2                       ; TXTPTR has to follow it: for INPUT so the trailing-extra check sees
0024ADr 2                       ; only what really remained on the line, and for READ so the next one
0024ADr 2                       ; doesn't start again in the middle of the item this one took.
0024ADr 2  A5 1E                lda     STRNG2
0024AFr 2  85 04                sta     TXTPTR
0024B1r 2  A5 1F                lda     STRNG2+1
0024B3r 2  85 05                sta     TXTPTR+1
0024B5r 2  A0 00                ldy     #0
0024B7r 2  A5 0E                lda     FAC
0024B9r 2  91 46                sta     (BAS_FORPNT),y
0024BBr 2  C8                   iny
0024BCr 2  A5 0F                lda     FAC+1
0024BEr 2  91 46                sta     (BAS_FORPNT),y
0024C0r 2  C8                   iny
0024C1r 2  A5 10                lda     FAC+2
0024C3r 2  91 46                sta     (BAS_FORPNT),y
0024C5r 2                       ; StrLt2 pushed a temporary descriptor via PutNew.  The variable owns
0024C5r 2                       ; the heap copy now, so pop the temp -- do NOT use FreFac, which would
0024C5r 2                       ; reclaim the heap we just handed over.  Leaving temps unfreed leaks
0024C5r 2                       ; the 3-slot temp stack, both overflowing it (?FORMULA TOO COMPLEX)
0024C5r 2                       ; and corrupting later strings via stale descriptor pointers.
0024C5r 2  A5 11                lda     FAC+3
0024C7r 2  A4 12                ldy     FAC+4
0024C9r 2  4C rr rr             jmp     FreTms
0024CCr 2               
0024CCr 2               BasCmdRead:
0024CCr 2  AE 1A 03             ldx     BAS_DATAPTR
0024CFr 2  AC 1B 03             ldy     BAS_DATAPTR+1
0024D2r 2  A9 98                lda     #$98                    ; INPUTFLG = $98 means READ mode
0024D4r 2  2C                   .byte   $2C
0024D5r 2               BasInpDoit:
0024D5r 2  A9 00                lda     #0
0024D7r 2  85 69                sta     BAS_INPUTFLG
0024D9r 2  86 3A                stx     BAS_TMP1                ; TMP1 = data pointer
0024DBr 2  84 3B                sty     BAS_TMP1+1
0024DDr 2               @nextVar:
0024DDr 2                       ; TXTPTR currently points into program at variable name.
0024DDr 2  20 rr rr             jsr     PtrGet                  ; advances TXTPTR past var name
0024E0r 2  85 46                sta     BAS_FORPNT
0024E2r 2  84 47                sty     BAS_FORPNT+1
0024E4r 2                       ; Save program TXTPTR on hw stack, switch TXTPTR to data ptr.
0024E4r 2  A5 05                lda     TXTPTR+1
0024E6r 2  48                   pha
0024E7r 2  A5 04                lda     TXTPTR
0024E9r 2  48                   pha
0024EAr 2  A5 3A                lda     BAS_TMP1
0024ECr 2  85 04                sta     TXTPTR
0024EEr 2  A5 3B                lda     BAS_TMP1+1
0024F0r 2  85 05                sta     TXTPTR+1
0024F2r 2  20 rr rr             jsr     ChrGot
0024F5r 2  D0 08                bne     @gotData
0024F7r 2                       ; Out of items on this line - find next DATA.
0024F7r 2  20 rr rr             jsr     BasFindData
0024FAr 2  90 03                bcc     @gotData
0024FCr 2  4C rr rr             jmp     @oodata
0024FFr 2               @gotData:
0024FFr 2                       ; Advance past separator (',' between items, ' ' after DATA token,
0024FFr 2                       ; or quote-delimiter for strings).  ChrGet also skips spaces.
0024FFr 2  20 rr rr             jsr     ChrGet
002502r 2                       ; Parse value at TXTPTR (data side).
002502r 2  24 64                bit     VALTYP
002504r 2  30 0C                bmi     @readStr
002506r 2                       ; Numeric.
002506r 2  20 rr rr             jsr     Fin
002509r 2  A6 46                ldx     BAS_FORPNT
00250Br 2  A4 47                ldy     BAS_FORPNT+1
00250Dr 2  20 rr rr             jsr     StoreFacAtYxRounded
002510r 2  80 05                bra     @afterStore
002512r 2               @readStr:
002512r 2                       ; Previously this called StrLt2 without setting up its (A,Y) source
002512r 2                       ; argument at all, so every DATA string pointed into zero page: an
002512r 2                       ; unquoted item read back empty and a quoted one read back as garbage
002512r 2                       ; from $0022.  BasStrItem is INPUT's path, which had it right.
002512r 2  A2 3A                ldx     #':'                    ; a DATA item also ends at a statement break
002514r 2  20 rr rr             jsr     BasStrItem
002517r 2               @afterStore:
002517r 2                       ; Save updated data ptr.
002517r 2  A5 04                lda     TXTPTR
002519r 2  85 3A                sta     BAS_TMP1
00251Br 2  A5 05                lda     TXTPTR+1
00251Dr 2  85 3B                sta     BAS_TMP1+1
00251Fr 2                       ; Restore program TXTPTR.
00251Fr 2  68                   pla
002520r 2  85 04                sta     TXTPTR
002522r 2  68                   pla
002523r 2  85 05                sta     TXTPTR+1
002525r 2                       ; If next program byte is ',', another variable follows.
002525r 2  20 rr rr             jsr     ChrGot
002528r 2  C9 2C                cmp     #','
00252Ar 2  D0 05                bne     @done
00252Cr 2  20 rr rr             jsr     ChrGet
00252Fr 2  80 AC                bra     @nextVar
002531r 2               @done:
002531r 2                       ; Persist data ptr.
002531r 2  A5 3A                lda     BAS_TMP1
002533r 2  8D 1A 03             sta     BAS_DATAPTR
002536r 2  A5 3B                lda     BAS_TMP1+1
002538r 2  8D 1B 03             sta     BAS_DATAPTR+1
00253Br 2  60                   rts
00253Cr 2               @oodata:
00253Cr 2  A2 0E                ldx     #ERR_OD
00253Er 2  4C rr rr             jmp     BasErrorVec
002541r 2               
002541r 2               ; ---------------------------------------------------------------------------
002541r 2               ; BasFindData -- starting from TXTPTR (positioned somewhere within a line's
002541r 2               ; payload), advance to the byte after the next DATA token in the program.
002541r 2               ; Returns carry SET on out-of-data, carry CLEAR with TXTPTR at first byte
002541r 2               ; AFTER the DATA token (i.e. at the first DATA item).
002541r 2               ; ---------------------------------------------------------------------------
002541r 2               BasFindData:
002541r 2               @scanByte:
002541r 2  A0 00                ldy     #0
002543r 2  B1 04                lda     (TXTPTR),y
002545r 2  F0 1F                beq     @atEnd
002547r 2  C9 83                cmp     #TOK_DATA
002549r 2  F0 2E                beq     @found
00254Br 2  C9 22                cmp     #'"'
00254Dr 2  D0 12                bne     @advance1
00254Fr 2                       ; Skip quoted string (advance TXTPTR past closing quote or NUL).
00254Fr 2  20 rr rr             jsr     @incTxt
002552r 2               @inStr:
002552r 2  A0 00                ldy     #0
002554r 2  B1 04                lda     (TXTPTR),y
002556r 2  F0 0E                beq     @atEnd
002558r 2  20 rr rr             jsr     @incTxt
00255Br 2  C9 22                cmp     #'"'
00255Dr 2  D0 F3                bne     @inStr
00255Fr 2  80 E0                bra     @scanByte
002561r 2               @advance1:
002561r 2  20 rr rr             jsr     @incTxt
002564r 2  80 DB                bra     @scanByte
002566r 2               @atEnd:
002566r 2                       ; (TXTPTR) is on the line's $00 terminator.  Bytes immediately after
002566r 2                       ; are the next line's [next-lo][next-hi][num-lo][num-hi][payload..].
002566r 2                       ; Check next-pointer at offset +2 (next-hi); if 0, end of program.
002566r 2  A0 02                ldy     #2
002568r 2  B1 04                lda     (TXTPTR),y
00256Ar 2  F0 0F                beq     @oodata
00256Cr 2                       ; Advance TXTPTR by 5: past terminator (1) + line header (4).
00256Cr 2  18                   clc
00256Dr 2  A5 04                lda     TXTPTR
00256Fr 2  69 05                adc     #5
002571r 2  85 04                sta     TXTPTR
002573r 2  90 CC                bcc     @scanByte
002575r 2  E6 05                inc     TXTPTR+1
002577r 2  80 C8                bra     @scanByte
002579r 2               @found:
002579r 2                       ; TXTPTR is left AT the TOK_DATA byte; caller's CHRGET advances past.
002579r 2  18                   clc
00257Ar 2  60                   rts
00257Br 2               @oodata:
00257Br 2  38                   sec
00257Cr 2  60                   rts
00257Dr 2               @incTxt:
00257Dr 2  E6 04                inc     TXTPTR
00257Fr 2  D0 02                bne     @r
002581r 2  E6 05                inc     TXTPTR+1
002583r 2               @r:
002583r 2  60                   rts
002584r 2               
002584r 2               ; ---------------------------------------------------------------------------
002584r 2               ; Statement: FOR var = expr1 TO expr2 [STEP expr3]
002584r 2               ; Pushes 18-byte frame on CPU stack:
002584r 2               ;   [tag $81][VAR-lo][VAR-hi][STEP-FP (5)][STEP-sign][CURLIN-lo][CURLIN-hi]
002584r 2               ;   [TXTPTR-lo][TXTPTR-hi][LIMIT-FP (5)]
002584r 2               ; ---------------------------------------------------------------------------
002584r 2               BasCmdFor:
002584r 2                       ; Set SUBFLG so PtrGet doesn't recurse on FN.
002584r 2  A9 80                lda     #$80
002586r 2  85 68                sta     SUBFLG
002588r 2  20 rr rr             jsr     BasCmdLet               ; consumes "var = expr"
00258Br 2                       ; PtrGet (inside LET) saved VARPNT in FORPNT (hopefully). Re-fetch
00258Br 2                       ; FORPNT from the assignment, but BasCmdLet doesn't set FORPNT in
00258Br 2                       ; our impl.  Re-parse the variable name by rewinding TXTPTR via
00258Br 2                       ; CURLIN scan.  Cheat: BasCmdLet leaves VARPNT current.
00258Br 2  A5 3F                lda     VARPNT
00258Dr 2  85 46                sta     BAS_FORPNT
00258Fr 2  A5 40                lda     VARPNT+1
002591r 2  85 47                sta     BAS_FORPNT+1
002593r 2                       ; Discard any prior FOR frame for the same variable to avoid leak.
002593r 2  20 rr rr             jsr     GtForPnt
002596r 2  90 00                bcc     @noOld                  ; carry clear -> no matching frame
002598r 2                       ; The prior-frame pop is still skipped: the runtime tolerates one stray
002598r 2                       ; frame, and msbasic re-uses the slot only when an explicit FOR with a
002598r 2                       ; matching variable already exists, which is rare. GtForPnt does now
002598r 2                       ; report found/not-found in carry (Z was ambiguous and unusable), so
002598r 2                       ; this branch is at least honest about which case it is in.
002598r 2               @noOld:
002598r 2                       ; Discard our caller's (BasExecuteStatement's) return address so
002598r 2                       ; that the FOR frame sits on the stack with no other junk above it.
002598r 2                       ; We will JMP BasNewstt at the end instead of RTSing.
002598r 2  68                   pla
002599r 2  68                   pla
00259Ar 2                       ; Push limit (will be parsed below) -- we lay out the frame as:
00259Ar 2                       ;   pushed first (deepest): TXTPTR, CURLIN, LIMIT (5), STEP-sign,
00259Ar 2                       ;   STEP (5), VAR-addr, $81-tag.
00259Ar 2                       ; We don't know LIMIT/STEP yet; we push placeholders and patch.
00259Ar 2                       ; Easier: parse limit & step first, then push frame in one go.
00259Ar 2  A9 9C                lda     #TOK_TO
00259Cr 2  20 rr rr             jsr     SynChr
00259Fr 2  20 rr rr             jsr     FrmNum
0025A2r 2                       ; Strip sign info on limit (msbasic stores limit unsigned-magnitude
0025A2r 2                       ; with sign packed).  Pack FACSIGN bit 7 -> FAC+1 bit 7.
0025A2r 2  A5 13                lda     FACSIGN
0025A4r 2  09 7F                ora     #$7F
0025A6r 2  25 0F                and     FAC+1
0025A8r 2  85 0F                sta     FAC+1
0025AAr 2                       ; Save LIMIT temporarily in BAS_TEMP1..+4 (5 bytes).
0025AAr 2  A2 04                ldx     #4
0025ACr 2               @saveLimit:
0025ACr 2  B5 0E                lda     FAC,x
0025AEr 2  95 4D                sta     BAS_TEMP1,x
0025B0r 2  CA                   dex
0025B1r 2  10 F9                bpl     @saveLimit
0025B3r 2                       ; STEP: default 1, or evaluate after TOK_STEP.
0025B3r 2  20 rr rr             jsr     ChrGot
0025B6r 2  C9 A1                cmp     #TOK_STEP
0025B8r 2  D0 08                bne     @defStep
0025BAr 2  20 rr rr             jsr     ChrGet
0025BDr 2  20 rr rr             jsr     FrmNum
0025C0r 2  80 07                bra     @gotStep
0025C2r 2               @defStep:
0025C2r 2  A9 rr                lda     #<ConstOne
0025C4r 2  A0 rr                ldy     #>ConstOne
0025C6r 2  20 rr rr             jsr     LoadFacFromYa
0025C9r 2               @gotStep:
0025C9r 2  20 rr rr             jsr     Sign                    ; A = step sign byte (-1/0/1)
0025CCr 2  85 52                sta     BAS_TEMP2               ; stash step sign
0025CEr 2                       ; Pack sign of FAC into FAC+1 bit7 then save STEP into BAS_TEMP2+1..+5.
0025CEr 2  A5 13                lda     FACSIGN
0025D0r 2  09 7F                ora     #$7F
0025D2r 2  25 0F                and     FAC+1
0025D4r 2  85 0F                sta     FAC+1
0025D6r 2  A2 04                ldx     #4
0025D8r 2               @saveStep:
0025D8r 2  B5 0E                lda     FAC,x
0025DAr 2  95 53                sta     BAS_TEMP2+1,x
0025DCr 2  CA                   dex
0025DDr 2  10 F9                bpl     @saveStep
0025DFr 2                       ; Now push the frame on stack (deepest first):
0025DFr 2                       ;   TXTPTR-hi, TXTPTR-lo, CURLIN-hi, CURLIN-lo,
0025DFr 2                       ;   LIMIT[4..0]   (deepest=LIMIT[4], so LIMIT[0] ends at $010A,x),
0025DFr 2                       ;   STEP-sign,
0025DFr 2                       ;   STEP[4..0]    (deepest=STEP[4], so STEP[0]  ends at $0104,x),
0025DFr 2                       ;   VAR-hi, VAR-lo, $81
0025DFr 2  A5 05                lda     TXTPTR+1
0025E1r 2  48                   pha
0025E2r 2  A5 04                lda     TXTPTR
0025E4r 2  48                   pha
0025E5r 2  AD 6A 03             lda     BAS_CURLIN+1
0025E8r 2  48                   pha
0025E9r 2  AD 69 03             lda     BAS_CURLIN
0025ECr 2  48                   pha
0025EDr 2  A2 04                ldx     #4
0025EFr 2               @pushLim:
0025EFr 2  B5 4D                lda     BAS_TEMP1,x
0025F1r 2  48                   pha
0025F2r 2  CA                   dex
0025F3r 2  10 FA                bpl     @pushLim
0025F5r 2  A5 52                lda     BAS_TEMP2               ; step sign
0025F7r 2  48                   pha
0025F8r 2  A2 05                ldx     #5
0025FAr 2               @pushStep:
0025FAr 2  B5 52                lda     BAS_TEMP2,x
0025FCr 2  48                   pha
0025FDr 2  CA                   dex
0025FEr 2  D0 FA                bne     @pushStep
002600r 2  A5 47                lda     BAS_FORPNT+1
002602r 2  48                   pha
002603r 2  A5 46                lda     BAS_FORPNT
002605r 2  48                   pha
002606r 2  A9 81                lda     #TOK_FOR
002608r 2  48                   pha
002609r 2  4C rr rr             jmp     BasNewstt               ; resume statement loop with frame in place
00260Cr 2               
00260Cr 2               ConstOne:
00260Cr 2  81 00 00 00          .byte   $81,$00,$00,$00,$00     ; FP +1.0
002610r 2  00           
002611r 2               
002611r 2               ; ---------------------------------------------------------------------------
002611r 2               ; Statement: NEXT [var]
002611r 2               ; Locate matching FOR frame, increment var by step, test against limit,
002611r 2               ; loop back if more iterations remain, else discard frame and continue.
002611r 2               ; ---------------------------------------------------------------------------
002611r 2               BasCmdNext:
002611r 2  20 rr rr             jsr     ChrGot
002614r 2  F0 0D                beq     @anyVar
002616r 2  C9 3A                cmp     #':'
002618r 2  F0 09                beq     @anyVar
00261Ar 2  20 rr rr             jsr     PtrGet
00261Dr 2  85 46                sta     BAS_FORPNT
00261Fr 2  84 47                sty     BAS_FORPNT+1
002621r 2  80 06                bra     @find
002623r 2               @anyVar:
002623r 2                       ; "NEXT" without a variable: set FORPNT = 0 so GtForPnt copies the
002623r 2                       ; stack-frame's var address into FORPNT and then trivially matches
002623r 2                       ; (any FOR frame is acceptable).
002623r 2  A9 00                lda     #0
002625r 2  85 46                sta     BAS_FORPNT
002627r 2  85 47                sta     BAS_FORPNT+1
002629r 2               @find:
002629r 2                       ; Carry, not Z: GtForPnt's not-found paths end in `lda #0`, which sets
002629r 2                       ; Z, so testing `beq` here read "no frame" as "found" -- a bare NEXT
002629r 2                       ; then did `txs` onto a garbage offset and died as ?SYNTAX ERROR IN 0
002629r 2                       ; instead of ?NEXT WITHOUT FOR.
002629r 2  20 rr rr             jsr     GtForPnt
00262Cr 2  B0 05                bcs     @found
00262Er 2  A2 0D                ldx     #ERR_NF
002630r 2  4C rr rr             jmp     BasErrorVec
002633r 2               @found:
002633r 2                       ; X = stack offset of (tag - 1).  txs makes SP = X so the frame
002633r 2                       ; sits at $101+X..$112+X.  All subsequent accesses use $0101+offset,x
002633r 2                       ; just like msbasic.
002633r 2  9A                   txs
002634r 2                       ; Frame layout (tag at $0101+X):
002634r 2                       ;   $0101+X = $81 tag
002634r 2                       ;   $0102+X = VAR-lo
002634r 2                       ;   $0103+X = VAR-hi
002634r 2                       ;   $0104+X..$0108+X = STEP (5 bytes FP, FAC[0..4] ascending)
002634r 2                       ;   $0109+X = STEP-sign
002634r 2                       ;   $010A+X..$010E+X = LIMIT (5 bytes FP, FAC[0..4] ascending)
002634r 2                       ;   $010F+X = CURLIN-lo
002634r 2                       ;   $0110+X = CURLIN-hi
002634r 2                       ;   $0111+X = TXTPTR-lo
002634r 2                       ;   $0112+X = TXTPTR-hi
002634r 2                       ; Load STEP into FAC.
002634r 2  A9 01                lda     #$01
002636r 2  85 3B                sta     BAS_TMP1+1
002638r 2  8A                   txa
002639r 2  18                   clc
00263Ar 2  69 04                adc     #$04
00263Cr 2  85 3A                sta     BAS_TMP1                ; TMP1 -> STEP[0] at $0104,x
00263Er 2  A5 3A                lda     BAS_TMP1
002640r 2  A4 3B                ldy     BAS_TMP1+1
002642r 2  20 rr rr             jsr     LoadFacFromYa
002645r 2                       ; FACSIGN := step sign byte at $0109,x.
002645r 2  BD 09 01             lda     $0109,x
002648r 2  85 13                sta     FACSIGN
00264Ar 2                       ; FAC += variable.
00264Ar 2  BD 02 01             lda     $0102,x
00264Dr 2  BC 03 01             ldy     $0103,x
002650r 2  85 46                sta     BAS_FORPNT
002652r 2  84 47                sty     BAS_FORPNT+1
002654r 2  20 rr rr             jsr     FAdd
002657r 2  20 rr rr             jsr     SetFor
00265Ar 2                       ; Compare FAC with LIMIT (at $010A,x).
00265Ar 2  BA                   tsx                             ; reload x (FAdd may have used it)
00265Br 2  8A                   txa
00265Cr 2  18                   clc
00265Dr 2  69 0A                adc     #$0A
00265Fr 2  85 3A                sta     BAS_TMP1
002661r 2  A9 01                lda     #$01
002663r 2  85 3B                sta     BAS_TMP1+1
002665r 2  A5 3A                lda     BAS_TMP1
002667r 2  A4 3B                ldy     BAS_TMP1+1
002669r 2  20 rr rr             jsr     FComp
00266Cr 2  BA                   tsx
00266Dr 2  38                   sec
00266Er 2  FD 09 01             sbc     $0109,x                 ; A - step-sign
002671r 2  F0 19                beq     @loopDone
002673r 2                       ; Continue: restore CURLIN/TXTPTR from frame, JMP NEWSTT (don't RTS).
002673r 2  BD 0F 01             lda     $010F,x
002676r 2  8D 69 03             sta     BAS_CURLIN
002679r 2  BD 10 01             lda     $0110,x
00267Cr 2  8D 6A 03             sta     BAS_CURLIN+1
00267Fr 2  BD 11 01             lda     $0111,x
002682r 2  85 04                sta     TXTPTR
002684r 2  BD 12 01             lda     $0112,x
002687r 2  85 05                sta     TXTPTR+1
002689r 2  4C rr rr             jmp     BasNewstt
00268Cr 2               @loopDone:
00268Cr 2                       ; Discard frame: SP := X + 18.
00268Cr 2  8A                   txa
00268Dr 2  18                   clc
00268Er 2  69 12                adc     #18
002690r 2  AA                   tax
002691r 2  9A                   txs
002692r 2                       ; Allow ", var" to chain into another NEXT.
002692r 2  20 rr rr             jsr     ChrGot
002695r 2  C9 2C                cmp     #','
002697r 2  D0 06                bne     @retNewstt
002699r 2  20 rr rr             jsr     ChrGet
00269Cr 2  4C rr rr             jmp     BasCmdNext
00269Fr 2               @retNewstt:
00269Fr 2  4C rr rr             jmp     BasNewstt
0026A2r 2               
0026A2r 2               ; ---------------------------------------------------------------------------
0026A2r 2               ; Statement: DEF FN A(X) = expr
0026A2r 2               ; Stored in the variable's 5 value bytes:
0026A2r 2               ;   [TXTPTR-of-expr-lo][TXTPTR-of-expr-hi][param-name-lo][param-name-hi][0]
0026A2r 2               ; ---------------------------------------------------------------------------
0026A2r 2               BasCmdDef:
0026A2r 2                       ; Expect: FN <name>(<param>) = <expr>
0026A2r 2  A9 9D                lda     #TOK_FN
0026A4r 2  20 rr rr             jsr     SynChr
0026A7r 2  09 80                ora     #$80
0026A9r 2  85 68                sta     SUBFLG                  ; tell PtrGet "this is a DEF FN var"
0026ABr 2  20 rr rr             jsr     PtrGet
0026AEr 2                       ; VARPNT = address of FN var slot.
0026AEr 2  85 81                sta     BAS_FNCNAM
0026B0r 2  84 82                sty     BAS_FNCNAM+1
0026B2r 2  20 rr rr             jsr     ChkNum
0026B5r 2                       ; Expect '(' name ')' = expr
0026B5r 2                       ; Param name parsed by recursive PtrGet inside FrmEvl on call;
0026B5r 2                       ; here we just record (param-name) by parsing it ourselves.
0026B5r 2  A9 28                lda     #'('
0026B7r 2  20 rr rr             jsr     SynChr
0026BAr 2  A9 80                lda     #$80
0026BCr 2  85 68                sta     SUBFLG
0026BEr 2  20 rr rr             jsr     PtrGet
0026C1r 2                       ; VARPNT = param var addr.  Save it.
0026C1r 2  A5 3F                lda     VARPNT
0026C3r 2  85 3A                sta     BAS_TMP1
0026C5r 2  A5 40                lda     VARPNT+1
0026C7r 2  85 3B                sta     BAS_TMP1+1
0026C9r 2  20 rr rr             jsr     ChkNum
0026CCr 2  A9 29                lda     #')'
0026CEr 2  20 rr rr             jsr     SynChr
0026D1r 2  A9 3D                lda     #'='
0026D3r 2  20 rr rr             jsr     SynChr
0026D6r 2                       ; Reject in direct mode.
0026D6r 2  AD 6A 03             lda     BAS_CURLIN+1
0026D9r 2  C9 FF                cmp     #$FF
0026DBr 2  D0 05                bne     @ok
0026DDr 2  A2 07                ldx     #ERR_ILLDIRECT
0026DFr 2  4C rr rr             jmp     BasErrorVec
0026E2r 2               @ok:
0026E2r 2                       ; Store [TXTPTR][param][0] in FN var.
0026E2r 2  A0 00                ldy     #0
0026E4r 2  A5 04                lda     TXTPTR
0026E6r 2  91 81                sta     (BAS_FNCNAM),y
0026E8r 2  C8                   iny
0026E9r 2  A5 05                lda     TXTPTR+1
0026EBr 2  91 81                sta     (BAS_FNCNAM),y
0026EDr 2  C8                   iny
0026EEr 2  A5 3A                lda     BAS_TMP1
0026F0r 2  91 81                sta     (BAS_FNCNAM),y
0026F2r 2  C8                   iny
0026F3r 2  A5 3B                lda     BAS_TMP1+1
0026F5r 2  91 81                sta     (BAS_FNCNAM),y
0026F7r 2  C8                   iny
0026F8r 2  A9 00                lda     #0
0026FAr 2  91 81                sta     (BAS_FNCNAM),y
0026FCr 2                       ; Skip past expression body.
0026FCr 2  20 rr rr             jsr     BasDatan
0026FFr 2  4C rr rr             jmp     BasAddon
002702r 2               
002702r 2               ; ---------------------------------------------------------------------------
002702r 2               ; FnCall -- evaluator-side handler for "FN A(expr)".
002702r 2               ; Called by FrmEvl when it sees TOK_FN.  Evaluates argument, swaps in the
002702r 2               ; param's stored value, executes the FN expression, and restores the param.
002702r 2               ; ---------------------------------------------------------------------------
002702r 2               FnCall:
002702r 2  20 rr rr             jsr     ChrGet                  ; consume FN
002705r 2  09 80                ora     #$80
002707r 2  85 68                sta     SUBFLG
002709r 2  20 rr rr             jsr     PtrGet                  ; locate FN var
00270Cr 2  8D 73 03             sta     BAS_FNPTR               ; durable copy: FNCNAM lives in ZP and
00270Fr 2  8C 74 03             sty     BAS_FNPTR+1             ; is scratch for Garbag
002712r 2  85 81                sta     BAS_FNCNAM
002714r 2  84 82                sty     BAS_FNCNAM+1
002716r 2  20 rr rr             jsr     ChkNum
002719r 2                       ; Read param ptr from FN slot.
002719r 2  A0 02                ldy     #2
00271Br 2  B1 81                lda     (BAS_FNCNAM),y
00271Dr 2  85 3F                sta     VARPNT
00271Fr 2  F0 57                beq     @undef
002721r 2  C8                   iny
002722r 2  B1 81                lda     (BAS_FNCNAM),y
002724r 2  85 40                sta     VARPNT+1
002726r 2                       ; Evaluate '(arg)'
002726r 2  A9 28                lda     #'('
002728r 2  20 rr rr             jsr     SynChr
00272Br 2                       ; Save param's current FP value (5 bytes) on stack.
00272Br 2  A0 04                ldy     #4
00272Dr 2               @savep:
00272Dr 2  B1 3F                lda     (VARPNT),y
00272Fr 2  48                   pha
002730r 2  88                   dey
002731r 2  10 FA                bpl     @savep
002733r 2                       ; Evaluate argument -> FAC.
002733r 2  20 rr rr             jsr     FrmNum
002736r 2  A9 29                lda     #')'
002738r 2  20 rr rr             jsr     SynChr
00273Br 2                       ; Any variable reference in the argument re-pointed VARPNT (and Garbag
00273Br 2                       ; may have eaten FNCNAM) — reload both before storing the argument.
00273Br 2  20 rr rr             jsr     @reload
00273Er 2                       ; Store FAC into param slot.
00273Er 2  A6 3F                ldx     VARPNT
002740r 2  A4 40                ldy     VARPNT+1
002742r 2  20 rr rr             jsr     StoreFacAtYxRounded
002745r 2                       ; Save current TXTPTR.
002745r 2  A5 05                lda     TXTPTR+1
002747r 2  48                   pha
002748r 2  A5 04                lda     TXTPTR
00274Ar 2  48                   pha
00274Br 2                       ; Switch TXTPTR to FN expression body.
00274Br 2  A0 00                ldy     #0
00274Dr 2  B1 81                lda     (BAS_FNCNAM),y
00274Fr 2  85 04                sta     TXTPTR
002751r 2  C8                   iny
002752r 2  B1 81                lda     (BAS_FNCNAM),y
002754r 2  85 05                sta     TXTPTR+1
002756r 2                       ; Body TXTPTR is positioned at the first byte; we need it positioned
002756r 2                       ; one BEFORE so FrmNum's first ChrGet loads the first byte.  Decrement.
002756r 2  A5 04                lda     TXTPTR
002758r 2  D0 02                bne     @noBor
00275Ar 2  C6 05                dec     TXTPTR+1
00275Cr 2               @noBor:
00275Cr 2  C6 04                dec     TXTPTR
00275Er 2                       ; Evaluate the FN expression body.
00275Er 2  20 rr rr             jsr     ChrGet
002761r 2  20 rr rr             jsr     FrmNum
002764r 2                       ; Restore TXTPTR.
002764r 2  68                   pla
002765r 2  85 04                sta     TXTPTR
002767r 2  68                   pla
002768r 2  85 05                sta     TXTPTR+1
00276Ar 2                       ; Restore param.  VARPNT may have been clobbered; reload.
00276Ar 2  20 rr rr             jsr     @reload
00276Dr 2  A0 00                ldy     #0
00276Fr 2               @restp:
00276Fr 2  68                   pla
002770r 2  91 3F                sta     (VARPNT),y
002772r 2  C8                   iny
002773r 2  C0 05                cpy     #5
002775r 2  D0 F8                bne     @restp
002777r 2  60                   rts
002778r 2               @undef:
002778r 2  A2 03                ldx     #ERR_UNDEFSTMT
00277Ar 2  4C rr rr             jmp     BasErrorVec
00277Dr 2               ; Re-seed FNCNAM from BAS_FNPTR and VARPNT from the FN slot's param pointer.
00277Dr 2               ; Preserves FAC (touches A and Y only).
00277Dr 2               @reload:
00277Dr 2  AD 73 03             lda     BAS_FNPTR
002780r 2  85 81                sta     BAS_FNCNAM
002782r 2  AD 74 03             lda     BAS_FNPTR+1
002785r 2  85 82                sta     BAS_FNCNAM+1
002787r 2  A0 02                ldy     #2
002789r 2  B1 81                lda     (BAS_FNCNAM),y
00278Br 2  85 3F                sta     VARPNT
00278Dr 2  C8                   iny
00278Er 2  B1 81                lda     (BAS_FNCNAM),y
002790r 2  85 40                sta     VARPNT+1
002792r 2  60                   rts
002793r 2               
002793r 2               ; ---------------------------------------------------------------------------
002793r 2               ; BasCmdDim -- DIM statement.  Dimension one or more arrays.
002793r 2               ;   On entry ChrGet has advanced past the DIM token, so A = first char of the
002793r 2               ;   first variable name.  For each name we call PtrGet2 with the from-DIM flag
002793r 2               ;   ($40) set in X; the '(' branch runs Array -> MakeNewArray, which allocates
002793r 2               ;   the array using the subscripts as sizes (0..N) and returns without looking
002793r 2               ;   up an element (DIMFLG nonzero).  Names are separated by commas.
002793r 2               ; ---------------------------------------------------------------------------
002793r 2               BasCmdDim:
002793r 2  A2 40                ldx     #$40                    ; from-DIM flag (bit 6)
002795r 2  20 rr rr             jsr     PtrGet2                 ; A = name char; create/dimension array
002798r 2  20 rr rr             jsr     ChrGot
00279Br 2  C9 2C                cmp     #','
00279Dr 2  D0 05                bne     @done
00279Fr 2  20 rr rr             jsr     ChrGet                  ; consume comma, advance to next name
0027A2r 2  80 EF                bra     BasCmdDim
0027A4r 2               @done:
0027A4r 2  60                   rts
0027A5r 2               
0027A5r 2               ; ===========================================================================
0027A5r 2               ;   H A R D W A R E - E X T E N S I O N   S T A T E M E N T S
0027A5r 2               ; ===========================================================================
0027A5r 2               
0027A5r 2               ; --- Helpers --------------------------------------------------------------
0027A5r 2               
0027A5r 2               ; Raise ?NO DEVICE error.
0027A5r 2               NoDevErr:
0027A5r 2  A2 0F                ldx     #ERR_NODEV
0027A7r 2  4C rr rr             jmp     BasErrorVec
0027AAr 2               
0027AAr 2               ; Require A bits in HW_PRESENT (else ?NO DEVICE).
0027AAr 2               ;   Input : A = mask
0027AAr 2               ;   Output: A preserved on success
0027AAr 2               ReqHw:
0027AAr 2  2D 0D 03             and     HW_PRESENT
0027ADr 2  F0 F6                beq     NoDevErr
0027AFr 2  60                   rts
0027B0r 2               
0027B0r 2               ; Evaluate expression -> A in 0..255.
0027B0r 2               ;   On entry: ChrGot positioned at first byte of expression.
0027B0r 2               ;   On exit : A = byte, ChrGot returns char following expression.
0027B0r 2               EvalU8:
0027B0r 2  20 rr rr             jsr     GetByt                  ; X = byte, jmp ChrGot
0027B3r 2  8A                   txa
0027B4r 2  60                   rts
0027B5r 2               
0027B5r 2               ; Evaluate expression as 16-bit signed -> FAC+3 (hi), FAC+4 (lo).
0027B5r 2               EvalU16:
0027B5r 2  20 rr rr             jsr     FrmNum
0027B8r 2  20 rr rr             jsr     AyInt
0027BBr 2  4C rr rr             jmp     ChrGot
0027BEr 2               
0027BEr 2               ; Evaluate expression as 16-bit unsigned address (0..65535)
0027BEr 2               ;   -> FAC+3 (hi), FAC+4 (lo).  Used by SYS, POKE, PEEK, WAIT so the full
0027BEr 2               ;   6502 address space is reachable with positive decimal literals.
0027BEr 2               ;   Truncates fractional part.  Negative or >= 65536 raises ?ILLEGAL QUANTITY.
0027BEr 2               EvalAddrU16:
0027BEr 2  20 rr rr             jsr     FrmNum
0027C1r 2  20 rr rr             jsr     FacToU16
0027C4r 2  4C rr rr             jmp     ChrGot
0027C7r 2               
0027C7r 2               ; FacToU16 -- Convert FAC (must be 0..65535) to FAC+3 (hi), FAC+4 (lo).
0027C7r 2               ;   Negative or >= 65536 raises ?ILLEGAL QUANTITY.  Truncates fractional part.
0027C7r 2               FacToU16:
0027C7r 2  24 13                bit     FACSIGN
0027C9r 2  30 34                bmi     @illqty
0027CBr 2  A5 0E                lda     FAC                     ; exponent byte (0 = value is zero)
0027CDr 2  F0 2B                beq     @zero
0027CFr 2  C9 91                cmp     #$91                    ; exp >= $91 means value >= 65536
0027D1r 2  B0 2C                bcs     @illqty
0027D3r 2                       ; Reconstruct top 16 bits of mantissa (with hidden 1 bit).
0027D3r 2  48                   pha                             ; save exponent byte
0027D4r 2  A5 0F                lda     FAC+1
0027D6r 2  09 80                ora     #$80                    ; restore hidden bit
0027D8r 2  85 3B                sta     BAS_TMP1+1              ; hi
0027DAr 2  A5 10                lda     FAC+2
0027DCr 2  85 3A                sta     BAS_TMP1                ; lo
0027DEr 2                       ; Shift count = $90 - exp_byte (0..15).
0027DEr 2  68                   pla
0027DFr 2  38                   sec
0027E0r 2  E9 90                sbc     #$90
0027E2r 2  49 FF                eor     #$FF
0027E4r 2  18                   clc
0027E5r 2  69 01                adc     #1                      ; A = $90 - exp
0027E7r 2  F0 08                beq     @store                  ; zero shifts: already aligned
0027E9r 2  AA                   tax
0027EAr 2               @shloop:
0027EAr 2  46 3B                lsr     BAS_TMP1+1
0027ECr 2  66 3A                ror     BAS_TMP1
0027EEr 2  CA                   dex
0027EFr 2  D0 F9                bne     @shloop
0027F1r 2               @store:
0027F1r 2  A5 3B                lda     BAS_TMP1+1
0027F3r 2  85 11                sta     FAC+3
0027F5r 2  A5 3A                lda     BAS_TMP1
0027F7r 2  85 12                sta     FAC+4
0027F9r 2  60                   rts
0027FAr 2               @zero:
0027FAr 2  64 11                stz     FAC+3
0027FCr 2  64 12                stz     FAC+4
0027FEr 2  60                   rts
0027FFr 2               @illqty:
0027FFr 2  4C rr rr             jmp     IqErr
002802r 2               
002802r 2               ; Evaluate string expression -> copy up to 12 chars to BAS_FNAME,
002802r 2               ; null-terminate, set STR_PTR := BAS_FNAME, free temp string.
002802r 2               ; 12 = full 8.3 form ("NAME.EXT" = 8 name + '.' + 3 ext).
002802r 2               EvalString:
002802r 2  20 rr rr             jsr     FrmEvl
002805r 2  20 rr rr             jsr     ChkStr
002808r 2  A5 0F                lda     FAC+1
00280Ar 2  85 20                sta     INDEX
00280Cr 2  A5 10                lda     FAC+2
00280Er 2  85 21                sta     INDEX+1
002810r 2  A0 00                ldy     #0
002812r 2  A6 0E                ldx     FAC                     ; length
002814r 2               @cpy:
002814r 2  C0 0C                cpy     #12
002816r 2  F0 0D                beq     @done
002818r 2  E0 00                cpx     #0
00281Ar 2  F0 09                beq     @done
00281Cr 2  B1 20                lda     (INDEX),y
00281Er 2  99 81 03             sta     BAS_FNAME,y
002821r 2  C8                   iny
002822r 2  CA                   dex
002823r 2  80 EF                bra     @cpy
002825r 2               @done:
002825r 2  A9 00                lda     #0
002827r 2  99 81 03             sta     BAS_FNAME,y
00282Ar 2  A9 81                lda     #<BAS_FNAME
00282Cr 2  85 02                sta     STR_PTR
00282Er 2  A9 03                lda     #>BAS_FNAME
002830r 2  85 03                sta     STR_PTR+1
002832r 2  4C rr rr             jmp     FreFac
002835r 2               
002835r 2               ; Print A as 2-digit decimal with leading zero (used by TIME/DATE).
002835r 2               BasPr2D:
002835r 2  A2 00                ldx     #0
002837r 2               @loop:
002837r 2  C9 0A                cmp     #10
002839r 2  90 05                bcc     @done
00283Br 2  E9 0A                sbc     #10
00283Dr 2  E8                   inx
00283Er 2  80 F7                bra     @loop
002840r 2               @done:
002840r 2  48                   pha
002841r 2  8A                   txa
002842r 2  09 30                ora     #'0'
002844r 2  20 rr rr             jsr     Chrout
002847r 2  68                   pla
002848r 2  09 30                ora     #'0'
00284Ar 2  4C rr rr             jmp     Chrout
00284Dr 2               
00284Dr 2               ; BasFixChain -- recompute end-of-program pointers after a program image load.
00284Dr 2               ; A program image is the raw bytes belonging at $0800 up: a tokenized line chain
00284Dr 2               ; and, for a .prg, machine code sitting past the chain's $0000 terminator.  A
00284Dr 2               ; chain walk alone only ever finds the end of the BASIC part, so the loader's
00284Dr 2               ; byte count has to be taken into account too.
00284Dr 2               ;   Input:  A = loaded image size lo, Y = size hi (0 = size unknown; chain only)
00284Dr 2               ;   Output: BAS_VARTAB = BAS_ARYTAB = BAS_STREND
00284Dr 2               ;             = max(chain-end + 2, PROGRAM_START + size)
00284Dr 2               ;   Note:   a size that would push the result past BAS_MEMSIZ is rejected and the
00284Dr 2               ;           chain-end candidate is used instead.
00284Dr 2               ; Mirroring VARTAB into ARYTAB/STREND matters on its own: Makenewvariable places
00284Dr 2               ; a new scalar at ARYTAB, so leaving it at its post-NEW $0802 makes the first
00284Dr 2               ; direct-mode assignment after a LOAD overwrite the program's first line.
00284Dr 2                       .assert (PROGRAM_START & $FF) = 0, error, "PROGRAM_START must be page-aligned"
00284Dr 2               BasFixChain:
00284Dr 2  85 3C                sta     BAS_TMP2                ; BAS_TMP2 = PROGRAM_START + size; the
00284Fr 2  98                   tya                             ; low byte passes through untouched
002850r 2  18                   clc                             ; because PROGRAM_START is page-aligned
002851r 2  69 08                adc     #>PROGRAM_START
002853r 2  85 3D                sta     BAS_TMP2+1
002855r 2  64 20                stz     INDEX
002857r 2  A9 08                lda     #>PROGRAM_START
002859r 2  85 21                sta     INDEX+1
00285Br 2               @walk:
00285Br 2  A0 01                ldy     #1
00285Dr 2  B1 20                lda     (INDEX),y               ; next-ptr hi
00285Fr 2  85 3A                sta     BAS_TMP1
002861r 2  88                   dey
002862r 2  11 20                ora     (INDEX),y               ; both bytes zero -> terminator
002864r 2  F0 15                beq     @end
002866r 2                       ; Lines ascend in memory.  LOAD accepts any file, so a corrupt or
002866r 2                       ; cyclic chain is reachable here — stop at the last good line rather
002866r 2                       ; than loop forever.
002866r 2  38                   sec
002867r 2  A5 20                lda     INDEX
002869r 2  F1 20                sbc     (INDEX),y
00286Br 2  A5 21                lda     INDEX+1
00286Dr 2  E5 3A                sbc     BAS_TMP1
00286Fr 2  B0 0A                bcs     @end                    ; current >= next -> not a real chain
002871r 2  B1 20                lda     (INDEX),y               ; next-ptr lo
002873r 2  85 20                sta     INDEX
002875r 2  A5 3A                lda     BAS_TMP1
002877r 2  85 21                sta     INDEX+1
002879r 2  80 E0                bra     @walk
00287Br 2               @end:
00287Br 2                       ; INDEX points at terminator ($00 $00).  Candidate A = INDEX + 2.
00287Br 2  18                   clc
00287Cr 2  A5 20                lda     INDEX
00287Er 2  69 02                adc     #2
002880r 2  8D 5F 03             sta     BAS_VARTAB
002883r 2  A5 21                lda     INDEX+1
002885r 2  69 00                adc     #0
002887r 2  8D 60 03             sta     BAS_VARTAB+1
00288Ar 2                       ; Candidate B = BAS_TMP2.  Keep it only when A <= B <= MEMSIZ, so a
00288Ar 2                       ; short or absent size loses the max and a bogus one cannot push
00288Ar 2                       ; VARTAB out of memory.
00288Ar 2  38                   sec
00288Br 2  A5 3C                lda     BAS_TMP2
00288Dr 2  ED 5F 03             sbc     BAS_VARTAB
002890r 2  A5 3D                lda     BAS_TMP2+1
002892r 2  ED 60 03             sbc     BAS_VARTAB+1
002895r 2  90 17                bcc     @mirror                 ; B < A -> keep A
002897r 2  38                   sec
002898r 2  AD 67 03             lda     BAS_MEMSIZ
00289Br 2  E5 3C                sbc     BAS_TMP2
00289Dr 2  AD 68 03             lda     BAS_MEMSIZ+1
0028A0r 2  E5 3D                sbc     BAS_TMP2+1
0028A2r 2  90 0A                bcc     @mirror                 ; B > MEMSIZ -> reject, keep A
0028A4r 2  A5 3C                lda     BAS_TMP2
0028A6r 2  8D 5F 03             sta     BAS_VARTAB
0028A9r 2  A5 3D                lda     BAS_TMP2+1
0028ABr 2  8D 60 03             sta     BAS_VARTAB+1
0028AEr 2               @mirror:
0028AEr 2                       ; ARYTAB / STREND follow VARTAB on a fresh load: no variables yet.
0028AEr 2  A2 01                ldx     #1
0028B0r 2               @copy:
0028B0r 2  BD 5F 03             lda     BAS_VARTAB,x
0028B3r 2  9D 61 03             sta     BAS_ARYTAB,x
0028B6r 2  9D 63 03             sta     BAS_STREND,x
0028B9r 2  CA                   dex
0028BAr 2  10 F4                bpl     @copy
0028BCr 2  60                   rts
0028BDr 2               
0028BDr 2               ; --- Statements -----------------------------------------------------------
0028BDr 2               
0028BDr 2               ; SYS addr[,a[,x[,y]]] -- call a machine-code routine; RTS comes back here.
0028BDr 2               ; A, X and Y are loaded from the optional arguments (0 when omitted) and the
0028BDr 2               ; routine is entered with decimal mode and the interrupt mask clear.  What it
0028BDr 2               ; returns in A, X, Y and P is left in BRK_A/X/Y/P (PEEK 787/788/789/784), the
0028BDr 2               ; bytes a BRK report reads from.  The arguments wait there too: FrmEvl owns
0028BDr 2               ; every zero-page scratch byte, and nothing else runs between the last
0028BDr 2               ; argument and the call.
0028BDr 2               BasCmdSys:
0028BDr 2  20 rr rr             jsr     EvalAddrU16
0028C0r 2  A5 12                lda     FAC+4                   ; lo, and hi, across the evaluations
0028C2r 2  48                   pha
0028C3r 2  A5 11                lda     FAC+3
0028C5r 2  48                   pha
0028C6r 2  9C 13 03             stz     BRK_A
0028C9r 2  9C 14 03             stz     BRK_X
0028CCr 2  9C 15 03             stz     BRK_Y
0028CFr 2  A2 00                ldx     #0
0028D1r 2               @arg:
0028D1r 2  20 rr rr             jsr     ChrGot
0028D4r 2  C9 2C                cmp     #','
0028D6r 2  D0 0E                bne     @call
0028D8r 2  DA                   phx
0028D9r 2  20 rr rr             jsr     GetComByt               ; X = value
0028DCr 2  8A                   txa
0028DDr 2  FA                   plx
0028DEr 2  9D 13 03             sta     BRK_A,x
0028E1r 2  E8                   inx
0028E2r 2  E0 03                cpx     #3
0028E4r 2  D0 EB                bne     @arg
0028E6r 2               @call:
0028E6r 2  68                   pla
0028E7r 2  85 21                sta     INDEX+1
0028E9r 2  68                   pla
0028EAr 2  85 20                sta     INDEX
0028ECr 2  20 rr rr             jsr     @go
0028EFr 2  08                   php
0028F0r 2  8D 13 03             sta     BRK_A
0028F3r 2  8E 14 03             stx     BRK_X
0028F6r 2  8C 15 03             sty     BRK_Y
0028F9r 2  68                   pla
0028FAr 2  8D 10 03             sta     BRK_P
0028FDr 2  D8                   cld
0028FEr 2  60                   rts
0028FFr 2               @go:
0028FFr 2  AD 13 03             lda     BRK_A
002902r 2  AE 14 03             ldx     BRK_X
002905r 2  AC 15 03             ldy     BRK_Y
002908r 2  D8                   cld
002909r 2  58                   cli
00290Ar 2  6C 20 00             jmp     (INDEX)
00290Dr 2               
00290Dr 2               ; ---------------------------------------------------------------------------
00290Dr 2               ; Byte arguments, with the ranges the README documents.
00290Dr 2               ;
00290Dr 2               ; GetByt itself only rejects a value that will not fit in a byte.  Every
00290Dr 2               ; statement below has a narrower range than that -- a volume of 0-15, a screen
00290Dr 2               ; row of 0-23, an hour of 0-23 -- and each of them used to take whatever byte
00290Dr 2               ; it was handed and fold it into something legal.  VOL 16 masked to 4 bits and
00290Dr 2               ; set the volume to *zero*; LOCATE 24,0 pointed the cursor past the end of the
00290Dr 2               ; name table; SETTIME 24,61,61 wrote BCD the DS1511Y has no values for.  None
00290Dr 2               ; of them said anything.
00290Dr 2               ;
00290Dr 2               ; So the range travels with the fetch.  A = one past the highest legal value;
00290Dr 2               ; anything from there up raises ILLEGAL QUANTITY, as NVRAM's address already
00290Dr 2               ; did.  GetComByteLim is the same thing preceded by the comma between two
00290Dr 2               ; arguments, and it costs a byte *less* per site than the `jsr ChkCom /
00290Dr 2               ; jsr GetByt` pair it replaces -- which is how thirteen range checks fit into
00290Dr 2               ; a segment that had one byte spare.
00290Dr 2               ;
00290Dr 2               ; The limit is parked on the stack across the fetch rather than in scratch:
00290Dr 2               ; GetByt runs the whole expression evaluator, which reaches BAS_TMP3 itself.
00290Dr 2               ; Between the `pla` and the `cpx` nothing runs at all, so the byte is safe
00290Dr 2               ; there and nowhere earlier.
00290Dr 2               ; ---------------------------------------------------------------------------
00290Dr 2               
00290Dr 2               ; GetComByt - a comma, then an unchecked byte argument.
00290Dr 2               GetComByt:
00290Dr 2  20 rr rr             jsr     ChkCom
002910r 2  4C rr rr             jmp     GetByt
002913r 2               
002913r 2               ; GetComByteLim / GetByteLim - the same, with a range.  X = value.
002913r 2               GetComByteLim:
002913r 2  48                   pha                             ; the limit, across the comma
002914r 2  20 rr rr             jsr     ChkCom
002917r 2  68                   pla
002918r 2               GetByteLim:
002918r 2  48                   pha                             ; and across the evaluator
002919r 2  20 rr rr             jsr     GetByt                  ; X = value
00291Cr 2  68                   pla
00291Dr 2  85 3E                sta     BAS_TMP3
00291Fr 2  E4 3E                cpx     BAS_TMP3
002921r 2  B0 01                bcs     BasRangeErr             ; value >= limit
002923r 2  60                   rts
002924r 2               BasRangeErr:
002924r 2  4C rr rr             jmp     IqErr
002927r 2               
002927r 2               ; The five statements below reach hardware that a machine may not have fitted,
002927r 2               ; and none of them raises ?NO DEVICE for it: a screen or a speaker has no answer
002927r 2               ; to return, so there is nothing an error could tell the program that silence
002927r 2               ; does not.  A game that beeps on a hit keeps playing on a machine with no sound
002927r 2               ; card.  The skip lives in the Kernal routine each one ends in, which is what
002927r 2               ; makes the same promise to a cartridge calling the slot directly; the arguments
002927r 2               ; are parsed and range-checked here either way, so a program is wrong or right
002927r 2               ; on every machine rather than on the one it was written on.
002927r 2               ;
002927r 2               ; The statements that read or write *data* — the CF and RTC ones below — do
002927r 2               ; raise ?NO DEVICE, and for the same reason: they have an answer to return and
002927r 2               ; cannot.
002927r 2               
002927r 2               ; CLS
002927r 2               BasCmdCls:
002927r 2  4C rr rr             jmp     VideoClear
00292Ar 2               
00292Ar 2               ; LOCATE row, col
00292Ar 2               BasCmdLocate:
00292Ar 2  A9 18                lda     #24                     ; rows 0-23
00292Cr 2  20 rr rr             jsr     GetByteLim              ; X = row
00292Fr 2  DA                   phx
002930r 2  A9 28                lda     #40                     ; columns 0-39
002932r 2  20 rr rr             jsr     GetComByteLim           ; X = col
002935r 2  7A                   ply                             ; Y = row
002936r 2  4C rr rr             jmp     VideoSetCursor
002939r 2               
002939r 2               ; COLOR fg[, bg[, border]]
002939r 2               ;   The pen for later output, through VideoSetColor, which also sets the border
002939r 2               ;   to bg.  bg defaults to the current pen's.  A border then writes register 7
002939r 2               ;   again as fg<<4 | border.
002939r 2               BasCmdColor:
002939r 2  A9 10                lda     #16                     ; colours 0-15
00293Br 2  20 rr rr             jsr     GetByteLim              ; X = fg
00293Er 2  8A                   txa
00293Fr 2  0A                   asl     a
002940r 2  0A                   asl     a
002941r 2  0A                   asl     a
002942r 2  0A                   asl     a
002943r 2  48                   pha                             ; fg must survive FrmEvl -> stack, not ZP
002944r 2  AD 91 03             lda     VID_PEN
002947r 2  29 0F                and     #$0F
002949r 2  AA                   tax                             ; X = bg if none is given
00294Ar 2  20 rr rr             jsr     ChrGot
00294Dr 2  C9 2C                cmp     #','
00294Fr 2  D0 05                bne     @bg
002951r 2  A9 10                lda     #16
002953r 2  20 rr rr             jsr     GetComByteLim           ; X = bg, already known to fit a nibble
002956r 2               @bg:
002956r 2  86 3A                stx     BAS_TMP1
002958r 2  68                   pla
002959r 2  48                   pha
00295Ar 2  05 3A                ora     BAS_TMP1
00295Cr 2  20 rr rr             jsr     VideoSetColor
00295Fr 2  20 rr rr             jsr     ChrGot
002962r 2  C9 2C                cmp     #','
002964r 2  D0 0F                bne     @done
002966r 2  A9 10                lda     #16
002968r 2  20 rr rr             jsr     GetComByteLim           ; X = border
00296Br 2  86 3A                stx     BAS_TMP1
00296Dr 2  68                   pla
00296Er 2  05 3A                ora     BAS_TMP1
002970r 2  A2 07                ldx     #VDP_COLOR
002972r 2  4C rr rr             jmp     VdpWriteRegImpl         ; Skips without a card
002975r 2               @done:
002975r 2  68                   pla
002976r 2  60                   rts
002977r 2               
002977r 2               ; VOL n
002977r 2               BasCmdVol:
002977r 2  A9 10                lda     #16                     ; volume 0-15
002979r 2  20 rr rr             jsr     GetByteLim              ; X = vol
00297Cr 2  8A                   txa
00297Dr 2  4C rr rr             jmp     SidSetVolume
002980r 2               
002980r 2               ; SOUND voice, freq, dur (freq=Hz, dur=centisec)
002980r 2               ;   Hz -> SID register: reg = Hz * 16.75 ≈ Hz<<4 + Hz - Hz/4
002980r 2               BasCmdSound:
002980r 2  A9 04                lda     #4                      ; voices 1-3, after Commodore BASIC V3.5
002982r 2  20 rr rr             jsr     GetByteLim              ; X = voice
002985r 2  CA                   dex                             ; 0-indexed for SidPlayNote
002986r 2  30 9C                bmi     BasRangeErr             ; voice 0 underflowed to $FF
002988r 2  DA                   phx                             ; voice (0-indexed) on stack
002989r 2  20 rr rr             jsr     ChkCom
00298Cr 2  20 rr rr             jsr     EvalU16                 ; freq Hz: hi=FAC+3, lo=FAC+4
00298Fr 2                       ; Compute reg = Hz<<4 + Hz - Hz/4
00298Fr 2  A5 12                lda     FAC+4
002991r 2  85 3A                sta     BAS_TMP1
002993r 2  A5 11                lda     FAC+3
002995r 2  85 3B                sta     BAS_TMP1+1
002997r 2  A5 3A                lda     BAS_TMP1
002999r 2  85 3C                sta     BAS_TMP2
00299Br 2  A5 3B                lda     BAS_TMP1+1
00299Dr 2  85 3D                sta     BAS_TMP2+1
00299Fr 2  A2 04                ldx     #4
0029A1r 2               @shl:
0029A1r 2  06 3A                asl     BAS_TMP1
0029A3r 2  26 3B                rol     BAS_TMP1+1
0029A5r 2  CA                   dex
0029A6r 2  D0 F9                bne     @shl
0029A8r 2  18                   clc
0029A9r 2  A5 3A                lda     BAS_TMP1
0029ABr 2  65 3C                adc     BAS_TMP2
0029ADr 2  85 3A                sta     BAS_TMP1
0029AFr 2  A5 3B                lda     BAS_TMP1+1
0029B1r 2  65 3D                adc     BAS_TMP2+1
0029B3r 2  85 3B                sta     BAS_TMP1+1
0029B5r 2  46 3D                lsr     BAS_TMP2+1
0029B7r 2  66 3C                ror     BAS_TMP2
0029B9r 2  46 3D                lsr     BAS_TMP2+1
0029BBr 2  66 3C                ror     BAS_TMP2
0029BDr 2  38                   sec
0029BEr 2  A5 3A                lda     BAS_TMP1
0029C0r 2  E5 3C                sbc     BAS_TMP2
0029C2r 2  48                   pha                             ; freqLo
0029C3r 2  A5 3B                lda     BAS_TMP1+1
0029C5r 2  E5 3D                sbc     BAS_TMP2+1
0029C7r 2  48                   pha                             ; freqHi
0029C8r 2  20 rr rr             jsr     ChkCom
0029CBr 2  20 rr rr             jsr     EvalU16                 ; dur in FAC+3/+4
0029CEr 2                       ; Stack (top-down): freqHi, freqLo, voice
0029CEr 2  7A                   ply                             ; Y = freqHi
0029CFr 2  FA                   plx                             ; X = freqLo
0029D0r 2  68                   pla                             ; A = voice
0029D1r 2  20 rr rr             jsr     SidPlayNote
0029D4r 2  A5 12                lda     FAC+4
0029D6r 2  A6 11                ldx     FAC+3
0029D8r 2  20 rr rr             jsr     SysDelay
0029DBr 2  4C rr rr             jmp     SidSilence
0029DEr 2               
0029DEr 2               ; TIME
0029DEr 2               BasCmdTime:
0029DEr 2  A9 04                lda     #HW_RTC
0029E0r 2  20 rr rr             jsr     ReqHw
0029E3r 2  20 rr rr             jsr     RtcReadTime             ; A=hours, X=min, Y=sec
0029E6r 2  5A                   phy
0029E7r 2  DA                   phx
0029E8r 2  20 rr rr             jsr     BasPr2D                 ; print hours
0029EBr 2  A9 3A                lda     #':'
0029EDr 2  20 rr rr             jsr     Chrout
0029F0r 2  68                   pla
0029F1r 2  20 rr rr             jsr     BasPr2D
0029F4r 2  A9 3A                lda     #':'
0029F6r 2  20 rr rr             jsr     Chrout
0029F9r 2  68                   pla
0029FAr 2  20 rr rr             jsr     BasPr2D
0029FDr 2  4C rr rr             jmp     BasPrintCRLF
002A00r 2               
002A00r 2               ; DATE
002A00r 2               BasCmdDate:
002A00r 2  A9 04                lda     #HW_RTC
002A02r 2  20 rr rr             jsr     ReqHw
002A05r 2  20 rr rr             jsr     RtcReadDate             ; A=day, X=month, Y=year
002A08r 2  48                   pha
002A09r 2  DA                   phx
002A0Ar 2  5A                   phy
002A0Br 2  AD 0B 03             lda     RTC_BUF_CENT
002A0Er 2  20 rr rr             jsr     BasPr2D
002A11r 2  68                   pla
002A12r 2  20 rr rr             jsr     BasPr2D
002A15r 2  A9 2D                lda     #'-'
002A17r 2  20 rr rr             jsr     Chrout
002A1Ar 2  68                   pla
002A1Br 2  20 rr rr             jsr     BasPr2D
002A1Er 2  A9 2D                lda     #'-'
002A20r 2  20 rr rr             jsr     Chrout
002A23r 2  68                   pla
002A24r 2  20 rr rr             jsr     BasPr2D
002A27r 2  4C rr rr             jmp     BasPrintCRLF
002A2Ar 2               
002A2Ar 2               ; SETTIME h, m, s
002A2Ar 2               BasCmdSettime:
002A2Ar 2  A9 04                lda     #HW_RTC
002A2Cr 2  20 rr rr             jsr     ReqHw
002A2Fr 2  A9 18                lda     #24                     ; hours 0-23
002A31r 2  20 rr rr             jsr     GetByteLim              ; X = h
002A34r 2  DA                   phx
002A35r 2  A9 3C                lda     #60                     ; minutes 0-59
002A37r 2  20 rr rr             jsr     GetComByteLim           ; X = m
002A3Ar 2  DA                   phx
002A3Br 2  A9 3C                lda     #60                     ; seconds 0-59
002A3Dr 2  20 rr rr             jsr     GetComByteLim           ; X = s
002A40r 2  8A                   txa
002A41r 2  A8                   tay                             ; Y = s
002A42r 2  FA                   plx                             ; X = m
002A43r 2  68                   pla                             ; A = h
002A44r 2  4C rr rr             jmp     RtcWriteTime
002A47r 2               
002A47r 2               ; SETDATE c, y, m, d
002A47r 2               BasCmdSetdate:
002A47r 2  A9 04                lda     #HW_RTC
002A49r 2  20 rr rr             jsr     ReqHw
002A4Cr 2  A9 64                lda     #100                    ; century 0-99, as two BCD digits
002A4Er 2  20 rr rr             jsr     GetByteLim
002A51r 2  8E 0B 03             stx     RTC_BUF_CENT
002A54r 2  A9 64                lda     #100                    ; year 0-99
002A56r 2  20 rr rr             jsr     GetComByteLim
002A59r 2  DA                   phx                             ; year
002A5Ar 2  A9 0D                lda     #13                     ; months 1-12, so reject 0 as well
002A5Cr 2  20 rr rr             jsr     GetComByteLim
002A5Fr 2  E0 01                cpx     #1
002A61r 2  90 10                bcc     @bad
002A63r 2  DA                   phx                             ; month
002A64r 2  A9 20                lda     #32                     ; days 1-31.  Which months are short is
002A66r 2  20 rr rr             jsr     GetComByteLim           ;   left alone: it needs a table and a
002A69r 2  E0 01                cpx     #1                      ;   leap rule for one wrong day a year,
002A6Br 2  90 06                bcc     @bad                    ;   and the DS1511Y does not check it
002A6Dr 2                                                       ;   either
002A6Dr 2  8A                   txa
002A6Er 2  FA                   plx                             ; X=month
002A6Fr 2  7A                   ply                             ; Y=year
002A70r 2  4C rr rr             jmp     RtcWriteDate
002A73r 2               @bad:                                   ; BasRangeErr is out of branch reach
002A73r 2  4C rr rr             jmp     IqErr
002A76r 2               
002A76r 2               ; NVRAM addr, val
002A76r 2               BasCmdNvram:
002A76r 2  A9 04                lda     #HW_RTC
002A78r 2  20 rr rr             jsr     ReqHw
002A7Br 2  20 rr rr             jsr     GetByt                  ; addr; GetByt's own 0-255 is the range
002A7Er 2  DA                   phx
002A7Fr 2  20 rr rr             jsr     GetComByt               ; X=val
002A82r 2  8A                   txa                             ; A=val
002A83r 2  FA                   plx                             ; X=addr
002A84r 2  4C rr rr             jmp     RtcWriteNVRAM
002A87r 2               
002A87r 2               ; WAIT addr, mask
002A87r 2               ; As with POKE, the address must survive evaluation of the second argument,
002A87r 2               ; which is free to trample BAS_TMP1 (FacToU16, MID$/LEFT$/RIGHT$, ...).
002A87r 2               BasCmdWait:
002A87r 2  20 rr rr             jsr     EvalAddrU16
002A8Ar 2  A5 11                lda     FAC+3                   ; hi
002A8Cr 2  48                   pha
002A8Dr 2  A5 12                lda     FAC+4                   ; lo
002A8Fr 2  48                   pha
002A90r 2  20 rr rr             jsr     GetComByt               ; X = mask
002A93r 2  86 3C                stx     BAS_TMP2
002A95r 2  68                   pla
002A96r 2  85 3A                sta     BAS_TMP1
002A98r 2  68                   pla
002A99r 2  85 3B                sta     BAS_TMP1+1
002A9Br 2               @poll:
002A9Br 2  20 rr rr             jsr     BasCheckBreak
002A9Er 2  A0 00                ldy     #0
002AA0r 2  B1 3A                lda     (BAS_TMP1),y
002AA2r 2  25 3C                and     BAS_TMP2
002AA4r 2  F0 F5                beq     @poll
002AA6r 2  60                   rts
002AA7r 2               
002AA7r 2               ; PAUSE n (centiseconds)
002AA7r 2               BasCmdPause:
002AA7r 2  20 rr rr             jsr     EvalU16
002AAAr 2  A5 12                lda     FAC+4
002AACr 2  A6 11                ldx     FAC+3
002AAEr 2  4C rr rr             jmp     SysDelay
002AB1r 2               
002AB1r 2               ; BANK n
002AB1r 2               BasCmdBank:
002AB1r 2  A9 01                lda     #HW_RAM_L
002AB3r 2  20 rr rr             jsr     ReqHw
002AB6r 2  20 rr rr             jsr     GetByt                  ; X = bank
002AB9r 2  8E FF 83             stx     RAM_BANK_L
002ABCr 2  60                   rts
002ABDr 2               
002ABDr 2               ; POKE addr, val
002ABDr 2               ; The value expression is evaluated BEFORE the address is parked in INDEX:
002ABDr 2               ; FrmEvl clobbers every zero-page scratch pair (INDEX via LoadFacFromYa,
002ABDr 2               ; BAS_TMP1 via FacToU16 / the string functions), so the address has to ride
002ABDr 2               ; the hardware stack across the evaluation.
002ABDr 2               BasCmdPoke:
002ABDr 2  20 rr rr             jsr     EvalAddrU16
002AC0r 2  A5 11                lda     FAC+3                   ; hi
002AC2r 2  48                   pha
002AC3r 2  A5 12                lda     FAC+4                   ; lo
002AC5r 2  48                   pha
002AC6r 2  20 rr rr             jsr     ChkCom
002AC9r 2  20 rr rr             jsr     GetByt                  ; X = val
002ACCr 2  68                   pla
002ACDr 2  85 20                sta     INDEX
002ACFr 2  68                   pla
002AD0r 2  85 21                sta     INDEX+1
002AD2r 2  8A                   txa
002AD3r 2  A0 00                ldy     #0
002AD5r 2  91 20                sta     (INDEX),y
002AD7r 2  60                   rts
002AD8r 2               
002AD8r 2               ; LOAD ["name"] / LOAD (bare) / LOAD "name"
002AD8r 2               BasCmdLoad:
002AD8r 2  20 rr rr             jsr     ChrGot
002ADBr 2  F0 02                beq     @bare
002ADDr 2  80 19                bra     @cf                     ; any argument is a filename expression
002ADFr 2               @bare:
002ADFr 2  A9 10                lda     #HW_SC
002AE1r 2  20 rr rr             jsr     ReqHw
002AE4r 2  A9 00                lda     #<PROGRAM_START
002AE6r 2  85 2A                sta     XFER_PTR
002AE8r 2  A9 08                lda     #>PROGRAM_START
002AEAr 2  85 2B                sta     XFER_PTR+1
002AECr 2  20 rr rr             jsr     XModemLoad
002AEFr 2                       ; XMODEM rounds up to a 128-byte block, so this can overshoot the true
002AEFr 2                       ; end by up to 127 bytes: it wastes a little variable space, never
002AEFr 2                       ; truncates.
002AEFr 2  AD 17 03             lda     XFER_REMAIN
002AF2r 2  AC 18 03             ldy     XFER_REMAIN+1
002AF5r 2  4C rr rr             jmp     BasFixChain
002AF8r 2               @cf:
002AF8r 2  A9 08                lda     #HW_CF
002AFAr 2  20 rr rr             jsr     ReqHw
002AFDr 2  20 rr rr             jsr     EvalString
002B00r 2  20 rr rr             jsr     FsLoadFile
002B03r 2  B0 09                bcs     @err
002B05r 2  AD 4A 03             lda     FS_FILE_SIZE
002B08r 2  AC 4B 03             ldy     FS_FILE_SIZE+1
002B0Br 2  4C rr rr             jmp     BasFixChain
002B0Er 2               @err:
002B0Er 2  A9 rr                lda     #<MsgLoadErr
002B10r 2  A0 rr                ldy     #>MsgLoadErr
002B12r 2  4C rr rr             jmp     BasPrintStr
002B15r 2               
002B15r 2               ; SAVE / SAVE "name"
002B15r 2               BasCmdSave:
002B15r 2  20 rr rr             jsr     ChrGot
002B18r 2  F0 02                beq     @bare
002B1Ar 2  80 21                bra     @cf                     ; any argument is a filename expression
002B1Cr 2               @bare:
002B1Cr 2  A9 10                lda     #HW_SC
002B1Er 2  20 rr rr             jsr     ReqHw
002B21r 2  A9 00                lda     #<PROGRAM_START
002B23r 2  85 2A                sta     XFER_PTR
002B25r 2  A9 08                lda     #>PROGRAM_START
002B27r 2  85 2B                sta     XFER_PTR+1
002B29r 2  38                   sec
002B2Ar 2  AD 5F 03             lda     BAS_VARTAB
002B2Dr 2  E9 00                sbc     #<PROGRAM_START
002B2Fr 2  8D 17 03             sta     XFER_REMAIN
002B32r 2  AD 60 03             lda     BAS_VARTAB+1
002B35r 2  E9 08                sbc     #>PROGRAM_START
002B37r 2  8D 18 03             sta     XFER_REMAIN+1
002B3Ar 2  4C rr rr             jmp     XModemSave
002B3Dr 2               @cf:
002B3Dr 2  A9 08                lda     #HW_CF
002B3Fr 2  20 rr rr             jsr     ReqHw
002B42r 2  20 rr rr             jsr     EvalString
002B45r 2  38                   sec
002B46r 2  AD 5F 03             lda     BAS_VARTAB
002B49r 2  E9 00                sbc     #<PROGRAM_START
002B4Br 2  8D 4A 03             sta     FS_FILE_SIZE
002B4Er 2  AD 60 03             lda     BAS_VARTAB+1
002B51r 2  E9 08                sbc     #>PROGRAM_START
002B53r 2  8D 4B 03             sta     FS_FILE_SIZE+1
002B56r 2  20 rr rr             jsr     FsSaveFile
002B59r 2  B0 01                bcs     @err
002B5Br 2  60                   rts
002B5Cr 2               @err:
002B5Cr 2  A9 rr                lda     #<MsgSaveErr
002B5Er 2  A0 rr                ldy     #>MsgSaveErr
002B60r 2  4C rr rr             jmp     BasPrintStr
002B63r 2               
002B63r 2               ; DIR
002B63r 2               BasCmdDir:
002B63r 2  A9 08                lda     #HW_CF
002B65r 2  20 rr rr             jsr     ReqHw
002B68r 2  4C rr rr             jmp     FsDirectory
002B6Br 2               
002B6Br 2               ; DEL "name"
002B6Br 2               BasCmdDel:
002B6Br 2  A9 08                lda     #HW_CF
002B6Dr 2  20 rr rr             jsr     ReqHw
002B70r 2  20 rr rr             jsr     EvalString
002B73r 2  20 rr rr             jsr     FsDeleteFile
002B76r 2  B0 01                bcs     @err
002B78r 2  60                   rts
002B79r 2               @err:
002B79r 2  A9 rr                lda     #<MsgDelErr
002B7Br 2  A0 rr                ldy     #>MsgDelErr
002B7Dr 2  4C rr rr             jmp     BasPrintStr
002B80r 2               
002B80r 2               ; MEM -- print "nnnnn BYTES FREE  HW=$xx"
002B80r 2               BasCmdMem:
002B80r 2                       ; Free bytes = MEMSIZ - VARTAB
002B80r 2  38                   sec
002B81r 2  AD 67 03             lda     BAS_MEMSIZ
002B84r 2  ED 5F 03             sbc     BAS_VARTAB
002B87r 2  A8                   tay
002B88r 2  AD 68 03             lda     BAS_MEMSIZ+1
002B8Br 2  ED 60 03             sbc     BAS_VARTAB+1
002B8Er 2  20 rr rr             jsr     GivAyf                  ; FAC = unsigned int from (Y,A)
002B91r 2                       ; Wait: GivAyf is signed.  For this simple display, OK if < 32768.
002B91r 2  20 rr rr             jsr     PrintNum
002B94r 2  A9 rr                lda     #<MsgFree
002B96r 2  A0 rr                ldy     #>MsgFree
002B98r 2  20 rr rr             jsr     BasPrintStr
002B9Br 2  A9 24                lda     #'$'
002B9Dr 2  20 rr rr             jsr     Chrout
002BA0r 2  AD 0D 03             lda     HW_PRESENT
002BA3r 2  20 rr rr             jsr     PrintHexByte
002BA6r 2  20 rr rr             jsr     BasPrintCRLF
002BA9r 2  4C rr rr             jmp     FsPrintDisk             ; print "DISK n" line
002BACr 2               
002BACr 2               ; DISK n -- select the current CF disk bank (0-255)
002BACr 2               BasCmdDisk:
002BACr 2  20 rr rr             jsr     GetByt                  ; X = value 0-255
002BAFr 2  8E 0F 03             stx     CF_DISK
002BB2r 2  60                   rts
002BB3r 2               
002BB3r 2               ; BLOAD addr[,"name"] -- load a file's raw bytes to addr, or with no name
002BB3r 2               ; receive them over XModem.  The card each path needs is asked for once the
002BB3r 2               ; arguments say which path it is.
002BB3r 2               BasCmdBload:
002BB3r 2  20 rr rr             jsr     EvalAddrU16             ; FAC+3 = hi, FAC+4 = lo
002BB6r 2  A5 12                lda     z:FAC+4
002BB8r 2  8D 7F 03             sta     FS_IO_ADDR
002BBBr 2  85 2A                sta     XFER_PTR
002BBDr 2  A5 11                lda     z:FAC+3
002BBFr 2  8D 80 03             sta     FS_IO_ADDR+1
002BC2r 2  85 2B                sta     XFER_PTR+1
002BC4r 2  20 rr rr             jsr     ChrGot
002BC7r 2  D0 0A                bne     @cf
002BC9r 2  A9 10                lda     #HW_SC
002BCBr 2  20 rr rr             jsr     ReqHw
002BCEr 2  20 rr rr             jsr     XModemLoad
002BD1r 2  80 0E                bra     @done
002BD3r 2               @cf:
002BD3r 2  A9 08                lda     #HW_CF
002BD5r 2  20 rr rr             jsr     ReqHw
002BD8r 2  20 rr rr             jsr     ChkCom
002BDBr 2  20 rr rr             jsr     EvalString              ; filename -> BAS_FNAME, STR_PTR
002BDEr 2  20 rr rr             jsr     FsLoadFileAddr
002BE1r 2               @done:
002BE1r 2  B0 01                bcs     BasLoadErr
002BE3r 2  60                   rts
002BE4r 2               BasLoadErr:
002BE4r 2  A9 rr                lda     #<MsgLoadErr
002BE6r 2  A0 rr                ldy     #>MsgLoadErr
002BE8r 2  4C rr rr             jmp     BasPrintStr
002BEBr 2               
002BEBr 2               ; BSAVE addr, len[,"name"] -- save len bytes from addr to a file, or with no
002BEBr 2               ; name send them over XModem
002BEBr 2               BasCmdBsave:
002BEBr 2  20 rr rr             jsr     EvalAddrU16             ; addr
002BEEr 2  A5 12                lda     z:FAC+4
002BF0r 2  8D 7F 03             sta     FS_IO_ADDR
002BF3r 2  85 2A                sta     XFER_PTR
002BF5r 2  A5 11                lda     z:FAC+3
002BF7r 2  8D 80 03             sta     FS_IO_ADDR+1
002BFAr 2  85 2B                sta     XFER_PTR+1
002BFCr 2  20 rr rr             jsr     ChkCom
002BFFr 2  20 rr rr             jsr     EvalAddrU16             ; length in bytes
002C02r 2  A5 12                lda     z:FAC+4
002C04r 2  8D 4A 03             sta     FS_FILE_SIZE
002C07r 2  8D 17 03             sta     XFER_REMAIN
002C0Ar 2  A5 11                lda     z:FAC+3
002C0Cr 2  8D 4B 03             sta     FS_FILE_SIZE+1
002C0Fr 2  8D 18 03             sta     XFER_REMAIN+1
002C12r 2  20 rr rr             jsr     ChrGot
002C15r 2  D0 0A                bne     @cf
002C17r 2  A9 10                lda     #HW_SC
002C19r 2  20 rr rr             jsr     ReqHw
002C1Cr 2  20 rr rr             jsr     XModemSave
002C1Fr 2  80 0E                bra     @done
002C21r 2               @cf:
002C21r 2  A9 08                lda     #HW_CF
002C23r 2  20 rr rr             jsr     ReqHw
002C26r 2  20 rr rr             jsr     ChkCom
002C29r 2  20 rr rr             jsr     EvalString              ; filename
002C2Cr 2  20 rr rr             jsr     FsSaveFileAddr
002C2Fr 2               @done:
002C2Fr 2  B0 01                bcs     @err
002C31r 2  60                   rts
002C32r 2               @err:
002C32r 2  A9 rr                lda     #<MsgSaveErr
002C34r 2  A0 rr                ldy     #>MsgSaveErr
002C36r 2  4C rr rr             jmp     BasPrintStr
002C39r 2               
002C39r 2               ; FORMAT -- erase (zero) the current disk's directory, with confirmation
002C39r 2               BasCmdFormat:
002C39r 2  A9 08                lda     #HW_CF
002C3Br 2  20 rr rr             jsr     ReqHw
002C3Er 2  A9 rr                lda     #<MsgEraseDisk
002C40r 2  A0 rr                ldy     #>MsgEraseDisk
002C42r 2  20 rr rr             jsr     BasPrintStr
002C45r 2  AD 0F 03             lda     CF_DISK
002C48r 2  8D 4A 03             sta     FS_FILE_SIZE
002C4Br 2  9C 4B 03             stz     FS_FILE_SIZE+1
002C4Er 2  20 rr rr             jsr     FsPrintSize             ; print disk number (decimal)
002C51r 2  A9 rr                lda     #<MsgConfirm
002C53r 2  A0 rr                ldy     #>MsgConfirm
002C55r 2  20 rr rr             jsr     BasPrintStr
002C58r 2               @wait:
002C58r 2  20 rr rr             jsr     Chrin                   ; wait for a key (echoes)
002C5Br 2  90 FB                bcc     @wait
002C5Dr 2  29 DF                and     #$DF                    ; fold to uppercase
002C5Fr 2  48                   pha
002C60r 2  20 rr rr             jsr     BasPrintCRLF
002C63r 2  68                   pla
002C64r 2  C9 59                cmp     #'Y'
002C66r 2  D0 03                bne     @abort
002C68r 2  4C rr rr             jmp     FsFormatDisk            ; zero the directory (returns carry status)
002C6Br 2               @abort:
002C6Br 2  60                   rts
002C6Cr 2               
002C6Cr 2               ; ===========================================================================
002C6Cr 2               ;   P I C O V D P   S T A T E M E N T S
002C6Cr 2               ;
002C6Cr 2               ; Silent without a card, like CLS, LOCATE and COLOR: the arguments are parsed
002C6Cr 2               ; and range-checked, and then the Kernal entry each ends in skips.  Port A
002C6Cr 2               ; only, through the $A0B1-$A0D5 entries, so VID_MODE and the LxCTRL shadows
002C6Cr 2               ; stay true and BasTextConsole knows when a program has left Text mode.
002C6Cr 2               ; ===========================================================================
002C6Cr 2               
002C6Cr 2               ; SCREEN n -- 0 the Text console (InitVideo + CLS); 1 Compact, 2 Graphics,
002C6Cr 2               ; 3 Full.  The three graphics modes share one layout, which fits Full's 1200-
002C6Cr 2               ; byte tables (decision 2):
002C6Cr 2               ;
002C6Cr 2               ;   $0000 L0 names   $0800 L0 attributes   $1000 L1 names   $1800 L1 attributes
002C6Cr 2               ;   $2000 sprite attributes   $4000 L0 patterns   $8000 L1 patterns
002C6Cr 2               ;   $C000 sprite patterns
002C6Cr 2               ;
002C6Cr 2               ; Layer 0 4bpp with per-cell attributes, opaque and on; layer 1 the same but
002C6Cr 2               ; off and transparent; 64 sprites at 4bpp, all parked at Y = 240, below the
002C6Cr 2               ; picture.  The four tables at $0000-$1FFF are cleared; the pattern tables and
002C6Cr 2               ; the palette are the program's.  VMODE goes last, through VdpWriteReg, so
002C6Cr 2               ; VID_MODE says which mode the card is in.
002C6Cr 2               BasCmdScreen:
002C6Cr 2  A9 04                lda     #4                      ; 0-3
002C6Er 2  20 rr rr             jsr     GetByteLim              ; X = n
002C71r 2  8A                   txa
002C72r 2  D0 06                bne     @graphics
002C74r 2  20 rr rr             jsr     InitVideo
002C77r 2  4C rr rr             jmp     VideoClear              ; Both skip without a card
002C7Ar 2               @graphics:
002C7Ar 2  2C 0D 03             bit     HW_PRESENT              ; Video is bit 7
002C7Dr 2  10 42                bpl     @done
002C7Fr 2  48                   pha                             ; n
002C80r 2  A0 00                ldy     #0
002C82r 2               @reg:
002C82r 2  BE rr rr             ldx     ScreenLayout,y
002C85r 2  B9 rr rr             lda     ScreenLayout+1,y
002C88r 2  20 rr rr             jsr     VdpWriteReg             ; Keeps X and Y
002C8Br 2  C8                   iny
002C8Cr 2  C8                   iny
002C8Dr 2  C0 22                cpy     #(ScreenLayoutEnd - ScreenLayout)
002C8Fr 2  D0 F1                bne     @reg
002C91r 2  A9 40                lda     #$40                    ; $0000, write
002C93r 2  A2 00                ldx     #0
002C95r 2  A0 00                ldy     #0
002C97r 2  20 rr rr             jsr     VdpAddress
002C9Ar 2  A2 00                ldx     #0
002C9Cr 2  A0 20                ldy     #>$2000                 ; 32 pages, the four tables
002C9Er 2               @clear:
002C9Er 2  9C 00 9C             stz     VC_DATA
002CA1r 2  E8                   inx
002CA2r 2  D0 FA                bne     @clear
002CA4r 2  88                   dey
002CA5r 2  D0 F7                bne     @clear
002CA7r 2  A2 40                ldx     #64                     ; On into the sprite table at $2000
002CA9r 2               @sprite:
002CA9r 2  A9 F0                lda     #240                    ; Y: the line below a 240-line picture
002CABr 2  8D 00 9C             sta     VC_DATA
002CAEr 2  9C 00 9C             stz     VC_DATA                 ; X
002CB1r 2  9C 00 9C             stz     VC_DATA                 ; Pattern
002CB4r 2  9C 00 9C             stz     VC_DATA                 ; Attributes
002CB7r 2  CA                   dex
002CB8r 2  D0 EF                bne     @sprite
002CBAr 2  68                   pla
002CBBr 2  1A                   inc     a                       ; SCREEN 1-3 is VMODE 2-4
002CBCr 2  A2 0D                ldx     #VDP_VMODE
002CBEr 2  4C rr rr             jmp     VdpWriteReg
002CC1r 2               @done:
002CC1r 2  60                   rts
002CC2r 2               
002CC2r 2               ScreenLayout:                           ; Register, value
002CC2r 2  01 40                .byte   VDP_MODE1,    $40       ; Display on, 8x8 sprites unmagnified
002CC4r 2  10 00                .byte   VDP_L0NAME,   $00       ; $0000
002CC6r 2  11 02                .byte   VDP_L0ATTR,   $02       ; $0800
002CC8r 2  12 08                .byte   VDP_L0PAT,    $08       ; $4000
002CCAr 2  13 00                .byte   VDP_L0SCRX,   $00
002CCCr 2  14 00                .byte   VDP_L0SCRY,   $00
002CCEr 2  15 32                .byte   VDP_L0CTRL,   $32       ; 4bpp, per cell, on, index 0 opaque
002CD0r 2  18 04                .byte   VDP_L1NAME,   $04       ; $1000
002CD2r 2  19 06                .byte   VDP_L1ATTR,   $06       ; $1800
002CD4r 2  1A 10                .byte   VDP_L1PAT,    $10       ; $8000
002CD6r 2  1B 00                .byte   VDP_L1SCRX,   $00
002CD8r 2  1C 00                .byte   VDP_L1SCRY,   $00
002CDAr 2  1D 02                .byte   VDP_L1CTRL,   $02       ; 4bpp, per cell, off, index 0 clear
002CDCr 2  20 40                .byte   VDP_SPRATTR,  $40       ; $2000, where VdpSprite writes
002CDEr 2  21 18                .byte   VDP_SPRPAT,   $18       ; $C000
002CE0r 2  22 40                .byte   VDP_SPRCOUNT, 64
002CE2r 2  23 23                .byte   VDP_SPRCTRL,  $23       ; On, collisions, no $D0 end, 4bpp
002CE4r 2               ScreenLayoutEnd:
002CE4r 2               
002CE4r 2               ; VPOKE addr, value -- a byte anywhere in the 64 KB of VRAM
002CE4r 2               ; The address rides the stack across the value's evaluation, as POKE's does.
002CE4r 2               BasCmdVpoke:
002CE4r 2  20 rr rr             jsr     EvalAddrU16
002CE7r 2  A5 12                lda     FAC+4                   ; lo
002CE9r 2  48                   pha
002CEAr 2  A5 11                lda     FAC+3                   ; hi
002CECr 2  48                   pha
002CEDr 2  20 rr rr             jsr     GetComByt               ; X = value
002CF0r 2  8A                   txa
002CF1r 2  7A                   ply                             ; hi
002CF2r 2  FA                   plx                             ; lo
002CF3r 2  4C rr rr             jmp     VdpPoke
002CF6r 2               
002CF6r 2               ; VREG reg, value -- write register 0-127, through VdpWriteReg
002CF6r 2               BasCmdVreg:
002CF6r 2  A9 80                lda     #128
002CF8r 2  20 rr rr             jsr     GetByteLim              ; X = reg
002CFBr 2  DA                   phx
002CFCr 2  20 rr rr             jsr     GetComByt               ; X = value
002CFFr 2  8A                   txa
002D00r 2  FA                   plx
002D01r 2  4C rr rr             jmp     VdpWriteReg
002D04r 2               
002D04r 2               ; PALETTE index, r, g, b -- palette entry 0-255 at $FC00 + 2 * index, 0-15 each
002D04r 2               BasCmdPalette:
002D04r 2  20 rr rr             jsr     GetByt                  ; X = index
002D07r 2  DA                   phx
002D08r 2  A9 10                lda     #16
002D0Ar 2  20 rr rr             jsr     GetComByteLim           ; X = r
002D0Dr 2  DA                   phx
002D0Er 2  A9 10                lda     #16
002D10r 2  20 rr rr             jsr     GetComByteLim           ; X = g
002D13r 2  DA                   phx
002D14r 2  A9 10                lda     #16
002D16r 2  20 rr rr             jsr     GetComByteLim           ; X = b
002D19r 2  86 3A                stx     BAS_TMP1
002D1Br 2  68                   pla                             ; g
002D1Cr 2  0A                   asl     a
002D1Dr 2  0A                   asl     a
002D1Er 2  0A                   asl     a
002D1Fr 2  0A                   asl     a
002D20r 2  05 3A                ora     BAS_TMP1
002D22r 2  A8                   tay                             ; $GB
002D23r 2  68                   pla                             ; $0R
002D24r 2  FA                   plx                             ; index
002D25r 2  4C rr rr             jmp     VdpSetPalette
002D28r 2               
002D28r 2               ; VSYNC -- wait for the start of the next vertical blank (2 cs without a card)
002D28r 2               BasCmdVsync     := WaitVBlank
002D28r 2               
002D28r 2               ; VLOAD "name", addr -- a file from the current disk into VRAM at addr, its
002D28r 2               ; exact length.  A data statement, so no CF card is ?NO DEVICE; no video card
002D28r 2               ; reads nothing and says nothing.
002D28r 2               BasCmdVload:
002D28r 2  A9 08                lda     #HW_CF
002D2Ar 2  20 rr rr             jsr     ReqHw
002D2Dr 2  20 rr rr             jsr     EvalString              ; -> BAS_FNAME, STR_PTR
002D30r 2  20 rr rr             jsr     ChkCom
002D33r 2  20 rr rr             jsr     EvalAddrU16
002D36r 2  A5 12                lda     FAC+4
002D38r 2  8D 7F 03             sta     FS_IO_ADDR
002D3Br 2  A5 11                lda     FAC+3
002D3Dr 2  8D 80 03             sta     FS_IO_ADDR+1
002D40r 2  2C 0D 03             bit     HW_PRESENT              ; Video is bit 7
002D43r 2  10 08                bpl     @done
002D45r 2  20 rr rr             jsr     VdpLoadFile
002D48r 2  90 03                bcc     @done
002D4Ar 2  4C rr rr             jmp     BasLoadErr
002D4Dr 2               @done:
002D4Dr 2  60                   rts
002D4Er 2               
002D4Er 2               ; VPEEK(addr) -- the VRAM byte at addr; 0 without a card
002D4Er 2               FnVpeek:
002D4Er 2  20 rr rr             jsr     ParenNum
002D51r 2  20 rr rr             jsr     FacToU16
002D54r 2  A6 12                ldx     FAC+4
002D56r 2  A4 11                ldy     FAC+3
002D58r 2  A9 00                lda     #0                      ; What VdpPeek leaves in A without a card
002D5Ar 2  20 rr rr             jsr     VdpPeek
002D5Dr 2  A8                   tay
002D5Er 2  4C rr rr             jmp     SngFlt
002D61r 2               
002D61r 2               ; SPRITE n, x, y, pattern[, attr] -- sprite n (0-63) at x (0-511, 384-511 being
002D61r 2               ; -128 to -1), y (0-255), with pattern (0-255) and attributes (0-127, default
002D61r 2               ; 0; b6 priority, b5:4 flips, b3:0 sub-palette).  VdpSprite writes the four
002D61r 2               ; bytes at $2000 + 4n, where SCREEN 1-3 put the table, with x's bit 8 as the
002D61r 2               ; attribute's b7.
002D61r 2               BasCmdSprite:
002D61r 2  A9 40                lda     #64
002D63r 2  20 rr rr             jsr     GetByteLim              ; X = n
002D66r 2  DA                   phx
002D67r 2  20 rr rr             jsr     ChkCom
002D6Ar 2  20 rr rr             jsr     EvalAddrU16             ; x
002D6Dr 2  A5 11                lda     FAC+3
002D6Fr 2  C9 02                cmp     #2
002D71r 2  B0 31                bcs     BasVdpRangeErr          ; 512 and up
002D73r 2  8D 9B 03             sta     VDP_P3                  ; Bit 8, until the attributes are in
002D76r 2  A5 12                lda     FAC+4
002D78r 2  8D 99 03             sta     VDP_P1
002D7Br 2  20 rr rr             jsr     GetComByt               ; X = y
002D7Er 2  8E 98 03             stx     VDP_P0
002D81r 2  20 rr rr             jsr     GetComByt               ; X = pattern
002D84r 2  8E 9A 03             stx     VDP_P2
002D87r 2  A2 00                ldx     #0                      ; attr if none is given
002D89r 2  20 rr rr             jsr     ChrGot
002D8Cr 2  C9 2C                cmp     #','
002D8Er 2  D0 05                bne     @attr
002D90r 2  A9 80                lda     #128
002D92r 2  20 rr rr             jsr     GetComByteLim           ; X = attr
002D95r 2               @attr:
002D95r 2  8A                   txa
002D96r 2  4E 9B 03             lsr     VDP_P3                  ; Bit 8 into carry
002D99r 2  90 02                bcc     @low
002D9Br 2  09 80                ora     #$80
002D9Dr 2               @low:
002D9Dr 2  8D 9B 03             sta     VDP_P3
002DA0r 2  FA                   plx                             ; n
002DA1r 2  4C rr rr             jmp     VdpSprite
002DA4r 2               
002DA4r 2               BasVdpRangeErr:
002DA4r 2  4C rr rr             jmp     IqErr
002DA7r 2               
002DA7r 2               ; SCROLL layer, x, y -- scroll layer 0-1 to x (0-319), y (0-255)
002DA7r 2               BasCmdScroll:
002DA7r 2  A9 02                lda     #2
002DA9r 2  20 rr rr             jsr     GetByteLim              ; X = layer
002DACr 2  DA                   phx
002DADr 2  20 rr rr             jsr     ChkCom
002DB0r 2  20 rr rr             jsr     EvalAddrU16             ; x
002DB3r 2  A5 11                lda     FAC+3
002DB5r 2  8D 98 03             sta     VDP_P0                  ; Bit 8
002DB8r 2  F0 0A                beq     @x
002DBAr 2  C9 01                cmp     #1
002DBCr 2  D0 E6                bne     BasVdpRangeErr
002DBEr 2  A5 12                lda     FAC+4
002DC0r 2  C9 40                cmp     #64                     ; 256 + 64 = 320
002DC2r 2  B0 E0                bcs     BasVdpRangeErr
002DC4r 2               @x:
002DC4r 2  A5 12                lda     FAC+4
002DC6r 2  48                   pha
002DC7r 2  20 rr rr             jsr     GetComByt               ; X = y
002DCAr 2  8A                   txa
002DCBr 2  A8                   tay
002DCCr 2  68                   pla                             ; x bits 7:0
002DCDr 2  FA                   plx                             ; layer
002DCEr 2  4C rr rr             jmp     VdpSetScroll
002DD1r 2               
002DD1r 2               ; LAYER layer, on -- hide layer 0-1 (on = 0) or show it
002DD1r 2               BasCmdLayer:
002DD1r 2  A9 02                lda     #2
002DD3r 2  20 rr rr             jsr     GetByteLim              ; X = layer
002DD6r 2  DA                   phx
002DD7r 2  20 rr rr             jsr     GetComByt               ; X = on
002DDAr 2  8A                   txa
002DDBr 2  FA                   plx
002DDCr 2  4C rr rr             jmp     VdpLayer
002DDFr 2               
002DDFr 2               ; VSTAT(n) -- status register n, 0-15; 0 without a card.  VSTAT(0) clears
002DDFr 2               ; STAT0's flags, as reading it does.
002DDFr 2               FnVstat:
002DDFr 2  20 rr rr             jsr     ParenU8                 ; A = n
002DE2r 2  C9 10                cmp     #16
002DE4r 2  B0 BE                bcs     BasVdpRangeErr
002DE6r 2  AA                   tax
002DE7r 2  A9 00                lda     #0                      ; What VdpStatus leaves in A without a card
002DE9r 2  20 rr rr             jsr     VdpStatus
002DECr 2  A8                   tay
002DEDr 2  4C rr rr             jmp     SngFlt
002DF0r 2               
002DF0r 2               ; ===========================================================================
002DF0r 2               ;   S A V E   S L O T   S T A T E M E N T S
002DF0r 2               ;
002DF0r 2               ; The Kernal's NvWrite, NvRead, NvErase, NvStat and NvFind, slot for slot
002DF0r 2               ; (decision 3).  Like NVRAM, the statements raise ?NO DEVICE without an RTC
002DF0r 2               ; card, and the functions answer quietly instead: NVSTAT is 0 (free), NVFIND
002DF0r 2               ; -1 (nothing found).  The owner ID of a slot stays readable as NVRAM(slot*16).
002DF0r 2               ; ===========================================================================
002DF0r 2               
002DF0r 2               ; NVSAVE slot, id, addr -- the 14 bytes at addr into slot 0-15, owner id 1-255
002DF0r 2               BasCmdNvsave:
002DF0r 2  A9 04                lda     #HW_RTC
002DF2r 2  20 rr rr             jsr     ReqHw
002DF5r 2  A9 10                lda     #NV_SLOTS
002DF7r 2  20 rr rr             jsr     GetByteLim              ; X = slot
002DFAr 2  DA                   phx
002DFBr 2  20 rr rr             jsr     GetComByt               ; X = id
002DFEr 2  8E 90 03             stx     NV_ID                   ; Kernal RAM: safe across FrmEvl
002E01r 2  8A                   txa
002E02r 2  F0 0E                beq     BasNvRangeErr           ; ID 0 marks a free slot
002E04r 2  20 rr rr             jsr     ChkCom
002E07r 2  20 rr rr             jsr     EvalAddrU16             ; addr
002E0Ar 2  A5 12                lda     FAC+4
002E0Cr 2  A4 11                ldy     FAC+3
002E0Er 2  FA                   plx                             ; slot
002E0Fr 2  4C rr rr             jmp     NvWrite                 ; Nothing left for it to refuse
002E12r 2               
002E12r 2               BasNvRangeErr:
002E12r 2  4C rr rr             jmp     IqErr
002E15r 2               
002E15r 2               ; NVLOAD slot, addr -- a valid slot's 14 bytes to addr; ?LOAD ERROR, and
002E15r 2               ; nothing copied, for a free or damaged one
002E15r 2               BasCmdNvload:
002E15r 2  A9 04                lda     #HW_RTC
002E17r 2  20 rr rr             jsr     ReqHw
002E1Ar 2  A9 10                lda     #NV_SLOTS
002E1Cr 2  20 rr rr             jsr     GetByteLim              ; X = slot
002E1Fr 2  DA                   phx
002E20r 2  20 rr rr             jsr     ChkCom
002E23r 2  20 rr rr             jsr     EvalAddrU16             ; addr
002E26r 2  A5 12                lda     FAC+4
002E28r 2  A4 11                ldy     FAC+3
002E2Ar 2  FA                   plx                             ; slot
002E2Br 2  20 rr rr             jsr     NvRead
002E2Er 2  90 03                bcc     @done
002E30r 2  4C rr rr             jmp     BasLoadErr
002E33r 2               @done:
002E33r 2  60                   rts
002E34r 2               
002E34r 2               ; NVERASE slot -- zero all 16 bytes of slot 0-15
002E34r 2               BasCmdNverase:
002E34r 2  A9 04                lda     #HW_RTC
002E36r 2  20 rr rr             jsr     ReqHw
002E39r 2  A9 10                lda     #NV_SLOTS
002E3Br 2  20 rr rr             jsr     GetByteLim              ; X = slot
002E3Er 2  4C rr rr             jmp     NvErase
002E41r 2               
002E41r 2               ; NVSTAT(slot) -- 0 free, 1 valid, 2 damaged
002E41r 2               FnNvstat:
002E41r 2  20 rr rr             jsr     ParenU8                 ; A = slot
002E44r 2  C9 10                cmp     #NV_SLOTS
002E46r 2  B0 CA                bcs     BasNvRangeErr
002E48r 2  AA                   tax
002E49r 2  20 rr rr             jsr     NvStat                  ; Carry: no RTC card
002E4Cr 2  90 02                bcc     @status
002E4Er 2  A9 00                lda     #NV_EMPTY
002E50r 2               @status:
002E50r 2  A8                   tay
002E51r 2  4C rr rr             jmp     SngFlt
002E54r 2               
002E54r 2               ; NVFIND(id) -- the lowest slot owned by id (0: the lowest free slot), or -1
002E54r 2               FnNvfind:
002E54r 2  20 rr rr             jsr     ParenU8                 ; A = id
002E57r 2  20 rr rr             jsr     NvFind                  ; X = slot; carry: none, or no RTC card
002E5Ar 2  B0 05                bcs     @none
002E5Cr 2  8A                   txa
002E5Dr 2  A8                   tay
002E5Er 2  4C rr rr             jmp     SngFlt
002E61r 2               @none:
002E61r 2  A9 FF                lda     #$FF                    ; -1
002E63r 2  A8                   tay
002E64r 2  4C rr rr             jmp     GivAyf
002E67r 2               
002E67r 2  20 42 59 54  MsgFree:        .byte   " BYTES FREE  HW=",0
002E6Br 2  45 53 20 46  
002E6Fr 2  52 45 45 20  
002E78r 2  3F 4C 4F 41  MsgLoadErr:     .byte   "?LOAD ERROR",$0D,$0A,0
002E7Cr 2  44 20 45 52  
002E80r 2  52 4F 52 0D  
002E86r 2  3F 53 41 56  MsgSaveErr:     .byte   "?SAVE ERROR",$0D,$0A,0
002E8Ar 2  45 20 45 52  
002E8Er 2  52 4F 52 0D  
002E94r 2  3F 44 45 4C  MsgDelErr:      .byte   "?DEL ERROR",$0D,$0A,0
002E98r 2  20 45 52 52  
002E9Cr 2  4F 52 0D 0A  
002EA1r 2  45 52 41 53  MsgEraseDisk:   .byte   "ERASE DISK ",0
002EA5r 2  45 20 44 49  
002EA9r 2  53 4B 20 00  
002EADr 2  3F 20 28 59  MsgConfirm:     .byte   "? (Y/N) ",0
002EB1r 2  2F 4E 29 20  
002EB5r 2  00           
002EB6r 2               
002EB6r 2               ; Wrappers so the dispatch table can call existing routines that expect
002EB6r 2               ; TXTPTR positioned already.
002EB6r 2               BasCmdPrintW:
002EB6r 2                       ; We were entered via the dispatch trampoline, so TXTPTR is already
002EB6r 2                       ; past the PRINT token (ChrGet was tail-called).  But BasCmdPrint
002EB6r 2                       ; expects to consume the token itself with its first ChrGet; rewind.
002EB6r 2                       ; Easier: BasCmdPrint reads via ChrGet; here ChrGet was called before
002EB6r 2                       ; routine entry, so TXTPTR currently points at first arg.  Just call
002EB6r 2                       ; an internal entry that skips the leading ChrGet.
002EB6r 2  4C rr rr             jmp     BasPrLoop
002EB9r 2               
002EB9r 2               ; ---------------------------------------------------------------------------
002EB9r 2               ; Token-address dispatch table.  Indexed by (token - $80).  Each entry is
002EB9r 2               ; (routine_address - 1) since the dispatcher PHA-pushes it and uses the
002EB9r 2               ; "JMP ChrGet -> RTS" trick to enter.
002EB9r 2               ; ---------------------------------------------------------------------------
002EB9r 2               BasTokenAddrTbl:
002EB9r 2  rr rr                .word   BasCmdEnd-1             ; $80 END
