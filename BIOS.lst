002980r 2  86 3C                stx     BAS_TMP2
002982r 2               @poll:
002982r 2  20 rr rr             jsr     BasCheckBreak
002985r 2  A0 00                ldy     #0
002987r 2  B1 3A                lda     (BAS_TMP1),y
002989r 2  25 3C                and     BAS_TMP2
