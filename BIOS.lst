001223r 2               ; ---------------------------------------------------------------------------
001223r 2               ; PtrGet -- find or create a scalar variable.
001223r 2               ; On entry : ChrGot-equivalent state; TXTPTR points at first char of name.
001223r 2               ; On exit  : VARPNT = address of variable's value bytes; (Y,A) = same.
001223r 2               ;            VARNAM = encoded name (with type bits in bit 7s).
001223r 2               ;            VALTYP = $00 numeric, $FF string.
001223r 2               ; ---------------------------------------------------------------------------
001223r 2               PtrGet:
001223r 2  A2 00                ldx     #$00
001225r 2  20 rr rr             jsr     ChrGot
001228r 2               PtrGet2:
001228r 2  86 63                stx     DIMFLG
00122Ar 2               PtrGet3:
00122Ar 2  85 7B                sta     VARNAM
00122Cr 2  20 rr rr             jsr     ChrGot
00122Fr 2  20 rr rr             jsr     IsLetC
001232r 2  B0 03                bcs     @nameok
001234r 2  4C rr rr             jmp     SynErr
001237r 2               @nameok:
001237r 2  A2 00                ldx     #$00
001239r 2  86 64                stx     VALTYP
00123Br 2  86 65                stx     VALTYP+1
00123Dr 2  20 rr rr             jsr     ChrGet
001240r 2  90 05                bcc     @second                 ; digit -> second char of name
001242r 2  20 rr rr             jsr     IsLetC
001245r 2  90 0B                bcc     @aftername              ; not letter -> done with chars
001247r 2               @second:
001247r 2  AA                   tax                             ; remember second char
001248r 2               @strip:
001248r 2  20 rr rr             jsr     ChrGet
00124Br 2  90 FB                bcc     @strip
00124Dr 2  20 rr rr             jsr     IsLetC
001250r 2  B0 F6                bcs     @strip
001252r 2               @aftername:
001252r 2  C9 24                cmp     #'$'
001254r 2  D0 06                bne     @notstr
001256r 2  A9 FF                lda     #$FF
001258r 2  85 64                sta     VALTYP
00125Ar 2  D0 09                bne     @typedone
00125Cr 2               @notstr:
00125Cr 2  C9 25                cmp     #'%'
00125Er 2  D0 03                bne     @typeskip               ; integer-percent unsupported -> ignore
001260r 2  4C rr rr             jmp     SynErr                  ; reject A% style
001263r 2               @typeskip:
001263r 2               @nottype:
