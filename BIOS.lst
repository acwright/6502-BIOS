0027EFr 2               
0027EFr 2               ; BasFixChain -- recompute end-of-program pointers after a program image load.
0027EFr 2               ; A program image is the raw bytes belonging at $0800 up: a tokenized line chain
0027EFr 2               ; and, for a .prg, machine code sitting past the chain's $0000 terminator.  A
0027EFr 2               ; chain walk alone only ever finds the end of the BASIC part, so the loader's
0027EFr 2               ; byte count has to be taken into account too.
0027EFr 2               ;   Input:  A = loaded image size lo, Y = size hi (0 = size unknown; chain only)
0027EFr 2               ;   Output: BAS_VARTAB = BAS_ARYTAB = BAS_STREND
0027EFr 2               ;             = max(chain-end + 2, PROGRAM_START + size)
0027EFr 2               ;   Note:   a size that would push the result past BAS_MEMSIZ is rejected and the
0027EFr 2               ;           chain-end candidate is used instead.
0027EFr 2               ; Mirroring VARTAB into ARYTAB/STREND matters on its own: Makenewvariable places
0027EFr 2               ; a new scalar at ARYTAB, so leaving it at its post-NEW $0802 makes the first
0027EFr 2               ; direct-mode assignment after a LOAD overwrite the program's first line.
0027EFr 2                       .assert (PROGRAM_START & $FF) = 0, error, "PROGRAM_START must be page-aligned"
0027EFr 2               BasFixChain:
0027EFr 2  85 3C                sta     BAS_TMP2                ; BAS_TMP2 = PROGRAM_START + size; the
0027F1r 2  98                   tya                             ; low byte passes through untouched
0027F2r 2  18                   clc                             ; because PROGRAM_START is page-aligned
0027F3r 2  69 08                adc     #>PROGRAM_START
0027F5r 2  85 3D                sta     BAS_TMP2+1
0027F7r 2  64 20                stz     INDEX
0027F9r 2  A9 08                lda     #>PROGRAM_START
0027FBr 2  85 21                sta     INDEX+1
0027FDr 2               @walk:
0027FDr 2  A0 01                ldy     #1
0027FFr 2  B1 20                lda     (INDEX),y               ; next-ptr hi
002801r 2  85 3A                sta     BAS_TMP1
002803r 2  88                   dey
002804r 2  11 20                ora     (INDEX),y               ; both bytes zero -> terminator
002806r 2  F0 15                beq     @end
002808r 2                       ; Lines ascend in memory.  LOAD accepts any file, so a corrupt or
002808r 2                       ; cyclic chain is reachable here — stop at the last good line rather
002808r 2                       ; than loop forever.
002808r 2  38                   sec
002809r 2  A5 20                lda     INDEX
00280Br 2  F1 20                sbc     (INDEX),y
00280Dr 2  A5 21                lda     INDEX+1
00280Fr 2  E5 3A                sbc     BAS_TMP1
002811r 2  B0 0A                bcs     @end                    ; current >= next -> not a real chain
002813r 2  B1 20                lda     (INDEX),y               ; next-ptr lo
002815r 2  85 20                sta     INDEX
002817r 2  A5 3A                lda     BAS_TMP1
002819r 2  85 21                sta     INDEX+1
00281Br 2  80 E0                bra     @walk
00281Dr 2               @end:
00281Dr 2                       ; INDEX points at terminator ($00 $00).  Candidate A = INDEX + 2.
00281Dr 2  18                   clc
00281Er 2  A5 20                lda     INDEX
002820r 2  69 02                adc     #2
002822r 2  8D 5F 03             sta     BAS_VARTAB
002825r 2  A5 21                lda     INDEX+1
002827r 2  69 00                adc     #0
002829r 2  8D 60 03             sta     BAS_VARTAB+1
00282Cr 2                       ; Candidate B = BAS_TMP2.  Keep it only when A <= B <= MEMSIZ, so a
00282Cr 2                       ; short or absent size loses the max and a bogus one cannot push
00282Cr 2                       ; VARTAB out of memory.
00282Cr 2  38                   sec
00282Dr 2  A5 3C                lda     BAS_TMP2
00282Fr 2  ED 5F 03             sbc     BAS_VARTAB
002832r 2  A5 3D                lda     BAS_TMP2+1
002834r 2  ED 60 03             sbc     BAS_VARTAB+1
002837r 2  90 17                bcc     @mirror                 ; B < A -> keep A
002839r 2  38                   sec
00283Ar 2  AD 67 03             lda     BAS_MEMSIZ
00283Dr 2  E5 3C                sbc     BAS_TMP2
00283Fr 2  AD 68 03             lda     BAS_MEMSIZ+1
002842r 2  E5 3D                sbc     BAS_TMP2+1
002844r 2  90 0A                bcc     @mirror                 ; B > MEMSIZ -> reject, keep A
002846r 2  A5 3C                lda     BAS_TMP2
002848r 2  8D 5F 03             sta     BAS_VARTAB
00284Br 2  A5 3D                lda     BAS_TMP2+1
00284Dr 2  8D 60 03             sta     BAS_VARTAB+1
002850r 2               @mirror:
002850r 2                       ; ARYTAB / STREND follow VARTAB on a fresh load: no variables yet.
002850r 2  A2 01                ldx     #1
002852r 2               @copy:
002852r 2  BD 5F 03             lda     BAS_VARTAB,x
002855r 2  9D 61 03             sta     BAS_ARYTAB,x
002858r 2  9D 63 03             sta     BAS_STREND,x
00285Br 2  CA                   dex
00285Cr 2  10 F4                bpl     @copy
00285Er 2  60                   rts
00285Fr 2               
