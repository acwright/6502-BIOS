00086Br 2                 ; Check if MON_ADDR > MON_END
00086Br 2  A5 31          lda MON_END+1
00086Dr 2  C5 2F          cmp MON_ADDR+1
00086Fr 2  90 08          bcc @DisDone
000871r 2  D0 F3          bne @DisRange
000873r 2  A5 30          lda MON_END
000875r 2  C5 2E          cmp MON_ADDR
