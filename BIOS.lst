00320Cr 2  49 4C 4C 45          .byte   "ILLEGAL QUANTITY",0    ; ERR_ILLQUAN
003210r 2  47 41 4C 20  
003214r 2  51 55 41 4E  
00321Dr 2  52 45 54 55          .byte   "RETURN WITHOUT GOSUB",0; ERR_RG
003221r 2  52 4E 20 57  
003225r 2  49 54 48 4F  
003232r 2  4E 45 58 54          .byte   "NEXT WITHOUT FOR",0    ; ERR_NF
003236r 2  20 57 49 54  
00323Ar 2  48 4F 55 54  
003243r 2  4F 55 54 20          .byte   "OUT OF DATA",0         ; ERR_OD
003247r 2  4F 46 20 44  
