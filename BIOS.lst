0027D9r 2               @loop:
0027D9r 2  C9 0A                cmp     #10
0027DBr 2  90 05                bcc     @done
0027DDr 2  E9 0A                sbc     #10
0027DFr 2  E8                   inx
0027E0r 2  80 F7                bra     @loop
0027E2r 2               @done:
0027E2r 2  48                   pha
0027E3r 2  8A                   txa
0027E4r 2  09 30                ora     #'0'
0027E6r 2  20 rr rr             jsr     Chrout
0027E9r 2  68                   pla
0027EAr 2  09 30                ora     #'0'
