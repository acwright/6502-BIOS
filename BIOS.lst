000000r 2               
000000r 2               ; Machine Code Monitor — Supermon-style command set
000000r 2               ; Segment: $EE00-$FEFF (~4KB)
000000r 2               ;
000000r 2               ; Entry points:
000000r 2               ;   MonitorEntry    ($EE00) — Cold entry from boot menu or X return
000000r 2               ;   MonitorBrkEntry ($EE03) — BRK entry with register display
000000r 2               
000000r 2               ; ============================================================================
000000r 2               ; Monitor Constants
000000r 2               ; ============================================================================
000000r 2               
000000r 2               MON_LINBUF          = BAS_LINBUF         ; Share BASIC's line buffer ($0434)
000000r 2               MON_LINBUF_SIZE     = 200                ; Max input line length
000000r 2               MON_PROMPT          = '.'                ; Supermon-style prompt character
000000r 2               
000000r 2               ; Mnemonic Indices (for disassembler)
000000r 2               MN_ADC = 0
000000r 2               MN_AND = 1
000000r 2               MN_ASL = 2
000000r 2               MN_BBR = 3
000000r 2               MN_BBS = 4
000000r 2               MN_BCC = 5
000000r 2               MN_BCS = 6
000000r 2               MN_BEQ = 7
000000r 2               MN_BIT = 8
000000r 2               MN_BMI = 9
000000r 2               MN_BNE = 10
000000r 2               MN_BPL = 11
000000r 2               MN_BRA = 12
000000r 2               MN_BRK = 13
000000r 2               MN_BVC = 14
000000r 2               MN_BVS = 15
000000r 2               MN_CLC = 16
000000r 2               MN_CLD = 17
000000r 2               MN_CLI = 18
000000r 2               MN_CLV = 19
000000r 2               MN_CMP = 20
000000r 2               MN_CPX = 21
000000r 2               MN_CPY = 22
000000r 2               MN_DEC = 23
000000r 2               MN_DEX = 24
000000r 2               MN_DEY = 25
000000r 2               MN_EOR = 26
000000r 2               MN_INC = 27
000000r 2               MN_INX = 28
000000r 2               MN_INY = 29
000000r 2               MN_JMP = 30
000000r 2               MN_JSR = 31
000000r 2               MN_LDA = 32
000000r 2               MN_LDX = 33
000000r 2               MN_LDY = 34
000000r 2               MN_LSR = 35
000000r 2               MN_NOP = 36
000000r 2               MN_ORA = 37
000000r 2               MN_PHA = 38
000000r 2               MN_PHP = 39
000000r 2               MN_PHX = 40
000000r 2               MN_PHY = 41
000000r 2               MN_PLA = 42
000000r 2               MN_PLP = 43
000000r 2               MN_PLX = 44
000000r 2               MN_PLY = 45
000000r 2               MN_RMB = 46
000000r 2               MN_ROL = 47
000000r 2               MN_ROR = 48
000000r 2               MN_RTI = 49
000000r 2               MN_RTS = 50
000000r 2               MN_SBC = 51
000000r 2               MN_SEC = 52
000000r 2               MN_SED = 53
000000r 2               MN_SEI = 54
000000r 2               MN_SMB = 55
000000r 2               MN_STA = 56
000000r 2               MN_STP = 57
000000r 2               MN_STX = 58
000000r 2               MN_STY = 59
000000r 2               MN_STZ = 60
000000r 2               MN_TAX = 61
000000r 2               MN_TAY = 62
000000r 2               MN_TRB = 63
000000r 2               MN_TSB = 64
000000r 2               MN_TSX = 65
000000r 2               MN_TXA = 66
000000r 2               MN_TXS = 67
000000r 2               MN_TYA = 68
000000r 2               MN_WAI = 69
000000r 2               MN_UND = 70
000000r 2               
000000r 2               ; Addressing Mode Indices
000000r 2               AM_IMP = 0
000000r 2               AM_ACC = 1
000000r 2               AM_IMM = 2
000000r 2               AM_ZP  = 3
000000r 2               AM_ZPX = 4
000000r 2               AM_ZPY = 5
000000r 2               AM_ABS = 6
000000r 2               AM_ABX = 7
000000r 2               AM_ABY = 8
000000r 2               AM_IND = 9
000000r 2               AM_IZX = 10
000000r 2               AM_IZY = 11
000000r 2               AM_ZPI = 12
000000r 2               AM_REL = 13
000000r 2               AM_ZPR = 14
000000r 2               AM_AIX = 15
000000r 2               
000000r 2               ; ============================================================================
000000r 2               ; Entry Points
000000r 2               ; ============================================================================
000000r 2               
000000r 2               MonitorEntry:
000000r 2  4C rr rr       jmp MonColdEntry              ; $EE00 - Cold entry (boot menu / return)
000003r 2               
000003r 2               MonitorBrkEntry:
000003r 2  4C rr rr       jmp MonBrkEntry               ; $C003 - BRK entry (register display)
000006r 2               
000006r 2               ; ============================================================================
000006r 2               ; Cold Entry — print banner and enter command loop
000006r 2               ; ============================================================================
000006r 2               
000006r 2               MonColdEntry:
000006r 2  A2 FF          ldx #$FF
000008r 2  9A             txs                           ; Reset stack pointer
000009r 2  D8             cld                           ; Ensure binary mode
00000Ar 2  20 rr rr       jsr VideoClear                ; Clear screen
00000Dr 2  20 rr rr       jsr MonPrintBanner            ; Print "MONITOR" banner
000010r 2  4C rr rr       jmp MonCmdLoop
000013r 2               
000013r 2               ; ============================================================================
000013r 2               ; BRK Entry — print BRK address, display registers, enter command loop
000013r 2               ; ============================================================================
000013r 2               
000013r 2               MonBrkEntry:
000013r 2  A2 FF          ldx #$FF
000015r 2  9A             txs                           ; Reset stack pointer
000016r 2  D8             cld
000017r 2  20 rr rr       jsr VideoClear                ; Clear screen
00001Ar 2  20 rr rr       jsr MonPrintBanner            ; Print "MONITOR" banner
00001Dr 2                 ; Print "BRK AT $"
00001Dr 2  A2 00          ldx #0
00001Fr 2               @BrkMsgLoop:
00001Fr 2  BD rr rr       lda MonStrBrk,x
000022r 2  F0 06          beq @BrkMsgDone
000024r 2  20 rr rr       jsr Chrout
000027r 2  E8             inx
000028r 2  80 F5          bra @BrkMsgLoop
00002Ar 2               @BrkMsgDone:
00002Ar 2                 ; Print PC address (adjusted: BRK_PC points to BRK+2, subtract 2 for actual BRK location)
00002Ar 2  38             sec
00002Br 2  AD 11 03       lda BRK_PCL
00002Er 2  E9 02          sbc #2
000030r 2  85 2E          sta MON_ADDR
000032r 2  AD 12 03       lda BRK_PCH
000035r 2  E9 00          sbc #0
000037r 2  85 2F          sta MON_ADDR + 1
000039r 2  20 rr rr       jsr MonPrintHex4
00003Cr 2  20 rr rr       jsr MonPrintCRLF
00003Fr 2                 ; Display registers
00003Fr 2  20 rr rr       jsr MonShowRegs
000042r 2  4C rr rr       jmp MonCmdLoop
000045r 2               
000045r 2               ; ============================================================================
000045r 2               ; Command Loop — prompt, read, parse, dispatch
000045r 2               ; ============================================================================
000045r 2               
000045r 2               MonCmdLoop:
000045r 2                 ; Print prompt
000045r 2  A9 2E          lda #MON_PROMPT
000047r 2  20 rr rr       jsr Chrout
00004Ar 2  A9 20          lda #' '
00004Cr 2  20 rr rr       jsr Chrout
00004Fr 2               
00004Fr 2                 ; Read input line
00004Fr 2  20 rr rr       jsr MonReadLine
000052r 2               
000052r 2                 ; Parse and dispatch
000052r 2  20 rr rr       jsr MonParseLine
000055r 2               
000055r 2                 ; Loop back for next command
000055r 2  4C rr rr       jmp MonCmdLoop
000058r 2               
000058r 2               ; ============================================================================
000058r 2               ; MonReadLine — Read a line of input into MON_LINBUF
000058r 2               ; Returns: MON_LINBUF contains null-terminated input, Y = length
000058r 2               ; ============================================================================
000058r 2               
000058r 2               MonReadLine:
000058r 2  A0 00          ldy #0                        ; Index into line buffer
00005Ar 2               @ReadWait:
00005Ar 2  20 rr rr       jsr Chrin                     ; Try to read a character (carry set = got one)
00005Dr 2  90 FB          bcc @ReadWait                 ; No char available, keep waiting
00005Fr 2                 ; Got a character in A
00005Fr 2  C9 0D          cmp #$0D                      ; Carriage return?
000061r 2  F0 21          beq @ReadDone
000063r 2  C9 0A          cmp #$0A                      ; Line feed? (treat same as CR)
000065r 2  F0 1D          beq @ReadDone
000067r 2  C9 08          cmp #$08                      ; Backspace?
000069r 2  F0 12          beq @ReadBS
00006Br 2  C9 7F          cmp #$7F                      ; Delete? (treat as backspace)
00006Dr 2  F0 0E          beq @ReadBS
00006Fr 2                 ; Skip non-printable characters ($00-$1F)
00006Fr 2  C9 20          cmp #$20
000071r 2  90 E7          bcc @ReadWait
000073r 2                 ; Printable character — store if room
000073r 2  C0 C8          cpy #MON_LINBUF_SIZE
000075r 2  B0 E3          bcs @ReadWait                 ; Buffer full, ignore
000077r 2  99 00 04       sta MON_LINBUF,y
00007Ar 2  C8             iny
00007Br 2  80 DD          bra @ReadWait
00007Dr 2               @ReadBS:
00007Dr 2  C0 00          cpy #0                        ; Anything to delete?
00007Fr 2  F0 D9          beq @ReadWait                 ; No, ignore
000081r 2  88             dey                           ; Back up one position
000082r 2  80 D6          bra @ReadWait
000084r 2               @ReadDone:
000084r 2  A9 0D          lda #$0D                      ; Echo CR
000086r 2  20 rr rr       jsr Chrout
000089r 2  A9 0A          lda #$0A                      ; Echo LF
00008Br 2  20 rr rr       jsr Chrout
00008Er 2  A9 00          lda #0
000090r 2  99 00 04       sta MON_LINBUF,y              ; Null-terminate
000093r 2  60             rts
000094r 2               
000094r 2               ; ============================================================================
000094r 2               ; MonParseLine — Parse first char and dispatch to command handler
000094r 2               ; ============================================================================
000094r 2               
000094r 2               MonParseLine:
000094r 2  64 35          stz MON_IDX                   ; Reset parse index
000096r 2  20 rr rr       jsr MonSkipSpaces             ; Skip leading whitespace
000099r 2  A4 35          ldy MON_IDX
00009Br 2  B9 00 04       lda MON_LINBUF,y              ; Get command character
00009Er 2  F0 2A          beq @ParseDone                ; Empty line — just return
0000A0r 2                 ; Convert to uppercase
0000A0r 2  C9 61          cmp #'a'
0000A2r 2  90 06          bcc @ParseNoConv
0000A4r 2  C9 7B          cmp #'z'+1
0000A6r 2  B0 02          bcs @ParseNoConv
0000A8r 2  29 DF          and #$DF                      ; Convert lowercase to uppercase
0000AAr 2               @ParseNoConv:
0000AAr 2  E6 35          inc MON_IDX                   ; Advance past command char
0000ACr 2                 ; Search dispatch table
0000ACr 2  A2 00          ldx #0
0000AEr 2               @DispatchLoop:
0000AEr 2  BC rr rr       ldy MonCmdTable,x             ; Load command character from table
0000B1r 2  F0 14          beq @ParseError               ; End of table (null terminator) — unknown command
0000B3r 2  DD rr rr       cmp MonCmdTable,x             ; Compare with input character
0000B6r 2  F0 05          beq @DispatchFound
0000B8r 2  E8             inx                           ; Skip char
0000B9r 2  E8             inx                           ; Skip address low
0000BAr 2  E8             inx                           ; Skip address high
0000BBr 2  80 F1          bra @DispatchLoop
0000BDr 2               @DispatchFound:
0000BDr 2  E8             inx                           ; Point to address low byte
0000BEr 2  BD rr rr       lda MonCmdTable+1,x           ; Handler address high byte — push first (big-endian on stack)
0000C1r 2  48             pha
0000C2r 2  BD rr rr       lda MonCmdTable,x             ; Handler address low byte
0000C5r 2  48             pha
0000C6r 2  60             rts                           ; "Return" to handler address (RTS adds 1 to address)
0000C7r 2               @ParseError:
0000C7r 2  20 rr rr       jsr MonPrintError
0000CAr 2               @ParseDone:
0000CAr 2  60             rts
0000CBr 2               
0000CBr 2               ; ============================================================================
0000CBr 2               ; Command Dispatch Table
0000CBr 2               ; Format: command char (1 byte), handler address - 1 (2 bytes, low/high for RTS trick)
0000CBr 2               ; ============================================================================
0000CBr 2               
0000CBr 2               MonCmdTable:
0000CBr 2  58             .byte 'X'
0000CCr 2  rr rr          .word MonCmdX - 1
0000CEr 2  52             .byte 'R'
0000CFr 2  rr rr          .word MonCmdR - 1
0000D1r 2  4D             .byte 'M'
0000D2r 2  rr rr          .word MonCmdM - 1
0000D4r 2  44             .byte 'D'
0000D5r 2  rr rr          .word MonCmdD - 1
0000D7r 2  3E             .byte '>'
0000D8r 2  rr rr          .word MonCmdDeposit - 1
0000DAr 2  46             .byte 'F'
0000DBr 2  rr rr          .word MonCmdFill - 1
0000DDr 2  54             .byte 'T'
0000DEr 2  rr rr          .word MonCmdTransfer - 1
0000E0r 2  48             .byte 'H'
0000E1r 2  rr rr          .word MonCmdHunt - 1
0000E3r 2  43             .byte 'C'
0000E4r 2  rr rr          .word MonCmdCompare - 1
0000E6r 2  47             .byte 'G'
0000E7r 2  rr rr          .word MonCmdGo - 1
0000E9r 2  4A             .byte 'J'
0000EAr 2  rr rr          .word MonCmdJsr - 1
0000ECr 2  3B             .byte ';'
0000EDr 2  rr rr          .word MonCmdModRegs - 1
0000EFr 2  4C             .byte 'L'
0000F0r 2  rr rr          .word MonCmdLoad - 1
0000F2r 2  53             .byte 'S'
0000F3r 2  rr rr          .word MonCmdSave - 1
0000F5r 2  40             .byte '@'
0000F6r 2  rr rr          .word MonCmdDir - 1
0000F8r 2  4E             .byte 'N'
0000F9r 2  rr rr          .word MonCmdNum - 1
0000FBr 2  23             .byte '#'
0000FCr 2  rr rr          .word MonCmdDisk - 1
0000FEr 2  00             .byte 0                       ; End of table sentinel
0000FFr 2               
0000FFr 2               ; ============================================================================
0000FFr 2               ; MonCmdX — Exit to BASIC
0000FFr 2               ; ============================================================================
0000FFr 2               
0000FFr 2               MonCmdX:
0000FFr 2  20 rr rr       jsr VideoClear                ; Clear screen before entering BASIC
000102r 2  4C rr rr       jmp BasEntry
000105r 2               
000105r 2               ; ============================================================================
000105r 2               ; MonCmdR — Display CPU registers
000105r 2               ; ============================================================================
000105r 2               
000105r 2               MonCmdR:
000105r 2  20 rr rr       jsr MonShowRegs
000108r 2  60             rts
000109r 2               
000109r 2               ; ============================================================================
000109r 2               ; MonCmdDeposit — Deposit (write) bytes to memory
000109r 2               ; Syntax: > ADDR XX [XX XX ...]
000109r 2               ; ============================================================================
000109r 2               
000109r 2               MonCmdDeposit:
000109r 2  20 rr rr       jsr MonSkipSpaces
00010Cr 2  20 rr rr       jsr MonParseHex4              ; Parse target address into MON_ADDR
00010Fr 2  90 16          bcc @DepError                 ; No address → error
000111r 2  A0 00          ldy #0                        ; Byte offset from MON_ADDR
000113r 2               @DepLoop:
000113r 2  5A             phy                           ; Save byte offset (Y clobbered by parse routines)
000114r 2  20 rr rr       jsr MonSkipSpaces
000117r 2  20 rr rr       jsr MonParseHex2              ; Parse next byte into A
00011Ar 2  7A             ply                           ; Restore byte offset (PLY doesn't affect carry)
00011Br 2  90 05          bcc @DepDone                  ; No more bytes → done
00011Dr 2  91 2E          sta (MON_ADDR),y
00011Fr 2  C8             iny
000120r 2  D0 F1          bne @DepLoop                  ; Up to 256 bytes (Y wraps)
000122r 2               @DepDone:
000122r 2  C0 00          cpy #0                        ; Did we deposit at least one byte?
000124r 2  F0 01          beq @DepError                 ; No bytes given → error
000126r 2  60             rts
000127r 2               @DepError:
000127r 2  4C rr rr       jmp MonPrintError
00012Ar 2               
00012Ar 2               ; ============================================================================
00012Ar 2               ; MonCmdFill — Fill memory range with a byte value
00012Ar 2               ; Syntax: F ADDR1 ADDR2 XX
00012Ar 2               ; ============================================================================
00012Ar 2               
00012Ar 2               MonCmdFill:
00012Ar 2  20 rr rr       jsr MonSkipSpaces
00012Dr 2  20 rr rr       jsr MonParseHex4              ; Parse start address → MON_ADDR
000130r 2  90 53          bcc @FillError
000132r 2  A5 2E          lda MON_ADDR
000134r 2  85 32          sta MON_TMP
000136r 2  A5 2F          lda MON_ADDR+1
000138r 2  85 33          sta MON_TMP+1                 ; Save start in MON_TMP
00013Ar 2  20 rr rr       jsr MonSkipSpaces
00013Dr 2  20 rr rr       jsr MonParseHex4              ; Parse end address → MON_ADDR
000140r 2  90 43          bcc @FillError
000142r 2  A5 2E          lda MON_ADDR
000144r 2  85 30          sta MON_END
000146r 2  A5 2F          lda MON_ADDR+1
000148r 2  85 31          sta MON_END+1                 ; Save end in MON_END
00014Ar 2                 ; Restore start into MON_ADDR
00014Ar 2  A5 32          lda MON_TMP
00014Cr 2  85 2E          sta MON_ADDR
00014Er 2  A5 33          lda MON_TMP+1
000150r 2  85 2F          sta MON_ADDR+1
000152r 2  20 rr rr       jsr MonSkipSpaces
000155r 2  20 rr rr       jsr MonParseHex2              ; Parse fill byte → A
000158r 2  90 2B          bcc @FillError
00015Ar 2                 ; A = fill byte, MON_ADDR = start, MON_END = end (inclusive)
00015Ar 2                 ; Refuse a reversed range.  The loop below stops only on start == end, so a
00015Ar 2                 ; start above the end never matches: it walks up through $FFFF, wraps to
00015Ar 2                 ; $0000 and comes back round, having overwritten the whole address space --
00015Ar 2                 ; the ROM's own vectors and this monitor included.  Equal addresses are a
00015Ar 2                 ; legitimate one-byte fill and must still go through.
00015Ar 2  A6 2F          ldx MON_ADDR+1
00015Cr 2  E4 31          cpx MON_END+1
00015Er 2  90 0A          bcc @FillRange
000160r 2  D0 22          bne @FillDone
000162r 2  A6 2E          ldx MON_ADDR
000164r 2  E4 30          cpx MON_END
000166r 2  90 02          bcc @FillRange
000168r 2  D0 1A          bne @FillDone                 ; carry set and not equal -> start > end
00016Ar 2               @FillRange:
00016Ar 2  A0 00          ldy #0
00016Cr 2               @FillLoop:
00016Cr 2  91 2E          sta (MON_ADDR),y
00016Er 2                 ; Check if MON_ADDR == MON_END
00016Er 2  A6 2F          ldx MON_ADDR+1
000170r 2  E4 31          cpx MON_END+1
000172r 2  D0 06          bne @FillNext
000174r 2  A6 2E          ldx MON_ADDR
000176r 2  E4 30          cpx MON_END
000178r 2  F0 0A          beq @FillDone
00017Ar 2               @FillNext:
00017Ar 2                 ; Advance MON_ADDR
00017Ar 2  48             pha                           ; Save fill byte
00017Br 2  E6 2E          inc MON_ADDR
00017Dr 2  D0 02          bne @FillNoHi
00017Fr 2  E6 2F          inc MON_ADDR+1
000181r 2               @FillNoHi:
000181r 2  68             pla                           ; Restore fill byte
000182r 2  80 E8          bra @FillLoop
000184r 2               @FillDone:
000184r 2  60             rts
000185r 2               @FillError:
000185r 2  4C rr rr       jmp MonPrintError
000188r 2               
000188r 2               ; ============================================================================
000188r 2               ; MonCmdTransfer — Copy memory block (handles overlapping regions)
000188r 2               ; Syntax: T SRC_START SRC_END DEST
000188r 2               ; ============================================================================
000188r 2               
000188r 2               MonCmdTransfer:
000188r 2  20 rr rr       jsr MonSkipSpaces
00018Br 2  20 rr rr       jsr MonParseHex4              ; Parse source start → MON_ADDR
00018Er 2  B0 03          bcs @XferGotStart
000190r 2  4C rr rr       jmp @XferError                ; No address → error
000193r 2               @XferGotStart:
000193r 2  A5 2E          lda MON_ADDR
000195r 2  85 32          sta MON_TMP
000197r 2  A5 2F          lda MON_ADDR+1
000199r 2  85 33          sta MON_TMP+1                 ; MON_TMP = source start
00019Br 2  20 rr rr       jsr MonSkipSpaces
00019Er 2  20 rr rr       jsr MonParseHex4              ; Parse source end → MON_ADDR
0001A1r 2  B0 03          bcs @XferGotEnd
0001A3r 2  4C rr rr       jmp @XferError
0001A6r 2               @XferGotEnd:
0001A6r 2  A5 2E          lda MON_ADDR
0001A8r 2  85 30          sta MON_END
0001AAr 2  A5 2F          lda MON_ADDR+1
0001ACr 2  85 31          sta MON_END+1                 ; MON_END = source end (inclusive)
0001AEr 2  20 rr rr       jsr MonSkipSpaces
0001B1r 2  20 rr rr       jsr MonParseHex4              ; Parse dest → MON_ADDR
0001B4r 2  B0 03          bcs @XferGotDest
0001B6r 2  4C rr rr       jmp @XferError
0001B9r 2               @XferGotDest:
0001B9r 2                 ; MON_ADDR = dest, MON_TMP = src start, MON_END = src end
0001B9r 2                 ; Determine copy direction: if dest > src_start, copy backward to handle overlap
0001B9r 2  A5 2F          lda MON_ADDR+1
0001BBr 2  C5 33          cmp MON_TMP+1
0001BDr 2  90 5C          bcc @CopyForward              ; dest < src → forward is safe
0001BFr 2  D0 08          bne @CopyBackward             ; dest > src → need backward
0001C1r 2  A5 2E          lda MON_ADDR
0001C3r 2  C5 32          cmp MON_TMP
0001C5r 2  90 54          bcc @CopyForward
0001C7r 2  F0 72          beq @XferDone                 ; dest == src → nothing to do
0001C9r 2               @CopyBackward:
0001C9r 2                 ; Compute offset = src_end - src_start
0001C9r 2  38             sec
0001CAr 2  A5 30          lda MON_END
0001CCr 2  E5 32          sbc MON_TMP
0001CEr 2  85 34          sta MON_BYTE                  ; low byte of offset
0001D0r 2  A5 31          lda MON_END+1
0001D2r 2  E5 33          sbc MON_TMP+1
0001D4r 2  85 35          sta MON_IDX                   ; high byte of offset (reuse MON_IDX as scratch)
0001D6r 2                 ; Point MON_TMP to src_end, MON_ADDR to dest + offset
0001D6r 2                 ; MON_TMP already needs to be src_end (currently src_start)
0001D6r 2                 ; Swap: MON_TMP = MON_END (src_end)
0001D6r 2  A5 30          lda MON_END
0001D8r 2  48             pha
0001D9r 2  A5 31          lda MON_END+1
0001DBr 2  48             pha
0001DCr 2                 ; MON_END = src_start (save for later comparison)
0001DCr 2  A5 32          lda MON_TMP
0001DEr 2  85 30          sta MON_END
0001E0r 2  A5 33          lda MON_TMP+1
0001E2r 2  85 31          sta MON_END+1
0001E4r 2                 ; MON_TMP = src_end
0001E4r 2  68             pla
0001E5r 2  85 33          sta MON_TMP+1
0001E7r 2  68             pla
0001E8r 2  85 32          sta MON_TMP
0001EAr 2                 ; dest_end = MON_ADDR + offset
0001EAr 2  18             clc
0001EBr 2  A5 2E          lda MON_ADDR
0001EDr 2  65 34          adc MON_BYTE
0001EFr 2  85 2E          sta MON_ADDR
0001F1r 2  A5 2F          lda MON_ADDR+1
0001F3r 2  65 35          adc MON_IDX
0001F5r 2  85 2F          sta MON_ADDR+1
0001F7r 2               @BackLoop:
0001F7r 2  A0 00          ldy #0
0001F9r 2  B1 32          lda (MON_TMP),y
0001FBr 2  91 2E          sta (MON_ADDR),y
0001FDr 2                 ; Check if MON_TMP == MON_END (src start, our stop address)
0001FDr 2  A5 33          lda MON_TMP+1
0001FFr 2  C5 31          cmp MON_END+1
000201r 2  D0 06          bne @BackDec
000203r 2  A5 32          lda MON_TMP
000205r 2  C5 30          cmp MON_END
000207r 2  F0 32          beq @XferDone
000209r 2               @BackDec:
000209r 2                 ; Decrement both pointers
000209r 2  A5 32          lda MON_TMP
00020Br 2  D0 02          bne @BackDecTmpLo
00020Dr 2  C6 33          dec MON_TMP+1
00020Fr 2               @BackDecTmpLo:
00020Fr 2  C6 32          dec MON_TMP
000211r 2  A5 2E          lda MON_ADDR
000213r 2  D0 02          bne @BackDecDstLo
000215r 2  C6 2F          dec MON_ADDR+1
000217r 2               @BackDecDstLo:
000217r 2  C6 2E          dec MON_ADDR
000219r 2  80 DC          bra @BackLoop
00021Br 2               
00021Br 2               @CopyForward:
00021Br 2                 ; Copy from MON_TMP (src) to MON_ADDR (dest), up to MON_END (src end)
00021Br 2  A0 00          ldy #0
00021Dr 2               @FwdLoop:
00021Dr 2  B1 32          lda (MON_TMP),y
00021Fr 2  91 2E          sta (MON_ADDR),y
000221r 2                 ; Check if MON_TMP == MON_END
000221r 2  A5 33          lda MON_TMP+1
000223r 2  C5 31          cmp MON_END+1
000225r 2  D0 06          bne @FwdNext
000227r 2  A5 32          lda MON_TMP
000229r 2  C5 30          cmp MON_END
00022Br 2  F0 0E          beq @XferDone
00022Dr 2               @FwdNext:
00022Dr 2                 ; Advance both pointers
00022Dr 2  E6 32          inc MON_TMP
00022Fr 2  D0 02          bne @FwdNoDstCarry
000231r 2  E6 33          inc MON_TMP+1
000233r 2               @FwdNoDstCarry:
000233r 2  E6 2E          inc MON_ADDR
000235r 2  D0 E6          bne @FwdLoop
000237r 2  E6 2F          inc MON_ADDR+1
000239r 2  80 E2          bra @FwdLoop
00023Br 2               
00023Br 2               @XferDone:
00023Br 2  60             rts
00023Cr 2               @XferError:
00023Cr 2  4C rr rr       jmp MonPrintError
00023Fr 2               
00023Fr 2               ; ============================================================================
00023Fr 2               ; MonCmdHunt — Search for byte pattern in memory range
00023Fr 2               ; Syntax: H ADDR1 ADDR2 XX [XX XX ...]
00023Fr 2               ; Prints address of each match on its own line.
00023Fr 2               ; ============================================================================
00023Fr 2               
00023Fr 2               ; Hunt uses a temp buffer at end of MON_LINBUF area for the pattern.
00023Fr 2               ; Pattern bytes stored at MON_LINBUF+128, max 64 pattern bytes.
00023Fr 2               MON_HUNT_PAT        = MON_LINBUF + 128
00023Fr 2               MON_HUNT_PAT_MAX    = 64
00023Fr 2               
00023Fr 2               MonCmdHunt:
00023Fr 2  20 rr rr       jsr MonSkipSpaces
000242r 2  20 rr rr       jsr MonParseHex4              ; Parse start address → MON_ADDR
000245r 2  90 65          bcc @HuntError
000247r 2  A5 2E          lda MON_ADDR
000249r 2  85 32          sta MON_TMP
00024Br 2  A5 2F          lda MON_ADDR+1
00024Dr 2  85 33          sta MON_TMP+1                 ; MON_TMP = search start
00024Fr 2  20 rr rr       jsr MonSkipSpaces
000252r 2  20 rr rr       jsr MonParseHex4              ; Parse end address → MON_ADDR
000255r 2  90 55          bcc @HuntError
000257r 2  A5 2E          lda MON_ADDR
000259r 2  85 30          sta MON_END
00025Br 2  A5 2F          lda MON_ADDR+1
00025Dr 2  85 31          sta MON_END+1                 ; MON_END = search end
00025Fr 2                 ; Restore start
00025Fr 2  A5 32          lda MON_TMP
000261r 2  85 2E          sta MON_ADDR
000263r 2  A5 33          lda MON_TMP+1
000265r 2  85 2F          sta MON_ADDR+1
000267r 2                 ; Parse pattern bytes into MON_HUNT_PAT
000267r 2  A2 00          ldx #0                        ; Pattern length counter
000269r 2               @HuntParseByte:
000269r 2  DA             phx                           ; Save pattern counter (X clobbered by MonParseHex2)
00026Ar 2  20 rr rr       jsr MonSkipSpaces
00026Dr 2  20 rr rr       jsr MonParseHex2              ; Next byte → A
000270r 2  FA             plx                           ; Restore pattern counter (PLX doesn't affect carry)
000271r 2  90 0A          bcc @HuntParseEnd
000273r 2  E0 40          cpx #MON_HUNT_PAT_MAX
000275r 2  B0 06          bcs @HuntParseEnd             ; Pattern buffer full
000277r 2  9D 80 04       sta MON_HUNT_PAT,x
00027Ar 2  E8             inx
00027Br 2  80 EC          bra @HuntParseByte
00027Dr 2               @HuntParseEnd:
00027Dr 2  E0 00          cpx #0
00027Fr 2  F0 2B          beq @HuntError                ; No pattern bytes → error
000281r 2  86 34          stx MON_BYTE                  ; MON_BYTE = pattern length
000283r 2                 ; Search: scan MON_ADDR to MON_END for pattern match
000283r 2               @HuntScanLoop:
000283r 2  A0 00          ldy #0                        ; Pattern match index
000285r 2               @HuntMatchLoop:
000285r 2  B1 2E          lda (MON_ADDR),y
000287r 2  D9 80 04       cmp MON_HUNT_PAT,y
00028Ar 2  D0 0B          bne @HuntNoMatch
00028Cr 2  C8             iny
00028Dr 2  C4 34          cpy MON_BYTE                  ; Matched all pattern bytes?
00028Fr 2  90 F4          bcc @HuntMatchLoop
000291r 2                 ; Full match — print address
000291r 2  20 rr rr       jsr MonPrintHex4
000294r 2  20 rr rr       jsr MonPrintCRLF
000297r 2               @HuntNoMatch:
000297r 2                 ; Check if MON_ADDR == MON_END
000297r 2  A5 2F          lda MON_ADDR+1
000299r 2  C5 31          cmp MON_END+1
00029Br 2  D0 06          bne @HuntAdvance
00029Dr 2  A5 2E          lda MON_ADDR
00029Fr 2  C5 30          cmp MON_END
0002A1r 2  F0 08          beq @HuntDone
0002A3r 2               @HuntAdvance:
0002A3r 2  E6 2E          inc MON_ADDR
0002A5r 2  D0 DC          bne @HuntScanLoop
0002A7r 2  E6 2F          inc MON_ADDR+1
0002A9r 2  80 D8          bra @HuntScanLoop
0002ABr 2               @HuntDone:
0002ABr 2  60             rts
0002ACr 2               @HuntError:
0002ACr 2  4C rr rr       jmp MonPrintError
0002AFr 2               
0002AFr 2               ; ============================================================================
0002AFr 2               ; MonCmdCompare — Compare two memory regions
0002AFr 2               ; Syntax: C ADDR1 ADDR2 ADDR3
0002AFr 2               ; Compares [addr1,addr2] with block at addr3, prints differing addresses.
0002AFr 2               ; ============================================================================
0002AFr 2               
0002AFr 2               MonCmdCompare:
0002AFr 2  20 rr rr       jsr MonSkipSpaces
0002B2r 2  20 rr rr       jsr MonParseHex4              ; Parse addr1 (region1 start) → MON_ADDR
0002B5r 2  90 57          bcc @CmpError
0002B7r 2                 ; Save addr1 on stack
0002B7r 2  A5 2F          lda MON_ADDR+1
0002B9r 2  48             pha
0002BAr 2  A5 2E          lda MON_ADDR
0002BCr 2  48             pha
0002BDr 2  20 rr rr       jsr MonSkipSpaces
0002C0r 2  20 rr rr       jsr MonParseHex4              ; Parse addr2 (region1 end) → MON_ADDR
0002C3r 2  90 47          bcc @CmpErrorPop
0002C5r 2  A5 2E          lda MON_ADDR
0002C7r 2  85 30          sta MON_END
0002C9r 2  A5 2F          lda MON_ADDR+1
0002CBr 2  85 31          sta MON_END+1                 ; MON_END = region1 end (inclusive)
0002CDr 2  20 rr rr       jsr MonSkipSpaces
0002D0r 2  20 rr rr       jsr MonParseHex4              ; Parse addr3 (region2 base) → MON_ADDR
0002D3r 2  90 37          bcc @CmpErrorPop
0002D5r 2  A5 2E          lda MON_ADDR
0002D7r 2  85 32          sta MON_TMP
0002D9r 2  A5 2F          lda MON_ADDR+1
0002DBr 2  85 33          sta MON_TMP+1                 ; MON_TMP = region2 pointer
0002DDr 2                 ; Restore addr1 → MON_ADDR
0002DDr 2  68             pla
0002DEr 2  85 2E          sta MON_ADDR
0002E0r 2  68             pla
0002E1r 2  85 2F          sta MON_ADDR+1
0002E3r 2                 ; Compare loop: [MON_ADDR..MON_END] vs [MON_TMP..]
0002E3r 2  A0 00          ldy #0
0002E5r 2               @CmpLoop:
0002E5r 2  B1 2E          lda (MON_ADDR),y
0002E7r 2  D1 32          cmp (MON_TMP),y
0002E9r 2  F0 06          beq @CmpMatch
0002EBr 2                 ; Mismatch — print addr1 address
0002EBr 2  20 rr rr       jsr MonPrintHex4
0002EEr 2  20 rr rr       jsr MonPrintCRLF
0002F1r 2               @CmpMatch:
0002F1r 2                 ; Check if MON_ADDR == MON_END
0002F1r 2  A5 2F          lda MON_ADDR+1
0002F3r 2  C5 31          cmp MON_END+1
0002F5r 2  D0 06          bne @CmpNext
0002F7r 2  A5 2E          lda MON_ADDR
0002F9r 2  C5 30          cmp MON_END
0002FBr 2  F0 0E          beq @CmpDone
0002FDr 2               @CmpNext:
0002FDr 2                 ; Advance both pointers
0002FDr 2  E6 2E          inc MON_ADDR
0002FFr 2  D0 02          bne @CmpNoHi1
000301r 2  E6 2F          inc MON_ADDR+1
000303r 2               @CmpNoHi1:
000303r 2  E6 32          inc MON_TMP
000305r 2  D0 DE          bne @CmpLoop
000307r 2  E6 33          inc MON_TMP+1
000309r 2  80 DA          bra @CmpLoop
00030Br 2               @CmpDone:
00030Br 2  60             rts
00030Cr 2               @CmpErrorPop:
00030Cr 2  68             pla                           ; Clean up stack
00030Dr 2  68             pla
00030Er 2               @CmpError:
00030Er 2  4C rr rr       jmp MonPrintError
000311r 2               
000311r 2               ; ============================================================================
000311r 2               ; MonCmdGo — Go (JMP to address with full register restore via RTI)
000311r 2               ; Syntax: G [addr]
000311r 2               ; If addr given, sets BRK_PCL/PCH. Restores A, X, Y, P, SP via RTI.
000311r 2               ; Program runs until BRK returns to monitor or forever.
000311r 2               ; ============================================================================
000311r 2               
000311r 2               MonCmdGo:
000311r 2  20 rr rr       jsr MonSkipSpaces
000314r 2  20 rr rr       jsr MonParseHex4
000317r 2  90 0A          bcc @GoNoAddr
000319r 2                 ; Address given — store to BRK_PCL/PCH
000319r 2  A5 2E          lda MON_ADDR
00031Br 2  8D 11 03       sta BRK_PCL
00031Er 2  A5 2F          lda MON_ADDR+1
000320r 2  8D 12 03       sta BRK_PCH
000323r 2               @GoNoAddr:
000323r 2  78             sei                           ; Disable interrupts during stack manipulation
000324r 2                 ; Restore user's stack pointer
000324r 2                 ; BRK_SP = SP at Break entry (user's original SP - 3 from BRK hardware push)
000324r 2                 ; We need SP = BRK_SP + 3 before our pushes, so RTI leaves SP at original
000324r 2  AE 16 03       ldx BRK_SP
000327r 2  E8             inx
000328r 2  E8             inx
000329r 2  E8             inx
00032Ar 2  9A             txs                           ; SP = user's original SP
00032Br 2                 ; Push PCH, PCL, P for RTI (RTI pops P first, then PCL, PCH)
00032Br 2  AD 12 03       lda BRK_PCH
00032Er 2  48             pha
00032Fr 2  AD 11 03       lda BRK_PCL
000332r 2  48             pha
000333r 2  AD 10 03       lda BRK_P
000336r 2  48             pha
000337r 2                 ; Restore registers
000337r 2  AC 15 03       ldy BRK_Y
00033Ar 2  AE 14 03       ldx BRK_X
00033Dr 2  AD 13 03       lda BRK_A
000340r 2  40             rti                           ; Pop P, PC → jump to target with full register state
000341r 2               
000341r 2               ; ============================================================================
000341r 2               ; MonCmdJsr — Call subroutine and return to monitor on RTS
000341r 2               ; Syntax: J [addr]
000341r 2               ; Pushes monitor return address, restores A/X/Y, JMPs to target.
000341r 2               ; When target does RTS, saves registers and re-enters monitor.
000341r 2               ; ============================================================================
000341r 2               
000341r 2               MonCmdJsr:
000341r 2  20 rr rr       jsr MonSkipSpaces
000344r 2  20 rr rr       jsr MonParseHex4
000347r 2  90 0A          bcc @JsrNoAddr
000349r 2                 ; Address given — store to BRK_PCL/PCH
000349r 2  A5 2E          lda MON_ADDR
00034Br 2  8D 11 03       sta BRK_PCL
00034Er 2  A5 2F          lda MON_ADDR+1
000350r 2  8D 12 03       sta BRK_PCH
000353r 2               @JsrNoAddr:
000353r 2                 ; Push return address (MonJsrReturn - 1) for RTS trick
000353r 2  A9 rr          lda #>(MonJsrReturn - 1)
000355r 2  48             pha
000356r 2  A9 rr          lda #<(MonJsrReturn - 1)
000358r 2  48             pha
000359r 2                 ; Restore registers as inputs to subroutine
000359r 2  AC 15 03       ldy BRK_Y
00035Cr 2  AE 14 03       ldx BRK_X
00035Fr 2  AD 13 03       lda BRK_A
000362r 2  6C 11 03       jmp (BRK_PCL)                 ; Jump to target — its RTS returns to MonJsrReturn
000365r 2               
000365r 2               ; MonJsrReturn — Landing point when user's subroutine does RTS
000365r 2               MonJsrReturn:
000365r 2  8D 13 03       sta BRK_A                     ; Save returned A
000368r 2  8E 14 03       stx BRK_X                    ; Save returned X
00036Br 2  8C 15 03       sty BRK_Y                    ; Save returned Y
00036Er 2  08             php                           ; Push current P
00036Fr 2  68             pla
000370r 2  8D 10 03       sta BRK_P                    ; Save processor status
000373r 2  BA             tsx
000374r 2  8E 16 03       stx BRK_SP                   ; Save current stack pointer
000377r 2                 ; Show registers and re-enter command loop
000377r 2  20 rr rr       jsr MonShowRegs
00037Ar 2  4C rr rr       jmp MonCmdLoop
00037Dr 2               
00037Dr 2               ; ============================================================================
00037Dr 2               ; MonCmdModRegs — Modify saved CPU registers
00037Dr 2               ; Syntax: ; PC xxxx A xx X xx Y xx SP xx P xx
00037Dr 2               ; Any subset, any order. Labels: PC, A, X, Y, SP, P
00037Dr 2               ; ============================================================================
00037Dr 2               
00037Dr 2               MonCmdModRegs:
00037Dr 2               @ModLoop:
00037Dr 2  20 rr rr       jsr MonSkipSpaces
000380r 2  A4 35          ldy MON_IDX
000382r 2  B9 00 04       lda MON_LINBUF,y
000385r 2  D0 03          bne @ModNotEnd
000387r 2  4C rr rr       jmp @ModDone                  ; End of line — trampoline (too far for beq)
00038Ar 2               @ModNotEnd:
00038Ar 2                 ; Convert to uppercase
00038Ar 2  C9 61          cmp #'a'
00038Cr 2  90 06          bcc @ModNoConv
00038Er 2  C9 7B          cmp #'z'+1
000390r 2  B0 02          bcs @ModNoConv
000392r 2  29 DF          and #$DF
000394r 2               @ModNoConv:
000394r 2  C9 50          cmp #'P'
000396r 2  F0 13          beq @ModCheckPCorP
000398r 2  C9 41          cmp #'A'
00039Ar 2  F0 4F          beq @ModA
00039Cr 2  C9 58          cmp #'X'
00039Er 2  F0 5E          beq @ModX
0003A0r 2  C9 59          cmp #'Y'
0003A2r 2  F0 6D          beq @ModY
0003A4r 2  C9 53          cmp #'S'
0003A6r 2  F0 7C          beq @ModCheckSP
0003A8r 2  4C rr rr       jmp @ModError                 ; Unknown label — trampoline (too far for bra)
0003ABr 2               
0003ABr 2               @ModCheckPCorP:
0003ABr 2                 ; Could be "PC" (program counter) or "P" (processor status)
0003ABr 2  E6 35          inc MON_IDX
0003ADr 2  A4 35          ldy MON_IDX
0003AFr 2  B9 00 04       lda MON_LINBUF,y
0003B2r 2                 ; Convert to uppercase
0003B2r 2  C9 61          cmp #'a'
0003B4r 2  90 06          bcc @ModPCNoConv
0003B6r 2  C9 7B          cmp #'z'+1
0003B8r 2  B0 02          bcs @ModPCNoConv
0003BAr 2  29 DF          and #$DF
0003BCr 2               @ModPCNoConv:
0003BCr 2  C9 43          cmp #'C'
0003BEr 2  F0 11          beq @ModPC
0003C0r 2                 ; It's just 'P' (processor status) — don't advance past the non-'C' char
0003C0r 2  20 rr rr       jsr MonSkipSpaces
0003C3r 2  20 rr rr       jsr MonParseHex2
0003C6r 2  B0 03          bcs @ModPOk
0003C8r 2  4C rr rr       jmp @ModError
0003CBr 2               @ModPOk:
0003CBr 2  8D 10 03       sta BRK_P
0003CEr 2  4C rr rr       jmp @ModLoop
0003D1r 2               
0003D1r 2               @ModPC:
0003D1r 2  E6 35          inc MON_IDX                   ; Advance past 'C'
0003D3r 2  20 rr rr       jsr MonSkipSpaces
0003D6r 2  20 rr rr       jsr MonParseHex4
0003D9r 2  B0 03          bcs @ModPCOk
0003DBr 2  4C rr rr       jmp @ModError
0003DEr 2               @ModPCOk:
0003DEr 2  A5 2E          lda MON_ADDR
0003E0r 2  8D 11 03       sta BRK_PCL
0003E3r 2  A5 2F          lda MON_ADDR+1
0003E5r 2  8D 12 03       sta BRK_PCH
0003E8r 2  4C rr rr       jmp @ModLoop
0003EBr 2               
0003EBr 2               @ModA:
0003EBr 2  E6 35          inc MON_IDX                   ; Advance past 'A'
0003EDr 2  20 rr rr       jsr MonSkipSpaces
0003F0r 2  20 rr rr       jsr MonParseHex2
0003F3r 2  B0 03          bcs @ModAOk
0003F5r 2  4C rr rr       jmp @ModError
0003F8r 2               @ModAOk:
0003F8r 2  8D 13 03       sta BRK_A
0003FBr 2  4C rr rr       jmp @ModLoop
0003FEr 2               
0003FEr 2               @ModX:
0003FEr 2  E6 35          inc MON_IDX                   ; Advance past 'X'
000400r 2  20 rr rr       jsr MonSkipSpaces
000403r 2  20 rr rr       jsr MonParseHex2
000406r 2  B0 03          bcs @ModXOk
000408r 2  4C rr rr       jmp @ModError
00040Br 2               @ModXOk:
00040Br 2  8D 14 03       sta BRK_X
00040Er 2  4C rr rr       jmp @ModLoop
000411r 2               
000411r 2               @ModY:
000411r 2  E6 35          inc MON_IDX                   ; Advance past 'Y'
000413r 2  20 rr rr       jsr MonSkipSpaces
000416r 2  20 rr rr       jsr MonParseHex2
000419r 2  B0 03          bcs @ModYOk
00041Br 2  4C rr rr       jmp @ModError
00041Er 2               @ModYOk:
00041Er 2  8D 15 03       sta BRK_Y
000421r 2  4C rr rr       jmp @ModLoop
000424r 2               
000424r 2               @ModCheckSP:
000424r 2                 ; Expect "SP" — must see 'P' next
000424r 2  E6 35          inc MON_IDX
000426r 2  A4 35          ldy MON_IDX
000428r 2  B9 00 04       lda MON_LINBUF,y
00042Br 2  C9 50          cmp #'P'
00042Dr 2  F0 07          beq @ModSPGotP
00042Fr 2  C9 70          cmp #'p'
000431r 2  F0 03          beq @ModSPGotP
000433r 2  4C rr rr       jmp @ModError                 ; Just 'S' alone is invalid
000436r 2               @ModSPGotP:
000436r 2  E6 35          inc MON_IDX                   ; Advance past 'P'
000438r 2  20 rr rr       jsr MonSkipSpaces
00043Br 2  20 rr rr       jsr MonParseHex2
00043Er 2  B0 03          bcs @ModSPOk
000440r 2  4C rr rr       jmp @ModError
000443r 2               @ModSPOk:
000443r 2  8D 16 03       sta BRK_SP
000446r 2  4C rr rr       jmp @ModLoop
000449r 2               
000449r 2               @ModError:
000449r 2  4C rr rr       jmp MonPrintError
00044Cr 2               @ModDone:
00044Cr 2                 ; Display updated registers
00044Cr 2  20 rr rr       jsr MonShowRegs
00044Fr 2  60             rts
000450r 2               
000450r 2               ; ============================================================================
000450r 2               ; MonCmdDir — Display CF directory listing
000450r 2               ; Syntax: @
000450r 2               ; ============================================================================
000450r 2               
000450r 2               MonCmdDir:
000450r 2  20 rr rr       jsr FsDirectory
000453r 2  60             rts
000454r 2               
000454r 2               ; ============================================================================
000454r 2               ; MonCmdDisk — Select / report the current CF disk bank
000454r 2               ; Syntax: # NN   (hex disk 00-FF selects); # alone reports the current disk
000454r 2               ; ============================================================================
000454r 2               
000454r 2               MonCmdDisk:
000454r 2  20 rr rr       jsr MonSkipSpaces
000457r 2  20 rr rr       jsr MonParseHex2
00045Ar 2  90 03          bcc @MonDiskShow              ; No argument — just report current disk
00045Cr 2  20 rr rr       jsr FsSetDisk                 ; CF_DISK = A
00045Fr 2               @MonDiskShow:
00045Fr 2  20 rr rr       jsr FsPrintDisk               ; Print "DISK n"
000462r 2  60             rts
000463r 2               
000463r 2               ; ============================================================================
000463r 2               ; MonCmdNum — Number base conversion
000463r 2               ; Syntax: N $XXXX  or  N +DDDDD  or  N %BBBBBBBBBBBBBBBB
000463r 2               ; Output: $XXXX  +DDDDD  %BBBBBBBBBBBBBBBB
000463r 2               ; ============================================================================
000463r 2               
000463r 2               MonCmdNum:
000463r 2  20 rr rr       jsr MonSkipSpaces
000466r 2  A4 35          ldy MON_IDX
000468r 2  B9 00 04       lda MON_LINBUF,y
00046Br 2  C9 24          cmp #'$'
00046Dr 2  F0 0A          beq @NumHex
00046Fr 2  C9 2B          cmp #'+'
000471r 2  F0 10          beq @NumDec
000473r 2  C9 25          cmp #'%'
000475r 2  F0 16          beq @NumBin
000477r 2                 ; Default: try hex (no prefix)
000477r 2  80 02          bra @NumHexDirect
000479r 2               @NumHex:
000479r 2  E6 35          inc MON_IDX                   ; Skip '$'
00047Br 2               @NumHexDirect:
00047Br 2  20 rr rr       jsr MonParseHex4
00047Er 2  B0 17          bcs @NumPrint
000480r 2  4C rr rr       jmp MonPrintError
000483r 2               @NumDec:
000483r 2  E6 35          inc MON_IDX                   ; Skip '+'
000485r 2  20 rr rr       jsr MonParseDec16
000488r 2  B0 0D          bcs @NumPrint
00048Ar 2  4C rr rr       jmp MonPrintError
00048Dr 2               @NumBin:
00048Dr 2  E6 35          inc MON_IDX                   ; Skip '%'
00048Fr 2  20 rr rr       jsr MonParseBin16
000492r 2  B0 03          bcs @NumPrint
000494r 2  4C rr rr       jmp MonPrintError
000497r 2               @NumPrint:
000497r 2                 ; Value is in MON_ADDR
000497r 2  A9 24          lda #'$'
000499r 2  20 rr rr       jsr Chrout
00049Cr 2  20 rr rr       jsr MonPrintHex4
00049Fr 2  20 rr rr       jsr MonPrintSpace
0004A2r 2  20 rr rr       jsr MonPrintSpace
0004A5r 2  A9 2B          lda #'+'
0004A7r 2  20 rr rr       jsr Chrout
0004AAr 2  20 rr rr       jsr MonPrintDec16
0004ADr 2  20 rr rr       jsr MonPrintSpace
0004B0r 2  20 rr rr       jsr MonPrintSpace
0004B3r 2  A9 25          lda #'%'
0004B5r 2  20 rr rr       jsr Chrout
0004B8r 2  20 rr rr       jsr MonPrintBin16
0004BBr 2  20 rr rr       jsr MonPrintCRLF
0004BEr 2  60             rts
0004BFr 2               
0004BFr 2               ; ============================================================================
0004BFr 2               ; MonCmdLoad — Load from CF (with quoted filename) or XModem (without)
0004BFr 2               ; Syntax: L ["FILE"] [ADDR]
0004BFr 2               ; CF path:     L "FILENAME" [ADDR] — load file to addr (default $0800)
0004BFr 2               ; Serial path: L [ADDR]            — receive via XModem to addr (default $0800)
0004BFr 2               ; ============================================================================
0004BFr 2               
0004BFr 2               MonCmdLoad:
0004BFr 2  20 rr rr       jsr MonSkipSpaces
0004C2r 2  A4 35          ldy MON_IDX
0004C4r 2  B9 00 04       lda MON_LINBUF,y
0004C7r 2  C9 22          cmp #'"'
0004C9r 2  D0 03          bne @LoadSerial
0004CBr 2  4C rr rr       jmp @LoadCF
0004CEr 2               
0004CEr 2                 ; --- Serial path (XModem) ---
0004CEr 2               @LoadSerial:
0004CEr 2  20 rr rr       jsr MonParseHex4              ; Optional address
0004D1r 2  90 0A          bcc @LoadSerDefault
0004D3r 2                 ; Got address
0004D3r 2  A5 2E          lda MON_ADDR
0004D5r 2  85 2A          sta XFER_PTR
0004D7r 2  A5 2F          lda MON_ADDR+1
0004D9r 2  85 2B          sta XFER_PTR+1
0004DBr 2  80 08          bra @LoadSerStart
0004DDr 2               @LoadSerDefault:
0004DDr 2  A9 00          lda #<PROGRAM_START
0004DFr 2  85 2A          sta XFER_PTR
0004E1r 2  A9 08          lda #>PROGRAM_START
0004E3r 2  85 2B          sta XFER_PTR+1
0004E5r 2               @LoadSerStart:
0004E5r 2                 ; Save load address for success message
0004E5r 2  A5 2A          lda XFER_PTR
0004E7r 2  85 30          sta MON_END
0004E9r 2  A5 2B          lda XFER_PTR+1
0004EBr 2  85 31          sta MON_END+1
0004EDr 2                 ; Receive via XModem
0004EDr 2  20 rr rr       jsr XModemLoad
0004F0r 2  B0 11          bcs @LoadSerErr
0004F2r 2                 ; XFER_REMAIN = total bytes received
0004F2r 2  AD 17 03       lda XFER_REMAIN
0004F5r 2  85 2E          sta MON_ADDR
0004F7r 2  AD 18 03       lda XFER_REMAIN+1
0004FAr 2  85 2F          sta MON_ADDR+1
0004FCr 2  20 rr rr       jsr MonNoteImage
0004FFr 2  20 rr rr       jsr MonPrintLoaded            ; Print "LOADED nnnn BYTES AT $xxxx"
000502r 2  60             rts
000503r 2               @LoadSerErr:
000503r 2  20 rr rr       jsr MonPrintIOErr
000506r 2  60             rts
000507r 2               
000507r 2                 ; --- CF path ---
000507r 2               @LoadCF:
000507r 2  E6 35          inc MON_IDX                   ; Skip opening quote
000509r 2                 ; Point STR_PTR into line buffer at the filename
000509r 2  A4 35          ldy MON_IDX
00050Br 2  98             tya
00050Cr 2  18             clc
00050Dr 2  69 00          adc #<MON_LINBUF
00050Fr 2  85 02          sta STR_PTR
000511r 2  A9 04          lda #>MON_LINBUF
000513r 2  69 00          adc #0
000515r 2  85 03          sta STR_PTR+1
000517r 2                 ; Find closing quote and null-terminate
000517r 2               @LoadCFFindQ:
000517r 2  B9 00 04       lda MON_LINBUF,y
00051Ar 2  F0 0D          beq @LoadCFQDone              ; End of line — use as-is
00051Cr 2  C9 22          cmp #'"'
00051Er 2  F0 03          beq @LoadCFGotQ
000520r 2  C8             iny
000521r 2  80 F4          bra @LoadCFFindQ
000523r 2               @LoadCFGotQ:
000523r 2  A9 00          lda #0
000525r 2  99 00 04       sta MON_LINBUF,y              ; Null-terminate at closing quote
000528r 2  C8             iny                           ; Advance past closing quote
000529r 2               @LoadCFQDone:
000529r 2  84 35          sty MON_IDX
00052Br 2                 ; Parse filename into FS_FNAME_BUF
00052Br 2  20 rr rr       jsr FsParseName
00052Er 2                 ; Read directory
00052Er 2  20 rr rr       jsr FsReadDir
000531r 2  90 03          bcc @LoadCFReadOk
000533r 2  4C rr rr       jmp @LoadCFErr
000536r 2               @LoadCFReadOk:
000536r 2                 ; Find file
000536r 2  20 rr rr       jsr FsFindFile
000539r 2  90 03          bcc @LoadCFFound
00053Br 2  4C rr rr       jmp @LoadCFNotFound
00053Er 2               @LoadCFFound:
00053Er 2                 ; Read file metadata
00053Er 2  A0 0C          ldy #FS_ENTRY_START
000540r 2  B1 24          lda (CF_BUF_PTR),y
000542r 2  8D 48 03       sta FS_START_SEC
000545r 2  C8             iny
000546r 2  B1 24          lda (CF_BUF_PTR),y
000548r 2  8D 49 03       sta FS_START_SEC+1
00054Br 2  A0 0E          ldy #FS_ENTRY_FSIZE
00054Dr 2  B1 24          lda (CF_BUF_PTR),y
00054Fr 2  8D 4A 03       sta FS_FILE_SIZE
000552r 2  C8             iny
000553r 2  B1 24          lda (CF_BUF_PTR),y
000555r 2  8D 4B 03       sta FS_FILE_SIZE+1
000558r 2                 ; Calculate sector count = ceil(size / 512)
000558r 2  AD 4B 03       lda FS_FILE_SIZE+1
00055Br 2  4A             lsr a
00055Cr 2  8D 4C 03       sta FS_SEC_COUNT
00055Fr 2  AD 4B 03       lda FS_FILE_SIZE+1
000562r 2  29 01          and #$01
000564r 2  D0 05          bne @LoadCFRound
000566r 2  AD 4A 03       lda FS_FILE_SIZE
000569r 2  F0 03          beq @LoadCFNoRound
00056Br 2               @LoadCFRound:
00056Br 2  EE 4C 03       inc FS_SEC_COUNT
00056Er 2               @LoadCFNoRound:
00056Er 2                 ; Parse optional load address
00056Er 2  20 rr rr       jsr MonSkipSpaces
000571r 2  20 rr rr       jsr MonParseHex4
000574r 2  90 0A          bcc @LoadCFDefAddr
000576r 2                 ; Got address — use it
000576r 2  A5 2E          lda MON_ADDR
000578r 2  85 24          sta CF_BUF_PTR
00057Ar 2  A5 2F          lda MON_ADDR+1
00057Cr 2  85 25          sta CF_BUF_PTR+1
00057Er 2  80 08          bra @LoadCFSetLBA
000580r 2               @LoadCFDefAddr:
000580r 2  A9 00          lda #<PROGRAM_START
000582r 2  85 24          sta CF_BUF_PTR
000584r 2  A9 08          lda #>PROGRAM_START
000586r 2  85 25          sta CF_BUF_PTR+1
000588r 2               @LoadCFSetLBA:
000588r 2                 ; Save load base address for message
000588r 2  A5 24          lda CF_BUF_PTR
00058Ar 2  85 30          sta MON_END
00058Cr 2  A5 25          lda CF_BUF_PTR+1
00058Er 2  85 31          sta MON_END+1
000590r 2                 ; Set up LBA
000590r 2  AD 48 03       lda FS_START_SEC
000593r 2  85 26          sta CF_LBA
000595r 2  AD 49 03       lda FS_START_SEC+1
000598r 2  85 27          sta CF_LBA+1
00059Ar 2  64 28          stz CF_LBA+2
00059Cr 2  64 29          stz CF_LBA+3
00059Er 2                 ; Read sectors
00059Er 2  AE 4C 03       ldx FS_SEC_COUNT
0005A1r 2  F0 10          beq @LoadCFOk
0005A3r 2               @LoadCFSec:
0005A3r 2  DA             phx
0005A4r 2  20 rr rr       jsr StReadSector              ; Reads 512 bytes, advances CF_BUF_PTR
0005A7r 2  B0 1B          bcs @LoadCFSecErr
0005A9r 2  E6 26          inc CF_LBA
0005ABr 2  D0 02          bne @LoadCFSecNext
0005ADr 2  E6 27          inc CF_LBA+1
0005AFr 2               @LoadCFSecNext:
0005AFr 2  FA             plx
0005B0r 2  CA             dex
0005B1r 2  D0 F0          bne @LoadCFSec
0005B3r 2               @LoadCFOk:
0005B3r 2                 ; Print success
0005B3r 2  AD 4A 03       lda FS_FILE_SIZE
0005B6r 2  85 2E          sta MON_ADDR
0005B8r 2  AD 4B 03       lda FS_FILE_SIZE+1
0005BBr 2  85 2F          sta MON_ADDR+1
0005BDr 2  20 rr rr       jsr MonNoteImage
0005C0r 2  20 rr rr       jsr MonPrintLoaded            ; Print "LOADED nnnn BYTES AT $xxxx"
0005C3r 2  60             rts
0005C4r 2               @LoadCFSecErr:
0005C4r 2  FA             plx                           ; Balance stack
0005C5r 2               @LoadCFErr:
0005C5r 2  20 rr rr       jsr MonPrintIOErr
0005C8r 2  60             rts
0005C9r 2               @LoadCFNotFound:
0005C9r 2  A2 00          ldx #0
0005CBr 2               @LoadCFNFLoop:
0005CBr 2  BD rr rr       lda MonStrNotFound,x
0005CEr 2  F0 06          beq @LoadCFNFDone
0005D0r 2  20 rr rr       jsr Chrout
0005D3r 2  E8             inx
0005D4r 2  80 F5          bra @LoadCFNFLoop
0005D6r 2               @LoadCFNFDone:
0005D6r 2  20 rr rr       jsr MonPrintCRLF
0005D9r 2  60             rts
0005DAr 2               
0005DAr 2               ; ============================================================================
0005DAr 2               ; MonNoteImage — Record a program image loaded to PROGRAM_START, so that BASIC
0005DAr 2               ; can size it correctly on entry.  'L' is the one raw loader that can land a
0005DAr 2               ; .prg where BASIC expects one; without the byte count BASIC would walk the
0005DAr 2               ; line chain, stop at the stub's end marker, and leave the machine code
0005DAr 2               ; unprotected below VARTAB.
0005DAr 2               ; Input: MON_END = load address, MON_ADDR = byte count
0005DAr 2               ; Output: PRG_IMAGE_END set, but only for a load to PROGRAM_START — a load to
0005DAr 2               ;         any other address is BLOAD-shaped and must not touch BASIC's state.
0005DAr 2               ; Modifies: Flags, A
0005DAr 2               ; ============================================================================
0005DAr 2               
0005DAr 2               MonNoteImage:
0005DAr 2  A5 30          lda MON_END
0005DCr 2  C9 00          cmp #<PROGRAM_START
0005DEr 2  D0 15          bne @NoteDone
0005E0r 2  A5 31          lda MON_END+1
0005E2r 2  C9 08          cmp #>PROGRAM_START
0005E4r 2  D0 0F          bne @NoteDone
0005E6r 2  18             clc
0005E7r 2  A5 2E          lda MON_ADDR
0005E9r 2  69 00          adc #<PROGRAM_START
0005EBr 2  8D 8E 03       sta PRG_IMAGE_END
0005EEr 2  A5 2F          lda MON_ADDR+1
0005F0r 2  69 08          adc #>PROGRAM_START
0005F2r 2  8D 8F 03       sta PRG_IMAGE_END+1
0005F5r 2               @NoteDone:
0005F5r 2  60             rts
0005F6r 2               
0005F6r 2               ; ============================================================================
0005F6r 2               ; MonCmdSave — Save to CF (with quoted filename) or XModem (without)
0005F6r 2               ; Syntax: S ["FILE"] ADDR1 ADDR2
0005F6r 2               ; CF path:     S "FILENAME" ADDR1 ADDR2 — save [addr1,addr2) to file
0005F6r 2               ; Serial path: S ADDR1 ADDR2            — send [addr1,addr2) via XModem
0005F6r 2               ; ============================================================================
0005F6r 2               
0005F6r 2               MonCmdSave:
0005F6r 2  20 rr rr       jsr MonSkipSpaces
0005F9r 2  A4 35          ldy MON_IDX
0005FBr 2  B9 00 04       lda MON_LINBUF,y
0005FEr 2  C9 22          cmp #'"'
000600r 2  D0 03          bne @SaveSerial
000602r 2  4C rr rr       jmp @SaveCF
000605r 2               
000605r 2                 ; --- Serial path ---
000605r 2                 ; --- Serial path (XModem) ---
000605r 2               @SaveSerial:
000605r 2  20 rr rr       jsr MonParseHex4              ; Parse start address
000608r 2  B0 03          bcs @SaveSerGotStart
00060Ar 2  4C rr rr       jmp @SaveError
00060Dr 2               @SaveSerGotStart:
00060Dr 2  A5 2E          lda MON_ADDR
00060Fr 2  85 2A          sta XFER_PTR
000611r 2  A5 2F          lda MON_ADDR+1
000613r 2  85 2B          sta XFER_PTR+1
000615r 2  20 rr rr       jsr MonSkipSpaces
000618r 2  20 rr rr       jsr MonParseHex4              ; Parse end address
00061Br 2  B0 03          bcs @SaveSerGotEnd
00061Dr 2  4C rr rr       jmp @SaveError
000620r 2               @SaveSerGotEnd:
000620r 2                 ; Calculate size = end - start
000620r 2  38             sec
000621r 2  A5 2E          lda MON_ADDR
000623r 2  E5 2A          sbc XFER_PTR
000625r 2  8D 17 03       sta XFER_REMAIN
000628r 2  A5 2F          lda MON_ADDR+1
00062Ar 2  E5 2B          sbc XFER_PTR+1
00062Cr 2  8D 18 03       sta XFER_REMAIN+1
00062Fr 2                 ; Save size for message
00062Fr 2  AD 17 03       lda XFER_REMAIN
000632r 2  85 30          sta MON_END
000634r 2  AD 18 03       lda XFER_REMAIN+1
000637r 2  85 31          sta MON_END+1
000639r 2                 ; Send via XModem
000639r 2  20 rr rr       jsr XModemSave
00063Cr 2  B0 0C          bcs @SaveSerErr
00063Er 2                 ; Print "SAVED nnnn BYTES"
00063Er 2  A5 30          lda MON_END
000640r 2  85 2E          sta MON_ADDR
000642r 2  A5 31          lda MON_END+1
000644r 2  85 2F          sta MON_ADDR+1
000646r 2  20 rr rr       jsr MonPrintSaved
000649r 2  60             rts
00064Ar 2               @SaveSerErr:
00064Ar 2  20 rr rr       jsr MonPrintIOErr
00064Dr 2  60             rts
00064Er 2               
00064Er 2                 ; --- CF path ---
00064Er 2               @SaveCF:
00064Er 2  E6 35          inc MON_IDX                   ; Skip opening quote
000650r 2                 ; Point STR_PTR into line buffer at the filename
000650r 2  A4 35          ldy MON_IDX
000652r 2  98             tya
000653r 2  18             clc
000654r 2  69 00          adc #<MON_LINBUF
000656r 2  85 02          sta STR_PTR
000658r 2  A9 04          lda #>MON_LINBUF
00065Ar 2  69 00          adc #0
00065Cr 2  85 03          sta STR_PTR+1
00065Er 2                 ; Find closing quote and null-terminate
00065Er 2               @SaveCFFindQ:
00065Er 2  B9 00 04       lda MON_LINBUF,y
000661r 2  F0 0D          beq @SaveCFQDone
000663r 2  C9 22          cmp #'"'
000665r 2  F0 03          beq @SaveCFGotQ
000667r 2  C8             iny
000668r 2  80 F4          bra @SaveCFFindQ
00066Ar 2               @SaveCFGotQ:
00066Ar 2  A9 00          lda #0
00066Cr 2  99 00 04       sta MON_LINBUF,y              ; Null-terminate at closing quote
00066Fr 2  C8             iny
000670r 2               @SaveCFQDone:
000670r 2  84 35          sty MON_IDX
000672r 2                 ; Parse filename
000672r 2  20 rr rr       jsr FsParseName
000675r 2                 ; Parse start address
000675r 2  20 rr rr       jsr MonSkipSpaces
000678r 2  20 rr rr       jsr MonParseHex4
00067Br 2  B0 03          bcs @SaveCFGotStart
00067Dr 2  4C rr rr       jmp @SaveError
000680r 2               @SaveCFGotStart:
000680r 2  A5 2E          lda MON_ADDR
000682r 2  85 32          sta MON_TMP                   ; MON_TMP = start address
000684r 2  A5 2F          lda MON_ADDR+1
000686r 2  85 33          sta MON_TMP+1
000688r 2                 ; Parse end address
000688r 2  20 rr rr       jsr MonSkipSpaces
00068Br 2  20 rr rr       jsr MonParseHex4
00068Er 2  B0 03          bcs @SaveCFGotEnd
000690r 2  4C rr rr       jmp @SaveError
000693r 2               @SaveCFGotEnd:
000693r 2                 ; Calculate size = end - start
000693r 2  38             sec
000694r 2  A5 2E          lda MON_ADDR
000696r 2  E5 32          sbc MON_TMP
000698r 2  8D 4A 03       sta FS_FILE_SIZE
00069Br 2  A5 2F          lda MON_ADDR+1
00069Dr 2  E5 33          sbc MON_TMP+1
00069Fr 2  8D 4B 03       sta FS_FILE_SIZE+1
0006A2r 2                 ; Read directory
0006A2r 2  20 rr rr       jsr FsReadDir
0006A5r 2  90 03          bcc @SaveCFReadOk
0006A7r 2  4C rr rr       jmp @SaveCFIOErr
0006AAr 2               @SaveCFReadOk:
0006AAr 2                 ; Try to find existing file with same name
0006AAr 2  20 rr rr       jsr FsFindFile
0006ADr 2  90 08          bcc @SaveCFOverwrite
0006AFr 2                 ; Not found — find a free slot
0006AFr 2  20 rr rr       jsr FsFindFree
0006B2r 2  90 11          bcc @SaveCFAlloc
0006B4r 2  4C rr rr       jmp @SaveCFDirFull
0006B7r 2               @SaveCFOverwrite:
0006B7r 2                 ; Clear old entry's flags
0006B7r 2  A0 0B          ldy #FS_ENTRY_FLAGS
0006B9r 2  A9 00          lda #$00
0006BBr 2  91 24          sta (CF_BUF_PTR),y
0006BDr 2                 ; Find a free slot (could be the one we just freed)
0006BDr 2  20 rr rr       jsr FsFindFree
0006C0r 2  90 03          bcc @SaveCFAllocOk
0006C2r 2  4C rr rr       jmp @SaveCFDirFull
0006C5r 2               @SaveCFAllocOk:
0006C5r 2               @SaveCFAlloc:
0006C5r 2                 ; Save CF_BUF_PTR (points to free entry)
0006C5r 2  A5 24          lda CF_BUF_PTR
0006C7r 2  48             pha
0006C8r 2  A5 25          lda CF_BUF_PTR+1
0006CAr 2  48             pha
0006CBr 2                 ; Save FS_FILE_SIZE: FsCalcNextSec reads every entry's size into it while
0006CBr 2                 ; scanning, so on a disk that already holds a file it comes back holding
0006CBr 2                 ; *that* file's length.  On an empty disk the scan touches nothing and the
0006CBr 2                 ; omission is invisible, which is how this survived.  FsSaveFileAddrImpl
0006CBr 2                 ; saves it across the same call for the same reason.
0006CBr 2  AD 4A 03       lda FS_FILE_SIZE
0006CEr 2  48             pha
0006CFr 2  AD 4B 03       lda FS_FILE_SIZE+1
0006D2r 2  48             pha
0006D3r 2                 ; Calculate next free sector
0006D3r 2  20 rr rr       jsr FsCalcNextSec
0006D6r 2                 ; Restore FS_FILE_SIZE, then CF_BUF_PTR
0006D6r 2  68             pla
0006D7r 2  8D 4B 03       sta FS_FILE_SIZE+1
0006DAr 2  68             pla
0006DBr 2  8D 4A 03       sta FS_FILE_SIZE
0006DEr 2  68             pla
0006DFr 2  85 25          sta CF_BUF_PTR+1
0006E1r 2  68             pla
0006E2r 2  85 24          sta CF_BUF_PTR
0006E4r 2                 ; Calculate sectors needed
0006E4r 2  AD 4B 03       lda FS_FILE_SIZE+1
0006E7r 2  4A             lsr a
0006E8r 2  8D 4C 03       sta FS_SEC_COUNT
0006EBr 2  AD 4B 03       lda FS_FILE_SIZE+1
0006EEr 2  29 01          and #$01
0006F0r 2  D0 05          bne @SaveCFRound
0006F2r 2  AD 4A 03       lda FS_FILE_SIZE
0006F5r 2  F0 03          beq @SaveCFNoRound
0006F7r 2               @SaveCFRound:
0006F7r 2  EE 4C 03       inc FS_SEC_COUNT
0006FAr 2               @SaveCFNoRound:
0006FAr 2                 ; Disk-full guard, as FsSaveFileAddrImpl has: end sector = FS_NEXT_SEC +
0006FAr 2                 ; FS_SEC_COUNT must be <= FS_DISK_SECTORS, or the write walks out of this
0006FAr 2                 ; disk's region and over the next disk's directory sector.
0006FAr 2  AD 4E 03       lda FS_NEXT_SEC
0006FDr 2  18             clc
0006FEr 2  6D 4C 03       adc FS_SEC_COUNT
000701r 2  A8             tay                           ; Y = end sector low
000702r 2  AD 4F 03       lda FS_NEXT_SEC+1
000705r 2  69 00          adc #$00                      ; A = end sector high
000707r 2  C9 08          cmp #>FS_DISK_SECTORS
000709r 2  90 08          bcc @SaveCFSpaceOk            ; end high < high(FS_DISK_SECTORS) -> fits
00070Br 2  D0 03          bne @SaveCFNoRoom             ; end high > high(FS_DISK_SECTORS) -> full
00070Dr 2  98             tya                           ; end high equal: OK only if end low == 0
00070Er 2  F0 03          beq @SaveCFSpaceOk
000710r 2               @SaveCFNoRoom:
000710r 2  4C rr rr       jmp @SaveCFIOErr
000713r 2               @SaveCFSpaceOk:
000713r 2                 ; Fill in directory entry
000713r 2                 ; Copy filename (11 bytes)
000713r 2  A0 00          ldy #0
000715r 2               @SaveCFCopyName:
000715r 2  B9 50 03       lda FS_FNAME_BUF,y
000718r 2  91 24          sta (CF_BUF_PTR),y
00071Ar 2  C8             iny
00071Br 2  C0 0B          cpy #11
00071Dr 2  D0 F6          bne @SaveCFCopyName
00071Fr 2                 ; Set flags = in use
00071Fr 2  A9 01          lda #FS_FLAG_USED
000721r 2  91 24          sta (CF_BUF_PTR),y            ; Y = 11 = FS_ENTRY_FLAGS
000723r 2                 ; Set start sector
000723r 2  A0 0C          ldy #FS_ENTRY_START
000725r 2  AD 4E 03       lda FS_NEXT_SEC
000728r 2  91 24          sta (CF_BUF_PTR),y
00072Ar 2  8D 48 03       sta FS_START_SEC
00072Dr 2  C8             iny
00072Er 2  AD 4F 03       lda FS_NEXT_SEC+1
000731r 2  91 24          sta (CF_BUF_PTR),y
000733r 2  8D 49 03       sta FS_START_SEC+1
000736r 2                 ; Set file size
000736r 2  A0 0E          ldy #FS_ENTRY_FSIZE
000738r 2  AD 4A 03       lda FS_FILE_SIZE
00073Br 2  91 24          sta (CF_BUF_PTR),y
00073Dr 2  C8             iny
00073Er 2  AD 4B 03       lda FS_FILE_SIZE+1
000741r 2  91 24          sta (CF_BUF_PTR),y
000743r 2                 ; Clear reserved bytes
000743r 2  A0 10          ldy #$10
000745r 2  A9 00          lda #$00
000747r 2               @SaveCFClrRsv:
000747r 2  91 24          sta (CF_BUF_PTR),y
000749r 2  C8             iny
00074Ar 2  C0 20          cpy #FS_ENTRY_SIZE
00074Cr 2  D0 F9          bne @SaveCFClrRsv
00074Er 2                 ; Write updated directory
00074Er 2  20 rr rr       jsr FsWriteDir
000751r 2  B0 3A          bcs @SaveCFIOErr
000753r 2                 ; Write data sectors from user-specified start address (MON_TMP)
000753r 2  AD 48 03       lda FS_START_SEC
000756r 2  85 26          sta CF_LBA
000758r 2  AD 49 03       lda FS_START_SEC+1
00075Br 2  85 27          sta CF_LBA+1
00075Dr 2  64 28          stz CF_LBA+2
00075Fr 2  64 29          stz CF_LBA+3
000761r 2                 ; Source = MON_TMP (start address)
000761r 2  A5 32          lda MON_TMP
000763r 2  85 24          sta CF_BUF_PTR
000765r 2  A5 33          lda MON_TMP+1
000767r 2  85 25          sta CF_BUF_PTR+1
000769r 2  AE 4C 03       ldx FS_SEC_COUNT
00076Cr 2  F0 10          beq @SaveCFOk
00076Er 2               @SaveCFSec:
00076Er 2  DA             phx
00076Fr 2  20 rr rr       jsr StWriteSector             ; Writes 512 bytes, advances CF_BUF_PTR
000772r 2  B0 18          bcs @SaveCFSecErr
000774r 2  E6 26          inc CF_LBA
000776r 2  D0 02          bne @SaveCFSecNext
000778r 2  E6 27          inc CF_LBA+1
00077Ar 2               @SaveCFSecNext:
00077Ar 2  FA             plx
00077Br 2  CA             dex
00077Cr 2  D0 F0          bne @SaveCFSec
00077Er 2               @SaveCFOk:
00077Er 2  AD 4A 03       lda FS_FILE_SIZE
000781r 2  85 2E          sta MON_ADDR
000783r 2  AD 4B 03       lda FS_FILE_SIZE+1
000786r 2  85 2F          sta MON_ADDR+1
000788r 2  20 rr rr       jsr MonPrintSaved             ; Print "SAVED nnnn BYTES"
00078Br 2  60             rts
00078Cr 2               @SaveCFSecErr:
00078Cr 2  FA             plx                           ; Balance stack
00078Dr 2               @SaveCFIOErr:
00078Dr 2  20 rr rr       jsr MonPrintIOErr
000790r 2  60             rts
000791r 2               @SaveCFDirFull:
000791r 2  A2 00          ldx #0
000793r 2               @SaveCFDFLoop:
000793r 2  BD rr rr       lda MonStrDirFull,x
000796r 2  F0 06          beq @SaveCFDFDone
000798r 2  20 rr rr       jsr Chrout
00079Br 2  E8             inx
00079Cr 2  80 F5          bra @SaveCFDFLoop
00079Er 2               @SaveCFDFDone:
00079Er 2  20 rr rr       jsr MonPrintCRLF
0007A1r 2  60             rts
0007A2r 2               @SaveError:
0007A2r 2  4C rr rr       jmp MonPrintError
0007A5r 2               
0007A5r 2               ; ============================================================================
0007A5r 2               ; MonCmdM — Memory dump (hex + ASCII, 8 bytes/row)
0007A5r 2               ; Syntax: M [addr] [addr]
0007A5r 2               ; Default: 8 lines (64 bytes). Remembers position for continuation.
0007A5r 2               ; ============================================================================
0007A5r 2               
0007A5r 2               MonCmdM:
0007A5r 2                 ; Preserve the continuation address across the parse attempt.  MonParseHex4
0007A5r 2                 ; opens with `stz MON_ADDR`, so it zeroes the address whether or not it finds
0007A5r 2                 ; any digits -- a bare M had therefore already lost the position it was meant
0007A5r 2                 ; to resume from and dumped from $0000 every time.  @StartOnly restores this.
0007A5r 2  A5 2E          lda MON_ADDR
0007A7r 2  85 32          sta MON_TMP
0007A9r 2  A5 2F          lda MON_ADDR+1
0007ABr 2  85 33          sta MON_TMP+1
0007ADr 2  20 rr rr       jsr MonSkipSpaces
0007B0r 2  20 rr rr       jsr MonParseHex4
0007B3r 2  90 22          bcc @StartOnly                ; No address given — resume where we left off
0007B5r 2                 ; Got first address in MON_ADDR — save it
0007B5r 2  A5 2E          lda MON_ADDR
0007B7r 2  85 32          sta MON_TMP
0007B9r 2  A5 2F          lda MON_ADDR+1
0007BBr 2  85 33          sta MON_TMP+1
0007BDr 2  20 rr rr       jsr MonSkipSpaces
0007C0r 2  20 rr rr       jsr MonParseHex4
0007C3r 2  90 12          bcc @StartOnly
0007C5r 2                 ; Got second address (end) in MON_ADDR
0007C5r 2  A5 2E          lda MON_ADDR
0007C7r 2  85 30          sta MON_END
0007C9r 2  A5 2F          lda MON_ADDR+1
0007CBr 2  85 31          sta MON_END+1
0007CDr 2                 ; Restore start address
0007CDr 2  A5 32          lda MON_TMP
0007CFr 2  85 2E          sta MON_ADDR
0007D1r 2  A5 33          lda MON_TMP+1
0007D3r 2  85 2F          sta MON_ADDR+1
0007D5r 2  80 15          bra @DumpRange
0007D7r 2               @StartOnly:
0007D7r 2                 ; Only start address — restore from MON_TMP
0007D7r 2  A5 32          lda MON_TMP
0007D9r 2  85 2E          sta MON_ADDR
0007DBr 2  A5 33          lda MON_TMP+1
0007DDr 2  85 2F          sta MON_ADDR+1
0007DFr 2               @UseDefault:
0007DFr 2                 ; Set end = start + 63 (8 lines x 8 bytes)
0007DFr 2  18             clc
0007E0r 2  A5 2E          lda MON_ADDR
0007E2r 2  69 3F          adc #63
0007E4r 2  85 30          sta MON_END
0007E6r 2  A5 2F          lda MON_ADDR+1
0007E8r 2  69 00          adc #0
0007EAr 2  85 31          sta MON_END+1
0007ECr 2               @DumpRange:
0007ECr 2  20 rr rr       jsr MonDumpLine
0007EFr 2  B0 0E          bcs @DumpDone                 ; Carry set = address wrapped past $FFFF
0007F1r 2                 ; Check if MON_ADDR > MON_END
0007F1r 2  A5 31          lda MON_END+1
0007F3r 2  C5 2F          cmp MON_ADDR+1
0007F5r 2  90 08          bcc @DumpDone
0007F7r 2  D0 F3          bne @DumpRange
0007F9r 2  A5 30          lda MON_END
0007FBr 2  C5 2E          cmp MON_ADDR
0007FDr 2  B0 ED          bcs @DumpRange
0007FFr 2               @DumpDone:
0007FFr 2  60             rts
000800r 2               
000800r 2               ; MonDumpLine — Dump 8 bytes at MON_ADDR as hex + ASCII, advance by 8
000800r 2               
000800r 2               MonDumpLine:
000800r 2                 ; Print ".:ADDR " (39 chars/line avoids 40-col auto-wrap + CRLF double-newline)
000800r 2  A9 2E          lda #'.'
000802r 2  20 rr rr       jsr Chrout
000805r 2  A9 3A          lda #':'
000807r 2  20 rr rr       jsr Chrout
00080Ar 2  20 rr rr       jsr MonPrintHex4
00080Dr 2  20 rr rr       jsr MonPrintSpace
000810r 2                 ; Print 8 hex bytes
000810r 2  A0 00          ldy #0
000812r 2               @HexLoop:
000812r 2  B1 2E          lda (MON_ADDR),y
000814r 2  5A             phy
000815r 2  20 rr rr       jsr MonPrintHex2
000818r 2  20 rr rr       jsr MonPrintSpace
00081Br 2  7A             ply
00081Cr 2  C8             iny
00081Dr 2  C0 08          cpy #8
00081Fr 2  90 F1          bcc @HexLoop
000821r 2                 ; Print 8 ASCII characters (no extra space — fits 40 cols)
000821r 2  A0 00          ldy #0
000823r 2               @AsciiLoop:
000823r 2  B1 2E          lda (MON_ADDR),y
000825r 2  C9 20          cmp #$20
000827r 2  90 04          bcc @NotPrint
000829r 2  C9 7F          cmp #$7F
00082Br 2  90 02          bcc @DoPrint
00082Dr 2               @NotPrint:
00082Dr 2  A9 2E          lda #'.'
00082Fr 2               @DoPrint:
00082Fr 2  5A             phy
000830r 2  20 rr rr       jsr Chrout
000833r 2  7A             ply
000834r 2  C8             iny
000835r 2  C0 08          cpy #8
000837r 2  90 EA          bcc @AsciiLoop
000839r 2                 ; Advance MON_ADDR by 8
000839r 2  18             clc
00083Ar 2  A5 2E          lda MON_ADDR
00083Cr 2  69 08          adc #8
00083Er 2  85 2E          sta MON_ADDR
000840r 2  90 04          bcc @NoCarry
000842r 2  E6 2F          inc MON_ADDR+1
000844r 2  F0 05          beq @Wrapped                  ; High byte became $00 = wrapped past $FFFF
000846r 2               @NoCarry:
000846r 2  20 rr rr       jsr MonPrintCRLF
000849r 2  18             clc                           ; Signal no overflow
00084Ar 2  60             rts
00084Br 2               @Wrapped:
00084Br 2  20 rr rr       jsr MonPrintCRLF
00084Er 2  38             sec                           ; Signal overflow
00084Fr 2  60             rts
000850r 2               
000850r 2               ; ============================================================================
000850r 2               ; MonCmdD — Disassemble 65C02 instructions
000850r 2               ; Syntax: D [addr] [addr]
000850r 2               ; Default: 20 lines. Remembers position for continuation.
000850r 2               ; ============================================================================
000850r 2               
000850r 2               MonCmdD:
000850r 2  20 rr rr       jsr MonSkipSpaces
000853r 2  20 rr rr       jsr MonParseHex4
000856r 2  90 2A          bcc @UseDefault
000858r 2                 ; Got first address
000858r 2  A5 2E          lda MON_ADDR
00085Ar 2  85 32          sta MON_TMP
00085Cr 2  A5 2F          lda MON_ADDR+1
00085Er 2  85 33          sta MON_TMP+1
000860r 2  20 rr rr       jsr MonSkipSpaces
000863r 2  20 rr rr       jsr MonParseHex4
000866r 2  90 12          bcc @StartOnly
000868r 2                 ; Got end address
000868r 2  A5 2E          lda MON_ADDR
00086Ar 2  85 30          sta MON_END
00086Cr 2  A5 2F          lda MON_ADDR+1
00086Er 2  85 31          sta MON_END+1
000870r 2  A5 32          lda MON_TMP
000872r 2  85 2E          sta MON_ADDR
000874r 2  A5 33          lda MON_TMP+1
000876r 2  85 2F          sta MON_ADDR+1
000878r 2  80 15          bra @DisRange
00087Ar 2               @StartOnly:
00087Ar 2  A5 32          lda MON_TMP
00087Cr 2  85 2E          sta MON_ADDR
00087Er 2  A5 33          lda MON_TMP+1
000880r 2  85 2F          sta MON_ADDR+1
000882r 2               @UseDefault:
000882r 2                 ; Disassemble 20 lines
000882r 2  A2 14          ldx #20
000884r 2               @DisCountLoop:
000884r 2  DA             phx
000885r 2  20 rr rr       jsr DisOneLine
000888r 2  FA             plx
000889r 2  B0 17          bcs @DisDone                  ; Carry set = address wrapped past $FFFF
00088Br 2  CA             dex
00088Cr 2  D0 F6          bne @DisCountLoop
00088Er 2  60             rts
00088Fr 2               @DisRange:
00088Fr 2  20 rr rr       jsr DisOneLine
000892r 2  B0 0E          bcs @DisDone                  ; Carry set = address wrapped past $FFFF
000894r 2                 ; Check if MON_ADDR > MON_END
000894r 2  A5 31          lda MON_END+1
000896r 2  C5 2F          cmp MON_ADDR+1
000898r 2  90 08          bcc @DisDone
00089Ar 2  D0 F3          bne @DisRange
00089Cr 2  A5 30          lda MON_END
00089Er 2  C5 2E          cmp MON_ADDR
0008A0r 2  B0 ED          bcs @DisRange
0008A2r 2               @DisDone:
0008A2r 2  60             rts
0008A3r 2               
0008A3r 2               ; ============================================================================
0008A3r 2               ; DisOneLine — Disassemble one instruction at MON_ADDR
0008A3r 2               ; Prints line, advances MON_ADDR by instruction length.
0008A3r 2               ; Uses: MON_BYTE=opcode, MON_TMP=mnemonic idx, MON_TMP+1=mode
0008A3r 2               ;       Stack holds instruction length throughout.
0008A3r 2               ; ============================================================================
0008A3r 2               
0008A3r 2               DisOneLine:
0008A3r 2                 ; Read opcode and look up table
0008A3r 2  A0 00          ldy #0
0008A5r 2  B1 2E          lda (MON_ADDR),y
0008A7r 2  85 34          sta MON_BYTE                  ; save opcode
0008A9r 2  0A             asl a                         ; opcode * 2 for table index
0008AAr 2  AA             tax
0008ABr 2  90 0C          bcc @LowHalf                  ; carry clear = opcodes $00-$7F
0008ADr 2  BD rr rr       lda DisOpcodeTable+256,x      ; opcodes $80-$FF: offset by 256
0008B0r 2  85 32          sta MON_TMP                   ; mnemonic index
0008B2r 2  BD rr rr       lda DisOpcodeTable+257,x
0008B5r 2  85 33          sta MON_TMP+1                 ; addressing mode
0008B7r 2  80 0A          bra @GotEntry
0008B9r 2               @LowHalf:
0008B9r 2  BD rr rr       lda DisOpcodeTable,x
0008BCr 2  85 32          sta MON_TMP                   ; mnemonic index
0008BEr 2  BD rr rr       lda DisOpcodeTable+1,x
0008C1r 2  85 33          sta MON_TMP+1                 ; addressing mode
0008C3r 2               @GotEntry:
0008C3r 2                 ; Get instruction length from mode
0008C3r 2  A6 33          ldx MON_TMP+1
0008C5r 2  BD rr rr       lda DisModeSizes,x
0008C8r 2  1A             inc a                         ; +1 for opcode = total length
0008C9r 2  48             pha                           ; save on stack (stays until end)
0008CAr 2                 ; Print prefix ".,ADDR" (no space — consistent with M command's .:ADDR)
0008CAr 2  A9 2E          lda #'.'
0008CCr 2  20 rr rr       jsr Chrout
0008CFr 2  A9 2C          lda #','
0008D1r 2  20 rr rr       jsr Chrout
0008D4r 2                 ; Print address
0008D4r 2  20 rr rr       jsr MonPrintHex4
0008D7r 2  20 rr rr       jsr MonPrintSpace
0008DAr 2  20 rr rr       jsr MonPrintSpace
0008DDr 2                 ; Print opcode byte
0008DDr 2  A5 34          lda MON_BYTE
0008DFr 2  20 rr rr       jsr MonPrintHex2
0008E2r 2                 ; Print 2nd byte or padding
0008E2r 2  68             pla
0008E3r 2  48             pha                           ; peek at length
0008E4r 2  C9 02          cmp #2
0008E6r 2  90 0C          bcc @Pad1
0008E8r 2  20 rr rr       jsr MonPrintSpace
0008EBr 2  A0 01          ldy #1
0008EDr 2  B1 2E          lda (MON_ADDR),y
0008EFr 2  20 rr rr       jsr MonPrintHex2
0008F2r 2  80 09          bra @Check3
0008F4r 2               @Pad1:
0008F4r 2  20 rr rr       jsr MonPrintSpace
0008F7r 2  20 rr rr       jsr MonPrintSpace
0008FAr 2  20 rr rr       jsr MonPrintSpace
0008FDr 2               @Check3:
0008FDr 2  68             pla
0008FEr 2  48             pha
0008FFr 2  C9 03          cmp #3
000901r 2  90 0C          bcc @Pad2
000903r 2  20 rr rr       jsr MonPrintSpace
000906r 2  A0 02          ldy #2
000908r 2  B1 2E          lda (MON_ADDR),y
00090Ar 2  20 rr rr       jsr MonPrintHex2
00090Dr 2  80 09          bra @AfterBytes
00090Fr 2               @Pad2:
00090Fr 2  20 rr rr       jsr MonPrintSpace
000912r 2  20 rr rr       jsr MonPrintSpace
000915r 2  20 rr rr       jsr MonPrintSpace
000918r 2               @AfterBytes:
000918r 2                 ; Separator before mnemonic
000918r 2  20 rr rr       jsr MonPrintSpace
00091Br 2  20 rr rr       jsr MonPrintSpace
00091Er 2                 ; Print mnemonic (3 chars)
00091Er 2  20 rr rr       jsr DisPrintMnemonic
000921r 2                 ; For RMB/SMB/BBR/BBS, append bit number digit
000921r 2  A5 32          lda MON_TMP
000923r 2  C9 03          cmp #MN_BBR
000925r 2  F0 11          beq @BitNum
000927r 2  C9 04          cmp #MN_BBS
000929r 2  F0 0D          beq @BitNum
00092Br 2  C9 2E          cmp #MN_RMB
00092Dr 2  F0 09          beq @BitNum
00092Fr 2  C9 37          cmp #MN_SMB
000931r 2  F0 05          beq @BitNum
000933r 2  20 rr rr       jsr MonPrintSpace             ; normal mnemonic — space separator
000936r 2  80 11          bra @Operand
000938r 2               @BitNum:
000938r 2  A5 34          lda MON_BYTE                  ; opcode encodes bit in upper nibble
00093Ar 2  4A             lsr a
00093Br 2  4A             lsr a
00093Cr 2  4A             lsr a
00093Dr 2  4A             lsr a
00093Er 2  29 07          and #$07
000940r 2  18             clc
000941r 2  69 30          adc #'0'
000943r 2  20 rr rr       jsr Chrout
000946r 2  20 rr rr       jsr MonPrintSpace
000949r 2               @Operand:
000949r 2                 ; Print operand based on addressing mode
000949r 2  A5 33          lda MON_TMP+1
00094Br 2  20 rr rr       jsr DisPrintOperand
00094Er 2                 ; CRLF
00094Er 2  20 rr rr       jsr MonPrintCRLF
000951r 2                 ; Advance MON_ADDR by instruction length
000951r 2  68             pla                           ; length from stack
000952r 2  18             clc
000953r 2  65 2E          adc MON_ADDR
000955r 2  85 2E          sta MON_ADDR
000957r 2  90 04          bcc @NoWrap
000959r 2  E6 2F          inc MON_ADDR+1
00095Br 2  F0 02          beq @DisWrapped               ; High byte became $00 = wrapped past $FFFF
00095Dr 2               @NoWrap:
00095Dr 2  18             clc                           ; Signal no overflow
00095Er 2  60             rts
00095Fr 2               @DisWrapped:
00095Fr 2  38             sec                           ; Signal overflow
000960r 2  60             rts
000961r 2               
000961r 2               ; DisPrintMnemonic — Print 3-char mnemonic from MON_TMP index
000961r 2               
000961r 2               DisPrintMnemonic:
000961r 2  A5 32          lda MON_TMP                   ; mnemonic index
000963r 2  0A             asl a                         ; index * 2
000964r 2  18             clc
000965r 2  65 32          adc MON_TMP                   ; + index = index * 3
000967r 2  AA             tax
000968r 2  BD rr rr       lda DisMnemonics,x
00096Br 2  DA             phx
00096Cr 2  20 rr rr       jsr Chrout
00096Fr 2  FA             plx
000970r 2  BD rr rr       lda DisMnemonics+1,x
000973r 2  DA             phx
000974r 2  20 rr rr       jsr Chrout
