0023E2r 2  A2 10                ldx     #ERR_CANTCONT
0023E4r 2  4C rr rr             jmp     BasErrorVec
0023E7r 2               @canCont:
0023E7r 2  AD 6D 03             lda     BAS_OLDTEXT
0023EAr 2  85 04                sta     TXTPTR
0023ECr 2  AD 6E 03             lda     BAS_OLDTEXT+1
0023EFr 2  85 05                sta     TXTPTR+1
0023F1r 2  AD 6B 03             lda     BAS_OLDLIN
0023F4r 2  8D 69 03             sta     BAS_CURLIN
0023F7r 2  AD 6C 03             lda     BAS_OLDLIN+1
0023FAr 2  8D 6A 03             sta     BAS_CURLIN+1
0023FDr 2  60                   rts
0023FEr 2               @synErr:
0023FEr 2  4C rr rr             jmp     SynErr
002401r 2               
002401r 2               ; ---------------------------------------------------------------------------
002401r 2               ; Statement: RESTORE -- DATAPTR := TXTTAB - 1.
002401r 2               ; ---------------------------------------------------------------------------
002401r 2               BasCmdRestore:
002401r 2  38                   sec
002402r 2  AD 5D 03             lda     BAS_TXTTAB
002405r 2  E9 01                sbc     #1
002407r 2  8D 1A 03             sta     BAS_DATAPTR
00240Ar 2  AD 5E 03             lda     BAS_TXTTAB+1
00240Dr 2  E9 00                sbc     #0
00240Fr 2  8D 1B 03             sta     BAS_DATAPTR+1
002412r 2  60                   rts
002413r 2               
002413r 2               ; ---------------------------------------------------------------------------
002413r 2               ; Statement: INPUT [<"prompt">{,;}] var[,var,...]
002413r 2               ;   Prompts user for input, reads a line, parses it into the variable list.
002413r 2               ;   "abc";VAR  prints  abc?    (question + space appended)
002413r 2               ;   "abc",VAR  prints  abc      (no question mark)
002413r 2               ;   no prompt: prints  ?
002413r 2               ;   On bad numeric input or premature end-of-line: "?REDO FROM START"
002413r 2               ;   and reprompt.  Trailing un-consumed input: "?EXTRA IGNORED".
002413r 2               ; ---------------------------------------------------------------------------
002413r 2               BasCmdInput:
002413r 2                       ; INPUT is illegal in direct mode.
002413r 2  AD 6A 03             lda     BAS_CURLIN+1
002416r 2  C9 FF                cmp     #$FF
002418r 2  D0 05                bne     @notDirect
00241Ar 2  A2 07                ldx     #ERR_ILLDIRECT
00241Cr 2  4C rr rr             jmp     BasErrorVec
00241Fr 2               @notDirect:
00241Fr 2                       ; ChrGot returns first char after the INPUT token.
00241Fr 2  20 rr rr             jsr     ChrGot
002422r 2  C9 22                cmp     #'"'
002424r 2  D0 27                bne     @noPrompt
002426r 2                       ; Parse string literal & print it; FrmEvl will leave descriptor in FAC.
002426r 2  20 rr rr             jsr     FrmEvl
002429r 2  20 rr rr             jsr     ChkStr
00242Cr 2  20 rr rr             jsr     PrintStrFAC
00242Fr 2  20 rr rr             jsr     FreFac
002432r 2  20 rr rr             jsr     ChrGot
002435r 2  C9 3B                cmp     #';'
002437r 2  F0 09                beq     @semi
002439r 2  C9 2C                cmp     #','
00243Br 2  D0 0D                bne     @badPrompt
00243Dr 2  20 rr rr             jsr     ChrGet                  ; consume ','
002440r 2  80 0E                bra     @afterPrompt
002442r 2               @semi:
002442r 2  20 rr rr             jsr     ChrGet                  ; consume ';'
002445r 2  20 rr rr             jsr     BasInpQues              ; '? '
002448r 2  80 06                bra     @afterPrompt
00244Ar 2               @badPrompt:
00244Ar 2  4C rr rr             jmp     SynErr
00244Dr 2               @noPrompt:
00244Dr 2  20 rr rr             jsr     BasInpQues              ; '? '
002450r 2               @afterPrompt:
002450r 2                       ; Save program TXTPTR (start of var-list) for REDO retry.
002450r 2  A5 04                lda     TXTPTR
002452r 2  8D 71 03             sta     BAS_INPSAV
002455r 2  A5 05                lda     TXTPTR+1
002457r 2  8D 72 03             sta     BAS_INPSAV+1
00245Ar 2               @retry:
00245Ar 2  20 rr rr             jsr     BasReadLine             ; reads to BAS_LINBUF, NUL-terminated, prints CRLF
00245Dr 2                       ; Set up data pointer with leading ',' sentinel just before LINBUF.
00245Dr 2  A9 2C                lda     #','
00245Fr 2  8D FF 03             sta     BAS_LINBUF-1
002462r 2  A9 FF                lda     #<(BAS_LINBUF-1)
002464r 2  85 3A                sta     BAS_TMP1
002466r 2  A9 03                lda     #>(BAS_LINBUF-1)
002468r 2  85 3B                sta     BAS_TMP1+1
00246Ar 2                       ; Restore program TXTPTR.
00246Ar 2  AD 71 03             lda     BAS_INPSAV
00246Dr 2  85 04                sta     TXTPTR
00246Fr 2  AD 72 03             lda     BAS_INPSAV+1
002472r 2  85 05                sta     TXTPTR+1
002474r 2  64 69                stz     BAS_INPUTFLG            ; INPUT mode ($00)
002476r 2               @nextVar:
002476r 2  20 rr rr             jsr     PtrGet                  ; advance program TXTPTR past var name
002479r 2  85 46                sta     BAS_FORPNT
00247Br 2  84 47                sty     BAS_FORPNT+1
00247Dr 2                       ; Save program TXTPTR; switch to data side.
00247Dr 2  A5 05                lda     TXTPTR+1
00247Fr 2  48                   pha
002480r 2  A5 04                lda     TXTPTR
002482r 2  48                   pha
002483r 2  A5 3A                lda     BAS_TMP1
002485r 2  85 04                sta     TXTPTR
002487r 2  A5 3B                lda     BAS_TMP1+1
002489r 2  85 05                sta     TXTPTR+1
00248Br 2  20 rr rr             jsr     ChrGot
00248Er 2  D0 05                bne     @gotData
002490r 2                       ; Out of input data before var list exhausted -> REDO.
002490r 2  68                   pla
002491r 2  68                   pla
002492r 2  4C rr rr             jmp     @doRedo
002495r 2               @gotData:
002495r 2  20 rr rr             jsr     ChrGet                  ; consume the separator/sentinel
002498r 2  24 64                bit     VALTYP
00249Ar 2  30 2E                bmi     @inpStr
00249Cr 2                       ; Numeric: must start with digit, '+', '-' or '.'; else REDO.
00249Cr 2  20 rr rr             jsr     ChrGot
00249Fr 2  90 11                bcc     @numOk                  ; carry clear == digit
0024A1r 2  C9 2D                cmp     #'-'
0024A3r 2  F0 0D                beq     @numOk
0024A5r 2  C9 2B                cmp     #'+'
0024A7r 2  F0 09                beq     @numOk
0024A9r 2  C9 2E                cmp     #'.'
0024ABr 2  F0 05                beq     @numOk
0024ADr 2                       ; bad numeric
0024ADr 2  68                   pla
0024AEr 2  68                   pla
0024AFr 2  4C rr rr             jmp     @doRedo
0024B2r 2               @numOk:
0024B2r 2  20 rr rr             jsr     Fin
0024B5r 2  A6 46                ldx     BAS_FORPNT
0024B7r 2  A4 47                ldy     BAS_FORPNT+1
0024B9r 2  20 rr rr             jsr     StoreFacAtYxRounded
0024BCr 2                       ; After Fin, ChrGot result must be NUL or ',' (Fin/ChrGot skips spaces).
0024BCr 2  20 rr rr             jsr     ChrGot
0024BFr 2  F0 0E                beq     @afterStore
0024C1r 2  C9 2C                cmp     #','
0024C3r 2  F0 0A                beq     @afterStore
0024C5r 2                       ; Garbage trailing the number -> REDO.
0024C5r 2  68                   pla
0024C6r 2  68                   pla
0024C7r 2  4C rr rr             jmp     @doRedo
0024CAr 2               @inpStr:
0024CAr 2  A2 00                ldx     #0                      ; INPUT stops an unquoted item at ',' only
0024CCr 2  20 rr rr             jsr     BasStrItem
0024CFr 2               @afterStore:
0024CFr 2                       ; Save data ptr; restore program TXTPTR.
0024CFr 2  A5 04                lda     TXTPTR
0024D1r 2  85 3A                sta     BAS_TMP1
0024D3r 2  A5 05                lda     TXTPTR+1
0024D5r 2  85 3B                sta     BAS_TMP1+1
0024D7r 2  68                   pla
0024D8r 2  85 04                sta     TXTPTR
0024DAr 2  68                   pla
0024DBr 2  85 05                sta     TXTPTR+1
0024DDr 2                       ; More variables?
0024DDr 2  20 rr rr             jsr     ChrGot
0024E0r 2  C9 2C                cmp     #','
0024E2r 2  D0 06                bne     @doneVars
0024E4r 2  20 rr rr             jsr     ChrGet                  ; consume ','
0024E7r 2  4C rr rr             jmp     @nextVar
0024EAr 2               @doneVars:
0024EAr 2                       ; Check for un-consumed input (EXTRA IGNORED).
0024EAr 2  A0 00                ldy     #0
0024ECr 2  B1 3A                lda     (BAS_TMP1),y
0024EEr 2  F0 12                beq     @inpDone
0024F0r 2                       ; Skip leading spaces; anything else is "extra".
0024F0r 2               @chkExtra:
0024F0r 2  B1 3A                lda     (BAS_TMP1),y
0024F2r 2  F0 0E                beq     @inpDone
0024F4r 2  C9 20                cmp     #' '
0024F6r 2  D0 03                bne     @hasExtra
0024F8r 2  C8                   iny
0024F9r 2  D0 F5                bne     @chkExtra
0024FBr 2               @hasExtra:
0024FBr 2  A9 rr                lda     #<MsgExtra
0024FDr 2  A0 rr                ldy     #>MsgExtra
0024FFr 2  20 rr rr             jsr     BasPrintStr
002502r 2               @inpDone:
002502r 2  60                   rts
002503r 2               @doRedo:
002503r 2  A9 rr                lda     #<MsgRedo
002505r 2  A0 rr                ldy     #>MsgRedo
002507r 2  20 rr rr             jsr     BasPrintStr
00250Ar 2  4C rr rr             jmp     @retry
00250Dr 2               
00250Dr 2               ; Print "? " prompt (used by INPUT and the ';' prompt-suffix path).
00250Dr 2               BasInpQues:
00250Dr 2  A9 3F                lda     #'?'
00250Fr 2  20 rr rr             jsr     PrintCh
002512r 2  A9 20                lda     #' '
002514r 2  4C rr rr             jmp     PrintCh
002517r 2               
002517r 2               MsgRedo:
002517r 2  3F 52 45 44          .byte   "?REDO FROM START", $0D, $0A, 0
00251Br 2  4F 20 46 52  
00251Fr 2  4F 4D 20 53  
00252Ar 2               MsgExtra:
00252Ar 2  3F 45 58 54          .byte   "?EXTRA IGNORED", $0D, $0A, 0
00252Er 2  52 41 20 49  
002532r 2  47 4E 4F 52  
00253Br 2               
00253Br 2               ; ---------------------------------------------------------------------------
00253Br 2               ; Statement: READ var[,var,...] -- pull next DATA item from BAS_DATAPTR
00253Br 2               ; into the variable pointed to by PtrGet.
00253Br 2               ; ---------------------------------------------------------------------------
00253Br 2               ; ---------------------------------------------------------------------------
00253Br 2               ; BasStrItem -- read one string item at TXTPTR into the variable BAS_FORPNT
00253Br 2               ; points at.  Shared by INPUT and READ, which differ only in what ends an
00253Br 2               ; unquoted item: INPUT stops at ',' or NUL, READ also stops at ':' because a
00253Br 2               ; DATA statement can be followed by another statement on the same line.
00253Br 2               ;
00253Br 2               ; On entry : X        = the extra unquoted terminator (StrLt2's CHARAC)
00253Br 2               ;            TXTPTR   = first character of the item
00253Br 2               ;            FORPNT   = the variable's 3-byte descriptor slot
00253Br 2               ; On exit  : TXTPTR advanced past the item, descriptor stored, temp popped.
00253Br 2               ; ---------------------------------------------------------------------------
00253Br 2               BasStrItem:
00253Br 2                       ; A '"' here means quote-mode (terminator '"' or NUL); anything else
00253Br 2                       ; is a bare item running to X, ',' or NUL.
00253Br 2  A0 00                ldy     #0
00253Dr 2  B1 04                lda     (TXTPTR),y
00253Fr 2  C9 22                cmp     #'"'
002541r 2  F0 0C                beq     @quoted
002543r 2  86 44                stx     CHARAC
002545r 2  A9 2C                lda     #','
002547r 2  85 6A                sta     ENDCHR
002549r 2  A5 04                lda     TXTPTR                  ; StrLt2's source = TXTPTR
00254Br 2  A4 05                ldy     TXTPTR+1
00254Dr 2  80 0E                bra     @call
00254Fr 2               @quoted:
00254Fr 2  85 44                sta     CHARAC                  ; A is still '"' from the compare
002551r 2  85 6A                sta     ENDCHR
002553r 2  18                   clc                             ; skip it: source = TXTPTR + 1
002554r 2  A5 04                lda     TXTPTR
002556r 2  69 01                adc     #1
002558r 2  A4 05                ldy     TXTPTR+1
00255Ar 2  90 01                bcc     @call
00255Cr 2  C8                   iny
00255Dr 2               @call:
00255Dr 2  20 rr rr             jsr     StrLt2
002560r 2                       ; StrLt2 leaves STRNG2 past the text it consumed -- at the terminator
002560r 2                       ; for an unquoted item, just past the closing '"' for a quoted one.
002560r 2                       ; TXTPTR has to follow it: for INPUT so the trailing-extra check sees
002560r 2                       ; only what really remained on the line, and for READ so the next one
002560r 2                       ; doesn't start again in the middle of the item this one took.
002560r 2  A5 1E                lda     STRNG2
002562r 2  85 04                sta     TXTPTR
002564r 2  A5 1F                lda     STRNG2+1
002566r 2  85 05                sta     TXTPTR+1
002568r 2  A0 00                ldy     #0
00256Ar 2  A5 0E                lda     FAC
00256Cr 2  91 46                sta     (BAS_FORPNT),y
00256Er 2  C8                   iny
00256Fr 2  A5 0F                lda     FAC+1
002571r 2  91 46                sta     (BAS_FORPNT),y
002573r 2  C8                   iny
002574r 2  A5 10                lda     FAC+2
002576r 2  91 46                sta     (BAS_FORPNT),y
002578r 2                       ; StrLt2 pushed a temporary descriptor via PutNew.  The variable owns
002578r 2                       ; the heap copy now, so pop the temp -- do NOT use FreFac, which would
002578r 2                       ; reclaim the heap we just handed over.  Leaving temps unfreed leaks
002578r 2                       ; the 3-slot temp stack, both overflowing it (?FORMULA TOO COMPLEX)
002578r 2                       ; and corrupting later strings via stale descriptor pointers.
002578r 2  A5 11                lda     FAC+3
00257Ar 2  A4 12                ldy     FAC+4
00257Cr 2  4C rr rr             jmp     FreTms
00257Fr 2               
00257Fr 2               BasCmdRead:
00257Fr 2  AE 1A 03             ldx     BAS_DATAPTR
002582r 2  AC 1B 03             ldy     BAS_DATAPTR+1
002585r 2  A9 98                lda     #$98                    ; INPUTFLG = $98 means READ mode
002587r 2  2C                   .byte   $2C
002588r 2               BasInpDoit:
002588r 2  A9 00                lda     #0
00258Ar 2  85 69                sta     BAS_INPUTFLG
00258Cr 2  86 3A                stx     BAS_TMP1                ; TMP1 = data pointer
00258Er 2  84 3B                sty     BAS_TMP1+1
002590r 2               @nextVar:
002590r 2                       ; TXTPTR currently points into program at variable name.
002590r 2  20 rr rr             jsr     PtrGet                  ; advances TXTPTR past var name
002593r 2  85 46                sta     BAS_FORPNT
002595r 2  84 47                sty     BAS_FORPNT+1
002597r 2                       ; Save program TXTPTR on hw stack, switch TXTPTR to data ptr.
002597r 2  A5 05                lda     TXTPTR+1
002599r 2  48                   pha
00259Ar 2  A5 04                lda     TXTPTR
00259Cr 2  48                   pha
00259Dr 2  A5 3A                lda     BAS_TMP1
00259Fr 2  85 04                sta     TXTPTR
0025A1r 2  A5 3B                lda     BAS_TMP1+1
0025A3r 2  85 05                sta     TXTPTR+1
0025A5r 2  20 rr rr             jsr     ChrGot
0025A8r 2  D0 08                bne     @gotData
0025AAr 2                       ; Out of items on this line - find next DATA.
0025AAr 2  20 rr rr             jsr     BasFindData
0025ADr 2  90 03                bcc     @gotData
0025AFr 2  4C rr rr             jmp     @oodata
0025B2r 2               @gotData:
0025B2r 2                       ; Advance past separator (',' between items, ' ' after DATA token,
0025B2r 2                       ; or quote-delimiter for strings).  ChrGet also skips spaces.
0025B2r 2  20 rr rr             jsr     ChrGet
0025B5r 2                       ; Parse value at TXTPTR (data side).
0025B5r 2  24 64                bit     VALTYP
0025B7r 2  30 0C                bmi     @readStr
0025B9r 2                       ; Numeric.
0025B9r 2  20 rr rr             jsr     Fin
0025BCr 2  A6 46                ldx     BAS_FORPNT
0025BEr 2  A4 47                ldy     BAS_FORPNT+1
0025C0r 2  20 rr rr             jsr     StoreFacAtYxRounded
0025C3r 2  80 05                bra     @afterStore
0025C5r 2               @readStr:
0025C5r 2                       ; Previously this called StrLt2 without setting up its (A,Y) source
0025C5r 2                       ; argument at all, so every DATA string pointed into zero page: an
0025C5r 2                       ; unquoted item read back empty and a quoted one read back as garbage
0025C5r 2                       ; from $0022.  BasStrItem is INPUT's path, which had it right.
0025C5r 2  A2 3A                ldx     #':'                    ; a DATA item also ends at a statement break
0025C7r 2  20 rr rr             jsr     BasStrItem
0025CAr 2               @afterStore:
0025CAr 2                       ; Save updated data ptr.
0025CAr 2  A5 04                lda     TXTPTR
0025CCr 2  85 3A                sta     BAS_TMP1
0025CEr 2  A5 05                lda     TXTPTR+1
0025D0r 2  85 3B                sta     BAS_TMP1+1
0025D2r 2                       ; Restore program TXTPTR.
0025D2r 2  68                   pla
0025D3r 2  85 04                sta     TXTPTR
0025D5r 2  68                   pla
0025D6r 2  85 05                sta     TXTPTR+1
0025D8r 2                       ; If next program byte is ',', another variable follows.
0025D8r 2  20 rr rr             jsr     ChrGot
0025DBr 2  C9 2C                cmp     #','
0025DDr 2  D0 05                bne     @done
0025DFr 2  20 rr rr             jsr     ChrGet
0025E2r 2  80 AC                bra     @nextVar
0025E4r 2               @done:
0025E4r 2                       ; Persist data ptr.
0025E4r 2  A5 3A                lda     BAS_TMP1
0025E6r 2  8D 1A 03             sta     BAS_DATAPTR
0025E9r 2  A5 3B                lda     BAS_TMP1+1
0025EBr 2  8D 1B 03             sta     BAS_DATAPTR+1
0025EEr 2  60                   rts
0025EFr 2               @oodata:
0025EFr 2  A2 0E                ldx     #ERR_OD
0025F1r 2  4C rr rr             jmp     BasErrorVec
0025F4r 2               
0025F4r 2               ; ---------------------------------------------------------------------------
0025F4r 2               ; BasFindData -- starting from TXTPTR (positioned somewhere within a line's
0025F4r 2               ; payload), advance to the byte after the next DATA token in the program.
0025F4r 2               ; Returns carry SET on out-of-data, carry CLEAR with TXTPTR at first byte
0025F4r 2               ; AFTER the DATA token (i.e. at the first DATA item).
0025F4r 2               ; ---------------------------------------------------------------------------
0025F4r 2               BasFindData:
0025F4r 2               @scanByte:
0025F4r 2  A0 00                ldy     #0
0025F6r 2  B1 04                lda     (TXTPTR),y
0025F8r 2  F0 1F                beq     @atEnd
0025FAr 2  C9 83                cmp     #TOK_DATA
0025FCr 2  F0 2E                beq     @found
0025FEr 2  C9 22                cmp     #'"'
002600r 2  D0 12                bne     @advance1
002602r 2                       ; Skip quoted string (advance TXTPTR past closing quote or NUL).
002602r 2  20 rr rr             jsr     @incTxt
002605r 2               @inStr:
002605r 2  A0 00                ldy     #0
002607r 2  B1 04                lda     (TXTPTR),y
002609r 2  F0 0E                beq     @atEnd
00260Br 2  20 rr rr             jsr     @incTxt
00260Er 2  C9 22                cmp     #'"'
002610r 2  D0 F3                bne     @inStr
002612r 2  80 E0                bra     @scanByte
002614r 2               @advance1:
002614r 2  20 rr rr             jsr     @incTxt
002617r 2  80 DB                bra     @scanByte
002619r 2               @atEnd:
002619r 2                       ; (TXTPTR) is on the line's $00 terminator.  Bytes immediately after
002619r 2                       ; are the next line's [next-lo][next-hi][num-lo][num-hi][payload..].
002619r 2                       ; Check next-pointer at offset +2 (next-hi); if 0, end of program.
002619r 2  A0 02                ldy     #2
00261Br 2  B1 04                lda     (TXTPTR),y
00261Dr 2  F0 0F                beq     @oodata
00261Fr 2                       ; Advance TXTPTR by 5: past terminator (1) + line header (4).
00261Fr 2  18                   clc
002620r 2  A5 04                lda     TXTPTR
002622r 2  69 05                adc     #5
002624r 2  85 04                sta     TXTPTR
002626r 2  90 CC                bcc     @scanByte
002628r 2  E6 05                inc     TXTPTR+1
00262Ar 2  80 C8                bra     @scanByte
00262Cr 2               @found:
00262Cr 2                       ; TXTPTR is left AT the TOK_DATA byte; caller's CHRGET advances past.
00262Cr 2  18                   clc
00262Dr 2  60                   rts
00262Er 2               @oodata:
00262Er 2  38                   sec
00262Fr 2  60                   rts
002630r 2               @incTxt:
002630r 2  E6 04                inc     TXTPTR
002632r 2  D0 02                bne     @r
002634r 2  E6 05                inc     TXTPTR+1
002636r 2               @r:
002636r 2  60                   rts
002637r 2               
002637r 2               ; ---------------------------------------------------------------------------
002637r 2               ; Statement: FOR var = expr1 TO expr2 [STEP expr3]
002637r 2               ; Pushes 18-byte frame on CPU stack:
002637r 2               ;   [tag $81][VAR-lo][VAR-hi][STEP-FP (5)][STEP-sign][CURLIN-lo][CURLIN-hi]
002637r 2               ;   [TXTPTR-lo][TXTPTR-hi][LIMIT-FP (5)]
002637r 2               ; ---------------------------------------------------------------------------
002637r 2               BasCmdFor:
002637r 2                       ; Set SUBFLG so PtrGet doesn't recurse on FN.
002637r 2  A9 80                lda     #$80
002639r 2  85 68                sta     SUBFLG
00263Br 2  20 rr rr             jsr     BasCmdLet               ; consumes "var = expr"
00263Er 2                       ; PtrGet (inside LET) saved VARPNT in FORPNT (hopefully). Re-fetch
00263Er 2                       ; FORPNT from the assignment, but BasCmdLet doesn't set FORPNT in
00263Er 2                       ; our impl.  Re-parse the variable name by rewinding TXTPTR via
00263Er 2                       ; CURLIN scan.  Cheat: BasCmdLet leaves VARPNT current.
00263Er 2  A5 3F                lda     VARPNT
002640r 2  85 46                sta     BAS_FORPNT
002642r 2  A5 40                lda     VARPNT+1
002644r 2  85 47                sta     BAS_FORPNT+1
002646r 2                       ; Discard any prior FOR frame for the same variable to avoid leak.
002646r 2  20 rr rr             jsr     GtForPnt
002649r 2  90 00                bcc     @noOld                  ; carry clear -> no matching frame
00264Br 2                       ; The prior-frame pop is still skipped: the runtime tolerates one stray
00264Br 2                       ; frame, and msbasic re-uses the slot only when an explicit FOR with a
00264Br 2                       ; matching variable already exists, which is rare. GtForPnt does now
00264Br 2                       ; report found/not-found in carry (Z was ambiguous and unusable), so
00264Br 2                       ; this branch is at least honest about which case it is in.
00264Br 2               @noOld:
00264Br 2                       ; Discard our caller's (BasExecuteStatement's) return address so
00264Br 2                       ; that the FOR frame sits on the stack with no other junk above it.
00264Br 2                       ; We will JMP BasNewstt at the end instead of RTSing.
00264Br 2  68                   pla
00264Cr 2  68                   pla
00264Dr 2                       ; Push limit (will be parsed below) -- we lay out the frame as:
00264Dr 2                       ;   pushed first (deepest): TXTPTR, CURLIN, LIMIT (5), STEP-sign,
00264Dr 2                       ;   STEP (5), VAR-addr, $81-tag.
00264Dr 2                       ; We don't know LIMIT/STEP yet; we push placeholders and patch.
00264Dr 2                       ; Easier: parse limit & step first, then push frame in one go.
00264Dr 2  A9 9C                lda     #TOK_TO
00264Fr 2  20 rr rr             jsr     SynChr
002652r 2  20 rr rr             jsr     FrmNum
002655r 2                       ; Strip sign info on limit (msbasic stores limit unsigned-magnitude
002655r 2                       ; with sign packed).  Pack FACSIGN bit 7 -> FAC+1 bit 7.
002655r 2  A5 13                lda     FACSIGN
002657r 2  09 7F                ora     #$7F
002659r 2  25 0F                and     FAC+1
00265Br 2  85 0F                sta     FAC+1
00265Dr 2                       ; Save LIMIT temporarily in BAS_TEMP1..+4 (5 bytes).
00265Dr 2  A2 04                ldx     #4
00265Fr 2               @saveLimit:
00265Fr 2  B5 0E                lda     FAC,x
002661r 2  95 4D                sta     BAS_TEMP1,x
002663r 2  CA                   dex
002664r 2  10 F9                bpl     @saveLimit
002666r 2                       ; STEP: default 1, or evaluate after TOK_STEP.
002666r 2  20 rr rr             jsr     ChrGot
002669r 2  C9 A1                cmp     #TOK_STEP
00266Br 2  D0 08                bne     @defStep
00266Dr 2  20 rr rr             jsr     ChrGet
002670r 2  20 rr rr             jsr     FrmNum
002673r 2  80 07                bra     @gotStep
002675r 2               @defStep:
002675r 2  A9 rr                lda     #<ConstOne
002677r 2  A0 rr                ldy     #>ConstOne
002679r 2  20 rr rr             jsr     LoadFacFromYa
00267Cr 2               @gotStep:
00267Cr 2  20 rr rr             jsr     Sign                    ; A = step sign byte (-1/0/1)
00267Fr 2  85 52                sta     BAS_TEMP2               ; stash step sign
002681r 2                       ; Pack sign of FAC into FAC+1 bit7 then save STEP into BAS_TEMP2+1..+5.
002681r 2  A5 13                lda     FACSIGN
002683r 2  09 7F                ora     #$7F
002685r 2  25 0F                and     FAC+1
002687r 2  85 0F                sta     FAC+1
002689r 2  A2 04                ldx     #4
00268Br 2               @saveStep:
00268Br 2  B5 0E                lda     FAC,x
00268Dr 2  95 53                sta     BAS_TEMP2+1,x
00268Fr 2  CA                   dex
002690r 2  10 F9                bpl     @saveStep
002692r 2                       ; Now push the frame on stack (deepest first):
002692r 2                       ;   TXTPTR-hi, TXTPTR-lo, CURLIN-hi, CURLIN-lo,
002692r 2                       ;   LIMIT[4..0]   (deepest=LIMIT[4], so LIMIT[0] ends at $010A,x),
002692r 2                       ;   STEP-sign,
002692r 2                       ;   STEP[4..0]    (deepest=STEP[4], so STEP[0]  ends at $0104,x),
002692r 2                       ;   VAR-hi, VAR-lo, $81
002692r 2  A5 05                lda     TXTPTR+1
002694r 2  48                   pha
002695r 2  A5 04                lda     TXTPTR
002697r 2  48                   pha
002698r 2  AD 6A 03             lda     BAS_CURLIN+1
00269Br 2  48                   pha
00269Cr 2  AD 69 03             lda     BAS_CURLIN
00269Fr 2  48                   pha
0026A0r 2  A2 04                ldx     #4
0026A2r 2               @pushLim:
0026A2r 2  B5 4D                lda     BAS_TEMP1,x
0026A4r 2  48                   pha
0026A5r 2  CA                   dex
0026A6r 2  10 FA                bpl     @pushLim
0026A8r 2  A5 52                lda     BAS_TEMP2               ; step sign
0026AAr 2  48                   pha
0026ABr 2  A2 05                ldx     #5
0026ADr 2               @pushStep:
0026ADr 2  B5 52                lda     BAS_TEMP2,x
0026AFr 2  48                   pha
0026B0r 2  CA                   dex
0026B1r 2  D0 FA                bne     @pushStep
0026B3r 2  A5 47                lda     BAS_FORPNT+1
0026B5r 2  48                   pha
0026B6r 2  A5 46                lda     BAS_FORPNT
0026B8r 2  48                   pha
0026B9r 2  A9 81                lda     #TOK_FOR
0026BBr 2  48                   pha
0026BCr 2  4C rr rr             jmp     BasNewstt               ; resume statement loop with frame in place
0026BFr 2               
0026BFr 2               ConstOne:
0026BFr 2  81 00 00 00          .byte   $81,$00,$00,$00,$00     ; FP +1.0
0026C3r 2  00           
0026C4r 2               
0026C4r 2               ; ---------------------------------------------------------------------------
0026C4r 2               ; Statement: NEXT [var]
0026C4r 2               ; Locate matching FOR frame, increment var by step, test against limit,
0026C4r 2               ; loop back if more iterations remain, else discard frame and continue.
0026C4r 2               ; ---------------------------------------------------------------------------
0026C4r 2               BasCmdNext:
0026C4r 2  20 rr rr             jsr     ChrGot
0026C7r 2  F0 0D                beq     @anyVar
0026C9r 2  C9 3A                cmp     #':'
0026CBr 2  F0 09                beq     @anyVar
0026CDr 2  20 rr rr             jsr     PtrGet
0026D0r 2  85 46                sta     BAS_FORPNT
0026D2r 2  84 47                sty     BAS_FORPNT+1
0026D4r 2  80 06                bra     @find
0026D6r 2               @anyVar:
0026D6r 2                       ; "NEXT" without a variable: set FORPNT = 0 so GtForPnt copies the
0026D6r 2                       ; stack-frame's var address into FORPNT and then trivially matches
0026D6r 2                       ; (any FOR frame is acceptable).
0026D6r 2  A9 00                lda     #0
0026D8r 2  85 46                sta     BAS_FORPNT
0026DAr 2  85 47                sta     BAS_FORPNT+1
0026DCr 2               @find:
0026DCr 2                       ; Carry, not Z: GtForPnt's not-found paths end in `lda #0`, which sets
0026DCr 2                       ; Z, so testing `beq` here read "no frame" as "found" -- a bare NEXT
0026DCr 2                       ; then did `txs` onto a garbage offset and died as ?SYNTAX ERROR IN 0
0026DCr 2                       ; instead of ?NEXT WITHOUT FOR.
0026DCr 2  20 rr rr             jsr     GtForPnt
0026DFr 2  B0 05                bcs     @found
0026E1r 2  A2 0D                ldx     #ERR_NF
0026E3r 2  4C rr rr             jmp     BasErrorVec
0026E6r 2               @found:
0026E6r 2                       ; X = stack offset of (tag - 1).  txs makes SP = X so the frame
0026E6r 2                       ; sits at $101+X..$112+X.  All subsequent accesses use $0101+offset,x
0026E6r 2                       ; just like msbasic.
0026E6r 2  9A                   txs
0026E7r 2                       ; Frame layout (tag at $0101+X):
0026E7r 2                       ;   $0101+X = $81 tag
0026E7r 2                       ;   $0102+X = VAR-lo
0026E7r 2                       ;   $0103+X = VAR-hi
0026E7r 2                       ;   $0104+X..$0108+X = STEP (5 bytes FP, FAC[0..4] ascending)
0026E7r 2                       ;   $0109+X = STEP-sign
0026E7r 2                       ;   $010A+X..$010E+X = LIMIT (5 bytes FP, FAC[0..4] ascending)
0026E7r 2                       ;   $010F+X = CURLIN-lo
0026E7r 2                       ;   $0110+X = CURLIN-hi
0026E7r 2                       ;   $0111+X = TXTPTR-lo
0026E7r 2                       ;   $0112+X = TXTPTR-hi
0026E7r 2                       ; Load STEP into FAC.
0026E7r 2  A9 01                lda     #$01
0026E9r 2  85 3B                sta     BAS_TMP1+1
0026EBr 2  8A                   txa
0026ECr 2  18                   clc
0026EDr 2  69 04                adc     #$04
0026EFr 2  85 3A                sta     BAS_TMP1                ; TMP1 -> STEP[0] at $0104,x
0026F1r 2  A5 3A                lda     BAS_TMP1
0026F3r 2  A4 3B                ldy     BAS_TMP1+1
0026F5r 2  20 rr rr             jsr     LoadFacFromYa
0026F8r 2                       ; FACSIGN := step sign byte at $0109,x.
0026F8r 2  BD 09 01             lda     $0109,x
0026FBr 2  85 13                sta     FACSIGN
0026FDr 2                       ; FAC += variable.
0026FDr 2  BD 02 01             lda     $0102,x
002700r 2  BC 03 01             ldy     $0103,x
002703r 2  85 46                sta     BAS_FORPNT
002705r 2  84 47                sty     BAS_FORPNT+1
002707r 2  20 rr rr             jsr     FAdd
00270Ar 2  20 rr rr             jsr     SetFor
00270Dr 2                       ; Compare FAC with LIMIT (at $010A,x).
00270Dr 2  BA                   tsx                             ; reload x (FAdd may have used it)
00270Er 2  8A                   txa
00270Fr 2  18                   clc
002710r 2  69 0A                adc     #$0A
002712r 2  85 3A                sta     BAS_TMP1
002714r 2  A9 01                lda     #$01
002716r 2  85 3B                sta     BAS_TMP1+1
002718r 2  A5 3A                lda     BAS_TMP1
00271Ar 2  A4 3B                ldy     BAS_TMP1+1
00271Cr 2  20 rr rr             jsr     FComp
00271Fr 2  BA                   tsx
002720r 2  38                   sec
002721r 2  FD 09 01             sbc     $0109,x                 ; A - step-sign
002724r 2  F0 19                beq     @loopDone
002726r 2                       ; Continue: restore CURLIN/TXTPTR from frame, JMP NEWSTT (don't RTS).
002726r 2  BD 0F 01             lda     $010F,x
002729r 2  8D 69 03             sta     BAS_CURLIN
00272Cr 2  BD 10 01             lda     $0110,x
00272Fr 2  8D 6A 03             sta     BAS_CURLIN+1
002732r 2  BD 11 01             lda     $0111,x
002735r 2  85 04                sta     TXTPTR
002737r 2  BD 12 01             lda     $0112,x
00273Ar 2  85 05                sta     TXTPTR+1
00273Cr 2  4C rr rr             jmp     BasNewstt
00273Fr 2               @loopDone:
00273Fr 2                       ; Discard frame: SP := X + 18.
00273Fr 2  8A                   txa
002740r 2  18                   clc
002741r 2  69 12                adc     #18
002743r 2  AA                   tax
002744r 2  9A                   txs
002745r 2                       ; Allow ", var" to chain into another NEXT.
002745r 2  20 rr rr             jsr     ChrGot
002748r 2  C9 2C                cmp     #','
00274Ar 2  D0 06                bne     @retNewstt
00274Cr 2  20 rr rr             jsr     ChrGet
00274Fr 2  4C rr rr             jmp     BasCmdNext
002752r 2               @retNewstt:
002752r 2  4C rr rr             jmp     BasNewstt
002755r 2               
002755r 2               ; ---------------------------------------------------------------------------
002755r 2               ; Statement: DEF FN A(X) = expr
002755r 2               ; Stored in the variable's 5 value bytes:
002755r 2               ;   [TXTPTR-of-expr-lo][TXTPTR-of-expr-hi][param-name-lo][param-name-hi][0]
002755r 2               ; ---------------------------------------------------------------------------
002755r 2               BasCmdDef:
002755r 2                       ; Expect: FN <name>(<param>) = <expr>
002755r 2  A9 9D                lda     #TOK_FN
002757r 2  20 rr rr             jsr     SynChr
00275Ar 2  09 80                ora     #$80
00275Cr 2  85 68                sta     SUBFLG                  ; tell PtrGet "this is a DEF FN var"
00275Er 2  20 rr rr             jsr     PtrGet
002761r 2                       ; VARPNT = address of FN var slot.
002761r 2  85 81                sta     BAS_FNCNAM
002763r 2  84 82                sty     BAS_FNCNAM+1
002765r 2  20 rr rr             jsr     ChkNum
002768r 2                       ; Expect '(' name ')' = expr
002768r 2                       ; Param name parsed by recursive PtrGet inside FrmEvl on call;
002768r 2                       ; here we just record (param-name) by parsing it ourselves.
002768r 2  A9 28                lda     #'('
00276Ar 2  20 rr rr             jsr     SynChr
00276Dr 2  A9 80                lda     #$80
00276Fr 2  85 68                sta     SUBFLG
002771r 2  20 rr rr             jsr     PtrGet
002774r 2                       ; VARPNT = param var addr.  Save it.
002774r 2  A5 3F                lda     VARPNT
002776r 2  85 3A                sta     BAS_TMP1
002778r 2  A5 40                lda     VARPNT+1
00277Ar 2  85 3B                sta     BAS_TMP1+1
00277Cr 2  20 rr rr             jsr     ChkNum
00277Fr 2  A9 29                lda     #')'
002781r 2  20 rr rr             jsr     SynChr
002784r 2  A9 3D                lda     #'='
002786r 2  20 rr rr             jsr     SynChr
002789r 2                       ; Reject in direct mode.
002789r 2  AD 6A 03             lda     BAS_CURLIN+1
00278Cr 2  C9 FF                cmp     #$FF
00278Er 2  D0 05                bne     @ok
002790r 2  A2 07                ldx     #ERR_ILLDIRECT
002792r 2  4C rr rr             jmp     BasErrorVec
002795r 2               @ok:
002795r 2                       ; Store [TXTPTR][param][0] in FN var.
002795r 2  A0 00                ldy     #0
002797r 2  A5 04                lda     TXTPTR
002799r 2  91 81                sta     (BAS_FNCNAM),y
00279Br 2  C8                   iny
00279Cr 2  A5 05                lda     TXTPTR+1
00279Er 2  91 81                sta     (BAS_FNCNAM),y
0027A0r 2  C8                   iny
0027A1r 2  A5 3A                lda     BAS_TMP1
0027A3r 2  91 81                sta     (BAS_FNCNAM),y
0027A5r 2  C8                   iny
0027A6r 2  A5 3B                lda     BAS_TMP1+1
0027A8r 2  91 81                sta     (BAS_FNCNAM),y
0027AAr 2  C8                   iny
0027ABr 2  A9 00                lda     #0
0027ADr 2  91 81                sta     (BAS_FNCNAM),y
0027AFr 2                       ; Skip past expression body.
0027AFr 2  20 rr rr             jsr     BasDatan
0027B2r 2  4C rr rr             jmp     BasAddon
0027B5r 2               
0027B5r 2               ; ---------------------------------------------------------------------------
0027B5r 2               ; FnCall -- evaluator-side handler for "FN A(expr)".
0027B5r 2               ; Called by FrmEvl when it sees TOK_FN.  Evaluates argument, swaps in the
0027B5r 2               ; param's stored value, executes the FN expression, and restores the param.
0027B5r 2               ; ---------------------------------------------------------------------------
0027B5r 2               FnCall:
0027B5r 2  20 rr rr             jsr     ChrGet                  ; consume FN
0027B8r 2  09 80                ora     #$80
0027BAr 2  85 68                sta     SUBFLG
0027BCr 2  20 rr rr             jsr     PtrGet                  ; locate FN var
0027BFr 2  8D 73 03             sta     BAS_FNPTR               ; durable copy: FNCNAM lives in ZP and
0027C2r 2  8C 74 03             sty     BAS_FNPTR+1             ; is scratch for Garbag
0027C5r 2  85 81                sta     BAS_FNCNAM
0027C7r 2  84 82                sty     BAS_FNCNAM+1
0027C9r 2  20 rr rr             jsr     ChkNum
0027CCr 2                       ; Read param ptr from FN slot.
0027CCr 2  A0 02                ldy     #2
0027CEr 2  B1 81                lda     (BAS_FNCNAM),y
0027D0r 2  85 3F                sta     VARPNT
0027D2r 2  F0 57                beq     @undef
0027D4r 2  C8                   iny
0027D5r 2  B1 81                lda     (BAS_FNCNAM),y
0027D7r 2  85 40                sta     VARPNT+1
0027D9r 2                       ; Evaluate '(arg)'
0027D9r 2  A9 28                lda     #'('
0027DBr 2  20 rr rr             jsr     SynChr
0027DEr 2                       ; Save param's current FP value (5 bytes) on stack.
0027DEr 2  A0 04                ldy     #4
0027E0r 2               @savep:
0027E0r 2  B1 3F                lda     (VARPNT),y
0027E2r 2  48                   pha
0027E3r 2  88                   dey
0027E4r 2  10 FA                bpl     @savep
0027E6r 2                       ; Evaluate argument -> FAC.
0027E6r 2  20 rr rr             jsr     FrmNum
0027E9r 2  A9 29                lda     #')'
0027EBr 2  20 rr rr             jsr     SynChr
0027EEr 2                       ; Any variable reference in the argument re-pointed VARPNT (and Garbag
0027EEr 2                       ; may have eaten FNCNAM) — reload both before storing the argument.
0027EEr 2  20 rr rr             jsr     @reload
0027F1r 2                       ; Store FAC into param slot.
0027F1r 2  A6 3F                ldx     VARPNT
0027F3r 2  A4 40                ldy     VARPNT+1
0027F5r 2  20 rr rr             jsr     StoreFacAtYxRounded
0027F8r 2                       ; Save current TXTPTR.
0027F8r 2  A5 05                lda     TXTPTR+1
0027FAr 2  48                   pha
0027FBr 2  A5 04                lda     TXTPTR
0027FDr 2  48                   pha
0027FEr 2                       ; Switch TXTPTR to FN expression body.
0027FEr 2  A0 00                ldy     #0
002800r 2  B1 81                lda     (BAS_FNCNAM),y
002802r 2  85 04                sta     TXTPTR
002804r 2  C8                   iny
002805r 2  B1 81                lda     (BAS_FNCNAM),y
002807r 2  85 05                sta     TXTPTR+1
002809r 2                       ; Body TXTPTR is positioned at the first byte; we need it positioned
002809r 2                       ; one BEFORE so FrmNum's first ChrGet loads the first byte.  Decrement.
002809r 2  A5 04                lda     TXTPTR
00280Br 2  D0 02                bne     @noBor
00280Dr 2  C6 05                dec     TXTPTR+1
00280Fr 2               @noBor:
00280Fr 2  C6 04                dec     TXTPTR
002811r 2                       ; Evaluate the FN expression body.
002811r 2  20 rr rr             jsr     ChrGet
002814r 2  20 rr rr             jsr     FrmNum
002817r 2                       ; Restore TXTPTR.
002817r 2  68                   pla
002818r 2  85 04                sta     TXTPTR
00281Ar 2  68                   pla
00281Br 2  85 05                sta     TXTPTR+1
00281Dr 2                       ; Restore param.  VARPNT may have been clobbered; reload.
00281Dr 2  20 rr rr             jsr     @reload
002820r 2  A0 00                ldy     #0
002822r 2               @restp:
002822r 2  68                   pla
002823r 2  91 3F                sta     (VARPNT),y
002825r 2  C8                   iny
002826r 2  C0 05                cpy     #5
002828r 2  D0 F8                bne     @restp
00282Ar 2  60                   rts
00282Br 2               @undef:
00282Br 2  A2 03                ldx     #ERR_UNDEFSTMT
00282Dr 2  4C rr rr             jmp     BasErrorVec
002830r 2               ; Re-seed FNCNAM from BAS_FNPTR and VARPNT from the FN slot's param pointer.
002830r 2               ; Preserves FAC (touches A and Y only).
002830r 2               @reload:
002830r 2  AD 73 03             lda     BAS_FNPTR
002833r 2  85 81                sta     BAS_FNCNAM
002835r 2  AD 74 03             lda     BAS_FNPTR+1
002838r 2  85 82                sta     BAS_FNCNAM+1
00283Ar 2  A0 02                ldy     #2
00283Cr 2  B1 81                lda     (BAS_FNCNAM),y
00283Er 2  85 3F                sta     VARPNT
002840r 2  C8                   iny
002841r 2  B1 81                lda     (BAS_FNCNAM),y
002843r 2  85 40                sta     VARPNT+1
002845r 2  60                   rts
002846r 2               
002846r 2               ; ---------------------------------------------------------------------------
002846r 2               ; BasCmdDim -- DIM statement.  Dimension one or more arrays.
002846r 2               ;   On entry ChrGet has advanced past the DIM token, so A = first char of the
002846r 2               ;   first variable name.  For each name we call PtrGet2 with the from-DIM flag
002846r 2               ;   ($40) set in X; the '(' branch runs Array -> MakeNewArray, which allocates
002846r 2               ;   the array using the subscripts as sizes (0..N) and returns without looking
002846r 2               ;   up an element (DIMFLG nonzero).  Names are separated by commas.
002846r 2               ; ---------------------------------------------------------------------------
002846r 2               BasCmdDim:
002846r 2  A2 40                ldx     #$40                    ; from-DIM flag (bit 6)
002848r 2  20 rr rr             jsr     PtrGet2                 ; A = name char; create/dimension array
00284Br 2  20 rr rr             jsr     ChrGot
00284Er 2  C9 2C                cmp     #','
002850r 2  D0 05                bne     @done
002852r 2  20 rr rr             jsr     ChrGet                  ; consume comma, advance to next name
002855r 2  80 EF                bra     BasCmdDim
002857r 2               @done:
002857r 2  60                   rts
002858r 2               
002858r 2               ; ===========================================================================
002858r 2               ;   H A R D W A R E - E X T E N S I O N   S T A T E M E N T S
002858r 2               ; ===========================================================================
002858r 2               
002858r 2               ; --- Helpers --------------------------------------------------------------
002858r 2               
002858r 2               ; Raise ?NO DEVICE error.
002858r 2               NoDevErr:
002858r 2  A2 0F                ldx     #ERR_NODEV
00285Ar 2  4C rr rr             jmp     BasErrorVec
00285Dr 2               
00285Dr 2               ; Require A bits in HW_PRESENT (else ?NO DEVICE).
00285Dr 2               ;   Input : A = mask
00285Dr 2               ;   Output: A preserved on success
00285Dr 2               ReqHw:
00285Dr 2  2D 0D 03             and     HW_PRESENT
002860r 2  F0 F6                beq     NoDevErr
002862r 2  60                   rts
002863r 2               
002863r 2               ; Evaluate expression -> A in 0..255.
002863r 2               ;   On entry: ChrGot positioned at first byte of expression.
002863r 2               ;   On exit : A = byte, ChrGot returns char following expression.
002863r 2               EvalU8:
002863r 2  20 rr rr             jsr     GetByt                  ; X = byte, jmp ChrGot
002866r 2  8A                   txa
002867r 2  60                   rts
002868r 2               
002868r 2               ; Evaluate expression as 16-bit signed -> FAC+3 (hi), FAC+4 (lo).
002868r 2               EvalU16:
002868r 2  20 rr rr             jsr     FrmNum
00286Br 2  20 rr rr             jsr     AyInt
00286Er 2  4C rr rr             jmp     ChrGot
002871r 2               
002871r 2               ; Evaluate expression as 16-bit unsigned address (0..65535)
002871r 2               ;   -> FAC+3 (hi), FAC+4 (lo).  Used by SYS, POKE, PEEK, WAIT so the full
002871r 2               ;   6502 address space is reachable with positive decimal literals.
002871r 2               ;   Truncates fractional part.  Negative or >= 65536 raises ?ILLEGAL QUANTITY.
002871r 2               EvalAddrU16:
002871r 2  20 rr rr             jsr     FrmNum
002874r 2  20 rr rr             jsr     FacToU16
002877r 2  4C rr rr             jmp     ChrGot
00287Ar 2               
00287Ar 2               ; FacToU16 -- Convert FAC (must be 0..65535) to FAC+3 (hi), FAC+4 (lo).
00287Ar 2               ;   Negative or >= 65536 raises ?ILLEGAL QUANTITY.  Truncates fractional part.
00287Ar 2               FacToU16:
00287Ar 2  24 13                bit     FACSIGN
00287Cr 2  30 34                bmi     @illqty
00287Er 2  A5 0E                lda     FAC                     ; exponent byte (0 = value is zero)
002880r 2  F0 2B                beq     @zero
002882r 2  C9 91                cmp     #$91                    ; exp >= $91 means value >= 65536
002884r 2  B0 2C                bcs     @illqty
002886r 2                       ; Reconstruct top 16 bits of mantissa (with hidden 1 bit).
002886r 2  48                   pha                             ; save exponent byte
002887r 2  A5 0F                lda     FAC+1
002889r 2  09 80                ora     #$80                    ; restore hidden bit
00288Br 2  85 3B                sta     BAS_TMP1+1              ; hi
00288Dr 2  A5 10                lda     FAC+2
00288Fr 2  85 3A                sta     BAS_TMP1                ; lo
002891r 2                       ; Shift count = $90 - exp_byte (0..15).
002891r 2  68                   pla
002892r 2  38                   sec
002893r 2  E9 90                sbc     #$90
002895r 2  49 FF                eor     #$FF
002897r 2  18                   clc
002898r 2  69 01                adc     #1                      ; A = $90 - exp
00289Ar 2  F0 08                beq     @store                  ; zero shifts: already aligned
00289Cr 2  AA                   tax
00289Dr 2               @shloop:
00289Dr 2  46 3B                lsr     BAS_TMP1+1
00289Fr 2  66 3A                ror     BAS_TMP1
0028A1r 2  CA                   dex
0028A2r 2  D0 F9                bne     @shloop
0028A4r 2               @store:
0028A4r 2  A5 3B                lda     BAS_TMP1+1
0028A6r 2  85 11                sta     FAC+3
0028A8r 2  A5 3A                lda     BAS_TMP1
0028AAr 2  85 12                sta     FAC+4
0028ACr 2  60                   rts
0028ADr 2               @zero:
0028ADr 2  64 11                stz     FAC+3
0028AFr 2  64 12                stz     FAC+4
0028B1r 2  60                   rts
0028B2r 2               @illqty:
0028B2r 2  4C rr rr             jmp     IqErr
0028B5r 2               
0028B5r 2               ; Evaluate string expression -> copy up to 12 chars to BAS_FNAME,
0028B5r 2               ; null-terminate, set STR_PTR := BAS_FNAME, free temp string.
0028B5r 2               ; 12 = full 8.3 form ("NAME.EXT" = 8 name + '.' + 3 ext).
0028B5r 2               EvalString:
0028B5r 2  20 rr rr             jsr     FrmEvl
0028B8r 2  20 rr rr             jsr     ChkStr
0028BBr 2  A5 0F                lda     FAC+1
0028BDr 2  85 20                sta     INDEX
0028BFr 2  A5 10                lda     FAC+2
0028C1r 2  85 21                sta     INDEX+1
0028C3r 2  A0 00                ldy     #0
0028C5r 2  A6 0E                ldx     FAC                     ; length
0028C7r 2               @cpy:
0028C7r 2  C0 0C                cpy     #12
0028C9r 2  F0 0D                beq     @done
0028CBr 2  E0 00                cpx     #0
0028CDr 2  F0 09                beq     @done
0028CFr 2  B1 20                lda     (INDEX),y
0028D1r 2  99 81 03             sta     BAS_FNAME,y
0028D4r 2  C8                   iny
0028D5r 2  CA                   dex
0028D6r 2  80 EF                bra     @cpy
0028D8r 2               @done:
0028D8r 2  A9 00                lda     #0
0028DAr 2  99 81 03             sta     BAS_FNAME,y
0028DDr 2  A9 81                lda     #<BAS_FNAME
0028DFr 2  85 02                sta     STR_PTR
0028E1r 2  A9 03                lda     #>BAS_FNAME
0028E3r 2  85 03                sta     STR_PTR+1
0028E5r 2  4C rr rr             jmp     FreFac
0028E8r 2               
0028E8r 2               ; Print A as 2-digit decimal with leading zero (used by TIME/DATE).
0028E8r 2               BasPr2D:
0028E8r 2  A2 00                ldx     #0
0028EAr 2               @loop:
0028EAr 2  C9 0A                cmp     #10
0028ECr 2  90 05                bcc     @done
0028EEr 2  E9 0A                sbc     #10
0028F0r 2  E8                   inx
0028F1r 2  80 F7                bra     @loop
0028F3r 2               @done:
0028F3r 2  48                   pha
0028F4r 2  8A                   txa
0028F5r 2  09 30                ora     #'0'
0028F7r 2  20 rr rr             jsr     Chrout
0028FAr 2  68                   pla
0028FBr 2  09 30                ora     #'0'
0028FDr 2  4C rr rr             jmp     Chrout
002900r 2               
002900r 2               ; BasFixChain -- recompute end-of-program pointers after a program image load.
002900r 2               ; A program image is the raw bytes belonging at $0800 up: a tokenized line chain
002900r 2               ; and, for a .prg, machine code sitting past the chain's $0000 terminator.  A
002900r 2               ; chain walk alone only ever finds the end of the BASIC part, so the loader's
002900r 2               ; byte count has to be taken into account too.
002900r 2               ;   Input:  A = loaded image size lo, Y = size hi (0 = size unknown; chain only)
002900r 2               ;   Output: BAS_VARTAB = BAS_ARYTAB = BAS_STREND
002900r 2               ;             = max(chain-end + 2, PROGRAM_START + size)
002900r 2               ;   Note:   a size that would push the result past BAS_MEMSIZ is rejected and the
002900r 2               ;           chain-end candidate is used instead.
002900r 2               ; Mirroring VARTAB into ARYTAB/STREND matters on its own: Makenewvariable places
002900r 2               ; a new scalar at ARYTAB, so leaving it at its post-NEW $0802 makes the first
002900r 2               ; direct-mode assignment after a LOAD overwrite the program's first line.
002900r 2                       .assert (PROGRAM_START & $FF) = 0, error, "PROGRAM_START must be page-aligned"
002900r 2               BasFixChain:
002900r 2  85 3C                sta     BAS_TMP2                ; BAS_TMP2 = PROGRAM_START + size; the
002902r 2  98                   tya                             ; low byte passes through untouched
002903r 2  18                   clc                             ; because PROGRAM_START is page-aligned
002904r 2  69 08                adc     #>PROGRAM_START
002906r 2  85 3D                sta     BAS_TMP2+1
002908r 2  64 20                stz     INDEX
00290Ar 2  A9 08                lda     #>PROGRAM_START
00290Cr 2  85 21                sta     INDEX+1
00290Er 2               @walk:
00290Er 2  A0 01                ldy     #1
002910r 2  B1 20                lda     (INDEX),y               ; next-ptr hi
002912r 2  85 3A                sta     BAS_TMP1
002914r 2  88                   dey
002915r 2  11 20                ora     (INDEX),y               ; both bytes zero -> terminator
002917r 2  F0 15                beq     @end
002919r 2                       ; Lines ascend in memory.  LOAD accepts any file, so a corrupt or
002919r 2                       ; cyclic chain is reachable here — stop at the last good line rather
002919r 2                       ; than loop forever.
002919r 2  38                   sec
00291Ar 2  A5 20                lda     INDEX
00291Cr 2  F1 20                sbc     (INDEX),y
00291Er 2  A5 21                lda     INDEX+1
002920r 2  E5 3A                sbc     BAS_TMP1
002922r 2  B0 0A                bcs     @end                    ; current >= next -> not a real chain
002924r 2  B1 20                lda     (INDEX),y               ; next-ptr lo
002926r 2  85 20                sta     INDEX
002928r 2  A5 3A                lda     BAS_TMP1
00292Ar 2  85 21                sta     INDEX+1
00292Cr 2  80 E0                bra     @walk
00292Er 2               @end:
00292Er 2                       ; INDEX points at terminator ($00 $00).  Candidate A = INDEX + 2.
00292Er 2  18                   clc
00292Fr 2  A5 20                lda     INDEX
002931r 2  69 02                adc     #2
002933r 2  8D 5F 03             sta     BAS_VARTAB
002936r 2  A5 21                lda     INDEX+1
002938r 2  69 00                adc     #0
00293Ar 2  8D 60 03             sta     BAS_VARTAB+1
00293Dr 2                       ; Candidate B = BAS_TMP2.  Keep it only when A <= B <= MEMSIZ, so a
00293Dr 2                       ; short or absent size loses the max and a bogus one cannot push
00293Dr 2                       ; VARTAB out of memory.
00293Dr 2  38                   sec
00293Er 2  A5 3C                lda     BAS_TMP2
002940r 2  ED 5F 03             sbc     BAS_VARTAB
002943r 2  A5 3D                lda     BAS_TMP2+1
002945r 2  ED 60 03             sbc     BAS_VARTAB+1
002948r 2  90 17                bcc     @mirror                 ; B < A -> keep A
00294Ar 2  38                   sec
00294Br 2  AD 67 03             lda     BAS_MEMSIZ
00294Er 2  E5 3C                sbc     BAS_TMP2
002950r 2  AD 68 03             lda     BAS_MEMSIZ+1
002953r 2  E5 3D                sbc     BAS_TMP2+1
002955r 2  90 0A                bcc     @mirror                 ; B > MEMSIZ -> reject, keep A
002957r 2  A5 3C                lda     BAS_TMP2
002959r 2  8D 5F 03             sta     BAS_VARTAB
00295Cr 2  A5 3D                lda     BAS_TMP2+1
00295Er 2  8D 60 03             sta     BAS_VARTAB+1
002961r 2               @mirror:
002961r 2                       ; ARYTAB / STREND follow VARTAB on a fresh load: no variables yet.
002961r 2  A2 01                ldx     #1
002963r 2               @copy:
002963r 2  BD 5F 03             lda     BAS_VARTAB,x
002966r 2  9D 61 03             sta     BAS_ARYTAB,x
002969r 2  9D 63 03             sta     BAS_STREND,x
00296Cr 2  CA                   dex
00296Dr 2  10 F4                bpl     @copy
00296Fr 2  60                   rts
002970r 2               
002970r 2               ; --- Statements -----------------------------------------------------------
002970r 2               
002970r 2               ; SYS addr[,a[,x[,y]]] -- call a machine-code routine; RTS comes back here.
002970r 2               ; A, X and Y are loaded from the optional arguments (0 when omitted) and the
002970r 2               ; routine is entered with decimal mode and the interrupt mask clear.  What it
002970r 2               ; returns in A, X, Y and P is left in BRK_A/X/Y/P (PEEK 787/788/789/784), the
002970r 2               ; bytes a BRK report reads from.  The arguments wait there too: FrmEvl owns
002970r 2               ; every zero-page scratch byte, and nothing else runs between the last
002970r 2               ; argument and the call.
002970r 2               BasCmdSys:
002970r 2  20 rr rr             jsr     EvalAddrU16
002973r 2  A5 12                lda     FAC+4                   ; lo, and hi, across the evaluations
002975r 2  48                   pha
002976r 2  A5 11                lda     FAC+3
002978r 2  48                   pha
002979r 2  9C 13 03             stz     BRK_A
00297Cr 2  9C 14 03             stz     BRK_X
00297Fr 2  9C 15 03             stz     BRK_Y
002982r 2  A2 00                ldx     #0
002984r 2               @arg:
002984r 2  20 rr rr             jsr     ChrGot
002987r 2  C9 2C                cmp     #','
002989r 2  D0 0E                bne     @call
00298Br 2  DA                   phx
00298Cr 2  20 rr rr             jsr     GetComByt               ; X = value
00298Fr 2  8A                   txa
002990r 2  FA                   plx
002991r 2  9D 13 03             sta     BRK_A,x
002994r 2  E8                   inx
002995r 2  E0 03                cpx     #3
002997r 2  D0 EB                bne     @arg
002999r 2               @call:
002999r 2  68                   pla
00299Ar 2  85 21                sta     INDEX+1
00299Cr 2  68                   pla
00299Dr 2  85 20                sta     INDEX
00299Fr 2  20 rr rr             jsr     @go
0029A2r 2  08                   php
0029A3r 2  8D 13 03             sta     BRK_A
0029A6r 2  8E 14 03             stx     BRK_X
0029A9r 2  8C 15 03             sty     BRK_Y
0029ACr 2  68                   pla
0029ADr 2  8D 10 03             sta     BRK_P
0029B0r 2  D8                   cld
0029B1r 2  60                   rts
0029B2r 2               @go:
0029B2r 2  AD 13 03             lda     BRK_A
0029B5r 2  AE 14 03             ldx     BRK_X
0029B8r 2  AC 15 03             ldy     BRK_Y
0029BBr 2  D8                   cld
0029BCr 2  58                   cli
0029BDr 2  6C 20 00             jmp     (INDEX)
0029C0r 2               
0029C0r 2               ; ---------------------------------------------------------------------------
0029C0r 2               ; Byte arguments, with the ranges the README documents.
0029C0r 2               ;
0029C0r 2               ; GetByt itself only rejects a value that will not fit in a byte.  Every
0029C0r 2               ; statement below has a narrower range than that -- a volume of 0-15, a screen
0029C0r 2               ; row of 0-23, an hour of 0-23 -- and each of them used to take whatever byte
0029C0r 2               ; it was handed and fold it into something legal.  VOL 16 masked to 4 bits and
0029C0r 2               ; set the volume to *zero*; LOCATE 24,0 pointed the cursor past the end of the
0029C0r 2               ; name table; SETTIME 24,61,61 wrote BCD the DS1511Y has no values for.  None
0029C0r 2               ; of them said anything.
0029C0r 2               ;
0029C0r 2               ; So the range travels with the fetch.  A = one past the highest legal value;
0029C0r 2               ; anything from there up raises ILLEGAL QUANTITY, as NVRAM's address already
0029C0r 2               ; did.  GetComByteLim is the same thing preceded by the comma between two
0029C0r 2               ; arguments, and it costs a byte *less* per site than the `jsr ChkCom /
0029C0r 2               ; jsr GetByt` pair it replaces -- which is how thirteen range checks fit into
0029C0r 2               ; a segment that had one byte spare.
0029C0r 2               ;
0029C0r 2               ; The limit is parked on the stack across the fetch rather than in scratch:
0029C0r 2               ; GetByt runs the whole expression evaluator, which reaches BAS_TMP3 itself.
0029C0r 2               ; Between the `pla` and the `cpx` nothing runs at all, so the byte is safe
0029C0r 2               ; there and nowhere earlier.
0029C0r 2               ; ---------------------------------------------------------------------------
0029C0r 2               
0029C0r 2               ; GetComByt - a comma, then an unchecked byte argument.
0029C0r 2               GetComByt:
0029C0r 2  20 rr rr             jsr     ChkCom
0029C3r 2  4C rr rr             jmp     GetByt
0029C6r 2               
0029C6r 2               ; GetComByteLim / GetByteLim - the same, with a range.  X = value.
0029C6r 2               GetComByteLim:
0029C6r 2  48                   pha                             ; the limit, across the comma
0029C7r 2  20 rr rr             jsr     ChkCom
0029CAr 2  68                   pla
0029CBr 2               GetByteLim:
0029CBr 2  48                   pha                             ; and across the evaluator
0029CCr 2  20 rr rr             jsr     GetByt                  ; X = value
0029CFr 2  68                   pla
0029D0r 2  85 3E                sta     BAS_TMP3
0029D2r 2  E4 3E                cpx     BAS_TMP3
0029D4r 2  B0 01                bcs     BasRangeErr             ; value >= limit
0029D6r 2  60                   rts
0029D7r 2               BasRangeErr:
0029D7r 2  4C rr rr             jmp     IqErr
0029DAr 2               
0029DAr 2               ; The five statements below reach hardware that a machine may not have fitted,
0029DAr 2               ; and none of them raises ?NO DEVICE for it: a screen or a speaker has no answer
0029DAr 2               ; to return, so there is nothing an error could tell the program that silence
0029DAr 2               ; does not.  A game that beeps on a hit keeps playing on a machine with no sound
0029DAr 2               ; card.  The skip lives in the Kernal routine each one ends in, which is what
0029DAr 2               ; makes the same promise to a cartridge calling the slot directly; the arguments
0029DAr 2               ; are parsed and range-checked here either way, so a program is wrong or right
0029DAr 2               ; on every machine rather than on the one it was written on.
0029DAr 2               ;
0029DAr 2               ; The statements that read or write *data* — the CF and RTC ones below — do
0029DAr 2               ; raise ?NO DEVICE, and for the same reason: they have an answer to return and
0029DAr 2               ; cannot.
0029DAr 2               
0029DAr 2               ; CLS
0029DAr 2               BasCmdCls:
0029DAr 2  4C rr rr             jmp     VideoClear
0029DDr 2               
0029DDr 2               ; LOCATE row, col
0029DDr 2               BasCmdLocate:
0029DDr 2  A9 18                lda     #24                     ; rows 0-23
0029DFr 2  20 rr rr             jsr     GetByteLim              ; X = row
0029E2r 2  DA                   phx
0029E3r 2  A9 28                lda     #40                     ; columns 0-39
0029E5r 2  20 rr rr             jsr     GetComByteLim           ; X = col
0029E8r 2  7A                   ply                             ; Y = row
0029E9r 2  4C rr rr             jmp     VideoSetCursor
0029ECr 2               
0029ECr 2               ; COLOR fg[, bg[, border]]
0029ECr 2               ;   The pen for later output.  bg defaults to the current pen's.  Every argument
0029ECr 2               ;   is read before anything is set, so an error leaves pen and border alone.
0029ECr 2               ;   Without a border, VideoSetColor: the border follows bg.  With one, the pen
0029ECr 2               ;   through VideoSetPen and register 7 = fg<<4 | border in one write — setting
0029ECr 2               ;   bg there first would show it for part of every frame the loop runs in.
0029ECr 2               BasCmdColor:
0029ECr 2  A9 10                lda     #16                     ; colours 0-15
0029EEr 2  20 rr rr             jsr     GetByteLim              ; X = fg
0029F1r 2  8A                   txa
0029F2r 2  0A                   asl     a
0029F3r 2  0A                   asl     a
0029F4r 2  0A                   asl     a
0029F5r 2  0A                   asl     a
0029F6r 2  48                   pha                             ; fg must survive FrmEvl -> stack, not ZP
0029F7r 2  AD 91 03             lda     VID_PEN
0029FAr 2  29 0F                and     #$0F
0029FCr 2  AA                   tax                             ; X = bg if none is given
0029FDr 2  20 rr rr             jsr     ChrGot
002A00r 2  C9 2C                cmp     #','
002A02r 2  D0 05                bne     @bg
002A04r 2  A9 10                lda     #16
002A06r 2  20 rr rr             jsr     GetComByteLim           ; X = bg, already known to fit a nibble
002A09r 2               @bg:
002A09r 2  86 3A                stx     BAS_TMP1
002A0Br 2  68                   pla
002A0Cr 2  05 3A                ora     BAS_TMP1
002A0Er 2  48                   pha                             ; the pen, across the border's FrmEvl
002A0Fr 2  20 rr rr             jsr     ChrGot
002A12r 2  C9 2C                cmp     #','
002A14r 2  D0 14                bne     @pen
002A16r 2  A9 10                lda     #16
002A18r 2  20 rr rr             jsr     GetComByteLim           ; X = border
002A1Br 2  68                   pla
002A1Cr 2  20 rr rr             jsr     VideoSetPen             ; keeps A, X and Y
002A1Fr 2  86 3A                stx     BAS_TMP1
002A21r 2  29 F0                and     #$F0
002A23r 2  05 3A                ora     BAS_TMP1
002A25r 2  A2 07                ldx     #VDP_COLOR
002A27r 2  4C rr rr             jmp     VdpWriteRegImpl         ; Skips without a card
002A2Ar 2               @pen:
002A2Ar 2  68                   pla
002A2Br 2  4C rr rr             jmp     VideoSetColor
002A2Er 2               
002A2Er 2               ; VOL n
002A2Er 2               BasCmdVol:
002A2Er 2  A9 10                lda     #16                     ; volume 0-15
002A30r 2  20 rr rr             jsr     GetByteLim              ; X = vol
002A33r 2  8A                   txa
002A34r 2  4C rr rr             jmp     SidSetVolume
002A37r 2               
002A37r 2               ; SOUND voice, freq, dur (freq=Hz, dur=centisec)
002A37r 2               ;   Hz -> SID register: reg = Hz * 16.75 ≈ Hz<<4 + Hz - Hz/4
002A37r 2               BasCmdSound:
002A37r 2  A9 04                lda     #4                      ; voices 1-3, after Commodore BASIC V3.5
002A39r 2  20 rr rr             jsr     GetByteLim              ; X = voice
002A3Cr 2  CA                   dex                             ; 0-indexed for SidPlayNote
002A3Dr 2  30 98                bmi     BasRangeErr             ; voice 0 underflowed to $FF
002A3Fr 2  DA                   phx                             ; voice (0-indexed) on stack
002A40r 2  20 rr rr             jsr     ChkCom
002A43r 2  20 rr rr             jsr     EvalU16                 ; freq Hz: hi=FAC+3, lo=FAC+4
002A46r 2                       ; Compute reg = Hz<<4 + Hz - Hz/4
002A46r 2  A5 12                lda     FAC+4
002A48r 2  85 3A                sta     BAS_TMP1
002A4Ar 2  A5 11                lda     FAC+3
002A4Cr 2  85 3B                sta     BAS_TMP1+1
002A4Er 2  A5 3A                lda     BAS_TMP1
002A50r 2  85 3C                sta     BAS_TMP2
002A52r 2  A5 3B                lda     BAS_TMP1+1
002A54r 2  85 3D                sta     BAS_TMP2+1
002A56r 2  A2 04                ldx     #4
002A58r 2               @shl:
002A58r 2  06 3A                asl     BAS_TMP1
002A5Ar 2  26 3B                rol     BAS_TMP1+1
002A5Cr 2  CA                   dex
002A5Dr 2  D0 F9                bne     @shl
002A5Fr 2  18                   clc
002A60r 2  A5 3A                lda     BAS_TMP1
002A62r 2  65 3C                adc     BAS_TMP2
002A64r 2  85 3A                sta     BAS_TMP1
002A66r 2  A5 3B                lda     BAS_TMP1+1
002A68r 2  65 3D                adc     BAS_TMP2+1
002A6Ar 2  85 3B                sta     BAS_TMP1+1
002A6Cr 2  46 3D                lsr     BAS_TMP2+1
002A6Er 2  66 3C                ror     BAS_TMP2
002A70r 2  46 3D                lsr     BAS_TMP2+1
002A72r 2  66 3C                ror     BAS_TMP2
002A74r 2  38                   sec
002A75r 2  A5 3A                lda     BAS_TMP1
002A77r 2  E5 3C                sbc     BAS_TMP2
002A79r 2  48                   pha                             ; freqLo
002A7Ar 2  A5 3B                lda     BAS_TMP1+1
002A7Cr 2  E5 3D                sbc     BAS_TMP2+1
002A7Er 2  48                   pha                             ; freqHi
002A7Fr 2  20 rr rr             jsr     ChkCom
002A82r 2  20 rr rr             jsr     EvalU16                 ; dur in FAC+3/+4
002A85r 2                       ; Stack (top-down): freqHi, freqLo, voice
002A85r 2  7A                   ply                             ; Y = freqHi
002A86r 2  FA                   plx                             ; X = freqLo
002A87r 2  68                   pla                             ; A = voice
002A88r 2  20 rr rr             jsr     SidPlayNote
002A8Br 2  A5 12                lda     FAC+4
002A8Dr 2  A6 11                ldx     FAC+3
002A8Fr 2  20 rr rr             jsr     SysDelay
002A92r 2  4C rr rr             jmp     SidSilence
002A95r 2               
002A95r 2               ; TIME
002A95r 2               BasCmdTime:
002A95r 2  A9 04                lda     #HW_RTC
002A97r 2  20 rr rr             jsr     ReqHw
002A9Ar 2  20 rr rr             jsr     RtcReadTime             ; A=hours, X=min, Y=sec
002A9Dr 2  5A                   phy
002A9Er 2  DA                   phx
002A9Fr 2  20 rr rr             jsr     BasPr2D                 ; print hours
002AA2r 2  A9 3A                lda     #':'
002AA4r 2  20 rr rr             jsr     Chrout
002AA7r 2  68                   pla
002AA8r 2  20 rr rr             jsr     BasPr2D
002AABr 2  A9 3A                lda     #':'
002AADr 2  20 rr rr             jsr     Chrout
002AB0r 2  68                   pla
002AB1r 2  20 rr rr             jsr     BasPr2D
002AB4r 2  4C rr rr             jmp     BasPrintCRLF
002AB7r 2               
002AB7r 2               ; DATE
002AB7r 2               BasCmdDate:
002AB7r 2  A9 04                lda     #HW_RTC
002AB9r 2  20 rr rr             jsr     ReqHw
002ABCr 2  20 rr rr             jsr     RtcReadDate             ; A=day, X=month, Y=year
002ABFr 2  48                   pha
002AC0r 2  DA                   phx
002AC1r 2  5A                   phy
002AC2r 2  AD 0B 03             lda     RTC_BUF_CENT
002AC5r 2  20 rr rr             jsr     BasPr2D
002AC8r 2  68                   pla
002AC9r 2  20 rr rr             jsr     BasPr2D
002ACCr 2  A9 2D                lda     #'-'
002ACEr 2  20 rr rr             jsr     Chrout
002AD1r 2  68                   pla
002AD2r 2  20 rr rr             jsr     BasPr2D
002AD5r 2  A9 2D                lda     #'-'
002AD7r 2  20 rr rr             jsr     Chrout
002ADAr 2  68                   pla
002ADBr 2  20 rr rr             jsr     BasPr2D
002ADEr 2  4C rr rr             jmp     BasPrintCRLF
002AE1r 2               
002AE1r 2               ; SETTIME h, m, s
002AE1r 2               BasCmdSettime:
002AE1r 2  A9 04                lda     #HW_RTC
002AE3r 2  20 rr rr             jsr     ReqHw
002AE6r 2  A9 18                lda     #24                     ; hours 0-23
002AE8r 2  20 rr rr             jsr     GetByteLim              ; X = h
002AEBr 2  DA                   phx
002AECr 2  A9 3C                lda     #60                     ; minutes 0-59
002AEEr 2  20 rr rr             jsr     GetComByteLim           ; X = m
002AF1r 2  DA                   phx
002AF2r 2  A9 3C                lda     #60                     ; seconds 0-59
002AF4r 2  20 rr rr             jsr     GetComByteLim           ; X = s
002AF7r 2  8A                   txa
002AF8r 2  A8                   tay                             ; Y = s
002AF9r 2  FA                   plx                             ; X = m
002AFAr 2  68                   pla                             ; A = h
002AFBr 2  4C rr rr             jmp     RtcWriteTime
002AFEr 2               
002AFEr 2               ; SETDATE c, y, m, d
002AFEr 2               BasCmdSetdate:
002AFEr 2  A9 04                lda     #HW_RTC
002B00r 2  20 rr rr             jsr     ReqHw
002B03r 2  A9 64                lda     #100                    ; century 0-99, as two BCD digits
002B05r 2  20 rr rr             jsr     GetByteLim
002B08r 2  8E 0B 03             stx     RTC_BUF_CENT
002B0Br 2  A9 64                lda     #100                    ; year 0-99
002B0Dr 2  20 rr rr             jsr     GetComByteLim
002B10r 2  DA                   phx                             ; year
002B11r 2  A9 0D                lda     #13                     ; months 1-12, so reject 0 as well
002B13r 2  20 rr rr             jsr     GetComByteLim
002B16r 2  E0 01                cpx     #1
002B18r 2  90 10                bcc     @bad
002B1Ar 2  DA                   phx                             ; month
002B1Br 2  A9 20                lda     #32                     ; days 1-31.  Which months are short is
002B1Dr 2  20 rr rr             jsr     GetComByteLim           ;   left alone: it needs a table and a
002B20r 2  E0 01                cpx     #1                      ;   leap rule for one wrong day a year,
002B22r 2  90 06                bcc     @bad                    ;   and the DS1511Y does not check it
002B24r 2                                                       ;   either
002B24r 2  8A                   txa
002B25r 2  FA                   plx                             ; X=month
002B26r 2  7A                   ply                             ; Y=year
002B27r 2  4C rr rr             jmp     RtcWriteDate
002B2Ar 2               @bad:                                   ; BasRangeErr is out of branch reach
002B2Ar 2  4C rr rr             jmp     IqErr
002B2Dr 2               
002B2Dr 2               ; NVRAM addr, val
002B2Dr 2               BasCmdNvram:
002B2Dr 2  A9 04                lda     #HW_RTC
002B2Fr 2  20 rr rr             jsr     ReqHw
002B32r 2  20 rr rr             jsr     GetByt                  ; addr; GetByt's own 0-255 is the range
002B35r 2  DA                   phx
002B36r 2  20 rr rr             jsr     GetComByt               ; X=val
002B39r 2  8A                   txa                             ; A=val
002B3Ar 2  FA                   plx                             ; X=addr
002B3Br 2  4C rr rr             jmp     RtcWriteNVRAM
002B3Er 2               
002B3Er 2               ; WAIT addr, mask
002B3Er 2               ; As with POKE, the address must survive evaluation of the second argument,
002B3Er 2               ; which is free to trample BAS_TMP1 (FacToU16, MID$/LEFT$/RIGHT$, ...).
002B3Er 2               BasCmdWait:
002B3Er 2  20 rr rr             jsr     EvalAddrU16
002B41r 2  A5 11                lda     FAC+3                   ; hi
002B43r 2  48                   pha
002B44r 2  A5 12                lda     FAC+4                   ; lo
002B46r 2  48                   pha
002B47r 2  20 rr rr             jsr     GetComByt               ; X = mask
002B4Ar 2  86 3C                stx     BAS_TMP2
002B4Cr 2  68                   pla
002B4Dr 2  85 3A                sta     BAS_TMP1
002B4Fr 2  68                   pla
002B50r 2  85 3B                sta     BAS_TMP1+1
002B52r 2               @poll:
002B52r 2  20 rr rr             jsr     BasCheckBreak
002B55r 2  A0 00                ldy     #0
002B57r 2  B1 3A                lda     (BAS_TMP1),y
002B59r 2  25 3C                and     BAS_TMP2
002B5Br 2  F0 F5                beq     @poll
002B5Dr 2  60                   rts
002B5Er 2               
002B5Er 2               ; PAUSE n (centiseconds)
002B5Er 2               BasCmdPause:
002B5Er 2  20 rr rr             jsr     EvalU16
002B61r 2  A5 12                lda     FAC+4
002B63r 2  A6 11                ldx     FAC+3
002B65r 2  4C rr rr             jmp     SysDelay
002B68r 2               
002B68r 2               ; BANK n
002B68r 2               BasCmdBank:
002B68r 2  A9 01                lda     #HW_RAM_L
002B6Ar 2  20 rr rr             jsr     ReqHw
002B6Dr 2  20 rr rr             jsr     GetByt                  ; X = bank
002B70r 2  8E FF 83             stx     RAM_BANK_L
002B73r 2  60                   rts
002B74r 2               
002B74r 2               ; POKE addr, val
002B74r 2               ; The value expression is evaluated BEFORE the address is parked in INDEX:
002B74r 2               ; FrmEvl clobbers every zero-page scratch pair (INDEX via LoadFacFromYa,
002B74r 2               ; BAS_TMP1 via FacToU16 / the string functions), so the address has to ride
002B74r 2               ; the hardware stack across the evaluation.
002B74r 2               BasCmdPoke:
002B74r 2  20 rr rr             jsr     EvalAddrU16
002B77r 2  A5 11                lda     FAC+3                   ; hi
002B79r 2  48                   pha
002B7Ar 2  A5 12                lda     FAC+4                   ; lo
002B7Cr 2  48                   pha
002B7Dr 2  20 rr rr             jsr     ChkCom
002B80r 2  20 rr rr             jsr     GetByt                  ; X = val
002B83r 2  68                   pla
002B84r 2  85 20                sta     INDEX
002B86r 2  68                   pla
002B87r 2  85 21                sta     INDEX+1
002B89r 2  8A                   txa
002B8Ar 2  A0 00                ldy     #0
002B8Cr 2  91 20                sta     (INDEX),y
002B8Er 2  60                   rts
002B8Fr 2               
002B8Fr 2               ; LOAD ["name"] / LOAD (bare) / LOAD "name"
002B8Fr 2               BasCmdLoad:
002B8Fr 2  20 rr rr             jsr     ChrGot
002B92r 2  F0 02                beq     @bare
002B94r 2  80 19                bra     @cf                     ; any argument is a filename expression
002B96r 2               @bare:
002B96r 2  A9 10                lda     #HW_SC
002B98r 2  20 rr rr             jsr     ReqHw
002B9Br 2  A9 00                lda     #<PROGRAM_START
002B9Dr 2  85 2A                sta     XFER_PTR
002B9Fr 2  A9 08                lda     #>PROGRAM_START
002BA1r 2  85 2B                sta     XFER_PTR+1
002BA3r 2  20 rr rr             jsr     XModemLoad
002BA6r 2                       ; XMODEM rounds up to a 128-byte block, so this can overshoot the true
002BA6r 2                       ; end by up to 127 bytes: it wastes a little variable space, never
002BA6r 2                       ; truncates.
002BA6r 2  AD 17 03             lda     XFER_REMAIN
002BA9r 2  AC 18 03             ldy     XFER_REMAIN+1
002BACr 2  4C rr rr             jmp     BasFixChain
002BAFr 2               @cf:
002BAFr 2  A9 08                lda     #HW_CF
002BB1r 2  20 rr rr             jsr     ReqHw
002BB4r 2  20 rr rr             jsr     EvalString
002BB7r 2  20 rr rr             jsr     FsLoadFile
002BBAr 2  B0 09                bcs     @err
002BBCr 2  AD 4A 03             lda     FS_FILE_SIZE
002BBFr 2  AC 4B 03             ldy     FS_FILE_SIZE+1
002BC2r 2  4C rr rr             jmp     BasFixChain
002BC5r 2               @err:
002BC5r 2  A9 rr                lda     #<MsgLoadErr
002BC7r 2  A0 rr                ldy     #>MsgLoadErr
002BC9r 2  4C rr rr             jmp     BasPrintStr
002BCCr 2               
002BCCr 2               ; SAVE / SAVE "name"
002BCCr 2               BasCmdSave:
002BCCr 2  20 rr rr             jsr     ChrGot
002BCFr 2  F0 02                beq     @bare
002BD1r 2  80 21                bra     @cf                     ; any argument is a filename expression
002BD3r 2               @bare:
002BD3r 2  A9 10                lda     #HW_SC
002BD5r 2  20 rr rr             jsr     ReqHw
002BD8r 2  A9 00                lda     #<PROGRAM_START
002BDAr 2  85 2A                sta     XFER_PTR
002BDCr 2  A9 08                lda     #>PROGRAM_START
002BDEr 2  85 2B                sta     XFER_PTR+1
002BE0r 2  38                   sec
002BE1r 2  AD 5F 03             lda     BAS_VARTAB
002BE4r 2  E9 00                sbc     #<PROGRAM_START
002BE6r 2  8D 17 03             sta     XFER_REMAIN
002BE9r 2  AD 60 03             lda     BAS_VARTAB+1
002BECr 2  E9 08                sbc     #>PROGRAM_START
002BEEr 2  8D 18 03             sta     XFER_REMAIN+1
002BF1r 2  4C rr rr             jmp     XModemSave
002BF4r 2               @cf:
002BF4r 2  A9 08                lda     #HW_CF
002BF6r 2  20 rr rr             jsr     ReqHw
002BF9r 2  20 rr rr             jsr     EvalString
002BFCr 2  38                   sec
002BFDr 2  AD 5F 03             lda     BAS_VARTAB
002C00r 2  E9 00                sbc     #<PROGRAM_START
002C02r 2  8D 4A 03             sta     FS_FILE_SIZE
002C05r 2  AD 60 03             lda     BAS_VARTAB+1
002C08r 2  E9 08                sbc     #>PROGRAM_START
002C0Ar 2  8D 4B 03             sta     FS_FILE_SIZE+1
002C0Dr 2  20 rr rr             jsr     FsSaveFile
002C10r 2  B0 01                bcs     @err
002C12r 2  60                   rts
002C13r 2               @err:
002C13r 2  A9 rr                lda     #<MsgSaveErr
002C15r 2  A0 rr                ldy     #>MsgSaveErr
002C17r 2  4C rr rr             jmp     BasPrintStr
002C1Ar 2               
002C1Ar 2               ; DIR
002C1Ar 2               BasCmdDir:
002C1Ar 2  A9 08                lda     #HW_CF
002C1Cr 2  20 rr rr             jsr     ReqHw
002C1Fr 2  4C rr rr             jmp     FsDirectory
002C22r 2               
002C22r 2               ; DEL "name"
002C22r 2               BasCmdDel:
002C22r 2  A9 08                lda     #HW_CF
002C24r 2  20 rr rr             jsr     ReqHw
002C27r 2  20 rr rr             jsr     EvalString
002C2Ar 2  20 rr rr             jsr     FsDeleteFile
002C2Dr 2  B0 01                bcs     @err
002C2Fr 2  60                   rts
002C30r 2               @err:
002C30r 2  A9 rr                lda     #<MsgDelErr
002C32r 2  A0 rr                ldy     #>MsgDelErr
002C34r 2  4C rr rr             jmp     BasPrintStr
002C37r 2               
002C37r 2               ; MEM -- print "nnnnn BYTES FREE  HW=$xx"
002C37r 2               BasCmdMem:
002C37r 2                       ; Free bytes = MEMSIZ - VARTAB
002C37r 2  38                   sec
002C38r 2  AD 67 03             lda     BAS_MEMSIZ
002C3Br 2  ED 5F 03             sbc     BAS_VARTAB
002C3Er 2  A8                   tay
002C3Fr 2  AD 68 03             lda     BAS_MEMSIZ+1
002C42r 2  ED 60 03             sbc     BAS_VARTAB+1
002C45r 2  20 rr rr             jsr     GivAyf                  ; FAC = unsigned int from (Y,A)
002C48r 2                       ; Wait: GivAyf is signed.  For this simple display, OK if < 32768.
002C48r 2  20 rr rr             jsr     PrintNum
002C4Br 2  A9 rr                lda     #<MsgFree
002C4Dr 2  A0 rr                ldy     #>MsgFree
002C4Fr 2  20 rr rr             jsr     BasPrintStr
002C52r 2  A9 24                lda     #'$'
002C54r 2  20 rr rr             jsr     Chrout
002C57r 2  AD 0D 03             lda     HW_PRESENT
002C5Ar 2  20 rr rr             jsr     PrintHexByte
002C5Dr 2  20 rr rr             jsr     BasPrintCRLF
002C60r 2  4C rr rr             jmp     FsPrintDisk             ; print "DISK n" line
002C63r 2               
002C63r 2               ; DISK n -- select the current CF disk bank (0-255)
002C63r 2               BasCmdDisk:
002C63r 2  20 rr rr             jsr     GetByt                  ; X = value 0-255
002C66r 2  8E 0F 03             stx     CF_DISK
002C69r 2  60                   rts
002C6Ar 2               
002C6Ar 2               ; BLOAD addr[,"name"] -- load a file's raw bytes to addr, or with no name
002C6Ar 2               ; receive them over XModem.  The card each path needs is asked for once the
002C6Ar 2               ; arguments say which path it is.
002C6Ar 2               BasCmdBload:
002C6Ar 2  20 rr rr             jsr     EvalAddrU16             ; FAC+3 = hi, FAC+4 = lo
002C6Dr 2  A5 12                lda     z:FAC+4
002C6Fr 2  8D 7F 03             sta     FS_IO_ADDR
002C72r 2  85 2A                sta     XFER_PTR
002C74r 2  A5 11                lda     z:FAC+3
002C76r 2  8D 80 03             sta     FS_IO_ADDR+1
002C79r 2  85 2B                sta     XFER_PTR+1
002C7Br 2  20 rr rr             jsr     ChrGot
002C7Er 2  D0 0A                bne     @cf
002C80r 2  A9 10                lda     #HW_SC
002C82r 2  20 rr rr             jsr     ReqHw
002C85r 2  20 rr rr             jsr     XModemLoad
002C88r 2  80 0E                bra     @done
002C8Ar 2               @cf:
002C8Ar 2  A9 08                lda     #HW_CF
002C8Cr 2  20 rr rr             jsr     ReqHw
002C8Fr 2  20 rr rr             jsr     ChkCom
002C92r 2  20 rr rr             jsr     EvalString              ; filename -> BAS_FNAME, STR_PTR
002C95r 2  20 rr rr             jsr     FsLoadFileAddr
002C98r 2               @done:
002C98r 2  B0 01                bcs     BasLoadErr
002C9Ar 2  60                   rts
002C9Br 2               BasLoadErr:
002C9Br 2  A9 rr                lda     #<MsgLoadErr
002C9Dr 2  A0 rr                ldy     #>MsgLoadErr
002C9Fr 2  4C rr rr             jmp     BasPrintStr
002CA2r 2               
002CA2r 2               ; BSAVE addr, len[,"name"] -- save len bytes from addr to a file, or with no
002CA2r 2               ; name send them over XModem
002CA2r 2               BasCmdBsave:
002CA2r 2  20 rr rr             jsr     EvalAddrU16             ; addr
002CA5r 2  A5 12                lda     z:FAC+4
002CA7r 2  8D 7F 03             sta     FS_IO_ADDR
002CAAr 2  85 2A                sta     XFER_PTR
002CACr 2  A5 11                lda     z:FAC+3
002CAEr 2  8D 80 03             sta     FS_IO_ADDR+1
002CB1r 2  85 2B                sta     XFER_PTR+1
002CB3r 2  20 rr rr             jsr     ChkCom
002CB6r 2  20 rr rr             jsr     EvalAddrU16             ; length in bytes
002CB9r 2  A5 12                lda     z:FAC+4
002CBBr 2  8D 4A 03             sta     FS_FILE_SIZE
002CBEr 2  8D 17 03             sta     XFER_REMAIN
002CC1r 2  A5 11                lda     z:FAC+3
002CC3r 2  8D 4B 03             sta     FS_FILE_SIZE+1
002CC6r 2  8D 18 03             sta     XFER_REMAIN+1
002CC9r 2  20 rr rr             jsr     ChrGot
002CCCr 2  D0 0A                bne     @cf
002CCEr 2  A9 10                lda     #HW_SC
002CD0r 2  20 rr rr             jsr     ReqHw
002CD3r 2  20 rr rr             jsr     XModemSave
002CD6r 2  80 0E                bra     @done
002CD8r 2               @cf:
002CD8r 2  A9 08                lda     #HW_CF
002CDAr 2  20 rr rr             jsr     ReqHw
002CDDr 2  20 rr rr             jsr     ChkCom
002CE0r 2  20 rr rr             jsr     EvalString              ; filename
002CE3r 2  20 rr rr             jsr     FsSaveFileAddr
002CE6r 2               @done:
002CE6r 2  B0 01                bcs     @err
002CE8r 2  60                   rts
002CE9r 2               @err:
002CE9r 2  A9 rr                lda     #<MsgSaveErr
002CEBr 2  A0 rr                ldy     #>MsgSaveErr
002CEDr 2  4C rr rr             jmp     BasPrintStr
002CF0r 2               
002CF0r 2               ; FORMAT -- erase (zero) the current disk's directory, with confirmation
002CF0r 2               BasCmdFormat:
002CF0r 2  A9 08                lda     #HW_CF
002CF2r 2  20 rr rr             jsr     ReqHw
002CF5r 2  A9 rr                lda     #<MsgEraseDisk
002CF7r 2  A0 rr                ldy     #>MsgEraseDisk
002CF9r 2  20 rr rr             jsr     BasPrintStr
002CFCr 2  AD 0F 03             lda     CF_DISK
002CFFr 2  8D 4A 03             sta     FS_FILE_SIZE
002D02r 2  9C 4B 03             stz     FS_FILE_SIZE+1
002D05r 2  20 rr rr             jsr     FsPrintSize             ; print disk number (decimal)
002D08r 2  A9 rr                lda     #<MsgConfirm
002D0Ar 2  A0 rr                ldy     #>MsgConfirm
002D0Cr 2  20 rr rr             jsr     BasPrintStr
002D0Fr 2               @wait:
002D0Fr 2  20 rr rr             jsr     Chrin                   ; wait for a key (echoes)
002D12r 2  90 FB                bcc     @wait
002D14r 2  29 DF                and     #$DF                    ; fold to uppercase
002D16r 2  48                   pha
002D17r 2  20 rr rr             jsr     BasPrintCRLF
002D1Ar 2  68                   pla
002D1Br 2  C9 59                cmp     #'Y'
002D1Dr 2  D0 03                bne     @abort
002D1Fr 2  4C rr rr             jmp     FsFormatDisk            ; zero the directory (returns carry status)
002D22r 2               @abort:
002D22r 2  60                   rts
002D23r 2               
002D23r 2               ; ===========================================================================
002D23r 2               ;   P I C O V D P   S T A T E M E N T S
002D23r 2               ;
002D23r 2               ; Silent without a card, like CLS, LOCATE and COLOR: the arguments are parsed
002D23r 2               ; and range-checked, and then the Kernal entry each ends in skips.  Port A
002D23r 2               ; only, through the $A0B1-$A0D5 entries, so VID_MODE and the LxCTRL shadows
002D23r 2               ; stay true and BasTextConsole knows when a program has left Text mode.
002D23r 2               ; ===========================================================================
002D23r 2               
002D23r 2               ; SCREEN n -- 0 the Text console (InitVideo + CLS); 1 Compact, 2 Graphics,
002D23r 2               ; 3 Full.  The three graphics modes share one layout, which fits Full's 1200-
002D23r 2               ; byte tables (decision 2):
002D23r 2               ;
002D23r 2               ;   $0000 L0 names   $0800 L0 attributes   $1000 L1 names   $1800 L1 attributes
002D23r 2               ;   $2000 sprite attributes   $4000 L0 patterns   $8000 L1 patterns
002D23r 2               ;   $C000 sprite patterns
002D23r 2               ;
002D23r 2               ; Layer 0 4bpp with per-cell attributes, opaque and on; layer 1 the same but
002D23r 2               ; off and transparent; 64 sprites at 4bpp, all parked at Y = 240, below the
002D23r 2               ; picture.  The four tables at $0000-$1FFF are cleared; the pattern tables and
002D23r 2               ; the palette are the program's.  VMODE goes last, through VdpWriteReg, so
002D23r 2               ; VID_MODE says which mode the card is in.
002D23r 2               BasCmdScreen:
002D23r 2  A9 04                lda     #4                      ; 0-3
002D25r 2  20 rr rr             jsr     GetByteLim              ; X = n
002D28r 2  8A                   txa
002D29r 2  D0 06                bne     @graphics
002D2Br 2  20 rr rr             jsr     InitVideo
002D2Er 2  4C rr rr             jmp     VideoClear              ; Both skip without a card
002D31r 2               @graphics:
002D31r 2  2C 0D 03             bit     HW_PRESENT              ; Video is bit 7
002D34r 2  10 42                bpl     @done
002D36r 2  48                   pha                             ; n
002D37r 2  A0 00                ldy     #0
002D39r 2               @reg:
002D39r 2  BE rr rr             ldx     ScreenLayout,y
002D3Cr 2  B9 rr rr             lda     ScreenLayout+1,y
002D3Fr 2  20 rr rr             jsr     VdpWriteReg             ; Keeps X and Y
002D42r 2  C8                   iny
002D43r 2  C8                   iny
002D44r 2  C0 22                cpy     #(ScreenLayoutEnd - ScreenLayout)
002D46r 2  D0 F1                bne     @reg
002D48r 2  A9 40                lda     #$40                    ; $0000, write
002D4Ar 2  A2 00                ldx     #0
002D4Cr 2  A0 00                ldy     #0
002D4Er 2  20 rr rr             jsr     VdpAddress
002D51r 2  A2 00                ldx     #0
002D53r 2  A0 20                ldy     #>$2000                 ; 32 pages, the four tables
002D55r 2               @clear:
002D55r 2  9C 00 9C             stz     VC_DATA
002D58r 2  E8                   inx
002D59r 2  D0 FA                bne     @clear
002D5Br 2  88                   dey
002D5Cr 2  D0 F7                bne     @clear
002D5Er 2  A2 40                ldx     #64                     ; On into the sprite table at $2000
002D60r 2               @sprite:
002D60r 2  A9 F0                lda     #240                    ; Y: the line below a 240-line picture
002D62r 2  8D 00 9C             sta     VC_DATA
002D65r 2  9C 00 9C             stz     VC_DATA                 ; X
002D68r 2  9C 00 9C             stz     VC_DATA                 ; Pattern
002D6Br 2  9C 00 9C             stz     VC_DATA                 ; Attributes
002D6Er 2  CA                   dex
002D6Fr 2  D0 EF                bne     @sprite
002D71r 2  68                   pla
002D72r 2  1A                   inc     a                       ; SCREEN 1-3 is VMODE 2-4
002D73r 2  A2 0D                ldx     #VDP_VMODE
002D75r 2  4C rr rr             jmp     VdpWriteReg
002D78r 2               @done:
002D78r 2  60                   rts
002D79r 2               
002D79r 2               ScreenLayout:                           ; Register, value
002D79r 2  01 40                .byte   VDP_MODE1,    $40       ; Display on, 8x8 sprites unmagnified
002D7Br 2  10 00                .byte   VDP_L0NAME,   $00       ; $0000
002D7Dr 2  11 02                .byte   VDP_L0ATTR,   $02       ; $0800
002D7Fr 2  12 08                .byte   VDP_L0PAT,    $08       ; $4000
002D81r 2  13 00                .byte   VDP_L0SCRX,   $00
002D83r 2  14 00                .byte   VDP_L0SCRY,   $00
002D85r 2  15 32                .byte   VDP_L0CTRL,   $32       ; 4bpp, per cell, on, index 0 opaque
002D87r 2  18 04                .byte   VDP_L1NAME,   $04       ; $1000
002D89r 2  19 06                .byte   VDP_L1ATTR,   $06       ; $1800
002D8Br 2  1A 10                .byte   VDP_L1PAT,    $10       ; $8000
002D8Dr 2  1B 00                .byte   VDP_L1SCRX,   $00
002D8Fr 2  1C 00                .byte   VDP_L1SCRY,   $00
002D91r 2  1D 02                .byte   VDP_L1CTRL,   $02       ; 4bpp, per cell, off, index 0 clear
002D93r 2  20 40                .byte   VDP_SPRATTR,  $40       ; $2000, where VdpSprite writes
002D95r 2  21 18                .byte   VDP_SPRPAT,   $18       ; $C000
002D97r 2  22 40                .byte   VDP_SPRCOUNT, 64
002D99r 2  23 23                .byte   VDP_SPRCTRL,  $23       ; On, collisions, no $D0 end, 4bpp
002D9Br 2               ScreenLayoutEnd:
002D9Br 2               
002D9Br 2               ; VPOKE addr, value -- a byte anywhere in the 64 KB of VRAM
002D9Br 2               ; The address rides the stack across the value's evaluation, as POKE's does.
002D9Br 2               BasCmdVpoke:
002D9Br 2  20 rr rr             jsr     EvalAddrU16
002D9Er 2  A5 12                lda     FAC+4                   ; lo
002DA0r 2  48                   pha
002DA1r 2  A5 11                lda     FAC+3                   ; hi
002DA3r 2  48                   pha
002DA4r 2  20 rr rr             jsr     GetComByt               ; X = value
002DA7r 2  8A                   txa
002DA8r 2  7A                   ply                             ; hi
002DA9r 2  FA                   plx                             ; lo
002DAAr 2  4C rr rr             jmp     VdpPoke
002DADr 2               
002DADr 2               ; VREG reg, value -- write register 0-127, through VdpWriteReg
002DADr 2               BasCmdVreg:
002DADr 2  A9 80                lda     #128
002DAFr 2  20 rr rr             jsr     GetByteLim              ; X = reg
002DB2r 2  DA                   phx
002DB3r 2  20 rr rr             jsr     GetComByt               ; X = value
002DB6r 2  8A                   txa
002DB7r 2  FA                   plx
002DB8r 2  4C rr rr             jmp     VdpWriteReg
002DBBr 2               
002DBBr 2               ; PALETTE index, r, g, b -- palette entry 0-255 at $FC00 + 2 * index, 0-15 each
002DBBr 2               BasCmdPalette:
002DBBr 2  20 rr rr             jsr     GetByt                  ; X = index
002DBEr 2  DA                   phx
002DBFr 2  A9 10                lda     #16
002DC1r 2  20 rr rr             jsr     GetComByteLim           ; X = r
002DC4r 2  DA                   phx
002DC5r 2  A9 10                lda     #16
002DC7r 2  20 rr rr             jsr     GetComByteLim           ; X = g
002DCAr 2  DA                   phx
002DCBr 2  A9 10                lda     #16
002DCDr 2  20 rr rr             jsr     GetComByteLim           ; X = b
002DD0r 2  86 3A                stx     BAS_TMP1
002DD2r 2  68                   pla                             ; g
002DD3r 2  0A                   asl     a
002DD4r 2  0A                   asl     a
002DD5r 2  0A                   asl     a
002DD6r 2  0A                   asl     a
002DD7r 2  05 3A                ora     BAS_TMP1
002DD9r 2  A8                   tay                             ; $GB
002DDAr 2  68                   pla                             ; $0R
002DDBr 2  FA                   plx                             ; index
002DDCr 2  4C rr rr             jmp     VdpSetPalette
002DDFr 2               
002DDFr 2               ; VSYNC -- wait for the start of the next vertical blank (2 cs without a card)
002DDFr 2               BasCmdVsync     := WaitVBlank
002DDFr 2               
002DDFr 2               ; VLOAD "name", addr -- a file from the current disk into VRAM at addr, its
002DDFr 2               ; exact length.  A data statement, so no CF card is ?NO DEVICE; no video card
002DDFr 2               ; reads nothing and says nothing.
002DDFr 2               BasCmdVload:
002DDFr 2  A9 08                lda     #HW_CF
002DE1r 2  20 rr rr             jsr     ReqHw
002DE4r 2  20 rr rr             jsr     EvalString              ; -> BAS_FNAME, STR_PTR
002DE7r 2  20 rr rr             jsr     ChkCom
002DEAr 2  20 rr rr             jsr     EvalAddrU16
002DEDr 2  A5 12                lda     FAC+4
002DEFr 2  8D 7F 03             sta     FS_IO_ADDR
002DF2r 2  A5 11                lda     FAC+3
002DF4r 2  8D 80 03             sta     FS_IO_ADDR+1
002DF7r 2  2C 0D 03             bit     HW_PRESENT              ; Video is bit 7
002DFAr 2  10 08                bpl     @done
002DFCr 2  20 rr rr             jsr     VdpLoadFile
002DFFr 2  90 03                bcc     @done
002E01r 2  4C rr rr             jmp     BasLoadErr
002E04r 2               @done:
002E04r 2  60                   rts
002E05r 2               
002E05r 2               ; VPEEK(addr) -- the VRAM byte at addr; 0 without a card
002E05r 2               FnVpeek:
002E05r 2  20 rr rr             jsr     ParenNum
002E08r 2  20 rr rr             jsr     FacToU16
002E0Br 2  A6 12                ldx     FAC+4
002E0Dr 2  A4 11                ldy     FAC+3
002E0Fr 2  A9 00                lda     #0                      ; What VdpPeek leaves in A without a card
002E11r 2  20 rr rr             jsr     VdpPeek
002E14r 2  A8                   tay
002E15r 2  4C rr rr             jmp     SngFlt
002E18r 2               
002E18r 2               ; SPRITE n, x, y, pattern[, attr] -- sprite n (0-63) at x (0-511, 384-511 being
002E18r 2               ; -128 to -1), y (0-255), with pattern (0-255) and attributes (0-127, default
002E18r 2               ; 0; b6 priority, b5:4 flips, b3:0 sub-palette).  VdpSprite writes the four
002E18r 2               ; bytes at $2000 + 4n, where SCREEN 1-3 put the table, with x's bit 8 as the
002E18r 2               ; attribute's b7.
002E18r 2               BasCmdSprite:
002E18r 2  A9 40                lda     #64
002E1Ar 2  20 rr rr             jsr     GetByteLim              ; X = n
002E1Dr 2  DA                   phx
002E1Er 2  20 rr rr             jsr     ChkCom
002E21r 2  20 rr rr             jsr     EvalAddrU16             ; x
002E24r 2  A5 11                lda     FAC+3
002E26r 2  C9 02                cmp     #2
002E28r 2  B0 31                bcs     BasVdpRangeErr          ; 512 and up
002E2Ar 2  8D 9B 03             sta     VDP_P3                  ; Bit 8, until the attributes are in
002E2Dr 2  A5 12                lda     FAC+4
002E2Fr 2  8D 99 03             sta     VDP_P1
002E32r 2  20 rr rr             jsr     GetComByt               ; X = y
002E35r 2  8E 98 03             stx     VDP_P0
002E38r 2  20 rr rr             jsr     GetComByt               ; X = pattern
002E3Br 2  8E 9A 03             stx     VDP_P2
002E3Er 2  A2 00                ldx     #0                      ; attr if none is given
002E40r 2  20 rr rr             jsr     ChrGot
002E43r 2  C9 2C                cmp     #','
002E45r 2  D0 05                bne     @attr
002E47r 2  A9 80                lda     #128
002E49r 2  20 rr rr             jsr     GetComByteLim           ; X = attr
002E4Cr 2               @attr:
002E4Cr 2  8A                   txa
002E4Dr 2  4E 9B 03             lsr     VDP_P3                  ; Bit 8 into carry
002E50r 2  90 02                bcc     @low
002E52r 2  09 80                ora     #$80
002E54r 2               @low:
002E54r 2  8D 9B 03             sta     VDP_P3
002E57r 2  FA                   plx                             ; n
002E58r 2  4C rr rr             jmp     VdpSprite
002E5Br 2               
002E5Br 2               BasVdpRangeErr:
002E5Br 2  4C rr rr             jmp     IqErr
002E5Er 2               
002E5Er 2               ; SCROLL layer, x, y -- scroll layer 0-1 to x (0-319), y (0-255)
002E5Er 2               BasCmdScroll:
002E5Er 2  A9 02                lda     #2
002E60r 2  20 rr rr             jsr     GetByteLim              ; X = layer
002E63r 2  DA                   phx
002E64r 2  20 rr rr             jsr     ChkCom
002E67r 2  20 rr rr             jsr     EvalAddrU16             ; x
002E6Ar 2  A5 11                lda     FAC+3
002E6Cr 2  8D 98 03             sta     VDP_P0                  ; Bit 8
002E6Fr 2  F0 0A                beq     @x
002E71r 2  C9 01                cmp     #1
002E73r 2  D0 E6                bne     BasVdpRangeErr
002E75r 2  A5 12                lda     FAC+4
002E77r 2  C9 40                cmp     #64                     ; 256 + 64 = 320
002E79r 2  B0 E0                bcs     BasVdpRangeErr
002E7Br 2               @x:
002E7Br 2  A5 12                lda     FAC+4
002E7Dr 2  48                   pha
002E7Er 2  20 rr rr             jsr     GetComByt               ; X = y
002E81r 2  8A                   txa
002E82r 2  A8                   tay
002E83r 2  68                   pla                             ; x bits 7:0
002E84r 2  FA                   plx                             ; layer
002E85r 2  4C rr rr             jmp     VdpSetScroll
002E88r 2               
002E88r 2               ; LAYER layer, on -- hide layer 0-1 (on = 0) or show it
002E88r 2               BasCmdLayer:
002E88r 2  A9 02                lda     #2
002E8Ar 2  20 rr rr             jsr     GetByteLim              ; X = layer
002E8Dr 2  DA                   phx
002E8Er 2  20 rr rr             jsr     GetComByt               ; X = on
002E91r 2  8A                   txa
002E92r 2  FA                   plx
002E93r 2  4C rr rr             jmp     VdpLayer
002E96r 2               
002E96r 2               ; VSTAT(n) -- status register n, 0-15; 0 without a card.  VSTAT(0) clears
002E96r 2               ; STAT0's flags, as reading it does.
002E96r 2               FnVstat:
002E96r 2  20 rr rr             jsr     ParenU8                 ; A = n
002E99r 2  C9 10                cmp     #16
002E9Br 2  B0 BE                bcs     BasVdpRangeErr
002E9Dr 2  AA                   tax
002E9Er 2  A9 00                lda     #0                      ; What VdpStatus leaves in A without a card
002EA0r 2  20 rr rr             jsr     VdpStatus
002EA3r 2  A8                   tay
002EA4r 2  4C rr rr             jmp     SngFlt
002EA7r 2               
002EA7r 2               ; ===========================================================================
002EA7r 2               ;   S A V E   S L O T   S T A T E M E N T S
002EA7r 2               ;
002EA7r 2               ; The Kernal's NvWrite, NvRead, NvErase, NvStat and NvFind, slot for slot
002EA7r 2               ; (decision 3).  Like NVRAM, the statements raise ?NO DEVICE without an RTC
002EA7r 2               ; card, and the functions answer quietly instead: NVSTAT is 0 (free), NVFIND
002EA7r 2               ; -1 (nothing found).  The owner ID of a slot stays readable as NVRAM(slot*16).
002EA7r 2               ; ===========================================================================
002EA7r 2               
002EA7r 2               ; NVSAVE slot, id, addr -- the 14 bytes at addr into slot 0-15, owner id 1-255
002EA7r 2               BasCmdNvsave:
002EA7r 2  A9 04                lda     #HW_RTC
002EA9r 2  20 rr rr             jsr     ReqHw
002EACr 2  A9 10                lda     #NV_SLOTS
002EAEr 2  20 rr rr             jsr     GetByteLim              ; X = slot
002EB1r 2  DA                   phx
002EB2r 2  20 rr rr             jsr     GetComByt               ; X = id
002EB5r 2  8E 90 03             stx     NV_ID                   ; Kernal RAM: safe across FrmEvl
002EB8r 2  8A                   txa
002EB9r 2  F0 0E                beq     BasNvRangeErr           ; ID 0 marks a free slot
002EBBr 2  20 rr rr             jsr     ChkCom
002EBEr 2  20 rr rr             jsr     EvalAddrU16             ; addr
002EC1r 2  A5 12                lda     FAC+4
002EC3r 2  A4 11                ldy     FAC+3
002EC5r 2  FA                   plx                             ; slot
002EC6r 2  4C rr rr             jmp     NvWrite                 ; Nothing left for it to refuse
002EC9r 2               
002EC9r 2               BasNvRangeErr:
002EC9r 2  4C rr rr             jmp     IqErr
002ECCr 2               
002ECCr 2               ; NVLOAD slot, addr -- a valid slot's 14 bytes to addr; ?LOAD ERROR, and
002ECCr 2               ; nothing copied, for a free or damaged one
002ECCr 2               BasCmdNvload:
002ECCr 2  A9 04                lda     #HW_RTC
002ECEr 2  20 rr rr             jsr     ReqHw
002ED1r 2  A9 10                lda     #NV_SLOTS
002ED3r 2  20 rr rr             jsr     GetByteLim              ; X = slot
002ED6r 2  DA                   phx
002ED7r 2  20 rr rr             jsr     ChkCom
002EDAr 2  20 rr rr             jsr     EvalAddrU16             ; addr
002EDDr 2  A5 12                lda     FAC+4
002EDFr 2  A4 11                ldy     FAC+3
002EE1r 2  FA                   plx                             ; slot
002EE2r 2  20 rr rr             jsr     NvRead
002EE5r 2  90 03                bcc     @done
002EE7r 2  4C rr rr             jmp     BasLoadErr
002EEAr 2               @done:
002EEAr 2  60                   rts
002EEBr 2               
002EEBr 2               ; NVERASE slot -- zero all 16 bytes of slot 0-15
002EEBr 2               BasCmdNverase:
002EEBr 2  A9 04                lda     #HW_RTC
002EEDr 2  20 rr rr             jsr     ReqHw
002EF0r 2  A9 10                lda     #NV_SLOTS
002EF2r 2  20 rr rr             jsr     GetByteLim              ; X = slot
002EF5r 2  4C rr rr             jmp     NvErase
002EF8r 2               
002EF8r 2               ; NVSTAT(slot) -- 0 free, 1 valid, 2 damaged
002EF8r 2               FnNvstat:
002EF8r 2  20 rr rr             jsr     ParenU8                 ; A = slot
002EFBr 2  C9 10                cmp     #NV_SLOTS
002EFDr 2  B0 CA                bcs     BasNvRangeErr
002EFFr 2  AA                   tax
002F00r 2  20 rr rr             jsr     NvStat                  ; Carry: no RTC card
002F03r 2  90 02                bcc     @status
002F05r 2  A9 00                lda     #NV_EMPTY
002F07r 2               @status:
002F07r 2  A8                   tay
002F08r 2  4C rr rr             jmp     SngFlt
002F0Br 2               
002F0Br 2               ; NVFIND(id) -- the lowest slot owned by id (0: the lowest free slot), or -1
002F0Br 2               FnNvfind:
002F0Br 2  20 rr rr             jsr     ParenU8                 ; A = id
002F0Er 2  20 rr rr             jsr     NvFind                  ; X = slot; carry: none, or no RTC card
002F11r 2  B0 05                bcs     @none
002F13r 2  8A                   txa
002F14r 2  A8                   tay
002F15r 2  4C rr rr             jmp     SngFlt
002F18r 2               @none:
002F18r 2  A9 FF                lda     #$FF                    ; -1
002F1Ar 2  A8                   tay
002F1Br 2  4C rr rr             jmp     GivAyf
002F1Er 2               
002F1Er 2  20 42 59 54  MsgFree:        .byte   " BYTES FREE  HW=",0
002F22r 2  45 53 20 46  
002F26r 2  52 45 45 20  
002F2Fr 2  3F 4C 4F 41  MsgLoadErr:     .byte   "?LOAD ERROR",$0D,$0A,0
002F33r 2  44 20 45 52  
002F37r 2  52 4F 52 0D  
002F3Dr 2  3F 53 41 56  MsgSaveErr:     .byte   "?SAVE ERROR",$0D,$0A,0
002F41r 2  45 20 45 52  
002F45r 2  52 4F 52 0D  
002F4Br 2  3F 44 45 4C  MsgDelErr:      .byte   "?DEL ERROR",$0D,$0A,0
002F4Fr 2  20 45 52 52  
002F53r 2  4F 52 0D 0A  
002F58r 2  45 52 41 53  MsgEraseDisk:   .byte   "ERASE DISK ",0
002F5Cr 2  45 20 44 49  
002F60r 2  53 4B 20 00  
002F64r 2  3F 20 28 59  MsgConfirm:     .byte   "? (Y/N) ",0
002F68r 2  2F 4E 29 20  
002F6Cr 2  00           
002F6Dr 2               
002F6Dr 2               ; Wrappers so the dispatch table can call existing routines that expect
002F6Dr 2               ; TXTPTR positioned already.
002F6Dr 2               BasCmdPrintW:
002F6Dr 2                       ; We were entered via the dispatch trampoline, so TXTPTR is already
002F6Dr 2                       ; past the PRINT token (ChrGet was tail-called).  But BasCmdPrint
002F6Dr 2                       ; expects to consume the token itself with its first ChrGet; rewind.
002F6Dr 2                       ; Easier: BasCmdPrint reads via ChrGet; here ChrGet was called before
002F6Dr 2                       ; routine entry, so TXTPTR currently points at first arg.  Just call
002F6Dr 2                       ; an internal entry that skips the leading ChrGet.
002F6Dr 2  4C rr rr             jmp     BasPrLoop
002F70r 2               
002F70r 2               ; ---------------------------------------------------------------------------
002F70r 2               ; Token-address dispatch table.  Indexed by (token - $80).  Each entry is
002F70r 2               ; (routine_address - 1) since the dispatcher PHA-pushes it and uses the
002F70r 2               ; "JMP ChrGet -> RTS" trick to enter.
002F70r 2               ; ---------------------------------------------------------------------------
002F70r 2               BasTokenAddrTbl:
002F70r 2  rr rr                .word   BasCmdEnd-1             ; $80 END
002F72r 2  rr rr                .word   BasCmdFor-1             ; $81 FOR
002F74r 2  rr rr                .word   BasCmdNext-1            ; $82 NEXT
002F76r 2  rr rr                .word   BasCmdData-1            ; $83 DATA
002F78r 2  rr rr                .word   BasCmdInput-1           ; $84 INPUT
002F7Ar 2  rr rr                .word   BasCmdDim-1             ; $85 DIM
002F7Cr 2  rr rr                .word   BasCmdRead-1            ; $86 READ
002F7Er 2  rr rr                .word   BasCmdLet-1             ; $87 LET
002F80r 2  rr rr                .word   BasCmdGoto-1            ; $88 GOTO
002F82r 2  rr rr                .word   BasCmdRun-1             ; $89 RUN
002F84r 2  rr rr                .word   BasCmdIf-1              ; $8A IF
002F86r 2  rr rr                .word   BasCmdRestore-1         ; $8B RESTORE
002F88r 2  rr rr                .word   BasCmdGosub-1           ; $8C GOSUB
002F8Ar 2  rr rr                .word   BasCmdReturn-1          ; $8D RETURN
002F8Cr 2  rr rr                .word   BasCmdRem-1             ; $8E REM
002F8Er 2  rr rr                .word   BasCmdStop-1            ; $8F STOP
002F90r 2  rr rr                .word   BasCmdOn-1              ; $90 ON
002F92r 2  rr rr                .word   BasCmdWait-1            ; $91 WAIT
002F94r 2  rr rr                .word   BasCmdLoad-1            ; $92 LOAD
002F96r 2  rr rr                .word   BasCmdSave-1            ; $93 SAVE
002F98r 2  rr rr                .word   BasCmdDef-1             ; $94 DEF
002F9Ar 2  rr rr                .word   BasCmdPoke-1            ; $95 POKE
002F9Cr 2  rr rr                .word   BasCmdPrintW-1          ; $96 PRINT
002F9Er 2  rr rr                .word   BasCmdCont-1            ; $97 CONT
002FA0r 2  rr rr                .word   BasCmdList-1            ; $98 LIST
002FA2r 2  rr rr                .word   BasCmdClr-1             ; $99 CLR
002FA4r 2  rr rr                .word   BasCmdNew-1             ; $9A NEW
002FA6r 2  rr rr                .word   SynErr-1                ; $9B TAB  (function only)
002FA8r 2  rr rr                .word   SynErr-1                ; $9C TO
002FAAr 2  rr rr                .word   SynErr-1                ; $9D FN
002FACr 2  rr rr                .word   SynErr-1                ; $9E SPC
002FAEr 2  rr rr                .word   SynErr-1                ; $9F THEN
002FB0r 2  rr rr                .word   SynErr-1                ; $A0 NOT
002FB2r 2  rr rr                .word   SynErr-1                ; $A1 STEP
002FB4r 2  rr rr                .word   SynErr-1                ; $A2 AND
002FB6r 2  rr rr                .word   SynErr-1                ; $A3 OR
002FB8r 2  rr rr                .word   BasCmdRem-1             ; $A4 ELSE (skip rest of line; THEN-branch ran)
002FBAr 2  rr rr                .word   BasCmdSys-1             ; $A5 SYS
002FBCr 2  rr rr                .word   BasCmdDir-1             ; $A6 DIR
002FBEr 2  rr rr                .word   BasCmdDel-1             ; $A7 DEL
002FC0r 2  rr rr                .word   BasCmdCls-1             ; $A8 CLS
