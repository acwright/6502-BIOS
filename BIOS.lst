001777r 2               .if 0
001777r 2               ; (Removed in Phase 8: _VARTEST debug harness lived here.)
001777r 2               VT_SetTxt:
001777r 2                       ; Set TXTPTR = VT_TXTPTR_TMP - 1 then ChrGet to load first char.
001777r 2                       ; Actually simpler: caller passes (Y,A) = pointer; we set TXTPTR =
001777r 2                       ; (Y,A) - 1 and call ChrGet to land on (Y,A).
001777r 2                       sta     TXTPTR
001777r 2                       sty     TXTPTR+1
001777r 2                       lda     TXTPTR
001777r 2                       bne     @nb
001777r 2                       dec     TXTPTR+1
001777r 2               @nb:
001777r 2                       dec     TXTPTR
001777r 2                       jmp     ChrGet
001777r 2               
001777r 2               VT_StoreFAC:
001777r 2                       ; Round and store FAC at (VARPNT).
001777r 2                       ldx     VARPNT
001777r 2                       ldy     VARPNT+1
001777r 2                       jmp     StoreFacAtYxRounded
001777r 2               
001777r 2               VT_LoadFAC:
001777r 2                       ; Load FAC from (VARPNT).
001777r 2                       lda     VARPNT
001777r 2                       ldy     VARPNT+1
001777r 2                       jmp     LoadFacFromYa
001777r 2               
001777r 2               VT_VPSAVE       = $86           ; 2-byte ZP VARPNT save (_VARTEST debug)
001777r 2               
001777r 2               BasCmdVarTest:
001777r 2                       jsr     BasCmdClr
001777r 2               
001777r 2                       ; --- Test 1: A=3.14, B=A*2 ---
001777r 2                       lda     #<VT_NameA
001777r 2                       ldy     #>VT_NameA
001777r 2                       jsr     VT_SetTxt
001777r 2                       jsr     PtrGet                  ; creates A; VARPNT -> A's value
001777r 2                       ; FAC = 3.14
001777r 2                       lda     #<VT_pi
001777r 2                       ldy     #>VT_pi
001777r 2                       jsr     LoadFacFromYa
001777r 2                       jsr     VT_StoreFAC
001777r 2               
001777r 2                       lda     #<VT_NameB
001777r 2                       ldy     #>VT_NameB
001777r 2                       jsr     VT_SetTxt
001777r 2                       jsr     PtrGet                  ; creates B
001777r 2                       ; Save B's VARPNT.
001777r 2                       lda     VARPNT
001777r 2                       sta     VT_VPSAVE
001777r 2                       lda     VARPNT+1
001777r 2                       sta     VT_VPSAVE+1
001777r 2               
001777r 2                       ; Look up A again (already exists).
001777r 2                       lda     #<VT_NameA
001777r 2                       ldy     #>VT_NameA
001777r 2                       jsr     VT_SetTxt
001777r 2                       jsr     PtrGet
001777r 2                       jsr     VT_LoadFAC              ; FAC = A = 3.14
001777r 2                       ; Multiply by 2.
001777r 2                       lda     #<FpC2
001777r 2                       ldy     #>FpC2
001777r 2                       jsr     FMult                   ; FAC = 2 * FAC = 6.28
001777r 2                       ; Store into B.
001777r 2                       ldx     VT_VPSAVE
001777r 2                       ldy     VT_VPSAVE+1
001777r 2                       jsr     StoreFacAtYxRounded
001777r 2               
001777r 2                       ; Print result.
001777r 2                       lda     #<MsgVT_A
001777r 2                       ldy     #>MsgVT_A
001777r 2                       jsr     BasPrintStr
001777r 2                       ; Reload B and print.
001777r 2                       lda     VT_VPSAVE
001777r 2                       ldy     VT_VPSAVE+1
001777r 2                       jsr     LoadFacFromYa
001777r 2                       jsr     BasPrintFAC
001777r 2                       jsr     BasPrintCRLF
001777r 2               
001777r 2                       ; --- Test 2: A$="HELLO" ---
001777r 2                       lda     #<VT_NameAS
001777r 2                       ldy     #>VT_NameAS
001777r 2                       jsr     VT_SetTxt
001777r 2                       jsr     PtrGet                  ; creates A$
001777r 2                       ; Save VARPNT (A$ descriptor address).
001777r 2                       lda     VARPNT
001777r 2                       sta     VT_VPSAVE
001777r 2                       lda     VARPNT+1
001777r 2                       sta     VT_VPSAVE+1
001777r 2                       ; Allocate space, copy "HELLO" via StrLit.
001777r 2                       lda     #<VT_HelloLit
001777r 2                       ldy     #>VT_HelloLit
001777r 2                       jsr     StrLit                  ; FAC has descriptor, in temp stack
001777r 2                       ; Now copy descriptor (3 bytes from temp stack entry) to A$ var.
001777r 2                       ; FAC+3,4 points at the temp descriptor; FAC = length, FAC+1/2 = addr.
001777r 2                       ; The descriptor lives in TEMPST.  We just write [len][lo][hi] into
001777r 2                       ; (VARPNT) so the variable now references the heap copy.
001777r 2                       lda     FAC
001777r 2                       ldy     #$00
001777r 2                       sta     (VT_VPSAVE),y           ; length
001777r 2                       lda     FAC+1
001777r 2                       iny
001777r 2                       sta     (VT_VPSAVE),y           ; addr lo
001777r 2                       lda     FAC+2
001777r 2                       iny
001777r 2                       sta     (VT_VPSAVE),y           ; addr hi
001777r 2                       ; Print length.
001777r 2                       lda     #<MsgVT_AS
001777r 2                       ldy     #>MsgVT_AS
001777r 2                       jsr     BasPrintStr
001777r 2                       ldy     #$00
001777r 2                       lda     (VT_VPSAVE),y
001777r 2                       tay
001777r 2                       jsr     SngFlt
001777r 2                       jsr     BasPrintFAC
001777r 2                       jsr     BasPrintCRLF
001777r 2               
001777r 2                       ; --- Test 3: DIM N(10), N(5)=42 ---
001777r 2                       ; Build TXTPTR pointing at "N(10) " and call MakInt-equivalent path.
001777r 2                       ; Easier: directly construct array via PtrGet3 + Array by simulating
001777r 2                       ; a 1-D DIM of size 11 (indices 0..10).  We emulate the parser:
001777r 2                       ;   1. Set DIMFLG = $40, VARNAM = ('N','N'), call PtrGet3 with X=1?
001777r 2                       ;   2. Or: just do PtrGet3 entry by hand then jmp Array.
001777r 2                       ; Simplest: set TXTPTR at "N(10) ", DIMFLG <- $40 (from DIM
001777r 2                       ; statement), then PtrGet3 with VARNAM letter, jmp to '(' branch.
001777r 2                       lda     #<VT_DimN10
001777r 2                       ldy     #>VT_DimN10
001777r 2                       jsr     VT_SetTxt               ; A = 'N'
001777r 2                       ldx     #$40                    ; from-DIM flag (bit 6)
001777r 2                       jsr     PtrGet2                 ; will hit '(' -> Array -> create
001777r 2                       ; Now N(5)=42.  Re-parse "N(5)" to find element.
001777r 2                       lda     #<VT_DimN5
001777r 2                       ldy     #>VT_DimN5
001777r 2                       jsr     VT_SetTxt
001777r 2                       jsr     PtrGet                  ; element address in VARPNT
001777r 2                       ; Save VARPNT.
001777r 2                       lda     VARPNT
001777r 2                       sta     VT_VPSAVE
001777r 2                       lda     VARPNT+1
001777r 2                       sta     VT_VPSAVE+1
001777r 2                       ; FAC = 42.
001777r 2                       lda     #<Vt42
001777r 2                       ldy     #>Vt42
001777r 2                       jsr     LoadFacFromYa
001777r 2                       ldx     VT_VPSAVE
001777r 2                       ldy     VT_VPSAVE+1
001777r 2                       jsr     StoreFacAtYxRounded
001777r 2                       ; Read it back and print.
001777r 2                       lda     #<MsgVT_NewArr
001777r 2                       ldy     #>MsgVT_NewArr
001777r 2                       jsr     BasPrintStr
001777r 2                       lda     VT_VPSAVE
001777r 2                       ldy     VT_VPSAVE+1
001777r 2                       jsr     LoadFacFromYa
001777r 2                       jsr     BasPrintFAC
001777r 2                       jsr     BasPrintCRLF
001777r 2               
001777r 2                       ; --- Test 4: 8 string allocations + GC ---
001777r 2                       ldx     #8
001777r 2               @galloc:
001777r 2                       phx
001777r 2                       lda     #16
001777r 2                       jsr     StrSpa                  ; consumes 16 bytes; FAC has descriptor
001777r 2                       plx
001777r 2                       dex
001777r 2                       bne     @galloc
001777r 2                       ; Force GC (TEMPPT got bumped by StrSpa-via-StrIni? StrSpa itself
001777r 2                       ; doesn't call PutNew, so temp stack untouched here.)
001777r 2                       jsr     Garbag
001777r 2                       lda     #<MsgVT_GC
001777r 2                       ldy     #>MsgVT_GC
001777r 2                       jsr     BasPrintStr
001777r 2                       lda     FRETOP+1
001777r 2                       ldy     FRETOP
001777r 2                       jsr     GivAyf
001777r 2                       jsr     BasPrintFAC
001777r 2                       jsr     BasPrintCRLF
001777r 2               
001777r 2                       rts
001777r 2               .endif
001777r 2               
001777r 2               ; =============================================================================
001777r 2               ;   E X P R E S S I O N   E V A L U A T O R
001777r 2               ;
001777r 2               ;   Recursive-descent precedence climber.  Operates on tokenized text at
001777r 2               ;   TXTPTR (advanced via ChrGet/ChrGot).  Result lands in FAC (numeric)
001777r 2               ;   or as a 3-byte string descriptor at FAC..FAC+2 (string).  VALTYP
001777r 2               ;   selects: $00 = numeric, $FF = string.
001777r 2               ;
001777r 2               ;   Precedence (lowest -> highest):
001777r 2               ;     OR
001777r 2               ;     AND
001777r 2               ;     NOT  (right-assoc unary)
001777r 2               ;     comparison (= <> < > <= >=)
001777r 2               ;     + -
001777r 2               ;     * /
001777r 2               ;     ^    (right-assoc)
001777r 2               ;     unary -, unary +
001777r 2               ;     atom: number, variable, string-literal, "(" expr ")", function call
001777r 2               ; =============================================================================
001777r 2               
001777r 2               ; ---------------------------------------------------------------------------
001777r 2               ; ZP scratch used only during expression evaluation.
001777r 2               ;   BAS_LVTYP = saved VALTYP of left operand around binary ops
001777r 2               ; ---------------------------------------------------------------------------
001777r 2               BAS_LVTYP       := $86
001777r 2               
001777r 2               ; ---------------------------------------------------------------------------
001777r 2               ; FrmEvl -- top-level entry.  TXTPTR positioned so ChrGot returns the first
001777r 2               ; byte of the expression.  On exit TXTPTR is at the first byte AFTER the
001777r 2               ; expression.  Result in FAC + VALTYP.
001777r 2               ; ---------------------------------------------------------------------------
001777r 2               FrmEvl:
001777r 2  4C rr rr             jmp     EvalOr
00177Ar 2               
00177Ar 2               ; ---------------------------------------------------------------------------
00177Ar 2               ; PushFac -- push the current FAC + VALTYP onto the CPU stack (8 bytes).
00177Ar 2               ; Order pushed: VALTYP, FAC, FAC+1, FAC+2, FAC+3, FAC+4, FACSIGN, FACEXTENSION
00177Ar 2               ; (FACEXTENSION pushed last so it's pulled first by PullArg.)
00177Ar 2               ; Preserves the return address.
00177Ar 2               ; ---------------------------------------------------------------------------
00177Ar 2               PushFac:
00177Ar 2  68                   pla
00177Br 2  A8                   tay                             ; Y = ret-addr lo
00177Cr 2  68                   pla
00177Dr 2  AA                   tax                             ; X = ret-addr hi
00177Er 2  A5 64                lda     VALTYP
001780r 2  48                   pha
001781r 2  A5 0E                lda     FAC
001783r 2  48                   pha
001784r 2  A5 0F                lda     FAC+1
001786r 2  48                   pha
001787r 2  A5 10                lda     FAC+2
001789r 2  48                   pha
00178Ar 2  A5 11                lda     FAC+3
00178Cr 2  48                   pha
00178Dr 2  A5 12                lda     FAC+4
00178Fr 2  48                   pha
001790r 2  A5 13                lda     FACSIGN
001792r 2  48                   pha
001793r 2  A5 1D                lda     FACEXTENSION
001795r 2  48                   pha
001796r 2  8A                   txa
001797r 2  48                   pha
001798r 2  98                   tya
001799r 2  48                   pha
00179Ar 2  60                   rts
00179Br 2               
00179Br 2               ; ---------------------------------------------------------------------------
00179Br 2               ; PullArg -- pop the previously-pushed FAC into ARG (signed FP value or
00179Br 2               ; string descriptor in ARG..ARG+2/sign).  Sets BAS_LVTYP to the saved
00179Br 2               ; left-operand VALTYP.  Preserves return address.
00179Br 2               ; ---------------------------------------------------------------------------
00179Br 2               PullArg:
00179Br 2  68                   pla
00179Cr 2  A8                   tay                             ; Y = ret-addr lo
00179Dr 2  68                   pla
00179Er 2  AA                   tax                             ; X = ret-addr hi
00179Fr 2  68                   pla
0017A0r 2  85 43                sta     ARGEXTENSION
0017A2r 2  68                   pla
0017A3r 2  85 1B                sta     ARGSIGN
0017A5r 2  68                   pla
0017A6r 2  85 1A                sta     ARG+4
0017A8r 2  68                   pla
0017A9r 2  85 19                sta     ARG+3
0017ABr 2  68                   pla
0017ACr 2  85 18                sta     ARG+2
0017AEr 2  68                   pla
0017AFr 2  85 17                sta     ARG+1
0017B1r 2  68                   pla
0017B2r 2  85 16                sta     ARG
0017B4r 2  68                   pla
0017B5r 2  85 86                sta     BAS_LVTYP
0017B7r 2  8A                   txa
0017B8r 2  48                   pha
0017B9r 2  98                   tya
0017BAr 2  48                   pha
0017BBr 2  60                   rts
0017BCr 2               
0017BCr 2               ; ---------------------------------------------------------------------------
0017BCr 2               ; PullFac -- pop pushed FAC back into FAC (used to discard right side and
0017BCr 2               ; restore left, e.g. unused).
0017BCr 2               ; ---------------------------------------------------------------------------
0017BCr 2               PullFac:
0017BCr 2  68                   pla
0017BDr 2  A8                   tay
0017BEr 2  68                   pla
0017BFr 2  AA                   tax
0017C0r 2  68                   pla
0017C1r 2  85 1D                sta     FACEXTENSION
0017C3r 2  68                   pla
0017C4r 2  85 13                sta     FACSIGN
0017C6r 2  68                   pla
0017C7r 2  85 12                sta     FAC+4
0017C9r 2  68                   pla
0017CAr 2  85 11                sta     FAC+3
0017CCr 2  68                   pla
0017CDr 2  85 10                sta     FAC+2
0017CFr 2  68                   pla
0017D0r 2  85 0F                sta     FAC+1
0017D2r 2  68                   pla
0017D3r 2  85 0E                sta     FAC
0017D5r 2  68                   pla
0017D6r 2  85 64                sta     VALTYP
0017D8r 2  8A                   txa
0017D9r 2  48                   pha
0017DAr 2  98                   tya
0017DBr 2  48                   pha
0017DCr 2  60                   rts
0017DDr 2               
0017DDr 2               ; ---------------------------------------------------------------------------
0017DDr 2               ; TypeMismatch helper.
0017DDr 2               ; ---------------------------------------------------------------------------
0017DDr 2               EvalTypeErr:
0017DDr 2  A2 08                ldx     #ERR_TYPEMISM
0017DFr 2  4C rr rr             jmp     BasErrorVec
0017E2r 2               
0017E2r 2               ; ===========================================================================
0017E2r 2               ;   L E V E L 0  --  O R
0017E2r 2               ; ===========================================================================
0017E2r 2               EvalOr:
0017E2r 2  20 rr rr             jsr     EvalAnd
0017E5r 2               @loop:
0017E5r 2  20 rr rr             jsr     ChrGot
0017E8r 2  C9 A3                cmp     #TOK_OR
0017EAr 2  D0 17                bne     @done
0017ECr 2  20 rr rr             jsr     ChkNum                  ; left must be numeric
0017EFr 2  20 rr rr             jsr     ChrGet                  ; consume OR
0017F2r 2  20 rr rr             jsr     PushFac
0017F5r 2  20 rr rr             jsr     EvalAnd
0017F8r 2  20 rr rr             jsr     ChkNum                  ; right must be numeric
0017FBr 2  20 rr rr             jsr     PullArg
0017FEr 2  20 rr rr             jsr     OrOp
001801r 2  80 E2                bra     @loop
001803r 2               @done:
001803r 2  60                   rts
001804r 2               
001804r 2               ; ===========================================================================
001804r 2               ;   L E V E L 1  --  A N D
001804r 2               ; ===========================================================================
001804r 2               EvalAnd:
001804r 2  20 rr rr             jsr     EvalNot
001807r 2               @loop:
001807r 2  20 rr rr             jsr     ChrGot
00180Ar 2  C9 A2                cmp     #TOK_AND
00180Cr 2  D0 17                bne     @done
00180Er 2  20 rr rr             jsr     ChkNum
001811r 2  20 rr rr             jsr     ChrGet
001814r 2  20 rr rr             jsr     PushFac
001817r 2  20 rr rr             jsr     EvalNot
00181Ar 2  20 rr rr             jsr     ChkNum
00181Dr 2  20 rr rr             jsr     PullArg
001820r 2  20 rr rr             jsr     AndOp
001823r 2  80 E2                bra     @loop
001825r 2               @done:
001825r 2  60                   rts
001826r 2               
001826r 2               ; ===========================================================================
001826r 2               ;   L E V E L 2  --  N O T   (right-assoc unary prefix)
001826r 2               ; ===========================================================================
001826r 2               EvalNot:
001826r 2  20 rr rr             jsr     ChrGot
001829r 2  C9 A0                cmp     #TOK_NOT
00182Br 2  D0 0C                bne     EvalCmp
00182Dr 2  20 rr rr             jsr     ChrGet
001830r 2  20 rr rr             jsr     EvalNot
001833r 2  20 rr rr             jsr     ChkNum
001836r 2  4C rr rr             jmp     NotOp
001839r 2               
001839r 2               ; ===========================================================================
001839r 2               ;   L E V E L 3  --  C O M P A R I S O N
001839r 2               ;   Reads up to two of {<, =, >} forming a relop; if none, no-op.
001839r 2               ;   Mask:  bit 0 = '>' present, bit 1 = '=' present, bit 2 = '<' present
001839r 2               ; ===========================================================================
001839r 2               EvalCmp:
001839r 2  20 rr rr             jsr     EvalAdd
00183Cr 2  A2 00                ldx     #0                      ; relop mask
00183Er 2               @scan:
00183Er 2  20 rr rr             jsr     ChrGot
001841r 2  C9 3D                cmp     #'='
001843r 2  F0 0A                beq     @gotEq
001845r 2  C9 3C                cmp     #'<'
001847r 2  F0 0A                beq     @gotLt
001849r 2  C9 3E                cmp     #'>'
00184Br 2  F0 0A                beq     @gotGt
00184Dr 2  80 1D                bra     @done
00184Fr 2               @gotEq:
00184Fr 2  A0 02                ldy     #2
001851r 2  80 06                bra     @setbit
001853r 2               @gotLt:
001853r 2  A0 04                ldy     #4
001855r 2  80 02                bra     @setbit
001857r 2               @gotGt:
001857r 2  A0 01                ldy     #1
001859r 2               @setbit:
001859r 2  84 45                sty     CPRMASK                 ; reuse as scratch
00185Br 2  8A                   txa
00185Cr 2  25 45                and     CPRMASK
00185Er 2  D0 09                bne     @synErr                 ; same char twice (e.g. "==")
001860r 2  8A                   txa
001861r 2  05 45                ora     CPRMASK
001863r 2  AA                   tax
001864r 2  20 rr rr             jsr     ChrGet
001867r 2  80 D5                bra     @scan
001869r 2               @synErr:
001869r 2  4C rr rr             jmp     SynErr
00186Cr 2               @done:
00186Cr 2  E0 00                cpx     #0
00186Er 2  D0 01                bne     @doCmp
001870r 2  60                   rts
001871r 2               @doCmp:
001871r 2  86 45                stx     CPRMASK
001873r 2                       ; Save left operand, evaluate right
001873r 2  20 rr rr             jsr     PushFac
001876r 2  20 rr rr             jsr     EvalAdd
001879r 2  20 rr rr             jsr     PullArg                 ; ARG = left, BAS_LVTYP = left's type
00187Cr 2                       ; Type compatibility check.
00187Cr 2  A5 86                lda     BAS_LVTYP
00187Er 2  45 64                eor     VALTYP
001880r 2  10 03 4C rr          jmi     EvalTypeErr             ; one numeric, one string -> mismatch
001884r 2  rr           
001885r 2  24 64                bit     VALTYP
001887r 2  30 03                bmi     @strCmp
001889r 2                       ; Numeric comparison.
001889r 2  4C rr rr             jmp     RelOpsNum
00188Cr 2               @strCmp:
00188Cr 2  4C rr rr             jmp     RelOpsStr
00188Fr 2               
00188Fr 2               ; ---------------------------------------------------------------------------
00188Fr 2               ; RelOpsNum -- numeric comparison.
00188Fr 2               ; Inputs: ARG = left, FAC = right, CPRMASK = relop mask (bit 0=>, 1==, 2=<).
00188Fr 2               ; Output: FAC = -1 if (ARG <op> FAC) is true, else 0.  VALTYP = numeric.
00188Fr 2               ; ---------------------------------------------------------------------------
00188Fr 2               RelOpsNum:
00188Fr 2                       ; Replicate msbasic ARG-pre-relop fixup: clear ARG+1 high bit, then
00188Fr 2                       ; set it from ARGSIGN's MSB.  This rebuilds the implicit-1 mantissa
00188Fr 2                       ; for FCOMP's signed comparison path.
00188Fr 2  A5 1B                lda     ARGSIGN
001891r 2  09 7F                ora     #$7F
001893r 2  25 17                and     ARG+1
001895r 2  85 17                sta     ARG+1
001897r 2  A9 16                lda     #<ARG
001899r 2  A0 00                ldy     #$00
00189Br 2  20 rr rr             jsr     FComp                   ; A = sign(FAC - ARG)
00189Er 2                       ; Map A to bit position:
00189Er 2                       ;   FAC<ARG (A=$FF): ARG>FAC  -> bit 0 (mask 1)
00189Er 2                       ;   FAC=ARG (A=$00):           -> bit 1 (mask 2)
00189Er 2                       ;   FAC>ARG (A=$01): ARG<FAC  -> bit 2 (mask 4)
00189Er 2  AA                   tax
00189Fr 2  30 06                bmi     @lt
0018A1r 2  F0 08                beq     @eq
0018A3r 2  A9 04                lda     #4
0018A5r 2  80 06                bra     @check
0018A7r 2               @lt:
0018A7r 2  A9 01                lda     #1
0018A9r 2  80 02                bra     @check
0018ABr 2               @eq:
0018ABr 2  A9 02                lda     #2
0018ADr 2               @check:
0018ADr 2  25 45                and     CPRMASK
0018AFr 2  F0 07                beq     @false
0018B1r 2  A9 FF                lda     #$FF
0018B3r 2  A0 FF                ldy     #$FF
0018B5r 2  4C rr rr             jmp     GivAyf
0018B8r 2               @false:
0018B8r 2  A9 00                lda     #0
0018BAr 2  A8                   tay
0018BBr 2  4C rr rr             jmp     GivAyf
0018BEr 2               
0018BEr 2               ; ---------------------------------------------------------------------------
0018BEr 2               ; RelOpsStr -- bytewise string comparison.
0018BEr 2               ; ARG = left descriptor (ARG=len, ARG+1=lo, ARG+2=hi, ARGSIGN, ARGEXT pushed).
0018BEr 2               ; FAC = right descriptor.  CPRMASK as above.
0018BEr 2               ; ---------------------------------------------------------------------------
0018BEr 2               RelOpsStr:
0018BEr 2                       ; INDEX = left ptr, BAS_TMP1 = right ptr, BAS_TMP2 lo = left len,
0018BEr 2                       ; BAS_TMP2 hi = right len.
0018BEr 2  A5 17                lda     ARG+1
0018C0r 2  85 20                sta     INDEX
0018C2r 2  A5 18                lda     ARG+2
0018C4r 2  85 21                sta     INDEX+1
0018C6r 2  A5 0F                lda     FAC+1
0018C8r 2  85 3A                sta     BAS_TMP1
0018CAr 2  A5 10                lda     FAC+2
0018CCr 2  85 3B                sta     BAS_TMP1+1
0018CEr 2  A5 16                lda     ARG
0018D0r 2  85 3C                sta     BAS_TMP2                ; left len
0018D2r 2  A5 0E                lda     FAC
0018D4r 2  85 3D                sta     BAS_TMP2+1              ; right len
0018D6r 2                       ; Compare byte-by-byte up to min length.
0018D6r 2  A0 00                ldy     #0
0018D8r 2               @cmp:
0018D8r 2                       ; Has either side ended?
0018D8r 2  C4 3C                cpy     BAS_TMP2
0018DAr 2  F0 17                beq     @leftEnd
0018DCr 2  C4 3D                cpy     BAS_TMP2+1
0018DEr 2  F0 1B                beq     @rightEnd               ; right ended first -> left > right
0018E0r 2  B1 20                lda     (INDEX),y
0018E2r 2  D1 3A                cmp     (BAS_TMP1),y
0018E4r 2  F0 0A                beq     @next
0018E6r 2  90 04                bcc     @lt                     ; left < right
0018E8r 2                       ; left > right
0018E8r 2  A9 01                lda     #1
0018EAr 2  80 15                bra     @decide
0018ECr 2               @lt:
0018ECr 2  A9 04                lda     #4
0018EEr 2  80 11                bra     @decide
0018F0r 2               @next:
0018F0r 2  C8                   iny
0018F1r 2  80 E5                bra     @cmp
0018F3r 2               @leftEnd:
0018F3r 2                       ; Left ran out; check right
0018F3r 2  C4 3D                cpy     BAS_TMP2+1
0018F5r 2  F0 08                beq     @equal
0018F7r 2                       ; left < right (left is prefix)
0018F7r 2  A9 04                lda     #4
0018F9r 2  80 06                bra     @decide
0018FBr 2               @rightEnd:
0018FBr 2                       ; right ran out, left has more; left > right
0018FBr 2  A9 01                lda     #1
0018FDr 2  80 02                bra     @decide
0018FFr 2               @equal:
0018FFr 2  A9 02                lda     #2
001901r 2               @decide:
001901r 2  25 45                and     CPRMASK
001903r 2  F0 05                beq     @false
001905r 2  A9 FF                lda     #$FF
001907r 2  A8                   tay
001908r 2  80 03                bra     @ret
00190Ar 2               @false:
00190Ar 2  A9 00                lda     #0
00190Cr 2  A8                   tay
00190Dr 2               @ret:
00190Dr 2                       ; Free temp strings before returning.  Save A,Y first.
00190Dr 2  48                   pha
00190Er 2  5A                   phy
00190Fr 2                       ; Free FAC's temp string (right operand).
00190Fr 2  24 64                bit     VALTYP
001911r 2  10 03                bpl     @noFreeR
001913r 2  20 rr rr             jsr     FreFac
001916r 2               @noFreeR:
001916r 2                       ; Free ARG's temp string (left operand): manually restore VALTYP=$FF
001916r 2                       ; and FAC := ARG, then FreFac.  (We don't always know if ARG is a
001916r 2                       ; temp; FreTms inside FreTmp checks.)
001916r 2  A5 16                lda     ARG
001918r 2  85 0E                sta     FAC
00191Ar 2  A5 17                lda     ARG+1
00191Cr 2  85 0F                sta     FAC+1
00191Er 2  A5 18                lda     ARG+2
001920r 2  85 10                sta     FAC+2
001922r 2  A9 FF                lda     #$FF
001924r 2  85 64                sta     VALTYP
001926r 2  20 rr rr             jsr     FreFac
001929r 2  7A                   ply
00192Ar 2  68                   pla
00192Br 2  4C rr rr             jmp     GivAyf
00192Er 2               
00192Er 2               ; ===========================================================================
00192Er 2               ;   L E V E L 4  --  + / -
00192Er 2               ; ===========================================================================
00192Er 2               EvalAdd:
00192Er 2  20 rr rr             jsr     EvalMul
001931r 2               @loop:
001931r 2  20 rr rr             jsr     ChrGot
001934r 2  C9 2B                cmp     #'+'
001936r 2  F0 05                beq     @plus
001938r 2  C9 2D                cmp     #'-'
00193Ar 2  F0 27                beq     @minus
00193Cr 2  60                   rts
00193Dr 2               @plus:
00193Dr 2  20 rr rr             jsr     ChrGet
001940r 2  20 rr rr             jsr     PushFac
001943r 2  20 rr rr             jsr     EvalMul
001946r 2  20 rr rr             jsr     PullArg
001949r 2                       ; Type dispatch.
001949r 2  A5 86                lda     BAS_LVTYP
00194Br 2  45 64                eor     VALTYP
00194Dr 2  10 03 4C rr          jmi     EvalTypeErr
001951r 2  rr           
001952r 2  24 64                bit     VALTYP
001954r 2  30 28                bmi     @cat
001956r 2                       ; numeric add: FAC = ARG + FAC
001956r 2                       ; FAddT expects: ARG is the operand, A=FAC's exponent on entry.
001956r 2                       ; Use entry "FAddT" preceded by sign work: msbasic does
001956r 2                       ;   bne <continue>; jmp CopyArgToFac
001956r 2                       ; But our FAddT entry already handles that.  We need to set
001956r 2                       ; SGNCPR = ARGSIGN ^ FACSIGN before FAddT.
001956r 2  A5 1B                lda     ARGSIGN
001958r 2  45 13                eor     FACSIGN
00195Ar 2  85 1C                sta     SGNCPR
00195Cr 2  A5 0E                lda     FAC
00195Er 2  20 rr rr             jsr     FAddT
001961r 2  80 CE                bra     @loop
001963r 2               @minus:
001963r 2  20 rr rr             jsr     ChrGet
001966r 2  20 rr rr             jsr     PushFac
001969r 2  20 rr rr             jsr     EvalMul
00196Cr 2  20 rr rr             jsr     ChkNum
00196Fr 2                       ; left was pushed; check pushed type via TOS-byte? Easier: we already
00196Fr 2                       ; verified left is numeric on first iteration.  But left might have
00196Fr 2                       ; been a string from concatenation; require numeric here:
00196Fr 2  20 rr rr             jsr     PullArg
001972r 2  A5 86                lda     BAS_LVTYP
001974r 2  10 03 4C rr          jmi     EvalTypeErr
001978r 2  rr           
001979r 2                       ; FAC = ARG - FAC
001979r 2                       ; FSubT does: FACSIGN ^= $FF; SGNCPR = FACSIGN^ARGSIGN; jmp FAddT
001979r 2                       ; We need to call FSubT directly.
001979r 2  20 rr rr             jsr     FSubT
