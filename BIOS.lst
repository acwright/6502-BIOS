000000r 1               
000000r 1               .segment "KERNAL"
000000r 1               .include "Kernal.asm"
000000r 2               ; ***             ***
000000r 2               ; ***   KERNAL    ***
000000r 2               ; ***             ***
000000r 2               
000000r 2               ; === Kernal Jump Table ($A000-$A0FF) ===
000000r 2               ; 85 slots of 3-byte JMP instructions plus 1 padding byte
000000r 2               ; Provides stable entry points for external code and cartridges
000000r 2               
000000r 2               ; --- Character I/O ---
000000r 2  4C rr rr     Chrout:         jmp ChroutDispatch      ; $A000 - Output char (dispatched by IO_MODE)
000003r 2  4C rr rr     Chrin:          jmp ChrinImpl           ; $A003 - Input char from buffer
000006r 2  4C rr rr     WriteBuffer:    jmp WriteBufferImpl     ; $A006 - Write byte to input buffer
000009r 2  4C rr rr     ReadBuffer:     jmp ReadBufferImpl      ; $A009 - Read byte from input buffer
00000Cr 2  4C rr rr     BufferSize:     jmp BufferSizeImpl      ; $A00C - Get buffer count
00000Fr 2               ; --- IO Mode ---
00000Fr 2  4C rr rr     SetIOMode:      jmp SetIOModeImpl       ; $A00F - Set IO_MODE
000012r 2  4C rr rr     GetIOMode:      jmp GetIOModeImpl       ; $A012 - Get IO_MODE
000015r 2               ; --- Video (TMS9918) ---
000015r 2  4C rr rr     InitVideo:      jmp InitVideoImpl       ; $A015 - Initialize TMS9918 (mode registers + character set)
000018r 2  4C rr rr     VideoClear:     jmp VideoClearImpl      ; $A018 - Clear video screen
00001Br 2  4C rr rr     VideoPutChar:   jmp VideoPutCharImpl    ; $A01B - Write char at cursor
00001Er 2  4C rr rr     VideoSetCursor: jmp VideoSetCursorImpl  ; $A01E - Set cursor (X=col, Y=row)
000021r 2  4C rr rr     VideoGetCursor: jmp VideoGetCursorImpl  ; $A021 - Get cursor position
000024r 2  4C rr rr     VideoScroll:    jmp VideoScrollImpl     ; $A024 - Scroll screen up one line
000027r 2  4C rr rr     VideoSetColor:  jmp VideoSetColorImpl   ; $A027 - Set TMS9918 text color (A=reg7 byte: hi=fg, lo=bg)
00002Ar 2  4C rr rr     VideoChroutRaw: jmp VideoChroutRawImpl  ; $A02A - Output char to video (raw, no control-code handling)
00002Dr 2               ; --- Sound (SID) ---
00002Dr 2  4C rr rr     InitSID:        jmp InitSIDImpl         ; $A02D - Initialize SID
000030r 2  4C rr rr     Beep:           jmp BeepImpl            ; $A030 - Play beep tone
000033r 2  4C rr rr     SidPlayNote:    jmp SidPlayNoteImpl     ; $A033 - Play note (A=voice, X=freqLo, Y=freqHi)
000036r 2  4C rr rr     SidSilence:     jmp SidSilenceImpl      ; $A036 - Silence all voices
000039r 2  4C rr rr     SidSetVolume:   jmp SidSetVolumeImpl    ; $A039 - Set SID master volume (A=0-15)
00003Cr 2               ; --- Filesystem ---
00003Cr 2  4C rr rr     FsLoadFile:     jmp FsLoadFileImpl      ; $A03C - Load file from CF
00003Fr 2  4C rr rr     FsSaveFile:     jmp FsSaveFileImpl      ; $A03F - Save file to CF
000042r 2  4C rr rr     FsDeleteFile:   jmp FsDeleteFileImpl    ; $A042 - Delete file from CF
000045r 2               ; --- Keyboard / GPIO ---
000045r 2  4C rr rr     InitKB:         jmp InitKBImpl          ; $A045 - Initialize GPIO/VIA keyboard
000048r 2  4C rr rr     ReadJoystick1:  jmp ReadJoystick1Impl   ; $A048 - Read joystick 1
00004Br 2  4C rr rr     ReadJoystick2:  jmp ReadJoystick2Impl   ; $A04B - Read joystick 2
00004Er 2               ; --- Serial (6551) ---
00004Er 2  4C rr rr     InitSC:         jmp InitSCImpl          ; $A04E - Initialize serial 6551
000051r 2  4C rr rr     SerialChrout:   jmp SerialChroutImpl    ; $A051 - Direct serial output (bypass IO_MODE)
000054r 2  4C rr rr     XModemLoad:     jmp XModemLoadImpl      ; $A054 - Receive binary via XModem
000057r 2  4C rr rr     XModemSave:     jmp XModemSaveImpl      ; $A057 - Send binary via XModem
00005Ar 2               ; --- RTC (DS1511Y) ---
00005Ar 2  4C rr rr     RtcReadTime:    jmp RtcReadTimeImpl     ; $A05A - Read RTC time
00005Dr 2  4C rr rr     RtcReadDate:    jmp RtcReadDateImpl     ; $A05D - Read RTC date
000060r 2  4C rr rr     RtcWriteTime:   jmp RtcWriteTimeImpl    ; $A060 - Set RTC time
000063r 2  4C rr rr     RtcWriteDate:   jmp RtcWriteDateImpl    ; $A063 - Set RTC date
000066r 2  4C rr rr     RtcReadNVRAM:   jmp RtcReadNVRAMImpl    ; $A066 - Read NVRAM byte
000069r 2  4C rr rr     RtcWriteNVRAM:  jmp RtcWriteNVRAMImpl   ; $A069 - Write NVRAM byte
00006Cr 2               ; --- CompactFlash Storage ---
00006Cr 2  4C rr rr     StReadSector:   jmp StReadSectorImpl    ; $A06C - Read CF sector
00006Fr 2  4C rr rr     StWriteSector:  jmp StWriteSectorImpl   ; $A06F - Write CF sector
000072r 2  4C rr rr     StWaitReady:    jmp StWaitReadyImpl     ; $A072 - Wait CF ready
000075r 2               ; --- System ---
000075r 2  4C rr rr     SysDelay:       jmp SysDelayImpl        ; $A075 - Delay A=cnt_lo, X=cnt_hi centiseconds
000078r 2  4C rr rr     KernalInit:     jmp KernalInitImpl      ; $A078 - Initialize all hardware (caller must reset SP; no cli, no splash); rts when done
00007Br 2  4C rr rr     KernalVersion:  jmp KernalVersionImpl   ; $A07B - Get BIOS version (A=major, X=minor)
00007Er 2               ; --- Disk banking / addressed storage ---
00007Er 2  4C rr rr     FsLoadFileAddr: jmp FsLoadFileAddrImpl  ; $A07E - Load named file to FS_IO_ADDR
000081r 2  4C rr rr     FsSaveFileAddr: jmp FsSaveFileAddrImpl  ; $A081 - Save FS_FILE_SIZE bytes from FS_IO_ADDR to named file
000084r 2  4C rr rr     FsFormatDisk:   jmp FsFormatDiskImpl    ; $A084 - Zero the current disk's directory sector
000087r 2  4C rr rr     FsSetDisk:      jmp FsSetDiskImpl       ; $A087 - Select current CF disk (A=0-255)
00008Ar 2  4C rr rr     FsGetDisk:      jmp FsGetDiskImpl       ; $A08A - Get current CF disk (A=disk)
00008Dr 2  4C rr rr     FsPrintDisk:    jmp FsPrintDiskImpl     ; $A08D - Print "DISK n" + CRLF via Chrout
000090r 2               ; --- General output utilities (console = IO_MODE-routed via Chrout) ---
000090r 2  4C rr rr     PrintStr:       jmp PrintStrImpl        ; $A090 - Print NUL-terminated string (A=lo, Y=hi); clobbers A,Y,STR_PTR
000093r 2  4C rr rr     PrintCRLF:      jmp PrintCRLFImpl       ; $A093 - Print CR+LF
000096r 2  4C rr rr     PrintDecU16:    jmp PrintDecU16Impl     ; $A096 - Print unsigned 16-bit decimal (A=lo, X=hi), no leading zeros
000099r 2               
000099r 2               ; Reserved entries ($A099-$A0FE)
000099r 2  4C rr rr 4C  .repeat 34
00009Dr 2  rr rr 4C rr  
0000A1r 2  rr 4C rr rr  
0000FFr 2                               jmp UnimplementedStub
0000FFr 2               .endrepeat
0000FFr 2  00           .byte $00                             ; Pad to 256 bytes ($A0FF)
000100r 2               
000100r 2               ; === Kernal Implementation ===
000100r 2               
000100r 2               ; Stub for unimplemented jump table entries
000100r 2               UnimplementedStub:
000100r 2  60             rts
000101r 2               
000101r 2               ; Chrout dispatcher — routes output based on IO_MODE
000101r 2               ; Input: A = character to output
000101r 2               ; Modifies: Flags
000101r 2               ChroutDispatch:
000101r 2  48             pha
000102r 2  AD 06 03       lda IO_MODE
000105r 2  29 01          and #$01                      ; Bit 0: 0=video, 1=serial
000107r 2  D0 04          bne @Serial
000109r 2  68             pla
00010Ar 2  4C rr rr       jmp VideoChroutImpl
00010Dr 2               @Serial:
00010Dr 2  68             pla
00010Er 2  4C rr rr       jmp SerialChroutImpl
000111r 2               
000111r 2               ; Set IO_MODE
000111r 2               ; Input: A = mode (bit 0: 0=video, 1=serial)
000111r 2               SetIOModeImpl:
000111r 2  8D 06 03       sta IO_MODE
000114r 2  60             rts
000115r 2               
000115r 2               ; Get IO_MODE
000115r 2               ; Output: A = current IO_MODE
000115r 2               GetIOModeImpl:
000115r 2  AD 06 03       lda IO_MODE
000118r 2  60             rts
000119r 2               
000119r 2               ; === TMS9918 Video Driver ===
000119r 2               
000119r 2               ; VideoClear — Fill name table (960 bytes at VRAM $0000) with spaces, reset cursor to (0,0)
000119r 2               ; Modifies: Flags, A, X, Y
000119r 2               VideoClearImpl:
000119r 2                 ; Set VRAM write address to $0000 (name table base)
000119r 2  A9 00          lda #$00
00011Br 2  8D 01 9C       sta VC_REG
00011Er 2  A9 40          lda #$40                      ; High byte $00 OR $40 for write mode
000120r 2  8D 01 9C       sta VC_REG
000123r 2                 ; Fill 960 bytes with space ($20) — 3 full pages + 192 bytes
000123r 2  A9 20          lda #$20
000125r 2  A0 00          ldy #$00
000127r 2  A2 03          ldx #$03                      ; 3 full pages (768 bytes)
000129r 2               @VideoClearPage:
000129r 2  8D 00 9C       sta VC_DATA
00012Cr 2  C8             iny
00012Dr 2  D0 FA          bne @VideoClearPage
00012Fr 2  CA             dex
000130r 2  D0 F7          bne @VideoClearPage
000132r 2                 ; Remaining 192 bytes (960 - 768)
000132r 2  A0 C0          ldy #192
000134r 2               @VideoClearRem:
000134r 2  8D 00 9C       sta VC_DATA
000137r 2  88             dey
000138r 2  D0 FA          bne @VideoClearRem
00013Ar 2                 ; Reset cursor to (0,0)
00013Ar 2  9C 07 03       stz VID_CURSOR_X
00013Dr 2  9C 08 03       stz VID_CURSOR_Y
000140r 2  9C 09 03       stz VID_CURSOR_ADDR
000143r 2  9C 0A 03       stz VID_CURSOR_ADDR + 1
000146r 2  60             rts
000147r 2               
000147r 2               ; VideoSetCursor — Set cursor position
000147r 2               ; Input: X = column (0-39), Y = row (0-23)
000147r 2               ; Calculates VRAM address = Y * 40 + X and stores in VID_CURSOR_ADDR
000147r 2               ; Modifies: Flags, A
000147r 2               VideoSetCursorImpl:
000147r 2  8E 07 03       stx VID_CURSOR_X
00014Ar 2  8C 08 03       sty VID_CURSOR_Y
00014Dr 2                 ; Calculate VRAM address = Y * 40 + X
00014Dr 2                 ; Y * 40 = Y * 32 + Y * 8
00014Dr 2  A9 00          lda #$00
00014Fr 2  8D 0A 03       sta VID_CURSOR_ADDR + 1       ; Clear high byte
000152r 2  98             tya                           ; A = row
000153r 2                 ; Multiply by 8: shift left 3
000153r 2  0A             asl a
000154r 2  2E 0A 03       rol VID_CURSOR_ADDR + 1
000157r 2  0A             asl a
000158r 2  2E 0A 03       rol VID_CURSOR_ADDR + 1
00015Br 2  0A             asl a
00015Cr 2  2E 0A 03       rol VID_CURSOR_ADDR + 1
00015Fr 2  8D 09 03       sta VID_CURSOR_ADDR           ; Store Y*8 low byte
000162r 2                 ; Save Y*8 for later addition
000162r 2  48             pha
000163r 2  AD 0A 03       lda VID_CURSOR_ADDR + 1
000166r 2  48             pha
000167r 2                 ; Multiply original row by 32: shift left 5 total (Y*8 << 2)
000167r 2  AD 09 03       lda VID_CURSOR_ADDR
00016Ar 2  0A             asl a
00016Br 2  2E 0A 03       rol VID_CURSOR_ADDR + 1
00016Er 2  0A             asl a
00016Fr 2  2E 0A 03       rol VID_CURSOR_ADDR + 1
000172r 2  8D 09 03       sta VID_CURSOR_ADDR           ; Now holds Y*32 low byte
000175r 2                 ; Add Y*8 + Y*32
000175r 2  68             pla                           ; Restore Y*8 high byte
000176r 2  6D 0A 03       adc VID_CURSOR_ADDR + 1       ; Carry still valid from last rol
000179r 2  8D 0A 03       sta VID_CURSOR_ADDR + 1
00017Cr 2  68             pla                           ; Restore Y*8 low byte
00017Dr 2  18             clc
00017Er 2  6D 09 03       adc VID_CURSOR_ADDR
000181r 2  8D 09 03       sta VID_CURSOR_ADDR
000184r 2  90 03          bcc @NoCarry
000186r 2  EE 0A 03       inc VID_CURSOR_ADDR + 1
000189r 2               @NoCarry:
000189r 2                 ; Add X (column)
000189r 2  8A             txa
00018Ar 2  18             clc
00018Br 2  6D 09 03       adc VID_CURSOR_ADDR
00018Er 2  8D 09 03       sta VID_CURSOR_ADDR
000191r 2  90 03          bcc @SetCursorDone
000193r 2  EE 0A 03       inc VID_CURSOR_ADDR + 1
000196r 2               @SetCursorDone:
000196r 2  60             rts
000197r 2               
000197r 2               ; VideoGetCursor — Get cursor position
000197r 2               ; Output: X = column (0-39), Y = row (0-23)
000197r 2               ; Modifies: Flags
000197r 2               VideoGetCursorImpl:
000197r 2  AE 07 03       ldx VID_CURSOR_X
00019Ar 2  AC 08 03       ldy VID_CURSOR_Y
00019Dr 2  60             rts
00019Er 2               
00019Er 2               ; VideoPutChar — Write a single character to VRAM at VID_CURSOR_ADDR
00019Er 2               ; Input: A = character to write
00019Er 2               ; Modifies: Flags
00019Er 2               VideoPutCharImpl:
00019Er 2  48             pha
00019Fr 2                 ; Set VRAM write address from VID_CURSOR_ADDR
00019Fr 2  AD 09 03       lda VID_CURSOR_ADDR
0001A2r 2  8D 01 9C       sta VC_REG                    ; Low byte of address
0001A5r 2  AD 0A 03       lda VID_CURSOR_ADDR + 1
0001A8r 2  09 40          ora #$40                      ; Set bit 6 for write mode
0001AAr 2  8D 01 9C       sta VC_REG                    ; High byte with write flag
0001ADr 2  68             pla
0001AEr 2  8D 00 9C       sta VC_DATA                   ; Write character to VRAM
0001B1r 2  60             rts
0001B2r 2               
0001B2r 2               ; VideoScroll — Scroll screen up one line
0001B2r 2               ; Copies VRAM rows 1-23 to rows 0-22 (920 bytes), clears row 23 with spaces
0001B2r 2               ; Uses SCROLL_BUF ($0320, 40 bytes) as temporary storage
0001B2r 2               ; Modifies: Flags, A, X, Y
0001B2r 2               VideoScrollImpl:
0001B2r 2                 ; Save STR_PTR (may be in use by caller, e.g. VideoPrintStr)
0001B2r 2  A5 02          lda STR_PTR
0001B4r 2  48             pha
0001B5r 2  A5 03          lda STR_PTR + 1
0001B7r 2  48             pha
0001B8r 2                 ; Source starts at row 1 (VRAM offset 40=$28), dest at row 0 (offset 0)
0001B8r 2                 ; We process 23 rows, copying each row up by one
0001B8r 2  A9 28          lda #<40                      ; Source address low = 40 (row 1)
0001BAr 2  85 02          sta STR_PTR
0001BCr 2  A9 00          lda #>40
0001BEr 2  85 03          sta STR_PTR + 1
0001C0r 2               
0001C0r 2  A2 17          ldx #23                       ; 23 rows to copy
0001C2r 2               @ScrollRowLoop:
0001C2r 2  DA             phx                           ; Save row counter
0001C3r 2               
0001C3r 2                 ; Set VRAM read address (source row)
0001C3r 2  A5 02          lda STR_PTR
0001C5r 2  8D 01 9C       sta VC_REG
0001C8r 2  A5 03          lda STR_PTR + 1
0001CAr 2  8D 01 9C       sta VC_REG                    ; Bit 6 clear = read mode
0001CDr 2                 ; Read 40 bytes into SCROLL_BUF
0001CDr 2  A0 00          ldy #$00
0001CFr 2               @ScrollRead:
0001CFr 2  AD 00 9C       lda VC_DATA
0001D2r 2  99 20 03       sta SCROLL_BUF,y
0001D5r 2  C8             iny
0001D6r 2  C0 28          cpy #40
0001D8r 2  D0 F5          bne @ScrollRead
0001DAr 2               
0001DAr 2                 ; Set VRAM write address (dest = source - 40)
0001DAr 2  A5 02          lda STR_PTR
0001DCr 2  38             sec
0001DDr 2  E9 28          sbc #40
0001DFr 2  8D 01 9C       sta VC_REG                    ; Dest address low
0001E2r 2  A5 03          lda STR_PTR + 1
0001E4r 2  E9 00          sbc #$00
0001E6r 2  09 40          ora #$40                      ; Set bit 6 for write mode
0001E8r 2  8D 01 9C       sta VC_REG                    ; Dest address high
0001EBr 2               
0001EBr 2                 ; Write 40 bytes from SCROLL_BUF
0001EBr 2  A0 00          ldy #$00
0001EDr 2               @ScrollWrite:
0001EDr 2  B9 20 03       lda SCROLL_BUF,y
0001F0r 2  8D 00 9C       sta VC_DATA
0001F3r 2  C8             iny
0001F4r 2  C0 28          cpy #40
0001F6r 2  D0 F5          bne @ScrollWrite
0001F8r 2               
0001F8r 2                 ; Advance source pointer by 40 for next row
0001F8r 2  A5 02          lda STR_PTR
0001FAr 2  18             clc
0001FBr 2  69 28          adc #40
0001FDr 2  85 02          sta STR_PTR
0001FFr 2  90 02          bcc @ScrollNoCarry
000201r 2  E6 03          inc STR_PTR + 1
000203r 2               @ScrollNoCarry:
000203r 2  FA             plx                           ; Restore row counter
000204r 2  CA             dex
000205r 2  D0 BB          bne @ScrollRowLoop
000207r 2               
000207r 2                 ; Clear bottom row (row 23) with spaces
000207r 2                 ; Row 23 address = 23 * 40 = 920 = $0398
000207r 2  A9 98          lda #$98                      ; Low byte of $0398
000209r 2  8D 01 9C       sta VC_REG
00020Cr 2  A9 03          lda #$03
00020Er 2  09 40          ora #$40                      ; Write mode
000210r 2  8D 01 9C       sta VC_REG
000213r 2  A9 20          lda #$20                      ; Space character
000215r 2  A0 28          ldy #40
000217r 2               @ScrollClearBottom:
000217r 2  8D 00 9C       sta VC_DATA
00021Ar 2  88             dey
00021Br 2  D0 FA          bne @ScrollClearBottom
00021Dr 2                 ; Restore STR_PTR
00021Dr 2  68             pla
00021Er 2  85 03          sta STR_PTR + 1
000220r 2  68             pla
000221r 2  85 02          sta STR_PTR
000223r 2  60             rts
000224r 2               
000224r 2               ; VideoChrout — Output character to video display
000224r 2               ; Handles control characters: CR ($0D), LF ($0A), BS ($08), BEL ($07)
000224r 2               ; Printable ASCII ($20-$7E) written to VRAM; all other codes silently discarded
000224r 2               ; Auto-wraps at column 40, auto-scrolls at row 24
000224r 2               ; Input: A = character to output
000224r 2               ; Preserves: A, X, Y (callers like ChrinImpl, BasPrintStr and Wozmon depend on this)
000224r 2               ; Modifies: Flags
000224r 2               VideoChroutImpl:
000224r 2  48             pha
000225r 2  DA             phx
000226r 2  5A             phy
000227r 2                 ; Fast path: printable ASCII ($20-$7E) — most common case
000227r 2  C9 20          cmp #$20
000229r 2  90 06          bcc @Control                  ; < $20 → check control codes
00022Br 2  C9 7F          cmp #$7F
00022Dr 2  90 14          bcc @PrintChar                ; $20-$7E → printable character
00022Fr 2                 ; >= $7F (DEL and above) — discard
00022Fr 2                 ; User programs wanting raw glyph output should use VideoChroutRaw.
00022Fr 2  80 45          bra @VideoChroutDone
000231r 2               @Control:
000231r 2  C9 0D          cmp #$0D                      ; Carriage Return?
000233r 2  F0 45          beq @VideoCR
000235r 2  C9 0A          cmp #$0A                      ; Line Feed?
000237r 2  F0 4E          beq @VideoLF
000239r 2  C9 08          cmp #$08                      ; Backspace?
00023Br 2  F0 67          beq @VideoBS
00023Dr 2  C9 07          cmp #$07                      ; Bell?
00023Fr 2  F0 7B          beq @VideoBEL
000241r 2                 ; Unrecognized control code — discard
000241r 2  80 33          bra @VideoChroutDone
000243r 2               @PrintChar:
000243r 2                 ; Regular printable character — write at cursor and advance
000243r 2  20 rr rr       jsr VideoPutChar              ; Write char to VRAM at cursor
000246r 2                 ; Advance cursor
000246r 2  EE 07 03       inc VID_CURSOR_X
000249r 2                 ; Increment VRAM address
000249r 2  EE 09 03       inc VID_CURSOR_ADDR
00024Cr 2  D0 03          bne @CheckWrap
00024Er 2  EE 0A 03       inc VID_CURSOR_ADDR + 1
000251r 2               @CheckWrap:
000251r 2  AD 07 03       lda VID_CURSOR_X
000254r 2  C9 28          cmp #40                       ; Past last column?
000256r 2  90 1E          bcc @VideoChroutDone          ; No, done
000258r 2                 ; Auto-wrap: CR + LF
000258r 2  9C 07 03       stz VID_CURSOR_X
00025Br 2  EE 08 03       inc VID_CURSOR_Y
00025Er 2  AD 08 03       lda VID_CURSOR_Y
000261r 2  C9 18          cmp #24                       ; Past last row?
000263r 2  90 08          bcc @WrapRecalc
000265r 2                 ; Need to scroll
000265r 2  20 rr rr       jsr VideoScroll
000268r 2  A9 17          lda #23
00026Ar 2  8D 08 03       sta VID_CURSOR_Y
00026Dr 2               @WrapRecalc:
00026Dr 2  AE 07 03       ldx VID_CURSOR_X
000270r 2  AC 08 03       ldy VID_CURSOR_Y
000273r 2  20 rr rr       jsr VideoSetCursor            ; Recalculate VRAM address
000276r 2               @VideoChroutDone:
000276r 2  7A             ply
000277r 2  FA             plx
000278r 2  68             pla
000279r 2  60             rts
00027Ar 2               
00027Ar 2               @VideoCR:
00027Ar 2  9C 07 03       stz VID_CURSOR_X              ; Column = 0
00027Dr 2  A2 00          ldx #$00
00027Fr 2  AC 08 03       ldy VID_CURSOR_Y
000282r 2  20 rr rr       jsr VideoSetCursor            ; Recalculate VRAM address
000285r 2  80 EF          bra @VideoChroutDone
000287r 2               
000287r 2               @VideoLF:
000287r 2  EE 08 03       inc VID_CURSOR_Y
00028Ar 2  AD 08 03       lda VID_CURSOR_Y
00028Dr 2  C9 18          cmp #24                       ; Past last row?
00028Fr 2  90 08          bcc @LFRecalc
000291r 2  20 rr rr       jsr VideoScroll
000294r 2  A9 17          lda #23
000296r 2  8D 08 03       sta VID_CURSOR_Y
000299r 2               @LFRecalc:
000299r 2  AE 07 03       ldx VID_CURSOR_X
00029Cr 2  AC 08 03       ldy VID_CURSOR_Y
00029Fr 2  20 rr rr       jsr VideoSetCursor
0002A2r 2  80 D2          bra @VideoChroutDone
0002A4r 2               
0002A4r 2               @VideoBS:
0002A4r 2  AD 07 03       lda VID_CURSOR_X
0002A7r 2  F0 CD          beq @VideoChroutDone          ; Already at column 0, ignore
0002A9r 2  CE 07 03       dec VID_CURSOR_X
0002ACr 2  AE 07 03       ldx VID_CURSOR_X
0002AFr 2  AC 08 03       ldy VID_CURSOR_Y
0002B2r 2  20 rr rr       jsr VideoSetCursor            ; Recalculate VRAM address
0002B5r 2  A9 20          lda #$20                      ; Write space to erase character
0002B7r 2  20 rr rr       jsr VideoPutChar
0002BAr 2  80 BA          bra @VideoChroutDone
0002BCr 2               
0002BCr 2               @VideoBEL:
0002BCr 2  20 rr rr       jsr Beep
0002BFr 2  80 B5          bra @VideoChroutDone
0002C1r 2               
0002C1r 2               ; VideoChroutRaw — Output character to video (raw, no control-code handling)
0002C1r 2               ; Always writes the character glyph at the cursor position and advances.
0002C1r 2               ; Input: A = character code (0-255)
0002C1r 2               ; Preserves: A, X, Y
0002C1r 2               ; Modifies: Flags
0002C1r 2               VideoChroutRawImpl:
0002C1r 2  48             pha
0002C2r 2  DA             phx
0002C3r 2  5A             phy
0002C4r 2  20 rr rr       jsr VideoPutChar              ; Write char to VRAM at cursor
0002C7r 2  EE 07 03       inc VID_CURSOR_X
0002CAr 2  EE 09 03       inc VID_CURSOR_ADDR
0002CDr 2  D0 03          bne @RawCheckWrap
0002CFr 2  EE 0A 03       inc VID_CURSOR_ADDR + 1
0002D2r 2               @RawCheckWrap:
0002D2r 2  AD 07 03       lda VID_CURSOR_X
0002D5r 2  C9 28          cmp #40                       ; Past last column?
0002D7r 2  90 1E          bcc @RawDone
0002D9r 2  9C 07 03       stz VID_CURSOR_X
0002DCr 2  EE 08 03       inc VID_CURSOR_Y
0002DFr 2  AD 08 03       lda VID_CURSOR_Y
0002E2r 2  C9 18          cmp #24                       ; Past last row?
0002E4r 2  90 08          bcc @RawRecalc
0002E6r 2  20 rr rr       jsr VideoScroll
0002E9r 2  A9 17          lda #23
0002EBr 2  8D 08 03       sta VID_CURSOR_Y
0002EEr 2               @RawRecalc:
0002EEr 2  AE 07 03       ldx VID_CURSOR_X
0002F1r 2  AC 08 03       ldy VID_CURSOR_Y
0002F4r 2  20 rr rr       jsr VideoSetCursor
0002F7r 2               @RawDone:
0002F7r 2  7A             ply
0002F8r 2  FA             plx
0002F9r 2  68             pla
0002FAr 2  60             rts
0002FBr 2               
0002FBr 2               ; VideoPrintStr — Print null-terminated string to video
0002FBr 2               ; Input: STR_PTR ($02-$03) points to string
0002FBr 2               ; Modifies: Flags, A, X, Y
0002FBr 2               VideoPrintStrImpl:
0002FBr 2  A0 00          ldy #$00
0002FDr 2               @VideoPrintStrLoop:
0002FDr 2  B1 02          lda (STR_PTR),y
0002FFr 2  F0 08          beq @VideoPrintStrDone        ; Exit on null terminator
000301r 2  5A             phy
000302r 2  20 rr rr       jsr VideoChroutImpl           ; Output character via video
000305r 2  7A             ply
000306r 2  C8             iny
000307r 2  D0 F4          bne @VideoPrintStrLoop        ; Max 256 chars per string
000309r 2               @VideoPrintStrDone:
000309r 2  60             rts
00030Ar 2               
00030Ar 2               ; PrintStr — Print a NUL-terminated string to the console (routed by IO_MODE
00030Ar 2               ; through Chrout, so it works for video OR serial).  General-purpose; used by
00030Ar 2               ; BASIC (via the BasPrintStr alias) and available to cartridges.
00030Ar 2               ; Input : A = string address low, Y = string address high
00030Ar 2               ; Output: A, Y clobbered; X preserved; clobbers STR_PTR (Chrout preserves it)
00030Ar 2               PrintStrImpl:
00030Ar 2  85 02          sta STR_PTR
00030Cr 2  84 03          sty STR_PTR + 1
00030Er 2  A0 00          ldy #$00
000310r 2               @PrintStrLoop:
000310r 2  B1 02          lda (STR_PTR),y
000312r 2  F0 06          beq @PrintStrDone             ; NUL terminator
000314r 2  20 rr rr       jsr Chrout
000317r 2  C8             iny
000318r 2  D0 F6          bne @PrintStrLoop             ; Max 256 chars per call
00031Ar 2               @PrintStrDone:
00031Ar 2  60             rts
00031Br 2               
00031Br 2               ; PrintCRLF — Emit CR ($0D) then LF ($0A) via Chrout.
00031Br 2               PrintCRLFImpl:
00031Br 2  A9 0D          lda #$0D
00031Dr 2  20 rr rr       jsr Chrout
000320r 2  A9 0A          lda #$0A
000322r 2  4C rr rr       jmp Chrout
000325r 2               
000325r 2               ; KernalInit — Initialize RAM variables, probe & init all hardware
000325r 2               ; Sets HW_PRESENT, IO_MODE, IRQ/BRK/NMI pointers, BOOT_VECTOR=0
000325r 2               ; Does NOT enable interrupts (caller must cli)
000325r 2               ; Does NOT reset the stack pointer (caller should do this before JSR)
000325r 2               ; Does NOT display splash or enter boot menu
000325r 2               ; Modifies: All registers, flags
000325r 2               KernalInitImpl:
000325r 2  D8             cld                           ; Clear decimal mode
000326r 2  78             sei                           ; Disable interrupts
000327r 2               
000327r 2  A9 rr          lda #<Irq                     ; Initialize the IRQ pointer
000329r 2  8D 00 03       sta IRQ_PTR
00032Cr 2  A9 rr          lda #>Irq
00032Er 2  8D 01 03       sta IRQ_PTR + 1
000331r 2               
000331r 2  A9 rr          lda #<Break                   ; Initialize the BRK pointer
000333r 2  8D 02 03       sta BRK_PTR
000336r 2  A9 rr          lda #>Break
000338r 2  8D 03 03       sta BRK_PTR + 1
00033Br 2               
00033Br 2  A9 rr          lda #<Nmi                     ; Initialize the NMI pointer
00033Dr 2  8D 04 03       sta NMI_PTR
000340r 2  A9 rr          lda #>Nmi
000342r 2  8D 05 03       sta NMI_PTR + 1
000345r 2               
000345r 2  9C 0D 03       stz HW_PRESENT                ; Clear all hardware flags
000348r 2  9C 5B 03       stz BOOT_VECTOR               ; Clear boot redirect vector
00034Br 2  9C 5C 03       stz BOOT_VECTOR + 1
00034Er 2  9C 8E 03       stz PRG_IMAGE_END             ; No externally-loaded program image yet.  This
000351r 2  9C 8F 03       stz PRG_IMAGE_END + 1         ;   runs before any loader can, so a non-zero
000354r 2                                               ;   value always means a loader put it there
000354r 2  9C 0F 03       stz CF_DISK                   ; Reset current CF disk bank to 0
000357r 2               
000357r 2  20 rr rr       jsr InitBuffer                ; Initialize the input buffer (RAM-only, no hardware)
00035Ar 2               
00035Ar 2  20 rr rr       jsr ProbeRAM                  ; Sets HW_RAM_L / HW_RAM_H if present (no init needed)
00035Dr 2               
00035Dr 2  20 rr rr       jsr ProbeRTC                  ; Sets HW_RTC if present (no init needed)
000360r 2               
000360r 2  20 rr rr       jsr StInit                    ; CF: timeout will handle absent card in Phase 3, sets HW_CF on success
000363r 2               
000363r 2  20 rr rr       jsr ProbeSerial               ; Sets HW_SC if present
000366r 2  AD 0D 03       lda HW_PRESENT
000369r 2  29 10          and #HW_SC
00036Br 2  F0 03          beq @SkipSerial
00036Dr 2  20 rr rr       jsr InitSCImpl
000370r 2               @SkipSerial:
000370r 2               
000370r 2  20 rr rr       jsr ProbeGPIO                 ; Sets HW_GPIO if present
000373r 2  AD 0D 03       lda HW_PRESENT
000376r 2  29 20          and #HW_GPIO
000378r 2  F0 03          beq @SkipGPIO
00037Ar 2  20 rr rr       jsr InitKBImpl
00037Dr 2               @SkipGPIO:
00037Dr 2               
00037Dr 2  20 rr rr       jsr ProbeSID                  ; Sets HW_SID if present
000380r 2  AD 0D 03       lda HW_PRESENT
000383r 2  29 40          and #HW_SID
000385r 2  F0 03          beq @SkipSID
000387r 2  20 rr rr       jsr InitSIDImpl
00038Ar 2               @SkipSID:
00038Ar 2               
00038Ar 2  20 rr rr       jsr ProbeVideo                ; Sets HW_VID if present
00038Dr 2  AD 0D 03       lda HW_PRESENT
000390r 2  29 80          and #HW_VID
000392r 2  F0 03          beq @SkipVideo
000394r 2  20 rr rr       jsr InitVideoImpl             ; Also loads the character set
000397r 2               @SkipVideo:
000397r 2               
000397r 2                 ; Console auto-detection — determine IO_MODE from available hardware
000397r 2  AD 0D 03       lda HW_PRESENT
00039Ar 2  29 80          and #HW_VID
00039Cr 2  D0 09          bne @ConsoleVideo             ; Video present — use it
00039Er 2  AD 0D 03       lda HW_PRESENT
0003A1r 2  29 10          and #HW_SC
0003A3r 2  D0 15          bne @ConsoleSerial            ; Serial present — use it
0003A5r 2                 ; Neither video nor serial — IO_MODE left as-is (no console)
0003A5r 2  80 18          bra @ConsoleDone
0003A7r 2               
0003A7r 2               @ConsoleVideo:
0003A7r 2  A9 00          lda #$00                      ; IO_MODE = video
0003A9r 2  8D 06 03       sta IO_MODE
0003ACr 2  9C 07 03       stz VID_CURSOR_X
0003AFr 2  9C 08 03       stz VID_CURSOR_Y
0003B2r 2  9C 09 03       stz VID_CURSOR_ADDR
0003B5r 2  9C 0A 03       stz VID_CURSOR_ADDR + 1
0003B8r 2  80 05          bra @ConsoleDone
0003BAr 2               
0003BAr 2               @ConsoleSerial:
0003BAr 2  A9 01          lda #$01                      ; IO_MODE = serial
0003BCr 2  8D 06 03       sta IO_MODE
0003BFr 2               
0003BFr 2               @ConsoleDone:
0003BFr 2  60             rts
0003C0r 2               
0003C0r 2               ; KernalVersion — Return BIOS version in registers
0003C0r 2               ; Output: A = major version, X = minor version
0003C0r 2               ; Modifies: A, X
0003C0r 2               KernalVersionImpl:
0003C0r 2  A9 01          lda #BIOS_VERSION_MAJOR
0003C2r 2  A2 03          ldx #BIOS_VERSION_MINOR
0003C4r 2  60             rts
0003C5r 2               
0003C5r 2               ; ProgramEnd — Determine where the program image at PROGRAM_START ends.
0003C5r 2               ; A program image is a tokenized BASIC line chain, optionally followed by machine
0003C5r 2               ; code (a ".prg").  Only a byte count can find the end of the machine code; a
0003C5r 2               ; chain walk stops at the $0000 end marker.  So prefer a count recorded by a
0003C5r 2               ; loader running outside BASIC, and fall back to the walk when there is none.
0003C5r 2               ; Input: none (reads PRG_IMAGE_END, set by Monitor L when it loads to $0800)
0003C5r 2               ; Output: A = end lo, Y = end hi — the address BASIC should use for VARTAB
0003C5r 2               ; Modifies: Flags, A, X, Y, PE_PTR, PE_NEXT, PRG_IMAGE_END (consumed)
0003C5r 2               ; Note: writes the $00 $00 end marker at PROGRAM_START in the empty case.
0003C5r 2               ; Not in the jump table — BASIC calls this label directly, as it does ReqHw.
0003C5r 2               ProgramEnd:
0003C5r 2                 ; --- 1. A loader recorded a byte count: trust it if it is in range ---
0003C5r 2  AD 8E 03       lda PRG_IMAGE_END
0003C8r 2  AE 8F 03       ldx PRG_IMAGE_END + 1
0003CBr 2  9C 8E 03       stz PRG_IMAGE_END             ; Consume it either way, so a stale value cannot
0003CEr 2  9C 8F 03       stz PRG_IMAGE_END + 1         ;   be acted on twice
0003D1r 2  E0 08          cpx #>PROGRAM_START           ; Must be >= PROGRAM_START + 2 (0 fails here too)
0003D3r 2  90 13          bcc @PeWalk
0003D5r 2  D0 04          bne @PeHiOk
0003D7r 2  C9 02          cmp #<(PROGRAM_START + 2)
0003D9r 2  90 0D          bcc @PeWalk
0003DBr 2               @PeHiOk:
0003DBr 2  E0 80          cpx #>MEMORY_TOP              ; ...and must not run past the top of RAM
0003DDr 2  90 06          bcc @PeUse
0003DFr 2  D0 07          bne @PeWalk
0003E1r 2  C9 00          cmp #<MEMORY_TOP
0003E3r 2  D0 03          bne @PeWalk
0003E5r 2               @PeUse:
0003E5r 2  DA             phx                           ; Y = hi; A still holds lo
0003E6r 2  7A             ply
0003E7r 2  60             rts
0003E8r 2               
0003E8r 2                 ; --- 2. No count: walk the line chain to the $0000 end marker ---
0003E8r 2               @PeWalk:
0003E8r 2  AD 01 08       lda PROGRAM_START + 1         ; High byte of the first next-pointer: a real
0003EBr 2  C9 08          cmp #>PROGRAM_START           ;   program's lines all live in [$0800, $8000)
0003EDr 2  90 3E          bcc @PeEmpty
0003EFr 2  C9 80          cmp #>MEMORY_TOP
0003F1r 2  B0 3A          bcs @PeEmpty
0003F3r 2  A9 00          lda #<PROGRAM_START
0003F5r 2  85 24          sta PE_PTR
0003F7r 2  A9 08          lda #>PROGRAM_START
0003F9r 2  85 25          sta PE_PTR + 1
0003FBr 2               @PeWalkLoop:
0003FBr 2  A0 01          ldy #1
0003FDr 2  B1 24          lda (PE_PTR),y                ; Next-pointer high byte
0003FFr 2  F0 1F          beq @PeWalkDone               ; 0 → end marker reached
000401r 2  C9 80          cmp #>MEMORY_TOP              ; Out of range → not a real program
000403r 2  B0 28          bcs @PeEmpty
000405r 2  85 27          sta PE_NEXT + 1
000407r 2  88             dey
000408r 2  B1 24          lda (PE_PTR),y                ; Next-pointer low byte
00040Ar 2  85 26          sta PE_NEXT
00040Cr 2                 ; Lines are stored in strictly ascending address order.  If the next-pointer
00040Cr 2                 ; does not advance upward we are walking random power-up RAM, which would
00040Cr 2                 ; otherwise loop forever — bail out and install an empty program.
00040Cr 2  A5 24          lda PE_PTR
00040Er 2  C5 26          cmp PE_NEXT
000410r 2  A5 25          lda PE_PTR + 1
000412r 2  E5 27          sbc PE_NEXT + 1
000414r 2  B0 17          bcs @PeEmpty                  ; current >= candidate → invalid chain
000416r 2  A5 26          lda PE_NEXT                   ; Advance to the next line
000418r 2  85 24          sta PE_PTR
00041Ar 2  A5 27          lda PE_NEXT + 1
00041Cr 2  85 25          sta PE_PTR + 1
00041Er 2  80 DB          bra @PeWalkLoop
000420r 2               @PeWalkDone:
000420r 2  18             clc                           ; PE_PTR is on the end marker; end = PE_PTR + 2
000421r 2  A5 24          lda PE_PTR
000423r 2  69 02          adc #2
000425r 2  AA             tax
000426r 2  A5 25          lda PE_PTR + 1
000428r 2  69 00          adc #0
00042Ar 2  A8             tay
00042Br 2  8A             txa
00042Cr 2  60             rts
00042Dr 2               
00042Dr 2                 ; --- 3. Nothing usable at $0800: install an empty program ---
00042Dr 2               @PeEmpty:
00042Dr 2  9C 00 08       stz PROGRAM_START             ; Write the [00][00] end marker
000430r 2  9C 01 08       stz PROGRAM_START + 1
000433r 2  A9 02          lda #<(PROGRAM_START + 2)
000435r 2  A0 08          ldy #>(PROGRAM_START + 2)
000437r 2  60             rts
000438r 2               
000438r 2               ; Reset — Full system startup: init hardware, beep, check boot vector, splash, boot menu
000438r 2               Reset:
000438r 2  A2 FF          ldx #$ff
00043Ar 2  9A             txs                           ; Reset the stack pointer
00043Br 2  20 rr rr       jsr KernalInitImpl            ; Initialize all hardware (leaves interrupts disabled)
00043Er 2               
00043Er 2  20 rr rr       jsr Beep                      ; Play the startup beep (guarded — skips if no SID)
000441r 2               
000441r 2                 ; Check boot redirect vector — cartridges set this before jumping to Reset
000441r 2  AD 5B 03       lda BOOT_VECTOR
000444r 2  0D 5C 03       ora BOOT_VECTOR + 1
000447r 2  F0 03          beq @NormalBoot               ; Zero — continue normal boot
000449r 2  6C 5B 03       jmp (BOOT_VECTOR)             ; Non-zero — jump to cartridge/external program
00044Cr 2               
00044Cr 2               @NormalBoot:
00044Cr 2                 ; Verify console is available for interactive boot
00044Cr 2  AD 0D 03       lda HW_PRESENT
00044Fr 2  29 90          and #(HW_VID | HW_SC)
000451r 2  D0 02          bne @HasConsole
000453r 2                 ; Neither video nor serial — halt (no console for interactive boot)
000453r 2               @Halt:
000453r 2  80 FE          bra @Halt
000455r 2               
000455r 2               @HasConsole:
000455r 2  20 rr rr       jsr Splash                    ; Draw the splash screen (guarded — skips if no video)
000458r 2               
000458r 2  58             cli                           ; Enable interrupts
000459r 2               
000459r 2                 ; Boot menu — wait for keypress with ~5-second timeout
000459r 2                 ; Each iteration delays 100ms then checks for a key. 50 iterations = 5 seconds.
000459r 2  A2 32          ldx #50                       ; Timeout counter: 50 × 100ms = 5 seconds
00045Br 2               @BootWait:
00045Br 2  DA             phx                           ; Save timeout counter
00045Cr 2  A9 0A          lda #10                       ; 10 centiseconds (100ms)
00045Er 2  A2 00          ldx #$00                      ; High byte = 0
000460r 2  20 rr rr       jsr SysDelay
000463r 2  20 rr rr       jsr BufferSize                ; A = bytes in buffer
000466r 2  FA             plx                           ; Restore timeout counter (clobbers Z flag)
000467r 2  C9 00          cmp #$00                      ; Re-test buffer size — plx overwrote Z
000469r 2  D0 05          bne @BootGotKey               ; Key available — process it
00046Br 2  CA             dex
00046Cr 2  D0 ED          bne @BootWait                 ; No key yet — keep waiting
00046Er 2  80 10          bra @BootBASIC                ; Timeout — auto-boot BASIC
000470r 2               
000470r 2               @BootGotKey:
000470r 2  20 rr rr       jsr ReadBuffer                ; Read the keypress
000473r 2  C9 0D          cmp #$0D                      ; ENTER?
000475r 2  F0 09          beq @BootBASIC
000477r 2  C9 1B          cmp #$1B                      ; ESC?
000479r 2  F0 0B          beq @BootMonitor
00047Br 2  CA             dex                           ; Consumed a non-menu key — decrement counter
00047Cr 2  D0 DD          bne @BootWait                 ; Keep waiting if time remains
00047Er 2  80 00          bra @BootBASIC                ; Timeout — auto-boot BASIC
000480r 2               
000480r 2               @BootBASIC:
000480r 2  20 rr rr       jsr VideoClear                ; Clear screen (harmless if no video)
000483r 2  4C rr rr       jmp BasEntry
000486r 2               @BootMonitor:
000486r 2  00             brk                           ; Enter monitor through BRK vector (saves/displays registers)
000487r 2               
000487r 2               ; Initialize the Keyboard via VIA (IO 6)
000487r 2               ; Configures Port B (matrix) and Port A (PS/2) as inputs
000487r 2               ; CB2 low (enable matrix encoder), CA2 low (enable PS/2 encoder)
000487r 2               ; CB1 and CA1 falling-edge IRQs enabled
000487r 2               ; Modifies: Flags, A
000487r 2               InitKBImpl:
000487r 2  A9 00          lda #$00                      ; Port B all inputs (matrix keyboard data bus)
000489r 2  8D 02 94       sta GPIO_DDRB
00048Cr 2  A9 00          lda #$00                      ; Port A all inputs (PS/2 keyboard data bus)
00048Er 2  8D 03 94       sta GPIO_DDRA
000491r 2                 ; PCR: CB2 low + CB1 neg + CA2 low + CA1 neg
000491r 2  A9 CC          lda #(GPIO_PCR_CB2_LO | GPIO_PCR_CB1_NEG | GPIO_PCR_CA2_LO | GPIO_PCR_CA1_NEG)
000493r 2  8D 0C 94       sta GPIO_PCR
000496r 2                 ; Enable both CB1 and CA1 interrupts
000496r 2  A9 92          lda #(GPIO_IER_SET | GPIO_INT_CB1 | GPIO_INT_CA1)
000498r 2  8D 0E 94       sta GPIO_IER
00049Br 2  60             rts
00049Cr 2               
00049Cr 2               ; Initialize the Serial Card (6551)
00049Cr 2               ; Modifies: Flags, A
00049Cr 2               InitSCImpl:
00049Cr 2  A9 1F          lda     #$1F                  ; 8-N-1, 19200 baud
00049Er 2  8D 03 90       sta     SC_CTRL
0004A1r 2  A9 09          lda     #$09                  ; No parity, no echo, RTSB low, TX interrupts disabled, RX interrupts enabled
0004A3r 2  8D 02 90       sta     SC_CMD
0004A6r 2  60             rts
0004A7r 2               
0004A7r 2               ; Initialze the Sound Card (6581)
0004A7r 2               ; Modifies: Flags, A, X
0004A7r 2               InitSIDImpl:
0004A7r 2  A9 00          lda #$00
0004A9r 2  A2 1D          ldx #$1D                      ; Clear all 29 SID registers
0004ABr 2               @InitSIDLoop:
0004ABr 2  9D 00 98       sta SID_V1_FREQ_LO,x          ; Clear register
0004AEr 2  CA             dex
0004AFr 2  10 FA          bpl @InitSIDLoop              ; Loop until all registers cleared
0004B1r 2  A9 0F          lda #$0F                      ; Set volume to maximum
0004B3r 2  8D 18 98       sta SID_MODE_VOL
0004B6r 2  60             rts
0004B7r 2               
0004B7r 2               ; Initialize the Video Card (TMS9918)
0004B7r 2               ; Writes the eight mode registers (text mode, 40x24) and reloads the character
0004B7r 2               ; set into the pattern table at $0800, so a program that overwrote the glyphs
0004B7r 2               ; can fully restore text mode with a single call.
0004B7r 2               ; Modifies: Flags, A, X, Y
0004B7r 2               InitVideoImpl:
0004B7r 2  A2 00          ldx #$00                      ; Start with register 0
0004B9r 2               @InitVideoLoop:
0004B9r 2  BD rr rr       lda @InitVideoRegData,x       ; Load register value
0004BCr 2  8D 01 9C       sta VC_REG                    ; Write data byte
0004BFr 2  8A             txa
0004C0r 2  09 80          ora #$80                      ; Set bit 7 to indicate register write
0004C2r 2  8D 01 9C       sta VC_REG                    ; Write register number
0004C5r 2  E8             inx
0004C6r 2  E0 08          cpx #$08                      ; Check if all 8 registers written
0004C8r 2  D0 EF          bne @InitVideoLoop            ; Continue until done
0004CAr 2  4C rr rr       jmp InitCharacters            ; Restore the character set (tail call)
0004CDr 2               @InitVideoRegData:
0004CDr 2  00             .byte $00                     ; R0: Mode control (no external video)
0004CEr 2  D0             .byte $D0                     ; R1: 16K, display on, interrupt off, text mode M1
0004CFr 2  00             .byte $00                     ; R2: Name table at $0000 (0x00 * 0x400)
0004D0r 2  00             .byte $00                     ; R3: Color table (not used in text mode)
0004D1r 2  01             .byte $01                     ; R4: Pattern table at $0800 (0x01 * 0x800)
0004D2r 2  00             .byte $00                     ; R5: Sprite attribute table (not used in text mode)
0004D3r 2  00             .byte $00                     ; R6: Sprite pattern table (not used in text mode)
0004D4r 2  1F             .byte $1F                     ; R7: Black text on white background
0004D5r 2               
0004D5r 2               ; Initialize the character set
0004D5r 2               ; Copies the 2KB character ROM into the pattern table at VRAM $0800.
0004D5r 2               ; STR_PTR is used as the source pointer but is saved and restored, so callers
0004D5r 2               ; may hold a pointer there across the call.
0004D5r 2               ; Modifies: Flags, A, X, Y
0004D5r 2               InitCharacters:
0004D5r 2  A5 02          lda STR_PTR                   ; Preserve caller's STR_PTR
0004D7r 2  48             pha
0004D8r 2  A5 03          lda STR_PTR + 1
0004DAr 2  48             pha
0004DBr 2                 ; Set VRAM write address to $0800 (pattern table base)
0004DBr 2  A9 00          lda #$00                      ; Low byte of address
0004DDr 2  8D 01 9C       sta VC_REG
0004E0r 2  A9 48          lda #$48                      ; High byte ($08) OR $40 for write mode
0004E2r 2  8D 01 9C       sta VC_REG
0004E5r 2                 ; Set up source pointer
0004E5r 2  A9 rr          lda #<CharacterSet
0004E7r 2  85 02          sta STR_PTR                   ; Use STR_PTR ($02-$03) for character set pointer
0004E9r 2  A9 rr          lda #>CharacterSet
0004EBr 2  85 03          sta STR_PTR + 1
0004EDr 2                 ; Copy 2048 bytes (8 pages of 256 bytes each)
0004EDr 2  A2 08          ldx #$08                      ; 8 pages to copy
0004EFr 2  A0 00          ldy #$00                      ; Byte counter within page
0004F1r 2               @InitCharPageLoop:
0004F1r 2  B1 02          lda (STR_PTR),y               ; Load from character set
0004F3r 2  8D 00 9C       sta VC_DATA                   ; Write to VRAM
0004F6r 2  C8             iny
0004F7r 2  D0 F8          bne @InitCharPageLoop         ; Loop until page complete (256 bytes)
0004F9r 2  E6 03          inc STR_PTR + 1               ; Move to next page
0004FBr 2  CA             dex
0004FCr 2  D0 F3          bne @InitCharPageLoop         ; Loop for all 8 pages
0004FEr 2  68             pla                           ; Restore caller's STR_PTR
0004FFr 2  85 03          sta STR_PTR + 1
000501r 2  68             pla
000502r 2  85 02          sta STR_PTR
000504r 2  60             rts
000505r 2               
000505r 2               ; Initialize the INPUT_BUFFER
000505r 2               ; Modifies: Flags, A
000505r 2               InitBuffer:
000505r 2  A9 00          lda #$00
000507r 2  85 00          sta READ_PTR                  ; Init read and write pointers
000509r 2  85 01          sta WRITE_PTR
00050Br 2  60             rts
00050Cr 2               
00050Cr 2               ; Write a character from the A register to the INPUT_BUFFER
00050Cr 2               ; Modifies: Flags, X
00050Cr 2               WriteBufferImpl:
00050Cr 2  A6 01          ldx WRITE_PTR
00050Er 2  9D 00 02       sta INPUT_BUFFER,x
000511r 2  E6 01          inc WRITE_PTR
000513r 2  60             rts
000514r 2               
000514r 2               ; Read a character from the INPUT_BUFFER and store it in A register
000514r 2               ; Modifies: Flags, X, A
000514r 2               ReadBufferImpl:
000514r 2  A6 00          ldx READ_PTR
000516r 2  BD 00 02       lda INPUT_BUFFER,x
000519r 2  E6 00          inc READ_PTR
00051Br 2  60             rts
00051Cr 2               
00051Cr 2               ; Return in A register the number of unread bytes in the INPUT_BUFFER
00051Cr 2               ; Modifies: Flags, A
00051Cr 2               BufferSizeImpl:
00051Cr 2  A5 01          lda WRITE_PTR
00051Er 2  38             sec
00051Fr 2  E5 00          sbc READ_PTR
000521r 2  60             rts
000522r 2               
000522r 2               ; Get a character from the INPUT_BUFFER if available
000522r 2               ; On return, carry flag indicates whether a character was available
000522r 2               ; If character available the character will be in the A register
000522r 2               ; Modifies: Flags, A
000522r 2               ChrinImpl:
000522r 2  DA             phx
000523r 2  20 rr rr       jsr BufferSize                ; Check for character available
000526r 2  F0 2C          beq @ChrinNoChar              ; Branch if no character available
000528r 2  20 rr rr       jsr ReadBuffer                ; Read the character from the buffer
00052Br 2  20 rr rr       jsr Chrout                    ; Echo
00052Er 2  48             pha
00052Fr 2  20 rr rr       jsr BufferSize
000532r 2  C9 B0          cmp #$B0                      ; Check if buffer is mostly full
000534r 2  90 0E          bcc @ChrinNotFull             ; Branch if buffer size < $B0
000536r 2                 ; Only touch SC_CMD if serial is present
000536r 2  AD 0D 03       lda HW_PRESENT
000539r 2  29 10          and #HW_SC
00053Br 2  F0 13          beq @ChrinExit
00053Dr 2  A9 01          lda #$01                      ; No parity, no echo, RTSB high, TX interrupts disabled, RX interrupts enabled
00053Fr 2  8D 02 90       sta SC_CMD
000542r 2  80 0C          bra @ChrinExit
000544r 2               @ChrinNotFull:
000544r 2  AD 0D 03       lda HW_PRESENT
000547r 2  29 10          and #HW_SC
000549r 2  F0 05          beq @ChrinExit
00054Br 2  A9 09          lda #$09                      ; No parity, no echo, RTSB low, TX interrupts disabled, RX interrupts enabled
00054Dr 2  8D 02 90       sta SC_CMD
000550r 2               @ChrinExit:
000550r 2  68             pla
000551r 2  FA             plx
000552r 2  38             sec
000553r 2  60             rts
000554r 2               @ChrinNoChar:
000554r 2  FA             plx
000555r 2  18             clc
000556r 2  60             rts
000557r 2               
000557r 2               ; Output a character from the A register to the Serial Card
000557r 2               ; Modifies: Flags
000557r 2               SerialChroutImpl:
000557r 2  8D 00 90       sta SC_DATA
00055Ar 2  48             pha
00055Br 2               @ChroutWait:
00055Br 2  AD 01 90       lda SC_STATUS
00055Er 2  29 10          and #SC_STATUS_TDRE           ; Check if TX buffer not empty
000560r 2  F0 F9          beq @ChroutWait               ; Loop if TX buffer not empty
000562r 2  68             pla
000563r 2  60             rts
000564r 2               
000564r 2               ; SidPlayNote — Play a note on a SID voice
000564r 2               ; Input: A = voice (0-2), X = frequency low byte, Y = frequency high byte
000564r 2               ; Uses triangle waveform with standard ADSR (Attack=0, Decay=9, Sustain=A, Release=2)
000564r 2               ; Modifies: Flags, A
000564r 2               SidPlayNoteImpl:
000564r 2  C9 01          cmp #$01
000566r 2  F0 1A          beq @Voice2
000568r 2  C9 02          cmp #$02
00056Ar 2  F0 2C          beq @Voice3
00056Cr 2                 ; Voice 0
00056Cr 2  8E 00 98       stx SID_V1_FREQ_LO
00056Fr 2  8C 01 98       sty SID_V1_FREQ_HI
000572r 2  A9 09          lda #$09                      ; Attack = 0, Decay = 9
000574r 2  8D 05 98       sta SID_V1_AD
000577r 2  A9 F8          lda #$F8                      ; Sustain = F, Release = 8
000579r 2  8D 06 98       sta SID_V1_SR
00057Cr 2  A9 11          lda #$11                      ; Triangle wave + Gate on
00057Er 2  8D 04 98       sta SID_V1_CTRL
000581r 2  60             rts
000582r 2               @Voice2:
000582r 2  8E 07 98       stx SID_V2_FREQ_LO
000585r 2  8C 08 98       sty SID_V2_FREQ_HI
000588r 2  A9 09          lda #$09
00058Ar 2  8D 0C 98       sta SID_V2_AD
00058Dr 2  A9 F8          lda #$F8
00058Fr 2  8D 0D 98       sta SID_V2_SR
000592r 2  A9 11          lda #$11
000594r 2  8D 0B 98       sta SID_V2_CTRL
000597r 2  60             rts
000598r 2               @Voice3:
000598r 2  8E 0E 98       stx SID_V3_FREQ_LO
00059Br 2  8C 0F 98       sty SID_V3_FREQ_HI
00059Er 2  A9 09          lda #$09
0005A0r 2  8D 13 98       sta SID_V3_AD
0005A3r 2  A9 F8          lda #$F8
0005A5r 2  8D 14 98       sta SID_V3_SR
0005A8r 2  A9 11          lda #$11
0005AAr 2  8D 12 98       sta SID_V3_CTRL
0005ADr 2  60             rts
0005AEr 2               
0005AEr 2               ; SidSilence — Silence all 3 SID voices
0005AEr 2               ; Gates off all voices, letting the release phase of the envelope ring out.
0005AEr 2               ;
0005AEr 2               ; The frequency registers are deliberately left alone. Zeroing them stops the
0005AEr 2               ; oscillator dead, which freezes the waveform at whatever level it had reached
0005AEr 2               ; and leaves the envelope to decay a DC offset instead of a tone — an audible
0005AEr 2               ; thump at the end of every note. Gate off is all the SID needs; the envelope
0005AEr 2               ; takes the voice to zero on its own.
0005AEr 2               ; Modifies: Flags, A
0005AEr 2               SidSilenceImpl:
0005AEr 2  A9 10          lda #$10                      ; Triangle wave, Gate off
0005B0r 2  8D 04 98       sta SID_V1_CTRL
0005B3r 2  8D 0B 98       sta SID_V2_CTRL
0005B6r 2  8D 12 98       sta SID_V3_CTRL
0005B9r 2  60             rts
0005BAr 2               
0005BAr 2               ; Play a short beep sound
0005BAr 2               ; Uses SidPlayNote on voice 0 with ~475 Hz tone, then silences
0005BAr 2               ; Skips silently if SID is absent
0005BAr 2               ; Modifies: Flags, A, X, Y
0005BAr 2               BeepImpl:
0005BAr 2  AD 0D 03       lda HW_PRESENT
0005BDr 2  29 40          and #HW_SID
0005BFr 2  D0 01          bne @BeepStart
0005C1r 2  60             rts                           ; No SID — skip silently
0005C2r 2               @BeepStart:
0005C2r 2  A9 00          lda #$00                      ; Voice 0
0005C4r 2  A2 20          ldx #$20                      ; Frequency low byte (~475 Hz)
0005C6r 2  A0 1F          ldy #$1F                      ; Frequency high byte
0005C8r 2  20 rr rr       jsr SidPlayNote
0005CBr 2                 ; Override ADSR for beep: fast decay, no sustain
0005CBr 2  A9 09          lda #$09                      ; Attack = 0, Decay = 9
0005CDr 2  8D 05 98       sta SID_V1_AD
0005D0r 2  A9 00          lda #$00                      ; Sustain = 0, Release = 0
0005D2r 2  8D 06 98       sta SID_V1_SR
0005D5r 2                 ; Delay for beep duration
0005D5r 2  A2 F0          ldx #$F0                      ; Outer loop counter
0005D7r 2               @BeepDelay1:
0005D7r 2  A0 FF          ldy #$FF                      ; Inner loop counter
0005D9r 2               @BeepDelay2:
0005D9r 2  88             dey
0005DAr 2  D0 FD          bne @BeepDelay2
0005DCr 2  CA             dex
0005DDr 2  D0 F8          bne @BeepDelay1
0005DFr 2  20 rr rr       jsr SidSilence                ; Gate off all voices
0005E2r 2  60             rts
0005E3r 2               
0005E3r 2               ; SysDelay — Delay for a specified number of centiseconds
0005E3r 2               ; Input: A = count low byte, X = count high byte
0005E3r 2               ; Uses VIA T1 in one-shot mode. 9999 cycles @ 1MHz = ~10ms per tick.
0005E3r 2               ; Modifies: Flags, A, X, Y (X/Y clobbered only in software-fallback path)
0005E3r 2               SysDelayImpl:
0005E3r 2  85 2C          sta DELAY_CNT
0005E5r 2  86 2D          stx DELAY_CNT + 1
0005E7r 2                 ; Return immediately if count is zero
0005E7r 2  05 2D          ora DELAY_CNT + 1
0005E9r 2  F0 4F          beq @DelayDone
0005EBr 2                 ; Check if VIA is present for hardware timer
0005EBr 2  AD 0D 03       lda HW_PRESENT
0005EEr 2  29 20          and #HW_GPIO
0005F0r 2  D0 19          bne @DelayHardware
0005F2r 2                 ; Software fallback — calibrated busy loop (~10ms per centisecond at 1MHz)
0005F2r 2                 ; Inner loop: 5 cycles × 256 iterations × 8 = ~10240 cycles ≈ 10ms
0005F2r 2               @DelaySoftLoop:
0005F2r 2  A0 00          ldy #$00                      ; 256 outer iterations
0005F4r 2  A2 08          ldx #8
0005F6r 2               @DelaySoftInner:
0005F6r 2  88             dey
0005F7r 2  D0 FD          bne @DelaySoftInner
0005F9r 2  CA             dex
0005FAr 2  D0 FA          bne @DelaySoftInner
0005FCr 2                 ; 16-bit decrement of DELAY_CNT
0005FCr 2  A5 2C          lda DELAY_CNT
0005FEr 2  D0 02          bne @SoftDecLo
000600r 2  C6 2D          dec DELAY_CNT + 1
000602r 2               @SoftDecLo:
000602r 2  C6 2C          dec DELAY_CNT
000604r 2  A5 2C          lda DELAY_CNT
000606r 2  05 2D          ora DELAY_CNT + 1
000608r 2  D0 E8          bne @DelaySoftLoop
00060Ar 2  60             rts
00060Br 2               @DelayHardware:
00060Br 2                 ; Configure T1 one-shot mode: clear ACR bit 6
00060Br 2  AD 0B 94       lda GPIO_ACR
00060Er 2  29 BF          and #%10111111
000610r 2  8D 0B 94       sta GPIO_ACR
000613r 2               @DelayLoop:
000613r 2                 ; Load T1 latch: 9999 = $270F
000613r 2  A9 0F          lda #$0F
000615r 2  8D 06 94       sta GPIO_T1LL
000618r 2  A9 27          lda #$27
00061Ar 2  8D 07 94       sta GPIO_T1LH
00061Dr 2                 ; Write T1CH to start countdown (also clears IFR T1 flag)
00061Dr 2  A9 27          lda #$27
00061Fr 2  8D 05 94       sta GPIO_T1CH
000622r 2               @DelayPoll:
000622r 2  AD 0D 94       lda GPIO_IFR
000625r 2  29 40          and #%01000000                ; T1 timeout flag
000627r 2  F0 F9          beq @DelayPoll
000629r 2                 ; Clear flag by reading T1CL
000629r 2  AD 04 94       lda GPIO_T1CL
00062Cr 2                 ; 16-bit decrement
00062Cr 2  A5 2C          lda DELAY_CNT
00062Er 2  D0 02          bne @DelayDecLo
000630r 2  C6 2D          dec DELAY_CNT + 1
000632r 2               @DelayDecLo:
000632r 2  C6 2C          dec DELAY_CNT
000634r 2                 ; Loop until both bytes zero
000634r 2  A5 2C          lda DELAY_CNT
000636r 2  05 2D          ora DELAY_CNT + 1
000638r 2  D0 D9          bne @DelayLoop
00063Ar 2               @DelayDone:
00063Ar 2  60             rts
00063Br 2               
00063Br 2               ; SidSetVolume — Set SID master volume
00063Br 2               ; Input: A = volume (0-15); upper nibble of SID_MODE_VOL is cleared (no filter)
00063Br 2               ; Modifies: Flags, A
00063Br 2               SidSetVolumeImpl:
00063Br 2  29 0F          and #$0F
00063Dr 2  8D 18 98       sta SID_MODE_VOL
000640r 2  60             rts
000641r 2               
000641r 2               ; VideoSetColor — Set TMS9918 text color register
000641r 2               ; Input: A = color byte (high nibble = fg color, low nibble = bg color)
000641r 2               ; Modifies: Flags, A
000641r 2               VideoSetColorImpl:
000641r 2  8D 01 9C       sta VC_REG                    ; Data byte
000644r 2  A9 87          lda #$87                      ; Register 7 | $80 (write mode flag)
000646r 2  8D 01 9C       sta VC_REG
000649r 2  60             rts
00064Ar 2               
00064Ar 2               ; KBDisable — Disable both keyboard encoders for raw port access
00064Ar 2               ; Sets CB2 high (disable matrix encoder) and CA2 high (disable PS/2 encoder)
00064Ar 2               ; Modifies: Flags, A
00064Ar 2               KBDisable:
00064Ar 2  A9 EE          lda #(GPIO_PCR_CB2_HI | GPIO_PCR_CB1_NEG | GPIO_PCR_CA2_HI | GPIO_PCR_CA1_NEG)
00064Cr 2  8D 0C 94       sta GPIO_PCR
00064Fr 2  60             rts
000650r 2               
000650r 2               ; KBEnable — Re-enable both keyboard encoders
000650r 2               ; Sets CB2 low (enable matrix encoder) and CA2 low (enable PS/2 encoder)
000650r 2               ; Modifies: Flags, A
000650r 2               KBEnable:
000650r 2  A9 CC          lda #(GPIO_PCR_CB2_LO | GPIO_PCR_CB1_NEG | GPIO_PCR_CA2_LO | GPIO_PCR_CA1_NEG)
000652r 2  8D 0C 94       sta GPIO_PCR
000655r 2  60             rts
000656r 2               
000656r 2               ; ReadJoystick1 — Read joystick 1 on Port B
000656r 2               ; Temporarily disables matrix keyboard encoder (CB2 high) to read raw port data
000656r 2               ; Output: A = joystick bitmask (bits: R-L-D-U-Y-X-B-A)
000656r 2               ; Modifies: Flags, A, X
000656r 2               ReadJoystick1Impl:
000656r 2  78             sei                           ; Disable interrupts during raw port read
000657r 2  AD 0C 94       lda GPIO_PCR
00065Ar 2  48             pha                           ; Save current PCR state
00065Br 2                 ; Set CB2 high to disable matrix encoder, preserve CA2 state
00065Br 2  A9 EC          lda #(GPIO_PCR_CB2_HI | GPIO_PCR_CB1_NEG | GPIO_PCR_CA2_LO | GPIO_PCR_CA1_NEG)
00065Dr 2  8D 0C 94       sta GPIO_PCR
000660r 2  AD 00 94       lda GPIO_PORTB                ; Read raw joystick data from Port B
000663r 2  AA             tax                           ; Save result in X
000664r 2  68             pla                           ; Restore original PCR state
000665r 2  8D 0C 94       sta GPIO_PCR
000668r 2  8A             txa                           ; Return result in A
000669r 2  58             cli                           ; Re-enable interrupts
00066Ar 2  60             rts
00066Br 2               
00066Br 2               ; ReadJoystick2 — Read joystick 2 on Port A
00066Br 2               ; Temporarily disables PS/2 keyboard encoder (CA2 high) to read raw port data
00066Br 2               ; Output: A = joystick bitmask (bits: R-L-D-U-Y-X-B-A)
00066Br 2               ; Modifies: Flags, A, X
00066Br 2               ReadJoystick2Impl:
00066Br 2  78             sei                           ; Disable interrupts during raw port read
00066Cr 2  AD 0C 94       lda GPIO_PCR
00066Fr 2  48             pha                           ; Save current PCR state
000670r 2                 ; Set CA2 high to disable PS/2 encoder, preserve CB2 state
000670r 2  A9 CE          lda #(GPIO_PCR_CB2_LO | GPIO_PCR_CB1_NEG | GPIO_PCR_CA2_HI | GPIO_PCR_CA1_NEG)
000672r 2  8D 0C 94       sta GPIO_PCR
000675r 2  AD 01 94       lda GPIO_PORTA                ; Read raw joystick data from Port A
000678r 2  AA             tax                           ; Save result in X
000679r 2  68             pla                           ; Restore original PCR state
00067Ar 2  8D 0C 94       sta GPIO_PCR
00067Dr 2  8A             txa                           ; Return result in A
00067Er 2  58             cli                           ; Re-enable interrupts
00067Fr 2  60             rts
000680r 2               
000680r 2               ; === BCD Conversion Helpers ===
000680r 2               
000680r 2               ; BcdToBin — Convert BCD byte to binary
000680r 2               ; Input: A = BCD value (e.g. $35 represents 35)
000680r 2               ; Output: A = binary value (e.g. 35 = $23)
000680r 2               ; Modifies: Flags
000680r 2               BcdToBin:
000680r 2  48             pha
000681r 2  4A             lsr a                         ; Shift tens digit to low nibble
000682r 2  4A             lsr a
000683r 2  4A             lsr a
000684r 2  4A             lsr a                         ; A = tens digit (0-9)
000685r 2  0A             asl a                         ; A = tens * 2
000686r 2  8D 0C 03       sta RTC_TMP
000689r 2  0A             asl a                         ; A = tens * 4
00068Ar 2  0A             asl a                         ; A = tens * 8
00068Br 2  18             clc
00068Cr 2  6D 0C 03       adc RTC_TMP                   ; A = tens * 10 (8 + 2)
00068Fr 2  8D 0C 03       sta RTC_TMP
000692r 2  68             pla
000693r 2  29 0F          and #$0F                      ; A = ones digit
000695r 2  18             clc
000696r 2  6D 0C 03       adc RTC_TMP                   ; A = tens * 10 + ones = binary
000699r 2  60             rts
00069Ar 2               
00069Ar 2               ; BinToBcd — Convert binary byte to BCD
00069Ar 2               ; Input: A = binary value (0-99)
00069Ar 2               ; Output: A = BCD value
00069Ar 2               ; Modifies: Flags, X
00069Ar 2               BinToBcd:
00069Ar 2  A2 FF          ldx #$FF                      ; Tens counter (starts at -1)
00069Cr 2               @BinToBcdLoop:
00069Cr 2  E8             inx
00069Dr 2  38             sec
00069Er 2  E9 0A          sbc #10
0006A0r 2  B0 FA          bcs @BinToBcdLoop             ; Count tens
0006A2r 2  69 0A          adc #10                       ; Restore ones (carry clear, so adds 10 + 0)
0006A4r 2  8D 0C 03       sta RTC_TMP                   ; Save ones digit
0006A7r 2  8A             txa                           ; A = tens digit
0006A8r 2  0A             asl a
0006A9r 2  0A             asl a
0006AAr 2  0A             asl a
0006ABr 2  0A             asl a                         ; Shift tens to high nibble
0006ACr 2  0D 0C 03       ora RTC_TMP                   ; Combine with ones
0006AFr 2  60             rts
0006B0r 2               
0006B0r 2               ; === DS1511Y RTC Routines ===
0006B0r 2               
0006B0r 2               ; RtcReadTime — Read current time from DS1511Y
0006B0r 2               ; Output: A = hours (binary), X = minutes (binary), Y = seconds (binary)
0006B0r 2               ; Modifies: Flags
0006B0r 2               RtcReadTimeImpl:
0006B0r 2  AD 02 88       lda RTC_HR
0006B3r 2  20 rr rr       jsr BcdToBin
0006B6r 2  48             pha                           ; Save hours
0006B7r 2  AD 01 88       lda RTC_MIN
0006BAr 2  20 rr rr       jsr BcdToBin
0006BDr 2  AA             tax                           ; X = minutes
0006BEr 2  AD 00 88       lda RTC_SEC
0006C1r 2  20 rr rr       jsr BcdToBin
0006C4r 2  A8             tay                           ; Y = seconds
0006C5r 2  68             pla                           ; A = hours
0006C6r 2  60             rts
0006C7r 2               
0006C7r 2               ; RtcReadDate — Read current date from DS1511Y
0006C7r 2               ; Output: A = day of month (binary), X = month (binary), Y = year (binary)
0006C7r 2               ;         RTC_BUF_CENT = century (binary)
0006C7r 2               ; Modifies: Flags
0006C7r 2               RtcReadDateImpl:
0006C7r 2  AD 07 88       lda RTC_CENT
0006CAr 2  20 rr rr       jsr BcdToBin
0006CDr 2  8D 0B 03       sta RTC_BUF_CENT              ; Store century in buffer
0006D0r 2  AD 05 88       lda RTC_MON
0006D3r 2  29 1F          and #RTC_MON_MASK             ; Strip control bits (EOSC/E32K/BB32) before BCD decode
0006D5r 2  20 rr rr       jsr BcdToBin
0006D8r 2  AA             tax                           ; X = month
0006D9r 2  AD 06 88       lda RTC_YR
0006DCr 2  20 rr rr       jsr BcdToBin
0006DFr 2  A8             tay                           ; Y = year
0006E0r 2  AD 04 88       lda RTC_DATE
0006E3r 2  20 rr rr       jsr BcdToBin                  ; A = day of month
0006E6r 2  60             rts
0006E7r 2               
0006E7r 2               ; RtcWriteTime — Set DS1511Y time
0006E7r 2               ; Input: A = hours (binary), X = minutes (binary), Y = seconds (binary)
0006E7r 2               ; Modifies: Flags, A, X
0006E7r 2               RtcWriteTimeImpl:
0006E7r 2  48             pha                           ; Save hours
0006E8r 2  DA             phx                           ; Save minutes
0006E9r 2  5A             phy                           ; Save seconds
0006EAr 2                 ; Set TE bit to inhibit update transfers
0006EAr 2  AD 0F 88       lda RTC_CTRL_B
0006EDr 2  09 80          ora #RTC_CTRL_B_TE
0006EFr 2  8D 0F 88       sta RTC_CTRL_B
0006F2r 2                 ; Write seconds
0006F2r 2  68             pla                           ; A = seconds
0006F3r 2  20 rr rr       jsr BinToBcd
0006F6r 2  8D 00 88       sta RTC_SEC
0006F9r 2                 ; Write minutes
0006F9r 2  68             pla                           ; A = minutes
0006FAr 2  20 rr rr       jsr BinToBcd
0006FDr 2  8D 01 88       sta RTC_MIN
000700r 2                 ; Write hours
000700r 2  68             pla                           ; A = hours
000701r 2  20 rr rr       jsr BinToBcd
000704r 2  8D 02 88       sta RTC_HR
000707r 2                 ; Clear TE bit to resume updates
000707r 2  AD 0F 88       lda RTC_CTRL_B
00070Ar 2  29 7F          and #<~RTC_CTRL_B_TE
00070Cr 2  8D 0F 88       sta RTC_CTRL_B
00070Fr 2  60             rts
000710r 2               
000710r 2               ; RtcWriteDate — Set DS1511Y date
000710r 2               ; Input: A = day of month (binary), X = month (binary), Y = year (binary)
000710r 2               ;        RTC_BUF_CENT = century (binary)
000710r 2               ; Modifies: Flags, A, X
000710r 2               RtcWriteDateImpl:
000710r 2  48             pha                           ; Save day
000711r 2  DA             phx                           ; Save month
000712r 2  5A             phy                           ; Save year
000713r 2                 ; Set TE bit to inhibit update transfers
000713r 2  AD 0F 88       lda RTC_CTRL_B
000716r 2  09 80          ora #RTC_CTRL_B_TE
000718r 2  8D 0F 88       sta RTC_CTRL_B
00071Br 2                 ; Write century
00071Br 2  AD 0B 03       lda RTC_BUF_CENT
00071Er 2  20 rr rr       jsr BinToBcd
000721r 2  8D 07 88       sta RTC_CENT
000724r 2                 ; Write year
000724r 2  68             pla                           ; A = year
000725r 2  20 rr rr       jsr BinToBcd
000728r 2  8D 06 88       sta RTC_YR
00072Br 2                 ; Write month
00072Br 2  68             pla                           ; A = month
00072Cr 2  20 rr rr       jsr BinToBcd
00072Fr 2  29 1F          and #RTC_MON_MASK             ; Keep only the month value bits
000731r 2  8D 0C 03       sta RTC_TMP
000734r 2  AD 05 88       lda RTC_MON
000737r 2  29 E0          and #<~RTC_MON_MASK           ; Preserve control bits (EOSC/E32K/BB32)
000739r 2  0D 0C 03       ora RTC_TMP
00073Cr 2  8D 05 88       sta RTC_MON
00073Fr 2                 ; Write day
00073Fr 2  68             pla                           ; A = day
000740r 2  20 rr rr       jsr BinToBcd
000743r 2  8D 04 88       sta RTC_DATE
000746r 2                 ; Clear TE bit to resume updates
000746r 2  AD 0F 88       lda RTC_CTRL_B
000749r 2  29 7F          and #<~RTC_CTRL_B_TE
00074Br 2  8D 0F 88       sta RTC_CTRL_B
00074Er 2  60             rts
00074Fr 2               
00074Fr 2               ; RtcReadNVRAM — Read a byte from DS1511Y NVRAM
00074Fr 2               ; Input: X = NVRAM address ($00-$FF)
00074Fr 2               ; Output: A = data byte
00074Fr 2               ; Modifies: Flags
00074Fr 2               RtcReadNVRAMImpl:
00074Fr 2  8E 10 88       stx RTC_RAM_ADDR
000752r 2  AD 13 88       lda RTC_RAM_DATA
000755r 2  60             rts
000756r 2               
000756r 2               ; RtcWriteNVRAM — Write a byte to DS1511Y NVRAM
000756r 2               ; Input: X = NVRAM address ($00-$FF), A = data byte
000756r 2               ; Modifies: Flags
000756r 2               RtcWriteNVRAMImpl:
000756r 2  8E 10 88       stx RTC_RAM_ADDR
000759r 2  8D 13 88       sta RTC_RAM_DATA
00075Cr 2  60             rts
00075Dr 2               
00075Dr 2               ; === Hardware Probes ===
00075Dr 2               
00075Dr 2               ; ProbeRAM — Test for banked SRAM on IO 1 and IO 2
00075Dr 2               ; Two-pattern read-back test ($A5 then $5A) on bank 0 data byte
00075Dr 2               ; Sets HW_RAM_L / HW_RAM_H in HW_PRESENT on success
00075Dr 2               ; Modifies: Flags, A
00075Dr 2               ProbeRAM:
00075Dr 2                 ; A naive "write byte, immediately read it back" test is unreliable: with no
00075Dr 2                 ; SRAM responding, bus/parasitic capacitance holds the just-written value for
00075Dr 2                 ; a cycle or two, so the read-back matches and the probe falsely passes.
00075Dr 2                 ; Instead we write complementary patterns into TWO different banks, then read
00075Dr 2                 ; them back AFTER intervening bus cycles (opcode fetches from ROM + a second
00075Dr 2                 ; bank's data) have flushed the bus. This forces the chip to actually store
00075Dr 2                 ; distinct values and also exercises the bank-select latch. Open bus cannot
00075Dr 2                 ; fake both reads. Bank-0/bank-1 byte 0 are saved and restored.
00075Dr 2               
00075Dr 2                 ; --- Probe RAM Low (IO 1) ---
00075Dr 2  9C FF 83       stz RAM_BANK_L                ; Bank 0
000760r 2  AD 00 80       lda RAM_DATA_L                ; Save bank-0 byte 0
000763r 2  48             pha
000764r 2  A9 01          lda #$01
000766r 2  8D FF 83       sta RAM_BANK_L                ; Bank 1
000769r 2  AD 00 80       lda RAM_DATA_L                ; Save bank-1 byte 0
00076Cr 2  48             pha
00076Dr 2  9C FF 83       stz RAM_BANK_L               ; Bank 0
000770r 2  A9 A5          lda #$A5
000772r 2  8D 00 80       sta RAM_DATA_L                ; bank0[0] = $A5
000775r 2  A9 01          lda #$01
000777r 2  8D FF 83       sta RAM_BANK_L                ; Bank 1
00077Ar 2  A9 5A          lda #$5A
00077Cr 2  8D 00 80       sta RAM_DATA_L                ; bank1[0] = $5A (flips data + address lines)
00077Fr 2  9C FF 83       stz RAM_BANK_L               ; Back to bank 0
000782r 2  AD 00 80       lda RAM_DATA_L               ; Read bank0[0] (bus no longer holds $A5)
000785r 2  C9 A5          cmp #$A5
000787r 2  D0 14          bne @RAMLRestore             ; Bank 0 did not retain its value
000789r 2  A9 01          lda #$01
00078Br 2  8D FF 83       sta RAM_BANK_L                ; Bank 1
00078Er 2  AD 00 80       lda RAM_DATA_L               ; Read bank1[0]
000791r 2  C9 5A          cmp #$5A
000793r 2  D0 08          bne @RAMLRestore             ; Bank 1 did not retain (or latch failed)
000795r 2  AD 0D 03       lda HW_PRESENT
000798r 2  09 01          ora #HW_RAM_L
00079Ar 2  8D 0D 03       sta HW_PRESENT
00079Dr 2               @RAMLRestore:
00079Dr 2  A9 01          lda #$01
00079Fr 2  8D FF 83       sta RAM_BANK_L                ; Bank 1
0007A2r 2  68             pla
0007A3r 2  8D 00 80       sta RAM_DATA_L                ; Restore bank-1 byte 0
0007A6r 2  9C FF 83       stz RAM_BANK_L               ; Bank 0
0007A9r 2  68             pla
0007AAr 2  8D 00 80       sta RAM_DATA_L                ; Restore bank-0 byte 0
0007ADr 2               
0007ADr 2                 ; --- Probe RAM High (IO 2) ---
0007ADr 2  9C FF 87       stz RAM_BANK_H                ; Bank 0
0007B0r 2  AD 00 84       lda RAM_DATA_H                ; Save bank-0 byte 0
0007B3r 2  48             pha
0007B4r 2  A9 01          lda #$01
0007B6r 2  8D FF 87       sta RAM_BANK_H                ; Bank 1
0007B9r 2  AD 00 84       lda RAM_DATA_H                ; Save bank-1 byte 0
0007BCr 2  48             pha
0007BDr 2  9C FF 87       stz RAM_BANK_H               ; Bank 0
0007C0r 2  A9 A5          lda #$A5
0007C2r 2  8D 00 84       sta RAM_DATA_H                ; bank0[0] = $A5
0007C5r 2  A9 01          lda #$01
0007C7r 2  8D FF 87       sta RAM_BANK_H                ; Bank 1
0007CAr 2  A9 5A          lda #$5A
0007CCr 2  8D 00 84       sta RAM_DATA_H                ; bank1[0] = $5A (flips data + address lines)
0007CFr 2  9C FF 87       stz RAM_BANK_H               ; Back to bank 0
0007D2r 2  AD 00 84       lda RAM_DATA_H               ; Read bank0[0] (bus no longer holds $A5)
0007D5r 2  C9 A5          cmp #$A5
0007D7r 2  D0 14          bne @RAMHRestore             ; Bank 0 did not retain its value
0007D9r 2  A9 01          lda #$01
0007DBr 2  8D FF 87       sta RAM_BANK_H                ; Bank 1
0007DEr 2  AD 00 84       lda RAM_DATA_H               ; Read bank1[0]
0007E1r 2  C9 5A          cmp #$5A
0007E3r 2  D0 08          bne @RAMHRestore             ; Bank 1 did not retain (or latch failed)
0007E5r 2  AD 0D 03       lda HW_PRESENT
0007E8r 2  09 02          ora #HW_RAM_H
0007EAr 2  8D 0D 03       sta HW_PRESENT
0007EDr 2               @RAMHRestore:
0007EDr 2  A9 01          lda #$01
0007EFr 2  8D FF 87       sta RAM_BANK_H                ; Bank 1
0007F2r 2  68             pla
0007F3r 2  8D 00 84       sta RAM_DATA_H                ; Restore bank-1 byte 0
0007F6r 2  9C FF 87       stz RAM_BANK_H               ; Bank 0
0007F9r 2  68             pla
0007FAr 2  8D 00 84       sta RAM_DATA_H                ; Restore bank-0 byte 0
0007FDr 2  60             rts
0007FEr 2               
0007FEr 2               ; ProbeVideo — TMS9918 VRAM read-back test
0007FEr 2               ; Writes $A5 to VRAM address $0000, reads it back
0007FEr 2               ; Sets HW_VID in HW_PRESENT on success
0007FEr 2               ; Modifies: Flags, A
0007FEr 2               ProbeVideo:
0007FEr 2                 ; Write $A5 to VRAM $0000
0007FEr 2  A9 00          lda #$00
000800r 2  8D 01 9C       sta VC_REG                    ; Low byte of address
000803r 2  A9 40          lda #$40                      ; High byte $00 OR $40 for write mode
000805r 2  8D 01 9C       sta VC_REG
000808r 2  A9 A5          lda #$A5
00080Ar 2  8D 00 9C       sta VC_DATA                   ; Write data byte
00080Dr 2                 ; Read back from VRAM $0000
00080Dr 2  A9 00          lda #$00
00080Fr 2  8D 01 9C       sta VC_REG                    ; Low byte of address
000812r 2  A9 00          lda #$00                      ; High byte $00, bit 6 clear for read mode
000814r 2  8D 01 9C       sta VC_REG
000817r 2  AD 00 9C       lda VC_DATA                   ; Read data byte
00081Ar 2  C9 A5          cmp #$A5
00081Cr 2  D0 17          bne @ProbeVideoDone
00081Er 2  AD 0D 03       lda HW_PRESENT
000821r 2  09 80          ora #HW_VID
000823r 2  8D 0D 03       sta HW_PRESENT
000826r 2                 ; Clean up probe byte — write $00 back to VRAM $0000
000826r 2  A9 00          lda #$00
000828r 2  8D 01 9C       sta VC_REG                    ; Low byte of address
00082Br 2  A9 40          lda #$40                      ; High byte $00 OR $40 for write mode
00082Dr 2  8D 01 9C       sta VC_REG
000830r 2  A9 00          lda #$00
000832r 2  8D 00 9C       sta VC_DATA
000835r 2               @ProbeVideoDone:
000835r 2  60             rts
000836r 2               
000836r 2               ; ProbeGPIO — VIA DDR register read-back test
000836r 2               ; Writes $AA to GPIO_DDRB, reads it back
000836r 2               ; Sets HW_GPIO in HW_PRESENT on success
000836r 2               ; Restores GPIO_DDRB to $00 afterward
000836r 2               ; Modifies: Flags, A
000836r 2               ProbeGPIO:
000836r 2  A9 AA          lda #$AA
000838r 2  8D 02 94       sta GPIO_DDRB
00083Br 2  CD 02 94       cmp GPIO_DDRB
00083Er 2  D0 08          bne @ProbeGPIODone
000840r 2  AD 0D 03       lda HW_PRESENT
000843r 2  09 20          ora #HW_GPIO
000845r 2  8D 0D 03       sta HW_PRESENT
000848r 2               @ProbeGPIODone:
000848r 2  9C 02 94       stz GPIO_DDRB                 ; Restore to inputs (InitKBImpl will configure properly)
00084Br 2  60             rts
00084Cr 2               
00084Cr 2               ; ProbeSerial — R65C51 CMD register write/read-back test
00084Cr 2               ; Issues programmatic reset, writes test value to CMD, reads back
00084Cr 2               ; Open bus will not match — prevents false detection
00084Cr 2               ; Sets HW_SC in HW_PRESENT on success
00084Cr 2               ; Modifies: Flags, A
00084Cr 2               ProbeSerial:
00084Cr 2  9C 01 90       stz SC_RESET                  ; Programmatic reset (write any value)
00084Fr 2  A9 0A          lda #$0A                      ; Test value (bits within CMD writable range)
000851r 2  8D 02 90       sta SC_CMD                    ; Write to Command Register
000854r 2  CD 02 90       cmp SC_CMD                    ; Read back — should match if real hardware
000857r 2  D0 08          bne @ProbeSerialDone          ; Mismatch = open bus, no card present
000859r 2  AD 0D 03       lda HW_PRESENT
00085Cr 2  09 10          ora #HW_SC
00085Er 2  8D 0D 03       sta HW_PRESENT
000861r 2               @ProbeSerialDone:
000861r 2  60             rts
000862r 2               
000862r 2               ; ProbeSID — Active oscillator test using voice 3
000862r 2               ; Configures voice 3 noise waveform, brief delay, reads SID_OSC3
000862r 2               ; Non-zero and non-$FF result indicates SID present
000862r 2               ; Sets HW_SID in HW_PRESENT on success
000862r 2               ; Modifies: Flags, A, X, Y
000862r 2               ProbeSID:
000862r 2                 ; Set voice 3 frequency to a fast value
000862r 2  A9 FF          lda #$FF
000864r 2  8D 0E 98       sta SID_V3_FREQ_LO
000867r 2  8D 0F 98       sta SID_V3_FREQ_HI
00086Ar 2                 ; Gate on + noise waveform
00086Ar 2  A9 81          lda #(SID_CTRL_GATE | SID_CTRL_NOISE)
00086Cr 2  8D 12 98       sta SID_V3_CTRL
00086Fr 2                 ; Brief software delay for oscillator to run
00086Fr 2  A0 00          ldy #$00
000871r 2               @ProbeSIDDelay:
000871r 2  88             dey
000872r 2  D0 FD          bne @ProbeSIDDelay            ; ~1280 cycles
000874r 2                 ; Read oscillator 3 output
000874r 2  AD 1B 98       lda SID_OSC3
000877r 2  F0 0E          beq @ProbeSIDCleanup          ; Zero → no SID
000879r 2  C9 FF          cmp #$FF
00087Br 2  F0 0A          beq @ProbeSIDCleanup          ; $FF → likely floating bus
00087Dr 2                 ; SID detected
00087Dr 2  48             pha
00087Er 2  AD 0D 03       lda HW_PRESENT
000881r 2  09 40          ora #HW_SID
000883r 2  8D 0D 03       sta HW_PRESENT
000886r 2  68             pla
000887r 2               @ProbeSIDCleanup:
000887r 2                 ; Silence voice 3
000887r 2  9C 12 98       stz SID_V3_CTRL
00088Ar 2  9C 0E 98       stz SID_V3_FREQ_LO
00088Dr 2  9C 0F 98       stz SID_V3_FREQ_HI
000890r 2  60             rts
000891r 2               
000891r 2               ; ProbeRTC — DS1511Y NVRAM read-back test
000891r 2               ; Writes test pattern to NVRAM address 0, reads it back
000891r 2               ; Sets HW_RTC in HW_PRESENT on success
000891r 2               ; Restores original NVRAM value afterward
000891r 2               ; Modifies: Flags, A
000891r 2               ProbeRTC:
000891r 2  9C 10 88       stz RTC_RAM_ADDR              ; Select NVRAM address 0
000894r 2  AD 13 88       lda RTC_RAM_DATA              ; Save existing value
000897r 2  48             pha
000898r 2  A9 A5          lda #$A5
00089Ar 2  8D 13 88       sta RTC_RAM_DATA              ; Write test pattern
00089Dr 2  CD 13 88       cmp RTC_RAM_DATA              ; Read back
0008A0r 2  D0 12          bne @ProbeRTCDone
0008A2r 2  AD 0D 03       lda HW_PRESENT
0008A5r 2  09 04          ora #HW_RTC
0008A7r 2  8D 0D 03       sta HW_PRESENT
0008AAr 2                 ; The DS1511Y SQW pin feeds the AB Controller, which turns every SQW edge into
0008AAr 2                 ; a 6502 NMI. Its control bits power up undefined and are battery-backed, so
0008AAr 2                 ; explicitly disable the square-wave output here. E32K/BB32/EOSC live in the
0008AAr 2                 ; upper 3 bits of the month register (05H); keep the month value and leave the
0008AAr 2                 ; oscillator running.
0008AAr 2  AD 05 88       lda RTC_MON
0008ADr 2  29 1F          and #RTC_MON_MASK             ; Keep month value (low 5 bits)
0008AFr 2  09 40          ora #RTC_MON_E32K             ; E32K=1 → SQW disabled; BB32=0, EOSC=0
0008B1r 2  8D 05 88       sta RTC_MON
0008B4r 2               @ProbeRTCDone:
0008B4r 2  68             pla
0008B5r 2  8D 13 88       sta RTC_RAM_DATA              ; Restore original value
0008B8r 2  60             rts
0008B9r 2               
0008B9r 2               ; === CompactFlash Storage Driver (True 8-bit IDE Mode) ===
0008B9r 2               
0008B9r 2               ; StWaitReady — Wait for CompactFlash to become ready
0008B9r 2               ; Polls ST_STATUS until BSY=0 and RDY=1, with X/Y timeout (~65536 iterations)
0008B9r 2               ; Output: Carry clear = ready, Carry set = error or timeout
0008B9r 2               ; Modifies: Flags, A, X, Y
0008B9r 2               StWaitReadyImpl:
0008B9r 2  A2 00          ldx #$00                      ; Outer timeout counter (256 × 256 = 65536 iterations)
0008BBr 2  A0 00          ldy #$00
0008BDr 2               @StWaitBsy:
0008BDr 2  AD 07 8C       lda ST_STATUS
0008C0r 2  29 80          and #ST_STATUS_BSY            ; Check BSY bit
0008C2r 2  F0 08          beq @StCheckRdy               ; BSY clear — check RDY
0008C4r 2  88             dey
0008C5r 2  D0 F6          bne @StWaitBsy
0008C7r 2  CA             dex
0008C8r 2  D0 F3          bne @StWaitBsy
0008CAr 2  38             sec                           ; Timed out — no device
0008CBr 2  60             rts
0008CCr 2               @StCheckRdy:
0008CCr 2  AD 07 8C       lda ST_STATUS
0008CFr 2  29 40          and #ST_STATUS_RDY            ; Check RDY bit
0008D1r 2  D0 08          bne @StCheckErr               ; RDY set — check for errors
0008D3r 2  88             dey
0008D4r 2  D0 E7          bne @StWaitBsy
0008D6r 2  CA             dex
0008D7r 2  D0 E4          bne @StWaitBsy
0008D9r 2  38             sec                           ; Timed out
0008DAr 2  60             rts
0008DBr 2               @StCheckErr:
0008DBr 2  AD 07 8C       lda ST_STATUS
0008DEr 2  29 01          and #ST_STATUS_ERR            ; Check ERR bit
0008E0r 2  D0 02          bne @StWaitErr
0008E2r 2  18             clc                           ; Ready, no error
0008E3r 2  60             rts
0008E4r 2               @StWaitErr:
0008E4r 2  38             sec                           ; Error condition
0008E5r 2  60             rts
0008E6r 2               
0008E6r 2               ; StWaitDrq — Wait for CompactFlash data request
0008E6r 2               ; Polls ST_STATUS until BSY=0 and DRQ=1, with X/Y timeout (~65536 iterations)
0008E6r 2               ; Output: Carry clear = DRQ active, Carry set = error or timeout
0008E6r 2               ; Modifies: Flags, A, X, Y
0008E6r 2               StWaitDrq:
0008E6r 2  A2 00          ldx #$00                      ; Outer timeout counter (256 × 256 = 65536 iterations)
0008E8r 2  A0 00          ldy #$00
0008EAr 2               @StDrqBsy:
0008EAr 2  AD 07 8C       lda ST_STATUS
0008EDr 2  29 80          and #ST_STATUS_BSY
0008EFr 2  F0 08          beq @StDrqCheckDrq            ; BSY clear — check DRQ
0008F1r 2  88             dey
0008F2r 2  D0 F6          bne @StDrqBsy
0008F4r 2  CA             dex
0008F5r 2  D0 F3          bne @StDrqBsy
0008F7r 2  38             sec                           ; Timed out — no device
0008F8r 2  60             rts
0008F9r 2               @StDrqCheckDrq:
0008F9r 2  AD 07 8C       lda ST_STATUS
0008FCr 2  29 01          and #ST_STATUS_ERR
0008FEr 2  D0 11          bne @StDrqErr
000900r 2  AD 07 8C       lda ST_STATUS
000903r 2  29 08          and #ST_STATUS_DRQ
000905r 2  D0 08          bne @StDrqOk                  ; DRQ set — ready for data
000907r 2  88             dey
000908r 2  D0 E0          bne @StDrqBsy
00090Ar 2  CA             dex
00090Br 2  D0 DD          bne @StDrqBsy
00090Dr 2  38             sec                           ; Timed out
00090Er 2  60             rts
00090Fr 2               @StDrqOk:
00090Fr 2  18             clc
000910r 2  60             rts
000911r 2               @StDrqErr:
000911r 2  38             sec
000912r 2  60             rts
000913r 2               
000913r 2               ; StInit — Initialize CompactFlash for 8-bit data transfers
000913r 2               ; Issues Set Features command with subcommand $01 (enable 8-bit I/O)
000913r 2               ; Output: Carry clear = success, Carry set = error
000913r 2               ; Modifies: Flags, A
000913r 2               StInit:
000913r 2  20 rr rr       jsr StWaitReady
000916r 2  B0 15          bcs @StInitDone               ; Timeout or error — CF not present
000918r 2                 ; CF responded — set presence flag
000918r 2  AD 0D 03       lda HW_PRESENT
00091Br 2  09 08          ora #HW_CF
00091Dr 2  8D 0D 03       sta HW_PRESENT
000920r 2  A9 01          lda #ST_FEAT_8BIT             ; Feature: enable 8-bit data I/O
000922r 2  8D 01 8C       sta ST_FEATURE
000925r 2  A9 EF          lda #ST_CMD_SET_FEAT          ; Set Features command
000927r 2  8D 07 8C       sta ST_CMD
00092Ar 2  20 rr rr       jsr StWaitReady               ; Wait for command completion
00092Dr 2               @StInitDone:
00092Dr 2  60             rts
00092Er 2               
00092Er 2               ; StSetupLba — Set up LBA registers from CF_LBA zero page variables
00092Er 2               ; Also sets sector count to 1 and selects master drive in LBA mode
00092Er 2               ; Modifies: Flags, A
00092Er 2               StSetupLba:
00092Er 2  A9 01          lda #$01
000930r 2  8D 02 8C       sta ST_SECT_CNT               ; Always 1 sector
000933r 2                 ; Effective LBA = CF_LBA + CF_DISK * FS_DISK_SECTORS (disk banking base offset).
000933r 2                 ; base = CF_DISK << 11: byte0=0, byte1=(CF_DISK<<3)&$FF, byte2=CF_DISK>>5, byte3=0.
000933r 2                 ; Precompute base bits 16-23 (CF_DISK >> 5) into X before any add clobbers carry.
000933r 2  AD 0F 03       lda CF_DISK
000936r 2  4A             lsr a
000937r 2  4A             lsr a
000938r 2  4A             lsr a
000939r 2  4A             lsr a
00093Ar 2  4A             lsr a
00093Br 2  AA             tax                           ; X = CF_DISK >> 5 (disk base, LBA bits 16-23)
00093Cr 2  A5 26          lda CF_LBA
00093Er 2  8D 03 8C       sta ST_LBA_0                  ; LBA bits 0-7 (base low byte is 0)
000941r 2                 ; LBA bits 8-15: CF_LBA+1 + (CF_DISK << 3)
000941r 2  AD 0F 03       lda CF_DISK
000944r 2  0A             asl a
000945r 2  0A             asl a
000946r 2  0A             asl a                         ; A = (CF_DISK << 3) & $FF
000947r 2  18             clc
000948r 2  65 27          adc CF_LBA + 1
00094Ar 2  8D 04 8C       sta ST_LBA_1
00094Dr 2                 ; LBA bits 16-23: CF_LBA+2 + (CF_DISK >> 5) + carry
00094Dr 2  8A             txa
00094Er 2  65 28          adc CF_LBA + 2
000950r 2  8D 05 8C       sta ST_LBA_2
000953r 2                 ; LBA bits 24-27: CF_LBA+3 + carry
000953r 2  A5 29          lda CF_LBA + 3
000955r 2  69 00          adc #$00
000957r 2  29 0F          and #$0F                      ; Mask to 4 bits (LBA 24-27)
000959r 2  09 E0          ora #ST_LBA3_MASTER           ; LBA mode, master drive
00095Br 2  8D 06 8C       sta ST_LBA_3
00095Er 2  60             rts
00095Fr 2               
00095Fr 2               ; StReadSector — Read one 512-byte sector from CompactFlash
00095Fr 2               ; Input: CF_LBA ($26-$29) = LBA address, CF_BUF_PTR ($24-$25) = destination pointer
00095Fr 2               ; Output: Carry clear = success, Carry set = error
00095Fr 2               ;         CF_BUF_PTR advanced by 512 bytes on success
00095Fr 2               ; Modifies: Flags, A, X, Y
00095Fr 2               StReadSectorImpl:
00095Fr 2  20 rr rr       jsr StWaitReady
000962r 2  B0 1F          bcs @StReadDone
000964r 2  20 rr rr       jsr StSetupLba
000967r 2  A9 20          lda #ST_CMD_READ              ; Issue read command
000969r 2  8D 07 8C       sta ST_CMD
00096Cr 2  20 rr rr       jsr StWaitDrq                 ; Wait for data ready
00096Fr 2  B0 12          bcs @StReadDone
000971r 2                 ; Read 512 bytes: 2 pages of 256 bytes
000971r 2  A0 00          ldy #$00
000973r 2  A2 02          ldx #$02                      ; 2 pages
000975r 2               @StReadPage:
000975r 2  AD 00 8C       lda ST_DATA                   ; Read byte from CF
000978r 2  91 24          sta (CF_BUF_PTR),y            ; Store to destination
00097Ar 2  C8             iny
00097Br 2  D0 F8          bne @StReadPage               ; Loop for 256 bytes
00097Dr 2  E6 25          inc CF_BUF_PTR + 1            ; Next page
00097Fr 2  CA             dex
000980r 2  D0 F3          bne @StReadPage
000982r 2  18             clc                           ; Success
000983r 2               @StReadDone:
000983r 2  60             rts
000984r 2               
000984r 2               ; StWriteSector — Write one 512-byte sector to CompactFlash
000984r 2               ; Input: CF_LBA ($26-$29) = LBA address, CF_BUF_PTR ($24-$25) = source pointer
000984r 2               ; Output: Carry clear = success, Carry set = error
000984r 2               ;         CF_BUF_PTR advanced by 512 bytes on success
000984r 2               ; Modifies: Flags, A, X, Y
000984r 2               StWriteSectorImpl:
000984r 2  20 rr rr       jsr StWaitReady
000987r 2  B0 21          bcs @StWriteDone
000989r 2  20 rr rr       jsr StSetupLba
00098Cr 2  A9 30          lda #ST_CMD_WRITE             ; Issue write command
00098Er 2  8D 07 8C       sta ST_CMD
000991r 2  20 rr rr       jsr StWaitDrq                 ; Wait for data request
000994r 2  B0 14          bcs @StWriteDone
000996r 2                 ; Write 512 bytes: 2 pages of 256 bytes
000996r 2  A0 00          ldy #$00
000998r 2  A2 02          ldx #$02                      ; 2 pages
00099Ar 2               @StWritePage:
00099Ar 2  B1 24          lda (CF_BUF_PTR),y            ; Load from source
00099Cr 2  8D 00 8C       sta ST_DATA                   ; Write byte to CF
00099Fr 2  C8             iny
0009A0r 2  D0 F8          bne @StWritePage              ; Loop for 256 bytes
0009A2r 2  E6 25          inc CF_BUF_PTR + 1            ; Next page
0009A4r 2  CA             dex
0009A5r 2  D0 F3          bne @StWritePage
0009A7r 2  20 rr rr       jsr StWaitReady               ; Wait for write to complete
0009AAr 2               @StWriteDone:
0009AAr 2  60             rts
0009ABr 2               
0009ABr 2               ; === Simple Custom Filesystem ===
0009ABr 2               ; Directory at LBA 0: 16 entries x 32 bytes = 512 bytes
0009ABr 2               ; Entry format:
0009ABr 2               ;   $00-$07: 8-byte filename (space-padded)
0009ABr 2               ;   $08-$0A: 3-byte extension (space-padded)
0009ABr 2               ;   $0B:     flags (bit 0 = in use)
0009ABr 2               ;   $0C-$0D: start sector (little-endian)
0009ABr 2               ;   $0E-$0F: file size in bytes (little-endian)
0009ABr 2               ;   $10-$1F: reserved (16 bytes)
0009ABr 2               
0009ABr 2               ; FsParseName — Parse null-terminated filename at STR_PTR into FS_FNAME_BUF
0009ABr 2               ; Converts "NAME.EXT" into 8+3 space-padded format
0009ABr 2               ; Input: STR_PTR ($02-$03) points to null-terminated filename
0009ABr 2               ; Output: FS_FNAME_BUF filled with padded 8+3 name
0009ABr 2               ; Modifies: Flags, A, X, Y
0009ABr 2               ; The extension is inert: it is split on the dot, padded into the directory
0009ABr 2               ; fields, and matched by FsFindFile's flat 11-byte compare.  Nothing anywhere
0009ABr 2               ; branches on it, so .PRG / .BAS / .FOO all behave identically — what a file
0009ABr 2               ; means is decided by the command that loads it (LOAD vs BLOAD), never by name.
0009ABr 2               FsParseName:
0009ABr 2                 ; Fill FS_FNAME_BUF with spaces
0009ABr 2  A9 20          lda #$20
0009ADr 2  A2 0A          ldx #10
0009AFr 2               @FsParseClr:
0009AFr 2  9D 50 03       sta FS_FNAME_BUF,x
0009B2r 2  CA             dex
0009B3r 2  10 FA          bpl @FsParseClr
0009B5r 2                 ; Copy name part (up to 8 chars, stop at '.' or null)
0009B5r 2  A0 00          ldy #$00                      ; Source index
0009B7r 2  A2 00          ldx #$00                      ; Dest index (name portion)
0009B9r 2               @FsParseName:
0009B9r 2  B1 02          lda (STR_PTR),y
0009BBr 2  F0 35          beq @FsParseDone              ; Null terminator — no extension
0009BDr 2  C9 2E          cmp #'.'
0009BFr 2  F0 15          beq @FsParseExt               ; Found dot — start extension
0009C1r 2  E0 08          cpx #$08
0009C3r 2  B0 0E          bcs @FsParseSkipName          ; Already 8 chars, skip extras
0009C5r 2                 ; Convert lowercase to uppercase
0009C5r 2  C9 61          cmp #'a'
0009C7r 2  90 06          bcc @FsStoreNameChar
0009C9r 2  C9 7B          cmp #'z' + 1
0009CBr 2  B0 02          bcs @FsStoreNameChar
0009CDr 2  29 DF          and #$DF                      ; Clear bit 5 to uppercase
0009CFr 2               @FsStoreNameChar:
0009CFr 2  9D 50 03       sta FS_FNAME_BUF,x
0009D2r 2  E8             inx
0009D3r 2               @FsParseSkipName:
0009D3r 2  C8             iny
0009D4r 2  80 E3          bra @FsParseName
0009D6r 2               @FsParseExt:
0009D6r 2  C8             iny                           ; Skip the dot
0009D7r 2  A2 08          ldx #$08                      ; Extension starts at offset 8
0009D9r 2               @FsParseExtLoop:
0009D9r 2  B1 02          lda (STR_PTR),y
0009DBr 2  F0 15          beq @FsParseDone              ; Null terminator
0009DDr 2  E0 0B          cpx #$0B
0009DFr 2  B0 11          bcs @FsParseDone              ; Max 3 ext chars
0009E1r 2                 ; Convert lowercase to uppercase
0009E1r 2  C9 61          cmp #'a'
0009E3r 2  90 06          bcc @FsStoreExtChar
0009E5r 2  C9 7B          cmp #'z' + 1
0009E7r 2  B0 02          bcs @FsStoreExtChar
0009E9r 2  29 DF          and #$DF
0009EBr 2               @FsStoreExtChar:
0009EBr 2  9D 50 03       sta FS_FNAME_BUF,x
0009EEr 2  E8             inx
0009EFr 2  C8             iny
0009F0r 2  80 E7          bra @FsParseExtLoop
0009F2r 2               @FsParseDone:
0009F2r 2  60             rts
0009F3r 2               
0009F3r 2               ; FsReadDir — Read directory sector (LBA 0) into FS_SECTOR_BUF
0009F3r 2               ; Output: Carry clear = success, Carry set = error
0009F3r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
0009F3r 2               FsReadDir:
0009F3r 2  64 26          stz CF_LBA                    ; LBA = 0 (directory sector)
0009F5r 2  64 27          stz CF_LBA + 1
0009F7r 2  64 28          stz CF_LBA + 2
0009F9r 2  64 29          stz CF_LBA + 3
0009FBr 2  A9 00          lda #<FS_SECTOR_BUF
0009FDr 2  85 24          sta CF_BUF_PTR
0009FFr 2  A9 06          lda #>FS_SECTOR_BUF
000A01r 2  85 25          sta CF_BUF_PTR + 1
000A03r 2  4C rr rr       jmp StReadSector
000A06r 2               
000A06r 2               ; FsWriteDir — Write directory sector from FS_SECTOR_BUF to LBA 0
000A06r 2               ; Output: Carry clear = success, Carry set = error
000A06r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
000A06r 2               FsWriteDir:
000A06r 2  64 26          stz CF_LBA
000A08r 2  64 27          stz CF_LBA + 1
000A0Ar 2  64 28          stz CF_LBA + 2
000A0Cr 2  64 29          stz CF_LBA + 3
000A0Er 2  A9 00          lda #<FS_SECTOR_BUF
000A10r 2  85 24          sta CF_BUF_PTR
000A12r 2  A9 06          lda #>FS_SECTOR_BUF
000A14r 2  85 25          sta CF_BUF_PTR + 1
000A16r 2  4C rr rr       jmp StWriteSector
000A19r 2               
000A19r 2               ; FsFindFile — Search directory for filename in FS_FNAME_BUF
000A19r 2               ; Must call FsReadDir first to load directory into FS_SECTOR_BUF
000A19r 2               ; Output: Carry clear = found, X = entry index (0-15), CF_BUF_PTR points to entry
000A19r 2               ;         Carry set = not found
000A19r 2               ; Modifies: Flags, A, X, Y, CF_BUF_PTR
000A19r 2               FsFindFile:
000A19r 2  A9 00          lda #<FS_SECTOR_BUF
000A1Br 2  85 24          sta CF_BUF_PTR
000A1Dr 2  A9 06          lda #>FS_SECTOR_BUF
000A1Fr 2  85 25          sta CF_BUF_PTR + 1
000A21r 2  A2 00          ldx #$00                      ; Entry index
000A23r 2               @FsFindLoop:
000A23r 2                 ; Check if entry is in use
000A23r 2  A0 0B          ldy #FS_ENTRY_FLAGS
000A25r 2  B1 24          lda (CF_BUF_PTR),y
000A27r 2  29 01          and #FS_FLAG_USED
000A29r 2  F0 13          beq @FsFindNext               ; Skip unused entries
000A2Br 2                 ; Compare 11-byte filename
000A2Br 2  A0 00          ldy #$00
000A2Dr 2               @FsFindCmp:
000A2Dr 2  B1 24          lda (CF_BUF_PTR),y
000A2Fr 2  D9 50 03       cmp FS_FNAME_BUF,y
000A32r 2  D0 0A          bne @FsFindNext               ; Mismatch
000A34r 2  C8             iny
000A35r 2  C0 0B          cpy #11
000A37r 2  D0 F4          bne @FsFindCmp
000A39r 2                 ; Match found
000A39r 2  8E 4D 03       stx FS_DIR_IDX
000A3Cr 2  18             clc
000A3Dr 2  60             rts
000A3Er 2               @FsFindNext:
000A3Er 2                 ; Advance CF_BUF_PTR by 32 (FS_ENTRY_SIZE)
000A3Er 2  A5 24          lda CF_BUF_PTR
000A40r 2  18             clc
000A41r 2  69 20          adc #FS_ENTRY_SIZE
000A43r 2  85 24          sta CF_BUF_PTR
000A45r 2  90 02          bcc @FsFindNoCarry
000A47r 2  E6 25          inc CF_BUF_PTR + 1
000A49r 2               @FsFindNoCarry:
000A49r 2  E8             inx
000A4Ar 2  E0 10          cpx #FS_MAX_FILES
000A4Cr 2  D0 D5          bne @FsFindLoop
000A4Er 2  38             sec                           ; Not found
000A4Fr 2  60             rts
000A50r 2               
000A50r 2               ; FsFindFree — Find first free directory entry
000A50r 2               ; Must call FsReadDir first
000A50r 2               ; Output: Carry clear = found, X = entry index, CF_BUF_PTR points to entry
000A50r 2               ;         Carry set = directory full
000A50r 2               ; Modifies: Flags, A, X, Y, CF_BUF_PTR
000A50r 2               FsFindFree:
000A50r 2  A9 00          lda #<FS_SECTOR_BUF
000A52r 2  85 24          sta CF_BUF_PTR
000A54r 2  A9 06          lda #>FS_SECTOR_BUF
000A56r 2  85 25          sta CF_BUF_PTR + 1
000A58r 2  A2 00          ldx #$00
000A5Ar 2               @FsFreeLoop:
000A5Ar 2  A0 0B          ldy #FS_ENTRY_FLAGS
000A5Cr 2  B1 24          lda (CF_BUF_PTR),y
000A5Er 2  29 01          and #FS_FLAG_USED
000A60r 2  F0 12          beq @FsFreeFound              ; Found unused entry
000A62r 2                 ; Advance by 32
000A62r 2  A5 24          lda CF_BUF_PTR
000A64r 2  18             clc
000A65r 2  69 20          adc #FS_ENTRY_SIZE
000A67r 2  85 24          sta CF_BUF_PTR
000A69r 2  90 02          bcc @FsFreeNoCarry
000A6Br 2  E6 25          inc CF_BUF_PTR + 1
000A6Dr 2               @FsFreeNoCarry:
000A6Dr 2  E8             inx
000A6Er 2  E0 10          cpx #FS_MAX_FILES
000A70r 2  D0 E8          bne @FsFreeLoop
000A72r 2  38             sec                           ; Directory full
000A73r 2  60             rts
000A74r 2               @FsFreeFound:
000A74r 2  8E 4D 03       stx FS_DIR_IDX
000A77r 2  18             clc
000A78r 2  60             rts
000A79r 2               
000A79r 2               ; FsCalcNextSec — Calculate next free sector by scanning all directory entries
000A79r 2               ; Must call FsReadDir first
000A79r 2               ; Output: FS_NEXT_SEC = first free sector after all used files
000A79r 2               ; Modifies: Flags, A, X, Y
000A79r 2               FsCalcNextSec:
000A79r 2  A9 01          lda #<FS_DATA_START           ; Start with first data sector
000A7Br 2  8D 4E 03       sta FS_NEXT_SEC
000A7Er 2  A9 00          lda #>FS_DATA_START
000A80r 2  8D 4F 03       sta FS_NEXT_SEC + 1
000A83r 2                 ; Scan all entries to find highest used sector + file sector count
000A83r 2  A9 00          lda #<FS_SECTOR_BUF
000A85r 2  85 24          sta CF_BUF_PTR
000A87r 2  A9 06          lda #>FS_SECTOR_BUF
000A89r 2  85 25          sta CF_BUF_PTR + 1
000A8Br 2  A2 00          ldx #$00
000A8Dr 2               @FsCalcLoop:
000A8Dr 2  A0 0B          ldy #FS_ENTRY_FLAGS
000A8Fr 2  B1 24          lda (CF_BUF_PTR),y
000A91r 2  29 01          and #FS_FLAG_USED
000A93r 2  F0 5D          beq @FsCalcNext               ; Skip unused
000A95r 2                 ; Get start sector + ceil(size/512)
000A95r 2  A0 0C          ldy #FS_ENTRY_START
000A97r 2  B1 24          lda (CF_BUF_PTR),y
000A99r 2  8D 48 03       sta FS_START_SEC
000A9Cr 2  C8             iny
000A9Dr 2  B1 24          lda (CF_BUF_PTR),y
000A9Fr 2  8D 49 03       sta FS_START_SEC + 1
000AA2r 2                 ; Get file size
000AA2r 2  A0 0E          ldy #FS_ENTRY_FSIZE
000AA4r 2  B1 24          lda (CF_BUF_PTR),y
000AA6r 2  8D 4A 03       sta FS_FILE_SIZE
000AA9r 2  C8             iny
000AAAr 2  B1 24          lda (CF_BUF_PTR),y
000AACr 2  8D 4B 03       sta FS_FILE_SIZE + 1
000AAFr 2                 ; Calculate sectors used = (size + 511) / 512 = (size + 511) >> 9
000AAFr 2                 ; = (size_hi + 1) if size_lo > 0, else size_hi / 2... simplify:
000AAFr 2                 ; sectors = (size >> 9) rounded up = high_byte >> 1, plus 1 if any remainder
000AAFr 2  AD 4B 03       lda FS_FILE_SIZE + 1          ; High byte of size
000AB2r 2  4A             lsr a                         ; Divide by 2 (each sector = 512 = 2 pages)
000AB3r 2  8D 4C 03       sta FS_SEC_COUNT
000AB6r 2                 ; Check if there's a remainder (low byte != 0 or high byte bit 0 was set)
000AB6r 2  AD 4B 03       lda FS_FILE_SIZE + 1
000AB9r 2  29 01          and #$01                      ; Was high byte odd?
000ABBr 2  D0 05          bne @FsCalcRound
000ABDr 2  AD 4A 03       lda FS_FILE_SIZE              ; Low byte non-zero?
000AC0r 2  F0 03          beq @FsCalcNoRound
000AC2r 2               @FsCalcRound:
000AC2r 2  EE 4C 03       inc FS_SEC_COUNT              ; Round up
000AC5r 2               @FsCalcNoRound:
000AC5r 2                 ; End sector = start + sector count.
000AC5r 2                 ; NOTE: X holds the directory-entry loop counter, so the end sector must
000AC5r 2                 ; NOT be kept in X (doing so ran the scan off the end of the directory
000AC5r 2                 ; buffer into program memory, corrupting FS_NEXT_SEC and causing spurious
000AC5r 2                 ; ?SAVE ERROR after a few files).  Stash it in memory scratch instead:
000AC5r 2                 ; FS_SEC_COUNT (end low) and FS_DIR_IDX (end high) are both free here.
000AC5r 2  AD 48 03       lda FS_START_SEC
000AC8r 2  18             clc
000AC9r 2  6D 4C 03       adc FS_SEC_COUNT
000ACCr 2  8D 4C 03       sta FS_SEC_COUNT              ; end sector low (reuse as scratch)
000ACFr 2  AD 49 03       lda FS_START_SEC + 1
000AD2r 2  69 00          adc #$00
000AD4r 2  8D 4D 03       sta FS_DIR_IDX               ; end sector high (reuse as scratch)
000AD7r 2                 ; Compare with FS_NEXT_SEC — keep the larger value
000AD7r 2  CD 4F 03       cmp FS_NEXT_SEC + 1
000ADAr 2  90 16          bcc @FsCalcNext               ; End high < FS_NEXT_SEC high, skip
000ADCr 2  D0 08          bne @FsCalcUpdate             ; End high > FS_NEXT_SEC high, update
000ADEr 2  AD 4C 03       lda FS_SEC_COUNT
000AE1r 2  CD 4E 03       cmp FS_NEXT_SEC
000AE4r 2  90 0C          bcc @FsCalcNext               ; End low < FS_NEXT_SEC low, skip
000AE6r 2               @FsCalcUpdate:
000AE6r 2  AD 4C 03       lda FS_SEC_COUNT
000AE9r 2  8D 4E 03       sta FS_NEXT_SEC
000AECr 2  AD 4D 03       lda FS_DIR_IDX
000AEFr 2  8D 4F 03       sta FS_NEXT_SEC + 1
000AF2r 2               @FsCalcNext:
000AF2r 2                 ; Advance CF_BUF_PTR by 32
000AF2r 2  A5 24          lda CF_BUF_PTR
000AF4r 2  18             clc
000AF5r 2  69 20          adc #FS_ENTRY_SIZE
000AF7r 2  85 24          sta CF_BUF_PTR
000AF9r 2  90 02          bcc @FsCalcNoCarry
000AFBr 2  E6 25          inc CF_BUF_PTR + 1
000AFDr 2               @FsCalcNoCarry:
000AFDr 2  E8             inx
000AFEr 2  E0 10          cpx #FS_MAX_FILES
000B00r 2  D0 8B          bne @FsCalcLoop
000B02r 2  60             rts
000B03r 2               
000B03r 2               ; FsDirectory — Print directory listing of all used entries
000B03r 2               ; Output via Chrout (respects current IO_MODE)
000B03r 2               ; Modifies: Flags, A, X, Y
000B03r 2               FsDirectory:
000B03r 2  20 rr rr       jsr FsReadDir                 ; Load directory sector
000B06r 2  90 01          bcc @FsDirStart
000B08r 2  60             rts                           ; Error reading directory
000B09r 2               @FsDirStart:
000B09r 2  20 rr rr       jsr FsPrintDiskImpl           ; Print "DISK n" header
000B0Cr 2  A9 00          lda #<FS_SECTOR_BUF
000B0Er 2  85 24          sta CF_BUF_PTR
000B10r 2  A9 06          lda #>FS_SECTOR_BUF
000B12r 2  85 25          sta CF_BUF_PTR + 1
000B14r 2  A2 00          ldx #$00                      ; Entry counter
000B16r 2               @FsDirLoop:
000B16r 2  DA             phx
000B17r 2  A0 0B          ldy #FS_ENTRY_FLAGS
000B19r 2  B1 24          lda (CF_BUF_PTR),y
000B1Br 2  29 01          and #FS_FLAG_USED
000B1Dr 2  F0 3A          beq @FsDirNext                ; Skip unused entries
000B1Fr 2                 ; Print filename (8 chars)
000B1Fr 2  A0 00          ldy #$00
000B21r 2               @FsDirName:
000B21r 2  B1 24          lda (CF_BUF_PTR),y
000B23r 2  20 rr rr       jsr Chrout
000B26r 2  C8             iny
000B27r 2  C0 08          cpy #$08
000B29r 2  D0 F6          bne @FsDirName
000B2Br 2                 ; Print dot separator
000B2Br 2  A9 2E          lda #'.'
000B2Dr 2  20 rr rr       jsr Chrout
000B30r 2                 ; Print extension (3 chars)
000B30r 2               @FsDirExt:
000B30r 2  B1 24          lda (CF_BUF_PTR),y
000B32r 2  20 rr rr       jsr Chrout
000B35r 2  C8             iny
000B36r 2  C0 0B          cpy #$0B
000B38r 2  D0 F6          bne @FsDirExt
000B3Ar 2                 ; Print space
000B3Ar 2  A9 20          lda #' '
000B3Cr 2  20 rr rr       jsr Chrout
000B3Fr 2                 ; Print file size in decimal
000B3Fr 2  A0 0E          ldy #FS_ENTRY_FSIZE
000B41r 2  B1 24          lda (CF_BUF_PTR),y
000B43r 2  8D 4A 03       sta FS_FILE_SIZE
000B46r 2  C8             iny
000B47r 2  B1 24          lda (CF_BUF_PTR),y
000B49r 2  8D 4B 03       sta FS_FILE_SIZE + 1
000B4Cr 2  20 rr rr       jsr FsPrintSize
000B4Fr 2                 ; Print newline
000B4Fr 2  A9 0D          lda #$0D
000B51r 2  20 rr rr       jsr Chrout
000B54r 2  A9 0A          lda #$0A
000B56r 2  20 rr rr       jsr Chrout
000B59r 2               @FsDirNext:
000B59r 2                 ; Advance CF_BUF_PTR by 32
000B59r 2  A5 24          lda CF_BUF_PTR
000B5Br 2  18             clc
000B5Cr 2  69 20          adc #FS_ENTRY_SIZE
000B5Er 2  85 24          sta CF_BUF_PTR
000B60r 2  90 02          bcc @FsDirNoCarry
000B62r 2  E6 25          inc CF_BUF_PTR + 1
000B64r 2               @FsDirNoCarry:
000B64r 2  FA             plx
000B65r 2  E8             inx
000B66r 2  E0 10          cpx #FS_MAX_FILES
000B68r 2  D0 AC          bne @FsDirLoop
000B6Ar 2  60             rts
000B6Br 2               
000B6Br 2               ; PrintDecU16 — Print an unsigned 16-bit value as decimal (no leading zeros).
000B6Br 2               ; General-purpose console output; used by BASIC (line numbers) and available
000B6Br 2               ; to cartridges.  Shares the FsPrintSize core below.
000B6Br 2               ; Input : A = value low, X = value high
000B6Br 2               ; Modifies: Flags, A, X, Y, FS_FILE_SIZE (consumed), FS_DIR_IDX
000B6Br 2               PrintDecU16Impl:
000B6Br 2  8D 4A 03       sta FS_FILE_SIZE
000B6Er 2  8E 4B 03       stx FS_FILE_SIZE + 1
000B71r 2                 ; fall through to the shared decimal-print core
000B71r 2               ; FsPrintSize — Print 16-bit value in FS_FILE_SIZE as decimal
000B71r 2               ; Modifies: Flags, A, X, Y
000B71r 2               FsPrintSize:
000B71r 2                 ; Convert 16-bit value to decimal digits (up to 5 digits for 0-65535)
000B71r 2                 ; Use successive subtraction of powers of 10
000B71r 2  A2 00          ldx #$00                      ; Digit index / leading zero suppression
000B73r 2  A0 00          ldy #$00                      ; Power-of-10 table index
000B75r 2               @FsPrintSizeLoop:
000B75r 2  A9 2F          lda #'0' - 1                  ; Start character below '0'
000B77r 2  8D 4D 03       sta FS_DIR_IDX                ; Reuse as digit scratch
000B7Ar 2               @FsPrintSub:
000B7Ar 2  EE 4D 03       inc FS_DIR_IDX
000B7Dr 2  AD 4A 03       lda FS_FILE_SIZE
000B80r 2  38             sec
000B81r 2  F9 rr rr       sbc @FsPow10Lo,y
000B84r 2  48             pha
000B85r 2  AD 4B 03       lda FS_FILE_SIZE + 1
000B88r 2  F9 rr rr       sbc @FsPow10Hi,y
000B8Br 2  90 09          bcc @FsPrintSizeDig           ; Underflow — done subtracting
000B8Dr 2  8D 4B 03       sta FS_FILE_SIZE + 1
000B90r 2  68             pla
000B91r 2  8D 4A 03       sta FS_FILE_SIZE
000B94r 2  80 E4          bra @FsPrintSub
000B96r 2               @FsPrintSizeDig:
000B96r 2  68             pla                           ; Discard underflowed low byte
000B97r 2  AD 4D 03       lda FS_DIR_IDX
000B9Ar 2  C9 30          cmp #'0'
000B9Cr 2  D0 04          bne @FsPrintSizeOut           ; Non-zero digit
000B9Er 2  E0 00          cpx #$00
000BA0r 2  F0 04          beq @FsPrintSizeSkip          ; Suppress leading zeros
000BA2r 2               @FsPrintSizeOut:
000BA2r 2  20 rr rr       jsr Chrout
000BA5r 2  E8             inx                           ; Mark that we've printed a digit
000BA6r 2               @FsPrintSizeSkip:
000BA6r 2  C8             iny
000BA7r 2  C0 04          cpy #$04                      ; 4 powers of 10 (10000, 1000, 100, 10)
000BA9r 2  D0 CA          bne @FsPrintSizeLoop
000BABr 2                 ; Always print ones digit
000BABr 2  AD 4A 03       lda FS_FILE_SIZE
000BAEr 2  09 30          ora #'0'                      ; Low byte is 0-9 at this point
000BB0r 2  20 rr rr       jsr Chrout
000BB3r 2  60             rts
000BB4r 2  10 E8 64 0A  @FsPow10Lo: .byte <10000, <1000, <100, <10
000BB8r 2  27 03 00 00  @FsPow10Hi: .byte >10000, >1000, >100, >10
000BBCr 2               
000BBCr 2               ; FsSetDiskImpl — Select the current CF disk bank
000BBCr 2               ; Input: A = disk number (0-255)
000BBCr 2               ; Modifies: Flags
000BBCr 2               FsSetDiskImpl:
000BBCr 2  8D 0F 03       sta CF_DISK
000BBFr 2  60             rts
000BC0r 2               
000BC0r 2               ; FsGetDiskImpl — Get the current CF disk bank
000BC0r 2               ; Output: A = current disk number
000BC0r 2               ; Modifies: Flags, A
000BC0r 2               FsGetDiskImpl:
000BC0r 2  AD 0F 03       lda CF_DISK
000BC3r 2  60             rts
000BC4r 2               
000BC4r 2               ; FsFormatDiskImpl — Zero the current disk's directory sector (erases its file list)
000BC4r 2               ; Output: Carry clear = success, Carry set = write error
000BC4r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
000BC4r 2               FsFormatDiskImpl:
000BC4r 2  A9 00          lda #<FS_SECTOR_BUF
000BC6r 2  85 24          sta CF_BUF_PTR
000BC8r 2  A9 06          lda #>FS_SECTOR_BUF
000BCAr 2  85 25          sta CF_BUF_PTR + 1
000BCCr 2  A0 00          ldy #$00
000BCEr 2  A2 02          ldx #$02                      ; 2 pages = 512 bytes
000BD0r 2  A9 00          lda #$00
000BD2r 2               @FsFormatClr:
000BD2r 2  91 24          sta (CF_BUF_PTR),y
000BD4r 2  C8             iny
000BD5r 2  D0 FB          bne @FsFormatClr
000BD7r 2  E6 25          inc CF_BUF_PTR + 1
000BD9r 2  CA             dex
000BDAr 2  D0 F6          bne @FsFormatClr
000BDCr 2  4C rr rr       jmp FsWriteDir                ; Write zeroed directory sector (returns carry status)
000BDFr 2               
000BDFr 2               ; FsPrintDiskImpl — Print "DISK n" (decimal) + CRLF via Chrout
000BDFr 2               ; Modifies: Flags, A, X, Y, FS_FILE_SIZE, FS_DIR_IDX
000BDFr 2               FsPrintDiskImpl:
000BDFr 2  A0 00          ldy #$00
000BE1r 2               @FsPDLbl:
000BE1r 2  B9 rr rr       lda FsDiskLbl,y
000BE4r 2  F0 06          beq @FsPDNum
000BE6r 2  20 rr rr       jsr Chrout
000BE9r 2  C8             iny
000BEAr 2  80 F5          bra @FsPDLbl
000BECr 2               @FsPDNum:
000BECr 2  AD 0F 03       lda CF_DISK
000BEFr 2  8D 4A 03       sta FS_FILE_SIZE
000BF2r 2  9C 4B 03       stz FS_FILE_SIZE + 1
000BF5r 2  20 rr rr       jsr FsPrintSize               ; Print CF_DISK as decimal (0-255, no leading zeros)
000BF8r 2  A9 0D          lda #$0D
000BFAr 2  20 rr rr       jsr Chrout
000BFDr 2  A9 0A          lda #$0A
000BFFr 2  4C rr rr       jmp Chrout
000C02r 2  44 49 53 4B  FsDiskLbl: .byte "DISK ", 0
000C06r 2  20 00        
000C08r 2               
000C08r 2               ; === BASIC command glue (thin handlers dispatched from BASIC) ===
000C08r 2               ; These implement the BASIC statements DISK/BLOAD/BSAVE/FORMAT.  The bodies
000C08r 2               ; live here (Kernal has room) while BASIC keeps only the keyword strings and a
000C08r 2               ; tiny dispatch stub.  Each is entered via the BASIC statement trampoline with
000C08r 2               ; TXTPTR at the first argument char (ChrGot state); argument parsing uses the
000C08r 2               ; BASIC evaluator routines (all sources assemble as one unit, so the labels
000C08r 2               ; resolve directly).
000C08r 2               
000C08r 2               ; BasExtAddrTbl — dispatch targets for extended statement tokens $D1-$D4.
000C08r 2               ; Entries are (handler-1) for the BASIC "push + JMP ChrGet -> RTS" trampoline.
000C08r 2               BasExtAddrTbl:
000C08r 2  rr rr          .word KBasCmdDisk - 1          ; $D1 DISK
000C0Ar 2  rr rr          .word KBasCmdBload - 1         ; $D2 BLOAD
000C0Cr 2  rr rr          .word KBasCmdBsave - 1         ; $D3 BSAVE
000C0Er 2  rr rr          .word KBasCmdFormat - 1        ; $D4 FORMAT
000C10r 2               
000C10r 2               ; DISK n — select the current CF disk bank (0-255)
000C10r 2               KBasCmdDisk:
000C10r 2  20 rr rr       jsr GetByt                     ; X = value 0-255
000C13r 2  8E 0F 03       stx CF_DISK
000C16r 2  60             rts
000C17r 2               
000C17r 2               ; BLOAD addr, "name" — load a file's raw bytes to addr
000C17r 2               KBasCmdBload:
000C17r 2  A9 08          lda #HW_CF
000C19r 2  20 rr rr       jsr ReqHw
000C1Cr 2  20 rr rr       jsr EvalAddrU16                ; FAC+3 = hi, FAC+4 = lo
000C1Fr 2  A5 12          lda z:FAC + 4
000C21r 2  8D 7F 03       sta FS_IO_ADDR
000C24r 2  A5 11          lda z:FAC + 3
000C26r 2  8D 80 03       sta FS_IO_ADDR + 1
000C29r 2  20 rr rr       jsr ChkCom
000C2Cr 2  20 rr rr       jsr EvalString                 ; filename -> BAS_FNAME, STR_PTR
000C2Fr 2  20 rr rr       jsr FsLoadFileAddr
000C32r 2  B0 01          bcs @KBloadErr
000C34r 2  60             rts
000C35r 2               @KBloadErr:
000C35r 2  A9 rr          lda #<MsgLoadErr
000C37r 2  A0 rr          ldy #>MsgLoadErr
000C39r 2  4C rr rr       jmp BasPrintStr
000C3Cr 2               
000C3Cr 2               ; BSAVE addr, len, "name" — save len bytes from addr to a file
000C3Cr 2               KBasCmdBsave:
000C3Cr 2  A9 08          lda #HW_CF
000C3Er 2  20 rr rr       jsr ReqHw
000C41r 2  20 rr rr       jsr EvalAddrU16                ; addr
000C44r 2  A5 12          lda z:FAC + 4
000C46r 2  8D 7F 03       sta FS_IO_ADDR
000C49r 2  A5 11          lda z:FAC + 3
000C4Br 2  8D 80 03       sta FS_IO_ADDR + 1
000C4Er 2  20 rr rr       jsr ChkCom
000C51r 2  20 rr rr       jsr EvalAddrU16                ; length in bytes
000C54r 2  A5 12          lda z:FAC + 4
000C56r 2  8D 4A 03       sta FS_FILE_SIZE
000C59r 2  A5 11          lda z:FAC + 3
000C5Br 2  8D 4B 03       sta FS_FILE_SIZE + 1
000C5Er 2  20 rr rr       jsr ChkCom
000C61r 2  20 rr rr       jsr EvalString                 ; filename
000C64r 2  20 rr rr       jsr FsSaveFileAddr
000C67r 2  B0 01          bcs @KBsaveErr
000C69r 2  60             rts
000C6Ar 2               @KBsaveErr:
000C6Ar 2  A9 rr          lda #<MsgSaveErr
000C6Cr 2  A0 rr          ldy #>MsgSaveErr
000C6Er 2  4C rr rr       jmp BasPrintStr
000C71r 2               
000C71r 2               ; FORMAT — erase (zero) the current disk's directory, with confirmation
000C71r 2               KBasCmdFormat:
000C71r 2  A9 08          lda #HW_CF
000C73r 2  20 rr rr       jsr ReqHw
000C76r 2  A9 rr          lda #<KMsgEraseDisk
000C78r 2  A0 rr          ldy #>KMsgEraseDisk
000C7Ar 2  20 rr rr       jsr BasPrintStr
000C7Dr 2  AD 0F 03       lda CF_DISK
000C80r 2  8D 4A 03       sta FS_FILE_SIZE
000C83r 2  9C 4B 03       stz FS_FILE_SIZE + 1
000C86r 2  20 rr rr       jsr FsPrintSize                ; print disk number (decimal)
000C89r 2  A9 rr          lda #<KMsgConfirm
000C8Br 2  A0 rr          ldy #>KMsgConfirm
000C8Dr 2  20 rr rr       jsr BasPrintStr
000C90r 2               @KFmtWait:
000C90r 2  20 rr rr       jsr Chrin                      ; wait for a key (echoes)
000C93r 2  90 FB          bcc @KFmtWait
000C95r 2  29 DF          and #$DF                       ; fold to uppercase
000C97r 2  48             pha
000C98r 2  20 rr rr       jsr BasPrintCRLF
000C9Br 2  68             pla
000C9Cr 2  C9 59          cmp #'Y'
000C9Er 2  D0 03          bne @KFmtAbort
000CA0r 2  4C rr rr       jmp FsFormatDisk               ; zero the directory (returns carry status)
000CA3r 2               @KFmtAbort:
000CA3r 2  60             rts
000CA4r 2  45 52 41 53  KMsgEraseDisk: .byte "ERASE DISK ", 0
000CA8r 2  45 20 44 49  
000CACr 2  53 4B 20 00  
000CB0r 2  3F 20 28 59  KMsgConfirm:   .byte "? (Y/N) ", 0
000CB4r 2  2F 4E 29 20  
000CB8r 2  00           
000CB9r 2               
000CB9r 2               ; FsLoadFileImpl — Load file from CF into PROGRAM_START ($0800)
000CB9r 2               ; Input: STR_PTR ($02-$03) points to null-terminated filename
000CB9r 2               ; Output: Carry clear = success, FS_FILE_SIZE = bytes loaded
000CB9r 2               ;         Carry set = file not found or read error
000CB9r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
000CB9r 2               FsLoadFileImpl:
000CB9r 2  A9 00          lda #<PROGRAM_START           ; Default target = PROGRAM_START
000CBBr 2  8D 7F 03       sta FS_IO_ADDR
000CBEr 2  A9 08          lda #>PROGRAM_START
000CC0r 2  8D 80 03       sta FS_IO_ADDR + 1
000CC3r 2               ; FsLoadFileAddrImpl — Load named file to FS_IO_ADDR (caller preset)
000CC3r 2               ; Input: STR_PTR = filename, FS_IO_ADDR = destination address
000CC3r 2               FsLoadFileAddrImpl:
000CC3r 2  20 rr rr       jsr FsParseName               ; Parse filename into FS_FNAME_BUF
000CC6r 2  20 rr rr       jsr FsReadDir                 ; Read directory sector
000CC9r 2  B0 65          bcs @FsLoadErr
000CCBr 2  20 rr rr       jsr FsFindFile                ; Search for filename
000CCEr 2  B0 60          bcs @FsLoadErr                ; Not found
000CD0r 2                 ; Read file metadata from entry
000CD0r 2  A0 0C          ldy #FS_ENTRY_START
000CD2r 2  B1 24          lda (CF_BUF_PTR),y
000CD4r 2  8D 48 03       sta FS_START_SEC
000CD7r 2  C8             iny
000CD8r 2  B1 24          lda (CF_BUF_PTR),y
000CDAr 2  8D 49 03       sta FS_START_SEC + 1
000CDDr 2  A0 0E          ldy #FS_ENTRY_FSIZE
000CDFr 2  B1 24          lda (CF_BUF_PTR),y
000CE1r 2  8D 4A 03       sta FS_FILE_SIZE
000CE4r 2  C8             iny
000CE5r 2  B1 24          lda (CF_BUF_PTR),y
000CE7r 2  8D 4B 03       sta FS_FILE_SIZE + 1
000CEAr 2                 ; Calculate number of sectors to read
000CEAr 2  AD 4B 03       lda FS_FILE_SIZE + 1
000CEDr 2  4A             lsr a
000CEEr 2  8D 4C 03       sta FS_SEC_COUNT
000CF1r 2  AD 4B 03       lda FS_FILE_SIZE + 1
000CF4r 2  29 01          and #$01
000CF6r 2  D0 05          bne @FsLoadRound
000CF8r 2  AD 4A 03       lda FS_FILE_SIZE
000CFBr 2  F0 03          beq @FsLoadNoRound
000CFDr 2               @FsLoadRound:
000CFDr 2  EE 4C 03       inc FS_SEC_COUNT
000D00r 2               @FsLoadNoRound:
000D00r 2                 ; Set up LBA starting at file's start sector
000D00r 2  AD 48 03       lda FS_START_SEC
000D03r 2  85 26          sta CF_LBA
000D05r 2  AD 49 03       lda FS_START_SEC + 1
000D08r 2  85 27          sta CF_LBA + 1
000D0Ar 2  64 28          stz CF_LBA + 2
000D0Cr 2  64 29          stz CF_LBA + 3
000D0Er 2                 ; Set destination pointer from FS_IO_ADDR
000D0Er 2  AD 7F 03       lda FS_IO_ADDR
000D11r 2  85 24          sta CF_BUF_PTR
000D13r 2  AD 80 03       lda FS_IO_ADDR + 1
000D16r 2  85 25          sta CF_BUF_PTR + 1
000D18r 2                 ; Read sectors
000D18r 2  AE 4C 03       ldx FS_SEC_COUNT
000D1Br 2  F0 10          beq @FsLoadOk                 ; Zero-size file
000D1Dr 2               @FsLoadSec:
000D1Dr 2  DA             phx
000D1Er 2  20 rr rr       jsr StReadSector              ; Read sector (advances CF_BUF_PTR by 512)
000D21r 2  B0 0C          bcs @FsLoadSecErr
000D23r 2                 ; Increment LBA
000D23r 2  E6 26          inc CF_LBA
000D25r 2  D0 02          bne @FsLoadSecNext
000D27r 2  E6 27          inc CF_LBA + 1
000D29r 2               @FsLoadSecNext:
000D29r 2  FA             plx
000D2Ar 2  CA             dex
000D2Br 2  D0 F0          bne @FsLoadSec
000D2Dr 2               @FsLoadOk:
000D2Dr 2  18             clc
000D2Er 2  60             rts
000D2Fr 2               @FsLoadSecErr:
000D2Fr 2  FA             plx                           ; Balance stack
000D30r 2               @FsLoadErr:
000D30r 2  38             sec
000D31r 2  60             rts
000D32r 2               
000D32r 2               ; FsSaveFileImpl — Save data from PROGRAM_START to CF
000D32r 2               ; Input: STR_PTR ($02-$03) points to null-terminated filename
000D32r 2               ;        FS_FILE_SIZE ($034A-$034B) = number of bytes to save
000D32r 2               ; Output: Carry clear = success, Carry set = error (directory full or write error)
000D32r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
000D32r 2               FsSaveFileImpl:
000D32r 2  A9 00          lda #<PROGRAM_START           ; Default source = PROGRAM_START
000D34r 2  8D 7F 03       sta FS_IO_ADDR
000D37r 2  A9 08          lda #>PROGRAM_START
000D39r 2  8D 80 03       sta FS_IO_ADDR + 1
000D3Cr 2               ; FsSaveFileAddrImpl — Save FS_FILE_SIZE bytes from FS_IO_ADDR to named file
000D3Cr 2               ; Input: STR_PTR = filename, FS_IO_ADDR = source address, FS_FILE_SIZE = byte count
000D3Cr 2               FsSaveFileAddrImpl:
000D3Cr 2  20 rr rr       jsr FsParseName               ; Parse filename into FS_FNAME_BUF
000D3Fr 2  20 rr rr       jsr FsReadDir                 ; Read directory sector
000D42r 2  90 03          bcc @FsSaveReadOk
000D44r 2  4C rr rr       jmp @FsSaveErr
000D47r 2               @FsSaveReadOk:
000D47r 2                 ; Try to find existing file with same name
000D47r 2  20 rr rr       jsr FsFindFile
000D4Ar 2  90 08          bcc @FsSaveOverwrite
000D4Cr 2                 ; Not found — find a free slot
000D4Cr 2  20 rr rr       jsr FsFindFree
000D4Fr 2  90 11          bcc @FsSaveAlloc
000D51r 2  4C rr rr       jmp @FsSaveErr                ; Directory full
000D54r 2               @FsSaveOverwrite:
000D54r 2                 ; CF_BUF_PTR already points to the existing entry — clear old flags
000D54r 2  A0 0B          ldy #FS_ENTRY_FLAGS
000D56r 2  A9 00          lda #$00
000D58r 2  91 24          sta (CF_BUF_PTR),y            ; Mark old entry as free
000D5Ar 2                 ; Find a free slot (could be the one we just freed or another)
000D5Ar 2  20 rr rr       jsr FsFindFree
000D5Dr 2  90 03          bcc @FsSaveAlloc
000D5Fr 2  4C rr rr       jmp @FsSaveErr
000D62r 2               @FsSaveAlloc:
000D62r 2                 ; Save CF_BUF_PTR (points to free entry from FsFindFree)
000D62r 2  A5 24          lda CF_BUF_PTR
000D64r 2  48             pha
000D65r 2  A5 25          lda CF_BUF_PTR + 1
000D67r 2  48             pha
000D68r 2                 ; Save FS_FILE_SIZE (FsCalcNextSec clobbers it while scanning entries)
000D68r 2  AD 4A 03       lda FS_FILE_SIZE
000D6Br 2  48             pha
000D6Cr 2  AD 4B 03       lda FS_FILE_SIZE + 1
000D6Fr 2  48             pha
000D70r 2                 ; Calculate next free sector (clobbers CF_BUF_PTR and FS_FILE_SIZE)
000D70r 2  20 rr rr       jsr FsCalcNextSec
000D73r 2                 ; Restore FS_FILE_SIZE
000D73r 2  68             pla
000D74r 2  8D 4B 03       sta FS_FILE_SIZE + 1
000D77r 2  68             pla
000D78r 2  8D 4A 03       sta FS_FILE_SIZE
000D7Br 2                 ; Restore CF_BUF_PTR to the free directory entry
000D7Br 2  68             pla
000D7Cr 2  85 25          sta CF_BUF_PTR + 1
000D7Er 2  68             pla
000D7Fr 2  85 24          sta CF_BUF_PTR
000D81r 2                 ; Calculate sectors needed
000D81r 2  AD 4B 03       lda FS_FILE_SIZE + 1
000D84r 2  4A             lsr a
000D85r 2  8D 4C 03       sta FS_SEC_COUNT
000D88r 2  AD 4B 03       lda FS_FILE_SIZE + 1
000D8Br 2  29 01          and #$01
000D8Dr 2  D0 05          bne @FsSaveRound
000D8Fr 2  AD 4A 03       lda FS_FILE_SIZE
000D92r 2  F0 03          beq @FsSaveNoRound
000D94r 2               @FsSaveRound:
000D94r 2  EE 4C 03       inc FS_SEC_COUNT
000D97r 2               @FsSaveNoRound:
000D97r 2                 ; Disk-full guard: reject if the file would spill past this disk's region.
000D97r 2                 ; end sector = FS_NEXT_SEC + FS_SEC_COUNT must be <= FS_DISK_SECTORS.
000D97r 2  AD 4E 03       lda FS_NEXT_SEC
000D9Ar 2  18             clc
000D9Br 2  6D 4C 03       adc FS_SEC_COUNT
000D9Er 2  A8             tay                           ; Y = end sector low
000D9Fr 2  AD 4F 03       lda FS_NEXT_SEC + 1
000DA2r 2  69 00          adc #$00                      ; A = end sector high
000DA4r 2  C9 08          cmp #>FS_DISK_SECTORS
000DA6r 2  90 08          bcc @FsSaveSpaceOk            ; end high < high(FS_DISK_SECTORS) -> fits
000DA8r 2  D0 03          bne @FsSaveDiskFull           ; end high > high(FS_DISK_SECTORS) -> full
000DAAr 2  98             tya                           ; end high equal: OK only if end low == 0
000DABr 2  F0 03          beq @FsSaveSpaceOk
000DADr 2               @FsSaveDiskFull:
000DADr 2  4C rr rr       jmp @FsSaveErr                ; Disk full
000DB0r 2               @FsSaveSpaceOk:
000DB0r 2                 ; Fill in directory entry at CF_BUF_PTR
000DB0r 2                 ; Copy filename (11 bytes)
000DB0r 2  A0 00          ldy #$00
000DB2r 2               @FsSaveCopyName:
000DB2r 2  B9 50 03       lda FS_FNAME_BUF,y
000DB5r 2  91 24          sta (CF_BUF_PTR),y
000DB7r 2  C8             iny
000DB8r 2  C0 0B          cpy #11
000DBAr 2  D0 F6          bne @FsSaveCopyName
000DBCr 2                 ; Set flags = in use
000DBCr 2  A9 01          lda #FS_FLAG_USED
000DBEr 2  91 24          sta (CF_BUF_PTR),y            ; Y = 11 = FS_ENTRY_FLAGS
000DC0r 2                 ; Set start sector
000DC0r 2  A0 0C          ldy #FS_ENTRY_START
000DC2r 2  AD 4E 03       lda FS_NEXT_SEC
000DC5r 2  91 24          sta (CF_BUF_PTR),y
000DC7r 2  8D 48 03       sta FS_START_SEC
000DCAr 2  C8             iny
000DCBr 2  AD 4F 03       lda FS_NEXT_SEC + 1
000DCEr 2  91 24          sta (CF_BUF_PTR),y
000DD0r 2  8D 49 03       sta FS_START_SEC + 1
000DD3r 2                 ; Set file size
000DD3r 2  A0 0E          ldy #FS_ENTRY_FSIZE
000DD5r 2  AD 4A 03       lda FS_FILE_SIZE
000DD8r 2  91 24          sta (CF_BUF_PTR),y
000DDAr 2  C8             iny
000DDBr 2  AD 4B 03       lda FS_FILE_SIZE + 1
000DDEr 2  91 24          sta (CF_BUF_PTR),y
000DE0r 2                 ; Clear reserved bytes
000DE0r 2  A0 10          ldy #$10
000DE2r 2  A9 00          lda #$00
000DE4r 2               @FsSaveClearRsv:
000DE4r 2  91 24          sta (CF_BUF_PTR),y
000DE6r 2  C8             iny
000DE7r 2  C0 20          cpy #FS_ENTRY_SIZE
000DE9r 2  D0 F9          bne @FsSaveClearRsv
000DEBr 2                 ; Write updated directory back to CF
000DEBr 2  20 rr rr       jsr FsWriteDir
000DEEr 2  B0 30          bcs @FsSaveErr
000DF0r 2                 ; Now write file data sectors
000DF0r 2  AD 48 03       lda FS_START_SEC
000DF3r 2  85 26          sta CF_LBA
000DF5r 2  AD 49 03       lda FS_START_SEC + 1
000DF8r 2  85 27          sta CF_LBA + 1
000DFAr 2  64 28          stz CF_LBA + 2
000DFCr 2  64 29          stz CF_LBA + 3
000DFEr 2                 ; Source = FS_IO_ADDR
000DFEr 2  AD 7F 03       lda FS_IO_ADDR
000E01r 2  85 24          sta CF_BUF_PTR
000E03r 2  AD 80 03       lda FS_IO_ADDR + 1
000E06r 2  85 25          sta CF_BUF_PTR + 1
000E08r 2  AE 4C 03       ldx FS_SEC_COUNT
000E0Br 2  F0 10          beq @FsSaveOk                 ; Zero-size file
000E0Dr 2               @FsSaveSec:
000E0Dr 2  DA             phx
000E0Er 2  20 rr rr       jsr StWriteSector             ; Write sector (advances CF_BUF_PTR by 512)
000E11r 2  B0 0C          bcs @FsSaveSecErr
000E13r 2                 ; Increment LBA
000E13r 2  E6 26          inc CF_LBA
000E15r 2  D0 02          bne @FsSaveSecNext
000E17r 2  E6 27          inc CF_LBA + 1
000E19r 2               @FsSaveSecNext:
000E19r 2  FA             plx
000E1Ar 2  CA             dex
000E1Br 2  D0 F0          bne @FsSaveSec
000E1Dr 2               @FsSaveOk:
000E1Dr 2  18             clc
000E1Er 2  60             rts
000E1Fr 2               @FsSaveSecErr:
000E1Fr 2  FA             plx                           ; Balance stack
000E20r 2               @FsSaveErr:
000E20r 2  38             sec
000E21r 2  60             rts
000E22r 2               
000E22r 2               ; FsDeleteFile — Delete a file from the CompactFlash filesystem
000E22r 2               ; Input: STR_PTR ($02-$03) points to null-terminated filename
000E22r 2               ; Output: Carry clear = success, Carry set = file not found or error
000E22r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
000E22r 2               FsDeleteFileImpl:
000E22r 2  20 rr rr       jsr FsParseName               ; Parse filename into FS_FNAME_BUF
000E25r 2  20 rr rr       jsr FsReadDir                 ; Read directory sector
000E28r 2  B0 0F          bcs @FsDelErr
000E2Ar 2  20 rr rr       jsr FsFindFile                ; Search for filename
000E2Dr 2  B0 0A          bcs @FsDelErr                 ; Not found
000E2Fr 2                 ; Clear the flags byte to mark entry as unused
000E2Fr 2  A0 0B          ldy #FS_ENTRY_FLAGS
000E31r 2  A9 00          lda #$00
000E33r 2  91 24          sta (CF_BUF_PTR),y
000E35r 2                 ; Write updated directory back to CF
000E35r 2  20 rr rr       jsr FsWriteDir
000E38r 2                 ; Carry already set/clear from FsWriteDir
000E38r 2  60             rts
000E39r 2               @FsDelErr:
000E39r 2  38             sec
000E3Ar 2  60             rts
000E3Br 2               
000E3Br 2               ; === XModem Serial LOAD/SAVE ===
000E3Br 2               ; Standard XModem protocol over serial (128-byte blocks, checksum)
000E3Br 2               ; Load: receives blocks into memory at caller-supplied XFER_PTR
000E3Br 2               ; Save: sends blocks from memory at caller-supplied XFER_PTR / XFER_REMAIN
000E3Br 2               
000E3Br 2               ; --- Shared XModem Utilities ---
000E3Br 2               
000E3Br 2               ; XModemGetByte — Read one byte from serial with timeout
000E3Br 2               ; Polls SC_STATUS for RDRF directly (bypasses IRQ-driven buffer).
000E3Br 2               ; Caller must disable serial RX IRQ before calling.
000E3Br 2               ; Output: A = byte received, Carry clear = got byte
000E3Br 2               ;         Carry set = timeout
000E3Br 2               ; Preserves: X, Y
000E3Br 2               XModemGetByte:
000E3Br 2  DA             phx
000E3Cr 2  5A             phy
000E3Dr 2  A2 00          ldx #$00                      ; Outer loop: 256 passes
000E3Fr 2               @Outer:
000E3Fr 2  A0 00          ldy #$00                      ; Inner loop: 256 polls
000E41r 2               @Inner:
000E41r 2  AD 01 90       lda SC_STATUS
000E44r 2  29 08          and #SC_STATUS_RDRF           ; Received byte waiting?
000E46r 2  D0 0A          bne @Got
000E48r 2  88             dey
000E49r 2  D0 F6          bne @Inner
000E4Br 2  CA             dex
000E4Cr 2  D0 F1          bne @Outer
000E4Er 2                 ; Timeout
000E4Er 2  7A             ply
000E4Fr 2  FA             plx
000E50r 2  38             sec
000E51r 2  60             rts
000E52r 2               @Got:
000E52r 2  AD 00 90       lda SC_DATA                   ; Read received byte (clears RDRF)
000E55r 2  7A             ply
000E56r 2  FA             plx
000E57r 2  18             clc
000E58r 2  60             rts
000E59r 2               
000E59r 2               ; XModemPurge — Drain all pending bytes from input buffer and hardware
000E59r 2               ; Modifies: A, X
000E59r 2               XModemPurge:
000E59r 2                 ; Drain software input buffer (bytes captured before IRQ was disabled)
000E59r 2               @DrainBuf:
000E59r 2  20 rr rr       jsr BufferSize
000E5Cr 2  F0 05          beq @DrainHw
000E5Er 2  20 rr rr       jsr ReadBuffer
000E61r 2  80 F6          bra @DrainBuf
000E63r 2               @DrainHw:
000E63r 2                 ; Drain hardware RDRF
000E63r 2  AD 01 90       lda SC_STATUS
000E66r 2  29 08          and #SC_STATUS_RDRF
000E68r 2  F0 05          beq @Done
000E6Ar 2  AD 00 90       lda SC_DATA                   ; Read and discard
000E6Dr 2  80 F4          bra @DrainHw
000E6Fr 2               @Done:
000E6Fr 2  60             rts
000E70r 2               
000E70r 2               ; --- XModem Load (Receive) ---
000E70r 2               
000E70r 2               ; XModemLoadImpl — Receive data via standard XModem protocol
000E70r 2               ; Input: XFER_PTR = destination address (set by caller)
000E70r 2               ; Output: Carry clear = success, XFER_PTR past last byte written
000E70r 2               ;         XFER_REMAIN = total bytes received
000E70r 2               ;         Carry set = transfer failed
000E70r 2               ; Modifies: Flags, A, X, Y
000E70r 2               XModemLoadImpl:
000E70r 2                 ; Save and switch IO_MODE to serial
000E70r 2  AD 06 03       lda IO_MODE
000E73r 2  8D 19 03       sta XFER_IO_SAVE
000E76r 2  A9 01          lda #$01
000E78r 2  8D 06 03       sta IO_MODE
000E7Br 2                 ; Disable serial RX IRQ — XModem polls SC_STATUS directly
000E7Br 2  A9 0B          lda #$0B                      ; Bit 1 set = RX IRQ disabled, RTSB low, DTR
000E7Dr 2  8D 02 90       sta SC_CMD
000E80r 2                 ; Initialize
000E80r 2  A9 01          lda #$01
000E82r 2  85 36          sta XMODEM_BLK                ; First expected block number
000E84r 2  9C 17 03       stz XFER_REMAIN
000E87r 2  9C 18 03       stz XFER_REMAIN + 1
000E8Ar 2  A9 3C          lda #XMODEM_STARTRETRY
000E8Cr 2  85 38          sta XMODEM_RETRY
000E8Er 2                 ; Print status message so user can start the terminal send
000E8Er 2  A2 00          ldx #0
000E90r 2               @PrintMsg:
000E90r 2  BD rr rr       lda XModemStrReceive,x
000E93r 2  F0 06          beq @PrintDone
000E95r 2  20 rr rr       jsr Chrout
000E98r 2  E8             inx
000E99r 2  80 F5          bra @PrintMsg
000E9Br 2               @PrintDone:
000E9Br 2  20 rr rr       jsr XModemPurge               ; Drain stale bytes
000E9Er 2                 ; Send initial NAK to start transfer
000E9Er 2  A9 15          lda #XMODEM_NAK
000EA0r 2  20 rr rr       jsr SerialChrout
000EA3r 2               @RecvWait:
000EA3r 2  20 rr rr       jsr XModemGetByte
000EA6r 2  B0 0E          bcs @RecvTimeout
000EA8r 2  C9 01          cmp #XMODEM_SOH
000EAAr 2  F0 3E          beq @RecvBlock
000EACr 2  C9 04          cmp #XMODEM_EOT
000EAEr 2  F0 11          beq @RecvEOT
000EB0r 2  C9 18          cmp #XMODEM_CAN
000EB2r 2  F0 1F          beq @RecvFail
000EB4r 2  80 ED          bra @RecvWait                 ; Ignore unknown bytes
000EB6r 2               
000EB6r 2               @RecvTimeout:
000EB6r 2  C6 38          dec XMODEM_RETRY
000EB8r 2  F0 19          beq @RecvFail
000EBAr 2  A9 15          lda #XMODEM_NAK
000EBCr 2  20 rr rr       jsr SerialChrout
000EBFr 2  80 E2          bra @RecvWait
000EC1r 2               
000EC1r 2               @RecvEOT:
000EC1r 2  A9 06          lda #XMODEM_ACK
000EC3r 2  20 rr rr       jsr SerialChrout
000EC6r 2                 ; Re-enable serial RX IRQ
000EC6r 2  A9 09          lda #$09
000EC8r 2  8D 02 90       sta SC_CMD
000ECBr 2  AD 19 03       lda XFER_IO_SAVE
000ECEr 2  8D 06 03       sta IO_MODE
000ED1r 2  18             clc                           ; Success
000ED2r 2  60             rts
000ED3r 2               
000ED3r 2               @RecvFail:
000ED3r 2  A9 18          lda #XMODEM_CAN
000ED5r 2  20 rr rr       jsr SerialChrout
000ED8r 2  A9 18          lda #XMODEM_CAN
000EDAr 2  20 rr rr       jsr SerialChrout
000EDDr 2                 ; Re-enable serial RX IRQ
000EDDr 2  A9 09          lda #$09
000EDFr 2  8D 02 90       sta SC_CMD
000EE2r 2  AD 19 03       lda XFER_IO_SAVE
000EE5r 2  8D 06 03       sta IO_MODE
000EE8r 2  38             sec                           ; Failure
000EE9r 2  60             rts
000EEAr 2               
000EEAr 2               @RecvBlock:
000EEAr 2                 ; Reset retry counter on SOH received
000EEAr 2  A9 0A          lda #XMODEM_MAXRETRY
000EECr 2  85 38          sta XMODEM_RETRY
000EEEr 2                 ; Read block number
000EEEr 2  20 rr rr       jsr XModemGetByte
000EF1r 2  B0 6B          bcs @RecvNAK
000EF3r 2  85 39          sta XMODEM_RCVBLK
000EF5r 2                 ; Read complement
000EF5r 2  20 rr rr       jsr XModemGetByte
000EF8r 2  B0 64          bcs @RecvNAK
000EFAr 2                 ; Verify block# + complement = $FF
000EFAr 2  18             clc
000EFBr 2  65 39          adc XMODEM_RCVBLK
000EFDr 2  C9 FF          cmp #$FF
000EFFr 2  D0 5D          bne @RecvNAK
000F01r 2                 ; Receive 128 data bytes into (XFER_PTR), accumulate checksum
000F01r 2  64 37          stz XMODEM_CHK
000F03r 2  A0 00          ldy #$00
000F05r 2               @RecvData:
000F05r 2  20 rr rr       jsr XModemGetByte             ; A = byte (X/Y preserved)
000F08r 2  B0 54          bcs @RecvNAK
000F0Ar 2  91 2A          sta (XFER_PTR),y              ; Write to destination at offset Y
000F0Cr 2  18             clc
000F0Dr 2  65 37          adc XMODEM_CHK
000F0Fr 2  85 37          sta XMODEM_CHK
000F11r 2  C8             iny
000F12r 2  C0 80          cpy #XMODEM_BLKSZ
000F14r 2  D0 EF          bne @RecvData
000F16r 2                 ; Read and verify checksum
000F16r 2  20 rr rr       jsr XModemGetByte
000F19r 2  B0 43          bcs @RecvNAK
000F1Br 2  C5 37          cmp XMODEM_CHK
000F1Dr 2  D0 3F          bne @RecvNAK
000F1Fr 2                 ; Verify block number matches expected
000F1Fr 2  A5 39          lda XMODEM_RCVBLK
000F21r 2  C5 36          cmp XMODEM_BLK
000F23r 2  D0 28          bne @RecvDupChk
000F25r 2                 ; Good block — advance pointer by 128
000F25r 2  18             clc
000F26r 2  A5 2A          lda XFER_PTR
000F28r 2  69 80          adc #XMODEM_BLKSZ
000F2Ar 2  85 2A          sta XFER_PTR
000F2Cr 2  A5 2B          lda XFER_PTR + 1
000F2Er 2  69 00          adc #$00
000F30r 2  85 2B          sta XFER_PTR + 1
000F32r 2                 ; Update total bytes received
000F32r 2  18             clc
000F33r 2  AD 17 03       lda XFER_REMAIN
000F36r 2  69 80          adc #XMODEM_BLKSZ
000F38r 2  8D 17 03       sta XFER_REMAIN
000F3Br 2  AD 18 03       lda XFER_REMAIN + 1
000F3Er 2  69 00          adc #$00
000F40r 2  8D 18 03       sta XFER_REMAIN + 1
000F43r 2                 ; Increment expected block number (wraps 255→0)
000F43r 2  E6 36          inc XMODEM_BLK
000F45r 2                 ; ACK the block
000F45r 2  A9 06          lda #XMODEM_ACK
000F47r 2  20 rr rr       jsr SerialChrout
000F4Ar 2  4C rr rr       jmp @RecvWait
000F4Dr 2               
000F4Dr 2               @RecvDupChk:
000F4Dr 2                 ; Check if this is a retransmit of the previous block (lost ACK)
000F4Dr 2  A5 36          lda XMODEM_BLK
000F4Fr 2  38             sec
000F50r 2  E9 01          sbc #$01
000F52r 2  C5 39          cmp XMODEM_RCVBLK
000F54r 2  D0 08          bne @RecvNAK                  ; Not a dup — NAK
000F56r 2                 ; Duplicate — re-ACK without advancing
000F56r 2  A9 06          lda #XMODEM_ACK
000F58r 2  20 rr rr       jsr SerialChrout
000F5Br 2  4C rr rr       jmp @RecvWait
000F5Er 2               
000F5Er 2               @RecvNAK:
000F5Er 2  20 rr rr       jsr XModemPurge               ; Drain any remaining bytes
000F61r 2  A9 15          lda #XMODEM_NAK
000F63r 2  20 rr rr       jsr SerialChrout
000F66r 2  4C rr rr       jmp @RecvWait
000F69r 2               
000F69r 2               ; --- XModem Save (Send) ---
000F69r 2               
000F69r 2               ; XModemSaveImpl — Send data via standard XModem protocol
000F69r 2               ; Input: XFER_PTR = source address, XFER_REMAIN = byte count (set by caller)
000F69r 2               ; Output: Carry clear = success, Carry set = transfer failed
000F69r 2               ; Modifies: Flags, A, X, Y
000F69r 2               XModemSaveImpl:
000F69r 2                 ; Save and switch IO_MODE to serial
000F69r 2  AD 06 03       lda IO_MODE
000F6Cr 2  8D 19 03       sta XFER_IO_SAVE
000F6Fr 2  A9 01          lda #$01
000F71r 2  8D 06 03       sta IO_MODE
000F74r 2                 ; Disable serial RX IRQ — XModem polls SC_STATUS directly
000F74r 2  A9 0B          lda #$0B                      ; Bit 1 set = RX IRQ disabled, RTSB low, DTR
000F76r 2  8D 02 90       sta SC_CMD
000F79r 2                 ; Initialize
000F79r 2  A9 01          lda #$01
000F7Br 2  85 36          sta XMODEM_BLK                ; First block number
000F7Dr 2  A9 3C          lda #XMODEM_STARTRETRY
000F7Fr 2  85 38          sta XMODEM_RETRY
000F81r 2                 ; Print status message so user can start the terminal receive
000F81r 2  A2 00          ldx #0
000F83r 2               @PrintMsg:
000F83r 2  BD rr rr       lda XModemStrSend,x
000F86r 2  F0 06          beq @PrintDone
000F88r 2  20 rr rr       jsr Chrout
000F8Br 2  E8             inx
000F8Cr 2  80 F5          bra @PrintMsg
000F8Er 2               @PrintDone:
000F8Er 2  20 rr rr       jsr XModemPurge               ; Drain stale bytes
000F91r 2                 ; Wait for initial NAK (or 'C' for CRC mode) from receiver
000F91r 2               @SendWaitNAK:
000F91r 2  20 rr rr       jsr XModemGetByte
000F94r 2  B0 11          bcs @SendInitTO
000F96r 2  C9 15          cmp #XMODEM_NAK
000F98r 2  F0 16          beq @SendLoop
000F9Ar 2  C9 43          cmp #'C'                      ; CRC mode request — treat as NAK (send checksum packets)
000F9Cr 2  F0 12          beq @SendLoop
000F9Er 2  C9 18          cmp #XMODEM_CAN
000FA0r 2  D0 03          bne :+
000FA2r 2  4C rr rr       jmp @SendFail
000FA5r 2  80 EA        : bra @SendWaitNAK
000FA7r 2               
000FA7r 2               @SendInitTO:
000FA7r 2  C6 38          dec XMODEM_RETRY
000FA9r 2  D0 03          bne :+
000FABr 2  4C rr rr       jmp @SendFail
000FAEr 2  80 E1        : bra @SendWaitNAK
000FB0r 2               
000FB0r 2               @SendLoop:
000FB0r 2                 ; Check if any data remains to send
000FB0r 2  AD 17 03       lda XFER_REMAIN
000FB3r 2  0D 18 03       ora XFER_REMAIN + 1
000FB6r 2  D0 03          bne :+
000FB8r 2  4C rr rr       jmp @SendEOT                  ; All data sent
000FBBr 2               :
000FBBr 2                 ; Reset retry counter for this block
000FBBr 2  A9 0A          lda #XMODEM_MAXRETRY
000FBDr 2  85 38          sta XMODEM_RETRY
000FBFr 2               @SendBlock:
000FBFr 2                 ; Save XFER_PTR and XFER_REMAIN on stack for retry
000FBFr 2  A5 2B          lda XFER_PTR + 1
000FC1r 2  48             pha
000FC2r 2  A5 2A          lda XFER_PTR
000FC4r 2  48             pha
000FC5r 2  AD 18 03       lda XFER_REMAIN + 1
000FC8r 2  48             pha
000FC9r 2  AD 17 03       lda XFER_REMAIN
000FCCr 2  48             pha
000FCDr 2                 ; Send header: SOH, block#, ~block#
000FCDr 2  A9 01          lda #XMODEM_SOH
000FCFr 2  20 rr rr       jsr SerialChrout
000FD2r 2  A5 36          lda XMODEM_BLK
000FD4r 2  20 rr rr       jsr SerialChrout
000FD7r 2  49 FF          eor #$FF
000FD9r 2  20 rr rr       jsr SerialChrout
000FDCr 2                 ; Send 128 data bytes, computing checksum
000FDCr 2  64 37          stz XMODEM_CHK
000FDEr 2  A0 00          ldy #$00                      ; Y=0 for (XFER_PTR),y indirect addressing
000FE0r 2  A2 80          ldx #XMODEM_BLKSZ             ; X = byte counter (128 down to 0)
000FE2r 2               @SendData:
000FE2r 2  AD 17 03       lda XFER_REMAIN
000FE5r 2  0D 18 03       ora XFER_REMAIN + 1
000FE8r 2  F0 20          beq @SendPad                  ; No more real data — pad remainder
000FEAr 2  B1 2A          lda (XFER_PTR),y              ; Read source byte
000FECr 2  20 rr rr       jsr SerialChrout              ; Send it (A preserved by SerialChrout)
000FEFr 2  18             clc
000FF0r 2  65 37          adc XMODEM_CHK
000FF2r 2  85 37          sta XMODEM_CHK
000FF4r 2                 ; Advance source pointer
000FF4r 2  E6 2A          inc XFER_PTR
000FF6r 2  D0 02          bne @SendNoPg
000FF8r 2  E6 2B          inc XFER_PTR + 1
000FFAr 2               @SendNoPg:
000FFAr 2                 ; Decrement remaining byte count
000FFAr 2  AD 17 03       lda XFER_REMAIN
000FFDr 2  D0 03          bne @SendDecLo
000FFFr 2  CE 18 03       dec XFER_REMAIN + 1
001002r 2               @SendDecLo:
001002r 2  CE 17 03       dec XFER_REMAIN
001005r 2  CA             dex
001006r 2  D0 DA          bne @SendData
001008r 2  80 0D          bra @SendChk
00100Ar 2               @SendPad:
00100Ar 2                 ; Pad remaining block bytes with SUB ($1A)
00100Ar 2  A9 1A          lda #XMODEM_SUB
00100Cr 2  20 rr rr       jsr SerialChrout
00100Fr 2  18             clc
001010r 2  65 37          adc XMODEM_CHK
001012r 2  85 37          sta XMODEM_CHK
001014r 2  CA             dex
001015r 2  D0 F3          bne @SendPad
001017r 2               @SendChk:
001017r 2                 ; Send checksum byte
001017r 2  A5 37          lda XMODEM_CHK
001019r 2  20 rr rr       jsr SerialChrout
00101Cr 2                 ; Wait for ACK/NAK response
00101Cr 2  20 rr rr       jsr XModemGetByte
00101Fr 2  B0 08          bcs @SendRetry                ; Timeout — retry
001021r 2  C9 06          cmp #XMODEM_ACK
001023r 2  F0 19          beq @SendBlockOK
001025r 2  C9 18          cmp #XMODEM_CAN
001027r 2  F0 1E          beq @SendCancel
001029r 2                 ; NAK or unknown — retry
001029r 2               @SendRetry:
001029r 2                 ; Restore XFER_PTR and XFER_REMAIN from stack
001029r 2  68             pla
00102Ar 2  8D 17 03       sta XFER_REMAIN
00102Dr 2  68             pla
00102Er 2  8D 18 03       sta XFER_REMAIN + 1
001031r 2  68             pla
001032r 2  85 2A          sta XFER_PTR
001034r 2  68             pla
001035r 2  85 2B          sta XFER_PTR + 1
001037r 2  C6 38          dec XMODEM_RETRY
001039r 2  F0 10          beq @SendFail
00103Br 2  4C rr rr       jmp @SendBlock
00103Er 2               
00103Er 2               @SendBlockOK:
00103Er 2                 ; Discard saved state from stack (4 bytes)
00103Er 2  68             pla
00103Fr 2  68             pla
001040r 2  68             pla
001041r 2  68             pla
001042r 2                 ; Advance to next block
001042r 2  E6 36          inc XMODEM_BLK
001044r 2  4C rr rr       jmp @SendLoop
001047r 2               
001047r 2               @SendCancel:
001047r 2                 ; Discard saved state from stack
001047r 2  68             pla
001048r 2  68             pla
001049r 2  68             pla
00104Ar 2  68             pla
00104Br 2               @SendFail:
00104Br 2                 ; Re-enable serial RX IRQ
00104Br 2  A9 09          lda #$09
00104Dr 2  8D 02 90       sta SC_CMD
001050r 2  AD 19 03       lda XFER_IO_SAVE
001053r 2  8D 06 03       sta IO_MODE
001056r 2  38             sec                           ; Failure
001057r 2  60             rts
001058r 2               
001058r 2               @SendEOT:
001058r 2                 ; All data sent — send EOT
001058r 2  A9 04          lda #XMODEM_EOT
00105Ar 2  20 rr rr       jsr SerialChrout
00105Dr 2                 ; Wait for ACK (best-effort; don't fail if timeout)
00105Dr 2  20 rr rr       jsr XModemGetByte
001060r 2                 ; Re-enable serial RX IRQ
001060r 2  A9 09          lda #$09
001062r 2  8D 02 90       sta SC_CMD
001065r 2  AD 19 03       lda XFER_IO_SAVE
001068r 2  8D 06 03       sta IO_MODE
00106Br 2  18             clc                           ; Success
00106Cr 2  60             rts
00106Dr 2               
00106Dr 2               ; XModem status strings
00106Dr 2               XModemStrReceive:
00106Dr 2  58 4D 4F 44    .byte "XMODEM RX READY", $0D, $0A, 0
001071r 2  45 4D 20 52  
001075r 2  58 20 52 45  
00107Fr 2               XModemStrSend:
00107Fr 2  58 4D 4F 44    .byte "XMODEM TX READY", $0D, $0A, 0
001083r 2  45 4D 20 54  
001087r 2  58 20 52 45  
001091r 2               
001091r 2               ; Draw the splash screen
001091r 2               ; Uses video output to display centered title and boot menu
001091r 2               ; Skips if video card is absent
001091r 2               ; Modifies: Flags, A, X, Y
001091r 2               Splash:
001091r 2  AD 0D 03       lda HW_PRESENT
001094r 2  29 80          and #HW_VID
001096r 2  D0 01          bne @SplashStart
001098r 2  60             rts                           ; No video — skip
001099r 2               @SplashStart:
001099r 2  20 rr rr       jsr VideoClear                ; Clear the video screen
00109Cr 2                 ; Position cursor at row 10, col 10 for title
00109Cr 2  A2 0A          ldx #10
00109Er 2  A0 0A          ldy #10
0010A0r 2  20 rr rr       jsr VideoSetCursor
0010A3r 2  A9 rr          lda #<@SplashTitle
0010A5r 2  85 02          sta STR_PTR
0010A7r 2  A9 rr          lda #>@SplashTitle
0010A9r 2  85 03          sta STR_PTR + 1
0010ABr 2  20 rr rr       jsr VideoPrintStrImpl
0010AEr 2                 ; Position cursor at row 12, col 8 for boot menu (centered: (40-24)/2 = 8)
0010AEr 2  A2 08          ldx #8
0010B0r 2  A0 0C          ldy #12
0010B2r 2  20 rr rr       jsr VideoSetCursor
0010B5r 2  A9 rr          lda #<@SplashMenu
0010B7r 2  85 02          sta STR_PTR
0010B9r 2  A9 rr          lda #>@SplashMenu
0010BBr 2  85 03          sta STR_PTR + 1
0010BDr 2  20 rr rr       jsr VideoPrintStrImpl
0010C0r 2  60             rts
0010C1r 2  2D 2D 20 36  @SplashTitle: .asciiz "-- 6502 BIOS v1.3 --"
0010C5r 2  35 30 32 20  
0010C9r 2  42 49 4F 53  
0010D6r 2  45 4E 54 45  @SplashMenu:  .asciiz "ENTER=BASIC  ESC=MONITOR"
0010DAr 2  52 3D 42 41  
0010DEr 2  53 49 43 20  
0010EFr 2               
0010EFr 2               ; NMI Handler
0010EFr 2               Nmi:
0010EFr 2  40             rti
0010F0r 2               
0010F0r 2               ; BRK Handler — saves full CPU state and enters monitor
0010F0r 2               ; On entry from @IrqBrk: A/X/Y are the user's original values (restored by IRQ handler).
0010F0r 2               ; The CPU's hardware push left P/PCL/PCH on the stack.
0010F0r 2               Break:
0010F0r 2  8D 13 03       sta BRK_A                     ; Save user's A register
0010F3r 2  8E 14 03       stx BRK_X                     ; Save user's X register
0010F6r 2  8C 15 03       sty BRK_Y                     ; Save user's Y register
0010F9r 2  BA             tsx                           ; Get current SP
0010FAr 2  8E 16 03       stx BRK_SP                   ; Save SP (points below P/PCL/PCH on stack)
0010FDr 2  68             pla                           ; Pull saved P
0010FEr 2  8D 10 03       sta BRK_P
001101r 2  68             pla                           ; Pull saved PCL (PC+2)
001102r 2  8D 11 03       sta BRK_PCL
001105r 2  68             pla                           ; Pull saved PCH
001106r 2  8D 12 03       sta BRK_PCH
001109r 2  4C rr rr       jmp MonitorBrkEntry
00110Cr 2               
00110Cr 2               ; IRQ Handler
00110Cr 2               Irq:
00110Cr 2  48             pha
00110Dr 2  5A             phy
00110Er 2  DA             phx
00110Fr 2  BA             tsx                           ; Get stack pointer to check saved status register
001110r 2  BD 04 01       lda $104,x                    ; Load saved P (SP+4: past X, Y, A we pushed)
001113r 2  29 10          and #$10                      ; Test B flag — set by BRK, clear by hardware IRQ
001115r 2  D0 47          bne @IrqBrk                   ; Branch if this was a BRK instruction
001117r 2               @IrqSc:
001117r 2  AD 0D 03       lda HW_PRESENT
00111Ar 2  29 10          and #HW_SC
00111Cr 2  F0 19          beq @IrqCheckKB               ; Serial not present — skip
00111Er 2  AD 01 90       lda SC_STATUS
001121r 2  29 80          and #SC_STATUS_IRQ            ; Check if serial data caused the interrupt
001123r 2  F0 12          beq @IrqCheckKB               ; If not, check keyboard
001125r 2  AD 00 90       lda SC_DATA                   ; Read the data from serial register
001128r 2  20 rr rr       jsr WriteBuffer               ; Store to the input buffer
00112Br 2  20 rr rr       jsr BufferSize
00112Er 2  C9 F0          cmp #$F0                      ; Is the buffer almost full?
001130r 2  90 05          bcc @IrqCheckKB               ; If not, also check keyboard
001132r 2  A9 01          lda #$01                      ; No parity, no echo, RTSB high, TX interrupts disabled, RX interrupts enabled
001134r 2  8D 02 90       sta SC_CMD                    ; Otherwise, signal not ready for receiving (RTSB high)
001137r 2                                               ; Fall through to check keyboard — always clear VIA flags
001137r 2               @IrqCheckKB:
001137r 2  AD 0D 03       lda HW_PRESENT
00113Ar 2  29 20          and #HW_GPIO
00113Cr 2  F0 1C          beq @IrqExit                  ; GPIO not present — skip
00113Er 2  AD 0D 94       lda GPIO_IFR
001141r 2  29 10          and #GPIO_INT_CB1             ; Check if CB1 (matrix keyboard data ready) caused the interrupt
001143r 2  F0 08          beq @IrqCheckPS2              ; If not, check PS/2 keyboard
001145r 2  AD 00 94       lda GPIO_PORTB                ; Read ASCII byte from matrix keyboard (also clears CB1 IFR flag)
001148r 2  20 rr rr       jsr WriteBuffer               ; Store to the input buffer
00114Br 2  80 0D          bra @IrqExit
00114Dr 2               @IrqCheckPS2:
00114Dr 2  AD 0D 94       lda GPIO_IFR
001150r 2  29 02          and #GPIO_INT_CA1             ; Check if CA1 (PS/2 keyboard data ready) caused the interrupt
001152r 2  F0 06          beq @IrqExit                  ; If not, exit
001154r 2  AD 01 94       lda GPIO_PORTA                ; Read ASCII byte from PS/2 keyboard (also clears CA1 IFR flag)
001157r 2  20 rr rr       jsr WriteBuffer               ; Store to the input buffer
00115Ar 2               @IrqExit:
00115Ar 2  FA             plx
00115Br 2  7A             ply
00115Cr 2  68             pla
00115Dr 2  40             rti
00115Er 2               @IrqBrk:
00115Er 2  FA             plx                           ; Restore saved registers
00115Fr 2  7A             ply
001160r 2  68             pla
001161r 2  58             cli                           ; Re-enable interrupts — abandoning interrupt context
001162r 2  6C 02 03       jmp (BRK_PTR)                 ; BRK — dispatch with P/PCL/PCH still on stack
001165r 2               
001165r 2               ; NMI Vector
001165r 2               NmiVec:
001165r 2  6C 04 03       jmp (NMI_PTR)                 ; Indirect jump through NMI pointer to the NMI handler
001168r 2               
001168r 2               ; Reset Vector
001168r 2               ResetVec:
001168r 2  4C rr rr       jmp Reset                     ; Initialize the system
00116Br 2               
00116Br 2               ; IRQ Vector
00116Br 2               IrqVec:
00116Br 2  6C 00 03       jmp (IRQ_PTR)                 ; Indirect jump through IRQ pointer to the IRQ handler
00116Er 2               
00116Er 1               .segment "CHARS"
000000r 1               .include "Chars.asm"
000000r 2               ; IBM Code Page 437 Character Set
000000r 2               ; 5x8 pixel font in 8x8 area, 8 bytes per character (256 characters total)
000000r 2               ; Each byte represents one horizontal row of pixels (5 pixels left-aligned in 8-bit space)
000000r 2               
000000r 2               CharacterSet:
000000r 2                   ; Character $00 - NULL (blank)
000000r 2  00 00 00 00      .byte $00, $00, $00, $00, $00, $00, $00, $00
000004r 2  00 00 00 00  
000008r 2                   ; Character $01 - ☺ (white smiling face)
000008r 2  70 88 D8 88      .byte $70, $88, $D8, $88, $A8, $88, $70, $00
00000Cr 2  A8 88 70 00  
000010r 2                   ; Character $02 - ☻ (black smiling face)
000010r 2  70 F8 A8 F8      .byte $70, $F8, $A8, $F8, $88, $F8, $70, $00
000014r 2  88 F8 70 00  
000018r 2                   ; Character $03 - ♥ (heart)
000018r 2  00 50 F8 F8      .byte $00, $50, $F8, $F8, $F8, $70, $20, $00
00001Cr 2  F8 70 20 00  
000020r 2                   ; Character $04 - ♦ (diamond)
000020r 2  00 20 70 F8      .byte $00, $20, $70, $F8, $F8, $70, $20, $00
000024r 2  F8 70 20 00  
000028r 2                   ; Character $05 - ♣ (club)
000028r 2  20 70 70 20      .byte $20, $70, $70, $20, $F8, $F8, $20, $00
00002Cr 2  F8 F8 20 00  
000030r 2                   ; Character $06 - ♠ (spade)
000030r 2  00 20 70 F8      .byte $00, $20, $70, $F8, $F8, $20, $70, $00
000034r 2  F8 20 70 00  
000038r 2                   ; Character $07 - • (bullet)
000038r 2  00 00 00 30      .byte $00, $00, $00, $30, $30, $00, $00, $00
00003Cr 2  30 00 00 00  
000040r 2                   ; Character $08 - ◘ (inverse bullet)
000040r 2  FC FC FC CC      .byte $FC, $FC, $FC, $CC, $CC, $FC, $FC, $FC
000044r 2  CC FC FC FC  
000048r 2                   ; Character $09 - ○ (white circle)
000048r 2  00 00 78 48      .byte $00, $00, $78, $48, $48, $78, $00, $00
00004Cr 2  48 78 00 00  
000050r 2                   ; Character $0A - ◙ (inverse white circle)
000050r 2  FC FC 84 B4      .byte $FC, $FC, $84, $B4, $B4, $84, $FC, $FC
000054r 2  B4 84 FC FC  
000058r 2                   ; Character $0B - ♂ (male symbol)
000058r 2  00 38 18 68      .byte $00, $38, $18, $68, $90, $90, $60, $00
00005Cr 2  90 90 60 00  
000060r 2                   ; Character $0C - ♀ (female symbol)
000060r 2  70 88 88 70      .byte $70, $88, $88, $70, $20, $70, $20, $00
000064r 2  20 70 20 00  
000068r 2                   ; Character $0D - ♪ (eighth note)
000068r 2  20 30 28 20      .byte $20, $30, $28, $20, $60, $E0, $C0, $00
00006Cr 2  60 E0 C0 00  
000070r 2                   ; Character $0E - ♫ (beamed eighth notes)
000070r 2  18 68 58 68      .byte $18, $68, $58, $68, $58, $D8, $C0, $00
000074r 2  58 D8 C0 00  
000078r 2                   ; Character $0F - ☼ (sun)
000078r 2  00 A8 70 D8      .byte $00, $A8, $70, $D8, $70, $A8, $00, $00
00007Cr 2  70 A8 00 00  
000080r 2                   ; Character $10 - ► (right-pointing triangle)
000080r 2  40 60 70 78      .byte $40, $60, $70, $78, $70, $60, $40, $00
000084r 2  70 60 40 00  
000088r 2                   ; Character $11 - ◄ (left-pointing triangle)
000088r 2  10 30 70 F0      .byte $10, $30, $70, $F0, $70, $30, $10, $00
00008Cr 2  70 30 10 00  
000090r 2                   ; Character $12 - ↕ (up/down arrow)
000090r 2  20 70 F8 20      .byte $20, $70, $F8, $20, $F8, $70, $20, $00
000094r 2  F8 70 20 00  
