00083Fr 2               @DisDone:
00083Fr 2  60             rts
000840r 2               
000840r 2               ; ============================================================================
000840r 2               ; DisOneLine — Disassemble one instruction at MON_ADDR
000840r 2               ; Prints line, advances MON_ADDR by instruction length.
000840r 2               ; Uses: MON_BYTE=opcode, MON_TMP=mnemonic idx, MON_TMP+1=mode
000840r 2               ;       Stack holds instruction length throughout.
000840r 2               ; ============================================================================
000840r 2               
000840r 2               DisOneLine:
000840r 2                 ; Read opcode and look up table
000840r 2  A0 00          ldy #0
000842r 2  B1 2E          lda (MON_ADDR),y
000844r 2  85 34          sta MON_BYTE                  ; save opcode
000846r 2  0A             asl a                         ; opcode * 2 for table index
000847r 2  AA             tax
000848r 2  90 0C          bcc @LowHalf                  ; carry clear = opcodes $00-$7F
00084Ar 2  BD rr rr       lda DisOpcodeTable+256,x      ; opcodes $80-$FF: offset by 256
00084Dr 2  85 32          sta MON_TMP                   ; mnemonic index
00084Fr 2  BD rr rr       lda DisOpcodeTable+257,x
000852r 2  85 33          sta MON_TMP+1                 ; addressing mode
000854r 2  80 0A          bra @GotEntry
000856r 2               @LowHalf:
000856r 2  BD rr rr       lda DisOpcodeTable,x
000859r 2  85 32          sta MON_TMP                   ; mnemonic index
00085Br 2  BD rr rr       lda DisOpcodeTable+1,x
00085Er 2  85 33          sta MON_TMP+1                 ; addressing mode
000860r 2               @GotEntry:
000860r 2                 ; Get instruction length from mode
000860r 2  A6 33          ldx MON_TMP+1
000862r 2  BD rr rr       lda DisModeSizes,x
000865r 2  1A             inc a                         ; +1 for opcode = total length
000866r 2  48             pha                           ; save on stack (stays until end)
000867r 2                 ; Print prefix ".,ADDR" (no space — consistent with M command's .:ADDR)
000867r 2  A9 2E          lda #'.'
000869r 2  20 rr rr       jsr Chrout
00086Cr 2  A9 2C          lda #','
00086Er 2  20 rr rr       jsr Chrout
000871r 2                 ; Print address
000871r 2  20 rr rr       jsr MonPrintHex4
000874r 2  20 rr rr       jsr MonPrintSpace
000877r 2  20 rr rr       jsr MonPrintSpace
00087Ar 2                 ; Print opcode byte
00087Ar 2  A5 34          lda MON_BYTE
00087Cr 2  20 rr rr       jsr MonPrintHex2
00087Fr 2                 ; Print 2nd byte or padding
00087Fr 2  68             pla
000880r 2  48             pha                           ; peek at length
000881r 2  C9 02          cmp #2
000883r 2  90 0C          bcc @Pad1
000885r 2  20 rr rr       jsr MonPrintSpace
000888r 2  A0 01          ldy #1
00088Ar 2  B1 2E          lda (MON_ADDR),y
00088Cr 2  20 rr rr       jsr MonPrintHex2
00088Fr 2  80 09          bra @Check3
000891r 2               @Pad1:
000891r 2  20 rr rr       jsr MonPrintSpace
000894r 2  20 rr rr       jsr MonPrintSpace
000897r 2  20 rr rr       jsr MonPrintSpace
00089Ar 2               @Check3:
00089Ar 2  68             pla
00089Br 2  48             pha
00089Cr 2  C9 03          cmp #3
00089Er 2  90 0C          bcc @Pad2
0008A0r 2  20 rr rr       jsr MonPrintSpace
0008A3r 2  A0 02          ldy #2
0008A5r 2  B1 2E          lda (MON_ADDR),y
0008A7r 2  20 rr rr       jsr MonPrintHex2
0008AAr 2  80 09          bra @AfterBytes
0008ACr 2               @Pad2:
0008ACr 2  20 rr rr       jsr MonPrintSpace
0008AFr 2  20 rr rr       jsr MonPrintSpace
0008B2r 2  20 rr rr       jsr MonPrintSpace
0008B5r 2               @AfterBytes:
0008B5r 2                 ; Separator before mnemonic
0008B5r 2  20 rr rr       jsr MonPrintSpace
0008B8r 2  20 rr rr       jsr MonPrintSpace
0008BBr 2                 ; Print mnemonic (3 chars)
0008BBr 2  20 rr rr       jsr DisPrintMnemonic
0008BEr 2                 ; For RMB/SMB/BBR/BBS, append bit number digit
0008BEr 2  A5 32          lda MON_TMP
0008C0r 2  C9 03          cmp #MN_BBR
0008C2r 2  F0 11          beq @BitNum
0008C4r 2  C9 04          cmp #MN_BBS
0008C6r 2  F0 0D          beq @BitNum
0008C8r 2  C9 2E          cmp #MN_RMB
0008CAr 2  F0 09          beq @BitNum
0008CCr 2  C9 37          cmp #MN_SMB
0008CEr 2  F0 05          beq @BitNum
0008D0r 2  20 rr rr       jsr MonPrintSpace             ; normal mnemonic — space separator
0008D3r 2  80 11          bra @Operand
0008D5r 2               @BitNum:
0008D5r 2  A5 34          lda MON_BYTE                  ; opcode encodes bit in upper nibble
0008D7r 2  4A             lsr a
0008D8r 2  4A             lsr a
0008D9r 2  4A             lsr a
0008DAr 2  4A             lsr a
0008DBr 2  29 07          and #$07
0008DDr 2  18             clc
0008DEr 2  69 30          adc #'0'
0008E0r 2  20 rr rr       jsr Chrout
0008E3r 2  20 rr rr       jsr MonPrintSpace
0008E6r 2               @Operand:
0008E6r 2                 ; Print operand based on addressing mode
0008E6r 2  A5 33          lda MON_TMP+1
0008E8r 2  20 rr rr       jsr DisPrintOperand
0008EBr 2                 ; CRLF
0008EBr 2  20 rr rr       jsr MonPrintCRLF
0008EEr 2                 ; Advance MON_ADDR by instruction length
0008EEr 2  68             pla                           ; length from stack
0008EFr 2  18             clc
0008F0r 2  65 2E          adc MON_ADDR
0008F2r 2  85 2E          sta MON_ADDR
0008F4r 2  90 04          bcc @NoWrap
0008F6r 2  E6 2F          inc MON_ADDR+1
0008F8r 2  F0 02          beq @DisWrapped               ; High byte became $00 = wrapped past $FFFF
0008FAr 2               @NoWrap:
0008FAr 2  18             clc                           ; Signal no overflow
0008FBr 2  60             rts
0008FCr 2               @DisWrapped:
0008FCr 2  38             sec                           ; Signal overflow
0008FDr 2  60             rts
0008FEr 2               
0008FEr 2               ; DisPrintMnemonic — Print 3-char mnemonic from MON_TMP index
0008FEr 2               
0008FEr 2               DisPrintMnemonic:
0008FEr 2  A5 32          lda MON_TMP                   ; mnemonic index
