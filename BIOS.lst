0029DDr 2               ; LOAD ["name"] / LOAD (bare) / LOAD "name"
0029DDr 2               BasCmdLoad:
0029DDr 2  20 rr rr             jsr     ChrGot
0029E0r 2  F0 02                beq     @bare
0029E2r 2  80 19                bra     @cf                     ; any argument is a filename expression
0029E4r 2               @bare:
0029E4r 2  A9 10                lda     #HW_SC
0029E6r 2  20 rr rr             jsr     ReqHw
0029E9r 2  A9 00                lda     #<PROGRAM_START
0029EBr 2  85 2A                sta     XFER_PTR
0029EDr 2  A9 08                lda     #>PROGRAM_START
0029EFr 2  85 2B                sta     XFER_PTR+1
0029F1r 2  20 rr rr             jsr     XModemLoad
0029F4r 2                       ; XMODEM rounds up to a 128-byte block, so this can overshoot the true
0029F4r 2                       ; end by up to 127 bytes: it wastes a little variable space, never
0029F4r 2                       ; truncates.
0029F4r 2  AD 17 03             lda     XFER_REMAIN
0029F7r 2  AC 18 03             ldy     XFER_REMAIN+1
0029FAr 2  4C rr rr             jmp     BasFixChain
