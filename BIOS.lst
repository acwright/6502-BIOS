000000r 1               ; =============================================================================
000000r 1               ; BIOS  —  Top-Level Assembly Source
000000r 1               ;           for AC6502 Homebrew Computer
000000r 1               ;
000000r 1               ;   Role        :  Sets the CPU target, then .include's every segment source
000000r 1               ;                   below in link order to produce the assembled ROM image.
000000r 1               ;   Segments    :  KERNAL, CHARS, BASIC, WOZMON, VECTORS  (see BIOS.cfg)
000000r 1               ;   Assembler   :  ca65  (cc65 toolchain)
000000r 1               ;   Linker cfg  :  BIOS.cfg
000000r 1               ;
000000r 1               ;   Build       :  make build   ->  BIOS.bin / BIOS.lst / BIOS.dbg
000000r 1               ;   Test        :  make test    ->  runs tests/run.mjs against BIOS.bin
000000r 1               ; =============================================================================
000000r 1               
000000r 1               ; The hardware is a WDC 65C02S. cc65's "65C02" is the Rockwell part: it has
000000r 1               ; RMB/SMB/BBR/BBS but not WAI or STP, which are WDC additions. "W65C02" is that
000000r 1               ; set plus those two, so this is a pure superset — no instruction already in use
000000r 1               ; changes encoding, and the ROM is byte-identical until something emits WAI or
000000r 1               ; STP.
000000r 1               .setcpu "W65C02"
000000r 1               
000000r 1               ; Stated as a requirement rather than left to the line above, so that narrowing
000000r 1               ; the CPU fails the build here with a reason instead of failing at whichever
000000r 1               ; instruction happened to need it.
000000r 1               .if (.cpu .bitand CPU_ISET_W65C02) = 0
000000r 1                 .error "BIOS targets the WDC 65C02S — .setcpu must be W65C02 (WAI/STP)"
000000r 1               .endif
000000r 1               
000000r 1               .include "BIOS.inc"
000000r 2               ; =============================================================================
000000r 2               ; BIOS.INC  —  Shared Zero-Page, Memory-Map, and Hardware Register Equates
000000r 2               ;               for AC6502 Homebrew Computer
000000r 2               ;
000000r 2               ;   Role        :  .include'd by BIOS.asm before any segment. Defines the
000000r 2               ;                   zero-page layout, stack/buffer addresses, Kernal RAM
000000r 2               ;                   variables, and the memory-mapped I/O registers (VIA,
000000r 2               ;                   6551 ACIA, TMS9918, SID, RTC, CompactFlash) shared by
000000r 2               ;                   every segment.
000000r 2               ;   Assembler   :  ca65  (cc65 toolchain)
000000r 2               ;
000000r 2               ;   Coding style :  Match the rest of the BIOS project.
000000r 2               ;                   * Constants / equates : UPPER_SNAKE_CASE.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; Zero Page
000000r 2               ZP                  := $00
000000r 2               READ_PTR            := $00
000000r 2               WRITE_PTR           := $01
000000r 2               STR_PTR             := $02               ; $02-$03 - String pointer (2 bytes)
000000r 2               ; $04-$23 reserved by BASIC interpreter
000000r 2               CF_BUF_PTR          := $24               ; $24-$25 - CF sector data buffer pointer (2 bytes)
000000r 2               CF_LBA              := $26               ; $26-$29 - CF 28-bit LBA address (4 bytes, little-endian)
000000r 2               XFER_PTR            := $2A               ; $2A-$2B - Serial transfer data pointer (2 bytes)
000000r 2               DELAY_CNT           := $2C               ; $2C-$2D - SysDelay 16-bit centisecond counter
000000r 2               ; $2E-$35 unassigned
000000r 2               
000000r 2               ; XModem ZP variables ($36-$39)
000000r 2               XMODEM_BLK          := $36               ; $36     - XModem expected/current block number
000000r 2               XMODEM_CHK          := $37               ; $37     - XModem running checksum
000000r 2               XMODEM_RETRY        := $38               ; $38     - XModem retry counter
000000r 2               XMODEM_RCVBLK       := $39               ; $39     - XModem received block number
000000r 2               
000000r 2               ; ProgramEnd chain-walk scratch.  Aliases the CF sector pointer / LBA, which are
000000r 2               ; idle whenever ProgramEnd runs (BASIC cold init or BASIC entry, never with an
000000r 2               ; I/O transfer in flight).
000000r 2               PE_PTR              := CF_BUF_PTR        ; $24-$25 - chain walk cursor
000000r 2               PE_NEXT             := CF_LBA            ; $26-$27 - candidate next-pointer
000000r 2               
000000r 2               ; NVRAM save-slot copy pointer.  Aliases STR_PTR, which NvRead/NvWrite clobber
000000r 2               ; exactly as PrintStr does — the two are never live at the same time.
000000r 2               NV_PTR              := STR_PTR           ; $02-$03 - caller's buffer during a slot copy
000000r 2               
000000r 2               ; Stack
000000r 2               STACK               := $0100             ; $0100-$01FF
000000r 2               
000000r 2               ; Input Buffer
000000r 2               INPUT_BUFFER        := $0200             ; $0200-$02FF
000000r 2               
000000r 2               ; Kernal Vars
000000r 2               KERNAL_VARS         := $0300             ; $0300-$03FF
000000r 2               IRQ_PTR             := $0300             ; $0300-$0301
000000r 2               BRK_PTR             := $0302             ; $0302-$0303
000000r 2               NMI_PTR             := $0304             ; $0304-$0305
000000r 2               IO_MODE             := $0306             ; Bit 0: 0=video, 1=serial output
000000r 2               VID_CURSOR_X        := $0307             ; Video cursor column (0-39)
000000r 2               VID_CURSOR_Y        := $0308             ; Video cursor row (0-23)
000000r 2               VID_CURSOR_ADDR     := $0309             ; Video cursor VRAM address ($0309-$030A)
000000r 2               RTC_BUF_CENT        := $030B             ; Century value from last RtcReadDate / for RtcWriteDate
000000r 2               RTC_TMP             := $030C             ; Scratch byte for BCD conversion
000000r 2               HW_PRESENT          := $030D             ; Hardware present bitmask (set during Reset probe)
000000r 2               ; HW_PRESENT bit definitions (bit order matches IO slot numbers)
000000r 2               HW_RAM_L            = %00000001          ; Bit 0: RAM card low  (IO 1, $8000-$83FF)
000000r 2               HW_RAM_H            = %00000010          ; Bit 1: RAM card high (IO 2, $8400-$87FF)
000000r 2               HW_RTC              = %00000100          ; Bit 2: RTC card (IO 3, DS1511Y)
000000r 2               HW_CF               = %00001000          ; Bit 3: Storage card (IO 4, CompactFlash)
000000r 2               HW_SC               = %00010000          ; Bit 4: Serial card (IO 5, R65C51)
000000r 2               HW_GPIO             = %00100000          ; Bit 5: GPIO card (IO 6, 65C22 VIA — keyboard/joysticks)
000000r 2               HW_SID              = %01000000          ; Bit 6: Sound card (IO 7, SID/ARMSID)
000000r 2               HW_VID              = %10000000          ; Bit 7: Video card (IO 8, PICOVDP)
000000r 2               BAS_PENDKEY         := $030E             ; Pending key from BasCheckBreak (1 byte)
000000r 2               CF_DISK             := $030F             ; Current CF "disk" bank (0-255); base LBA = CF_DISK * FS_DISK_SECTORS
000000r 2               BRK_P               := $0310             ; Saved P at time of BRK
000000r 2               BRK_PCL             := $0311             ; Saved PCL at time of BRK (points to BRK+2)
000000r 2               BRK_PCH             := $0312             ; Saved PCH at time of BRK
000000r 2               BRK_A               := $0313             ; Saved A at time of BRK
000000r 2               BRK_X               := $0314             ; Saved X at time of BRK
000000r 2               BRK_Y               := $0315             ; Saved Y at time of BRK
000000r 2               BRK_SP              := $0316             ; Saved SP at time of BRK
000000r 2               XFER_REMAIN         := $0317             ; $0317-$0318 - Remaining bytes to transfer (2 bytes)
000000r 2               XFER_IO_SAVE        := $0319             ; Saved IO_MODE before switching to serial
000000r 2               BAS_DATAPTR         := $031A             ; $031A-$031B - DATA read position (2 bytes)
000000r 2               BAS_STOPLINE        := $031C             ; $031C-$031D - Saved BAS_CURLINE for CONT (2 bytes)
000000r 2               BAS_STOPTXT         := $031E             ; $031E-$031F - Saved BAS_TXTPTR for CONT (2 bytes)
000000r 2               ; $0320-$0347 unassigned (1.x's SCROLL_BUF; the console scrolls in hardware)
000000r 2               ; Filesystem temp vars ($0348+)
000000r 2               FS_START_SEC        := $0348             ; $0348-$0349 - File start sector (2 bytes)
000000r 2               FS_FILE_SIZE        := $034A             ; $034A-$034B - File size in bytes (2 bytes)
000000r 2               FS_SEC_COUNT        := $034C             ; Number of sectors to read/write
000000r 2               FS_DIR_IDX          := $034D             ; Directory entry index (0-15)
000000r 2               FS_NEXT_SEC         := $034E             ; $034E-$034F - Next free sector for allocation (2 bytes)
000000r 2               FS_FNAME_BUF        := $0350             ; $0350-$035A - 11-byte filename buffer (8 name + 3 ext)
000000r 2               BOOT_VECTOR         := $035B             ; $035B-$035C - Cart/boot redirect vector (2 bytes, 0=normal boot)
000000r 2               
000000r 2               ; BASIC runtime variables ($035D-$038F) - additive; assignable by BASIC
000000r 2               BAS_TXTTAB          := $035D             ; $035D-$035E - Start of program text (= $0800)
000000r 2               BAS_VARTAB          := $035F             ; $035F-$0360 - End-of-program / start-of-vars pointer
000000r 2               BAS_ARYTAB          := $0361             ; $0361-$0362 - Start of arrays
000000r 2               BAS_STREND          := $0363             ; $0363-$0364 - End of arrays
000000r 2               BAS_FRETOP          := $0365             ; $0365-$0366 - Top-of-string-heap pointer
000000r 2               BAS_MEMSIZ          := $0367             ; $0367-$0368 - End of usable memory (= $8000)
000000r 2               BAS_CURLIN          := $0369             ; $0369-$036A - Currently executing line ($FFFF=direct mode)
000000r 2               BAS_OLDLIN          := $036B             ; $036B-$036C - Saved line for CONT
000000r 2               BAS_OLDTEXT         := $036D             ; $036D-$036E - Saved text ptr for CONT
000000r 2               BAS_WARM            := $036F             ; Warm-start magic ($A5 = previously initialised)
000000r 2               BAS_POSX            := $0370             ; PRINT column counter (0-39 video / 0-79 serial)
000000r 2               BAS_INPSAV          := $0371             ; $0371-$0372 - Saved TXTPTR across INPUT REDO retry
000000r 2               BAS_FNPTR           := $0373             ; $0373-$0374 - FN variable slot addr held across FnCall's expression evaluations (out of ZP so FrmEvl/Garbag cannot touch it)
000000r 2               BAS_STKBASE         := $0375             ; Stack pointer the READY loop restores before each direct-mode line: $FF with no
000000r 2                                                        ;   program suspended, or the running program's statement-boundary SP after a
000000r 2                                                        ;   STOP/END/Ctrl+C break, which is what keeps its FOR and GOSUB frames alive
000000r 2                                                        ;   for CONT.  Reset to $FF wherever the stack is reset (RUN, CLR, NEW, an error)
000000r 2               FS_IO_ADDR          := $037F             ; $037F-$0380 - Load/save target address for FsLoadFileAddr/FsSaveFileAddr
000000r 2               BAS_FNAME           := $0381             ; $0381-$038D - 13-byte scratch for null-terminated 8.3 filename (12-char "NAME.EXT" + null)
000000r 2               PRG_IMAGE_END       := $038E             ; $038E-$038F - End address of a program image placed at PROGRAM_START by a loader
000000r 2                                                        ;   outside BASIC; 0 = none.  Cleared by KernalInit and consumed by
000000r 2                                                        ;   ProgramEnd, so a stale value can never be mistaken for a fresh load.
000000r 2               
000000r 2               ; Kernal NVRAM save-slot variables ($0390-$03FF)
000000r 2               NV_ID               := $0390             ; Owner ID input for NvWrite ($00 is refused — that is NvErase)
000000r 2               
000000r 2               ; Kernal video variables ($0391-$039B)
000000r 2               VID_PEN             := $0391             ; Attribute byte for new output, fg<<4 | bg ($1F from KernalInit)
000000r 2               VID_TOP             := $0392             ; Name-table row shown at the top of the screen (0-23); L0SCRY = VID_TOP * 8
000000r 2               VID_MODE            := $0393             ; $00 = console not set up since KernalInit (card in the legacy submode);
000000r 2                                                        ;   $01 = text console intact.  Otherwise low nibble = the VMODE the Kernal
000000r 2                                                        ;   last set, b7 = disturbed (sprites, scroll, layers)
000000r 2               VDP_FW              := $0394             ; STAT5 (firmware version, BCD) at boot; $00 if no card
000000r 2               VDP_CAPS            := $0395             ; STAT6 (capability bits) at boot; $00 if no card
000000r 2               VDP_L0CTRL_SHADOW   := $0396             ; Shadow of the write-only L0CTRL register
000000r 2               VDP_L1CTRL_SHADOW   := $0397             ; Shadow of the write-only L1CTRL register
000000r 2               VDP_P0              := $0398             ; Parameter block for VDP entries that take more than A/X/Y
000000r 2               VDP_P1              := $0399
000000r 2               VDP_P2              := $039A
000000r 2               VDP_P3              := $039B
000000r 2               
000000r 2               FS_SECTOR_BUF       := $0600             ; $0600-$07FF - 512-byte sector buffer (overlaps BAS_TOKBUF/BAS_STRBUF)
000000r 2               
000000r 2               ; XModem Protocol Constants
000000r 2               XMODEM_SOH          = $01                ; Start of Header
000000r 2               XMODEM_EOT          = $04                ; End of Transmission
000000r 2               XMODEM_ACK          = $06                ; Acknowledge
000000r 2               XMODEM_NAK          = $15                ; Negative Acknowledge
000000r 2               XMODEM_CAN          = $18                ; Cancel
000000r 2               XMODEM_SUB          = $1A                ; Padding byte (end of last block)
000000r 2               XMODEM_BLKSZ        = 128                ; Data bytes per block
000000r 2               XMODEM_MAXRETRY     = 10                 ; Max retries per block during transfer
000000r 2               XMODEM_STARTRETRY   = 60                 ; Retries waiting for initial connect (~60s)
000000r 2               
000000r 2               ; BIOS Version
000000r 2               BIOS_VERSION_MAJOR  = 2
000000r 2               BIOS_VERSION_MINOR  = 0
000000r 2               
000000r 2               ; NOT user memory, despite the name -- kept only because Wozmon builds its input
000000r 2               ; buffer on it.  Every byte of $0400-$07FF belongs to something: $0400 is
000000r 2               ; BAS_LINBUF (the raw input line), $0500 is BAS_TOKBUF (tokenizing scratch), and
000000r 2               ; $0600-$07FF is FS_SECTOR_BUF, which any filesystem call overwrites.  A program
000000r 2               ; wanting scratch space has $003A-$00FF in zero page and everything above itself
000000r 2               ; up to MEMORY_TOP.
000000r 2               USER_VARS           := $0400             ; $0400-$07FF - see above; Wozmon's input buffer
000000r 2               
000000r 2               ; Program
000000r 2               PROGRAM_START       := $0800             ; $0800-$7FFF
000000r 2               MEMORY_TOP          := $8000             ; First address past usable RAM (I/O starts here)
000000r 2               
000000r 2               ; RAM Card | IO 1 | $8000-$83FF
000000r 2               RAM_DATA_L          := $8000             ; R/W ($8000-$83FE)
000000r 2               RAM_BANK_L          := $83FF             ; Write-only RAM bank latch, value ($00-$FF) sets which of 256 ~1K banks of RAM is selected
000000r 2               
000000r 2               ; RAM Card | IO 2 | $8400-$87FF
000000r 2               RAM_DATA_H          := $8400             ; R/W ($8400-$87FE)
000000r 2               RAM_BANK_H          := $87FF             ; Write-only RAM bank latch, value ($00-$FF) sets which of 256 ~1K banks of RAM is selected
000000r 2               
000000r 2               ; RTC Card (DS1511Y) | IO 3 | $8800-$881F
000000r 2               RTC_SEC             := $8800
000000r 2               RTC_MIN             := $8801
000000r 2               RTC_HR              := $8802
000000r 2               RTC_DAY             := $8803
000000r 2               RTC_DATE            := $8804
000000r 2               RTC_MON             := $8805
000000r 2               RTC_YR              := $8806
000000r 2               RTC_CENT            := $8807
000000r 2               RTC_ALARM_SEC       := $8808
000000r 2               RTC_ALARM_MIN       := $8809
000000r 2               RTC_ALARM_HR        := $880A
000000r 2               RTC_ALARM_DATE      := $880B
000000r 2               RTC_WD_L            := $880C
000000r 2               RTC_WD_H            := $880D
000000r 2               RTC_CTRL_A          := $880E
000000r 2               RTC_CTRL_B          := $880F
000000r 2               RTC_RAM_ADDR        := $8810
000000r 2               RTC_RAM_DATA        := $8813
000000r 2               ; DS1511Y Control Register B Bits
000000r 2               RTC_CTRL_B_TE       := %10000000         ; Transfer Enable — 1 = counters update the user registers once a second, 0 = inhibited
000000r 2               RTC_CTRL_B_BME      := %00100000         ; Burst Mode Enable — 1 = RTC_RAM_ADDR auto-increments on each access of RTC_RAM_DATA
000000r 2               ; DS1511Y Month Register (05H) — upper 3 bits are control bits, low 5 are month
000000r 2               RTC_MON_MASK        := %00011111         ; Month value occupies the low 5 bits
000000r 2               RTC_MON_EOSC        := %10000000         ; Oscillator Start/Stop (0 = oscillator running)
000000r 2               RTC_MON_E32K        := %01000000         ; 32kHz square-wave enable (1 = SQW output disabled)
000000r 2               RTC_MON_BB32        := %00100000         ; Battery-backup 32kHz SQW enable (1 = enabled in backup)
000000r 2               ; NVRAM save slots — slot n occupies NVRAM n*16 .. n*16+15:
000000r 2               ;   +0 owner ID ($00 = free), +1 checksum, +2..+15 payload
000000r 2               ; Checksum: ck = NV_CK_SEED, then ck = rol8(ck) EOR b for the ID and the 14 payload bytes
000000r 2               NV_SLOTS            = 16                 ; Save slots in RTC NVRAM
000000r 2               NV_SLOT_SIZE        = 16                 ; Bytes per slot (slot n at NVRAM n*16)
000000r 2               NV_SLOT_DATA        = 14                 ; Payload bytes per slot
000000r 2               NV_CK_SEED          = $A6                ; Checksum seed
000000r 2               NV_EMPTY            = 0                  ; NvStat: slot is free
000000r 2               NV_VALID            = 1                  ; NvStat: owner ID set, checksum agrees
000000r 2               NV_BAD              = 2                  ; NvStat: owner ID set, checksum does not
000000r 2               
000000r 2               ; Storage Card (CompactFlash 8-bit IDE) | IO 4 | $8C00-$8C07
000000r 2               ST_DATA             := $8C00             ; R/W
000000r 2               ST_ERROR            := $8C01             ; Read
000000r 2               ST_FEATURE          := $8C01             ; Write
000000r 2               ST_SECT_CNT         := $8C02             ; R/W
000000r 2               ST_LBA_0            := $8C03             ; R/W
000000r 2               ST_LBA_1            := $8C04             ; R/W
000000r 2               ST_LBA_2            := $8C05             ; R/W
000000r 2               ST_LBA_3            := $8C06             ; R/W
000000r 2               ST_STATUS           := $8C07             ; Read
000000r 2               ST_CMD              := $8C07             ; Write
000000r 2               ST_ERR_AMNF         := %00000001
000000r 2               ST_ERR_ABRT         := %00000100
000000r 2               ST_ERR_IDNF         := %00010000
000000r 2               ST_ERR_UNC          := %01000000
000000r 2               ST_ERR_BBK          := %10000000
000000r 2               ST_STATUS_ERR       := %00000001
000000r 2               ST_STATUS_IDX       := %00000010
000000r 2               ST_STATUS_CORR      := %00000100
000000r 2               ST_STATUS_DRQ       := %00001000
000000r 2               ST_STATUS_DSC       := %00010000
000000r 2               ST_STATUS_DWF       := %00100000
000000r 2               ST_STATUS_RDY       := %01000000
000000r 2               ST_STATUS_BSY       := %10000000
000000r 2               ; ATA Command Constants
000000r 2               ST_CMD_READ         := $20               ; Read Sectors
000000r 2               ST_CMD_WRITE        := $30               ; Write Sectors
000000r 2               ST_CMD_SET_FEAT     := $EF               ; Set Features
000000r 2               ST_FEAT_8BIT        := $01               ; Enable 8-bit data I/O
000000r 2               ST_LBA3_MASTER      := $E0               ; LBA mode, master drive (bits 7-5 = 111, bit 4 = 0)
000000r 2               ; Filesystem Constants
000000r 2               FS_DIR_LBA          = 0                  ; Directory sector at LBA 0
000000r 2               FS_DATA_START       = 1                  ; Data sectors start at LBA 1
000000r 2               FS_MAX_FILES        = 16                 ; Max directory entries
000000r 2               FS_ENTRY_SIZE       = 32                 ; Bytes per directory entry
000000r 2               FS_ENTRY_FLAGS      = 11                 ; Offset of flags byte within entry
000000r 2               FS_ENTRY_START      = 12                 ; Offset of start sector (2 bytes)
000000r 2               FS_ENTRY_FSIZE      = 14                 ; Offset of file size (2 bytes)
000000r 2               FS_FLAG_USED        = %00000001          ; Entry in use
000000r 2               FS_DISK_SECTORS     = 2048               ; Sectors per disk bank (2048 * 512 = 1 MB); 256 disks = 256 MB
000000r 2               
000000r 2               ; Serial Card / Serial Card Pro (R65C51) | IO 5 | $9000-$9003
000000r 2               SC_DATA             := $9000             ; R/W
000000r 2               SC_RESET            := $9001             ; Write
000000r 2               SC_STATUS           := $9001             ; Read
000000r 2               SC_CMD              := $9002             ; R/W
000000r 2               SC_CTRL             := $9003             ; R/W
000000r 2               SC_STATUS_IRQ       := %10000000         ; Interrupt
000000r 2               SC_STATUS_DSR       := %01000000         ; Data Set Ready
000000r 2               SC_STATUS_DCD       := %00100000         ; Data Carrier Detect
000000r 2               SC_STATUS_TDRE      := %00010000         ; TX Data Register Empty
000000r 2               SC_STATUS_RDRF      := %00001000         ; RX Data Register Full
000000r 2               SC_STATUS_OVR       := %00000100         ; Overrun
000000r 2               SC_STATUS_FRME      := %00000010         ; Framing Error
000000r 2               SC_STATUS_PARE      := %00000001         ; Parity Error
000000r 2               SC_CMD_RXIRQ_OFF    := %00000010         ; Receiver interrupt disabled
000000r 2               
000000r 2               ; GPIO Card / Input Board (65C22) | IO 6 | $9400-$940F
000000r 2               GPIO_PORTB          := $9400
000000r 2               GPIO_PORTA          := $9401
000000r 2               GPIO_DDRB           := $9402
000000r 2               GPIO_DDRA           := $9403
000000r 2               GPIO_T1CL           := $9404
000000r 2               GPIO_T1CH           := $9405
000000r 2               GPIO_T1LL           := $9406
000000r 2               GPIO_T1LH           := $9407
000000r 2               GPIO_T2CL           := $9408
000000r 2               GPIO_T2CH           := $9409
000000r 2               GPIO_SR             := $940A
000000r 2               GPIO_ACR            := $940B
000000r 2               GPIO_PCR            := $940C
000000r 2               GPIO_IFR            := $940D
000000r 2               GPIO_IER            := $940E
000000r 2               GPIO_ORA            := $940F
000000r 2               ; Keyboard (VIA) Constants
000000r 2               GPIO_PCR_CB2_LO     := %11000000         ; PCR CB2 mode = manual output low (enables matrix keyboard encoder)
000000r 2               GPIO_PCR_CB2_HI     := %11100000         ; PCR CB2 mode = manual output high (disables matrix keyboard encoder)
000000r 2               GPIO_PCR_CB1_NEG    := %00000000         ; PCR CB1 active on falling (high-to-low) edge
000000r 2               GPIO_PCR_CA2_LO     := %00001100         ; PCR CA2 mode = manual output low (enables PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA2_HI     := %00001110         ; PCR CA2 mode = manual output high (disables PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA1_NEG    := %00000000         ; PCR CA1 active on falling (high-to-low) edge
000000r 2               GPIO_INT_CB1        := %00010000         ; IFR/IER bit 4 = CB1 interrupt flag/enable
000000r 2               GPIO_INT_CA1        := %00000010         ; IFR/IER bit 1 = CA1 interrupt flag/enable
000000r 2               GPIO_IER_SET        := %10000000         ; IER bit 7 = set mode (1=set named bits, 0=clear)
000000r 2               
000000r 2               ; Sound Card (SID/ARMSID) | IO 7 | $9800-$981C
000000r 2               SID_V1_FREQ_LO      := $9800             ; Voice 1 Frequency Low
000000r 2               SID_V1_FREQ_HI      := $9801             ; Voice 1 Frequency High
000000r 2               SID_V1_PW_LO        := $9802             ; Voice 1 Pulse Width Low
000000r 2               SID_V1_PW_HI        := $9803             ; Voice 1 Pulse Width High
000000r 2               SID_V1_CTRL         := $9804             ; Voice 1 Control Register
000000r 2               SID_V1_AD           := $9805             ; Voice 1 Attack/Decay
000000r 2               SID_V1_SR           := $9806             ; Voice 1 Sustain/Release
000000r 2               SID_V2_FREQ_LO      := $9807             ; Voice 2 Frequency Low
000000r 2               SID_V2_FREQ_HI      := $9808             ; Voice 2 Frequency High
000000r 2               SID_V2_PW_LO        := $9809             ; Voice 2 Pulse Width Low
000000r 2               SID_V2_PW_HI        := $980A             ; Voice 2 Pulse Width High
000000r 2               SID_V2_CTRL         := $980B             ; Voice 2 Control Register
000000r 2               SID_V2_AD           := $980C             ; Voice 2 Attack/Decay
000000r 2               SID_V2_SR           := $980D             ; Voice 2 Sustain/Release
000000r 2               SID_V3_FREQ_LO      := $980E             ; Voice 3 Frequency Low
000000r 2               SID_V3_FREQ_HI      := $980F             ; Voice 3 Frequency High
000000r 2               SID_V3_PW_LO        := $9810             ; Voice 3 Pulse Width Low
000000r 2               SID_V3_PW_HI        := $9811             ; Voice 3 Pulse Width High
000000r 2               SID_V3_CTRL         := $9812             ; Voice 3 Control Register
000000r 2               SID_V3_AD           := $9813             ; Voice 3 Attack/Decay
000000r 2               SID_V3_SR           := $9814             ; Voice 3 Sustain/Release
000000r 2               SID_FC_LO           := $9815             ; Filter Cutoff Low
000000r 2               SID_FC_HI           := $9816             ; Filter Cutoff High
000000r 2               SID_RES_FILT        := $9817             ; Resonance/Filter
000000r 2               SID_MODE_VOL        := $9818             ; Filter Mode/Volume
000000r 2               SID_PADDLE_X        := $9819             ; Paddle X (Read-only)
000000r 2               SID_PADDLE_Y        := $981A             ; Paddle Y (Read-only)
000000r 2               SID_OSC3            := $981B             ; Oscillator 3 (Read-only)
000000r 2               SID_ENV3            := $981C             ; Envelope 3 (Read-only)
000000r 2               ; SID Control Register Bits
000000r 2               SID_CTRL_GATE       := %00000001         ; Gate bit
000000r 2               SID_CTRL_SYNC       := %00000010         ; Sync bit
000000r 2               SID_CTRL_RING       := %00000100         ; Ring modulation
000000r 2               SID_CTRL_TEST       := %00001000         ; Test bit
000000r 2               SID_CTRL_TRIANGLE   := %00010000         ; Triangle waveform
000000r 2               SID_CTRL_SAWTOOTH   := %00100000         ; Sawtooth waveform
000000r 2               SID_CTRL_PULSE      := %01000000         ; Pulse waveform
000000r 2               SID_CTRL_NOISE      := %10000000         ; Noise waveform
000000r 2               ; SID Filter Mode Bits
000000r 2               SID_FILT_LP         := %00010000         ; Low-pass filter
000000r 2               SID_FILT_BP         := %00100000         ; Band-pass filter
000000r 2               SID_FILT_HP         := %01000000         ; High-pass filter
000000r 2               SID_FILT_3OFF       := %10000000         ; Voice 3 off
000000r 2               
000000r 2               ; Video Card (6502-PICOVDP) | IO 8 | $9C00-$9C03
000000r 2               ; Two complete port pairs.  The Kernal uses port A only; port B is for interrupt
000000r 2               ; handlers (SPEC §4).  A register write is two writes to a command port: the
000000r 2               ; value, then the register number with bit 7 set.
000000r 2               VC_DATA             := $9C00             ; R/W  VRAM data, port A
000000r 2               VC_REG              := $9C01             ; Write  command, port A
000000r 2               VC_STATUS           := $9C01             ; Read  status (STATSEL_A selects which), port A
000000r 2               VC_DATA2            := $9C02             ; R/W  VRAM data, port B
000000r 2               VC_REG2             := $9C03             ; Write  command, port B
000000r 2               VC_STATUS2          := $9C03             ; Read  status (STATSEL_B selects which), port B
000000r 2               VDP_ID              = $AC                ; STAT4, the identification byte
000000r 2               ; Registers (SPEC §5).  All write-only.
000000r 2               VDP_MODE0           = $00                ; b1 M3
000000r 2               VDP_MODE1           = $01                ; b6 display enable, b5 vblank IRQ enable, b4 M1, b3 M2, b1 sprite size, b0 magnify
000000r 2                                                        ; $02-$06 are legacy aliases of L0NAME, L0ATTR, L0PAT, SPRATTR, SPRPAT
000000r 2               VDP_COLOR           = $07                ; b7:4 default foreground, b3:0 backdrop/border
000000r 2               VDP_VBANK           = $08                ; VRAM address bits 15:14, sampled by an address command
000000r 2               VDP_VINC            = $09                ; VRAM pointer stride, signed (the Kernal assumes +1)
000000r 2               VDP_IRQEN           = $0A                ; b0 vblank, b1 scanline, b2 sprite overflow, b3 collision
000000r 2               VDP_IRQLINE         = $0B                ; Scanline compare value
000000r 2               VDP_PALBASE         = $0C                ; Palette base, x $400 ($3F = $FC00)
000000r 2               VDP_VMODE           = $0D                ; $0 legacy submode, $1 Text, $2 Compact, $3 Graphics, $4 Full
000000r 2               VDP_STATSEL_B       = $0E                ; Status register port B returns
000000r 2               VDP_STATSEL_A       = $0F                ; Status register port A returns
000000r 2               VDP_L0NAME          = $10                ; Layer 0 name table base, x $400
000000r 2               VDP_L0ATTR          = $11                ; Layer 0 attribute table base, x $400
000000r 2               VDP_L0PAT           = $12                ; Layer 0 pattern table base, x $800
000000r 2               VDP_L0SCRX          = $13                ; Layer 0 horizontal scroll, pixels (bit 8 = L0CTRL b6)
000000r 2               VDP_L0SCRY          = $14                ; Layer 0 vertical scroll, pixels
000000r 2               VDP_L0CTRL          = $15                ; b1:0 depth, b3:2 attribute source, b4 enable, b5 index 0 opaque, b6 X bit 8
000000r 2               VDP_L0PAL           = $16                ; Layer 0 palette group high bits
000000r 2               VDP_L1NAME          = $18                ; Layer 1 name table base, x $400
000000r 2               VDP_L1ATTR          = $19                ; Layer 1 attribute table base, x $400
000000r 2               VDP_L1PAT           = $1A                ; Layer 1 pattern table base, x $800
000000r 2               VDP_L1SCRX          = $1B                ; Layer 1 horizontal scroll, pixels (bit 8 = L1CTRL b6)
000000r 2               VDP_L1SCRY          = $1C                ; Layer 1 vertical scroll, pixels
000000r 2               VDP_L1CTRL          = $1D                ; As VDP_L0CTRL
000000r 2               VDP_L1PAL           = $1E                ; Layer 1 palette group high bits
000000r 2               VDP_SPRATTR         = $20                ; Sprite attribute table base, x $80
000000r 2               VDP_SPRPAT          = $21                ; Sprite pattern table base, x $800
000000r 2               VDP_SPRCOUNT        = $22                ; Active sprite slots, 0-64
000000r 2               VDP_SPRCTRL         = $23                ; b0 enable, b1 collision, b2 $D0 terminates, b3 detailed collision, b5:4 depth
000000r 2               VDP_SPRLIMIT        = $24                ; Sprites drawn per scanline, 1-32
000000r 2               VDP_SPRPAL          = $25                ; Sprite palette group high bits
000000r 2               ; STAT6 capability bits (SPEC §6)
000000r 2               VDP_CAP_LAYERS      = %00000001          ; Two layers
000000r 2               VDP_CAP_8BPP        = %00000010          ; 8bpp layer
000000r 2               VDP_CAP_FLIP        = %00000100          ; Sprite flip
000000r 2               VDP_CAP_SCROLL      = %00001000          ; Hardware scroll
000000r 2               VDP_CAP_SCANIRQ     = %00010000          ; Scanline IRQ
000000r 2               VDP_CAP_64K         = %00100000          ; 64 KB VRAM
000000r 2               
000000r 1               
000000r 1               .segment "KERNAL"
000000r 1               .include "Kernal.asm"
000000r 2               ; =============================================================================
000000r 2               ; KERNAL  —  Hardware Driver Library and Jump Table
000000r 2               ;             for AC6502 Homebrew Computer
000000r 2               ;
000000r 2               ;   ROM Region  :  $A000-$B7FF  (6,144 bytes / $1800)
000000r 2               ;   Segment     :  KERNAL
000000r 2               ;   Entry point :  Chrout  (jump table, first byte of segment = $A000)
000000r 2               ;   Assembler   :  ca65  (cc65 toolchain)
000000r 2               ;   Linker cfg  :  BIOS.cfg
000000r 2               ;
000000r 2               ;   Contents    :  85-slot JMP table ($A000-$A0FF) giving external code and
000000r 2               ;                   cartridges stable entry points, followed by the driver
000000r 2               ;                   implementations for character I/O, TMS9918 video, SID
000000r 2               ;                   sound, CompactFlash storage, RTC, keyboard/joystick,
000000r 2               ;                   serial (6551 + XModem), and the Reset/NMI/IRQ handlers.
000000r 2               ;
000000r 2               ;   Coding style :  Match the rest of the BIOS project.
000000r 2               ;                   * Routine / data labels : PascalCase  (e.g. ChroutDispatch,
000000r 2               ;                     KernalInit, RtcReadTime).
000000r 2               ;                   * Constants / equates    : UPPER_SNAKE_CASE  (e.g. IO_MODE).
000000r 2               ;                   * Local labels           : @camelCase or @PascalCase.
000000r 2               ;                   * Opcodes are lowercase.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; === Kernal Jump Table ($A000-$A0FF) ===
000000r 2               ; 85 slots of 3-byte JMP instructions plus 1 padding byte
000000r 2               ; Provides stable entry points for external code and cartridges
000000r 2               
000000r 2               ; --- Character I/O ---
000000r 2  4C rr rr     Chrout:         jmp ChroutDispatch      ; $A000 - Output char (dispatched by IO_MODE)
000003r 2  4C rr rr     Chrin:          jmp ChrinImpl           ; $A003 - Input char from buffer
000006r 2  4C rr rr     WriteBuffer:    jmp WriteBufferImpl     ; $A006 - Write byte to input buffer
000009r 2  4C rr rr     ReadBuffer:     jmp ReadBufferImpl      ; $A009 - Read byte from input buffer
00000Cr 2  4C rr rr     BufferSize:     jmp BufferSizeImpl      ; $A00C - Get buffer count
00000Fr 2               ; --- IO Mode ---
00000Fr 2  4C rr rr     SetIOMode:      jmp SetIOModeImpl       ; $A00F - Set IO_MODE
000012r 2  4C rr rr     GetIOMode:      jmp GetIOModeImpl       ; $A012 - Get IO_MODE
000015r 2               ; --- Video (PICOVDP) ---
000015r 2  4C rr rr     InitVideo:      jmp InitVideoImpl       ; $A015 - Text-mode console: registers, character set, palette row 0
000018r 2  4C rr rr     VideoClear:     jmp VideoClearImpl      ; $A018 - Clear video screen
00001Br 2  4C rr rr     VideoPutChar:   jmp VideoPutCharImpl    ; $A01B - Write char at cursor
00001Er 2  4C rr rr     VideoSetCursor: jmp VideoSetCursorImpl  ; $A01E - Set cursor (X=col, Y=row)
000021r 2  4C rr rr     VideoGetCursor: jmp VideoGetCursorImpl  ; $A021 - Get cursor position
000024r 2  4C rr rr     VideoScroll:    jmp VideoScrollImpl     ; $A024 - Scroll screen up one line
000027r 2  4C rr rr     VideoSetColor:  jmp VideoSetColorImpl   ; $A027 - Set the pen and the border (A = fg<<4 | bg)
00002Ar 2  4C rr rr     VideoChroutRaw: jmp VideoChroutRawImpl  ; $A02A - Output char to video (raw, no control-code handling)
00002Dr 2               ; --- Sound (SID) ---
00002Dr 2  4C rr rr     InitSID:        jmp InitSIDImpl         ; $A02D - Initialize SID
000030r 2  4C rr rr     Beep:           jmp BeepImpl            ; $A030 - Play beep tone
000033r 2  4C rr rr     SidPlayNote:    jmp SidPlayNoteImpl     ; $A033 - Play note (A=voice, X=freqLo, Y=freqHi)
000036r 2  4C rr rr     SidSilence:     jmp SidSilenceImpl      ; $A036 - Silence all voices
000039r 2  4C rr rr     SidSetVolume:   jmp SidSetVolumeImpl    ; $A039 - Set SID master volume (A=0-15)
00003Cr 2               ; --- Filesystem ---
00003Cr 2  4C rr rr     FsLoadFile:     jmp FsLoadFileImpl      ; $A03C - Load file from CF
00003Fr 2  4C rr rr     FsSaveFile:     jmp FsSaveFileImpl      ; $A03F - Save file to CF
000042r 2  4C rr rr     FsDeleteFile:   jmp FsDeleteFileImpl    ; $A042 - Delete file from CF
000045r 2               ; --- Keyboard / GPIO ---
000045r 2  4C rr rr     InitKB:         jmp InitKBImpl          ; $A045 - Initialize GPIO/VIA keyboard
000048r 2  4C rr rr     ReadJoystick1:  jmp ReadJoystick1Impl   ; $A048 - Read joystick 1
00004Br 2  4C rr rr     ReadJoystick2:  jmp ReadJoystick2Impl   ; $A04B - Read joystick 2
00004Er 2               ; --- Serial (6551) ---
00004Er 2  4C rr rr     InitSC:         jmp InitSCImpl          ; $A04E - Initialize serial 6551
000051r 2  4C rr rr     SerialChrout:   jmp SerialChroutImpl    ; $A051 - Direct serial output (bypass IO_MODE)
000054r 2  4C rr rr     XModemLoad:     jmp XModemLoadImpl      ; $A054 - Receive binary via XModem
000057r 2  4C rr rr     XModemSave:     jmp XModemSaveImpl      ; $A057 - Send binary via XModem
00005Ar 2               ; --- RTC (DS1511Y) ---
00005Ar 2  4C rr rr     RtcReadTime:    jmp RtcReadTimeImpl     ; $A05A - Read RTC time
00005Dr 2  4C rr rr     RtcReadDate:    jmp RtcReadDateImpl     ; $A05D - Read RTC date
000060r 2  4C rr rr     RtcWriteTime:   jmp RtcWriteTimeImpl    ; $A060 - Set RTC time
000063r 2  4C rr rr     RtcWriteDate:   jmp RtcWriteDateImpl    ; $A063 - Set RTC date
000066r 2  4C rr rr     RtcReadNVRAM:   jmp RtcReadNVRAMImpl    ; $A066 - Read NVRAM byte
000069r 2  4C rr rr     RtcWriteNVRAM:  jmp RtcWriteNVRAMImpl   ; $A069 - Write NVRAM byte
00006Cr 2               ; --- CompactFlash Storage ---
00006Cr 2  4C rr rr     StReadSector:   jmp StReadSectorImpl    ; $A06C - Read CF sector
00006Fr 2  4C rr rr     StWriteSector:  jmp StWriteSectorImpl   ; $A06F - Write CF sector
000072r 2  4C rr rr     StWaitReady:    jmp StWaitReadyImpl     ; $A072 - Wait CF ready
000075r 2               ; --- System ---
000075r 2  4C rr rr     SysDelay:       jmp SysDelayImpl        ; $A075 - Delay A=cnt_lo, X=cnt_hi centiseconds
000078r 2  4C rr rr     KernalInit:     jmp KernalInitImpl      ; $A078 - Initialize all hardware (caller must reset SP; no cli); rts when done
00007Br 2  4C rr rr     KernalVersion:  jmp KernalVersionImpl   ; $A07B - Get BIOS version (A=major, X=minor)
00007Er 2               ; --- Disk banking / addressed storage ---
00007Er 2  4C rr rr     FsLoadFileAddr: jmp FsLoadFileAddrImpl  ; $A07E - Load named file to FS_IO_ADDR
000081r 2  4C rr rr     FsSaveFileAddr: jmp FsSaveFileAddrImpl  ; $A081 - Save FS_FILE_SIZE bytes from FS_IO_ADDR to named file
000084r 2  4C rr rr     FsFormatDisk:   jmp FsFormatDiskImpl    ; $A084 - Zero the current disk's directory sector
000087r 2  4C rr rr     FsSetDisk:      jmp FsSetDiskImpl       ; $A087 - Select current CF disk (A=0-255)
00008Ar 2  4C rr rr     FsGetDisk:      jmp FsGetDiskImpl       ; $A08A - Get current CF disk (A=disk)
00008Dr 2  4C rr rr     FsPrintDisk:    jmp FsPrintDiskImpl     ; $A08D - Print "DISK n" + CRLF via Chrout
000090r 2               ; --- General output utilities (console = IO_MODE-routed via Chrout) ---
000090r 2  4C rr rr     PrintStr:       jmp PrintStrImpl        ; $A090 - Print NUL-terminated string (A=lo, Y=hi); clobbers A,Y,STR_PTR
000093r 2  4C rr rr     PrintCRLF:      jmp PrintCRLFImpl       ; $A093 - Print CR+LF
000096r 2  4C rr rr     PrintDecU16:    jmp PrintDecU16Impl     ; $A096 - Print unsigned 16-bit decimal (A=lo, X=hi), no leading zeros
000099r 2               ; --- Keyboard encoder control (raw port access) ---
000099r 2  4C rr rr     KBDisable:      jmp KBDisableImpl       ; $A099 - Release both encoders and settle; ports free for raw read
00009Cr 2  4C rr rr     KBEnable:       jmp KBEnableImpl        ; $A09C - Re-enable both encoders
00009Fr 2               ; --- NVRAM save slots (DS1511Y) ---
00009Fr 2  4C rr rr     NvStat:         jmp NvStatImpl          ; $A09F - Slot status (X=slot) → A=status, Y=owner ID
0000A2r 2  4C rr rr     NvRead:         jmp NvReadImpl          ; $A0A2 - Copy a valid slot's payload (X=slot, A/Y=dest lo/hi)
0000A5r 2  4C rr rr     NvWrite:        jmp NvWriteImpl         ; $A0A5 - Write a slot (X=slot, A/Y=src lo/hi, NV_ID=owner ID)
0000A8r 2  4C rr rr     NvErase:        jmp NvEraseImpl         ; $A0A8 - Zero all 16 bytes of a slot (X=slot)
0000ABr 2  4C rr rr     NvFind:         jmp NvFindImpl          ; $A0AB - Lowest slot owned by A ($00 = first free) → X
0000AEr 2  4C rr rr     NvFormat:       jmp NvFormatImpl        ; $A0AE - Erase all 16 slots
0000B1r 2               
0000B1r 2               ; --- PICOVDP ---
0000B1r 2  4C rr rr     VdpInfo:        jmp VdpInfoImpl         ; $A0B1 - Card found at boot → A=VDP_FW, X=VDP_CAPS, Y=$AC; carry set if none
0000B4r 2  4C rr rr     VdpWriteReg:    jmp VdpWriteRegImpl     ; $A0B4 - Write register (A=value, X=0-127), keeping VID_MODE and the LxCTRL shadows
0000B7r 2  4C rr rr     VdpSetMode:     jmp VdpSetModeImpl      ; $A0B7 - Write VMODE (A=1-4); carry set if out of range
0000BAr 2  4C rr rr     VdpPoke:        jmp VdpPokeImpl         ; $A0BA - Write VRAM byte A at X/Y = address lo/hi (all 64 KB)
0000BDr 2  4C rr rr     VdpPeek:        jmp VdpPeekImpl         ; $A0BD - Read VRAM byte at X/Y = address lo/hi → A
0000C0r 2  4C rr rr     VdpSetPalette:  jmp VdpSetPaletteImpl   ; $A0C0 - Palette entry X = 0-255 ← A = $0R, Y = $GB (at $FC00 + 2X)
0000C3r 2  4C rr rr     WaitVBlank:     jmp WaitVBlankImpl      ; $A0C3 - Return at the start of the next vertical blank (STAT0 untouched)
0000C6r 2  4C rr rr     VdpLoadFile:    jmp VdpLoadFileImpl     ; $A0C6 - Load named file (STR_PTR) into VRAM at FS_IO_ADDR, exactly FS_FILE_SIZE bytes
0000C9r 2  4C rr rr     VdpLoadFont:    jmp VdpLoadFontImpl     ; $A0C9 - Copy built-in font A into L0PAT and wait for it (carry set until Phase 8)
0000CCr 2  4C rr rr     VdpSprite:      jmp VdpSpriteImpl       ; $A0CC - Sprite X = 0-63 ← VDP_P0-P3 = Y, X lo, pattern, attributes (table at $2000)
0000CFr 2  4C rr rr     VdpSetScroll:   jmp VdpSetScrollImpl    ; $A0CF - Layer X = 0-1 scroll: A = x lo, Y = y, VDP_P0 = x bit 8
0000D2r 2  4C rr rr     VdpLayer:       jmp VdpLayerImpl        ; $A0D2 - Layer X = 0-1 off (A = 0) or on
0000D5r 2  4C rr rr     VdpStatus:      jmp VdpStatusImpl       ; $A0D5 - Read status register X = 0-15 on port A → A
0000D8r 2               
0000D8r 2               ; Reserved entries ($A0D8-$A0FE)
0000D8r 2  4C rr rr 4C  .repeat 13
0000DCr 2  rr rr 4C rr  
0000E0r 2  rr 4C rr rr  
0000FFr 2                               jmp UnimplementedStub
0000FFr 2               .endrepeat
0000FFr 2  00           .byte $00                             ; Pad to 256 bytes ($A0FF)
000100r 2               
000100r 2               ; === Kernal Implementation ===
000100r 2               
000100r 2               ; Stub for unimplemented jump table entries
000100r 2               UnimplementedStub:
000100r 2  60             rts
000101r 2               
000101r 2               ; Chrout dispatcher — routes output based on IO_MODE
000101r 2               ; Input: A = character to output
000101r 2               ; Modifies: Flags
000101r 2               ChroutDispatch:
000101r 2  48             pha
000102r 2  AD 06 03       lda IO_MODE
000105r 2  29 01          and #$01                      ; Bit 0: 0=video, 1=serial
000107r 2  D0 04          bne @Serial
000109r 2  68             pla
00010Ar 2  4C rr rr       jmp VideoChroutImpl
00010Dr 2               @Serial:
00010Dr 2  68             pla
00010Er 2  4C rr rr       jmp SerialChroutImpl
000111r 2               
000111r 2               ; Set IO_MODE
000111r 2               ; Input: A = mode (bit 0: 0=video, 1=serial)
000111r 2               SetIOModeImpl:
000111r 2  8D 06 03       sta IO_MODE
000114r 2  60             rts
000115r 2               
000115r 2               ; Get IO_MODE
000115r 2               ; Output: A = current IO_MODE
000115r 2               GetIOModeImpl:
000115r 2  AD 06 03       lda IO_MODE
000118r 2  60             rts
000119r 2               
000119r 2               ; === PICOVDP Video Driver ===
000119r 2               ;
000119r 2               ; The console is Text mode (VMODE $1): 40x24 cells of 6x8, a name table of 960
000119r 2               ; bytes at VRAM $0000 and a per-cell attribute table beside it at $0400, one
000119r 2               ; fg<<4 | bg byte for each cell.  A cell's name byte is at VID_CURSOR_ADDR and
000119r 2               ; its attribute at VID_CURSOR_ADDR | $0400.  Everything here goes through port
000119r 2               ; A and leaves VBANK = 0 and VINC = +1; nothing in the ROM touches port B, which
000119r 2               ; belongs to interrupt handlers (SPEC §4).
000119r 2               
000119r 2               ; VdpSetReg — write a VDP register through port A (no card check)
000119r 2               ; Input: A = value, X = register (0-127)
000119r 2               ; Modifies: Flags, A
000119r 2               VdpSetReg:
000119r 2  8D 01 9C       sta VC_REG                    ; Value
00011Cr 2  8A             txa
00011Dr 2  09 80          ora #$80                      ; Register number with the write flag
00011Fr 2  8D 01 9C       sta VC_REG
000122r 2  60             rts
000123r 2               
000123r 2               ; === PICOVDP entries ($A0B1-$A0D5) ===
000123r 2               ;
000123r 2               ; Each one returns carry set, having written nothing, when no card is fitted
000123r 2               ; (HW_VID clear) or an argument is out of range, and carry clear otherwise.
000123r 2               ; Port A only, and VBANK = 0, VINC = +1 on the way out, like the console.
000123r 2               
000123r 2               ; VdpInfo — What the probe found
000123r 2               ; Output: A = VDP_FW (STAT5), X = VDP_CAPS (STAT6), Y = VDP_ID ($AC); with no
000123r 2               ;         card A = X = Y = 0 and carry set
000123r 2               ; Modifies: Flags, A, X, Y
000123r 2               VdpInfoImpl:
000123r 2  AD 94 03       lda VDP_FW                    ; Both $00 when the probe found no card
000126r 2  AE 95 03       ldx VDP_CAPS
000129r 2  A0 00          ldy #$00
00012Br 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
00012Er 2  10 36          bpl VdpNoCard
000130r 2  A0 AC          ldy #VDP_ID
000132r 2  18             clc
000133r 2  60             rts
000134r 2               
000134r 2               ; VdpWriteReg — Write a VDP register, keeping the Kernal's records of it
000134r 2               ; Input: A = value, X = register (0-127)
000134r 2               ; A VMODE write sets VID_MODE: the mode, with b7 (disturbed) set when it takes
000134r 2               ; the card to Text or the legacy submode from anything else, so that only
000134r 2               ; InitVideo can say the Text console is intact.  L0CTRL and L1CTRL, which read
000134r 2               ; back as nothing, are kept in VDP_L0CTRL_SHADOW and VDP_L1CTRL_SHADOW.
000134r 2               ; Output: carry set, and nothing written, if no card or X > 127
000134r 2               ; Preserves: X, Y
000134r 2               ; Modifies: Flags, A
000134r 2               VdpWriteRegImpl:
000134r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
000137r 2  10 2D          bpl VdpNoCard
000139r 2  E0 80          cpx #$80
00013Br 2  B0 29          bcs VdpNoCard
00013Dr 2  E0 0D          cpx #VDP_VMODE
00013Fr 2  D0 12          bne @VdpWriteRegL0
000141r 2  48             pha
000142r 2  29 0F          and #$0F                      ; The mode, b3:0
000144r 2  C9 02          cmp #$02
000146r 2  B0 07          bcs @VdpWriteRegMode          ; Compact, Graphics, Full: the mode itself
000148r 2  CD 93 03       cmp VID_MODE
00014Br 2  F0 02          beq @VdpWriteRegMode          ; Text over the Text console, or legacy over legacy
00014Dr 2  09 80          ora #$80                      ; Anything else back to Text or legacy: disturbed
00014Fr 2               @VdpWriteRegMode:
00014Fr 2  8D 93 03       sta VID_MODE
000152r 2  68             pla
000153r 2               @VdpWriteRegL0:
000153r 2  E0 15          cpx #VDP_L0CTRL
000155r 2  D0 03          bne @VdpWriteRegL1
000157r 2  8D 96 03       sta VDP_L0CTRL_SHADOW
00015Ar 2               @VdpWriteRegL1:
00015Ar 2  E0 1D          cpx #VDP_L1CTRL
00015Cr 2  D0 03          bne @VdpWriteRegSet
00015Er 2  8D 97 03       sta VDP_L1CTRL_SHADOW
000161r 2               @VdpWriteRegSet:
000161r 2  20 rr rr       jsr VdpSetReg
000164r 2  18             clc
000165r 2  60             rts
000166r 2               
000166r 2               ; The shared exit for no card or a bad argument
000166r 2               VdpNoCard:
000166r 2  38             sec
000167r 2  60             rts
000168r 2               
000168r 2               ; VdpSetMode — Set VMODE: 1 Text, 2 Compact, 3 Graphics, 4 Full
000168r 2               ; Only the register (and VID_MODE, as VdpWriteReg keeps it): the tables, layers
000168r 2               ; and sprites are the caller's to lay out.  The Text console proper is
000168r 2               ; InitVideo.
000168r 2               ; Input: A = mode (1-4)
000168r 2               ; Output: carry set, and nothing written, if no card or A is out of range
000168r 2               ; Modifies: Flags, A, X
000168r 2               VdpSetModeImpl:
000168r 2  C9 01          cmp #$01
00016Ar 2  90 FA          bcc VdpNoCard
00016Cr 2  C9 05          cmp #$05
00016Er 2  B0 F6          bcs VdpNoCard
000170r 2  A2 0D          ldx #VDP_VMODE
000172r 2  80 C0          bra VdpWriteRegImpl
000174r 2               
000174r 2               ; VdpPoke — Write one byte anywhere in VRAM
000174r 2               ; Input: A = value, X = address low, Y = address high ($0000-$FFFF)
000174r 2               ; Output: carry set, and nothing written, if no card
000174r 2               ; Modifies: Flags, A, X
000174r 2               VdpPokeImpl:
000174r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
000177r 2  10 ED          bpl VdpNoCard
000179r 2  48             pha
00017Ar 2  A9 40          lda #$40                      ; Write
00017Cr 2  20 rr rr       jsr VdpAddress
00017Fr 2  68             pla
000180r 2  8D 00 9C       sta VC_DATA
000183r 2  18             clc
000184r 2  60             rts
000185r 2               
000185r 2               ; VdpPeek — Read one byte anywhere in VRAM
000185r 2               ; Input: X = address low, Y = address high ($0000-$FFFF)
000185r 2               ; Output: A = the byte; carry set, and nothing read, if no card
000185r 2               ; Modifies: Flags, A, X
000185r 2               VdpPeekImpl:
000185r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
000188r 2  10 DC          bpl VdpNoCard
00018Ar 2  A9 00          lda #$00                      ; Read: the address command prefetches it
00018Cr 2  20 rr rr       jsr VdpAddress
00018Fr 2  AD 00 9C       lda VC_DATA
000192r 2  18             clc
000193r 2  60             rts
000194r 2               
000194r 2               ; VdpSetPalette — Set one palette entry in VRAM, at $FC00 + 2 * entry
000194r 2               ; The card takes the write into its palette at once (SPEC §11).  $FC00 is where
000194r 2               ; InitVideo puts PALBASE; a program that moves PALBASE writes its own.
000194r 2               ; Input: X = entry (0-255), A = $0R, Y = $GB
000194r 2               ; Output: carry set, and nothing written, if no card
000194r 2               ; Modifies: Flags, A, X, Y
000194r 2               VdpSetPaletteImpl:
000194r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
000197r 2  10 CD          bpl VdpNoCard
000199r 2  5A             phy                           ; $GB
00019Ar 2  48             pha                           ; $0R
00019Br 2  8A             txa
00019Cr 2  0A             asl a                         ; 2 * entry: the low byte, and the carry
00019Dr 2  AA             tax                           ;   into the high one
00019Er 2  A9 FC          lda #>$FC00
0001A0r 2  69 00          adc #$00
0001A2r 2  A8             tay
0001A3r 2  A9 40          lda #$40                      ; Write
0001A5r 2  20 rr rr       jsr VdpAddress
0001A8r 2  68             pla
0001A9r 2  8D 00 9C       sta VC_DATA
0001ACr 2  68             pla
0001ADr 2  8D 00 9C       sta VC_DATA
0001B0r 2  18             clc
0001B1r 2  60             rts
0001B2r 2               
0001B2r 2               ; WaitVBlank — Return at the start of the next vertical blank
0001B2r 2               ; Polls STAT3 b0 on port A: waits while the display is in blanking, then until
0001B2r 2               ; it is, and puts STATSEL_A back to 0.  Not STAT0's F: reading STAT0 clears
0001B2r 2               ; F, OVF and COL and the STAT1 latches a program or its interrupt handler may
0001B2r 2               ; be relying on, and this leaves them all as they were.
0001B2r 2               ; No card: waits 2 cs through SysDelay instead, so a loop paced by it still
0001B2r 2               ; runs at about the speed it would, and returns carry set.
0001B2r 2               ; Modifies: Flags, A, X, Y
0001B2r 2               WaitVBlankImpl:
0001B2r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
0001B5r 2  30 09          bmi @WaitVBlankCard
0001B7r 2  A9 02          lda #2
0001B9r 2  A2 00          ldx #0
0001BBr 2  20 rr rr       jsr SysDelay
0001BEr 2  38             sec
0001BFr 2  60             rts
0001C0r 2               @WaitVBlankCard:
0001C0r 2  A9 03          lda #$03
0001C2r 2  20 rr rr       jsr VdpSelectStat             ; STAT3
0001C5r 2               @WaitVBlankOut:
0001C5r 2  AD 01 9C       lda VC_STATUS
0001C8r 2  4A             lsr a                         ; b0, vertical blanking, into carry
0001C9r 2  B0 FA          bcs @WaitVBlankOut            ; Still in the last one
0001CBr 2               @WaitVBlankIn:
0001CBr 2  AD 01 9C       lda VC_STATUS
0001CEr 2  4A             lsr a
0001CFr 2  90 FA          bcc @WaitVBlankIn             ; Not yet in the next
0001D1r 2  A9 00          lda #$00
0001D3r 2  20 rr rr       jsr VdpSelectStat             ; STATSEL_A back to STAT0, without reading it
0001D6r 2  18             clc
0001D7r 2  60             rts
0001D8r 2               
0001D8r 2               ; VdpLoadFont — Load one of the card's built-in fonts into the pattern table
0001D8r 2               ; The published slot for SPEC draft 0.5's FONT register.  Until the Kernal
0001D8r 2               ; loads the font from the card (VDP-PLAN §5 Phase 8), InitVideo still uploads
0001D8r 2               ; the character set from ROM, and this returns carry set having done nothing.
0001D8r 2               ; Input: A = font ID
0001D8r 2               ; Output: carry set
0001D8r 2               ; Modifies: Flags
0001D8r 2               VdpLoadFontImpl:
0001D8r 2  38             sec
0001D9r 2  60             rts
0001DAr 2               
0001DAr 2               ; VdpSprite — Write one sprite's four attribute bytes
0001DAr 2               ; The attribute table is taken to be at VRAM $2000 (SPRATTR = $40), where
0001DAr 2               ; BASIC's SCREEN 1-3 puts it; a program that moves SPRATTR writes its sprites
0001DAr 2               ; with VdpPoke.  Sets VID_MODE b7 (disturbed).
0001DAr 2               ; Input: X = sprite (0-63), VDP_P0 = Y, VDP_P1 = X bits 7:0, VDP_P2 = pattern,
0001DAr 2               ;        VDP_P3 = attributes (b7 = X bit 8, b6 priority, b5:4 flips, b3:0
0001DAr 2               ;        sub-palette; SPEC §10)
0001DAr 2               ; Output: carry set, and nothing written, if no card or X > 63
0001DAr 2               ; Preserves: X
0001DAr 2               ; Modifies: Flags, A, Y
0001DAr 2               VdpSpriteImpl:
0001DAr 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
0001DDr 2  10 20          bpl @VdpSpriteNone
0001DFr 2  E0 40          cpx #64
0001E1r 2  B0 1C          bcs @VdpSpriteNone
0001E3r 2  DA             phx
0001E4r 2  8A             txa
0001E5r 2  0A             asl a                         ; 4 bytes a sprite: at most 252
0001E6r 2  0A             asl a
0001E7r 2  AA             tax
0001E8r 2  A0 20          ldy #>$2000
0001EAr 2  A9 40          lda #$40                      ; Write
0001ECr 2  20 rr rr       jsr VdpAddress
0001EFr 2  A2 00          ldx #$00
0001F1r 2               @VdpSpriteByte:
0001F1r 2  BD 98 03       lda VDP_P0,x
0001F4r 2  8D 00 9C       sta VC_DATA
0001F7r 2  E8             inx
0001F8r 2  E0 04          cpx #4
0001FAr 2  D0 F5          bne @VdpSpriteByte
0001FCr 2  FA             plx
0001FDr 2  80 41          bra VdpDisturbed
0001FFr 2               @VdpSpriteNone:
0001FFr 2  38             sec
000200r 2  60             rts
000201r 2               
000201r 2               ; VdpSetScroll — Scroll a layer
000201r 2               ; Writes LxSCRX, LxSCRY, and LxCTRL with b6 = X bit 8 and its other bits from
000201r 2               ; the shadow.  Sets VID_MODE b7 (disturbed).
000201r 2               ; Input: X = layer (0-1), A = x bits 7:0, Y = y, VDP_P0 = x bit 8 (0 or not)
000201r 2               ; Output: carry set, and nothing written, if no card or X > 1
000201r 2               ; Modifies: Flags, A, X
000201r 2               VdpSetScrollImpl:
000201r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
000204r 2  10 44          bpl VdpLayerNone
000206r 2  E0 02          cpx #2
000208r 2  B0 40          bcs VdpLayerNone
00020Ar 2  5A             phy                           ; y
00020Br 2  48             pha                           ; x
00020Cr 2  BD 96 03       lda VDP_L0CTRL_SHADOW,x
00020Fr 2  29 BF          and #<~$40
000211r 2  AC 98 03       ldy VDP_P0
000214r 2  F0 02          beq @VdpSetScrollCtrl
000216r 2  09 40          ora #$40                      ; X bit 8
000218r 2               @VdpSetScrollCtrl:
000218r 2  20 rr rr       jsr VdpWriteLayerCtrl         ; X = LxCTRL
00021Br 2  CA             dex                           ; LxSCRX
00021Cr 2  CA             dex
00021Dr 2  68             pla
00021Er 2  20 rr rr       jsr VdpWriteRegImpl
000221r 2  E8             inx                           ; LxSCRY
000222r 2  68             pla
000223r 2  20 rr rr       jsr VdpWriteRegImpl
000226r 2  80 18          bra VdpDisturbed
000228r 2               
000228r 2               ; VdpLayer — Show or hide a layer
000228r 2               ; Sets or clears LxCTRL b4, keeping its other bits from the shadow.  Sets
000228r 2               ; VID_MODE b7 (disturbed).
000228r 2               ; Input: X = layer (0-1), A = 0 to hide, anything else to show
000228r 2               ; Output: carry set, and nothing written, if no card or X > 1
000228r 2               ; Modifies: Flags, A, X
000228r 2               VdpLayerImpl:
000228r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
00022Br 2  10 1D          bpl VdpLayerNone
00022Dr 2  E0 02          cpx #2
00022Fr 2  B0 19          bcs VdpLayerNone
000231r 2  A8             tay                           ; Sets Z from A
000232r 2  BD 96 03       lda VDP_L0CTRL_SHADOW,x
000235r 2  29 EF          and #<~$10
000237r 2  C0 00          cpy #$00
000239r 2  F0 02          beq @VdpLayerOff
00023Br 2  09 10          ora #$10                      ; Enable
00023Dr 2               @VdpLayerOff:
00023Dr 2  20 rr rr       jsr VdpWriteLayerCtrl
000240r 2               VdpDisturbed:                   ; VID_MODE b7: sprites, scroll or layers moved
000240r 2  AD 93 03       lda VID_MODE
000243r 2  09 80          ora #$80
000245r 2  8D 93 03       sta VID_MODE
000248r 2  18             clc
000249r 2  60             rts
00024Ar 2               VdpLayerNone:
00024Ar 2  38             sec
00024Br 2  60             rts
00024Cr 2               
00024Cr 2               ; VdpWriteLayerCtrl — LxCTRL = A for layer X (0-1) through VdpWriteReg, so the
00024Cr 2               ; shadow follows (no checks)
00024Cr 2               ; Output: X = the register, $15 or $1D
00024Cr 2               ; Modifies: Flags, A, X
00024Cr 2               VdpWriteLayerCtrl:
00024Cr 2  48             pha
00024Dr 2  8A             txa
00024Er 2  0A             asl a                         ; 0 or 8, carry clear
00024Fr 2  0A             asl a
000250r 2  0A             asl a
000251r 2  69 15          adc #VDP_L0CTRL
000253r 2  AA             tax
000254r 2  68             pla
000255r 2  4C rr rr       jmp VdpWriteRegImpl
000258r 2               
000258r 2               ; VdpStatus — Read a status register through port A
000258r 2               ; Selects STATn with STATSEL_A, reads it, and puts STATSEL_A back to 0 without
000258r 2               ; reading STAT0.  Reading STAT0 itself clears its flags, and STAT1 its
000258r 2               ; latches, as SPEC §6 says.
000258r 2               ; Input: X = status register (0-15)
000258r 2               ; Output: A = its value; carry set, and nothing read, if no card or X > 15
000258r 2               ; Preserves: X, Y
000258r 2               ; Modifies: Flags, A
000258r 2               VdpStatusImpl:
000258r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
00025Br 2  10 ED          bpl VdpLayerNone
00025Dr 2  E0 10          cpx #16
00025Fr 2  B0 E9          bcs VdpLayerNone
000261r 2  8A             txa
000262r 2  20 rr rr       jsr VdpReadStat
000265r 2  18             clc
000266r 2  60             rts
000267r 2               
000267r 2               ; VdpAddress — Point port A at any VRAM address (no card check)
000267r 2               ; VBANK = the address's bits 15:14 for the address command, then back to 0:
000267r 2               ; the card samples it there, and the pointer carries across banks by itself.
000267r 2               ; Input: A = $40 to write or $00 to read, X = address low, Y = address high
000267r 2               ; Modifies: Flags, A, X
000267r 2               VdpAddress:
000267r 2  48             pha                           ; Write or read
000268r 2  98             tya
000269r 2  0A             asl a                         ; Bits 15:14 down to 1:0
00026Ar 2  2A             rol a
00026Br 2  2A             rol a
00026Cr 2  29 03          and #$03
00026Er 2  DA             phx
00026Fr 2  A2 08          ldx #VDP_VBANK
000271r 2  20 rr rr       jsr VdpSetReg
000274r 2  68             pla
000275r 2  8D 01 9C       sta VC_REG                    ; Address low
000278r 2  98             tya
000279r 2  29 3F          and #$3F
00027Br 2  BA             tsx
00027Cr 2  1D 01 01       ora $0101,x                   ; With the write bit
00027Fr 2  8D 01 9C       sta VC_REG
000282r 2  68             pla
000283r 2  A9 00          lda #$00
000285r 2  A2 08          ldx #VDP_VBANK
000287r 2  4C rr rr       jmp VdpSetReg
00028Ar 2               
00028Ar 2               ; VdpReadStat — A = STATn for n in A, leaving STATSEL_A = 0 (no card check)
00028Ar 2               ; Modifies: Flags, A
00028Ar 2               VdpReadStat:
00028Ar 2  20 rr rr       jsr VdpSelectStat
00028Dr 2  AD 01 9C       lda VC_STATUS
000290r 2  48             pha
000291r 2  A9 00          lda #$00                      ; STATSEL_A back to STAT0, without reading it
000293r 2  20 rr rr       jsr VdpSelectStat
000296r 2  68             pla
000297r 2  60             rts
000298r 2               
000298r 2               ; VdpSelectStat — STATSEL_A = A (no card check)
000298r 2               ; Modifies: Flags, A
000298r 2               VdpSelectStat:
000298r 2  8D 01 9C       sta VC_REG
00029Br 2  A9 8F          lda #($80 | VDP_STATSEL_A)
00029Dr 2  8D 01 9C       sta VC_REG
0002A0r 2  60             rts
0002A1r 2               
0002A1r 2               ; VideoClear — Fill the screen with spaces in the current pen, cursor home
0002A1r 2               ; Fills the 960-byte name table at VRAM $0000 with $20 and the 960 attributes at
0002A1r 2               ; $0400 with VID_PEN, so COLOR fg,bg : CLS gives a screen of that colour, and
0002A1r 2               ; takes the scroll origin back to row 0.
0002A1r 2               ; Skips silently if no video card is fitted
0002A1r 2               ; Modifies: Flags, A, X, Y
0002A1r 2               VideoClearImpl:
0002A1r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7, so BIT tests it in N without
0002A4r 2  30 01          bmi @VideoClearFitted         ;   disturbing A — these routines take their
0002A6r 2  60             rts                           ;   argument there.  See the note above
0002A7r 2                                               ;   HW_PRESENT's bit definitions in BIOS.inc.
0002A7r 2               @VideoClearFitted:
0002A7r 2  AD 93 03       lda VID_MODE                  ; First use since KernalInit: bring the console
0002AAr 2  D0 03          bne VideoClearNow             ;   up, and then this is the clear it needs
0002ACr 2  20 rr rr       jsr InitVideoImpl
0002AFr 2               VideoClearNow:
0002AFr 2  A9 40          lda #$40                      ; Name table, $0000, write
0002B1r 2  A2 20          ldx #$20
0002B3r 2  20 rr rr       jsr @Fill
0002B6r 2  A9 44          lda #$44                      ; Attribute table, $0400, write
0002B8r 2  AE 91 03       ldx VID_PEN
0002BBr 2  20 rr rr       jsr @Fill
0002BEr 2  9C 92 03       stz VID_TOP                   ; Unscrolled
0002C1r 2  A9 00          lda #$00
0002C3r 2  A2 14          ldx #VDP_L0SCRY
0002C5r 2  20 rr rr       jsr VdpSetReg
0002C8r 2                 ; Reset cursor to (0,0)
0002C8r 2  9C 07 03       stz VID_CURSOR_X
0002CBr 2  9C 08 03       stz VID_CURSOR_Y
0002CEr 2  9C 09 03       stz VID_CURSOR_ADDR
0002D1r 2  9C 0A 03       stz VID_CURSOR_ADDR + 1
0002D4r 2  60             rts
0002D5r 2               @Fill:                          ; A = address command high byte, X = fill value
0002D5r 2  9C 01 9C       stz VC_REG                    ; Low byte of the address
0002D8r 2  8D 01 9C       sta VC_REG
0002DBr 2  8A             txa
0002DCr 2  A0 00          ldy #$00
0002DEr 2  A2 03          ldx #$03                      ; 3 full pages (768 bytes)
0002E0r 2               @VideoClearPage:
0002E0r 2  8D 00 9C       sta VC_DATA
0002E3r 2  C8             iny
0002E4r 2  D0 FA          bne @VideoClearPage
0002E6r 2  CA             dex
0002E7r 2  D0 F7          bne @VideoClearPage
0002E9r 2  A0 C0          ldy #192                      ; Remaining 192 bytes (960 - 768)
0002EBr 2               @VideoClearRem:
0002EBr 2  8D 00 9C       sta VC_DATA
0002EEr 2  88             dey
0002EFr 2  D0 FA          bne @VideoClearRem
0002F1r 2  60             rts
0002F2r 2               
0002F2r 2               ; VideoSetCursor — Set cursor position
0002F2r 2               ; Input: X = column (0-39), Y = row (0-23), on the screen as shown
0002F2r 2               ; VID_CURSOR_ADDR = ((Y + VID_TOP) mod 24) * 40 + X, the cell's place in the
0002F2r 2               ; name table once the scroll origin is folded in
0002F2r 2               ; Skips silently if no video card is fitted
0002F2r 2               ; Modifies: Flags, A
0002F2r 2               VideoSetCursorImpl:
0002F2r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
0002F5r 2  10 23          bpl @VideoSetCursorNone
0002F7r 2  20 rr rr       jsr VideoConsoleReady
0002FAr 2  8E 07 03       stx VID_CURSOR_X
0002FDr 2  8C 08 03       sty VID_CURSOR_Y
000300r 2  98             tya                           ; Screen row to name-table row:
000301r 2  18             clc                           ;   (row + VID_TOP) mod 24
000302r 2  6D 92 03       adc VID_TOP
000305r 2  C9 18          cmp #24
000307r 2  90 02          bcc @VideoSetCursorRow
000309r 2  E9 18          sbc #24                       ; Carry is set
00030Br 2               @VideoSetCursorRow:
00030Br 2  20 rr rr       jsr VideoRowAddr              ; VID_CURSOR_ADDR = row * 40, carry clear
00030Er 2  8A             txa                           ; Add the column
00030Fr 2  6D 09 03       adc VID_CURSOR_ADDR
000312r 2  8D 09 03       sta VID_CURSOR_ADDR
000315r 2  90 03          bcc @VideoSetCursorNone
000317r 2  EE 0A 03       inc VID_CURSOR_ADDR + 1
00031Ar 2               @VideoSetCursorNone:
00031Ar 2  60             rts
00031Br 2               
00031Br 2               ; VideoConsoleReady — Bring the Text console up on its first use
00031Br 2               ; KernalInit leaves the card in the legacy submode it resets to (VID_MODE = $00),
00031Br 2               ; so that a cartridge programming M1/M2/M3 itself sees what it saw on 1.x.  The
00031Br 2               ; console entries call this first: if the card is fitted and VID_MODE is still
00031Br 2               ; $00, InitVideo + VideoClear.  Only $00 triggers it, so a program that switched
00031Br 2               ; to another mode and then prints is not reset behind its back.
00031Br 2               ; Preserves: A, X, Y
00031Br 2               ; Modifies: Flags
00031Br 2               VideoConsoleReady:
00031Br 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
00031Er 2  10 11          bpl @VideoConsoleNone
000320r 2  48             pha
000321r 2  AD 93 03       lda VID_MODE
000324r 2  D0 0A          bne @VideoConsoleUp
000326r 2  DA             phx
000327r 2  5A             phy
000328r 2  20 rr rr       jsr InitVideoImpl             ; Sets VID_MODE = $01, so no recursion
00032Br 2  20 rr rr       jsr VideoClearNow
00032Er 2  7A             ply
00032Fr 2  FA             plx
000330r 2               @VideoConsoleUp:
000330r 2  68             pla
000331r 2               @VideoConsoleNone:
000331r 2  60             rts
000332r 2               
000332r 2               ; VideoRowAddr — VID_CURSOR_ADDR = A * 40, for a name-table row 0-23
000332r 2               ; Output: carry clear
000332r 2               ; Modifies: Flags, A
000332r 2               VideoRowAddr:
000332r 2  9C 0A 03       stz VID_CURSOR_ADDR + 1
000335r 2  0A             asl a                         ; x8 fits in a byte (23 * 8 = 184)
000336r 2  0A             asl a
000337r 2  0A             asl a
000338r 2  8D 09 03       sta VID_CURSOR_ADDR
00033Br 2  0A             asl a                         ; x32 does not: carry into the high byte
00033Cr 2  2E 0A 03       rol VID_CURSOR_ADDR + 1
00033Fr 2  0A             asl a
000340r 2  2E 0A 03       rol VID_CURSOR_ADDR + 1       ; Leaves carry clear (the high byte's b7 was 0)
000343r 2  6D 09 03       adc VID_CURSOR_ADDR           ; x32 + x8
000346r 2  8D 09 03       sta VID_CURSOR_ADDR
000349r 2  90 04          bcc @VideoRowAddrDone
00034Br 2  EE 0A 03       inc VID_CURSOR_ADDR + 1
00034Er 2  18             clc
00034Fr 2               @VideoRowAddrDone:
00034Fr 2  60             rts
000350r 2               
000350r 2               ; VideoGetCursor — Get cursor position
000350r 2               ; Output: X = column (0-39), Y = row (0-23)
000350r 2               ; Modifies: Flags
000350r 2               VideoGetCursorImpl:
000350r 2  20 rr rr       jsr VideoConsoleReady
000353r 2  AE 07 03       ldx VID_CURSOR_X
000356r 2  AC 08 03       ldy VID_CURSOR_Y
000359r 2  60             rts
00035Ar 2               
00035Ar 2               ; VideoPutChar — Write a character at VID_CURSOR_ADDR, coloured with VID_PEN
00035Ar 2               ; Input: A = character to write
00035Ar 2               ; Modifies: Flags
00035Ar 2               VideoPutCharImpl:
00035Ar 2  48             pha
00035Br 2  AD 09 03       lda VID_CURSOR_ADDR           ; Name byte
00035Er 2  8D 01 9C       sta VC_REG
000361r 2  AD 0A 03       lda VID_CURSOR_ADDR + 1
000364r 2  09 40          ora #$40                      ; Write mode
000366r 2  8D 01 9C       sta VC_REG
000369r 2  68             pla
00036Ar 2  8D 00 9C       sta VC_DATA
00036Dr 2  48             pha
00036Er 2  AD 09 03       lda VID_CURSOR_ADDR           ; Attribute byte, $0400 further on
000371r 2  8D 01 9C       sta VC_REG
000374r 2  AD 0A 03       lda VID_CURSOR_ADDR + 1
000377r 2  09 44          ora #$44                      ; Write mode, + $0400
000379r 2  8D 01 9C       sta VC_REG
00037Cr 2  AD 91 03       lda VID_PEN
00037Fr 2  8D 00 9C       sta VC_DATA
000382r 2  68             pla
000383r 2  60             rts
000384r 2               
000384r 2               ; VideoScroll — Scroll the screen up one line, in hardware
000384r 2               ; Moves the display origin down a row (VID_TOP, and L0SCRY = VID_TOP * 8) and
000384r 2               ; blanks the row that was at the top, which is now the bottom line, in the
000384r 2               ; current pen.  The name table does not move.  The cursor keeps its screen
000384r 2               ; position, so its VRAM address is worked out again.
000384r 2               ; Skips silently if no video card is fitted
000384r 2               ; Modifies: Flags, A, X, Y
000384r 2               VideoScrollImpl:
000384r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
000387r 2  10 32          bpl @VideoScrollNone
000389r 2  AD 92 03       lda VID_TOP
00038Cr 2  48             pha                           ; The row leaving the top
00038Dr 2  1A             inc a
00038Er 2  C9 18          cmp #24
000390r 2  90 02          bcc @VideoScrollTop
000392r 2  A9 00          lda #$00
000394r 2               @VideoScrollTop:
000394r 2  8D 92 03       sta VID_TOP
000397r 2  0A             asl a                         ; x8 pixels (at most 184)
000398r 2  0A             asl a
000399r 2  0A             asl a
00039Ar 2  A2 14          ldx #VDP_L0SCRY
00039Cr 2  20 rr rr       jsr VdpSetReg
00039Fr 2  68             pla
0003A0r 2  20 rr rr       jsr VideoRowAddr              ; VID_CURSOR_ADDR = that row * 40
0003A3r 2  A9 40          lda #$40                      ; Its names, write mode
0003A5r 2  A2 20          ldx #$20
0003A7r 2  20 rr rr       jsr @VideoScrollRow
0003AAr 2  A9 44          lda #$44                      ; Its attributes, write mode, + $0400
0003ACr 2  AE 91 03       ldx VID_PEN
0003AFr 2  20 rr rr       jsr @VideoScrollRow
0003B2r 2  AE 07 03       ldx VID_CURSOR_X              ; Put the cursor back on its screen cell
0003B5r 2  AC 08 03       ldy VID_CURSOR_Y
0003B8r 2  4C rr rr       jmp VideoSetCursorImpl
0003BBr 2               @VideoScrollNone:
0003BBr 2  60             rts
0003BCr 2               @VideoScrollRow:                ; A = address high bits, X = fill value
0003BCr 2  0D 0A 03       ora VID_CURSOR_ADDR + 1
0003BFr 2  AC 09 03       ldy VID_CURSOR_ADDR
0003C2r 2  8C 01 9C       sty VC_REG
0003C5r 2  8D 01 9C       sta VC_REG
0003C8r 2  8A             txa
0003C9r 2  A0 28          ldy #40
0003CBr 2               @VideoScrollFill:
0003CBr 2  8D 00 9C       sta VC_DATA
0003CEr 2  88             dey
0003CFr 2  D0 FA          bne @VideoScrollFill
0003D1r 2  60             rts
0003D2r 2               
0003D2r 2               ; VideoChrout — Output character to video display
0003D2r 2               ; Handles control characters: CR ($0D), LF ($0A), BS ($08), BEL ($07)
0003D2r 2               ; Printable ASCII ($20-$7E) written to VRAM; all other codes silently discarded
0003D2r 2               ; Auto-wraps at column 40, auto-scrolls at row 24
0003D2r 2               ; Input: A = character to output
0003D2r 2               ; Preserves: A, X, Y (callers like ChrinImpl, BasPrintStr and Wozmon depend on this)
0003D2r 2               ; Modifies: Flags
0003D2r 2               VideoChroutImpl:
0003D2r 2  20 rr rr       jsr VideoConsoleReady
0003D5r 2  48             pha
0003D6r 2  DA             phx
0003D7r 2  5A             phy
0003D8r 2                 ; Fast path: printable ASCII ($20-$7E) — most common case
0003D8r 2  C9 20          cmp #$20
0003DAr 2  90 06          bcc @Control                  ; < $20 → check control codes
0003DCr 2  C9 7F          cmp #$7F
0003DEr 2  90 14          bcc @PrintChar                ; $20-$7E → printable character
0003E0r 2                 ; >= $7F (DEL and above) — discard
0003E0r 2                 ; User programs wanting raw glyph output should use VideoChroutRaw.
0003E0r 2  80 45          bra @VideoChroutDone
0003E2r 2               @Control:
0003E2r 2  C9 0D          cmp #$0D                      ; Carriage Return?
0003E4r 2  F0 45          beq @VideoCR
0003E6r 2  C9 0A          cmp #$0A                      ; Line Feed?
0003E8r 2  F0 4E          beq @VideoLF
0003EAr 2  C9 08          cmp #$08                      ; Backspace?
0003ECr 2  F0 67          beq @VideoBS
0003EEr 2  C9 07          cmp #$07                      ; Bell?
0003F0r 2  F0 7B          beq @VideoBEL
0003F2r 2                 ; Unrecognized control code — discard
0003F2r 2  80 33          bra @VideoChroutDone
0003F4r 2               @PrintChar:
0003F4r 2                 ; Regular printable character — write at cursor and advance
0003F4r 2  20 rr rr       jsr VideoPutChar              ; Write char to VRAM at cursor
0003F7r 2                 ; Advance cursor
0003F7r 2  EE 07 03       inc VID_CURSOR_X
0003FAr 2                 ; Increment VRAM address
0003FAr 2  EE 09 03       inc VID_CURSOR_ADDR
0003FDr 2  D0 03          bne @CheckWrap
0003FFr 2  EE 0A 03       inc VID_CURSOR_ADDR + 1
000402r 2               @CheckWrap:
000402r 2  AD 07 03       lda VID_CURSOR_X
000405r 2  C9 28          cmp #40                       ; Past last column?
000407r 2  90 1E          bcc @VideoChroutDone          ; No, done
000409r 2                 ; Auto-wrap: CR + LF
000409r 2  9C 07 03       stz VID_CURSOR_X
00040Cr 2  EE 08 03       inc VID_CURSOR_Y
00040Fr 2  AD 08 03       lda VID_CURSOR_Y
000412r 2  C9 18          cmp #24                       ; Past last row?
000414r 2  90 08          bcc @WrapRecalc
000416r 2                 ; Need to scroll
000416r 2  20 rr rr       jsr VideoScroll
000419r 2  A9 17          lda #23
00041Br 2  8D 08 03       sta VID_CURSOR_Y
00041Er 2               @WrapRecalc:
00041Er 2  AE 07 03       ldx VID_CURSOR_X
000421r 2  AC 08 03       ldy VID_CURSOR_Y
000424r 2  20 rr rr       jsr VideoSetCursor            ; Recalculate VRAM address
000427r 2               @VideoChroutDone:
000427r 2  7A             ply
000428r 2  FA             plx
000429r 2  68             pla
00042Ar 2  60             rts
00042Br 2               
00042Br 2               @VideoCR:
00042Br 2  9C 07 03       stz VID_CURSOR_X              ; Column = 0
00042Er 2  A2 00          ldx #$00
000430r 2  AC 08 03       ldy VID_CURSOR_Y
000433r 2  20 rr rr       jsr VideoSetCursor            ; Recalculate VRAM address
000436r 2  80 EF          bra @VideoChroutDone
000438r 2               
000438r 2               @VideoLF:
000438r 2  EE 08 03       inc VID_CURSOR_Y
00043Br 2  AD 08 03       lda VID_CURSOR_Y
00043Er 2  C9 18          cmp #24                       ; Past last row?
000440r 2  90 08          bcc @LFRecalc
000442r 2  20 rr rr       jsr VideoScroll
000445r 2  A9 17          lda #23
000447r 2  8D 08 03       sta VID_CURSOR_Y
00044Ar 2               @LFRecalc:
00044Ar 2  AE 07 03       ldx VID_CURSOR_X
00044Dr 2  AC 08 03       ldy VID_CURSOR_Y
000450r 2  20 rr rr       jsr VideoSetCursor
000453r 2  80 D2          bra @VideoChroutDone
000455r 2               
000455r 2               @VideoBS:
000455r 2  AD 07 03       lda VID_CURSOR_X
000458r 2  F0 CD          beq @VideoChroutDone          ; Already at column 0, ignore
00045Ar 2  CE 07 03       dec VID_CURSOR_X
00045Dr 2  AE 07 03       ldx VID_CURSOR_X
000460r 2  AC 08 03       ldy VID_CURSOR_Y
000463r 2  20 rr rr       jsr VideoSetCursor            ; Recalculate VRAM address
000466r 2  A9 20          lda #$20                      ; Write space to erase character
000468r 2  20 rr rr       jsr VideoPutChar
00046Br 2  80 BA          bra @VideoChroutDone
00046Dr 2               
00046Dr 2               @VideoBEL:
00046Dr 2  20 rr rr       jsr Beep
000470r 2  80 B5          bra @VideoChroutDone
000472r 2               
000472r 2               ; VideoChroutRaw — Output character to video (raw, no control-code handling)
000472r 2               ; Always writes the character glyph at the cursor position and advances.
000472r 2               ; Input: A = character code (0-255)
000472r 2               ; Preserves: A, X, Y
000472r 2               ; Modifies: Flags
000472r 2               VideoChroutRawImpl:
000472r 2  20 rr rr       jsr VideoConsoleReady
000475r 2  48             pha
000476r 2  DA             phx
000477r 2  5A             phy
000478r 2  20 rr rr       jsr VideoPutChar              ; Write char to VRAM at cursor
00047Br 2  EE 07 03       inc VID_CURSOR_X
00047Er 2  EE 09 03       inc VID_CURSOR_ADDR
000481r 2  D0 03          bne @RawCheckWrap
000483r 2  EE 0A 03       inc VID_CURSOR_ADDR + 1
000486r 2               @RawCheckWrap:
000486r 2  AD 07 03       lda VID_CURSOR_X
000489r 2  C9 28          cmp #40                       ; Past last column?
00048Br 2  90 1E          bcc @RawDone
00048Dr 2  9C 07 03       stz VID_CURSOR_X
000490r 2  EE 08 03       inc VID_CURSOR_Y
000493r 2  AD 08 03       lda VID_CURSOR_Y
000496r 2  C9 18          cmp #24                       ; Past last row?
000498r 2  90 08          bcc @RawRecalc
00049Ar 2  20 rr rr       jsr VideoScroll
00049Dr 2  A9 17          lda #23
00049Fr 2  8D 08 03       sta VID_CURSOR_Y
0004A2r 2               @RawRecalc:
0004A2r 2  AE 07 03       ldx VID_CURSOR_X
0004A5r 2  AC 08 03       ldy VID_CURSOR_Y
0004A8r 2  20 rr rr       jsr VideoSetCursor
0004ABr 2               @RawDone:
0004ABr 2  7A             ply
0004ACr 2  FA             plx
0004ADr 2  68             pla
0004AEr 2  60             rts
0004AFr 2               
0004AFr 2               ; PrintStr — Print a NUL-terminated string to the console (routed by IO_MODE
0004AFr 2               ; through Chrout, so it works for video OR serial).  General-purpose; used by
0004AFr 2               ; BASIC (via the BasPrintStr alias) and available to cartridges.
0004AFr 2               ; Input : A = string address low, Y = string address high
0004AFr 2               ; Output: A, Y clobbered; X preserved; clobbers STR_PTR (Chrout preserves it)
0004AFr 2               PrintStrImpl:
0004AFr 2  85 02          sta STR_PTR
0004B1r 2  84 03          sty STR_PTR + 1
0004B3r 2  A0 00          ldy #$00
0004B5r 2               @PrintStrLoop:
0004B5r 2  B1 02          lda (STR_PTR),y
0004B7r 2  F0 06          beq @PrintStrDone             ; NUL terminator
0004B9r 2  20 rr rr       jsr Chrout
0004BCr 2  C8             iny
0004BDr 2  D0 F6          bne @PrintStrLoop             ; Max 256 chars per call
0004BFr 2               @PrintStrDone:
0004BFr 2  60             rts
0004C0r 2               
0004C0r 2               ; PrintCRLF — Emit CR ($0D) then LF ($0A) via Chrout.
0004C0r 2               PrintCRLFImpl:
0004C0r 2  A9 0D          lda #$0D
0004C2r 2  20 rr rr       jsr Chrout
0004C5r 2  A9 0A          lda #$0A
0004C7r 2  4C rr rr       jmp Chrout
0004CAr 2               
0004CAr 2               ; KernalInit — Initialize RAM variables, probe & init all hardware
0004CAr 2               ; Sets HW_PRESENT, IO_MODE, IRQ/BRK/NMI pointers, BOOT_VECTOR=0
0004CAr 2               ; Does NOT enable interrupts (caller must cli)
0004CAr 2               ; Does NOT reset the stack pointer (caller should do this before JSR)
0004CAr 2               ; Does NOT print anything or start BASIC
0004CAr 2               ; Modifies: All registers, flags
0004CAr 2               KernalInitImpl:
0004CAr 2  D8             cld                           ; Clear decimal mode
0004CBr 2  78             sei                           ; Disable interrupts
0004CCr 2               
0004CCr 2  A9 rr          lda #<Irq                     ; Initialize the IRQ pointer
0004CEr 2  8D 00 03       sta IRQ_PTR
0004D1r 2  A9 rr          lda #>Irq
0004D3r 2  8D 01 03       sta IRQ_PTR + 1
0004D6r 2               
0004D6r 2  A9 rr          lda #<Break                   ; Initialize the BRK pointer
0004D8r 2  8D 02 03       sta BRK_PTR
0004DBr 2  A9 rr          lda #>Break
0004DDr 2  8D 03 03       sta BRK_PTR + 1
0004E0r 2               
0004E0r 2  A9 rr          lda #<Nmi                     ; Initialize the NMI pointer
0004E2r 2  8D 04 03       sta NMI_PTR
0004E5r 2  A9 rr          lda #>Nmi
0004E7r 2  8D 05 03       sta NMI_PTR + 1
0004EAr 2               
0004EAr 2  9C 0D 03       stz HW_PRESENT                ; Clear all hardware flags
0004EDr 2  9C 5B 03       stz BOOT_VECTOR               ; Clear boot redirect vector
0004F0r 2  9C 5C 03       stz BOOT_VECTOR + 1
0004F3r 2  9C 8E 03       stz PRG_IMAGE_END             ; No externally-loaded program image yet.  This
0004F6r 2  9C 8F 03       stz PRG_IMAGE_END + 1         ;   runs before any loader can, so a non-zero
0004F9r 2                                               ;   value always means a loader put it there
0004F9r 2  9C 0F 03       stz CF_DISK                   ; Reset current CF disk bank to 0
0004FCr 2  A9 1F          lda #$1F                      ; Black on white.  Only KernalInit resets the
0004FEr 2  8D 91 03       sta VID_PEN                   ;   pen: NEW, RUN, CLR and errors keep it
000501r 2               
000501r 2  20 rr rr       jsr InitBuffer                ; Initialize the input buffer (RAM-only, no hardware)
000504r 2               
000504r 2  20 rr rr       jsr ProbeRAM                  ; Sets HW_RAM_L / HW_RAM_H if present (no init needed)
000507r 2               
000507r 2  20 rr rr       jsr ProbeRTC                  ; Sets HW_RTC if present (no init needed)
00050Ar 2               
00050Ar 2  20 rr rr       jsr StInit                    ; CF: timeout will handle absent card in Phase 3, sets HW_CF on success
00050Dr 2               
00050Dr 2  20 rr rr       jsr ProbeSerial               ; Sets HW_SC if present
000510r 2  AD 0D 03       lda HW_PRESENT
000513r 2  29 10          and #HW_SC
000515r 2  F0 03          beq @SkipSerial
000517r 2  20 rr rr       jsr InitSCImpl
00051Ar 2               @SkipSerial:
00051Ar 2               
00051Ar 2  20 rr rr       jsr ProbeGPIO                 ; Sets HW_GPIO if present
00051Dr 2  AD 0D 03       lda HW_PRESENT
000520r 2  29 20          and #HW_GPIO
000522r 2  F0 03          beq @SkipGPIO
000524r 2  20 rr rr       jsr InitKBImpl
000527r 2               @SkipGPIO:
000527r 2               
000527r 2  20 rr rr       jsr ProbeSID                  ; Sets HW_SID if present
00052Ar 2  AD 0D 03       lda HW_PRESENT
00052Dr 2  29 40          and #HW_SID
00052Fr 2  F0 03          beq @SkipSID
000531r 2  20 rr rr       jsr InitSIDImpl
000534r 2               @SkipSID:
000534r 2               
000534r 2  9C 93 03       stz VID_MODE                  ; No console set up since KernalInit
000537r 2  9C 92 03       stz VID_TOP
00053Ar 2  20 rr rr       jsr ProbeVideo                ; Sets HW_VID if present
00053Dr 2  2C 0D 03       bit HW_PRESENT
000540r 2  10 19          bpl @SkipVideo
000542r 2                 ; The card as it is after its own reset, so that a warm KernalInit matches a
000542r 2                 ; power-on: the legacy submode, unscrolled, port A reading STAT0 (the probe
000542r 2                 ; restored that).  No InitVideo — the console comes up on first use
000542r 2                 ; (VideoConsoleReady), and a cartridge that drives the card itself finds it
000542r 2                 ; where a 1.x ROM left a TMS9918.
000542r 2  A2 0D          ldx #VDP_VMODE
000544r 2  20 rr rr       jsr @ZeroReg
000547r 2  A2 13          ldx #VDP_L0SCRX
000549r 2  20 rr rr       jsr @ZeroReg
00054Cr 2  A2 14          ldx #VDP_L0SCRY
00054Er 2  20 rr rr       jsr @ZeroReg
000551r 2  A9 3C          lda #$3C                      ; LxCTRL as the card resets them (SPEC §5), for
000553r 2  8D 96 03       sta VDP_L0CTRL_SHADOW         ;   VdpSetScroll and VdpLayer before anything
000556r 2  A9 0C          lda #$0C                      ;   has written them
000558r 2  8D 97 03       sta VDP_L1CTRL_SHADOW
00055Br 2               @SkipVideo:
00055Br 2               
00055Br 2                 ; Console auto-detection — determine IO_MODE from available hardware
00055Br 2  AD 0D 03       lda HW_PRESENT
00055Er 2  29 80          and #HW_VID
000560r 2  D0 09          bne @ConsoleVideo             ; Video present — use it
000562r 2  AD 0D 03       lda HW_PRESENT
000565r 2  29 10          and #HW_SC
000567r 2  D0 15          bne @ConsoleSerial            ; Serial present — use it
000569r 2                 ; Neither video nor serial — IO_MODE left as-is (no console)
000569r 2  80 18          bra @ConsoleDone
00056Br 2               
00056Br 2               @ConsoleVideo:
00056Br 2  A9 00          lda #$00                      ; IO_MODE = video
00056Dr 2  8D 06 03       sta IO_MODE
000570r 2  9C 07 03       stz VID_CURSOR_X
000573r 2  9C 08 03       stz VID_CURSOR_Y
000576r 2  9C 09 03       stz VID_CURSOR_ADDR
000579r 2  9C 0A 03       stz VID_CURSOR_ADDR + 1
00057Cr 2  80 05          bra @ConsoleDone
00057Er 2               
00057Er 2               @ConsoleSerial:
00057Er 2  A9 01          lda #$01                      ; IO_MODE = serial
000580r 2  8D 06 03       sta IO_MODE
000583r 2               
000583r 2               @ConsoleDone:
000583r 2  60             rts
000584r 2               @ZeroReg:                       ; X = register
000584r 2  A9 00          lda #$00
000586r 2  4C rr rr       jmp VdpSetReg
000589r 2               
000589r 2               ; KernalVersion — Return BIOS version in registers
000589r 2               ; Output: A = major version, X = minor version
000589r 2               ; Modifies: A, X
000589r 2               KernalVersionImpl:
000589r 2  A9 02          lda #BIOS_VERSION_MAJOR
00058Br 2  A2 00          ldx #BIOS_VERSION_MINOR
00058Dr 2  60             rts
00058Er 2               
00058Er 2               ; ProgramEnd — Determine where the program image at PROGRAM_START ends.
00058Er 2               ; A program image is a tokenized BASIC line chain, optionally followed by machine
00058Er 2               ; code (a ".prg").  Only a byte count can find the end of the machine code; a
00058Er 2               ; chain walk stops at the $0000 end marker.  So prefer a count recorded by a
00058Er 2               ; loader running outside BASIC, and fall back to the walk when there is none.
00058Er 2               ; Input: none (reads PRG_IMAGE_END, set by a loader that places a .prg at $0800)
00058Er 2               ; Output: A = end lo, Y = end hi — the address BASIC should use for VARTAB
00058Er 2               ; Modifies: Flags, A, X, Y, PE_PTR, PE_NEXT, PRG_IMAGE_END (consumed)
00058Er 2               ; Note: writes the $00 $00 end marker at PROGRAM_START in the empty case.
00058Er 2               ; Not in the jump table — BASIC calls this label directly, as it does ReqHw.
00058Er 2               ProgramEnd:
00058Er 2                 ; --- 1. A loader recorded a byte count: trust it if it is in range ---
00058Er 2  AD 8E 03       lda PRG_IMAGE_END
000591r 2  AE 8F 03       ldx PRG_IMAGE_END + 1
000594r 2  9C 8E 03       stz PRG_IMAGE_END             ; Consume it either way, so a stale value cannot
000597r 2  9C 8F 03       stz PRG_IMAGE_END + 1         ;   be acted on twice
00059Ar 2  E0 08          cpx #>PROGRAM_START           ; Must be >= PROGRAM_START + 2 (0 fails here too)
00059Cr 2  90 13          bcc @PeWalk
00059Er 2  D0 04          bne @PeHiOk
0005A0r 2  C9 02          cmp #<(PROGRAM_START + 2)
0005A2r 2  90 0D          bcc @PeWalk
0005A4r 2               @PeHiOk:
0005A4r 2  E0 80          cpx #>MEMORY_TOP              ; ...and must not run past the top of RAM
0005A6r 2  90 06          bcc @PeUse
0005A8r 2  D0 07          bne @PeWalk
0005AAr 2  C9 00          cmp #<MEMORY_TOP
0005ACr 2  D0 03          bne @PeWalk
0005AEr 2               @PeUse:
0005AEr 2  DA             phx                           ; Y = hi; A still holds lo
0005AFr 2  7A             ply
0005B0r 2  60             rts
0005B1r 2               
0005B1r 2                 ; --- 2. No count: walk the line chain to the $0000 end marker ---
0005B1r 2               @PeWalk:
0005B1r 2  AD 01 08       lda PROGRAM_START + 1         ; High byte of the first next-pointer: a real
0005B4r 2  C9 08          cmp #>PROGRAM_START           ;   program's lines all live in [$0800, $8000)
0005B6r 2  90 3E          bcc @PeEmpty
0005B8r 2  C9 80          cmp #>MEMORY_TOP
0005BAr 2  B0 3A          bcs @PeEmpty
0005BCr 2  A9 00          lda #<PROGRAM_START
0005BEr 2  85 24          sta PE_PTR
0005C0r 2  A9 08          lda #>PROGRAM_START
0005C2r 2  85 25          sta PE_PTR + 1
0005C4r 2               @PeWalkLoop:
0005C4r 2  A0 01          ldy #1
0005C6r 2  B1 24          lda (PE_PTR),y                ; Next-pointer high byte
0005C8r 2  F0 1F          beq @PeWalkDone               ; 0 → end marker reached
0005CAr 2  C9 80          cmp #>MEMORY_TOP              ; Out of range → not a real program
0005CCr 2  B0 28          bcs @PeEmpty
0005CEr 2  85 27          sta PE_NEXT + 1
0005D0r 2  88             dey
0005D1r 2  B1 24          lda (PE_PTR),y                ; Next-pointer low byte
0005D3r 2  85 26          sta PE_NEXT
0005D5r 2                 ; Lines are stored in strictly ascending address order.  If the next-pointer
0005D5r 2                 ; does not advance upward we are walking random power-up RAM, which would
0005D5r 2                 ; otherwise loop forever — bail out and install an empty program.
0005D5r 2  A5 24          lda PE_PTR
0005D7r 2  C5 26          cmp PE_NEXT
0005D9r 2  A5 25          lda PE_PTR + 1
0005DBr 2  E5 27          sbc PE_NEXT + 1
0005DDr 2  B0 17          bcs @PeEmpty                  ; current >= candidate → invalid chain
0005DFr 2  A5 26          lda PE_NEXT                   ; Advance to the next line
0005E1r 2  85 24          sta PE_PTR
0005E3r 2  A5 27          lda PE_NEXT + 1
0005E5r 2  85 25          sta PE_PTR + 1
0005E7r 2  80 DB          bra @PeWalkLoop
0005E9r 2               @PeWalkDone:
0005E9r 2  18             clc                           ; PE_PTR is on the end marker; end = PE_PTR + 2
0005EAr 2  A5 24          lda PE_PTR
0005ECr 2  69 02          adc #2
0005EEr 2  AA             tax
0005EFr 2  A5 25          lda PE_PTR + 1
0005F1r 2  69 00          adc #0
0005F3r 2  A8             tay
0005F4r 2  8A             txa
0005F5r 2  60             rts
0005F6r 2               
0005F6r 2                 ; --- 3. Nothing usable at $0800: install an empty program ---
0005F6r 2               @PeEmpty:
0005F6r 2  9C 00 08       stz PROGRAM_START             ; Write the [00][00] end marker
0005F9r 2  9C 01 08       stz PROGRAM_START + 1
0005FCr 2  A9 02          lda #<(PROGRAM_START + 2)
0005FEr 2  A0 08          ldy #>(PROGRAM_START + 2)
000600r 2  60             rts
000601r 2               
000601r 2               ; Reset — Full system startup: init hardware, beep, check boot vector, start BASIC
000601r 2               Reset:
000601r 2  A2 FF          ldx #$ff
000603r 2  9A             txs                           ; Reset the stack pointer
000604r 2  20 rr rr       jsr KernalInitImpl            ; Initialize all hardware (leaves interrupts disabled)
000607r 2               
000607r 2  20 rr rr       jsr Beep                      ; Play the startup beep (guarded — skips if no SID)
00060Ar 2               
00060Ar 2                 ; Check boot redirect vector — cartridges set this before jumping to Reset
00060Ar 2  AD 5B 03       lda BOOT_VECTOR
00060Dr 2  0D 5C 03       ora BOOT_VECTOR + 1
000610r 2  F0 03          beq @NormalBoot               ; Zero — continue normal boot
000612r 2  6C 5B 03       jmp (BOOT_VECTOR)             ; Non-zero — jump to cartridge/external program
000615r 2               
000615r 2               @NormalBoot:
000615r 2                 ; Verify console is available for interactive boot
000615r 2  AD 0D 03       lda HW_PRESENT
000618r 2  29 90          and #(HW_VID | HW_SC)
00061Ar 2  D0 02          bne @HasConsole
00061Cr 2                 ; Neither video nor serial — halt (no console for interactive boot)
00061Cr 2               @Halt:
00061Cr 2  80 FE          bra @Halt
00061Er 2               
00061Er 2               @HasConsole:
00061Er 2  9C 6F 03       stz BAS_WARM                  ; A reset is a cold BASIC start: the header
000621r 2                                               ;   prints and the variables are cleared, while
000621r 2                                               ;   the program at $0800 is kept (ProgramEnd
000621r 2                                               ;   walks its line chain)
000621r 2  58             cli                           ; Enable interrupts before anything is printed:
000622r 2                                               ;   reading the ACIA's status register clears a
000622r 2                                               ;   pending receive interrupt (6551 datasheet),
000622r 2                                               ;   and the transmit loop reads it on every
000622r 2                                               ;   character — so a key pressed while the
000622r 2                                               ;   header prints would be sitting in the
000622r 2                                               ;   receive register with nothing left to tell
000622r 2                                               ;   the handler about it.  With interrupts on,
000622r 2                                               ;   it is in the input buffer when BASIC asks.
000622r 2  4C rr rr       jmp BasEntry
000625r 2               
000625r 2               ; Initialize the Keyboard via VIA (IO 6)
000625r 2               ; Configures Port B (matrix) and Port A (PS/2) as inputs
000625r 2               ; CB2 low (enable matrix encoder), CA2 low (enable PS/2 encoder)
000625r 2               ; CB1 and CA1 falling-edge IRQs enabled
000625r 2               ; Modifies: Flags, A
000625r 2               InitKBImpl:
000625r 2  A9 00          lda #$00                      ; Port B all inputs (matrix keyboard data bus)
000627r 2  8D 02 94       sta GPIO_DDRB
00062Ar 2  A9 00          lda #$00                      ; Port A all inputs (PS/2 keyboard data bus)
00062Cr 2  8D 03 94       sta GPIO_DDRA
00062Fr 2                 ; PCR: CB2 low + CB1 neg + CA2 low + CA1 neg
00062Fr 2  A9 CC          lda #(GPIO_PCR_CB2_LO | GPIO_PCR_CB1_NEG | GPIO_PCR_CA2_LO | GPIO_PCR_CA1_NEG)
000631r 2  8D 0C 94       sta GPIO_PCR
000634r 2                 ; Enable both CB1 and CA1 interrupts
000634r 2  A9 92          lda #(GPIO_IER_SET | GPIO_INT_CB1 | GPIO_INT_CA1)
000636r 2  8D 0E 94       sta GPIO_IER
000639r 2  60             rts
00063Ar 2               
00063Ar 2               ; Initialize the Serial Card (6551)
00063Ar 2               ; Modifies: Flags, A
00063Ar 2               InitSCImpl:
00063Ar 2  A9 1F          lda     #$1F                  ; 8-N-1, 19200 baud
00063Cr 2  8D 03 90       sta     SC_CTRL
00063Fr 2  A9 09          lda     #$09                  ; No parity, no echo, RTSB low, TX interrupts disabled, RX interrupts enabled
000641r 2  8D 02 90       sta     SC_CMD
000644r 2  60             rts
000645r 2               
000645r 2               ; Initialze the Sound Card (6581)
000645r 2               ; Modifies: Flags, A, X
000645r 2               InitSIDImpl:
000645r 2  A9 00          lda #$00
000647r 2  A2 1D          ldx #$1D                      ; Clear all 29 SID registers
000649r 2               @InitSIDLoop:
000649r 2  9D 00 98       sta SID_V1_FREQ_LO,x          ; Clear register
00064Cr 2  CA             dex
00064Dr 2  10 FA          bpl @InitSIDLoop              ; Loop until all registers cleared
00064Fr 2  A9 0F          lda #$0F                      ; Set volume to maximum
000651r 2  8D 18 98       sta SID_MODE_VOL
000654r 2  60             rts
000655r 2               
000655r 2               ; InitVideo — Put the PICOVDP in the Kernal's Text-mode console
000655r 2               ; Writes the register table below with the display off, reloads the character
000655r 2               ; set into the pattern table at $0800, restores palette row 0, sets the border
000655r 2               ; from VID_PEN and turns the display on.  It does not clear the screen: the
000655r 2               ; name and attribute tables are left as they were and shown unscrolled.  A
000655r 2               ; program that switched modes, moved tables or overwrote the glyphs gets the
000655r 2               ; console back with this one call.
000655r 2               ; Skips silently if no video card is fitted
000655r 2               ; Modifies: Flags, A, X, Y
000655r 2               InitVideoImpl:
000655r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
000658r 2  10 64          bpl @InitVideoNone
00065Ar 2  A2 00          ldx #$00
00065Cr 2               @InitVideoLoop:
00065Cr 2  BD rr rr       lda @InitVideoRegs + 1,x      ; Value
00065Fr 2  8D 01 9C       sta VC_REG
000662r 2  BD rr rr       lda @InitVideoRegs,x          ; Register | $80
000665r 2  8D 01 9C       sta VC_REG
000668r 2  E8             inx
000669r 2  E8             inx
00066Ar 2  E0 22          cpx #(@InitVideoRegsEnd - @InitVideoRegs)
00066Cr 2  D0 EE          bne @InitVideoLoop
00066Er 2  20 rr rr       jsr InitCharacters            ; The font, into L0PAT = $0800
000671r 2                 ; Palette row 0, 16 entries of $0R $GB at $FC00.  $FC00 is in bank 3, and
000671r 2                 ; VBANK is sampled by the address command, so it goes straight back to 0.
000671r 2  A9 03          lda #$03
000673r 2  A2 08          ldx #VDP_VBANK
000675r 2  20 rr rr       jsr VdpSetReg
000678r 2  9C 01 9C       stz VC_REG                    ; $FC00 = bank 3, $3C00
00067Br 2  A9 7C          lda #($40 | $3C)
00067Dr 2  8D 01 9C       sta VC_REG
000680r 2  A9 00          lda #$00
000682r 2  A2 08          ldx #VDP_VBANK
000684r 2  20 rr rr       jsr VdpSetReg
000687r 2  A2 00          ldx #$00
000689r 2               @InitVideoPalette:
000689r 2  BD rr rr       lda @InitVideoPaletteRow0,x
00068Cr 2  8D 00 9C       sta VC_DATA
00068Fr 2  E8             inx
000690r 2  E0 20          cpx #32
000692r 2  D0 F5          bne @InitVideoPalette
000694r 2  AD 91 03       lda VID_PEN                   ; Border = the pen's background
000697r 2  A2 07          ldx #VDP_COLOR
000699r 2  20 rr rr       jsr VdpSetReg
00069Cr 2  A9 40          lda #$40                      ; Display on
00069Er 2  A2 01          ldx #VDP_MODE1
0006A0r 2  20 rr rr       jsr VdpSetReg
0006A3r 2  A9 30          lda #$30
0006A5r 2  8D 96 03       sta VDP_L0CTRL_SHADOW
0006A8r 2  A9 0C          lda #$0C
0006AAr 2  8D 97 03       sta VDP_L1CTRL_SHADOW
0006ADr 2  A9 01          lda #$01
0006AFr 2  8D 93 03       sta VID_MODE                  ; Text console intact
0006B2r 2  9C 92 03       stz VID_TOP
0006B5r 2  AE 07 03       ldx VID_CURSOR_X              ; The cursor keeps its screen position
0006B8r 2  AC 08 03       ldy VID_CURSOR_Y
0006BBr 2  4C rr rr       jmp VideoSetCursorImpl
0006BEr 2               @InitVideoNone:
0006BEr 2  60             rts
0006BFr 2               @InitVideoRegs:                 ; Register | $80, value
0006BFr 2  81 00          .byte $80 | VDP_MODE1,     $00  ; Display off, IRQ off, legacy mode bits clear
0006C1r 2  80 00          .byte $80 | VDP_MODE0,     $00
0006C3r 2  8D 01          .byte $80 | VDP_VMODE,     $01  ; Text, 40x24 of 6x8
0006C5r 2  88 00          .byte $80 | VDP_VBANK,     $00  ; The Kernal assumes both
0006C7r 2  89 01          .byte $80 | VDP_VINC,      $01
0006C9r 2  8A 00          .byte $80 | VDP_IRQEN,     $00
0006CBr 2  8F 00          .byte $80 | VDP_STATSEL_A, $00  ; Port B's STATSEL_B is never touched
0006CDr 2  8C 3F          .byte $80 | VDP_PALBASE,   $3F  ; $FC00
0006CFr 2  90 00          .byte $80 | VDP_L0NAME,    $00  ; Name table $0000
0006D1r 2  91 01          .byte $80 | VDP_L0ATTR,    $01  ; Attributes $0400
0006D3r 2  92 01          .byte $80 | VDP_L0PAT,     $01  ; Patterns $0800
0006D5r 2  93 00          .byte $80 | VDP_L0SCRX,    $00
0006D7r 2  94 00          .byte $80 | VDP_L0SCRY,    $00
0006D9r 2  95 30          .byte $80 | VDP_L0CTRL,    $30  ; 1bpp, per-cell attributes, enabled, index 0 opaque
0006DBr 2  96 00          .byte $80 | VDP_L0PAL,     $00  ; Palette row 0, the TMS9918 colours
0006DDr 2  9D 0C          .byte $80 | VDP_L1CTRL,    $0C  ; Layer 1 off (its reset value)
0006DFr 2  A3 26          .byte $80 | VDP_SPRCTRL,   $26  ; Sprites off
0006E1r 2               @InitVideoRegsEnd:
0006E1r 2               @InitVideoPaletteRow0:          ; SPEC §11 default palette, row 0
0006E1r 2  00 00 00 00    .byte $00,$00, $00,$00, $02,$C4, $06,$D7, $05,$5E, $07,$7F, $0C,$55, $04,$EE
0006E5r 2  02 C4 06 D7  
0006E9r 2  05 5E 07 7F  
0006F1r 2  0F 55 0F 77    .byte $0F,$55, $0F,$77, $0C,$B5, $0D,$C8, $02,$A4, $0C,$5B, $0C,$CC, $0F,$FF
0006F5r 2  0C B5 0D C8  
0006F9r 2  02 A4 0C 5B  
000701r 2               
000701r 2               ; Initialize the character set
000701r 2               ; Copies the 2KB character ROM into the pattern table at VRAM $0800.
000701r 2               ; STR_PTR is used as the source pointer but is saved and restored, so callers
000701r 2               ; may hold a pointer there across the call.
000701r 2               ; Modifies: Flags, A, X, Y
000701r 2               InitCharacters:
000701r 2  A5 02          lda STR_PTR                   ; Preserve caller's STR_PTR
000703r 2  48             pha
000704r 2  A5 03          lda STR_PTR + 1
000706r 2  48             pha
000707r 2                 ; Set VRAM write address to $0800 (pattern table base)
000707r 2  A9 00          lda #$00                      ; Low byte of address
000709r 2  8D 01 9C       sta VC_REG
00070Cr 2  A9 48          lda #$48                      ; High byte ($08) OR $40 for write mode
00070Er 2  8D 01 9C       sta VC_REG
000711r 2                 ; Set up source pointer
000711r 2  A9 rr          lda #<CharacterSet
000713r 2  85 02          sta STR_PTR                   ; Use STR_PTR ($02-$03) for character set pointer
000715r 2  A9 rr          lda #>CharacterSet
000717r 2  85 03          sta STR_PTR + 1
000719r 2                 ; Copy 2048 bytes (8 pages of 256 bytes each)
000719r 2  A2 08          ldx #$08                      ; 8 pages to copy
00071Br 2  A0 00          ldy #$00                      ; Byte counter within page
00071Dr 2               @InitCharPageLoop:
00071Dr 2  B1 02          lda (STR_PTR),y               ; Load from character set
00071Fr 2  8D 00 9C       sta VC_DATA                   ; Write to VRAM
000722r 2  C8             iny
000723r 2  D0 F8          bne @InitCharPageLoop         ; Loop until page complete (256 bytes)
000725r 2  E6 03          inc STR_PTR + 1               ; Move to next page
000727r 2  CA             dex
000728r 2  D0 F3          bne @InitCharPageLoop         ; Loop for all 8 pages
00072Ar 2  68             pla                           ; Restore caller's STR_PTR
00072Br 2  85 03          sta STR_PTR + 1
00072Dr 2  68             pla
00072Er 2  85 02          sta STR_PTR
000730r 2  60             rts
000731r 2               
000731r 2               ; Initialize the INPUT_BUFFER
000731r 2               ; Modifies: Flags, A
000731r 2               InitBuffer:
000731r 2  A9 00          lda #$00
000733r 2  85 00          sta READ_PTR                  ; Init read and write pointers
000735r 2  85 01          sta WRITE_PTR
000737r 2  60             rts
000738r 2               
000738r 2               ; Write a character from the A register to the INPUT_BUFFER
000738r 2               ; Modifies: Flags, X
000738r 2               WriteBufferImpl:
000738r 2  A6 01          ldx WRITE_PTR
00073Ar 2  9D 00 02       sta INPUT_BUFFER,x
00073Dr 2  E6 01          inc WRITE_PTR
00073Fr 2  60             rts
000740r 2               
000740r 2               ; Read a character from the INPUT_BUFFER and store it in A register
000740r 2               ; Modifies: Flags, X, A
000740r 2               ReadBufferImpl:
000740r 2  A6 00          ldx READ_PTR
000742r 2  BD 00 02       lda INPUT_BUFFER,x
000745r 2  E6 00          inc READ_PTR
000747r 2  60             rts
000748r 2               
000748r 2               ; Return in A register the number of unread bytes in the INPUT_BUFFER
000748r 2               ; Modifies: Flags, A
000748r 2               BufferSizeImpl:
000748r 2  A5 01          lda WRITE_PTR
00074Ar 2  38             sec
00074Br 2  E5 00          sbc READ_PTR
00074Dr 2  60             rts
00074Er 2               
00074Er 2               ; Get a character from the INPUT_BUFFER if available
00074Er 2               ; On return, carry flag indicates whether a character was available
00074Er 2               ; If character available the character will be in the A register
00074Er 2               ; Modifies: Flags, A
00074Er 2               ChrinImpl:
00074Er 2  DA             phx
00074Fr 2  20 rr rr       jsr BufferSize                ; Check for character available
000752r 2  F0 2C          beq @ChrinNoChar              ; Branch if no character available
000754r 2  20 rr rr       jsr ReadBuffer                ; Read the character from the buffer
000757r 2  20 rr rr       jsr Chrout                    ; Echo
00075Ar 2  48             pha
00075Br 2  20 rr rr       jsr BufferSize
00075Er 2  C9 B0          cmp #$B0                      ; Check if buffer is mostly full
000760r 2  90 0E          bcc @ChrinNotFull             ; Branch if buffer size < $B0
000762r 2                 ; Only touch SC_CMD if serial is present
000762r 2  AD 0D 03       lda HW_PRESENT
000765r 2  29 10          and #HW_SC
000767r 2  F0 13          beq @ChrinExit
000769r 2  A9 01          lda #$01                      ; No parity, no echo, RTSB high, TX interrupts disabled, RX interrupts enabled
00076Br 2  8D 02 90       sta SC_CMD
00076Er 2  80 0C          bra @ChrinExit
000770r 2               @ChrinNotFull:
000770r 2  AD 0D 03       lda HW_PRESENT
000773r 2  29 10          and #HW_SC
000775r 2  F0 05          beq @ChrinExit
000777r 2  A9 09          lda #$09                      ; No parity, no echo, RTSB low, TX interrupts disabled, RX interrupts enabled
000779r 2  8D 02 90       sta SC_CMD
00077Cr 2               @ChrinExit:
00077Cr 2  68             pla
00077Dr 2  FA             plx
00077Er 2  38             sec
00077Fr 2  60             rts
000780r 2               @ChrinNoChar:
000780r 2  FA             plx
000781r 2  18             clc
000782r 2  60             rts
000783r 2               
000783r 2               ; Output a character from the A register to the Serial Card
000783r 2               ; Modifies: Flags
000783r 2               SerialChroutImpl:
000783r 2  8D 00 90       sta SC_DATA
000786r 2  48             pha
000787r 2  DA             phx                           ; WriteBuffer uses X
000788r 2               @ChroutWait:
000788r 2  AD 01 90       lda SC_STATUS
00078Br 2                 ; Reading the status register clears a pending receive interrupt. A byte that
00078Br 2                 ; arrives while this loop is running therefore loses its interrupt before Irq
00078Br 2                 ; can see it, and since the receive register stays full the ACIA will not hand
00078Br 2                 ; over the next one either — the console stops accepting input for good. So
00078Br 2                 ; the byte is collected here rather than left for a handler that will never
00078Br 2                 ; run. XModem is the exception: it turns the receiver interrupt off and polls
00078Br 2                 ; the chip itself, and those bytes belong to it.
00078Br 2  89 08          bit #SC_STATUS_RDRF           ; Did a byte arrive during the poll?
00078Dr 2  F0 12          beq @ChroutNoRx
00078Fr 2  48             pha                           ; Keep the status just read
000790r 2  AD 02 90       lda SC_CMD
000793r 2  29 02          and #SC_CMD_RXIRQ_OFF
000795r 2  D0 09          bne @ChroutRxDone             ; Receiver is somebody else's — leave it alone
000797r 2  08             php
000798r 2  78             sei                           ; WriteBuffer's pointer bump is not atomic
000799r 2  AD 00 90       lda SC_DATA                   ; Frees the receive register
00079Cr 2  20 rr rr       jsr WriteBuffer
00079Fr 2  28             plp
0007A0r 2               @ChroutRxDone:
0007A0r 2  68             pla                           ; Back to the status
0007A1r 2               @ChroutNoRx:
0007A1r 2  29 10          and #SC_STATUS_TDRE           ; Check if TX buffer not empty
0007A3r 2  F0 E3          beq @ChroutWait               ; Loop if TX buffer not empty
0007A5r 2  FA             plx
0007A6r 2  68             pla
0007A7r 2  60             rts
0007A8r 2               
0007A8r 2               ; SidPlayNote — Play a note on a SID voice
0007A8r 2               ; Input: A = voice (0-2), X = frequency low byte, Y = frequency high byte
0007A8r 2               ; Uses triangle waveform with standard ADSR (Attack=0, Decay=9, Sustain=A, Release=2)
0007A8r 2               ; Skips silently if no SID is fitted
0007A8r 2               ; Modifies: Flags, A
0007A8r 2               SidPlayNoteImpl:
0007A8r 2  2C 0D 03       bit HW_PRESENT                ; SID is bit 6, so BIT tests it in V and leaves
0007ABr 2  50 49          bvc @SidPlayNoteNone          ;   the voice number in A — see VideoClear
0007ADr 2  C9 01          cmp #$01
0007AFr 2  F0 1A          beq @Voice2
0007B1r 2  C9 02          cmp #$02
0007B3r 2  F0 2C          beq @Voice3
0007B5r 2                 ; Voice 0
0007B5r 2  8E 00 98       stx SID_V1_FREQ_LO
0007B8r 2  8C 01 98       sty SID_V1_FREQ_HI
0007BBr 2  A9 09          lda #$09                      ; Attack = 0, Decay = 9
0007BDr 2  8D 05 98       sta SID_V1_AD
0007C0r 2  A9 F8          lda #$F8                      ; Sustain = F, Release = 8
0007C2r 2  8D 06 98       sta SID_V1_SR
0007C5r 2  A9 11          lda #$11                      ; Triangle wave + Gate on
0007C7r 2  8D 04 98       sta SID_V1_CTRL
0007CAr 2  60             rts
0007CBr 2               @Voice2:
0007CBr 2  8E 07 98       stx SID_V2_FREQ_LO
0007CEr 2  8C 08 98       sty SID_V2_FREQ_HI
0007D1r 2  A9 09          lda #$09
0007D3r 2  8D 0C 98       sta SID_V2_AD
0007D6r 2  A9 F8          lda #$F8
0007D8r 2  8D 0D 98       sta SID_V2_SR
0007DBr 2  A9 11          lda #$11
0007DDr 2  8D 0B 98       sta SID_V2_CTRL
0007E0r 2  60             rts
0007E1r 2               @Voice3:
0007E1r 2  8E 0E 98       stx SID_V3_FREQ_LO
0007E4r 2  8C 0F 98       sty SID_V3_FREQ_HI
0007E7r 2  A9 09          lda #$09
0007E9r 2  8D 13 98       sta SID_V3_AD
0007ECr 2  A9 F8          lda #$F8
0007EEr 2  8D 14 98       sta SID_V3_SR
0007F1r 2  A9 11          lda #$11
0007F3r 2  8D 12 98       sta SID_V3_CTRL
0007F6r 2               @SidPlayNoteNone:
0007F6r 2  60             rts
0007F7r 2               
0007F7r 2               ; SidSilence — Silence all 3 SID voices
0007F7r 2               ; Gates off all voices, letting the release phase of the envelope ring out.
0007F7r 2               ;
0007F7r 2               ; The frequency registers are deliberately left alone. Zeroing them stops the
0007F7r 2               ; oscillator dead, which freezes the waveform at whatever level it had reached
0007F7r 2               ; and leaves the envelope to decay a DC offset instead of a tone — an audible
0007F7r 2               ; thump at the end of every note. Gate off is all the SID needs; the envelope
0007F7r 2               ; takes the voice to zero on its own.
0007F7r 2               ; Skips silently if no SID is fitted
0007F7r 2               ; Modifies: Flags, A
0007F7r 2               SidSilenceImpl:
0007F7r 2  2C 0D 03       bit HW_PRESENT                ; SID is bit 6 — see VideoClear
0007FAr 2  50 0B          bvc @SidSilenceNone
0007FCr 2  A9 10          lda #$10                      ; Triangle wave, Gate off
0007FEr 2  8D 04 98       sta SID_V1_CTRL
000801r 2  8D 0B 98       sta SID_V2_CTRL
000804r 2  8D 12 98       sta SID_V3_CTRL
000807r 2               @SidSilenceNone:
000807r 2  60             rts
000808r 2               
000808r 2               ; Play a short beep sound
000808r 2               ; Uses SidPlayNote on voice 0 with ~475 Hz tone, then silences
000808r 2               ; Skips silently if SID is absent
000808r 2               ; Modifies: Flags, A, X, Y
000808r 2               BeepImpl:
000808r 2  AD 0D 03       lda HW_PRESENT
00080Br 2  29 40          and #HW_SID
00080Dr 2  D0 01          bne @BeepStart
00080Fr 2  60             rts                           ; No SID — skip silently
000810r 2               @BeepStart:
000810r 2  A9 00          lda #$00                      ; Voice 0
000812r 2  A2 20          ldx #$20                      ; Frequency low byte (~475 Hz)
000814r 2  A0 1F          ldy #$1F                      ; Frequency high byte
000816r 2  20 rr rr       jsr SidPlayNote
000819r 2                 ; Override ADSR for beep: fast decay, no sustain
000819r 2  A9 09          lda #$09                      ; Attack = 0, Decay = 9
00081Br 2  8D 05 98       sta SID_V1_AD
00081Er 2  A9 00          lda #$00                      ; Sustain = 0, Release = 0
000820r 2  8D 06 98       sta SID_V1_SR
000823r 2                 ; Delay for beep duration
000823r 2  A2 F0          ldx #$F0                      ; Outer loop counter
000825r 2               @BeepDelay1:
000825r 2  A0 FF          ldy #$FF                      ; Inner loop counter
000827r 2               @BeepDelay2:
000827r 2  88             dey
000828r 2  D0 FD          bne @BeepDelay2
00082Ar 2  CA             dex
00082Br 2  D0 F8          bne @BeepDelay1
00082Dr 2  20 rr rr       jsr SidSilence                ; Gate off all voices
000830r 2  60             rts
000831r 2               
000831r 2               ; SysDelay — Delay for a specified number of centiseconds
000831r 2               ; Input: A = count low byte, X = count high byte
000831r 2               ; Uses VIA T1 in one-shot mode. 9999 cycles @ 1MHz = ~10ms per tick.
000831r 2               ; Modifies: Flags, A, X, Y (X/Y clobbered only in software-fallback path)
000831r 2               SysDelayImpl:
000831r 2  85 2C          sta DELAY_CNT
000833r 2  86 2D          stx DELAY_CNT + 1
000835r 2                 ; Return immediately if count is zero
000835r 2  05 2D          ora DELAY_CNT + 1
000837r 2  F0 4F          beq @DelayDone
000839r 2                 ; Check if VIA is present for hardware timer
000839r 2  AD 0D 03       lda HW_PRESENT
00083Cr 2  29 20          and #HW_GPIO
00083Er 2  D0 19          bne @DelayHardware
000840r 2                 ; Software fallback — calibrated busy loop (~10ms per centisecond at 1MHz)
000840r 2                 ; Inner loop: 5 cycles × 256 iterations × 8 = ~10240 cycles ≈ 10ms
000840r 2               @DelaySoftLoop:
000840r 2  A0 00          ldy #$00                      ; 256 outer iterations
000842r 2  A2 08          ldx #8
000844r 2               @DelaySoftInner:
000844r 2  88             dey
000845r 2  D0 FD          bne @DelaySoftInner
000847r 2  CA             dex
000848r 2  D0 FA          bne @DelaySoftInner
00084Ar 2                 ; 16-bit decrement of DELAY_CNT
00084Ar 2  A5 2C          lda DELAY_CNT
00084Cr 2  D0 02          bne @SoftDecLo
00084Er 2  C6 2D          dec DELAY_CNT + 1
000850r 2               @SoftDecLo:
000850r 2  C6 2C          dec DELAY_CNT
000852r 2  A5 2C          lda DELAY_CNT
000854r 2  05 2D          ora DELAY_CNT + 1
000856r 2  D0 E8          bne @DelaySoftLoop
000858r 2  60             rts
000859r 2               @DelayHardware:
000859r 2                 ; Configure T1 one-shot mode: clear ACR bit 6
000859r 2  AD 0B 94       lda GPIO_ACR
00085Cr 2  29 BF          and #%10111111
00085Er 2  8D 0B 94       sta GPIO_ACR
000861r 2               @DelayLoop:
000861r 2                 ; Load T1 latch: 9999 = $270F
000861r 2  A9 0F          lda #$0F
000863r 2  8D 06 94       sta GPIO_T1LL
000866r 2  A9 27          lda #$27
000868r 2  8D 07 94       sta GPIO_T1LH
00086Br 2                 ; Write T1CH to start countdown (also clears IFR T1 flag)
00086Br 2  A9 27          lda #$27
00086Dr 2  8D 05 94       sta GPIO_T1CH
000870r 2               @DelayPoll:
000870r 2  AD 0D 94       lda GPIO_IFR
000873r 2  29 40          and #%01000000                ; T1 timeout flag
000875r 2  F0 F9          beq @DelayPoll
000877r 2                 ; Clear flag by reading T1CL
000877r 2  AD 04 94       lda GPIO_T1CL
00087Ar 2                 ; 16-bit decrement
00087Ar 2  A5 2C          lda DELAY_CNT
00087Cr 2  D0 02          bne @DelayDecLo
00087Er 2  C6 2D          dec DELAY_CNT + 1
000880r 2               @DelayDecLo:
000880r 2  C6 2C          dec DELAY_CNT
000882r 2                 ; Loop until both bytes zero
000882r 2  A5 2C          lda DELAY_CNT
000884r 2  05 2D          ora DELAY_CNT + 1
000886r 2  D0 D9          bne @DelayLoop
000888r 2               @DelayDone:
000888r 2  60             rts
000889r 2               
000889r 2               ; SidSetVolume — Set SID master volume
000889r 2               ; Input: A = volume (0-15); upper nibble of SID_MODE_VOL is cleared (no filter)
000889r 2               ; Skips silently if no SID is fitted
000889r 2               ; Modifies: Flags, A
000889r 2               SidSetVolumeImpl:
000889r 2  2C 0D 03       bit HW_PRESENT                ; SID is bit 6 — see VideoClear
00088Cr 2  50 05          bvc @SidSetVolumeNone
00088Er 2  29 0F          and #$0F
000890r 2  8D 18 98       sta SID_MODE_VOL
000893r 2               @SidSetVolumeNone:
000893r 2  60             rts
000894r 2               
000894r 2               ; VideoSetColor — Set the pen for later output, and the border
000894r 2               ; Input: A = fg<<4 | bg.  VID_PEN = A, and register 7 = A, so the border follows
000894r 2               ; the background.  Characters already on screen keep their colours.
000894r 2               ; Skips silently if no video card is fitted
000894r 2               ; Modifies: Flags, A
000894r 2               VideoSetColorImpl:
000894r 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
000897r 2  10 0E          bpl @VideoSetColorNone
000899r 2  20 rr rr       jsr VideoConsoleReady
00089Cr 2  8D 91 03       sta VID_PEN
00089Fr 2  8D 01 9C       sta VC_REG                    ; Data byte
0008A2r 2  A9 87          lda #($80 | VDP_COLOR)
0008A4r 2  8D 01 9C       sta VC_REG
0008A7r 2               @VideoSetColorNone:
0008A7r 2  60             rts
0008A8r 2               
0008A8r 2               ; Encoder settle count for KBDisableImpl. Each loop iteration is 5 cycles, so
0008A8r 2               ; the busy-wait is ~KB_SETTLE_COUNT*5 cycles. Sized against the 2 MHz clock
0008A8r 2               ; option (the worst case): 80 => ~400 cycles => ~200 us @ 2 MHz (~400 us @ 1 MHz),
0008A8r 2               ; comfortably above the firmware's guaranteed 100 us release ceiling.
0008A8r 2               KB_SETTLE_COUNT = 80
0008A8r 2               
0008A8r 2               ; KBDisable — Disable both keyboard encoders and wait for them to release the ports
0008A8r 2               ; Sets CB2/CA2 high, then busy-waits so the encoder firmware has time to let go of
0008A8r 2               ; both ports before the caller reads them. Self-contained cycle loop — deliberately
0008A8r 2               ; not SysDelay or the VIA T1 path, so it is safe to call while the caller owns the timers.
0008A8r 2               ; Modifies: Flags, A
0008A8r 2               KBDisableImpl:
0008A8r 2  A9 EE          lda #(GPIO_PCR_CB2_HI | GPIO_PCR_CB1_NEG | GPIO_PCR_CA2_HI | GPIO_PCR_CA1_NEG)
0008AAr 2  8D 0C 94       sta GPIO_PCR                  ; Tell both encoders to release the ports
0008ADr 2  8A             txa
0008AEr 2  48             pha                           ; Preserve X so the contract stays "Modifies: Flags, A"
0008AFr 2  A2 50          ldx #KB_SETTLE_COUNT
0008B1r 2               @KBSettle:
0008B1r 2  CA             dex
0008B2r 2  D0 FD          bne @KBSettle                 ; Give the encoders time to go high-impedance
0008B4r 2  68             pla
0008B5r 2  AA             tax
0008B6r 2  60             rts
0008B7r 2               
0008B7r 2               ; KBEnable — Re-enable both keyboard encoders
0008B7r 2               ; Sets CB2 low (enable matrix encoder) and CA2 low (enable PS/2 encoder)
0008B7r 2               ; Modifies: Flags, A
0008B7r 2               KBEnableImpl:
0008B7r 2  A9 CC          lda #(GPIO_PCR_CB2_LO | GPIO_PCR_CB1_NEG | GPIO_PCR_CA2_LO | GPIO_PCR_CA1_NEG)
0008B9r 2  8D 0C 94       sta GPIO_PCR
0008BCr 2  60             rts
0008BDr 2               
0008BDr 2               ; ReadJoystick1 — Read joystick 1 on Port B
0008BDr 2               ; Disables both encoders, waits for release, then reads the raw port directly —
0008BDr 2               ; the same way a C64 reads a CIA port. No sei/PCR save-restore is needed: the port
0008BDr 2               ; is static while the encoders are off and no interrupt handler touches these ports.
0008BDr 2               ; Output: A = joystick bitmask (active-low bits: R-L-D-U-Y-X-B-A)
0008BDr 2               ; Modifies: Flags, A
0008BDr 2               ReadJoystick1Impl:
0008BDr 2  20 rr rr       jsr KBDisableImpl             ; Encoders off, ports released, settled
0008C0r 2  AD 00 94       lda GPIO_PORTB                ; JOY(1) - raw Port B
0008C3r 2  48             pha
0008C4r 2  20 rr rr       jsr KBEnableImpl
0008C7r 2  68             pla
0008C8r 2  60             rts
0008C9r 2               
0008C9r 2               ; ReadJoystick2 — Read joystick 2 on Port A
0008C9r 2               ; Output: A = joystick bitmask (active-low bits: R-L-D-U-Y-X-B-A)
0008C9r 2               ; Modifies: Flags, A
0008C9r 2               ReadJoystick2Impl:
0008C9r 2  20 rr rr       jsr KBDisableImpl             ; Encoders off, ports released, settled
0008CCr 2  AD 01 94       lda GPIO_PORTA                ; JOY(2) - raw Port A
0008CFr 2  48             pha
0008D0r 2  20 rr rr       jsr KBEnableImpl
0008D3r 2  68             pla
0008D4r 2  60             rts
0008D5r 2               
0008D5r 2               ; === BCD Conversion Helpers ===
0008D5r 2               
0008D5r 2               ; BcdToBin — Convert BCD byte to binary
0008D5r 2               ; Input: A = BCD value (e.g. $35 represents 35)
0008D5r 2               ; Output: A = binary value (e.g. 35 = $23)
0008D5r 2               ; Modifies: Flags
0008D5r 2               BcdToBin:
0008D5r 2  48             pha
0008D6r 2  4A             lsr a                         ; Shift tens digit to low nibble
0008D7r 2  4A             lsr a
0008D8r 2  4A             lsr a
0008D9r 2  4A             lsr a                         ; A = tens digit (0-9)
0008DAr 2  0A             asl a                         ; A = tens * 2
0008DBr 2  8D 0C 03       sta RTC_TMP
0008DEr 2  0A             asl a                         ; A = tens * 4
0008DFr 2  0A             asl a                         ; A = tens * 8
0008E0r 2  18             clc
0008E1r 2  6D 0C 03       adc RTC_TMP                   ; A = tens * 10 (8 + 2)
0008E4r 2  8D 0C 03       sta RTC_TMP
0008E7r 2  68             pla
0008E8r 2  29 0F          and #$0F                      ; A = ones digit
0008EAr 2  18             clc
0008EBr 2  6D 0C 03       adc RTC_TMP                   ; A = tens * 10 + ones = binary
0008EEr 2  60             rts
0008EFr 2               
0008EFr 2               ; BinToBcd — Convert binary byte to BCD
0008EFr 2               ; Input: A = binary value (0-99)
0008EFr 2               ; Output: A = BCD value
0008EFr 2               ; Modifies: Flags, X
0008EFr 2               BinToBcd:
0008EFr 2  A2 FF          ldx #$FF                      ; Tens counter (starts at -1)
0008F1r 2               @BinToBcdLoop:
0008F1r 2  E8             inx
0008F2r 2  38             sec
0008F3r 2  E9 0A          sbc #10
0008F5r 2  B0 FA          bcs @BinToBcdLoop             ; Count tens
0008F7r 2  69 0A          adc #10                       ; Restore ones (carry clear, so adds 10 + 0)
0008F9r 2  8D 0C 03       sta RTC_TMP                   ; Save ones digit
0008FCr 2  8A             txa                           ; A = tens digit
0008FDr 2  0A             asl a
0008FEr 2  0A             asl a
0008FFr 2  0A             asl a
000900r 2  0A             asl a                         ; Shift tens to high nibble
000901r 2  0D 0C 03       ora RTC_TMP                   ; Combine with ones
000904r 2  60             rts
000905r 2               
000905r 2               ; === DS1511Y RTC Routines ===
000905r 2               
000905r 2               ; The clock registers at $8800-$8807 are double buffered.  A set of internal
000905r 2               ; counters does the actual timekeeping; what the CPU reads and writes is a
000905r 2               ; user-facing copy, and the TE bit in Control Register B decides how the two
000905r 2               ; are joined:
000905r 2               ;
000905r 2               ;   TE = 1  the counters are copied into the user registers once a second —
000905r 2               ;           the normal running state, and what makes a read see time advance
000905r 2               ;   TE = 0  that copy is inhibited, so the user registers hold one consistent
000905r 2               ;           instant.  Returning TE to 1 transfers the user registers back into
000905r 2               ;           the counters, which is how a write takes effect
000905r 2               ;
000905r 2               ; So a write brackets itself with RtcFreeze / RtcThaw, keeping the per-second
000905r 2               ; update from landing in the middle of the bytes being set and then committing
000905r 2               ; the lot.  Leaving TE set afterwards is not housekeeping, it is the whole
000905r 2               ; point: TE is battery-backed and no internal function of the part ever changes
000905r 2               ; it, so a TE left at 0 freezes the CPU's view of the clock indefinitely — the
000905r 2               ; counters go on counting, but every read returns the same instant, across
000905r 2               ; resets and power cycles alike, until something sets TE again.
000905r 2               ;
000905r 2               ; A read has a rollover to worry about — read the hour at 23:59:59 and the
000905r 2               ; minute a moment later and the answer is 23:00, an hour that never happened —
000905r 2               ; but it deliberately does not use TE for it.  Freezing would work, and is what
000905r 2               ; the part is for, except that the thaw both commits the user registers back
000905r 2               ; into the counters and restarts the second from zero; a program polling the
000905r 2               ; time in a loop would thereby hold the clock still.  Reading the seconds on
000905r 2               ; either side of the other registers and retrying if they differ costs nothing
000905r 2               ; and writes nothing.
000905r 2               
000905r 2               ; RtcFreeze — Clear TE, holding the user registers at one instant
000905r 2               ; Modifies: Flags, A
000905r 2               RtcFreeze:
000905r 2  AD 0F 88       lda RTC_CTRL_B
000908r 2  29 7F          and #<~RTC_CTRL_B_TE
00090Ar 2  8D 0F 88       sta RTC_CTRL_B
00090Dr 2  60             rts
00090Er 2               
00090Er 2               ; RtcThaw — Set TE, committing the user registers and resuming the updates
00090Er 2               ; Modifies: Flags, A
00090Er 2               RtcThaw:
00090Er 2  AD 0F 88       lda RTC_CTRL_B
000911r 2  09 80          ora #RTC_CTRL_B_TE
000913r 2  8D 0F 88       sta RTC_CTRL_B
000916r 2  60             rts
000917r 2               
000917r 2               ; RtcReadTime — Read current time from DS1511Y
000917r 2               ; Output: A = hours (binary), X = minutes (binary), Y = seconds (binary)
000917r 2               ; Modifies: Flags
000917r 2               RtcReadTimeImpl:
000917r 2  A0 02          ldy #2                        ; Attempts.  One retry is all a working clock
000919r 2               @Retry:                         ;   can need — a rollover cannot happen twice
000919r 2  AD 00 88       lda RTC_SEC                   ;   in the same second — and the count is what
00091Cr 2  8D 0C 03       sta RTC_TMP                   ;   keeps a floating bus, on a machine with no
00091Fr 2  AD 02 88       lda RTC_HR                    ;   card, from spinning here forever
000922r 2  48             pha                           ; Stacked raw: the seconds have to be compared
000923r 2  AD 01 88       lda RTC_MIN                   ;   before BcdToBin, which wants RTC_TMP itself
000926r 2  48             pha
000927r 2  AD 00 88       lda RTC_SEC                   ; Seconds after; unchanged means no rollover
00092Ar 2  CD 0C 03       cmp RTC_TMP                   ;   happened between the two reads above
00092Dr 2  F0 07          beq @Stable
00092Fr 2  88             dey
000930r 2  F0 04          beq @Stable                   ; Out of attempts: take what is there
000932r 2  68             pla                           ; Torn — drop the pair and read again
000933r 2  68             pla
000934r 2  80 E3          bra @Retry
000936r 2               @Stable:
000936r 2  20 rr rr       jsr BcdToBin                  ; A still holds the seconds
000939r 2  A8             tay                           ; Y = seconds
00093Ar 2  68             pla
00093Br 2  20 rr rr       jsr BcdToBin
00093Er 2  AA             tax                           ; X = minutes
00093Fr 2  68             pla
000940r 2  20 rr rr       jsr BcdToBin                  ; A = hours
000943r 2  60             rts
000944r 2               
000944r 2               ; RtcReadDate — Read current date from DS1511Y
000944r 2               ; Output: A = day of month (binary), X = month (binary), Y = year (binary)
000944r 2               ;         RTC_BUF_CENT = century (binary)
000944r 2               ; Modifies: Flags
000944r 2               RtcReadDateImpl:
000944r 2  A0 02          ldy #2                        ; Attempts, bounded as in RtcReadTime
000946r 2               @Retry:
000946r 2  AD 00 88       lda RTC_SEC                   ; The date rolls over on a second like anything
000949r 2  8D 0C 03       sta RTC_TMP                   ;   else, so it is guarded the same way
00094Cr 2  AD 04 88       lda RTC_DATE                  ; Pushed in reverse of the order they are
00094Fr 2  48             pha                           ;   wanted, so the day of month comes off last
000950r 2  AD 06 88       lda RTC_YR                    ;   and is already in A to return
000953r 2  48             pha
000954r 2  AD 05 88       lda RTC_MON
000957r 2  48             pha
000958r 2  AD 07 88       lda RTC_CENT
00095Br 2  48             pha
00095Cr 2  AD 00 88       lda RTC_SEC
00095Fr 2  CD 0C 03       cmp RTC_TMP
000962r 2  F0 09          beq @Stable
000964r 2  88             dey
000965r 2  F0 06          beq @Stable                   ; Out of attempts: take what is there
000967r 2  68             pla                           ; Torn — drop the four and read again
000968r 2  68             pla
000969r 2  68             pla
00096Ar 2  68             pla
00096Br 2  80 D9          bra @Retry
00096Dr 2               @Stable:
00096Dr 2  68             pla
00096Er 2  20 rr rr       jsr BcdToBin
000971r 2  8D 0B 03       sta RTC_BUF_CENT              ; Store century in buffer
000974r 2  68             pla
000975r 2  29 1F          and #RTC_MON_MASK             ; Strip control bits (EOSC/E32K/BB32) before BCD decode
000977r 2  20 rr rr       jsr BcdToBin
00097Ar 2  AA             tax                           ; X = month
00097Br 2  68             pla
00097Cr 2  20 rr rr       jsr BcdToBin
00097Fr 2  A8             tay                           ; Y = year
000980r 2  68             pla
000981r 2  20 rr rr       jsr BcdToBin                  ; A = day of month
000984r 2  60             rts
000985r 2               
000985r 2               ; RtcWriteTime — Set DS1511Y time
000985r 2               ; Input: A = hours (binary), X = minutes (binary), Y = seconds (binary)
000985r 2               ; Modifies: Flags, A, X
000985r 2               RtcWriteTimeImpl:
000985r 2  48             pha                           ; Save hours
000986r 2  DA             phx                           ; Save minutes
000987r 2  5A             phy                           ; Save seconds
000988r 2  20 rr rr       jsr RtcFreeze                 ; Hold off the once-a-second update
00098Br 2                 ; Write seconds
00098Br 2  68             pla                           ; A = seconds
00098Cr 2  20 rr rr       jsr BinToBcd
00098Fr 2  8D 00 88       sta RTC_SEC
000992r 2                 ; Write minutes
000992r 2  68             pla                           ; A = minutes
000993r 2  20 rr rr       jsr BinToBcd
000996r 2  8D 01 88       sta RTC_MIN
000999r 2                 ; Write hours
000999r 2  68             pla                           ; A = hours
00099Ar 2  20 rr rr       jsr BinToBcd
00099Dr 2  8D 02 88       sta RTC_HR
0009A0r 2  4C rr rr       jmp RtcThaw                   ; Commit the write and resume the updates
0009A3r 2               
0009A3r 2               ; RtcWriteDate — Set DS1511Y date
0009A3r 2               ; Input: A = day of month (binary), X = month (binary), Y = year (binary)
0009A3r 2               ;        RTC_BUF_CENT = century (binary)
0009A3r 2               ; Modifies: Flags, A, X
0009A3r 2               RtcWriteDateImpl:
0009A3r 2  48             pha                           ; Save day
0009A4r 2  DA             phx                           ; Save month
0009A5r 2  5A             phy                           ; Save year
0009A6r 2  20 rr rr       jsr RtcFreeze                 ; Hold off the once-a-second update
0009A9r 2                 ; Write century
0009A9r 2  AD 0B 03       lda RTC_BUF_CENT
0009ACr 2  20 rr rr       jsr BinToBcd
0009AFr 2  8D 07 88       sta RTC_CENT
0009B2r 2                 ; Write year
0009B2r 2  68             pla                           ; A = year
0009B3r 2  20 rr rr       jsr BinToBcd
0009B6r 2  8D 06 88       sta RTC_YR
0009B9r 2                 ; Write month
0009B9r 2  68             pla                           ; A = month
0009BAr 2  20 rr rr       jsr BinToBcd
0009BDr 2  29 1F          and #RTC_MON_MASK             ; Keep only the month value bits
0009BFr 2  8D 0C 03       sta RTC_TMP
0009C2r 2  AD 05 88       lda RTC_MON
0009C5r 2  29 E0          and #<~RTC_MON_MASK           ; Preserve control bits (EOSC/E32K/BB32)
0009C7r 2  0D 0C 03       ora RTC_TMP
0009CAr 2  8D 05 88       sta RTC_MON
0009CDr 2                 ; Write day
0009CDr 2  68             pla                           ; A = day
0009CEr 2  20 rr rr       jsr BinToBcd
0009D1r 2  8D 04 88       sta RTC_DATE
0009D4r 2  4C rr rr       jmp RtcThaw                   ; Commit the write and resume the updates
0009D7r 2               
0009D7r 2               ; RtcReadNVRAM — Read a byte from DS1511Y NVRAM
0009D7r 2               ; Input: X = NVRAM address ($00-$FF)
0009D7r 2               ; Output: A = data byte
0009D7r 2               ; Modifies: Flags
0009D7r 2               RtcReadNVRAMImpl:
0009D7r 2  8E 10 88       stx RTC_RAM_ADDR
0009DAr 2  AD 13 88       lda RTC_RAM_DATA
0009DDr 2  60             rts
0009DEr 2               
0009DEr 2               ; RtcWriteNVRAM — Write a byte to DS1511Y NVRAM
0009DEr 2               ; Input: X = NVRAM address ($00-$FF), A = data byte
0009DEr 2               ; Modifies: Flags
0009DEr 2               RtcWriteNVRAMImpl:
0009DEr 2  8E 10 88       stx RTC_RAM_ADDR
0009E1r 2  8D 13 88       sta RTC_RAM_DATA
0009E4r 2  60             rts
0009E5r 2               
0009E5r 2               ; === NVRAM Save Slots ===
0009E5r 2               ;
0009E5r 2               ; The 256 NVRAM bytes are 16 slots of 16 bytes; slot n starts at NVRAM n*16:
0009E5r 2               ;
0009E5r 2               ;   +$0      owner ID     $00 = free, otherwise a game-chosen identity byte
0009E5r 2               ;   +$1      checksum     over the owner ID and the 14 payload bytes
0009E5r 2               ;   +$2-$F   payload
0009E5r 2               ;
0009E5r 2               ; Checksum: ck = NV_CK_SEED, then ck = rol8(ck) EOR b for each covered byte.
0009E5r 2               ; The 8-bit rotate is asl / adc #0, which is why these routines clear D.
0009E5r 2               ;
0009E5r 2               ; Contract shared by all six:
0009E5r 2               ;   * Carry set means the call did nothing: no RTC card, slot >= NV_SLOTS, and
0009E5r 2               ;     the per-routine cases documented on each.
0009E5r 2               ;   * The caller's D and I flags come back unchanged.  Interrupts are masked for
0009E5r 2               ;     the duration, because the slot copies use burst mode, where every access
0009E5r 2               ;     of RTC_RAM_DATA advances the address latch — an IRQ handler touching NVRAM
0009E5r 2               ;     mid-copy would corrupt the save.  A user NMI handler must not touch NVRAM.
0009E5r 2               ;   * BME is clear on exit, so RtcReadNVRAM / RtcWriteNVRAM keep their
0009E5r 2               ;     single-byte behaviour.
0009E5r 2               ;   * While BME is set, RTC_RAM_DATA is only ever touched with plain absolute
0009E5r 2               ;     addressing: one instruction, one bus access, one step of the latch.
0009E5r 2               
0009E5r 2               ; NvStat — Report a slot's state
0009E5r 2               ; Input: X = slot (0-15)
0009E5r 2               ; Output: A = NV_EMPTY / NV_VALID / NV_BAD, Y = owner ID, C clear
0009E5r 2               ;         C set on no RTC or bad slot (A, Y undefined)
0009E5r 2               ; Modifies: Flags (D and I preserved), A, Y
0009E5r 2               NvStatImpl:
0009E5r 2  08             php
0009E6r 2  78             sei
0009E7r 2  D8             cld
0009E8r 2  20 rr rr       jsr NvCheck
0009EBr 2  B0 3B          bcs NvFail
0009EDr 2  20 rr rr       jsr NvScan
0009F0r 2  4C rr rr       jmp NvOk
0009F3r 2               
0009F3r 2               ; NvRead — Copy a valid slot's 14 payload bytes to the caller's buffer
0009F3r 2               ; Input: X = slot (0-15), A/Y = destination lo/hi
0009F3r 2               ; Output: A = status, Y = owner ID; C clear and the buffer written only if A = NV_VALID
0009F3r 2               ;         C set on no RTC or bad slot (A, Y undefined), or a slot that is not
0009F3r 2               ;         valid (A = its status, Y = its owner ID) — the buffer is untouched
0009F3r 2               ; Modifies: Flags (D and I preserved), A, Y, NV_PTR
0009F3r 2               NvReadImpl:
0009F3r 2  08             php
0009F4r 2  78             sei
0009F5r 2  D8             cld
0009F6r 2  85 02          sta NV_PTR
0009F8r 2  84 03          sty NV_PTR+1
0009FAr 2  20 rr rr       jsr NvCheck
0009FDr 2  B0 29          bcs NvFail
0009FFr 2  20 rr rr       jsr NvScan
000A02r 2  C9 01          cmp #NV_VALID
000A04r 2  D0 22          bne NvFail                    ; Nothing copied until the slot has validated
000A06r 2  5A             phy                           ; Owner ID
000A07r 2  20 rr rr       jsr NvBurstStart
000A0Ar 2  AD 13 88       lda RTC_RAM_DATA              ; Step past the owner ID...
000A0Dr 2  AD 13 88       lda RTC_RAM_DATA              ;   ...and the checksum
000A10r 2  A0 00          ldy #0
000A12r 2               @Copy:
000A12r 2  AD 13 88       lda RTC_RAM_DATA
000A15r 2  91 02          sta (NV_PTR),y
000A17r 2  C8             iny
000A18r 2  C0 0E          cpy #NV_SLOT_DATA
000A1Ar 2  D0 F6          bne @Copy
000A1Cr 2  20 rr rr       jsr NvBurstEnd
000A1Fr 2  7A             ply
000A20r 2  A9 01          lda #NV_VALID
000A22r 2  4C rr rr       jmp NvOk
000A25r 2               
000A25r 2               ; NvOk / NvFail — Common exits: restore the caller's flags, then report
000A25r 2               ; Entered by jmp with the P byte an entry's php pushed on top of the stack.
000A25r 2               ; A, X and Y pass through untouched.
000A25r 2               NvOk:
000A25r 2  28             plp
000A26r 2  18             clc
000A27r 2  60             rts
000A28r 2               NvFail:
000A28r 2  28             plp
000A29r 2  38             sec
000A2Ar 2  60             rts
000A2Br 2               
000A2Br 2               ; NvFind — Find the lowest slot whose owner ID is A
000A2Br 2               ; Matches any non-free slot, valid or damaged; A = $00 finds the lowest free slot.
000A2Br 2               ; Input: A = owner ID
000A2Br 2               ; Output: X = slot, C clear; C set if no slot matched (X undefined)
000A2Br 2               ; Modifies: Flags (I preserved), A, X, RTC_TMP
000A2Br 2               NvFindImpl:
000A2Br 2  08             php
000A2Cr 2  78             sei
000A2Dr 2  8D 0C 03       sta RTC_TMP
000A30r 2  AD 0D 03       lda HW_PRESENT
000A33r 2  29 04          and #HW_RTC
000A35r 2  F0 F1          beq NvFail
000A37r 2  A2 00          ldx #0
000A39r 2               @Next:
000A39r 2  8A             txa
000A3Ar 2  0A             asl a
000A3Br 2  0A             asl a
000A3Cr 2  0A             asl a
000A3Dr 2  0A             asl a
000A3Er 2  8D 10 88       sta RTC_RAM_ADDR              ; One byte per slot, so no burst: the latch is
000A41r 2  AD 13 88       lda RTC_RAM_DATA              ;   set afresh each time
000A44r 2  CD 0C 03       cmp RTC_TMP
000A47r 2  F0 DC          beq NvOk
000A49r 2  E8             inx
000A4Ar 2  E0 10          cpx #NV_SLOTS
000A4Cr 2  D0 EB          bne @Next
000A4Er 2  F0 D8          beq NvFail
000A50r 2               
000A50r 2               ; NvErase — Zero all 16 bytes of a slot, so nothing of the old save is legible
000A50r 2               ; Input: X = slot (0-15)
000A50r 2               ; Output: C clear; C set on no RTC or bad slot
000A50r 2               ; Modifies: Flags (I preserved), A, Y
000A50r 2               NvEraseImpl:
000A50r 2  08             php
000A51r 2  78             sei
000A52r 2  20 rr rr       jsr NvCheck
000A55r 2  B0 D1          bcs NvFail
000A57r 2  20 rr rr       jsr NvBurstStart
000A5Ar 2  A0 10          ldy #NV_SLOT_SIZE
000A5Cr 2               @Zero:
000A5Cr 2  9C 13 88       stz RTC_RAM_DATA
000A5Fr 2  88             dey
000A60r 2  D0 FA          bne @Zero
000A62r 2  20 rr rr       jsr NvBurstEnd
000A65r 2  4C rr rr       jmp NvOk
000A68r 2               
000A68r 2               ; NvWrite — Write a slot: owner ID, checksum and 14 payload bytes
000A68r 2               ; Input: X = slot (0-15), A/Y = source lo/hi, NV_ID = owner ID ($01-$FF)
000A68r 2               ; Output: C clear; C set on no RTC, bad slot, or NV_ID = 0 (nothing written)
000A68r 2               ; Modifies: Flags (D and I preserved), A, Y, NV_PTR
000A68r 2               NvWriteImpl:
000A68r 2  08             php
000A69r 2  78             sei
000A6Ar 2  D8             cld
000A6Br 2  85 02          sta NV_PTR
000A6Dr 2  84 03          sty NV_PTR+1
000A6Fr 2  20 rr rr       jsr NvCheck
000A72r 2  B0 B4          bcs NvFail
000A74r 2  AD 90 03       lda NV_ID
000A77r 2  F0 AF          beq NvFail                    ; ID 0 marks a free slot — that is NvErase
000A79r 2  A9 A6          lda #NV_CK_SEED               ; Checksum first, from the caller's buffer
000A7Br 2  0A             asl a
000A7Cr 2  69 00          adc #$00
000A7Er 2  4D 90 03       eor NV_ID
000A81r 2  A0 00          ldy #0
000A83r 2               @Sum:
000A83r 2  0A             asl a
000A84r 2  69 00          adc #$00
000A86r 2  51 02          eor (NV_PTR),y
000A88r 2  C8             iny
000A89r 2  C0 0E          cpy #NV_SLOT_DATA
000A8Br 2  D0 F6          bne @Sum
000A8Dr 2  8D 0C 03       sta RTC_TMP
000A90r 2  20 rr rr       jsr NvBurstStart
000A93r 2  AD 90 03       lda NV_ID
000A96r 2  8D 13 88       sta RTC_RAM_DATA
000A99r 2  AD 0C 03       lda RTC_TMP
000A9Cr 2  8D 13 88       sta RTC_RAM_DATA
000A9Fr 2  A0 00          ldy #0
000AA1r 2               @Copy:
000AA1r 2  B1 02          lda (NV_PTR),y
000AA3r 2  8D 13 88       sta RTC_RAM_DATA
000AA6r 2  C8             iny
000AA7r 2  C0 0E          cpy #NV_SLOT_DATA
000AA9r 2  D0 F6          bne @Copy
000AABr 2  20 rr rr       jsr NvBurstEnd
000AAEr 2  4C rr rr       jmp NvOk
000AB1r 2               
000AB1r 2               ; NvFormat — Erase all 16 slots
000AB1r 2               ; Output: C clear; C set on no RTC
000AB1r 2               ; Modifies: Flags, A, X, Y
000AB1r 2               NvFormatImpl:
000AB1r 2  A2 0F          ldx #NV_SLOTS-1
000AB3r 2               @Next:
000AB3r 2  20 rr rr       jsr NvEraseImpl
000AB6r 2  B0 03          bcs @Done
000AB8r 2  CA             dex
000AB9r 2  10 F8          bpl @Next
000ABBr 2               @Done:
000ABBr 2  60             rts
000ABCr 2               
000ABCr 2               ; NvCheck — Fail unless an RTC is fitted and X names a slot
000ABCr 2               ; Input: X = slot
000ABCr 2               ; Output: C set if no RTC or X >= NV_SLOTS
000ABCr 2               ; Modifies: Flags, A
000ABCr 2               NvCheck:
000ABCr 2  AD 0D 03       lda HW_PRESENT
000ABFr 2  29 04          and #HW_RTC
000AC1r 2  F0 03          beq @Fail
000AC3r 2  E0 10          cpx #NV_SLOTS                 ; C = X >= NV_SLOTS
000AC5r 2  60             rts
000AC6r 2               @Fail:
000AC6r 2  38             sec
000AC7r 2  60             rts
000AC8r 2               
000AC8r 2               ; NvScan — Read slot X's header and validate its checksum
000AC8r 2               ; Input: X = slot (already checked), D clear, interrupts masked
000AC8r 2               ; Output: A = NV_EMPTY / NV_VALID / NV_BAD, Y = owner ID
000AC8r 2               ; Modifies: Flags, A, Y, RTC_TMP
000AC8r 2               NvScan:
000AC8r 2  20 rr rr       jsr NvBurstStart
000ACBr 2  AD 13 88       lda RTC_RAM_DATA              ; Owner ID
000ACEr 2  48             pha
000ACFr 2  8D 0C 03       sta RTC_TMP
000AD2r 2  A9 A6          lda #NV_CK_SEED               ; Fold in the owner ID
000AD4r 2  0A             asl a
000AD5r 2  69 00          adc #$00
000AD7r 2  4D 0C 03       eor RTC_TMP
000ADAr 2  AC 13 88       ldy RTC_RAM_DATA              ; Stored checksum
000ADDr 2  8C 0C 03       sty RTC_TMP
000AE0r 2  A0 0E          ldy #NV_SLOT_DATA
000AE2r 2               @Sum:
000AE2r 2  0A             asl a                         ; Rotate left: bit 7 into carry...
000AE3r 2  69 00          adc #$00                      ;   ...and back into bit 0
000AE5r 2  4D 13 88       eor RTC_RAM_DATA              ; Next payload byte
000AE8r 2  88             dey
000AE9r 2  D0 F7          bne @Sum
000AEBr 2  4D 0C 03       eor RTC_TMP                   ; 0 when the checksum agrees
000AEEr 2  8D 0C 03       sta RTC_TMP
000AF1r 2  20 rr rr       jsr NvBurstEnd
000AF4r 2  7A             ply                           ; Y = owner ID
000AF5r 2  F0 0B          beq @Empty
000AF7r 2  AD 0C 03       lda RTC_TMP
000AFAr 2  F0 03          beq @Valid
000AFCr 2  A9 02          lda #NV_BAD
000AFEr 2  60             rts
000AFFr 2               @Valid:
000AFFr 2  A9 01          lda #NV_VALID
000B01r 2  60             rts
000B02r 2               @Empty:
000B02r 2  A9 00          lda #NV_EMPTY
000B04r 2  60             rts
000B05r 2               
000B05r 2               ; NvBurstStart — Point the NVRAM latch at slot X and enable burst mode
000B05r 2               ; Input: X = slot
000B05r 2               ; Modifies: Flags, A
000B05r 2               NvBurstStart:
000B05r 2  8A             txa
000B06r 2  0A             asl a                         ; Slot base = slot * 16
000B07r 2  0A             asl a
000B08r 2  0A             asl a
000B09r 2  0A             asl a
000B0Ar 2  8D 10 88       sta RTC_RAM_ADDR
000B0Dr 2  AD 0F 88       lda RTC_CTRL_B                ; Read-modify-write: Control B also holds TE
000B10r 2  09 20          ora #RTC_CTRL_B_BME
000B12r 2  8D 0F 88       sta RTC_CTRL_B
000B15r 2  60             rts
000B16r 2               
000B16r 2               ; NvBurstEnd — Disable burst mode
000B16r 2               ; Modifies: Flags, A
000B16r 2               NvBurstEnd:
000B16r 2  AD 0F 88       lda RTC_CTRL_B
000B19r 2  29 DF          and #<~RTC_CTRL_B_BME
000B1Br 2  8D 0F 88       sta RTC_CTRL_B
000B1Er 2  60             rts
000B1Fr 2               
000B1Fr 2               ; === Hardware Probes ===
000B1Fr 2               
000B1Fr 2               ; ProbeRAM — Test for banked SRAM on IO 1 and IO 2
000B1Fr 2               ; Two-pattern read-back test ($A5 then $5A) on bank 0 data byte
000B1Fr 2               ; Sets HW_RAM_L / HW_RAM_H in HW_PRESENT on success
000B1Fr 2               ; Modifies: Flags, A
000B1Fr 2               ProbeRAM:
000B1Fr 2                 ; A naive "write byte, immediately read it back" test is unreliable: with no
000B1Fr 2                 ; SRAM responding, bus/parasitic capacitance holds the just-written value for
000B1Fr 2                 ; a cycle or two, so the read-back matches and the probe falsely passes.
000B1Fr 2                 ; Instead we write complementary patterns into TWO different banks, then read
000B1Fr 2                 ; them back AFTER intervening bus cycles (opcode fetches from ROM + a second
000B1Fr 2                 ; bank's data) have flushed the bus. This forces the chip to actually store
000B1Fr 2                 ; distinct values and also exercises the bank-select latch. Open bus cannot
000B1Fr 2                 ; fake both reads. Bank-0/bank-1 byte 0 are saved and restored.
000B1Fr 2               
000B1Fr 2                 ; --- Probe RAM Low (IO 1) ---
000B1Fr 2  9C FF 83       stz RAM_BANK_L                ; Bank 0
000B22r 2  AD 00 80       lda RAM_DATA_L                ; Save bank-0 byte 0
000B25r 2  48             pha
000B26r 2  A9 01          lda #$01
000B28r 2  8D FF 83       sta RAM_BANK_L                ; Bank 1
000B2Br 2  AD 00 80       lda RAM_DATA_L                ; Save bank-1 byte 0
000B2Er 2  48             pha
000B2Fr 2  9C FF 83       stz RAM_BANK_L               ; Bank 0
000B32r 2  A9 A5          lda #$A5
000B34r 2  8D 00 80       sta RAM_DATA_L                ; bank0[0] = $A5
000B37r 2  A9 01          lda #$01
000B39r 2  8D FF 83       sta RAM_BANK_L                ; Bank 1
000B3Cr 2  A9 5A          lda #$5A
000B3Er 2  8D 00 80       sta RAM_DATA_L                ; bank1[0] = $5A (flips data + address lines)
000B41r 2  9C FF 83       stz RAM_BANK_L               ; Back to bank 0
000B44r 2  AD 00 80       lda RAM_DATA_L               ; Read bank0[0] (bus no longer holds $A5)
000B47r 2  C9 A5          cmp #$A5
000B49r 2  D0 14          bne @RAMLRestore             ; Bank 0 did not retain its value
000B4Br 2  A9 01          lda #$01
000B4Dr 2  8D FF 83       sta RAM_BANK_L                ; Bank 1
000B50r 2  AD 00 80       lda RAM_DATA_L               ; Read bank1[0]
000B53r 2  C9 5A          cmp #$5A
000B55r 2  D0 08          bne @RAMLRestore             ; Bank 1 did not retain (or latch failed)
000B57r 2  AD 0D 03       lda HW_PRESENT
000B5Ar 2  09 01          ora #HW_RAM_L
000B5Cr 2  8D 0D 03       sta HW_PRESENT
000B5Fr 2               @RAMLRestore:
000B5Fr 2  A9 01          lda #$01
000B61r 2  8D FF 83       sta RAM_BANK_L                ; Bank 1
000B64r 2  68             pla
000B65r 2  8D 00 80       sta RAM_DATA_L                ; Restore bank-1 byte 0
000B68r 2  9C FF 83       stz RAM_BANK_L               ; Bank 0
000B6Br 2  68             pla
000B6Cr 2  8D 00 80       sta RAM_DATA_L                ; Restore bank-0 byte 0
000B6Fr 2               
000B6Fr 2                 ; --- Probe RAM High (IO 2) ---
000B6Fr 2  9C FF 87       stz RAM_BANK_H                ; Bank 0
000B72r 2  AD 00 84       lda RAM_DATA_H                ; Save bank-0 byte 0
000B75r 2  48             pha
000B76r 2  A9 01          lda #$01
000B78r 2  8D FF 87       sta RAM_BANK_H                ; Bank 1
000B7Br 2  AD 00 84       lda RAM_DATA_H                ; Save bank-1 byte 0
000B7Er 2  48             pha
000B7Fr 2  9C FF 87       stz RAM_BANK_H               ; Bank 0
000B82r 2  A9 A5          lda #$A5
000B84r 2  8D 00 84       sta RAM_DATA_H                ; bank0[0] = $A5
000B87r 2  A9 01          lda #$01
000B89r 2  8D FF 87       sta RAM_BANK_H                ; Bank 1
000B8Cr 2  A9 5A          lda #$5A
000B8Er 2  8D 00 84       sta RAM_DATA_H                ; bank1[0] = $5A (flips data + address lines)
000B91r 2  9C FF 87       stz RAM_BANK_H               ; Back to bank 0
000B94r 2  AD 00 84       lda RAM_DATA_H               ; Read bank0[0] (bus no longer holds $A5)
000B97r 2  C9 A5          cmp #$A5
000B99r 2  D0 14          bne @RAMHRestore             ; Bank 0 did not retain its value
000B9Br 2  A9 01          lda #$01
000B9Dr 2  8D FF 87       sta RAM_BANK_H                ; Bank 1
000BA0r 2  AD 00 84       lda RAM_DATA_H               ; Read bank1[0]
000BA3r 2  C9 5A          cmp #$5A
000BA5r 2  D0 08          bne @RAMHRestore             ; Bank 1 did not retain (or latch failed)
000BA7r 2  AD 0D 03       lda HW_PRESENT
000BAAr 2  09 02          ora #HW_RAM_H
000BACr 2  8D 0D 03       sta HW_PRESENT
000BAFr 2               @RAMHRestore:
000BAFr 2  A9 01          lda #$01
000BB1r 2  8D FF 87       sta RAM_BANK_H                ; Bank 1
000BB4r 2  68             pla
000BB5r 2  8D 00 84       sta RAM_DATA_H                ; Restore bank-1 byte 0
000BB8r 2  9C FF 87       stz RAM_BANK_H               ; Bank 0
000BBBr 2  68             pla
000BBCr 2  8D 00 84       sta RAM_DATA_H                ; Restore bank-0 byte 0
000BBFr 2  60             rts
000BC0r 2               
000BC0r 2               ; ProbeVideo — identify a 6502-PICOVDP (SPEC §16)
000BC0r 2               ; Selects STAT4 on port A and looks for the identification byte.  Only a PICOVDP
000BC0r 2               ; is video: an empty slot reads something else, and a TMS9918A decodes three
000BC0r 2               ; register bits, takes the select as a harmless register 7 write, and is left
000BC0r 2               ; alone after that.  On a PICOVDP, records STAT5 in VDP_FW and STAT6 in
000BC0r 2               ; VDP_CAPS, puts STATSEL_A back to STAT0 and sets HW_VID.  STAT5 gates nothing.
000BC0r 2               ; Modifies: Flags, A, VDP_FW, VDP_CAPS
000BC0r 2               ProbeVideo:
000BC0r 2  9C 94 03       stz VDP_FW                    ; No card until one answers
000BC3r 2  9C 95 03       stz VDP_CAPS
000BC6r 2  AD 01 9C       lda VC_STATUS                 ; Resynchronise the command flip-flop (and, on
000BC9r 2                                               ;   a TMS9918A, clear the flags that could
000BC9r 2                                               ;   otherwise read as $AC)
000BC9r 2  A9 04          lda #$04
000BCBr 2  20 rr rr       jsr VdpSelectStat
000BCEr 2  AD 01 9C       lda VC_STATUS                 ; STAT4
000BD1r 2  C9 AC          cmp #VDP_ID
000BD3r 2  D0 1B          bne @ProbeVideoDone           ; Not a PICOVDP: nothing more is written
000BD5r 2  A9 05          lda #$05
000BD7r 2  20 rr rr       jsr VdpSelectStat
000BDAr 2  AD 01 9C       lda VC_STATUS
000BDDr 2  8D 94 03       sta VDP_FW                    ; STAT5: firmware version, BCD
000BE0r 2  A9 06          lda #$06
000BE2r 2  20 rr rr       jsr VdpReadStat               ; And STATSEL_A back to STAT0
000BE5r 2  8D 95 03       sta VDP_CAPS                  ; STAT6: capability bits
000BE8r 2  AD 0D 03       lda HW_PRESENT
000BEBr 2  09 80          ora #HW_VID
000BEDr 2  8D 0D 03       sta HW_PRESENT
000BF0r 2               @ProbeVideoDone:
000BF0r 2  60             rts
000BF1r 2               
000BF1r 2               ; ProbeGPIO — VIA DDR register read-back test
000BF1r 2               ; Writes $AA to GPIO_DDRB, reads it back
000BF1r 2               ; Sets HW_GPIO in HW_PRESENT on success
000BF1r 2               ; Restores GPIO_DDRB to $00 afterward
000BF1r 2               ; Modifies: Flags, A
000BF1r 2               ProbeGPIO:
000BF1r 2  A9 AA          lda #$AA
000BF3r 2  8D 02 94       sta GPIO_DDRB
000BF6r 2  CD 02 94       cmp GPIO_DDRB
000BF9r 2  D0 08          bne @ProbeGPIODone
000BFBr 2  AD 0D 03       lda HW_PRESENT
000BFEr 2  09 20          ora #HW_GPIO
000C00r 2  8D 0D 03       sta HW_PRESENT
000C03r 2               @ProbeGPIODone:
000C03r 2  9C 02 94       stz GPIO_DDRB                 ; Restore to inputs (InitKBImpl will configure properly)
000C06r 2  60             rts
000C07r 2               
000C07r 2               ; ProbeSerial — R65C51 CMD register write/read-back test
000C07r 2               ; Issues programmatic reset, writes test value to CMD, reads back
000C07r 2               ; Open bus will not match — prevents false detection
000C07r 2               ; Sets HW_SC in HW_PRESENT on success
000C07r 2               ; Modifies: Flags, A
000C07r 2               ProbeSerial:
000C07r 2  9C 01 90       stz SC_RESET                  ; Programmatic reset (write any value)
000C0Ar 2  A9 0A          lda #$0A                      ; Test value (bits within CMD writable range)
000C0Cr 2  8D 02 90       sta SC_CMD                    ; Write to Command Register
000C0Fr 2  CD 02 90       cmp SC_CMD                    ; Read back — should match if real hardware
000C12r 2  D0 08          bne @ProbeSerialDone          ; Mismatch = open bus, no card present
000C14r 2  AD 0D 03       lda HW_PRESENT
000C17r 2  09 10          ora #HW_SC
000C19r 2  8D 0D 03       sta HW_PRESENT
000C1Cr 2               @ProbeSerialDone:
000C1Cr 2  60             rts
000C1Dr 2               
000C1Dr 2               ; ProbeSID — Active oscillator test using voice 3
000C1Dr 2               ; Configures voice 3 noise waveform, brief delay, reads SID_OSC3
000C1Dr 2               ; Non-zero and non-$FF result indicates SID present
000C1Dr 2               ; Sets HW_SID in HW_PRESENT on success
000C1Dr 2               ; Modifies: Flags, A, X, Y
000C1Dr 2               ProbeSID:
000C1Dr 2                 ; Set voice 3 frequency to a fast value
000C1Dr 2  A9 FF          lda #$FF
000C1Fr 2  8D 0E 98       sta SID_V3_FREQ_LO
000C22r 2  8D 0F 98       sta SID_V3_FREQ_HI
000C25r 2                 ; Gate on + noise waveform
000C25r 2  A9 81          lda #(SID_CTRL_GATE | SID_CTRL_NOISE)
000C27r 2  8D 12 98       sta SID_V3_CTRL
000C2Ar 2                 ; Brief software delay for oscillator to run
000C2Ar 2  A0 00          ldy #$00
000C2Cr 2               @ProbeSIDDelay:
000C2Cr 2  88             dey
000C2Dr 2  D0 FD          bne @ProbeSIDDelay            ; ~1280 cycles
000C2Fr 2                 ; Read oscillator 3 output
000C2Fr 2  AD 1B 98       lda SID_OSC3
000C32r 2  F0 0E          beq @ProbeSIDCleanup          ; Zero → no SID
000C34r 2  C9 FF          cmp #$FF
000C36r 2  F0 0A          beq @ProbeSIDCleanup          ; $FF → likely floating bus
000C38r 2                 ; SID detected
000C38r 2  48             pha
000C39r 2  AD 0D 03       lda HW_PRESENT
000C3Cr 2  09 40          ora #HW_SID
000C3Er 2  8D 0D 03       sta HW_PRESENT
000C41r 2  68             pla
000C42r 2               @ProbeSIDCleanup:
000C42r 2                 ; Silence voice 3
000C42r 2  9C 12 98       stz SID_V3_CTRL
000C45r 2  9C 0E 98       stz SID_V3_FREQ_LO
000C48r 2  9C 0F 98       stz SID_V3_FREQ_HI
000C4Br 2  60             rts
000C4Cr 2               
000C4Cr 2               ; ProbeRTC — DS1511Y NVRAM read-back test
000C4Cr 2               ; Writes test pattern to NVRAM address 0, reads it back
000C4Cr 2               ; Sets HW_RTC in HW_PRESENT on success
000C4Cr 2               ; Restores original NVRAM value afterward
000C4Cr 2               ; Modifies: Flags, A
000C4Cr 2               ProbeRTC:
000C4Cr 2                 ; BME is battery-backed and undefined at power-up, like TE beside it.  Left set,
000C4Cr 2                 ; every access of RTC_RAM_DATA below would advance the address latch: the
000C4Cr 2                 ; read-back would compare against the wrong byte, HW_RTC would never be set,
000C4Cr 2                 ; and the restore would land on a third address.  So clear it before the RAM
000C4Cr 2                 ; ports are touched — read-modify-write, since Control B also holds TE.
000C4Cr 2  AD 0F 88       lda RTC_CTRL_B
000C4Fr 2  29 DF          and #<~RTC_CTRL_B_BME
000C51r 2  8D 0F 88       sta RTC_CTRL_B
000C54r 2  9C 10 88       stz RTC_RAM_ADDR              ; Select NVRAM address 0
000C57r 2  AD 13 88       lda RTC_RAM_DATA              ; Save existing value
000C5Ar 2  48             pha
000C5Br 2  A9 A5          lda #$A5
000C5Dr 2  8D 13 88       sta RTC_RAM_DATA              ; Write test pattern
000C60r 2  CD 13 88       cmp RTC_RAM_DATA              ; Read back
000C63r 2  D0 18          bne @ProbeRTCDone
000C65r 2  AD 0D 03       lda HW_PRESENT
000C68r 2  09 04          ora #HW_RTC
000C6Ar 2  8D 0D 03       sta HW_PRESENT
000C6Dr 2                 ; The DS1511Y SQW pin feeds the AB Controller, which turns every SQW edge into
000C6Dr 2                 ; a 6502 NMI. Its control bits power up undefined and are battery-backed, so
000C6Dr 2                 ; explicitly disable the square-wave output here. E32K/BB32/EOSC live in the
000C6Dr 2                 ; upper 3 bits of the month register (05H); keep the month value and leave the
000C6Dr 2                 ; oscillator running.
000C6Dr 2                 ;
000C6Dr 2                 ; Bracketed like any other clock write, since 05H carries the month as well as
000C6Dr 2                 ; the control bits. The thaw doubles as a repair: TE is battery-backed, so a
000C6Dr 2                 ; board whose TE was left at 0 reads a stopped clock forever, and setting it
000C6Dr 2                 ; here is the only thing that starts the readout moving again.
000C6Dr 2  20 rr rr       jsr RtcFreeze
000C70r 2  AD 05 88       lda RTC_MON
000C73r 2  29 1F          and #RTC_MON_MASK             ; Keep month value (low 5 bits)
000C75r 2  09 40          ora #RTC_MON_E32K             ; E32K=1 → SQW disabled; BB32=0, EOSC=0
000C77r 2  8D 05 88       sta RTC_MON
000C7Ar 2  20 rr rr       jsr RtcThaw
000C7Dr 2               @ProbeRTCDone:
000C7Dr 2  68             pla
000C7Er 2  8D 13 88       sta RTC_RAM_DATA              ; Restore original value
000C81r 2  60             rts
000C82r 2               
000C82r 2               ; === CompactFlash Storage Driver (True 8-bit IDE Mode) ===
000C82r 2               
000C82r 2               ; StWaitReady — Wait for CompactFlash to become ready
000C82r 2               ; Polls ST_STATUS until BSY=0 and RDY=1, with X/Y timeout (~65536 iterations)
000C82r 2               ; Output: Carry clear = ready, Carry set = error or timeout
000C82r 2               ; Modifies: Flags, A, X, Y
000C82r 2               StWaitReadyImpl:
000C82r 2  AD 0D 03       lda HW_PRESENT
000C85r 2  29 08          and #HW_CF
000C87r 2  D0 02          bne StWaitReadyPoll           ; Card fitted — poll it
000C89r 2  38             sec                           ; No card: fail now rather than spinning out a
000C8Ar 2  60             rts                           ;   65536-iteration timeout per sector.  This is
000C8Br 2                                               ;   the one guard the whole storage stack needs
000C8Br 2                                               ;   — every read, write and directory listing
000C8Br 2                                               ;   comes through here first — so a caller on
000C8Br 2                                               ;   a machine with an empty slot gets carry set
000C8Br 2                                               ;   without carrying a presence check of its
000C8Br 2                                               ;   own.
000C8Br 2               
000C8Br 2               ; StWaitReadyPoll — the same wait without the presence check, for the probe that
000C8Br 2               ; establishes presence in the first place.
000C8Br 2               StWaitReadyPoll:
000C8Br 2  A2 00          ldx #$00                      ; Outer timeout counter (256 × 256 = 65536 iterations)
000C8Dr 2  A0 00          ldy #$00
000C8Fr 2               @StWaitBsy:
000C8Fr 2  AD 07 8C       lda ST_STATUS
000C92r 2  29 80          and #ST_STATUS_BSY            ; Check BSY bit
000C94r 2  F0 08          beq @StCheckRdy               ; BSY clear — check RDY
000C96r 2  88             dey
000C97r 2  D0 F6          bne @StWaitBsy
000C99r 2  CA             dex
000C9Ar 2  D0 F3          bne @StWaitBsy
000C9Cr 2  38             sec                           ; Timed out — no device
000C9Dr 2  60             rts
000C9Er 2               @StCheckRdy:
000C9Er 2  AD 07 8C       lda ST_STATUS
000CA1r 2  29 40          and #ST_STATUS_RDY            ; Check RDY bit
000CA3r 2  D0 08          bne @StCheckErr               ; RDY set — check for errors
000CA5r 2  88             dey
000CA6r 2  D0 E7          bne @StWaitBsy
000CA8r 2  CA             dex
000CA9r 2  D0 E4          bne @StWaitBsy
000CABr 2  38             sec                           ; Timed out
000CACr 2  60             rts
000CADr 2               @StCheckErr:
000CADr 2  AD 07 8C       lda ST_STATUS
000CB0r 2  29 01          and #ST_STATUS_ERR            ; Check ERR bit
000CB2r 2  D0 02          bne @StWaitErr
000CB4r 2  18             clc                           ; Ready, no error
000CB5r 2  60             rts
000CB6r 2               @StWaitErr:
000CB6r 2  38             sec                           ; Error condition
000CB7r 2  60             rts
000CB8r 2               
000CB8r 2               ; StWaitDrq — Wait for CompactFlash data request
000CB8r 2               ; Polls ST_STATUS until BSY=0 and DRQ=1, with X/Y timeout (~65536 iterations)
000CB8r 2               ; Output: Carry clear = DRQ active, Carry set = error or timeout
000CB8r 2               ; Modifies: Flags, A, X, Y
000CB8r 2               StWaitDrq:
000CB8r 2  A2 00          ldx #$00                      ; Outer timeout counter (256 × 256 = 65536 iterations)
000CBAr 2  A0 00          ldy #$00
000CBCr 2               @StDrqBsy:
000CBCr 2  AD 07 8C       lda ST_STATUS
000CBFr 2  29 80          and #ST_STATUS_BSY
000CC1r 2  F0 08          beq @StDrqCheckDrq            ; BSY clear — check DRQ
000CC3r 2  88             dey
000CC4r 2  D0 F6          bne @StDrqBsy
000CC6r 2  CA             dex
000CC7r 2  D0 F3          bne @StDrqBsy
000CC9r 2  38             sec                           ; Timed out — no device
000CCAr 2  60             rts
000CCBr 2               @StDrqCheckDrq:
000CCBr 2  AD 07 8C       lda ST_STATUS
000CCEr 2  29 01          and #ST_STATUS_ERR
000CD0r 2  D0 11          bne @StDrqErr
000CD2r 2  AD 07 8C       lda ST_STATUS
000CD5r 2  29 08          and #ST_STATUS_DRQ
000CD7r 2  D0 08          bne @StDrqOk                  ; DRQ set — ready for data
000CD9r 2  88             dey
000CDAr 2  D0 E0          bne @StDrqBsy
000CDCr 2  CA             dex
000CDDr 2  D0 DD          bne @StDrqBsy
000CDFr 2  38             sec                           ; Timed out
000CE0r 2  60             rts
000CE1r 2               @StDrqOk:
000CE1r 2  18             clc
000CE2r 2  60             rts
000CE3r 2               @StDrqErr:
000CE3r 2  38             sec
000CE4r 2  60             rts
000CE5r 2               
000CE5r 2               ; StInit — Initialize CompactFlash for 8-bit data transfers
000CE5r 2               ; Issues Set Features command with subcommand $01 (enable 8-bit I/O)
000CE5r 2               ; Output: Carry clear = success, Carry set = error
000CE5r 2               ; Modifies: Flags, A
000CE5r 2               StInit:
000CE5r 2  20 rr rr       jsr StWaitReadyPoll           ; Not StWaitReady: HW_CF is what this sets, so
000CE8r 2                                               ;   the guarded entry would answer "no card"
000CE8r 2                                               ;   before the card had been asked
000CE8r 2  B0 15          bcs @StInitDone               ; Timeout or error — CF not present
000CEAr 2                 ; CF responded — set presence flag
000CEAr 2  AD 0D 03       lda HW_PRESENT
000CEDr 2  09 08          ora #HW_CF
000CEFr 2  8D 0D 03       sta HW_PRESENT
000CF2r 2  A9 01          lda #ST_FEAT_8BIT             ; Feature: enable 8-bit data I/O
000CF4r 2  8D 01 8C       sta ST_FEATURE
000CF7r 2  A9 EF          lda #ST_CMD_SET_FEAT          ; Set Features command
000CF9r 2  8D 07 8C       sta ST_CMD
000CFCr 2  20 rr rr       jsr StWaitReady               ; Wait for command completion
000CFFr 2               @StInitDone:
000CFFr 2  60             rts
000D00r 2               
000D00r 2               ; StSetupLba — Set up LBA registers from CF_LBA zero page variables
000D00r 2               ; Also sets sector count to 1 and selects master drive in LBA mode
000D00r 2               ; Modifies: Flags, A
000D00r 2               StSetupLba:
000D00r 2  A9 01          lda #$01
000D02r 2  8D 02 8C       sta ST_SECT_CNT               ; Always 1 sector
000D05r 2                 ; Effective LBA = CF_LBA + CF_DISK * FS_DISK_SECTORS (disk banking base offset).
000D05r 2                 ; base = CF_DISK << 11: byte0=0, byte1=(CF_DISK<<3)&$FF, byte2=CF_DISK>>5, byte3=0.
000D05r 2                 ; Precompute base bits 16-23 (CF_DISK >> 5) into X before any add clobbers carry.
000D05r 2  AD 0F 03       lda CF_DISK
000D08r 2  4A             lsr a
000D09r 2  4A             lsr a
000D0Ar 2  4A             lsr a
000D0Br 2  4A             lsr a
000D0Cr 2  4A             lsr a
000D0Dr 2  AA             tax                           ; X = CF_DISK >> 5 (disk base, LBA bits 16-23)
000D0Er 2  A5 26          lda CF_LBA
000D10r 2  8D 03 8C       sta ST_LBA_0                  ; LBA bits 0-7 (base low byte is 0)
000D13r 2                 ; LBA bits 8-15: CF_LBA+1 + (CF_DISK << 3)
000D13r 2  AD 0F 03       lda CF_DISK
000D16r 2  0A             asl a
000D17r 2  0A             asl a
000D18r 2  0A             asl a                         ; A = (CF_DISK << 3) & $FF
000D19r 2  18             clc
000D1Ar 2  65 27          adc CF_LBA + 1
000D1Cr 2  8D 04 8C       sta ST_LBA_1
000D1Fr 2                 ; LBA bits 16-23: CF_LBA+2 + (CF_DISK >> 5) + carry
000D1Fr 2  8A             txa
000D20r 2  65 28          adc CF_LBA + 2
000D22r 2  8D 05 8C       sta ST_LBA_2
000D25r 2                 ; LBA bits 24-27: CF_LBA+3 + carry
000D25r 2  A5 29          lda CF_LBA + 3
000D27r 2  69 00          adc #$00
000D29r 2  29 0F          and #$0F                      ; Mask to 4 bits (LBA 24-27)
000D2Br 2  09 E0          ora #ST_LBA3_MASTER           ; LBA mode, master drive
000D2Dr 2  8D 06 8C       sta ST_LBA_3
000D30r 2  60             rts
000D31r 2               
000D31r 2               ; StReadSector — Read one 512-byte sector from CompactFlash
000D31r 2               ; Input: CF_LBA ($26-$29) = LBA address, CF_BUF_PTR ($24-$25) = destination pointer
000D31r 2               ; Output: Carry clear = success, Carry set = error
000D31r 2               ;         CF_BUF_PTR advanced by 512 bytes on success
000D31r 2               ; Modifies: Flags, A, X, Y
000D31r 2               StReadSectorImpl:
000D31r 2  20 rr rr       jsr StWaitReady
000D34r 2  B0 1F          bcs @StReadDone
000D36r 2  20 rr rr       jsr StSetupLba
000D39r 2  A9 20          lda #ST_CMD_READ              ; Issue read command
000D3Br 2  8D 07 8C       sta ST_CMD
000D3Er 2  20 rr rr       jsr StWaitDrq                 ; Wait for data ready
000D41r 2  B0 12          bcs @StReadDone
000D43r 2                 ; Read 512 bytes: 2 pages of 256 bytes
000D43r 2  A0 00          ldy #$00
000D45r 2  A2 02          ldx #$02                      ; 2 pages
000D47r 2               @StReadPage:
000D47r 2  AD 00 8C       lda ST_DATA                   ; Read byte from CF
000D4Ar 2  91 24          sta (CF_BUF_PTR),y            ; Store to destination
000D4Cr 2  C8             iny
000D4Dr 2  D0 F8          bne @StReadPage               ; Loop for 256 bytes
000D4Fr 2  E6 25          inc CF_BUF_PTR + 1            ; Next page
000D51r 2  CA             dex
000D52r 2  D0 F3          bne @StReadPage
000D54r 2  18             clc                           ; Success
000D55r 2               @StReadDone:
000D55r 2  60             rts
000D56r 2               
000D56r 2               ; StWriteSector — Write one 512-byte sector to CompactFlash
000D56r 2               ; Input: CF_LBA ($26-$29) = LBA address, CF_BUF_PTR ($24-$25) = source pointer
000D56r 2               ; Output: Carry clear = success, Carry set = error
000D56r 2               ;         CF_BUF_PTR advanced by 512 bytes on success
000D56r 2               ; Modifies: Flags, A, X, Y
000D56r 2               StWriteSectorImpl:
000D56r 2  20 rr rr       jsr StWaitReady
000D59r 2  B0 21          bcs @StWriteDone
000D5Br 2  20 rr rr       jsr StSetupLba
000D5Er 2  A9 30          lda #ST_CMD_WRITE             ; Issue write command
000D60r 2  8D 07 8C       sta ST_CMD
000D63r 2  20 rr rr       jsr StWaitDrq                 ; Wait for data request
000D66r 2  B0 14          bcs @StWriteDone
000D68r 2                 ; Write 512 bytes: 2 pages of 256 bytes
000D68r 2  A0 00          ldy #$00
000D6Ar 2  A2 02          ldx #$02                      ; 2 pages
000D6Cr 2               @StWritePage:
000D6Cr 2  B1 24          lda (CF_BUF_PTR),y            ; Load from source
000D6Er 2  8D 00 8C       sta ST_DATA                   ; Write byte to CF
000D71r 2  C8             iny
000D72r 2  D0 F8          bne @StWritePage              ; Loop for 256 bytes
000D74r 2  E6 25          inc CF_BUF_PTR + 1            ; Next page
000D76r 2  CA             dex
000D77r 2  D0 F3          bne @StWritePage
000D79r 2  20 rr rr       jsr StWaitReady               ; Wait for write to complete
000D7Cr 2               @StWriteDone:
000D7Cr 2  60             rts
000D7Dr 2               
000D7Dr 2               ; === Simple Custom Filesystem ===
000D7Dr 2               ; Directory at LBA 0: 16 entries x 32 bytes = 512 bytes
000D7Dr 2               ; Entry format:
000D7Dr 2               ;   $00-$07: 8-byte filename (space-padded)
000D7Dr 2               ;   $08-$0A: 3-byte extension (space-padded)
000D7Dr 2               ;   $0B:     flags (bit 0 = in use)
000D7Dr 2               ;   $0C-$0D: start sector (little-endian)
000D7Dr 2               ;   $0E-$0F: file size in bytes (little-endian)
000D7Dr 2               ;   $10-$1F: reserved (16 bytes)
000D7Dr 2               
000D7Dr 2               ; FsParseName — Parse null-terminated filename at STR_PTR into FS_FNAME_BUF
000D7Dr 2               ; Converts "NAME.EXT" into 8+3 space-padded format
000D7Dr 2               ; Input: STR_PTR ($02-$03) points to null-terminated filename
000D7Dr 2               ; Output: FS_FNAME_BUF filled with padded 8+3 name
000D7Dr 2               ; Modifies: Flags, A, X, Y
000D7Dr 2               ; The extension is inert: it is split on the dot, padded into the directory
000D7Dr 2               ; fields, and matched by FsFindFile's flat 11-byte compare.  Nothing anywhere
000D7Dr 2               ; branches on it, so .PRG / .BAS / .FOO all behave identically — what a file
000D7Dr 2               ; means is decided by the command that loads it (LOAD vs BLOAD), never by name.
000D7Dr 2               FsParseName:
000D7Dr 2                 ; Fill FS_FNAME_BUF with spaces
000D7Dr 2  A9 20          lda #$20
000D7Fr 2  A2 0A          ldx #10
000D81r 2               @FsParseClr:
000D81r 2  9D 50 03       sta FS_FNAME_BUF,x
000D84r 2  CA             dex
000D85r 2  10 FA          bpl @FsParseClr
000D87r 2                 ; Copy name part (up to 8 chars, stop at '.' or null)
000D87r 2  A0 00          ldy #$00                      ; Source index
000D89r 2  A2 00          ldx #$00                      ; Dest index (name portion)
000D8Br 2               @FsParseName:
000D8Br 2  B1 02          lda (STR_PTR),y
000D8Dr 2  F0 35          beq @FsParseDone              ; Null terminator — no extension
000D8Fr 2  C9 2E          cmp #'.'
000D91r 2  F0 15          beq @FsParseExt               ; Found dot — start extension
000D93r 2  E0 08          cpx #$08
000D95r 2  B0 0E          bcs @FsParseSkipName          ; Already 8 chars, skip extras
000D97r 2                 ; Convert lowercase to uppercase
000D97r 2  C9 61          cmp #'a'
000D99r 2  90 06          bcc @FsStoreNameChar
000D9Br 2  C9 7B          cmp #'z' + 1
000D9Dr 2  B0 02          bcs @FsStoreNameChar
000D9Fr 2  29 DF          and #$DF                      ; Clear bit 5 to uppercase
000DA1r 2               @FsStoreNameChar:
000DA1r 2  9D 50 03       sta FS_FNAME_BUF,x
000DA4r 2  E8             inx
000DA5r 2               @FsParseSkipName:
000DA5r 2  C8             iny
000DA6r 2  80 E3          bra @FsParseName
000DA8r 2               @FsParseExt:
000DA8r 2  C8             iny                           ; Skip the dot
000DA9r 2  A2 08          ldx #$08                      ; Extension starts at offset 8
000DABr 2               @FsParseExtLoop:
000DABr 2  B1 02          lda (STR_PTR),y
000DADr 2  F0 15          beq @FsParseDone              ; Null terminator
000DAFr 2  E0 0B          cpx #$0B
000DB1r 2  B0 11          bcs @FsParseDone              ; Max 3 ext chars
000DB3r 2                 ; Convert lowercase to uppercase
000DB3r 2  C9 61          cmp #'a'
000DB5r 2  90 06          bcc @FsStoreExtChar
000DB7r 2  C9 7B          cmp #'z' + 1
000DB9r 2  B0 02          bcs @FsStoreExtChar
000DBBr 2  29 DF          and #$DF
000DBDr 2               @FsStoreExtChar:
000DBDr 2  9D 50 03       sta FS_FNAME_BUF,x
000DC0r 2  E8             inx
000DC1r 2  C8             iny
000DC2r 2  80 E7          bra @FsParseExtLoop
000DC4r 2               @FsParseDone:
000DC4r 2  60             rts
000DC5r 2               
000DC5r 2               ; FsReadDir — Read directory sector (LBA 0) into FS_SECTOR_BUF
000DC5r 2               ; Output: Carry clear = success, Carry set = error
000DC5r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
000DC5r 2               FsReadDir:
000DC5r 2  64 26          stz CF_LBA                    ; LBA = 0 (directory sector)
000DC7r 2  64 27          stz CF_LBA + 1
000DC9r 2  64 28          stz CF_LBA + 2
000DCBr 2  64 29          stz CF_LBA + 3
000DCDr 2  A9 00          lda #<FS_SECTOR_BUF
000DCFr 2  85 24          sta CF_BUF_PTR
000DD1r 2  A9 06          lda #>FS_SECTOR_BUF
000DD3r 2  85 25          sta CF_BUF_PTR + 1
000DD5r 2  4C rr rr       jmp StReadSector
000DD8r 2               
000DD8r 2               ; FsWriteDir — Write directory sector from FS_SECTOR_BUF to LBA 0
000DD8r 2               ; Output: Carry clear = success, Carry set = error
000DD8r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
000DD8r 2               FsWriteDir:
000DD8r 2  64 26          stz CF_LBA
000DDAr 2  64 27          stz CF_LBA + 1
000DDCr 2  64 28          stz CF_LBA + 2
000DDEr 2  64 29          stz CF_LBA + 3
000DE0r 2  A9 00          lda #<FS_SECTOR_BUF
000DE2r 2  85 24          sta CF_BUF_PTR
000DE4r 2  A9 06          lda #>FS_SECTOR_BUF
000DE6r 2  85 25          sta CF_BUF_PTR + 1
000DE8r 2  4C rr rr       jmp StWriteSector
000DEBr 2               
000DEBr 2               ; FsFindFile — Search directory for filename in FS_FNAME_BUF
000DEBr 2               ; Must call FsReadDir first to load directory into FS_SECTOR_BUF
000DEBr 2               ; Output: Carry clear = found, X = entry index (0-15), CF_BUF_PTR points to entry
000DEBr 2               ;         Carry set = not found
000DEBr 2               ; Modifies: Flags, A, X, Y, CF_BUF_PTR
000DEBr 2               FsFindFile:
000DEBr 2  A9 00          lda #<FS_SECTOR_BUF
000DEDr 2  85 24          sta CF_BUF_PTR
000DEFr 2  A9 06          lda #>FS_SECTOR_BUF
000DF1r 2  85 25          sta CF_BUF_PTR + 1
000DF3r 2  A2 00          ldx #$00                      ; Entry index
000DF5r 2               @FsFindLoop:
000DF5r 2                 ; Check if entry is in use
000DF5r 2  A0 0B          ldy #FS_ENTRY_FLAGS
000DF7r 2  B1 24          lda (CF_BUF_PTR),y
000DF9r 2  29 01          and #FS_FLAG_USED
000DFBr 2  F0 13          beq @FsFindNext               ; Skip unused entries
000DFDr 2                 ; Compare 11-byte filename
000DFDr 2  A0 00          ldy #$00
000DFFr 2               @FsFindCmp:
000DFFr 2  B1 24          lda (CF_BUF_PTR),y
000E01r 2  D9 50 03       cmp FS_FNAME_BUF,y
000E04r 2  D0 0A          bne @FsFindNext               ; Mismatch
000E06r 2  C8             iny
000E07r 2  C0 0B          cpy #11
000E09r 2  D0 F4          bne @FsFindCmp
000E0Br 2                 ; Match found
000E0Br 2  8E 4D 03       stx FS_DIR_IDX
000E0Er 2  18             clc
000E0Fr 2  60             rts
000E10r 2               @FsFindNext:
000E10r 2                 ; Advance CF_BUF_PTR by 32 (FS_ENTRY_SIZE)
000E10r 2  A5 24          lda CF_BUF_PTR
000E12r 2  18             clc
000E13r 2  69 20          adc #FS_ENTRY_SIZE
000E15r 2  85 24          sta CF_BUF_PTR
000E17r 2  90 02          bcc @FsFindNoCarry
000E19r 2  E6 25          inc CF_BUF_PTR + 1
000E1Br 2               @FsFindNoCarry:
000E1Br 2  E8             inx
000E1Cr 2  E0 10          cpx #FS_MAX_FILES
000E1Er 2  D0 D5          bne @FsFindLoop
000E20r 2  38             sec                           ; Not found
000E21r 2  60             rts
000E22r 2               
000E22r 2               ; FsFindFree — Find first free directory entry
000E22r 2               ; Must call FsReadDir first
000E22r 2               ; Output: Carry clear = found, X = entry index, CF_BUF_PTR points to entry
000E22r 2               ;         Carry set = directory full
000E22r 2               ; Modifies: Flags, A, X, Y, CF_BUF_PTR
000E22r 2               FsFindFree:
000E22r 2  A9 00          lda #<FS_SECTOR_BUF
000E24r 2  85 24          sta CF_BUF_PTR
000E26r 2  A9 06          lda #>FS_SECTOR_BUF
000E28r 2  85 25          sta CF_BUF_PTR + 1
000E2Ar 2  A2 00          ldx #$00
000E2Cr 2               @FsFreeLoop:
000E2Cr 2  A0 0B          ldy #FS_ENTRY_FLAGS
000E2Er 2  B1 24          lda (CF_BUF_PTR),y
000E30r 2  29 01          and #FS_FLAG_USED
000E32r 2  F0 12          beq @FsFreeFound              ; Found unused entry
000E34r 2                 ; Advance by 32
000E34r 2  A5 24          lda CF_BUF_PTR
000E36r 2  18             clc
000E37r 2  69 20          adc #FS_ENTRY_SIZE
000E39r 2  85 24          sta CF_BUF_PTR
000E3Br 2  90 02          bcc @FsFreeNoCarry
000E3Dr 2  E6 25          inc CF_BUF_PTR + 1
000E3Fr 2               @FsFreeNoCarry:
000E3Fr 2  E8             inx
000E40r 2  E0 10          cpx #FS_MAX_FILES
000E42r 2  D0 E8          bne @FsFreeLoop
000E44r 2  38             sec                           ; Directory full
000E45r 2  60             rts
000E46r 2               @FsFreeFound:
000E46r 2  8E 4D 03       stx FS_DIR_IDX
000E49r 2  18             clc
000E4Ar 2  60             rts
000E4Br 2               
000E4Br 2               ; FsCalcNextSec — Calculate next free sector by scanning all directory entries
000E4Br 2               ; Must call FsReadDir first
000E4Br 2               ; Output: FS_NEXT_SEC = first free sector after all used files
000E4Br 2               ; Modifies: Flags, A, X, Y
000E4Br 2               FsCalcNextSec:
000E4Br 2  A9 01          lda #<FS_DATA_START           ; Start with first data sector
000E4Dr 2  8D 4E 03       sta FS_NEXT_SEC
000E50r 2  A9 00          lda #>FS_DATA_START
000E52r 2  8D 4F 03       sta FS_NEXT_SEC + 1
000E55r 2                 ; Scan all entries to find highest used sector + file sector count
000E55r 2  A9 00          lda #<FS_SECTOR_BUF
000E57r 2  85 24          sta CF_BUF_PTR
000E59r 2  A9 06          lda #>FS_SECTOR_BUF
000E5Br 2  85 25          sta CF_BUF_PTR + 1
000E5Dr 2  A2 00          ldx #$00
000E5Fr 2               @FsCalcLoop:
000E5Fr 2  A0 0B          ldy #FS_ENTRY_FLAGS
000E61r 2  B1 24          lda (CF_BUF_PTR),y
000E63r 2  29 01          and #FS_FLAG_USED
000E65r 2  F0 5D          beq @FsCalcNext               ; Skip unused
000E67r 2                 ; Get start sector + ceil(size/512)
000E67r 2  A0 0C          ldy #FS_ENTRY_START
000E69r 2  B1 24          lda (CF_BUF_PTR),y
000E6Br 2  8D 48 03       sta FS_START_SEC
000E6Er 2  C8             iny
000E6Fr 2  B1 24          lda (CF_BUF_PTR),y
000E71r 2  8D 49 03       sta FS_START_SEC + 1
000E74r 2                 ; Get file size
000E74r 2  A0 0E          ldy #FS_ENTRY_FSIZE
000E76r 2  B1 24          lda (CF_BUF_PTR),y
000E78r 2  8D 4A 03       sta FS_FILE_SIZE
000E7Br 2  C8             iny
000E7Cr 2  B1 24          lda (CF_BUF_PTR),y
000E7Er 2  8D 4B 03       sta FS_FILE_SIZE + 1
000E81r 2                 ; Calculate sectors used = (size + 511) / 512 = (size + 511) >> 9
000E81r 2                 ; = (size_hi + 1) if size_lo > 0, else size_hi / 2... simplify:
000E81r 2                 ; sectors = (size >> 9) rounded up = high_byte >> 1, plus 1 if any remainder
000E81r 2  AD 4B 03       lda FS_FILE_SIZE + 1          ; High byte of size
000E84r 2  4A             lsr a                         ; Divide by 2 (each sector = 512 = 2 pages)
000E85r 2  8D 4C 03       sta FS_SEC_COUNT
000E88r 2                 ; Check if there's a remainder (low byte != 0 or high byte bit 0 was set)
000E88r 2  AD 4B 03       lda FS_FILE_SIZE + 1
000E8Br 2  29 01          and #$01                      ; Was high byte odd?
000E8Dr 2  D0 05          bne @FsCalcRound
000E8Fr 2  AD 4A 03       lda FS_FILE_SIZE              ; Low byte non-zero?
000E92r 2  F0 03          beq @FsCalcNoRound
000E94r 2               @FsCalcRound:
000E94r 2  EE 4C 03       inc FS_SEC_COUNT              ; Round up
000E97r 2               @FsCalcNoRound:
000E97r 2                 ; End sector = start + sector count.
000E97r 2                 ; NOTE: X holds the directory-entry loop counter, so the end sector must
000E97r 2                 ; NOT be kept in X (doing so ran the scan off the end of the directory
000E97r 2                 ; buffer into program memory, corrupting FS_NEXT_SEC and causing spurious
000E97r 2                 ; ?SAVE ERROR after a few files).  Stash it in memory scratch instead:
000E97r 2                 ; FS_SEC_COUNT (end low) and FS_DIR_IDX (end high) are both free here.
000E97r 2  AD 48 03       lda FS_START_SEC
000E9Ar 2  18             clc
000E9Br 2  6D 4C 03       adc FS_SEC_COUNT
000E9Er 2  8D 4C 03       sta FS_SEC_COUNT              ; end sector low (reuse as scratch)
000EA1r 2  AD 49 03       lda FS_START_SEC + 1
000EA4r 2  69 00          adc #$00
000EA6r 2  8D 4D 03       sta FS_DIR_IDX               ; end sector high (reuse as scratch)
000EA9r 2                 ; Compare with FS_NEXT_SEC — keep the larger value
000EA9r 2  CD 4F 03       cmp FS_NEXT_SEC + 1
000EACr 2  90 16          bcc @FsCalcNext               ; End high < FS_NEXT_SEC high, skip
000EAEr 2  D0 08          bne @FsCalcUpdate             ; End high > FS_NEXT_SEC high, update
000EB0r 2  AD 4C 03       lda FS_SEC_COUNT
000EB3r 2  CD 4E 03       cmp FS_NEXT_SEC
000EB6r 2  90 0C          bcc @FsCalcNext               ; End low < FS_NEXT_SEC low, skip
000EB8r 2               @FsCalcUpdate:
000EB8r 2  AD 4C 03       lda FS_SEC_COUNT
000EBBr 2  8D 4E 03       sta FS_NEXT_SEC
000EBEr 2  AD 4D 03       lda FS_DIR_IDX
000EC1r 2  8D 4F 03       sta FS_NEXT_SEC + 1
000EC4r 2               @FsCalcNext:
000EC4r 2                 ; Advance CF_BUF_PTR by 32
000EC4r 2  A5 24          lda CF_BUF_PTR
000EC6r 2  18             clc
000EC7r 2  69 20          adc #FS_ENTRY_SIZE
000EC9r 2  85 24          sta CF_BUF_PTR
000ECBr 2  90 02          bcc @FsCalcNoCarry
000ECDr 2  E6 25          inc CF_BUF_PTR + 1
000ECFr 2               @FsCalcNoCarry:
000ECFr 2  E8             inx
000ED0r 2  E0 10          cpx #FS_MAX_FILES
000ED2r 2  D0 8B          bne @FsCalcLoop
000ED4r 2  60             rts
000ED5r 2               
000ED5r 2               ; FsDirectory — Print directory listing of all used entries
000ED5r 2               ; Output via Chrout (respects current IO_MODE)
000ED5r 2               ; Modifies: Flags, A, X, Y
000ED5r 2               FsDirectory:
000ED5r 2  20 rr rr       jsr FsReadDir                 ; Load directory sector
000ED8r 2  90 01          bcc @FsDirStart
000EDAr 2  60             rts                           ; Error reading directory
000EDBr 2               @FsDirStart:
000EDBr 2  20 rr rr       jsr FsPrintDiskImpl           ; Print "DISK n" header
000EDEr 2  A9 00          lda #<FS_SECTOR_BUF
000EE0r 2  85 24          sta CF_BUF_PTR
000EE2r 2  A9 06          lda #>FS_SECTOR_BUF
000EE4r 2  85 25          sta CF_BUF_PTR + 1
000EE6r 2  A2 00          ldx #$00                      ; Entry counter
000EE8r 2               @FsDirLoop:
000EE8r 2  DA             phx
000EE9r 2  A0 0B          ldy #FS_ENTRY_FLAGS
000EEBr 2  B1 24          lda (CF_BUF_PTR),y
000EEDr 2  29 01          and #FS_FLAG_USED
000EEFr 2  F0 3A          beq @FsDirNext                ; Skip unused entries
000EF1r 2                 ; Print filename (8 chars)
000EF1r 2  A0 00          ldy #$00
000EF3r 2               @FsDirName:
000EF3r 2  B1 24          lda (CF_BUF_PTR),y
000EF5r 2  20 rr rr       jsr Chrout
000EF8r 2  C8             iny
000EF9r 2  C0 08          cpy #$08
000EFBr 2  D0 F6          bne @FsDirName
000EFDr 2                 ; Print dot separator
000EFDr 2  A9 2E          lda #'.'
000EFFr 2  20 rr rr       jsr Chrout
000F02r 2                 ; Print extension (3 chars)
000F02r 2               @FsDirExt:
000F02r 2  B1 24          lda (CF_BUF_PTR),y
000F04r 2  20 rr rr       jsr Chrout
000F07r 2  C8             iny
000F08r 2  C0 0B          cpy #$0B
000F0Ar 2  D0 F6          bne @FsDirExt
000F0Cr 2                 ; Print space
000F0Cr 2  A9 20          lda #' '
000F0Er 2  20 rr rr       jsr Chrout
000F11r 2                 ; Print file size in decimal
000F11r 2  A0 0E          ldy #FS_ENTRY_FSIZE
000F13r 2  B1 24          lda (CF_BUF_PTR),y
000F15r 2  8D 4A 03       sta FS_FILE_SIZE
000F18r 2  C8             iny
000F19r 2  B1 24          lda (CF_BUF_PTR),y
000F1Br 2  8D 4B 03       sta FS_FILE_SIZE + 1
000F1Er 2  20 rr rr       jsr FsPrintSize
000F21r 2                 ; Print newline
000F21r 2  A9 0D          lda #$0D
000F23r 2  20 rr rr       jsr Chrout
000F26r 2  A9 0A          lda #$0A
000F28r 2  20 rr rr       jsr Chrout
000F2Br 2               @FsDirNext:
000F2Br 2                 ; Advance CF_BUF_PTR by 32
000F2Br 2  A5 24          lda CF_BUF_PTR
000F2Dr 2  18             clc
000F2Er 2  69 20          adc #FS_ENTRY_SIZE
000F30r 2  85 24          sta CF_BUF_PTR
000F32r 2  90 02          bcc @FsDirNoCarry
000F34r 2  E6 25          inc CF_BUF_PTR + 1
000F36r 2               @FsDirNoCarry:
000F36r 2  FA             plx
000F37r 2  E8             inx
000F38r 2  E0 10          cpx #FS_MAX_FILES
000F3Ar 2  D0 AC          bne @FsDirLoop
000F3Cr 2  60             rts
000F3Dr 2               
000F3Dr 2               ; PrintDecU16 — Print an unsigned 16-bit value as decimal (no leading zeros).
000F3Dr 2               ; General-purpose console output; used by BASIC (line numbers) and available
000F3Dr 2               ; to cartridges.  Shares the FsPrintSize core below.
000F3Dr 2               ; Input : A = value low, X = value high
000F3Dr 2               ; Modifies: Flags, A, X, Y, FS_FILE_SIZE (consumed), FS_DIR_IDX
000F3Dr 2               PrintDecU16Impl:
000F3Dr 2  8D 4A 03       sta FS_FILE_SIZE
000F40r 2  8E 4B 03       stx FS_FILE_SIZE + 1
000F43r 2                 ; fall through to the shared decimal-print core
000F43r 2               ; FsPrintSize — Print 16-bit value in FS_FILE_SIZE as decimal
000F43r 2               ; Modifies: Flags, A, X, Y
000F43r 2               FsPrintSize:
000F43r 2                 ; Convert 16-bit value to decimal digits (up to 5 digits for 0-65535)
000F43r 2                 ; Use successive subtraction of powers of 10
000F43r 2  A2 00          ldx #$00                      ; Digit index / leading zero suppression
000F45r 2  A0 00          ldy #$00                      ; Power-of-10 table index
000F47r 2               @FsPrintSizeLoop:
000F47r 2  A9 2F          lda #'0' - 1                  ; Start character below '0'
000F49r 2  8D 4D 03       sta FS_DIR_IDX                ; Reuse as digit scratch
000F4Cr 2               @FsPrintSub:
000F4Cr 2  EE 4D 03       inc FS_DIR_IDX
000F4Fr 2  AD 4A 03       lda FS_FILE_SIZE
000F52r 2  38             sec
000F53r 2  F9 rr rr       sbc @FsPow10Lo,y
000F56r 2  48             pha
000F57r 2  AD 4B 03       lda FS_FILE_SIZE + 1
000F5Ar 2  F9 rr rr       sbc @FsPow10Hi,y
000F5Dr 2  90 09          bcc @FsPrintSizeDig           ; Underflow — done subtracting
000F5Fr 2  8D 4B 03       sta FS_FILE_SIZE + 1
000F62r 2  68             pla
000F63r 2  8D 4A 03       sta FS_FILE_SIZE
000F66r 2  80 E4          bra @FsPrintSub
000F68r 2               @FsPrintSizeDig:
000F68r 2  68             pla                           ; Discard underflowed low byte
000F69r 2  AD 4D 03       lda FS_DIR_IDX
000F6Cr 2  C9 30          cmp #'0'
000F6Er 2  D0 04          bne @FsPrintSizeOut           ; Non-zero digit
000F70r 2  E0 00          cpx #$00
000F72r 2  F0 04          beq @FsPrintSizeSkip          ; Suppress leading zeros
000F74r 2               @FsPrintSizeOut:
000F74r 2  20 rr rr       jsr Chrout
000F77r 2  E8             inx                           ; Mark that we've printed a digit
000F78r 2               @FsPrintSizeSkip:
000F78r 2  C8             iny
000F79r 2  C0 04          cpy #$04                      ; 4 powers of 10 (10000, 1000, 100, 10)
000F7Br 2  D0 CA          bne @FsPrintSizeLoop
000F7Dr 2                 ; Always print ones digit
000F7Dr 2  AD 4A 03       lda FS_FILE_SIZE
000F80r 2  09 30          ora #'0'                      ; Low byte is 0-9 at this point
000F82r 2  20 rr rr       jsr Chrout
000F85r 2  60             rts
000F86r 2  10 E8 64 0A  @FsPow10Lo: .byte <10000, <1000, <100, <10
000F8Ar 2  27 03 00 00  @FsPow10Hi: .byte >10000, >1000, >100, >10
000F8Er 2               
000F8Er 2               ; FsSetDiskImpl — Select the current CF disk bank
000F8Er 2               ; Input: A = disk number (0-255)
000F8Er 2               ; Modifies: Flags
000F8Er 2               FsSetDiskImpl:
000F8Er 2  8D 0F 03       sta CF_DISK
000F91r 2  60             rts
000F92r 2               
000F92r 2               ; FsGetDiskImpl — Get the current CF disk bank
000F92r 2               ; Output: A = current disk number
000F92r 2               ; Modifies: Flags, A
000F92r 2               FsGetDiskImpl:
000F92r 2  AD 0F 03       lda CF_DISK
000F95r 2  60             rts
000F96r 2               
000F96r 2               ; FsFormatDiskImpl — Zero the current disk's directory sector (erases its file list)
000F96r 2               ; Output: Carry clear = success, Carry set = write error
000F96r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
000F96r 2               FsFormatDiskImpl:
000F96r 2  A9 00          lda #<FS_SECTOR_BUF
000F98r 2  85 24          sta CF_BUF_PTR
000F9Ar 2  A9 06          lda #>FS_SECTOR_BUF
000F9Cr 2  85 25          sta CF_BUF_PTR + 1
000F9Er 2  A0 00          ldy #$00
000FA0r 2  A2 02          ldx #$02                      ; 2 pages = 512 bytes
000FA2r 2  A9 00          lda #$00
000FA4r 2               @FsFormatClr:
000FA4r 2  91 24          sta (CF_BUF_PTR),y
000FA6r 2  C8             iny
000FA7r 2  D0 FB          bne @FsFormatClr
000FA9r 2  E6 25          inc CF_BUF_PTR + 1
000FABr 2  CA             dex
000FACr 2  D0 F6          bne @FsFormatClr
000FAEr 2  4C rr rr       jmp FsWriteDir                ; Write zeroed directory sector (returns carry status)
000FB1r 2               
000FB1r 2               ; FsPrintDiskImpl — Print "DISK n" (decimal) + CRLF via Chrout
000FB1r 2               ; Modifies: Flags, A, X, Y, FS_FILE_SIZE, FS_DIR_IDX
000FB1r 2               FsPrintDiskImpl:
000FB1r 2  A0 00          ldy #$00
000FB3r 2               @FsPDLbl:
000FB3r 2  B9 rr rr       lda FsDiskLbl,y
000FB6r 2  F0 06          beq @FsPDNum
000FB8r 2  20 rr rr       jsr Chrout
000FBBr 2  C8             iny
000FBCr 2  80 F5          bra @FsPDLbl
000FBEr 2               @FsPDNum:
000FBEr 2  AD 0F 03       lda CF_DISK
000FC1r 2  8D 4A 03       sta FS_FILE_SIZE
000FC4r 2  9C 4B 03       stz FS_FILE_SIZE + 1
000FC7r 2  20 rr rr       jsr FsPrintSize               ; Print CF_DISK as decimal (0-255, no leading zeros)
000FCAr 2  A9 0D          lda #$0D
000FCCr 2  20 rr rr       jsr Chrout
000FCFr 2  A9 0A          lda #$0A
000FD1r 2  4C rr rr       jmp Chrout
000FD4r 2  44 49 53 4B  FsDiskLbl: .byte "DISK ", 0
000FD8r 2  20 00        
000FDAr 2               
000FDAr 2               ; FsLoadFileImpl — Load file from CF into PROGRAM_START ($0800)
000FDAr 2               ; Input: STR_PTR ($02-$03) points to null-terminated filename
000FDAr 2               ; Output: Carry clear = success, FS_FILE_SIZE = bytes loaded
000FDAr 2               ;         Carry set = file not found or read error
000FDAr 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
000FDAr 2               FsLoadFileImpl:
000FDAr 2  A9 00          lda #<PROGRAM_START           ; Default target = PROGRAM_START
000FDCr 2  8D 7F 03       sta FS_IO_ADDR
000FDFr 2  A9 08          lda #>PROGRAM_START
000FE1r 2  8D 80 03       sta FS_IO_ADDR + 1
000FE4r 2               ; FsLoadFileAddrImpl — Load named file to FS_IO_ADDR (caller preset)
000FE4r 2               ; Input: STR_PTR = filename, FS_IO_ADDR = destination address
000FE4r 2               FsLoadFileAddrImpl:
000FE4r 2  20 rr rr       jsr FsOpenFile
000FE7r 2  B0 22          bcs @FsLoadErr
000FE9r 2                 ; Set destination pointer from FS_IO_ADDR
000FE9r 2  AD 7F 03       lda FS_IO_ADDR
000FECr 2  85 24          sta CF_BUF_PTR
000FEEr 2  AD 80 03       lda FS_IO_ADDR + 1
000FF1r 2  85 25          sta CF_BUF_PTR + 1
000FF3r 2                 ; Read sectors
000FF3r 2  AE 4C 03       ldx FS_SEC_COUNT
000FF6r 2  F0 10          beq @FsLoadOk                 ; Zero-size file
000FF8r 2               @FsLoadSec:
000FF8r 2  DA             phx
000FF9r 2  20 rr rr       jsr StReadSector              ; Read sector (advances CF_BUF_PTR by 512)
000FFCr 2  B0 0C          bcs @FsLoadSecErr
000FFEr 2                 ; Increment LBA
000FFEr 2  E6 26          inc CF_LBA
001000r 2  D0 02          bne @FsLoadSecNext
001002r 2  E6 27          inc CF_LBA + 1
001004r 2               @FsLoadSecNext:
001004r 2  FA             plx
001005r 2  CA             dex
001006r 2  D0 F0          bne @FsLoadSec
001008r 2               @FsLoadOk:
001008r 2  18             clc
001009r 2  60             rts
00100Ar 2               @FsLoadSecErr:
00100Ar 2  FA             plx                           ; Balance stack
00100Br 2               @FsLoadErr:
00100Br 2  38             sec
00100Cr 2  60             rts
00100Dr 2               
00100Dr 2               ; VdpLoadFile — Load a named file from the current disk into VRAM
00100Dr 2               ; Streams the file through port A to FS_IO_ADDR, anywhere in the 64 KB, and
00100Dr 2               ; writes exactly its FS_FILE_SIZE bytes: the rest of the last sector is read
00100Dr 2               ; and dropped, so a table loaded here cannot spill into the one after it.
00100Dr 2               ; Input: STR_PTR = filename, FS_IO_ADDR = VRAM address
00100Dr 2               ; Output: Carry clear = loaded, FS_FILE_SIZE = bytes written
00100Dr 2               ;         Carry set = no video card (nothing read), or not found or read error
00100Dr 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR, XFER_REMAIN, FS_SECTOR_BUF
00100Dr 2               VdpLoadFileImpl:
00100Dr 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
001010r 2  30 02          bmi @VdpLoadFileCard
001012r 2  38             sec
001013r 2  60             rts
001014r 2               @VdpLoadFileCard:
001014r 2  20 rr rr       jsr FsOpenFile
001017r 2  B0 5B          bcs @VdpLoadFileDone
001019r 2  AD 4A 03       lda FS_FILE_SIZE              ; Bytes still to write
00101Cr 2  8D 17 03       sta XFER_REMAIN
00101Fr 2  AD 4B 03       lda FS_FILE_SIZE + 1
001022r 2  8D 18 03       sta XFER_REMAIN + 1
001025r 2  AE 7F 03       ldx FS_IO_ADDR
001028r 2  AC 80 03       ldy FS_IO_ADDR + 1
00102Br 2  A9 40          lda #$40                      ; Write
00102Dr 2  20 rr rr       jsr VdpAddress
001030r 2               @VdpLoadFileSector:
001030r 2  AD 17 03       lda XFER_REMAIN
001033r 2  0D 18 03       ora XFER_REMAIN + 1
001036r 2  F0 3B          beq @VdpLoadFileOk            ; Written them all: no more sectors to read
001038r 2  A9 00          lda #<FS_SECTOR_BUF
00103Ar 2  85 24          sta CF_BUF_PTR
00103Cr 2  A9 06          lda #>FS_SECTOR_BUF
00103Er 2  85 25          sta CF_BUF_PTR + 1
001040r 2  20 rr rr       jsr StReadSector
001043r 2  B0 2F          bcs @VdpLoadFileDone
001045r 2  E6 26          inc CF_LBA
001047r 2  D0 02          bne @VdpLoadFileCopy
001049r 2  E6 27          inc CF_LBA + 1
00104Br 2               @VdpLoadFileCopy:
00104Br 2  C6 25          dec CF_BUF_PTR + 1            ; StReadSector left it 512 bytes on
00104Dr 2  C6 25          dec CF_BUF_PTR + 1
00104Fr 2  A0 00          ldy #$00
001051r 2               @VdpLoadFileByte:
001051r 2  AD 17 03       lda XFER_REMAIN
001054r 2  D0 08          bne @VdpLoadFileCount
001056r 2  AD 18 03       lda XFER_REMAIN + 1
001059r 2  F0 18          beq @VdpLoadFileOk            ; The file ends inside this sector
00105Br 2  CE 18 03       dec XFER_REMAIN + 1
00105Er 2               @VdpLoadFileCount:
00105Er 2  CE 17 03       dec XFER_REMAIN
001061r 2  B1 24          lda (CF_BUF_PTR),y
001063r 2  8D 00 9C       sta VC_DATA
001066r 2  C8             iny
001067r 2  D0 E8          bne @VdpLoadFileByte
001069r 2  E6 25          inc CF_BUF_PTR + 1            ; The sector's second page
00106Br 2  A5 25          lda CF_BUF_PTR + 1
00106Dr 2  C9 08          cmp #>(FS_SECTOR_BUF + 512)
00106Fr 2  D0 E0          bne @VdpLoadFileByte
001071r 2  80 BD          bra @VdpLoadFileSector
001073r 2               @VdpLoadFileOk:
001073r 2  18             clc
001074r 2               @VdpLoadFileDone:
001074r 2  60             rts
001075r 2               
001075r 2               ; FsOpenFile — Find a named file and get ready to read it
001075r 2               ; Shared by FsLoadFileAddr and VdpLoadFile.
001075r 2               ; Input: STR_PTR = filename
001075r 2               ; Output: Carry clear = found: FS_FILE_SIZE = its size, FS_SEC_COUNT = the
001075r 2               ;         sectors it spans, CF_LBA = its first sector
001075r 2               ;         Carry set = not found or read error
001075r 2               ; Modifies: Flags, A, X, Y, CF_BUF_PTR, FS_START_SEC
001075r 2               FsOpenFile:
001075r 2  20 rr rr       jsr FsParseName               ; Parse filename into FS_FNAME_BUF
001078r 2  20 rr rr       jsr FsReadDir                 ; Read directory sector
00107Br 2  B0 44          bcs @FsOpenDone
00107Dr 2  20 rr rr       jsr FsFindFile                ; Search for filename
001080r 2  B0 3F          bcs @FsOpenDone               ; Not found
001082r 2                 ; Read file metadata from entry
001082r 2  A0 0C          ldy #FS_ENTRY_START
001084r 2  B1 24          lda (CF_BUF_PTR),y
001086r 2  8D 48 03       sta FS_START_SEC
001089r 2  C8             iny
00108Ar 2  B1 24          lda (CF_BUF_PTR),y
00108Cr 2  8D 49 03       sta FS_START_SEC + 1
00108Fr 2  A0 0E          ldy #FS_ENTRY_FSIZE
001091r 2  B1 24          lda (CF_BUF_PTR),y
001093r 2  8D 4A 03       sta FS_FILE_SIZE
001096r 2  C8             iny
001097r 2  B1 24          lda (CF_BUF_PTR),y
001099r 2  8D 4B 03       sta FS_FILE_SIZE + 1
00109Cr 2                 ; Calculate number of sectors to read
00109Cr 2  AD 4B 03       lda FS_FILE_SIZE + 1
00109Fr 2  4A             lsr a
0010A0r 2  8D 4C 03       sta FS_SEC_COUNT
0010A3r 2  AD 4B 03       lda FS_FILE_SIZE + 1
0010A6r 2  29 01          and #$01
0010A8r 2  D0 05          bne @FsLoadRound
0010AAr 2  AD 4A 03       lda FS_FILE_SIZE
0010ADr 2  F0 03          beq @FsLoadNoRound
0010AFr 2               @FsLoadRound:
0010AFr 2  EE 4C 03       inc FS_SEC_COUNT
0010B2r 2               @FsLoadNoRound:
0010B2r 2                 ; Set up LBA starting at file's start sector
0010B2r 2  AD 48 03       lda FS_START_SEC
0010B5r 2  85 26          sta CF_LBA
0010B7r 2  AD 49 03       lda FS_START_SEC + 1
0010BAr 2  85 27          sta CF_LBA + 1
0010BCr 2  64 28          stz CF_LBA + 2
0010BEr 2  64 29          stz CF_LBA + 3
0010C0r 2  18             clc
0010C1r 2               @FsOpenDone:
0010C1r 2  60             rts
0010C2r 2               
0010C2r 2               ; FsSaveFileImpl — Save data from PROGRAM_START to CF
0010C2r 2               ; Input: STR_PTR ($02-$03) points to null-terminated filename
0010C2r 2               ;        FS_FILE_SIZE ($034A-$034B) = number of bytes to save
0010C2r 2               ; Output: Carry clear = success, Carry set = error (directory full or write error)
0010C2r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
0010C2r 2               FsSaveFileImpl:
0010C2r 2  A9 00          lda #<PROGRAM_START           ; Default source = PROGRAM_START
0010C4r 2  8D 7F 03       sta FS_IO_ADDR
0010C7r 2  A9 08          lda #>PROGRAM_START
0010C9r 2  8D 80 03       sta FS_IO_ADDR + 1
0010CCr 2               ; FsSaveFileAddrImpl — Save FS_FILE_SIZE bytes from FS_IO_ADDR to named file
0010CCr 2               ; Input: STR_PTR = filename, FS_IO_ADDR = source address, FS_FILE_SIZE = byte count
0010CCr 2               FsSaveFileAddrImpl:
0010CCr 2  20 rr rr       jsr FsParseName               ; Parse filename into FS_FNAME_BUF
0010CFr 2  20 rr rr       jsr FsReadDir                 ; Read directory sector
0010D2r 2  90 03          bcc @FsSaveReadOk
0010D4r 2  4C rr rr       jmp @FsSaveErr
0010D7r 2               @FsSaveReadOk:
0010D7r 2                 ; Try to find existing file with same name
0010D7r 2  20 rr rr       jsr FsFindFile
0010DAr 2  90 08          bcc @FsSaveOverwrite
0010DCr 2                 ; Not found — find a free slot
0010DCr 2  20 rr rr       jsr FsFindFree
0010DFr 2  90 11          bcc @FsSaveAlloc
0010E1r 2  4C rr rr       jmp @FsSaveErr                ; Directory full
0010E4r 2               @FsSaveOverwrite:
0010E4r 2                 ; CF_BUF_PTR already points to the existing entry — clear old flags
0010E4r 2  A0 0B          ldy #FS_ENTRY_FLAGS
0010E6r 2  A9 00          lda #$00
0010E8r 2  91 24          sta (CF_BUF_PTR),y            ; Mark old entry as free
0010EAr 2                 ; Find a free slot (could be the one we just freed or another)
0010EAr 2  20 rr rr       jsr FsFindFree
0010EDr 2  90 03          bcc @FsSaveAlloc
0010EFr 2  4C rr rr       jmp @FsSaveErr
0010F2r 2               @FsSaveAlloc:
0010F2r 2                 ; Save CF_BUF_PTR (points to free entry from FsFindFree)
0010F2r 2  A5 24          lda CF_BUF_PTR
0010F4r 2  48             pha
0010F5r 2  A5 25          lda CF_BUF_PTR + 1
0010F7r 2  48             pha
0010F8r 2                 ; Save FS_FILE_SIZE (FsCalcNextSec clobbers it while scanning entries)
0010F8r 2  AD 4A 03       lda FS_FILE_SIZE
0010FBr 2  48             pha
0010FCr 2  AD 4B 03       lda FS_FILE_SIZE + 1
0010FFr 2  48             pha
001100r 2                 ; Calculate next free sector (clobbers CF_BUF_PTR and FS_FILE_SIZE)
001100r 2  20 rr rr       jsr FsCalcNextSec
001103r 2                 ; Restore FS_FILE_SIZE
001103r 2  68             pla
001104r 2  8D 4B 03       sta FS_FILE_SIZE + 1
001107r 2  68             pla
001108r 2  8D 4A 03       sta FS_FILE_SIZE
00110Br 2                 ; Restore CF_BUF_PTR to the free directory entry
00110Br 2  68             pla
00110Cr 2  85 25          sta CF_BUF_PTR + 1
00110Er 2  68             pla
00110Fr 2  85 24          sta CF_BUF_PTR
001111r 2                 ; Calculate sectors needed
001111r 2  AD 4B 03       lda FS_FILE_SIZE + 1
001114r 2  4A             lsr a
001115r 2  8D 4C 03       sta FS_SEC_COUNT
001118r 2  AD 4B 03       lda FS_FILE_SIZE + 1
00111Br 2  29 01          and #$01
00111Dr 2  D0 05          bne @FsSaveRound
00111Fr 2  AD 4A 03       lda FS_FILE_SIZE
001122r 2  F0 03          beq @FsSaveNoRound
001124r 2               @FsSaveRound:
001124r 2  EE 4C 03       inc FS_SEC_COUNT
001127r 2               @FsSaveNoRound:
001127r 2                 ; Disk-full guard: reject if the file would spill past this disk's region.
001127r 2                 ; end sector = FS_NEXT_SEC + FS_SEC_COUNT must be <= FS_DISK_SECTORS.
001127r 2  AD 4E 03       lda FS_NEXT_SEC
00112Ar 2  18             clc
00112Br 2  6D 4C 03       adc FS_SEC_COUNT
00112Er 2  A8             tay                           ; Y = end sector low
00112Fr 2  AD 4F 03       lda FS_NEXT_SEC + 1
001132r 2  69 00          adc #$00                      ; A = end sector high
001134r 2  C9 08          cmp #>FS_DISK_SECTORS
001136r 2  90 08          bcc @FsSaveSpaceOk            ; end high < high(FS_DISK_SECTORS) -> fits
001138r 2  D0 03          bne @FsSaveDiskFull           ; end high > high(FS_DISK_SECTORS) -> full
00113Ar 2  98             tya                           ; end high equal: OK only if end low == 0
00113Br 2  F0 03          beq @FsSaveSpaceOk
00113Dr 2               @FsSaveDiskFull:
00113Dr 2  4C rr rr       jmp @FsSaveErr                ; Disk full
001140r 2               @FsSaveSpaceOk:
001140r 2                 ; Fill in directory entry at CF_BUF_PTR
001140r 2                 ; Copy filename (11 bytes)
001140r 2  A0 00          ldy #$00
001142r 2               @FsSaveCopyName:
001142r 2  B9 50 03       lda FS_FNAME_BUF,y
001145r 2  91 24          sta (CF_BUF_PTR),y
001147r 2  C8             iny
001148r 2  C0 0B          cpy #11
00114Ar 2  D0 F6          bne @FsSaveCopyName
00114Cr 2                 ; Set flags = in use
00114Cr 2  A9 01          lda #FS_FLAG_USED
00114Er 2  91 24          sta (CF_BUF_PTR),y            ; Y = 11 = FS_ENTRY_FLAGS
001150r 2                 ; Set start sector
001150r 2  A0 0C          ldy #FS_ENTRY_START
001152r 2  AD 4E 03       lda FS_NEXT_SEC
001155r 2  91 24          sta (CF_BUF_PTR),y
001157r 2  8D 48 03       sta FS_START_SEC
00115Ar 2  C8             iny
00115Br 2  AD 4F 03       lda FS_NEXT_SEC + 1
00115Er 2  91 24          sta (CF_BUF_PTR),y
001160r 2  8D 49 03       sta FS_START_SEC + 1
001163r 2                 ; Set file size
001163r 2  A0 0E          ldy #FS_ENTRY_FSIZE
001165r 2  AD 4A 03       lda FS_FILE_SIZE
001168r 2  91 24          sta (CF_BUF_PTR),y
00116Ar 2  C8             iny
00116Br 2  AD 4B 03       lda FS_FILE_SIZE + 1
00116Er 2  91 24          sta (CF_BUF_PTR),y
001170r 2                 ; Clear reserved bytes
001170r 2  A0 10          ldy #$10
001172r 2  A9 00          lda #$00
001174r 2               @FsSaveClearRsv:
001174r 2  91 24          sta (CF_BUF_PTR),y
001176r 2  C8             iny
001177r 2  C0 20          cpy #FS_ENTRY_SIZE
001179r 2  D0 F9          bne @FsSaveClearRsv
00117Br 2                 ; Write updated directory back to CF
00117Br 2  20 rr rr       jsr FsWriteDir
00117Er 2  B0 30          bcs @FsSaveErr
001180r 2                 ; Now write file data sectors
001180r 2  AD 48 03       lda FS_START_SEC
001183r 2  85 26          sta CF_LBA
001185r 2  AD 49 03       lda FS_START_SEC + 1
001188r 2  85 27          sta CF_LBA + 1
00118Ar 2  64 28          stz CF_LBA + 2
00118Cr 2  64 29          stz CF_LBA + 3
00118Er 2                 ; Source = FS_IO_ADDR
00118Er 2  AD 7F 03       lda FS_IO_ADDR
001191r 2  85 24          sta CF_BUF_PTR
001193r 2  AD 80 03       lda FS_IO_ADDR + 1
001196r 2  85 25          sta CF_BUF_PTR + 1
001198r 2  AE 4C 03       ldx FS_SEC_COUNT
00119Br 2  F0 10          beq @FsSaveOk                 ; Zero-size file
00119Dr 2               @FsSaveSec:
00119Dr 2  DA             phx
00119Er 2  20 rr rr       jsr StWriteSector             ; Write sector (advances CF_BUF_PTR by 512)
0011A1r 2  B0 0C          bcs @FsSaveSecErr
0011A3r 2                 ; Increment LBA
0011A3r 2  E6 26          inc CF_LBA
0011A5r 2  D0 02          bne @FsSaveSecNext
0011A7r 2  E6 27          inc CF_LBA + 1
0011A9r 2               @FsSaveSecNext:
0011A9r 2  FA             plx
0011AAr 2  CA             dex
0011ABr 2  D0 F0          bne @FsSaveSec
0011ADr 2               @FsSaveOk:
0011ADr 2  18             clc
0011AEr 2  60             rts
0011AFr 2               @FsSaveSecErr:
0011AFr 2  FA             plx                           ; Balance stack
0011B0r 2               @FsSaveErr:
0011B0r 2  38             sec
0011B1r 2  60             rts
0011B2r 2               
0011B2r 2               ; FsDeleteFile — Delete a file from the CompactFlash filesystem
0011B2r 2               ; Input: STR_PTR ($02-$03) points to null-terminated filename
0011B2r 2               ; Output: Carry clear = success, Carry set = file not found or error
0011B2r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
0011B2r 2               FsDeleteFileImpl:
0011B2r 2  20 rr rr       jsr FsParseName               ; Parse filename into FS_FNAME_BUF
0011B5r 2  20 rr rr       jsr FsReadDir                 ; Read directory sector
0011B8r 2  B0 0F          bcs @FsDelErr
0011BAr 2  20 rr rr       jsr FsFindFile                ; Search for filename
0011BDr 2  B0 0A          bcs @FsDelErr                 ; Not found
0011BFr 2                 ; Clear the flags byte to mark entry as unused
0011BFr 2  A0 0B          ldy #FS_ENTRY_FLAGS
0011C1r 2  A9 00          lda #$00
0011C3r 2  91 24          sta (CF_BUF_PTR),y
0011C5r 2                 ; Write updated directory back to CF
0011C5r 2  20 rr rr       jsr FsWriteDir
0011C8r 2                 ; Carry already set/clear from FsWriteDir
0011C8r 2  60             rts
0011C9r 2               @FsDelErr:
0011C9r 2  38             sec
0011CAr 2  60             rts
0011CBr 2               
0011CBr 2               ; === XModem Serial LOAD/SAVE ===
0011CBr 2               ; Standard XModem protocol over serial (128-byte blocks, checksum)
0011CBr 2               ; Load: receives blocks into memory at caller-supplied XFER_PTR
0011CBr 2               ; Save: sends blocks from memory at caller-supplied XFER_PTR / XFER_REMAIN
0011CBr 2               
0011CBr 2               ; --- Shared XModem Utilities ---
0011CBr 2               
0011CBr 2               ; XModemGetByte — Read one byte from serial with timeout
0011CBr 2               ; Polls SC_STATUS for RDRF directly (bypasses IRQ-driven buffer).
0011CBr 2               ; Caller must disable serial RX IRQ before calling.
0011CBr 2               ; Output: A = byte received, Carry clear = got byte
0011CBr 2               ;         Carry set = timeout
0011CBr 2               ; Preserves: X, Y
0011CBr 2               XModemGetByte:
0011CBr 2  DA             phx
0011CCr 2  5A             phy
0011CDr 2  A2 00          ldx #$00                      ; Outer loop: 256 passes
0011CFr 2               @Outer:
0011CFr 2  A0 00          ldy #$00                      ; Inner loop: 256 polls
0011D1r 2               @Inner:
0011D1r 2  AD 01 90       lda SC_STATUS
0011D4r 2  29 08          and #SC_STATUS_RDRF           ; Received byte waiting?
0011D6r 2  D0 0A          bne @Got
0011D8r 2  88             dey
0011D9r 2  D0 F6          bne @Inner
0011DBr 2  CA             dex
0011DCr 2  D0 F1          bne @Outer
0011DEr 2                 ; Timeout
0011DEr 2  7A             ply
0011DFr 2  FA             plx
0011E0r 2  38             sec
0011E1r 2  60             rts
0011E2r 2               @Got:
0011E2r 2  AD 00 90       lda SC_DATA                   ; Read received byte (clears RDRF)
0011E5r 2  7A             ply
0011E6r 2  FA             plx
0011E7r 2  18             clc
0011E8r 2  60             rts
0011E9r 2               
0011E9r 2               ; XModemPurge — Drain all pending bytes from input buffer and hardware
0011E9r 2               ; Modifies: A, X
0011E9r 2               XModemPurge:
0011E9r 2                 ; Drain software input buffer (bytes captured before IRQ was disabled)
0011E9r 2               @DrainBuf:
0011E9r 2  20 rr rr       jsr BufferSize
0011ECr 2  F0 05          beq @DrainHw
0011EEr 2  20 rr rr       jsr ReadBuffer
0011F1r 2  80 F6          bra @DrainBuf
0011F3r 2               @DrainHw:
0011F3r 2                 ; Drain hardware RDRF
0011F3r 2  AD 01 90       lda SC_STATUS
0011F6r 2  29 08          and #SC_STATUS_RDRF
0011F8r 2  F0 05          beq @Done
0011FAr 2  AD 00 90       lda SC_DATA                   ; Read and discard
0011FDr 2  80 F4          bra @DrainHw
0011FFr 2               @Done:
0011FFr 2  60             rts
001200r 2               
001200r 2               ; --- XModem Load (Receive) ---
001200r 2               
001200r 2               ; XModemLoadImpl — Receive data via standard XModem protocol
001200r 2               ; Input: XFER_PTR = destination address (set by caller)
001200r 2               ; Output: Carry clear = success, XFER_PTR past last byte written
001200r 2               ;         XFER_REMAIN = total bytes received
001200r 2               ;         Carry set = transfer failed
001200r 2               ; Modifies: Flags, A, X, Y
001200r 2               XModemLoadImpl:
001200r 2                 ; Save and switch IO_MODE to serial
001200r 2  AD 06 03       lda IO_MODE
001203r 2  8D 19 03       sta XFER_IO_SAVE
001206r 2  A9 01          lda #$01
001208r 2  8D 06 03       sta IO_MODE
00120Br 2                 ; Disable serial RX IRQ — XModem polls SC_STATUS directly
00120Br 2  A9 0B          lda #$0B                      ; Bit 1 set = RX IRQ disabled, RTSB low, DTR
00120Dr 2  8D 02 90       sta SC_CMD
001210r 2                 ; Initialize
001210r 2  A9 01          lda #$01
001212r 2  85 36          sta XMODEM_BLK                ; First expected block number
001214r 2  9C 17 03       stz XFER_REMAIN
001217r 2  9C 18 03       stz XFER_REMAIN + 1
00121Ar 2  A9 3C          lda #XMODEM_STARTRETRY
00121Cr 2  85 38          sta XMODEM_RETRY
00121Er 2                 ; Print status message so user can start the terminal send
00121Er 2  A2 00          ldx #0
001220r 2               @PrintMsg:
001220r 2  BD rr rr       lda XModemStrReceive,x
001223r 2  F0 06          beq @PrintDone
001225r 2  20 rr rr       jsr Chrout
001228r 2  E8             inx
001229r 2  80 F5          bra @PrintMsg
00122Br 2               @PrintDone:
00122Br 2  20 rr rr       jsr XModemPurge               ; Drain stale bytes
00122Er 2                 ; Send initial NAK to start transfer
00122Er 2  A9 15          lda #XMODEM_NAK
001230r 2  20 rr rr       jsr SerialChrout
001233r 2               @RecvWait:
001233r 2  20 rr rr       jsr XModemGetByte
001236r 2  B0 0E          bcs @RecvTimeout
001238r 2  C9 01          cmp #XMODEM_SOH
00123Ar 2  F0 3E          beq @RecvBlock
00123Cr 2  C9 04          cmp #XMODEM_EOT
00123Er 2  F0 11          beq @RecvEOT
001240r 2  C9 18          cmp #XMODEM_CAN
001242r 2  F0 1F          beq @RecvFail
001244r 2  80 ED          bra @RecvWait                 ; Ignore unknown bytes
001246r 2               
001246r 2               @RecvTimeout:
001246r 2  C6 38          dec XMODEM_RETRY
001248r 2  F0 19          beq @RecvFail
00124Ar 2  A9 15          lda #XMODEM_NAK
00124Cr 2  20 rr rr       jsr SerialChrout
00124Fr 2  80 E2          bra @RecvWait
001251r 2               
001251r 2               @RecvEOT:
001251r 2  A9 06          lda #XMODEM_ACK
001253r 2  20 rr rr       jsr SerialChrout
001256r 2                 ; Re-enable serial RX IRQ
001256r 2  A9 09          lda #$09
001258r 2  8D 02 90       sta SC_CMD
00125Br 2  AD 19 03       lda XFER_IO_SAVE
00125Er 2  8D 06 03       sta IO_MODE
001261r 2  18             clc                           ; Success
001262r 2  60             rts
001263r 2               
001263r 2               @RecvFail:
001263r 2  A9 18          lda #XMODEM_CAN
001265r 2  20 rr rr       jsr SerialChrout
001268r 2  A9 18          lda #XMODEM_CAN
00126Ar 2  20 rr rr       jsr SerialChrout
00126Dr 2                 ; Re-enable serial RX IRQ
00126Dr 2  A9 09          lda #$09
00126Fr 2  8D 02 90       sta SC_CMD
001272r 2  AD 19 03       lda XFER_IO_SAVE
001275r 2  8D 06 03       sta IO_MODE
001278r 2  38             sec                           ; Failure
001279r 2  60             rts
00127Ar 2               
00127Ar 2               @RecvBlock:
00127Ar 2                 ; Reset retry counter on SOH received
00127Ar 2  A9 0A          lda #XMODEM_MAXRETRY
00127Cr 2  85 38          sta XMODEM_RETRY
00127Er 2                 ; Read block number
00127Er 2  20 rr rr       jsr XModemGetByte
001281r 2  B0 6B          bcs @RecvNAK
001283r 2  85 39          sta XMODEM_RCVBLK
001285r 2                 ; Read complement
001285r 2  20 rr rr       jsr XModemGetByte
001288r 2  B0 64          bcs @RecvNAK
00128Ar 2                 ; Verify block# + complement = $FF
00128Ar 2  18             clc
00128Br 2  65 39          adc XMODEM_RCVBLK
00128Dr 2  C9 FF          cmp #$FF
00128Fr 2  D0 5D          bne @RecvNAK
001291r 2                 ; Receive 128 data bytes into (XFER_PTR), accumulate checksum
001291r 2  64 37          stz XMODEM_CHK
001293r 2  A0 00          ldy #$00
001295r 2               @RecvData:
001295r 2  20 rr rr       jsr XModemGetByte             ; A = byte (X/Y preserved)
001298r 2  B0 54          bcs @RecvNAK
00129Ar 2  91 2A          sta (XFER_PTR),y              ; Write to destination at offset Y
00129Cr 2  18             clc
00129Dr 2  65 37          adc XMODEM_CHK
00129Fr 2  85 37          sta XMODEM_CHK
0012A1r 2  C8             iny
0012A2r 2  C0 80          cpy #XMODEM_BLKSZ
0012A4r 2  D0 EF          bne @RecvData
0012A6r 2                 ; Read and verify checksum
0012A6r 2  20 rr rr       jsr XModemGetByte
0012A9r 2  B0 43          bcs @RecvNAK
0012ABr 2  C5 37          cmp XMODEM_CHK
0012ADr 2  D0 3F          bne @RecvNAK
0012AFr 2                 ; Verify block number matches expected
0012AFr 2  A5 39          lda XMODEM_RCVBLK
0012B1r 2  C5 36          cmp XMODEM_BLK
0012B3r 2  D0 28          bne @RecvDupChk
0012B5r 2                 ; Good block — advance pointer by 128
0012B5r 2  18             clc
0012B6r 2  A5 2A          lda XFER_PTR
0012B8r 2  69 80          adc #XMODEM_BLKSZ
0012BAr 2  85 2A          sta XFER_PTR
0012BCr 2  A5 2B          lda XFER_PTR + 1
0012BEr 2  69 00          adc #$00
0012C0r 2  85 2B          sta XFER_PTR + 1
0012C2r 2                 ; Update total bytes received
0012C2r 2  18             clc
0012C3r 2  AD 17 03       lda XFER_REMAIN
0012C6r 2  69 80          adc #XMODEM_BLKSZ
0012C8r 2  8D 17 03       sta XFER_REMAIN
0012CBr 2  AD 18 03       lda XFER_REMAIN + 1
0012CEr 2  69 00          adc #$00
0012D0r 2  8D 18 03       sta XFER_REMAIN + 1
0012D3r 2                 ; Increment expected block number (wraps 255→0)
0012D3r 2  E6 36          inc XMODEM_BLK
0012D5r 2                 ; ACK the block
0012D5r 2  A9 06          lda #XMODEM_ACK
0012D7r 2  20 rr rr       jsr SerialChrout
0012DAr 2  4C rr rr       jmp @RecvWait
0012DDr 2               
0012DDr 2               @RecvDupChk:
0012DDr 2                 ; Check if this is a retransmit of the previous block (lost ACK)
0012DDr 2  A5 36          lda XMODEM_BLK
0012DFr 2  38             sec
0012E0r 2  E9 01          sbc #$01
0012E2r 2  C5 39          cmp XMODEM_RCVBLK
0012E4r 2  D0 08          bne @RecvNAK                  ; Not a dup — NAK
0012E6r 2                 ; Duplicate — re-ACK without advancing
0012E6r 2  A9 06          lda #XMODEM_ACK
0012E8r 2  20 rr rr       jsr SerialChrout
0012EBr 2  4C rr rr       jmp @RecvWait
0012EEr 2               
0012EEr 2               @RecvNAK:
0012EEr 2  20 rr rr       jsr XModemPurge               ; Drain any remaining bytes
0012F1r 2  A9 15          lda #XMODEM_NAK
0012F3r 2  20 rr rr       jsr SerialChrout
0012F6r 2  4C rr rr       jmp @RecvWait
0012F9r 2               
0012F9r 2               ; --- XModem Save (Send) ---
0012F9r 2               
0012F9r 2               ; XModemSaveImpl — Send data via standard XModem protocol
0012F9r 2               ; Input: XFER_PTR = source address, XFER_REMAIN = byte count (set by caller)
0012F9r 2               ; Output: Carry clear = success, Carry set = transfer failed
0012F9r 2               ; Modifies: Flags, A, X, Y
0012F9r 2               XModemSaveImpl:
0012F9r 2                 ; Save and switch IO_MODE to serial
0012F9r 2  AD 06 03       lda IO_MODE
0012FCr 2  8D 19 03       sta XFER_IO_SAVE
0012FFr 2  A9 01          lda #$01
001301r 2  8D 06 03       sta IO_MODE
001304r 2                 ; Disable serial RX IRQ — XModem polls SC_STATUS directly
001304r 2  A9 0B          lda #$0B                      ; Bit 1 set = RX IRQ disabled, RTSB low, DTR
001306r 2  8D 02 90       sta SC_CMD
001309r 2                 ; Initialize
001309r 2  A9 01          lda #$01
00130Br 2  85 36          sta XMODEM_BLK                ; First block number
00130Dr 2  A9 3C          lda #XMODEM_STARTRETRY
00130Fr 2  85 38          sta XMODEM_RETRY
001311r 2                 ; Print status message so user can start the terminal receive
001311r 2  A2 00          ldx #0
001313r 2               @PrintMsg:
001313r 2  BD rr rr       lda XModemStrSend,x
001316r 2  F0 06          beq @PrintDone
001318r 2  20 rr rr       jsr Chrout
00131Br 2  E8             inx
00131Cr 2  80 F5          bra @PrintMsg
00131Er 2               @PrintDone:
00131Er 2  20 rr rr       jsr XModemPurge               ; Drain stale bytes
001321r 2                 ; Wait for initial NAK (or 'C' for CRC mode) from receiver
001321r 2               @SendWaitNAK:
001321r 2  20 rr rr       jsr XModemGetByte
001324r 2  B0 11          bcs @SendInitTO
001326r 2  C9 15          cmp #XMODEM_NAK
001328r 2  F0 16          beq @SendLoop
00132Ar 2  C9 43          cmp #'C'                      ; CRC mode request — treat as NAK (send checksum packets)
00132Cr 2  F0 12          beq @SendLoop
00132Er 2  C9 18          cmp #XMODEM_CAN
001330r 2  D0 03          bne :+
001332r 2  4C rr rr       jmp @SendFail
001335r 2  80 EA        : bra @SendWaitNAK
001337r 2               
001337r 2               @SendInitTO:
001337r 2  C6 38          dec XMODEM_RETRY
001339r 2  D0 03          bne :+
00133Br 2  4C rr rr       jmp @SendFail
00133Er 2  80 E1        : bra @SendWaitNAK
001340r 2               
001340r 2               @SendLoop:
001340r 2                 ; Check if any data remains to send
001340r 2  AD 17 03       lda XFER_REMAIN
001343r 2  0D 18 03       ora XFER_REMAIN + 1
001346r 2  D0 03          bne :+
001348r 2  4C rr rr       jmp @SendEOT                  ; All data sent
00134Br 2               :
00134Br 2                 ; Reset retry counter for this block
00134Br 2  A9 0A          lda #XMODEM_MAXRETRY
00134Dr 2  85 38          sta XMODEM_RETRY
00134Fr 2               @SendBlock:
00134Fr 2                 ; Save XFER_PTR and XFER_REMAIN on stack for retry
00134Fr 2  A5 2B          lda XFER_PTR + 1
001351r 2  48             pha
001352r 2  A5 2A          lda XFER_PTR
001354r 2  48             pha
001355r 2  AD 18 03       lda XFER_REMAIN + 1
001358r 2  48             pha
001359r 2  AD 17 03       lda XFER_REMAIN
00135Cr 2  48             pha
00135Dr 2                 ; Send header: SOH, block#, ~block#
00135Dr 2  A9 01          lda #XMODEM_SOH
00135Fr 2  20 rr rr       jsr SerialChrout
001362r 2  A5 36          lda XMODEM_BLK
001364r 2  20 rr rr       jsr SerialChrout
001367r 2  49 FF          eor #$FF
001369r 2  20 rr rr       jsr SerialChrout
00136Cr 2                 ; Send 128 data bytes, computing checksum
00136Cr 2  64 37          stz XMODEM_CHK
00136Er 2  A0 00          ldy #$00                      ; Y=0 for (XFER_PTR),y indirect addressing
001370r 2  A2 80          ldx #XMODEM_BLKSZ             ; X = byte counter (128 down to 0)
001372r 2               @SendData:
001372r 2  AD 17 03       lda XFER_REMAIN
001375r 2  0D 18 03       ora XFER_REMAIN + 1
001378r 2  F0 20          beq @SendPad                  ; No more real data — pad remainder
00137Ar 2  B1 2A          lda (XFER_PTR),y              ; Read source byte
00137Cr 2  20 rr rr       jsr SerialChrout              ; Send it (A preserved by SerialChrout)
00137Fr 2  18             clc
001380r 2  65 37          adc XMODEM_CHK
001382r 2  85 37          sta XMODEM_CHK
001384r 2                 ; Advance source pointer
001384r 2  E6 2A          inc XFER_PTR
001386r 2  D0 02          bne @SendNoPg
001388r 2  E6 2B          inc XFER_PTR + 1
00138Ar 2               @SendNoPg:
00138Ar 2                 ; Decrement remaining byte count
00138Ar 2  AD 17 03       lda XFER_REMAIN
00138Dr 2  D0 03          bne @SendDecLo
00138Fr 2  CE 18 03       dec XFER_REMAIN + 1
001392r 2               @SendDecLo:
001392r 2  CE 17 03       dec XFER_REMAIN
001395r 2  CA             dex
001396r 2  D0 DA          bne @SendData
001398r 2  80 0D          bra @SendChk
00139Ar 2               @SendPad:
00139Ar 2                 ; Pad remaining block bytes with SUB ($1A)
00139Ar 2  A9 1A          lda #XMODEM_SUB
00139Cr 2  20 rr rr       jsr SerialChrout
00139Fr 2  18             clc
0013A0r 2  65 37          adc XMODEM_CHK
0013A2r 2  85 37          sta XMODEM_CHK
0013A4r 2  CA             dex
0013A5r 2  D0 F3          bne @SendPad
0013A7r 2               @SendChk:
0013A7r 2                 ; Send checksum byte
0013A7r 2  A5 37          lda XMODEM_CHK
0013A9r 2  20 rr rr       jsr SerialChrout
0013ACr 2                 ; Wait for ACK/NAK response
0013ACr 2  20 rr rr       jsr XModemGetByte
0013AFr 2  B0 08          bcs @SendRetry                ; Timeout — retry
0013B1r 2  C9 06          cmp #XMODEM_ACK
0013B3r 2  F0 19          beq @SendBlockOK
0013B5r 2  C9 18          cmp #XMODEM_CAN
0013B7r 2  F0 1E          beq @SendCancel
0013B9r 2                 ; NAK or unknown — retry
0013B9r 2               @SendRetry:
0013B9r 2                 ; Restore XFER_PTR and XFER_REMAIN from stack
0013B9r 2  68             pla
0013BAr 2  8D 17 03       sta XFER_REMAIN
0013BDr 2  68             pla
0013BEr 2  8D 18 03       sta XFER_REMAIN + 1
0013C1r 2  68             pla
0013C2r 2  85 2A          sta XFER_PTR
0013C4r 2  68             pla
0013C5r 2  85 2B          sta XFER_PTR + 1
0013C7r 2  C6 38          dec XMODEM_RETRY
0013C9r 2  F0 10          beq @SendFail
0013CBr 2  4C rr rr       jmp @SendBlock
0013CEr 2               
0013CEr 2               @SendBlockOK:
0013CEr 2                 ; Discard saved state from stack (4 bytes)
0013CEr 2  68             pla
0013CFr 2  68             pla
0013D0r 2  68             pla
0013D1r 2  68             pla
0013D2r 2                 ; Advance to next block
0013D2r 2  E6 36          inc XMODEM_BLK
0013D4r 2  4C rr rr       jmp @SendLoop
0013D7r 2               
0013D7r 2               @SendCancel:
0013D7r 2                 ; Discard saved state from stack
0013D7r 2  68             pla
0013D8r 2  68             pla
0013D9r 2  68             pla
0013DAr 2  68             pla
0013DBr 2               @SendFail:
0013DBr 2                 ; Re-enable serial RX IRQ
0013DBr 2  A9 09          lda #$09
0013DDr 2  8D 02 90       sta SC_CMD
0013E0r 2  AD 19 03       lda XFER_IO_SAVE
0013E3r 2  8D 06 03       sta IO_MODE
0013E6r 2  38             sec                           ; Failure
0013E7r 2  60             rts
0013E8r 2               
0013E8r 2               @SendEOT:
0013E8r 2                 ; All data sent — send EOT
0013E8r 2  A9 04          lda #XMODEM_EOT
0013EAr 2  20 rr rr       jsr SerialChrout
0013EDr 2                 ; Wait for ACK (best-effort; don't fail if timeout)
0013EDr 2  20 rr rr       jsr XModemGetByte
0013F0r 2                 ; Re-enable serial RX IRQ
0013F0r 2  A9 09          lda #$09
0013F2r 2  8D 02 90       sta SC_CMD
0013F5r 2  AD 19 03       lda XFER_IO_SAVE
0013F8r 2  8D 06 03       sta IO_MODE
0013FBr 2  18             clc                           ; Success
0013FCr 2  60             rts
0013FDr 2               
0013FDr 2               ; XModem status strings
0013FDr 2               XModemStrReceive:
0013FDr 2  58 4D 4F 44    .byte "XMODEM RX READY", $0D, $0A, 0
001401r 2  45 4D 20 52  
001405r 2  58 20 52 45  
00140Fr 2               XModemStrSend:
00140Fr 2  58 4D 4F 44    .byte "XMODEM TX READY", $0D, $0A, 0
001413r 2  45 4D 20 54  
001417r 2  58 20 52 45  
001421r 2               
001421r 2               ; NMI Handler
001421r 2               Nmi:
001421r 2  40             rti
001422r 2               
001422r 2               ; BRK Handler — saves full CPU state, reports it, and warm-starts BASIC
001422r 2               ; On entry from @IrqBrk: A/X/Y are the user's original values (restored by IRQ handler).
001422r 2               ; The CPU's hardware push left P/PCL/PCH on the stack.
001422r 2               ; Prints, on the console IO_MODE names:
001422r 2               ;   BREAK $nn AT $xxxx
001422r 2               ;   A=xx X=xx Y=xx P=xx S=xx
001422r 2               ; xxxx is the BRK opcode's address (BRK_PC - 2), nn the byte after it, and S
001422r 2               ; the stack pointer before the BRK (BRK_SP + 3).  A video console that a
001422r 2               ; program has taken out of the Text console is put back first.  BRK_PTR stays
001422r 2               ; hookable; a cartridge with no BASIC at $C000 must point it elsewhere.
001422r 2               Break:
001422r 2  8D 13 03       sta BRK_A                     ; Save user's A register
001425r 2  8E 14 03       stx BRK_X                     ; Save user's X register
001428r 2  8C 15 03       sty BRK_Y                     ; Save user's Y register
00142Br 2  BA             tsx                           ; Get current SP
00142Cr 2  8E 16 03       stx BRK_SP                   ; Save SP (points below P/PCL/PCH on stack)
00142Fr 2  68             pla                           ; Pull saved P
001430r 2  8D 10 03       sta BRK_P
001433r 2  68             pla                           ; Pull saved PCL (PC+2)
001434r 2  8D 11 03       sta BRK_PCL
001437r 2  68             pla                           ; Pull saved PCH
001438r 2  8D 12 03       sta BRK_PCH
00143Br 2  A2 FF          ldx #$FF                      ; BasEntry resets the stack anyway, and a BRK
00143Dr 2  9A             txs                           ;   reached by running off a full one has no
00143Er 2                                               ;   room left to print the report with
00143Er 2  2C 0D 03       bit HW_PRESENT                ; Video is bit 7 — see VideoClear
001441r 2  10 0D          bpl @BreakReport
001443r 2  AD 93 03       lda VID_MODE
001446r 2  C9 01          cmp #$01
001448r 2  F0 06          beq @BreakReport              ; The Text console is intact
00144Ar 2  20 rr rr       jsr InitVideoImpl             ; A program moved the card on: bring the
00144Dr 2  20 rr rr       jsr VideoClearNow             ;   console back to print on
001450r 2               @BreakReport:
001450r 2  20 rr rr       jsr PrintCRLF
001453r 2  A9 rr          lda #<KMsgBreak               ; "BREAK $"
001455r 2  A0 rr          ldy #>KMsgBreak
001457r 2  20 rr rr       jsr PrintStr
00145Ar 2  AD 11 03       lda BRK_PCL                   ; The opcode's address, BRK_PC - 2
00145Dr 2  38             sec
00145Er 2  E9 02          sbc #2
001460r 2  85 02          sta STR_PTR
001462r 2  AA             tax
001463r 2  AD 12 03       lda BRK_PCH
001466r 2  E9 00          sbc #0
001468r 2  85 03          sta STR_PTR + 1
00146Ar 2  48             pha                           ; Its high byte, then its low byte, for later
00146Br 2  DA             phx
00146Cr 2  A0 01          ldy #1
00146Er 2  B1 02          lda (STR_PTR),y               ; The byte after the BRK
001470r 2  20 rr rr       jsr KPrintHexByte
001473r 2  A9 rr          lda #<KMsgAt                  ; " AT $"
001475r 2  A0 rr          ldy #>KMsgAt
001477r 2  20 rr rr       jsr PrintStr
00147Ar 2  68             pla
00147Br 2  AA             tax
00147Cr 2  68             pla
00147Dr 2  20 rr rr       jsr KPrintHexByte
001480r 2  8A             txa
001481r 2  20 rr rr       jsr KPrintHexByte
001484r 2  20 rr rr       jsr PrintCRLF
001487r 2  A2 00          ldx #0                        ; A=xx X=xx Y=xx P=xx S=xx
001489r 2               @BreakReg:
001489r 2  8A             txa
00148Ar 2  F0 05          beq @BreakRegName
00148Cr 2  A9 20          lda #' '
00148Er 2  20 rr rr       jsr Chrout
001491r 2               @BreakRegName:
001491r 2  BD rr rr       lda KBreakRegName,x
001494r 2  20 rr rr       jsr Chrout
001497r 2  A9 3D          lda #'='
001499r 2  20 rr rr       jsr Chrout
00149Cr 2  BC rr rr       ldy KBreakRegOffset,x
00149Fr 2  B9 10 03       lda BRK_P,y
0014A2r 2  E0 04          cpx #4                        ; S: the stack pointer before the BRK pushed
0014A4r 2  D0 02          bne @BreakRegHex              ;   PCH, PCL and P
0014A6r 2  69 02          adc #2                        ; Carry is set: + 3
0014A8r 2               @BreakRegHex:
0014A8r 2  20 rr rr       jsr KPrintHexByte
0014ABr 2  E8             inx
0014ACr 2  E0 05          cpx #5
0014AEr 2  D0 D9          bne @BreakReg
0014B0r 2  20 rr rr       jsr PrintCRLF
0014B3r 2  4C rr rr       jmp BasEntry                  ; Warm start: the program is kept
0014B6r 2               KMsgBreak:
0014B6r 2  42 52 45 41    .byte "BREAK $", 0
0014BAr 2  4B 20 24 00  
0014BEr 2               KMsgAt:
0014BEr 2  20 41 54 20    .byte " AT $", 0
0014C2r 2  24 00        
0014C4r 2               KBreakRegName:
0014C4r 2  41 58 59 50    .byte "AXYPS"
0014C8r 2  53           
0014C9r 2               KBreakRegOffset:                ; From BRK_P
0014C9r 2  03 04 05 00    .byte BRK_A - BRK_P, BRK_X - BRK_P, BRK_Y - BRK_P, 0, BRK_SP - BRK_P
0014CDr 2  06           
0014CEr 2               
0014CEr 2               ; KPrintHexByte — Print A as two hex digits through Chrout
0014CEr 2               ; Preserves: X, Y
0014CEr 2               ; Modifies: Flags, A
0014CEr 2               KPrintHexByte:
0014CEr 2  48             pha
0014CFr 2  4A             lsr a
0014D0r 2  4A             lsr a
0014D1r 2  4A             lsr a
0014D2r 2  4A             lsr a
0014D3r 2  20 rr rr       jsr @KHexDigit
0014D6r 2  68             pla
0014D7r 2  29 0F          and #$0F
0014D9r 2               @KHexDigit:
0014D9r 2  C9 0A          cmp #10
0014DBr 2  90 02          bcc @KHexDec
0014DDr 2  69 06          adc #6                        ; Carry is set: 'A' - '0' - 10
0014DFr 2               @KHexDec:
0014DFr 2  69 30          adc #'0'
0014E1r 2  4C rr rr       jmp Chrout
0014E4r 2               
0014E4r 2               ; IRQ Handler
0014E4r 2               Irq:
0014E4r 2  48             pha
0014E5r 2  5A             phy
0014E6r 2  DA             phx
0014E7r 2  BA             tsx                           ; Get stack pointer to check saved status register
0014E8r 2  BD 04 01       lda $104,x                    ; Load saved P (SP+4: past X, Y, A we pushed)
0014EBr 2  29 10          and #$10                      ; Test B flag — set by BRK, clear by hardware IRQ
0014EDr 2  D0 47          bne @IrqBrk                   ; Branch if this was a BRK instruction
0014EFr 2               @IrqSc:
0014EFr 2  AD 0D 03       lda HW_PRESENT
0014F2r 2  29 10          and #HW_SC
0014F4r 2  F0 19          beq @IrqCheckKB               ; Serial not present — skip
0014F6r 2  AD 01 90       lda SC_STATUS
0014F9r 2  29 80          and #SC_STATUS_IRQ            ; Check if serial data caused the interrupt
0014FBr 2  F0 12          beq @IrqCheckKB               ; If not, check keyboard
0014FDr 2  AD 00 90       lda SC_DATA                   ; Read the data from serial register
001500r 2  20 rr rr       jsr WriteBuffer               ; Store to the input buffer
001503r 2  20 rr rr       jsr BufferSize
001506r 2  C9 F0          cmp #$F0                      ; Is the buffer almost full?
001508r 2  90 05          bcc @IrqCheckKB               ; If not, also check keyboard
00150Ar 2  A9 01          lda #$01                      ; No parity, no echo, RTSB high, TX interrupts disabled, RX interrupts enabled
00150Cr 2  8D 02 90       sta SC_CMD                    ; Otherwise, signal not ready for receiving (RTSB high)
00150Fr 2                                               ; Fall through to check keyboard — always clear VIA flags
00150Fr 2               @IrqCheckKB:
00150Fr 2  AD 0D 03       lda HW_PRESENT
001512r 2  29 20          and #HW_GPIO
001514r 2  F0 1C          beq @IrqExit                  ; GPIO not present — skip
001516r 2  AD 0D 94       lda GPIO_IFR
001519r 2  29 10          and #GPIO_INT_CB1             ; Check if CB1 (matrix keyboard data ready) caused the interrupt
00151Br 2  F0 08          beq @IrqCheckPS2              ; If not, check PS/2 keyboard
00151Dr 2  AD 00 94       lda GPIO_PORTB                ; Read ASCII byte from matrix keyboard (also clears CB1 IFR flag)
001520r 2  20 rr rr       jsr WriteBuffer               ; Store to the input buffer
001523r 2  80 0D          bra @IrqExit
001525r 2               @IrqCheckPS2:
001525r 2  AD 0D 94       lda GPIO_IFR
001528r 2  29 02          and #GPIO_INT_CA1             ; Check if CA1 (PS/2 keyboard data ready) caused the interrupt
00152Ar 2  F0 06          beq @IrqExit                  ; If not, exit
00152Cr 2  AD 01 94       lda GPIO_PORTA                ; Read ASCII byte from PS/2 keyboard (also clears CA1 IFR flag)
00152Fr 2  20 rr rr       jsr WriteBuffer               ; Store to the input buffer
001532r 2               @IrqExit:
001532r 2  FA             plx
001533r 2  7A             ply
001534r 2  68             pla
001535r 2  40             rti
001536r 2               @IrqBrk:
001536r 2  FA             plx                           ; Restore saved registers
001537r 2  7A             ply
001538r 2  68             pla
001539r 2  58             cli                           ; Re-enable interrupts — abandoning interrupt context
00153Ar 2  6C 02 03       jmp (BRK_PTR)                 ; BRK — dispatch with P/PCL/PCH still on stack
00153Dr 2               
00153Dr 2               ; NMI Vector
00153Dr 2               NmiVec:
00153Dr 2  6C 04 03       jmp (NMI_PTR)                 ; Indirect jump through NMI pointer to the NMI handler
001540r 2               
001540r 2               ; Reset Vector
001540r 2               ResetVec:
001540r 2  4C rr rr       jmp Reset                     ; Initialize the system
001543r 2               
001543r 2               ; IRQ Vector
001543r 2               IrqVec:
001543r 2  6C 00 03       jmp (IRQ_PTR)                 ; Indirect jump through IRQ pointer to the IRQ handler
001546r 2               
001546r 1               .segment "CHARS"
000000r 1               .include "Chars.asm"
000000r 2               ; =============================================================================
000000r 2               ; CHARS  —  IBM Code Page 437 Character Set (5x8 font, 8x8 cell)
000000r 2               ;            for AC6502 Homebrew Computer
000000r 2               ;
000000r 2               ;   ROM Region  :  $B800-$BFFF  (2,048 bytes / $0800)
000000r 2               ;   Segment     :  CHARS
000000r 2               ;   Entry point :  CharacterSet  (first byte of segment = $B800)
000000r 2               ;   Assembler   :  ca65  (cc65 toolchain)
000000r 2               ;   Linker cfg  :  BIOS.cfg
000000r 2               ;
000000r 2               ;   Layout      :  256 characters, 8 bytes each. Each byte is one horizontal
000000r 2               ;                   row of pixels, 5 pixels left-aligned in the 8-bit byte.
000000r 2               ;                   Consumed by InitVideo (Kernal.asm) to seed the TMS9918
000000r 2               ;                   pattern table.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               CharacterSet:
000000r 2                   ; Character $00 - NULL (blank)
000000r 2  00 00 00 00      .byte $00, $00, $00, $00, $00, $00, $00, $00
000004r 2  00 00 00 00  
000008r 2                   ; Character $01 - ☺ (white smiling face)
000008r 2  70 88 D8 88      .byte $70, $88, $D8, $88, $A8, $88, $70, $00
00000Cr 2  A8 88 70 00  
000010r 2                   ; Character $02 - ☻ (black smiling face)
000010r 2  70 F8 A8 F8      .byte $70, $F8, $A8, $F8, $88, $F8, $70, $00
000014r 2  88 F8 70 00  
000018r 2                   ; Character $03 - ♥ (heart)
000018r 2  00 50 F8 F8      .byte $00, $50, $F8, $F8, $F8, $70, $20, $00
00001Cr 2  F8 70 20 00  
000020r 2                   ; Character $04 - ♦ (diamond)
000020r 2  00 20 70 F8      .byte $00, $20, $70, $F8, $F8, $70, $20, $00
000024r 2  F8 70 20 00  
000028r 2                   ; Character $05 - ♣ (club)
000028r 2  20 70 70 20      .byte $20, $70, $70, $20, $F8, $F8, $20, $00
00002Cr 2  F8 F8 20 00  
000030r 2                   ; Character $06 - ♠ (spade)
000030r 2  00 20 70 F8      .byte $00, $20, $70, $F8, $F8, $20, $70, $00
000034r 2  F8 20 70 00  
000038r 2                   ; Character $07 - • (bullet)
000038r 2  00 00 00 30      .byte $00, $00, $00, $30, $30, $00, $00, $00
00003Cr 2  30 00 00 00  
000040r 2                   ; Character $08 - ◘ (inverse bullet)
000040r 2  FC FC FC CC      .byte $FC, $FC, $FC, $CC, $CC, $FC, $FC, $FC
000044r 2  CC FC FC FC  
000048r 2                   ; Character $09 - ○ (white circle)
000048r 2  00 00 78 48      .byte $00, $00, $78, $48, $48, $78, $00, $00
00004Cr 2  48 78 00 00  
000050r 2                   ; Character $0A - ◙ (inverse white circle)
000050r 2  FC FC 84 B4      .byte $FC, $FC, $84, $B4, $B4, $84, $FC, $FC
000054r 2  B4 84 FC FC  
000058r 2                   ; Character $0B - ♂ (male symbol)
000058r 2  00 38 18 68      .byte $00, $38, $18, $68, $90, $90, $60, $00
00005Cr 2  90 90 60 00  
000060r 2                   ; Character $0C - ♀ (female symbol)
000060r 2  70 88 88 70      .byte $70, $88, $88, $70, $20, $70, $20, $00
000064r 2  20 70 20 00  
000068r 2                   ; Character $0D - ♪ (eighth note)
000068r 2  20 30 28 20      .byte $20, $30, $28, $20, $60, $E0, $C0, $00
00006Cr 2  60 E0 C0 00  
000070r 2                   ; Character $0E - ♫ (beamed eighth notes)
000070r 2  18 68 58 68      .byte $18, $68, $58, $68, $58, $D8, $C0, $00
000074r 2  58 D8 C0 00  
000078r 2                   ; Character $0F - ☼ (sun)
000078r 2  00 A8 70 D8      .byte $00, $A8, $70, $D8, $70, $A8, $00, $00
00007Cr 2  70 A8 00 00  
000080r 2                   ; Character $10 - ► (right-pointing triangle)
000080r 2  40 60 70 78      .byte $40, $60, $70, $78, $70, $60, $40, $00
000084r 2  70 60 40 00  
000088r 2                   ; Character $11 - ◄ (left-pointing triangle)
000088r 2  10 30 70 F0      .byte $10, $30, $70, $F0, $70, $30, $10, $00
00008Cr 2  70 30 10 00  
000090r 2                   ; Character $12 - ↕ (up/down arrow)
000090r 2  20 70 F8 20      .byte $20, $70, $F8, $20, $F8, $70, $20, $00
000094r 2  F8 70 20 00  
000098r 2                   ; Character $13 - ‼ (double exclamation mark)
000098r 2  50 50 50 50      .byte $50, $50, $50, $50, $50, $00, $50, $00
00009Cr 2  50 00 50 00  
0000A0r 2                   ; Character $14 - ¶ (pilcrow)
0000A0r 2  78 A8 A8 68      .byte $78, $A8, $A8, $68, $28, $28, $28, $00
0000A4r 2  28 28 28 00  
0000A8r 2                   ; Character $15 - § (section sign)
0000A8r 2  70 88 60 50      .byte $70, $88, $60, $50, $30, $88, $70, $00
0000ACr 2  30 88 70 00  
0000B0r 2                   ; Character $16 - ▬ (black rectangle)
0000B0r 2  00 00 00 00      .byte $00, $00, $00, $00, $00, $F0, $F0, $00
0000B4r 2  00 F0 F0 00  
0000B8r 2                   ; Character $17 - ↨ (up/down arrow with base)
0000B8r 2  20 70 F8 20      .byte $20, $70, $F8, $20, $F8, $70, $20, $70
0000BCr 2  F8 70 20 70  
0000C0r 2                   ; Character $18 - ↑ (up arrow)
0000C0r 2  20 70 F8 20      .byte $20, $70, $F8, $20, $20, $20, $20, $00
0000C4r 2  20 20 20 00  
0000C8r 2                   ; Character $19 - ↓ (down arrow)
0000C8r 2  20 20 20 20      .byte $20, $20, $20, $20, $F8, $70, $20, $00
0000CCr 2  F8 70 20 00  
0000D0r 2                   ; Character $1A - → (right arrow)
0000D0r 2  00 20 30 F8      .byte $00, $20, $30, $F8, $30, $20, $00, $00
0000D4r 2  30 20 00 00  
0000D8r 2                   ; Character $1B - ← (left arrow)
0000D8r 2  00 20 60 F8      .byte $00, $20, $60, $F8, $60, $20, $00, $00
0000DCr 2  60 20 00 00  
0000E0r 2                   ; Character $1C - ∟ (right angle)
0000E0r 2  00 00 00 80      .byte $00, $00, $00, $80, $80, $80, $F8, $00
0000E4r 2  80 80 F8 00  
0000E8r 2                   ; Character $1D - ↔ (left/right arrow)
0000E8r 2  00 50 50 F8      .byte $00, $50, $50, $F8, $50, $50, $00, $00
0000ECr 2  50 50 00 00  
0000F0r 2                   ; Character $1E - ▲ (up-pointing triangle)
0000F0r 2  20 20 70 70      .byte $20, $20, $70, $70, $F8, $F8, $00, $00
0000F4r 2  F8 F8 00 00  
0000F8r 2                   ; Character $1F - ▼ (down-pointing triangle)
0000F8r 2  F8 F8 70 70      .byte $F8, $F8, $70, $70, $20, $20, $00, $00
0000FCr 2  20 20 00 00  
000100r 2                   ; Character $20 - SPACE
000100r 2  00 00 00 00      .byte $00, $00, $00, $00, $00, $00, $00, $00
000104r 2  00 00 00 00  
000108r 2                   ; Character $21 - !
000108r 2  20 70 70 20      .byte $20, $70, $70, $20, $20, $00, $20, $00
00010Cr 2  20 00 20 00  
000110r 2                   ; Character $22 - "
000110r 2  D8 D8 90 00      .byte $D8, $D8, $90, $00, $00, $00, $00, $00
000114r 2  00 00 00 00  
000118r 2                   ; Character $23 - #
000118r 2  00 50 F8 50      .byte $00, $50, $F8, $50, $50, $F8, $50, $00
00011Cr 2  50 F8 50 00  
000120r 2                   ; Character $24 - $
000120r 2  40 70 80 60      .byte $40, $70, $80, $60, $10, $E0, $20, $00
000124r 2  10 E0 20 00  
000128r 2                   ; Character $25 - %
000128r 2  C8 C8 10 20      .byte $C8, $C8, $10, $20, $40, $98, $98, $00
00012Cr 2  40 98 98 00  
000130r 2                   ; Character $26 - &
000130r 2  40 A0 A0 40      .byte $40, $A0, $A0, $40, $A8, $90, $68, $00
000134r 2  A8 90 68 00  
000138r 2                   ; Character $27 - '
000138r 2  C0 C0 80 00      .byte $C0, $C0, $80, $00, $00, $00, $00, $00
00013Cr 2  00 00 00 00  
000140r 2                   ; Character $28 - (
000140r 2  40 80 80 80      .byte $40, $80, $80, $80, $80, $80, $40, $00
000144r 2  80 80 40 00  
000148r 2                   ; Character $29 - )
000148r 2  80 40 40 40      .byte $80, $40, $40, $40, $40, $40, $80, $00
00014Cr 2  40 40 80 00  
000150r 2                   ; Character $2A - *
000150r 2  00 50 70 F8      .byte $00, $50, $70, $F8, $70, $50, $00, $00
000154r 2  70 50 00 00  
000158r 2                   ; Character $2B - +
000158r 2  00 20 20 F8      .byte $00, $20, $20, $F8, $20, $20, $00, $00
00015Cr 2  20 20 00 00  
000160r 2                   ; Character $2C - ,
000160r 2  00 00 00 00      .byte $00, $00, $00, $00, $00, $C0, $C0, $80
000164r 2  00 C0 C0 80  
000168r 2                   ; Character $2D - -
000168r 2  00 00 00 F8      .byte $00, $00, $00, $F8, $00, $00, $00, $00
00016Cr 2  00 00 00 00  
000170r 2                   ; Character $2E - .
000170r 2  00 00 00 00      .byte $00, $00, $00, $00, $00, $C0, $C0, $00
000174r 2  00 C0 C0 00  
000178r 2                   ; Character $2F - /
000178r 2  00 08 10 20      .byte $00, $08, $10, $20, $40, $80, $00, $00
00017Cr 2  40 80 00 00  
000180r 2                   ; Character $30 - 0
000180r 2  70 88 98 A8      .byte $70, $88, $98, $A8, $C8, $88, $70, $00
000184r 2  C8 88 70 00  
000188r 2                   ; Character $31 - 1
000188r 2  20 60 20 20      .byte $20, $60, $20, $20, $20, $20, $70, $00
00018Cr 2  20 20 70 00  
000190r 2                   ; Character $32 - 2
000190r 2  70 88 08 30      .byte $70, $88, $08, $30, $40, $80, $F8, $00
000194r 2  40 80 F8 00  
000198r 2                   ; Character $33 - 3
000198r 2  70 88 08 70      .byte $70, $88, $08, $70, $08, $88, $70, $00
00019Cr 2  08 88 70 00  
0001A0r 2                   ; Character $34 - 4
0001A0r 2  10 30 50 90      .byte $10, $30, $50, $90, $F8, $10, $10, $00
0001A4r 2  F8 10 10 00  
0001A8r 2                   ; Character $35 - 5
0001A8r 2  F8 80 80 F0      .byte $F8, $80, $80, $F0, $08, $88, $70, $00
0001ACr 2  08 88 70 00  
0001B0r 2                   ; Character $36 - 6
0001B0r 2  30 40 80 F0      .byte $30, $40, $80, $F0, $88, $88, $70, $00
0001B4r 2  88 88 70 00  
0001B8r 2                   ; Character $37 - 7
0001B8r 2  F8 08 10 20      .byte $F8, $08, $10, $20, $40, $40, $40, $00
0001BCr 2  40 40 40 00  
0001C0r 2                   ; Character $38 - 8
0001C0r 2  70 88 88 70      .byte $70, $88, $88, $70, $88, $88, $70, $00
0001C4r 2  88 88 70 00  
0001C8r 2                   ; Character $39 - 9
0001C8r 2  70 88 88 78      .byte $70, $88, $88, $78, $08, $10, $60, $00
0001CCr 2  08 10 60 00  
0001D0r 2                   ; Character $3A - :
0001D0r 2  00 00 60 60      .byte $00, $00, $60, $60, $00, $60, $60, $00
0001D4r 2  00 60 60 00  
0001D8r 2                   ; Character $3B - ;
0001D8r 2  00 00 60 60      .byte $00, $00, $60, $60, $00, $60, $60, $40
