000EAAr 2               
000EAAr 2               ; Addressing mode operand size table (bytes beyond opcode)
000EAAr 2               DisModeSizes:
000EAAr 2  00             .byte 0                  ; AM_IMP  = 0
000EABr 2  00             .byte 0                  ; AM_ACC  = 1
000EACr 2  01             .byte 1                  ; AM_IMM  = 2
000EADr 2  01             .byte 1                  ; AM_ZP   = 3
000EAEr 2  01             .byte 1                  ; AM_ZPX  = 4
000EAFr 2  01             .byte 1                  ; AM_ZPY  = 5
000EB0r 2  02             .byte 2                  ; AM_ABS  = 6
000EB1r 2  02             .byte 2                  ; AM_ABX  = 7
000EB2r 2  02             .byte 2                  ; AM_ABY  = 8
000EB3r 2  02             .byte 2                  ; AM_IND  = 9
000EB4r 2  01             .byte 1                  ; AM_IZX  = 10
000EB5r 2  01             .byte 1                  ; AM_IZY  = 11
000EB6r 2  01             .byte 1                  ; AM_ZPI  = 12
000EB7r 2  01             .byte 1                  ; AM_REL  = 13
000EB8r 2  02             .byte 2                  ; AM_ZPR  = 14
000EB9r 2  02             .byte 2                  ; AM_AIX  = 15
000EBAr 2               
000EBAr 2               ; Operand print dispatch table (16 addressing modes)
000EBAr 2               DisOperandJmpTable:
000EBAr 2  rr rr          .word DisOpImp             ; AM_IMP  = 0
000EBCr 2  rr rr          .word DisOpAcc             ; AM_ACC  = 1
000EBEr 2  rr rr          .word DisOpImm             ; AM_IMM  = 2
000EC0r 2  rr rr          .word DisOpZp              ; AM_ZP   = 3
