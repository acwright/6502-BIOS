000995r 2  4C rr rr             jmp     NormalizeFac5
000998r 2               
000998r 2               ; ----------------------------------------------------------------------------
000998r 2               ; FINISH NORMALIZING FAC
000998r 2               ; ----------------------------------------------------------------------------
000998r 2               NormalizeFac3:
000998r 2  69 01                adc     #$01
00099Ar 2  06 1D                asl     FACEXTENSION
00099Cr 2  26 12                rol     FAC+4
00099Er 2  26 11                rol     FAC+3
0009A0r 2  26 10                rol     FAC+2
