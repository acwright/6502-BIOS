0021BAr 2  A9 9F                lda     #TOK_THEN
0021BCr 2  20 rr rr             jsr     SynChr
0021BFr 2               @testTrue:
0021BFr 2  A5 0E                lda     FAC
0021C1r 2  D0 1F                bne     @true
0021C3r 2                       ; FALSE: scan to end-of-line OR a TOK_ELSE; if ELSE found, advance
0021C3r 2                       ; TXTPTR past it and resume execution there.
0021C3r 2  A0 00                ldy     #0
0021C5r 2               @searchElse:
0021C5r 2  B1 04                lda     (TXTPTR),y
0021C7r 2  F0 07                beq     @noElse
0021C9r 2  C9 A4                cmp     #TOK_ELSE
0021CBr 2  F0 09                beq     @gotElse
0021CDr 2  C8                   iny
0021CEr 2  D0 F5                bne     @searchElse
0021D0r 2               @noElse:
0021D0r 2                       ; Skip remainder of line (no ELSE).
0021D0r 2  20 rr rr             jsr     BasRemn
0021D3r 2  4C rr rr             jmp     BasAddon
0021D6r 2               @gotElse:
0021D6r 2                       ; Advance TXTPTR past ELSE token; continue execution.
0021D6r 2  C8                   iny
0021D7r 2  98                   tya
0021D8r 2  18                   clc
0021D9r 2  65 04                adc     TXTPTR
0021DBr 2  85 04                sta     TXTPTR
0021DDr 2  90 02                bcc     @t1
0021DFr 2  E6 05                inc     TXTPTR+1
0021E1r 2               @t1:
0021E1r 2  60                   rts
0021E2r 2               @true:
0021E2r 2                       ; TRUE: if next is a digit, IF expr THEN <linenum> -> implicit GOTO.
0021E2r 2  20 rr rr             jsr     ChrGot
