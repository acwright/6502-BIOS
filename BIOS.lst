0023FCr 2               
0023FCr 2               ; ---------------------------------------------------------------------------
0023FCr 2               ; Statement: READ var[,var,...] -- pull next DATA item from BAS_DATAPTR
0023FCr 2               ; into the variable pointed to by PtrGet.
0023FCr 2               ; ---------------------------------------------------------------------------
0023FCr 2               ; ---------------------------------------------------------------------------
0023FCr 2               ; BasStrItem -- read one string item at TXTPTR into the variable BAS_FORPNT
0023FCr 2               ; points at.  Shared by INPUT and READ, which differ only in what ends an
0023FCr 2               ; unquoted item: INPUT stops at ',' or NUL, READ also stops at ':' because a
0023FCr 2               ; DATA statement can be followed by another statement on the same line.
0023FCr 2               ;
0023FCr 2               ; On entry : X        = the extra unquoted terminator (StrLt2's CHARAC)
0023FCr 2               ;            TXTPTR   = first character of the item
0023FCr 2               ;            FORPNT   = the variable's 3-byte descriptor slot
0023FCr 2               ; On exit  : TXTPTR advanced past the item, descriptor stored, temp popped.
0023FCr 2               ; ---------------------------------------------------------------------------
0023FCr 2               BasStrItem:
0023FCr 2                       ; A '"' here means quote-mode (terminator '"' or NUL); anything else
0023FCr 2                       ; is a bare item running to X, ',' or NUL.
0023FCr 2  A0 00                ldy     #0
0023FEr 2  B1 04                lda     (TXTPTR),y
002400r 2  C9 22                cmp     #'"'
002402r 2  F0 0C                beq     @quoted
002404r 2  86 44                stx     CHARAC
002406r 2  A9 2C                lda     #','
002408r 2  85 6A                sta     ENDCHR
00240Ar 2  A5 04                lda     TXTPTR                  ; StrLt2's source = TXTPTR
00240Cr 2  A4 05                ldy     TXTPTR+1
00240Er 2  80 0E                bra     @call
002410r 2               @quoted:
002410r 2  85 44                sta     CHARAC                  ; A is still '"' from the compare
002412r 2  85 6A                sta     ENDCHR
002414r 2  18                   clc                             ; skip it: source = TXTPTR + 1
002415r 2  A5 04                lda     TXTPTR
002417r 2  69 01                adc     #1
002419r 2  A4 05                ldy     TXTPTR+1
00241Br 2  90 01                bcc     @call
00241Dr 2  C8                   iny
00241Er 2               @call:
00241Er 2  20 rr rr             jsr     StrLt2
002421r 2                       ; StrLt2 leaves STRNG2 past the text it consumed -- at the terminator
002421r 2                       ; for an unquoted item, just past the closing '"' for a quoted one.
002421r 2                       ; TXTPTR has to follow it: for INPUT so the trailing-extra check sees
002421r 2                       ; only what really remained on the line, and for READ so the next one
002421r 2                       ; doesn't start again in the middle of the item this one took.
002421r 2  A5 1E                lda     STRNG2
002423r 2  85 04                sta     TXTPTR
002425r 2  A5 1F                lda     STRNG2+1
002427r 2  85 05                sta     TXTPTR+1
002429r 2  A0 00                ldy     #0
00242Br 2  A5 0E                lda     FAC
00242Dr 2  91 46                sta     (BAS_FORPNT),y
00242Fr 2  C8                   iny
002430r 2  A5 0F                lda     FAC+1
002432r 2  91 46                sta     (BAS_FORPNT),y
002434r 2  C8                   iny
002435r 2  A5 10                lda     FAC+2
002437r 2  91 46                sta     (BAS_FORPNT),y
002439r 2                       ; StrLt2 pushed a temporary descriptor via PutNew.  The variable owns
002439r 2                       ; the heap copy now, so pop the temp -- do NOT use FreFac, which would
002439r 2                       ; reclaim the heap we just handed over.  Leaving temps unfreed leaks
002439r 2                       ; the 3-slot temp stack, both overflowing it (?FORMULA TOO COMPLEX)
002439r 2                       ; and corrupting later strings via stale descriptor pointers.
002439r 2  A5 11                lda     FAC+3
00243Br 2  A4 12                ldy     FAC+4
00243Dr 2  4C rr rr             jmp     FreTms
002440r 2               
002440r 2               BasCmdRead:
002440r 2  AE 1A 03             ldx     BAS_DATAPTR
002443r 2  AC 1B 03             ldy     BAS_DATAPTR+1
002446r 2  A9 98                lda     #$98                    ; INPUTFLG = $98 means READ mode
002448r 2  2C                   .byte   $2C
002449r 2               BasInpDoit:
002449r 2  A9 00                lda     #0
00244Br 2  85 69                sta     BAS_INPUTFLG
00244Dr 2  86 3A                stx     BAS_TMP1                ; TMP1 = data pointer
00244Fr 2  84 3B                sty     BAS_TMP1+1
002451r 2               @nextVar:
002451r 2                       ; TXTPTR currently points into program at variable name.
002451r 2  20 rr rr             jsr     PtrGet                  ; advances TXTPTR past var name
002454r 2  85 46                sta     BAS_FORPNT
002456r 2  84 47                sty     BAS_FORPNT+1
002458r 2                       ; Save program TXTPTR on hw stack, switch TXTPTR to data ptr.
002458r 2  A5 05                lda     TXTPTR+1
00245Ar 2  48                   pha
00245Br 2  A5 04                lda     TXTPTR
00245Dr 2  48                   pha
00245Er 2  A5 3A                lda     BAS_TMP1
002460r 2  85 04                sta     TXTPTR
002462r 2  A5 3B                lda     BAS_TMP1+1
002464r 2  85 05                sta     TXTPTR+1
002466r 2  20 rr rr             jsr     ChrGot
002469r 2  D0 08                bne     @gotData
00246Br 2                       ; Out of items on this line - find next DATA.
00246Br 2  20 rr rr             jsr     BasFindData
00246Er 2  90 03                bcc     @gotData
002470r 2  4C rr rr             jmp     @oodata
002473r 2               @gotData:
002473r 2                       ; Advance past separator (',' between items, ' ' after DATA token,
002473r 2                       ; or quote-delimiter for strings).  ChrGet also skips spaces.
002473r 2  20 rr rr             jsr     ChrGet
002476r 2                       ; Parse value at TXTPTR (data side).
002476r 2  24 64                bit     VALTYP
002478r 2  30 0C                bmi     @readStr
00247Ar 2                       ; Numeric.
00247Ar 2  20 rr rr             jsr     Fin
00247Dr 2  A6 46                ldx     BAS_FORPNT
00247Fr 2  A4 47                ldy     BAS_FORPNT+1
002481r 2  20 rr rr             jsr     StoreFacAtYxRounded
002484r 2  80 05                bra     @afterStore
002486r 2               @readStr:
002486r 2                       ; Previously this called StrLt2 without setting up its (A,Y) source
002486r 2                       ; argument at all, so every DATA string pointed into zero page: an
002486r 2                       ; unquoted item read back empty and a quoted one read back as garbage
002486r 2                       ; from $0022.  BasStrItem is INPUT's path, which had it right.
002486r 2  A2 3A                ldx     #':'                    ; a DATA item also ends at a statement break
002488r 2  20 rr rr             jsr     BasStrItem
00248Br 2               @afterStore:
00248Br 2                       ; Save updated data ptr.
00248Br 2  A5 04                lda     TXTPTR
00248Dr 2  85 3A                sta     BAS_TMP1
00248Fr 2  A5 05                lda     TXTPTR+1
002491r 2  85 3B                sta     BAS_TMP1+1
002493r 2                       ; Restore program TXTPTR.
002493r 2  68                   pla
002494r 2  85 04                sta     TXTPTR
002496r 2  68                   pla
002497r 2  85 05                sta     TXTPTR+1
002499r 2                       ; If next program byte is ',', another variable follows.
002499r 2  20 rr rr             jsr     ChrGot
00249Cr 2  C9 2C                cmp     #','
00249Er 2  D0 05                bne     @done
0024A0r 2  20 rr rr             jsr     ChrGet
0024A3r 2  80 AC                bra     @nextVar
0024A5r 2               @done:
0024A5r 2                       ; Persist data ptr.
0024A5r 2  A5 3A                lda     BAS_TMP1
0024A7r 2  8D 1A 03             sta     BAS_DATAPTR
0024AAr 2  A5 3B                lda     BAS_TMP1+1
0024ACr 2  8D 1B 03             sta     BAS_DATAPTR+1
0024AFr 2  60                   rts
0024B0r 2               @oodata:
0024B0r 2  A2 0E                ldx     #ERR_OD
0024B2r 2  4C rr rr             jmp     BasErrorVec
0024B5r 2               
0024B5r 2               ; ---------------------------------------------------------------------------
0024B5r 2               ; BasFindData -- starting from TXTPTR (positioned somewhere within a line's
0024B5r 2               ; payload), advance to the byte after the next DATA token in the program.
0024B5r 2               ; Returns carry SET on out-of-data, carry CLEAR with TXTPTR at first byte
0024B5r 2               ; AFTER the DATA token (i.e. at the first DATA item).
0024B5r 2               ; ---------------------------------------------------------------------------
0024B5r 2               BasFindData:
0024B5r 2               @scanByte:
0024B5r 2  A0 00                ldy     #0
0024B7r 2  B1 04                lda     (TXTPTR),y
0024B9r 2  F0 1F                beq     @atEnd
0024BBr 2  C9 83                cmp     #TOK_DATA
0024BDr 2  F0 2E                beq     @found
0024BFr 2  C9 22                cmp     #'"'
0024C1r 2  D0 12                bne     @advance1
0024C3r 2                       ; Skip quoted string (advance TXTPTR past closing quote or NUL).
0024C3r 2  20 rr rr             jsr     @incTxt
0024C6r 2               @inStr:
0024C6r 2  A0 00                ldy     #0
0024C8r 2  B1 04                lda     (TXTPTR),y
0024CAr 2  F0 0E                beq     @atEnd
0024CCr 2  20 rr rr             jsr     @incTxt
0024CFr 2  C9 22                cmp     #'"'
0024D1r 2  D0 F3                bne     @inStr
0024D3r 2  80 E0                bra     @scanByte
0024D5r 2               @advance1:
0024D5r 2  20 rr rr             jsr     @incTxt
0024D8r 2  80 DB                bra     @scanByte
0024DAr 2               @atEnd:
0024DAr 2                       ; (TXTPTR) is on the line's $00 terminator.  Bytes immediately after
0024DAr 2                       ; are the next line's [next-lo][next-hi][num-lo][num-hi][payload..].
0024DAr 2                       ; Check next-pointer at offset +2 (next-hi); if 0, end of program.
0024DAr 2  A0 02                ldy     #2
0024DCr 2  B1 04                lda     (TXTPTR),y
0024DEr 2  F0 0F                beq     @oodata
0024E0r 2                       ; Advance TXTPTR by 5: past terminator (1) + line header (4).
0024E0r 2  18                   clc
0024E1r 2  A5 04                lda     TXTPTR
0024E3r 2  69 05                adc     #5
0024E5r 2  85 04                sta     TXTPTR
0024E7r 2  90 CC                bcc     @scanByte
0024E9r 2  E6 05                inc     TXTPTR+1
0024EBr 2  80 C8                bra     @scanByte
0024EDr 2               @found:
0024EDr 2                       ; TXTPTR is left AT the TOK_DATA byte; caller's CHRGET advances past.
0024EDr 2  18                   clc
0024EEr 2  60                   rts
0024EFr 2               @oodata:
0024EFr 2  38                   sec
0024F0r 2  60                   rts
0024F1r 2               @incTxt:
0024F1r 2  E6 04                inc     TXTPTR
0024F3r 2  D0 02                bne     @r
0024F5r 2  E6 05                inc     TXTPTR+1
0024F7r 2               @r:
0024F7r 2  60                   rts
0024F8r 2               
0024F8r 2               ; ---------------------------------------------------------------------------
0024F8r 2               ; Statement: FOR var = expr1 TO expr2 [STEP expr3]
0024F8r 2               ; Pushes 18-byte frame on CPU stack:
0024F8r 2               ;   [tag $81][VAR-lo][VAR-hi][STEP-FP (5)][STEP-sign][CURLIN-lo][CURLIN-hi]
0024F8r 2               ;   [TXTPTR-lo][TXTPTR-hi][LIMIT-FP (5)]
0024F8r 2               ; ---------------------------------------------------------------------------
0024F8r 2               BasCmdFor:
0024F8r 2                       ; Set SUBFLG so PtrGet doesn't recurse on FN.
0024F8r 2  A9 80                lda     #$80
0024FAr 2  85 68                sta     SUBFLG
0024FCr 2  20 rr rr             jsr     BasCmdLet               ; consumes "var = expr"
0024FFr 2                       ; PtrGet (inside LET) saved VARPNT in FORPNT (hopefully). Re-fetch
0024FFr 2                       ; FORPNT from the assignment, but BasCmdLet doesn't set FORPNT in
0024FFr 2                       ; our impl.  Re-parse the variable name by rewinding TXTPTR via
0024FFr 2                       ; CURLIN scan.  Cheat: BasCmdLet leaves VARPNT current.
0024FFr 2  A5 3F                lda     VARPNT
002501r 2  85 46                sta     BAS_FORPNT
002503r 2  A5 40                lda     VARPNT+1
002505r 2  85 47                sta     BAS_FORPNT+1
002507r 2                       ; Discard any prior FOR frame for the same variable to avoid leak.
002507r 2  20 rr rr             jsr     GtForPnt
00250Ar 2  90 00                bcc     @noOld                  ; carry clear -> no matching frame
00250Cr 2                       ; The prior-frame pop is still skipped: the runtime tolerates one stray
00250Cr 2                       ; frame, and msbasic re-uses the slot only when an explicit FOR with a
00250Cr 2                       ; matching variable already exists, which is rare. GtForPnt does now
00250Cr 2                       ; report found/not-found in carry (Z was ambiguous and unusable), so
00250Cr 2                       ; this branch is at least honest about which case it is in.
00250Cr 2               @noOld:
00250Cr 2                       ; Discard our caller's (BasExecuteStatement's) return address so
00250Cr 2                       ; that the FOR frame sits on the stack with no other junk above it.
00250Cr 2                       ; We will JMP BasNewstt at the end instead of RTSing.
00250Cr 2  68                   pla
00250Dr 2  68                   pla
00250Er 2                       ; Push limit (will be parsed below) -- we lay out the frame as:
00250Er 2                       ;   pushed first (deepest): TXTPTR, CURLIN, LIMIT (5), STEP-sign,
00250Er 2                       ;   STEP (5), VAR-addr, $81-tag.
00250Er 2                       ; We don't know LIMIT/STEP yet; we push placeholders and patch.
00250Er 2                       ; Easier: parse limit & step first, then push frame in one go.
00250Er 2  A9 9C                lda     #TOK_TO
002510r 2  20 rr rr             jsr     SynChr
002513r 2  20 rr rr             jsr     FrmNum
002516r 2                       ; Strip sign info on limit (msbasic stores limit unsigned-magnitude
002516r 2                       ; with sign packed).  Pack FACSIGN bit 7 -> FAC+1 bit 7.
002516r 2  A5 13                lda     FACSIGN
002518r 2  09 7F                ora     #$7F
00251Ar 2  25 0F                and     FAC+1
00251Cr 2  85 0F                sta     FAC+1
00251Er 2                       ; Save LIMIT temporarily in BAS_TEMP1..+4 (5 bytes).
00251Er 2  A2 04                ldx     #4
002520r 2               @saveLimit:
002520r 2  B5 0E                lda     FAC,x
002522r 2  95 4D                sta     BAS_TEMP1,x
002524r 2  CA                   dex
002525r 2  10 F9                bpl     @saveLimit
002527r 2                       ; STEP: default 1, or evaluate after TOK_STEP.
002527r 2  20 rr rr             jsr     ChrGot
00252Ar 2  C9 A1                cmp     #TOK_STEP
00252Cr 2  D0 08                bne     @defStep
00252Er 2  20 rr rr             jsr     ChrGet
002531r 2  20 rr rr             jsr     FrmNum
002534r 2  80 07                bra     @gotStep
002536r 2               @defStep:
002536r 2  A9 rr                lda     #<ConstOne
002538r 2  A0 rr                ldy     #>ConstOne
00253Ar 2  20 rr rr             jsr     LoadFacFromYa
00253Dr 2               @gotStep:
00253Dr 2  20 rr rr             jsr     Sign                    ; A = step sign byte (-1/0/1)
002540r 2  85 52                sta     BAS_TEMP2               ; stash step sign
002542r 2                       ; Pack sign of FAC into FAC+1 bit7 then save STEP into BAS_TEMP2+1..+5.
002542r 2  A5 13                lda     FACSIGN
002544r 2  09 7F                ora     #$7F
002546r 2  25 0F                and     FAC+1
002548r 2  85 0F                sta     FAC+1
00254Ar 2  A2 04                ldx     #4
00254Cr 2               @saveStep:
00254Cr 2  B5 0E                lda     FAC,x
00254Er 2  95 53                sta     BAS_TEMP2+1,x
002550r 2  CA                   dex
002551r 2  10 F9                bpl     @saveStep
002553r 2                       ; Now push the frame on stack (deepest first):
002553r 2                       ;   TXTPTR-hi, TXTPTR-lo, CURLIN-hi, CURLIN-lo,
002553r 2                       ;   LIMIT[4..0]   (deepest=LIMIT[4], so LIMIT[0] ends at $010A,x),
002553r 2                       ;   STEP-sign,
002553r 2                       ;   STEP[4..0]    (deepest=STEP[4], so STEP[0]  ends at $0104,x),
002553r 2                       ;   VAR-hi, VAR-lo, $81
002553r 2  A5 05                lda     TXTPTR+1
002555r 2  48                   pha
002556r 2  A5 04                lda     TXTPTR
002558r 2  48                   pha
002559r 2  AD 6A 03             lda     BAS_CURLIN+1
00255Cr 2  48                   pha
00255Dr 2  AD 69 03             lda     BAS_CURLIN
002560r 2  48                   pha
002561r 2  A2 04                ldx     #4
002563r 2               @pushLim:
002563r 2  B5 4D                lda     BAS_TEMP1,x
002565r 2  48                   pha
002566r 2  CA                   dex
002567r 2  10 FA                bpl     @pushLim
002569r 2  A5 52                lda     BAS_TEMP2               ; step sign
00256Br 2  48                   pha
00256Cr 2  A2 05                ldx     #5
00256Er 2               @pushStep:
00256Er 2  B5 52                lda     BAS_TEMP2,x
002570r 2  48                   pha
002571r 2  CA                   dex
002572r 2  D0 FA                bne     @pushStep
002574r 2  A5 47                lda     BAS_FORPNT+1
002576r 2  48                   pha
002577r 2  A5 46                lda     BAS_FORPNT
002579r 2  48                   pha
00257Ar 2  A9 81                lda     #TOK_FOR
00257Cr 2  48                   pha
00257Dr 2  4C rr rr             jmp     BasNewstt               ; resume statement loop with frame in place
002580r 2               
002580r 2               ConstOne:
002580r 2  81 00 00 00          .byte   $81,$00,$00,$00,$00     ; FP +1.0
002584r 2  00           
002585r 2               
002585r 2               ; ---------------------------------------------------------------------------
002585r 2               ; Statement: NEXT [var]
002585r 2               ; Locate matching FOR frame, increment var by step, test against limit,
002585r 2               ; loop back if more iterations remain, else discard frame and continue.
002585r 2               ; ---------------------------------------------------------------------------
002585r 2               BasCmdNext:
002585r 2  20 rr rr             jsr     ChrGot
002588r 2  F0 0D                beq     @anyVar
00258Ar 2  C9 3A                cmp     #':'
00258Cr 2  F0 09                beq     @anyVar
00258Er 2  20 rr rr             jsr     PtrGet
002591r 2  85 46                sta     BAS_FORPNT
002593r 2  84 47                sty     BAS_FORPNT+1
002595r 2  80 06                bra     @find
002597r 2               @anyVar:
002597r 2                       ; "NEXT" without a variable: set FORPNT = 0 so GtForPnt copies the
002597r 2                       ; stack-frame's var address into FORPNT and then trivially matches
002597r 2                       ; (any FOR frame is acceptable).
002597r 2  A9 00                lda     #0
002599r 2  85 46                sta     BAS_FORPNT
00259Br 2  85 47                sta     BAS_FORPNT+1
00259Dr 2               @find:
00259Dr 2                       ; Carry, not Z: GtForPnt's not-found paths end in `lda #0`, which sets
00259Dr 2                       ; Z, so testing `beq` here read "no frame" as "found" -- a bare NEXT
00259Dr 2                       ; then did `txs` onto a garbage offset and died as ?SYNTAX ERROR IN 0
00259Dr 2                       ; instead of ?NEXT WITHOUT FOR.
00259Dr 2  20 rr rr             jsr     GtForPnt
0025A0r 2  B0 05                bcs     @found
0025A2r 2  A2 0D                ldx     #ERR_NF
0025A4r 2  4C rr rr             jmp     BasErrorVec
0025A7r 2               @found:
0025A7r 2                       ; X = stack offset of (tag - 1).  txs makes SP = X so the frame
0025A7r 2                       ; sits at $101+X..$112+X.  All subsequent accesses use $0101+offset,x
0025A7r 2                       ; just like msbasic.
0025A7r 2  9A                   txs
0025A8r 2                       ; Frame layout (tag at $0101+X):
0025A8r 2                       ;   $0101+X = $81 tag
0025A8r 2                       ;   $0102+X = VAR-lo
0025A8r 2                       ;   $0103+X = VAR-hi
0025A8r 2                       ;   $0104+X..$0108+X = STEP (5 bytes FP, FAC[0..4] ascending)
0025A8r 2                       ;   $0109+X = STEP-sign
0025A8r 2                       ;   $010A+X..$010E+X = LIMIT (5 bytes FP, FAC[0..4] ascending)
0025A8r 2                       ;   $010F+X = CURLIN-lo
0025A8r 2                       ;   $0110+X = CURLIN-hi
0025A8r 2                       ;   $0111+X = TXTPTR-lo
0025A8r 2                       ;   $0112+X = TXTPTR-hi
0025A8r 2                       ; Load STEP into FAC.
0025A8r 2  A9 01                lda     #$01
0025AAr 2  85 3B                sta     BAS_TMP1+1
0025ACr 2  8A                   txa
0025ADr 2  18                   clc
0025AEr 2  69 04                adc     #$04
0025B0r 2  85 3A                sta     BAS_TMP1                ; TMP1 -> STEP[0] at $0104,x
0025B2r 2  A5 3A                lda     BAS_TMP1
0025B4r 2  A4 3B                ldy     BAS_TMP1+1
0025B6r 2  20 rr rr             jsr     LoadFacFromYa
0025B9r 2                       ; FACSIGN := step sign byte at $0109,x.
0025B9r 2  BD 09 01             lda     $0109,x
0025BCr 2  85 13                sta     FACSIGN
0025BEr 2                       ; FAC += variable.
0025BEr 2  BD 02 01             lda     $0102,x
0025C1r 2  BC 03 01             ldy     $0103,x
0025C4r 2  85 46                sta     BAS_FORPNT
0025C6r 2  84 47                sty     BAS_FORPNT+1
0025C8r 2  20 rr rr             jsr     FAdd
0025CBr 2  20 rr rr             jsr     SetFor
0025CEr 2                       ; Compare FAC with LIMIT (at $010A,x).
0025CEr 2  BA                   tsx                             ; reload x (FAdd may have used it)
0025CFr 2  8A                   txa
0025D0r 2  18                   clc
0025D1r 2  69 0A                adc     #$0A
0025D3r 2  85 3A                sta     BAS_TMP1
0025D5r 2  A9 01                lda     #$01
0025D7r 2  85 3B                sta     BAS_TMP1+1
0025D9r 2  A5 3A                lda     BAS_TMP1
0025DBr 2  A4 3B                ldy     BAS_TMP1+1
0025DDr 2  20 rr rr             jsr     FComp
0025E0r 2  BA                   tsx
0025E1r 2  38                   sec
0025E2r 2  FD 09 01             sbc     $0109,x                 ; A - step-sign
0025E5r 2  F0 19                beq     @loopDone
0025E7r 2                       ; Continue: restore CURLIN/TXTPTR from frame, JMP NEWSTT (don't RTS).
0025E7r 2  BD 0F 01             lda     $010F,x
0025EAr 2  8D 69 03             sta     BAS_CURLIN
0025EDr 2  BD 10 01             lda     $0110,x
0025F0r 2  8D 6A 03             sta     BAS_CURLIN+1
0025F3r 2  BD 11 01             lda     $0111,x
0025F6r 2  85 04                sta     TXTPTR
0025F8r 2  BD 12 01             lda     $0112,x
0025FBr 2  85 05                sta     TXTPTR+1
0025FDr 2  4C rr rr             jmp     BasNewstt
002600r 2               @loopDone:
002600r 2                       ; Discard frame: SP := X + 18.
002600r 2  8A                   txa
002601r 2  18                   clc
002602r 2  69 12                adc     #18
002604r 2  AA                   tax
002605r 2  9A                   txs
002606r 2                       ; Allow ", var" to chain into another NEXT.
002606r 2  20 rr rr             jsr     ChrGot
002609r 2  C9 2C                cmp     #','
00260Br 2  D0 06                bne     @retNewstt
00260Dr 2  20 rr rr             jsr     ChrGet
002610r 2  4C rr rr             jmp     BasCmdNext
002613r 2               @retNewstt:
002613r 2  4C rr rr             jmp     BasNewstt
002616r 2               
002616r 2               ; ---------------------------------------------------------------------------
002616r 2               ; Statement: DEF FN A(X) = expr
002616r 2               ; Stored in the variable's 5 value bytes:
002616r 2               ;   [TXTPTR-of-expr-lo][TXTPTR-of-expr-hi][param-name-lo][param-name-hi][0]
002616r 2               ; ---------------------------------------------------------------------------
002616r 2               BasCmdDef:
002616r 2                       ; Expect: FN <name>(<param>) = <expr>
002616r 2  A9 9D                lda     #TOK_FN
002618r 2  20 rr rr             jsr     SynChr
00261Br 2  09 80                ora     #$80
00261Dr 2  85 68                sta     SUBFLG                  ; tell PtrGet "this is a DEF FN var"
00261Fr 2  20 rr rr             jsr     PtrGet
002622r 2                       ; VARPNT = address of FN var slot.
002622r 2  85 81                sta     BAS_FNCNAM
002624r 2  84 82                sty     BAS_FNCNAM+1
002626r 2  20 rr rr             jsr     ChkNum
002629r 2                       ; Expect '(' name ')' = expr
002629r 2                       ; Param name parsed by recursive PtrGet inside FrmEvl on call;
002629r 2                       ; here we just record (param-name) by parsing it ourselves.
002629r 2  A9 28                lda     #'('
00262Br 2  20 rr rr             jsr     SynChr
00262Er 2  A9 80                lda     #$80
002630r 2  85 68                sta     SUBFLG
002632r 2  20 rr rr             jsr     PtrGet
002635r 2                       ; VARPNT = param var addr.  Save it.
002635r 2  A5 3F                lda     VARPNT
002637r 2  85 3A                sta     BAS_TMP1
002639r 2  A5 40                lda     VARPNT+1
00263Br 2  85 3B                sta     BAS_TMP1+1
00263Dr 2  20 rr rr             jsr     ChkNum
002640r 2  A9 29                lda     #')'
002642r 2  20 rr rr             jsr     SynChr
002645r 2  A9 3D                lda     #'='
002647r 2  20 rr rr             jsr     SynChr
00264Ar 2                       ; Reject in direct mode.
00264Ar 2  AD 6A 03             lda     BAS_CURLIN+1
00264Dr 2  C9 FF                cmp     #$FF
00264Fr 2  D0 05                bne     @ok
002651r 2  A2 07                ldx     #ERR_ILLDIRECT
002653r 2  4C rr rr             jmp     BasErrorVec
002656r 2               @ok:
002656r 2                       ; Store [TXTPTR][param][0] in FN var.
002656r 2  A0 00                ldy     #0
002658r 2  A5 04                lda     TXTPTR
00265Ar 2  91 81                sta     (BAS_FNCNAM),y
00265Cr 2  C8                   iny
00265Dr 2  A5 05                lda     TXTPTR+1
00265Fr 2  91 81                sta     (BAS_FNCNAM),y
002661r 2  C8                   iny
002662r 2  A5 3A                lda     BAS_TMP1
002664r 2  91 81                sta     (BAS_FNCNAM),y
002666r 2  C8                   iny
002667r 2  A5 3B                lda     BAS_TMP1+1
002669r 2  91 81                sta     (BAS_FNCNAM),y
00266Br 2  C8                   iny
00266Cr 2  A9 00                lda     #0
00266Er 2  91 81                sta     (BAS_FNCNAM),y
002670r 2                       ; Skip past expression body.
002670r 2  20 rr rr             jsr     BasDatan
002673r 2  4C rr rr             jmp     BasAddon
002676r 2               
002676r 2               ; ---------------------------------------------------------------------------
002676r 2               ; FnCall -- evaluator-side handler for "FN A(expr)".
002676r 2               ; Called by FrmEvl when it sees TOK_FN.  Evaluates argument, swaps in the
002676r 2               ; param's stored value, executes the FN expression, and restores the param.
002676r 2               ; ---------------------------------------------------------------------------
002676r 2               FnCall:
002676r 2  20 rr rr             jsr     ChrGet                  ; consume FN
002679r 2  09 80                ora     #$80
00267Br 2  85 68                sta     SUBFLG
00267Dr 2  20 rr rr             jsr     PtrGet                  ; locate FN var
002680r 2  8D 73 03             sta     BAS_FNPTR               ; durable copy: FNCNAM lives in ZP and
002683r 2  8C 74 03             sty     BAS_FNPTR+1             ; is scratch for Garbag
002686r 2  85 81                sta     BAS_FNCNAM
002688r 2  84 82                sty     BAS_FNCNAM+1
00268Ar 2  20 rr rr             jsr     ChkNum
00268Dr 2                       ; Read param ptr from FN slot.
00268Dr 2  A0 02                ldy     #2
00268Fr 2  B1 81                lda     (BAS_FNCNAM),y
002691r 2  85 3F                sta     VARPNT
002693r 2  F0 57                beq     @undef
002695r 2  C8                   iny
002696r 2  B1 81                lda     (BAS_FNCNAM),y
002698r 2  85 40                sta     VARPNT+1
00269Ar 2                       ; Evaluate '(arg)'
00269Ar 2  A9 28                lda     #'('
00269Cr 2  20 rr rr             jsr     SynChr
00269Fr 2                       ; Save param's current FP value (5 bytes) on stack.
00269Fr 2  A0 04                ldy     #4
0026A1r 2               @savep:
0026A1r 2  B1 3F                lda     (VARPNT),y
0026A3r 2  48                   pha
0026A4r 2  88                   dey
0026A5r 2  10 FA                bpl     @savep
0026A7r 2                       ; Evaluate argument -> FAC.
0026A7r 2  20 rr rr             jsr     FrmNum
0026AAr 2  A9 29                lda     #')'
0026ACr 2  20 rr rr             jsr     SynChr
0026AFr 2                       ; Any variable reference in the argument re-pointed VARPNT (and Garbag
0026AFr 2                       ; may have eaten FNCNAM) — reload both before storing the argument.
0026AFr 2  20 rr rr             jsr     @reload
0026B2r 2                       ; Store FAC into param slot.
0026B2r 2  A6 3F                ldx     VARPNT
0026B4r 2  A4 40                ldy     VARPNT+1
0026B6r 2  20 rr rr             jsr     StoreFacAtYxRounded
0026B9r 2                       ; Save current TXTPTR.
0026B9r 2  A5 05                lda     TXTPTR+1
0026BBr 2  48                   pha
0026BCr 2  A5 04                lda     TXTPTR
0026BEr 2  48                   pha
0026BFr 2                       ; Switch TXTPTR to FN expression body.
0026BFr 2  A0 00                ldy     #0
0026C1r 2  B1 81                lda     (BAS_FNCNAM),y
0026C3r 2  85 04                sta     TXTPTR
0026C5r 2  C8                   iny
0026C6r 2  B1 81                lda     (BAS_FNCNAM),y
0026C8r 2  85 05                sta     TXTPTR+1
0026CAr 2                       ; Body TXTPTR is positioned at the first byte; we need it positioned
0026CAr 2                       ; one BEFORE so FrmNum's first ChrGet loads the first byte.  Decrement.
0026CAr 2  A5 04                lda     TXTPTR
0026CCr 2  D0 02                bne     @noBor
0026CEr 2  C6 05                dec     TXTPTR+1
0026D0r 2               @noBor:
0026D0r 2  C6 04                dec     TXTPTR
0026D2r 2                       ; Evaluate the FN expression body.
0026D2r 2  20 rr rr             jsr     ChrGet
0026D5r 2  20 rr rr             jsr     FrmNum
0026D8r 2                       ; Restore TXTPTR.
0026D8r 2  68                   pla
0026D9r 2  85 04                sta     TXTPTR
0026DBr 2  68                   pla
0026DCr 2  85 05                sta     TXTPTR+1
0026DEr 2                       ; Restore param.  VARPNT may have been clobbered; reload.
0026DEr 2  20 rr rr             jsr     @reload
0026E1r 2  A0 00                ldy     #0
0026E3r 2               @restp:
0026E3r 2  68                   pla
0026E4r 2  91 3F                sta     (VARPNT),y
0026E6r 2  C8                   iny
0026E7r 2  C0 05                cpy     #5
0026E9r 2  D0 F8                bne     @restp
0026EBr 2  60                   rts
0026ECr 2               @undef:
0026ECr 2  A2 03                ldx     #ERR_UNDEFSTMT
0026EEr 2  4C rr rr             jmp     BasErrorVec
0026F1r 2               ; Re-seed FNCNAM from BAS_FNPTR and VARPNT from the FN slot's param pointer.
0026F1r 2               ; Preserves FAC (touches A and Y only).
0026F1r 2               @reload:
0026F1r 2  AD 73 03             lda     BAS_FNPTR
0026F4r 2  85 81                sta     BAS_FNCNAM
0026F6r 2  AD 74 03             lda     BAS_FNPTR+1
0026F9r 2  85 82                sta     BAS_FNCNAM+1
0026FBr 2  A0 02                ldy     #2
0026FDr 2  B1 81                lda     (BAS_FNCNAM),y
0026FFr 2  85 3F                sta     VARPNT
002701r 2  C8                   iny
002702r 2  B1 81                lda     (BAS_FNCNAM),y
002704r 2  85 40                sta     VARPNT+1
002706r 2  60                   rts
002707r 2               
002707r 2               ; ---------------------------------------------------------------------------
002707r 2               ; BasCmdDim -- DIM statement.  Dimension one or more arrays.
002707r 2               ;   On entry ChrGet has advanced past the DIM token, so A = first char of the
002707r 2               ;   first variable name.  For each name we call PtrGet2 with the from-DIM flag
002707r 2               ;   ($40) set in X; the '(' branch runs Array -> MakeNewArray, which allocates
002707r 2               ;   the array using the subscripts as sizes (0..N) and returns without looking
002707r 2               ;   up an element (DIMFLG nonzero).  Names are separated by commas.
002707r 2               ; ---------------------------------------------------------------------------
002707r 2               BasCmdDim:
002707r 2  A2 40                ldx     #$40                    ; from-DIM flag (bit 6)
002709r 2  20 rr rr             jsr     PtrGet2                 ; A = name char; create/dimension array
00270Cr 2  20 rr rr             jsr     ChrGot
00270Fr 2  C9 2C                cmp     #','
002711r 2  D0 05                bne     @done
002713r 2  20 rr rr             jsr     ChrGet                  ; consume comma, advance to next name
002716r 2  80 EF                bra     BasCmdDim
002718r 2               @done:
002718r 2  60                   rts
002719r 2               
002719r 2               ; ===========================================================================
002719r 2               ;   H A R D W A R E - E X T E N S I O N   S T A T E M E N T S
002719r 2               ; ===========================================================================
002719r 2               
002719r 2               ; --- Helpers --------------------------------------------------------------
002719r 2               
002719r 2               ; Raise ?NO DEVICE error.
002719r 2               NoDevErr:
002719r 2  A2 0F                ldx     #ERR_NODEV
00271Br 2  4C rr rr             jmp     BasErrorVec
00271Er 2               
00271Er 2               ; Require A bits in HW_PRESENT (else ?NO DEVICE).
00271Er 2               ;   Input : A = mask
00271Er 2               ;   Output: A preserved on success
00271Er 2               ReqHw:
00271Er 2  2D 0D 03             and     HW_PRESENT
002721r 2  F0 F6                beq     NoDevErr
002723r 2  60                   rts
002724r 2               
002724r 2               ; Evaluate expression -> A in 0..255.
002724r 2               ;   On entry: ChrGot positioned at first byte of expression.
002724r 2               ;   On exit : A = byte, ChrGot returns char following expression.
002724r 2               EvalU8:
002724r 2  20 rr rr             jsr     GetByt                  ; X = byte, jmp ChrGot
002727r 2  8A                   txa
002728r 2  60                   rts
002729r 2               
002729r 2               ; Evaluate expression as 16-bit signed -> FAC+3 (hi), FAC+4 (lo).
002729r 2               EvalU16:
002729r 2  20 rr rr             jsr     FrmNum
00272Cr 2  20 rr rr             jsr     AyInt
00272Fr 2  4C rr rr             jmp     ChrGot
002732r 2               
002732r 2               ; Evaluate expression as 16-bit unsigned address (0..65535)
002732r 2               ;   -> FAC+3 (hi), FAC+4 (lo).  Used by SYS, POKE, PEEK, WAIT so the full
002732r 2               ;   6502 address space is reachable with positive decimal literals.
002732r 2               ;   Truncates fractional part.  Negative or >= 65536 raises ?ILLEGAL QUANTITY.
002732r 2               EvalAddrU16:
002732r 2  20 rr rr             jsr     FrmNum
002735r 2  20 rr rr             jsr     FacToU16
002738r 2  4C rr rr             jmp     ChrGot
00273Br 2               
00273Br 2               ; FacToU16 -- Convert FAC (must be 0..65535) to FAC+3 (hi), FAC+4 (lo).
00273Br 2               ;   Negative or >= 65536 raises ?ILLEGAL QUANTITY.  Truncates fractional part.
00273Br 2               FacToU16:
00273Br 2  24 13                bit     FACSIGN
00273Dr 2  30 34                bmi     @illqty
00273Fr 2  A5 0E                lda     FAC                     ; exponent byte (0 = value is zero)
002741r 2  F0 2B                beq     @zero
002743r 2  C9 91                cmp     #$91                    ; exp >= $91 means value >= 65536
002745r 2  B0 2C                bcs     @illqty
002747r 2                       ; Reconstruct top 16 bits of mantissa (with hidden 1 bit).
002747r 2  48                   pha                             ; save exponent byte
002748r 2  A5 0F                lda     FAC+1
00274Ar 2  09 80                ora     #$80                    ; restore hidden bit
00274Cr 2  85 3B                sta     BAS_TMP1+1              ; hi
00274Er 2  A5 10                lda     FAC+2
002750r 2  85 3A                sta     BAS_TMP1                ; lo
002752r 2                       ; Shift count = $90 - exp_byte (0..15).
002752r 2  68                   pla
002753r 2  38                   sec
002754r 2  E9 90                sbc     #$90
002756r 2  49 FF                eor     #$FF
002758r 2  18                   clc
002759r 2  69 01                adc     #1                      ; A = $90 - exp
00275Br 2  F0 08                beq     @store                  ; zero shifts: already aligned
00275Dr 2  AA                   tax
00275Er 2               @shloop:
00275Er 2  46 3B                lsr     BAS_TMP1+1
002760r 2  66 3A                ror     BAS_TMP1
002762r 2  CA                   dex
002763r 2  D0 F9                bne     @shloop
002765r 2               @store:
002765r 2  A5 3B                lda     BAS_TMP1+1
002767r 2  85 11                sta     FAC+3
002769r 2  A5 3A                lda     BAS_TMP1
00276Br 2  85 12                sta     FAC+4
00276Dr 2  60                   rts
00276Er 2               @zero:
00276Er 2  64 11                stz     FAC+3
002770r 2  64 12                stz     FAC+4
002772r 2  60                   rts
002773r 2               @illqty:
002773r 2  4C rr rr             jmp     IqErr
002776r 2               
002776r 2               ; Evaluate string expression -> copy up to 12 chars to BAS_FNAME,
002776r 2               ; null-terminate, set STR_PTR := BAS_FNAME, free temp string.
002776r 2               ; 12 = full 8.3 form ("NAME.EXT" = 8 name + '.' + 3 ext).
002776r 2               EvalString:
002776r 2  20 rr rr             jsr     FrmEvl
002779r 2  20 rr rr             jsr     ChkStr
00277Cr 2  A5 0F                lda     FAC+1
00277Er 2  85 20                sta     INDEX
002780r 2  A5 10                lda     FAC+2
002782r 2  85 21                sta     INDEX+1
002784r 2  A0 00                ldy     #0
002786r 2  A6 0E                ldx     FAC                     ; length
002788r 2               @cpy:
002788r 2  C0 0C                cpy     #12
00278Ar 2  F0 0D                beq     @done
00278Cr 2  E0 00                cpx     #0
00278Er 2  F0 09                beq     @done
002790r 2  B1 20                lda     (INDEX),y
002792r 2  99 81 03             sta     BAS_FNAME,y
002795r 2  C8                   iny
002796r 2  CA                   dex
002797r 2  80 EF                bra     @cpy
002799r 2               @done:
002799r 2  A9 00                lda     #0
00279Br 2  99 81 03             sta     BAS_FNAME,y
00279Er 2  A9 81                lda     #<BAS_FNAME
0027A0r 2  85 02                sta     STR_PTR
0027A2r 2  A9 03                lda     #>BAS_FNAME
0027A4r 2  85 03                sta     STR_PTR+1
0027A6r 2  4C rr rr             jmp     FreFac
0027A9r 2               
0027A9r 2               ; Print A as 2-digit decimal with leading zero (used by TIME/DATE).
0027A9r 2               BasPr2D:
0027A9r 2  A2 00                ldx     #0
0027ABr 2               @loop:
0027ABr 2  C9 0A                cmp     #10
0027ADr 2  90 05                bcc     @done
0027AFr 2  E9 0A                sbc     #10
0027B1r 2  E8                   inx
0027B2r 2  80 F7                bra     @loop
0027B4r 2               @done:
0027B4r 2  48                   pha
0027B5r 2  8A                   txa
0027B6r 2  09 30                ora     #'0'
0027B8r 2  20 rr rr             jsr     Chrout
0027BBr 2  68                   pla
0027BCr 2  09 30                ora     #'0'
0027BEr 2  4C rr rr             jmp     Chrout
0027C1r 2               
0027C1r 2               ; BasFixChain -- recompute end-of-program pointers after a program image load.
0027C1r 2               ; A program image is the raw bytes belonging at $0800 up: a tokenized line chain
0027C1r 2               ; and, for a .prg, machine code sitting past the chain's $0000 terminator.  A
0027C1r 2               ; chain walk alone only ever finds the end of the BASIC part, so the loader's
0027C1r 2               ; byte count has to be taken into account too.
0027C1r 2               ;   Input:  A = loaded image size lo, Y = size hi (0 = size unknown; chain only)
0027C1r 2               ;   Output: BAS_VARTAB = BAS_ARYTAB = BAS_STREND
0027C1r 2               ;             = max(chain-end + 2, PROGRAM_START + size)
0027C1r 2               ;   Note:   a size that would push the result past BAS_MEMSIZ is rejected and the
0027C1r 2               ;           chain-end candidate is used instead.
0027C1r 2               ; Mirroring VARTAB into ARYTAB/STREND matters on its own: Makenewvariable places
0027C1r 2               ; a new scalar at ARYTAB, so leaving it at its post-NEW $0802 makes the first
0027C1r 2               ; direct-mode assignment after a LOAD overwrite the program's first line.
0027C1r 2                       .assert (PROGRAM_START & $FF) = 0, error, "PROGRAM_START must be page-aligned"
0027C1r 2               BasFixChain:
0027C1r 2  85 3C                sta     BAS_TMP2                ; BAS_TMP2 = PROGRAM_START + size; the
0027C3r 2  98                   tya                             ; low byte passes through untouched
0027C4r 2  18                   clc                             ; because PROGRAM_START is page-aligned
0027C5r 2  69 08                adc     #>PROGRAM_START
0027C7r 2  85 3D                sta     BAS_TMP2+1
0027C9r 2  64 20                stz     INDEX
0027CBr 2  A9 08                lda     #>PROGRAM_START
0027CDr 2  85 21                sta     INDEX+1
0027CFr 2               @walk:
0027CFr 2  A0 01                ldy     #1
0027D1r 2  B1 20                lda     (INDEX),y               ; next-ptr hi
0027D3r 2  85 3A                sta     BAS_TMP1
0027D5r 2  88                   dey
0027D6r 2  11 20                ora     (INDEX),y               ; both bytes zero -> terminator
0027D8r 2  F0 15                beq     @end
0027DAr 2                       ; Lines ascend in memory.  LOAD accepts any file, so a corrupt or
0027DAr 2                       ; cyclic chain is reachable here — stop at the last good line rather
0027DAr 2                       ; than loop forever.
0027DAr 2  38                   sec
0027DBr 2  A5 20                lda     INDEX
0027DDr 2  F1 20                sbc     (INDEX),y
0027DFr 2  A5 21                lda     INDEX+1
0027E1r 2  E5 3A                sbc     BAS_TMP1
0027E3r 2  B0 0A                bcs     @end                    ; current >= next -> not a real chain
0027E5r 2  B1 20                lda     (INDEX),y               ; next-ptr lo
0027E7r 2  85 20                sta     INDEX
0027E9r 2  A5 3A                lda     BAS_TMP1
0027EBr 2  85 21                sta     INDEX+1
0027EDr 2  80 E0                bra     @walk
0027EFr 2               @end:
0027EFr 2                       ; INDEX points at terminator ($00 $00).  Candidate A = INDEX + 2.
0027EFr 2  18                   clc
0027F0r 2  A5 20                lda     INDEX
0027F2r 2  69 02                adc     #2
0027F4r 2  8D 5F 03             sta     BAS_VARTAB
0027F7r 2  A5 21                lda     INDEX+1
0027F9r 2  69 00                adc     #0
0027FBr 2  8D 60 03             sta     BAS_VARTAB+1
0027FEr 2                       ; Candidate B = BAS_TMP2.  Keep it only when A <= B <= MEMSIZ, so a
0027FEr 2                       ; short or absent size loses the max and a bogus one cannot push
0027FEr 2                       ; VARTAB out of memory.
0027FEr 2  38                   sec
0027FFr 2  A5 3C                lda     BAS_TMP2
002801r 2  ED 5F 03             sbc     BAS_VARTAB
002804r 2  A5 3D                lda     BAS_TMP2+1
002806r 2  ED 60 03             sbc     BAS_VARTAB+1
002809r 2  90 17                bcc     @mirror                 ; B < A -> keep A
00280Br 2  38                   sec
00280Cr 2  AD 67 03             lda     BAS_MEMSIZ
00280Fr 2  E5 3C                sbc     BAS_TMP2
002811r 2  AD 68 03             lda     BAS_MEMSIZ+1
002814r 2  E5 3D                sbc     BAS_TMP2+1
002816r 2  90 0A                bcc     @mirror                 ; B > MEMSIZ -> reject, keep A
002818r 2  A5 3C                lda     BAS_TMP2
00281Ar 2  8D 5F 03             sta     BAS_VARTAB
00281Dr 2  A5 3D                lda     BAS_TMP2+1
00281Fr 2  8D 60 03             sta     BAS_VARTAB+1
002822r 2               @mirror:
002822r 2                       ; ARYTAB / STREND follow VARTAB on a fresh load: no variables yet.
002822r 2  A2 01                ldx     #1
002824r 2               @copy:
002824r 2  BD 5F 03             lda     BAS_VARTAB,x
002827r 2  9D 61 03             sta     BAS_ARYTAB,x
00282Ar 2  9D 63 03             sta     BAS_STREND,x
00282Dr 2  CA                   dex
00282Er 2  10 F4                bpl     @copy
002830r 2  60                   rts
002831r 2               
