00287Fr 2               
00287Fr 2               ; SOUND voice, freq, dur (freq=Hz, dur=centisec)
00287Fr 2               ;   Hz -> SID register: reg = Hz * 16.75 ≈ Hz<<4 + Hz - Hz/4
00287Fr 2               BasCmdSound:
00287Fr 2  A9 40                lda     #HW_SID
002881r 2  20 rr rr             jsr     ReqHw
