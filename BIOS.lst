0023F5r 2               ; ---------------------------------------------------------------------------
0023F5r 2               ; Statement: INPUT [<"prompt">{,;}] var[,var,...]
0023F5r 2               ;   Prompts user for input, reads a line, parses it into the variable list.
0023F5r 2               ;   "abc";VAR  prints  abc?    (question + space appended)
0023F5r 2               ;   "abc",VAR  prints  abc      (no question mark)
0023F5r 2               ;   no prompt: prints  ?
0023F5r 2               ;   On bad numeric input or premature end-of-line: "?REDO FROM START"
0023F5r 2               ;   and reprompt.  Trailing un-consumed input: "?EXTRA IGNORED".
0023F5r 2               ; ---------------------------------------------------------------------------
0023F5r 2               BasCmdInput:
0023F5r 2                       ; INPUT is illegal in direct mode.
0023F5r 2  AD 6A 03             lda     BAS_CURLIN+1
0023F8r 2  C9 FF                cmp     #$FF
0023FAr 2  D0 05                bne     @notDirect
0023FCr 2  A2 07                ldx     #ERR_ILLDIRECT
0023FEr 2  4C rr rr             jmp     BasErrorVec
002401r 2               @notDirect:
002401r 2                       ; ChrGot returns first char after the INPUT token.
002401r 2  20 rr rr             jsr     ChrGot
002404r 2  C9 22                cmp     #'"'
002406r 2  D0 27                bne     @noPrompt
002408r 2                       ; Parse string literal & print it; FrmEvl will leave descriptor in FAC.
002408r 2  20 rr rr             jsr     FrmEvl
00240Br 2  20 rr rr             jsr     ChkStr
00240Er 2  20 rr rr             jsr     PrintStrFAC
002411r 2  20 rr rr             jsr     FreFac
002414r 2  20 rr rr             jsr     ChrGot
002417r 2  C9 3B                cmp     #';'
002419r 2  F0 09                beq     @semi
00241Br 2  C9 2C                cmp     #','
00241Dr 2  D0 0D                bne     @badPrompt
00241Fr 2  20 rr rr             jsr     ChrGet                  ; consume ','
002422r 2  80 0E                bra     @afterPrompt
002424r 2               @semi:
002424r 2  20 rr rr             jsr     ChrGet                  ; consume ';'
002427r 2  20 rr rr             jsr     BasInpQues              ; '? '
00242Ar 2  80 06                bra     @afterPrompt
00242Cr 2               @badPrompt:
00242Cr 2  4C rr rr             jmp     SynErr
00242Fr 2               @noPrompt:
00242Fr 2  20 rr rr             jsr     BasInpQues              ; '? '
002432r 2               @afterPrompt:
002432r 2                       ; Save program TXTPTR (start of var-list) for REDO retry.
002432r 2  A5 04                lda     TXTPTR
002434r 2  8D 71 03             sta     BAS_INPSAV
002437r 2  A5 05                lda     TXTPTR+1
002439r 2  8D 72 03             sta     BAS_INPSAV+1
00243Cr 2               @retry:
00243Cr 2  20 rr rr             jsr     BasReadLine             ; reads to BAS_LINBUF, NUL-terminated, prints CRLF
00243Fr 2                       ; Set up data pointer with leading ',' sentinel just before LINBUF.
00243Fr 2  A9 2C                lda     #','
002441r 2  8D FF 03             sta     BAS_LINBUF-1
002444r 2  A9 FF                lda     #<(BAS_LINBUF-1)
002446r 2  85 3A                sta     BAS_TMP1
002448r 2  A9 03                lda     #>(BAS_LINBUF-1)
00244Ar 2  85 3B                sta     BAS_TMP1+1
00244Cr 2                       ; Restore program TXTPTR.
00244Cr 2  AD 71 03             lda     BAS_INPSAV
00244Fr 2  85 04                sta     TXTPTR
002451r 2  AD 72 03             lda     BAS_INPSAV+1
002454r 2  85 05                sta     TXTPTR+1
002456r 2  64 69                stz     BAS_INPUTFLG            ; INPUT mode ($00)
002458r 2               @nextVar:
002458r 2  20 rr rr             jsr     PtrGet                  ; advance program TXTPTR past var name
00245Br 2  85 46                sta     BAS_FORPNT
00245Dr 2  84 47                sty     BAS_FORPNT+1
00245Fr 2                       ; Save program TXTPTR; switch to data side.
00245Fr 2  A5 05                lda     TXTPTR+1
002461r 2  48                   pha
002462r 2  A5 04                lda     TXTPTR
002464r 2  48                   pha
002465r 2  A5 3A                lda     BAS_TMP1
002467r 2  85 04                sta     TXTPTR
002469r 2  A5 3B                lda     BAS_TMP1+1
00246Br 2  85 05                sta     TXTPTR+1
00246Dr 2  20 rr rr             jsr     ChrGot
002470r 2  D0 05                bne     @gotData
002472r 2                       ; Out of input data before var list exhausted -> REDO.
002472r 2  68                   pla
002473r 2  68                   pla
002474r 2  4C rr rr             jmp     @doRedo
002477r 2               @gotData:
002477r 2  20 rr rr             jsr     ChrGet                  ; consume the separator/sentinel
00247Ar 2  24 64                bit     VALTYP
00247Cr 2  30 2E                bmi     @inpStr
00247Er 2                       ; Numeric: must start with digit, '+', '-' or '.'; else REDO.
00247Er 2  20 rr rr             jsr     ChrGot
002481r 2  90 11                bcc     @numOk                  ; carry clear == digit
002483r 2  C9 2D                cmp     #'-'
002485r 2  F0 0D                beq     @numOk
002487r 2  C9 2B                cmp     #'+'
002489r 2  F0 09                beq     @numOk
00248Br 2  C9 2E                cmp     #'.'
00248Dr 2  F0 05                beq     @numOk
00248Fr 2                       ; bad numeric
00248Fr 2  68                   pla
002490r 2  68                   pla
002491r 2  4C rr rr             jmp     @doRedo
002494r 2               @numOk:
002494r 2  20 rr rr             jsr     Fin
002497r 2  A6 46                ldx     BAS_FORPNT
002499r 2  A4 47                ldy     BAS_FORPNT+1
00249Br 2  20 rr rr             jsr     StoreFacAtYxRounded
00249Er 2                       ; After Fin, ChrGot result must be NUL or ',' (Fin/ChrGot skips spaces).
00249Er 2  20 rr rr             jsr     ChrGot
0024A1r 2  F0 0E                beq     @afterStore
0024A3r 2  C9 2C                cmp     #','
0024A5r 2  F0 0A                beq     @afterStore
0024A7r 2                       ; Garbage trailing the number -> REDO.
0024A7r 2  68                   pla
0024A8r 2  68                   pla
0024A9r 2  4C rr rr             jmp     @doRedo
0024ACr 2               @inpStr:
0024ACr 2  A2 00                ldx     #0                      ; INPUT stops an unquoted item at ',' only
0024AEr 2  20 rr rr             jsr     BasStrItem
0024B1r 2               @afterStore:
0024B1r 2                       ; Save data ptr; restore program TXTPTR.
0024B1r 2  A5 04                lda     TXTPTR
0024B3r 2  85 3A                sta     BAS_TMP1
0024B5r 2  A5 05                lda     TXTPTR+1
0024B7r 2  85 3B                sta     BAS_TMP1+1
0024B9r 2  68                   pla
0024BAr 2  85 04                sta     TXTPTR
0024BCr 2  68                   pla
0024BDr 2  85 05                sta     TXTPTR+1
0024BFr 2                       ; More variables?
0024BFr 2  20 rr rr             jsr     ChrGot
0024C2r 2  C9 2C                cmp     #','
0024C4r 2  D0 06                bne     @doneVars
0024C6r 2  20 rr rr             jsr     ChrGet                  ; consume ','
0024C9r 2  4C rr rr             jmp     @nextVar
0024CCr 2               @doneVars:
0024CCr 2                       ; Check for un-consumed input (EXTRA IGNORED).
0024CCr 2  A0 00                ldy     #0
0024CEr 2  B1 3A                lda     (BAS_TMP1),y
0024D0r 2  F0 12                beq     @inpDone
0024D2r 2                       ; Skip leading spaces; anything else is "extra".
0024D2r 2               @chkExtra:
0024D2r 2  B1 3A                lda     (BAS_TMP1),y
0024D4r 2  F0 0E                beq     @inpDone
0024D6r 2  C9 20                cmp     #' '
0024D8r 2  D0 03                bne     @hasExtra
0024DAr 2  C8                   iny
0024DBr 2  D0 F5                bne     @chkExtra
0024DDr 2               @hasExtra:
0024DDr 2  A9 rr                lda     #<MsgExtra
0024DFr 2  A0 rr                ldy     #>MsgExtra
0024E1r 2  20 rr rr             jsr     BasPrintStr
0024E4r 2               @inpDone:
0024E4r 2  60                   rts
0024E5r 2               @doRedo:
0024E5r 2  A9 rr                lda     #<MsgRedo
0024E7r 2  A0 rr                ldy     #>MsgRedo
0024E9r 2  20 rr rr             jsr     BasPrintStr
0024ECr 2  4C rr rr             jmp     @retry
0024EFr 2               
0024EFr 2               ; Print "? " prompt (used by INPUT and the ';' prompt-suffix path).
0024EFr 2               BasInpQues:
0024EFr 2  A9 3F                lda     #'?'
0024F1r 2  20 rr rr             jsr     PrintCh
0024F4r 2  A9 20                lda     #' '
0024F6r 2  4C rr rr             jmp     PrintCh
0024F9r 2               
0024F9r 2               MsgRedo:
0024F9r 2  3F 52 45 44          .byte   "?REDO FROM START", $0D, $0A, 0
0024FDr 2  4F 20 46 52  
002501r 2  4F 4D 20 53  
00250Cr 2               MsgExtra:
00250Cr 2  3F 45 58 54          .byte   "?EXTRA IGNORED", $0D, $0A, 0
002510r 2  52 41 20 49  
002514r 2  47 4E 4F 52  
00251Dr 2               
00251Dr 2               ; ---------------------------------------------------------------------------
00251Dr 2               ; Statement: READ var[,var,...] -- pull next DATA item from BAS_DATAPTR
00251Dr 2               ; into the variable pointed to by PtrGet.
00251Dr 2               ; ---------------------------------------------------------------------------
00251Dr 2               ; ---------------------------------------------------------------------------
00251Dr 2               ; BasStrItem -- read one string item at TXTPTR into the variable BAS_FORPNT
00251Dr 2               ; points at.  Shared by INPUT and READ, which differ only in what ends an
00251Dr 2               ; unquoted item: INPUT stops at ',' or NUL, READ also stops at ':' because a
00251Dr 2               ; DATA statement can be followed by another statement on the same line.
00251Dr 2               ;
00251Dr 2               ; On entry : X        = the extra unquoted terminator (StrLt2's CHARAC)
00251Dr 2               ;            TXTPTR   = first character of the item
00251Dr 2               ;            FORPNT   = the variable's 3-byte descriptor slot
00251Dr 2               ; On exit  : TXTPTR advanced past the item, descriptor stored, temp popped.
00251Dr 2               ; ---------------------------------------------------------------------------
00251Dr 2               BasStrItem:
00251Dr 2                       ; A '"' here means quote-mode (terminator '"' or NUL); anything else
00251Dr 2                       ; is a bare item running to X, ',' or NUL.
00251Dr 2  A0 00                ldy     #0
00251Fr 2  B1 04                lda     (TXTPTR),y
002521r 2  C9 22                cmp     #'"'
002523r 2  F0 0C                beq     @quoted
002525r 2  86 44                stx     CHARAC
002527r 2  A9 2C                lda     #','
002529r 2  85 6A                sta     ENDCHR
00252Br 2  A5 04                lda     TXTPTR                  ; StrLt2's source = TXTPTR
00252Dr 2  A4 05                ldy     TXTPTR+1
00252Fr 2  80 0E                bra     @call
002531r 2               @quoted:
002531r 2  85 44                sta     CHARAC                  ; A is still '"' from the compare
002533r 2  85 6A                sta     ENDCHR
002535r 2  18                   clc                             ; skip it: source = TXTPTR + 1
002536r 2  A5 04                lda     TXTPTR
002538r 2  69 01                adc     #1
00253Ar 2  A4 05                ldy     TXTPTR+1
00253Cr 2  90 01                bcc     @call
00253Er 2  C8                   iny
00253Fr 2               @call:
00253Fr 2  20 rr rr             jsr     StrLt2
002542r 2                       ; StrLt2 leaves STRNG2 past the text it consumed -- at the terminator
002542r 2                       ; for an unquoted item, just past the closing '"' for a quoted one.
002542r 2                       ; TXTPTR has to follow it: for INPUT so the trailing-extra check sees
002542r 2                       ; only what really remained on the line, and for READ so the next one
002542r 2                       ; doesn't start again in the middle of the item this one took.
002542r 2  A5 1E                lda     STRNG2
002544r 2  85 04                sta     TXTPTR
002546r 2  A5 1F                lda     STRNG2+1
002548r 2  85 05                sta     TXTPTR+1
00254Ar 2  A0 00                ldy     #0
00254Cr 2  A5 0E                lda     FAC
00254Er 2  91 46                sta     (BAS_FORPNT),y
002550r 2  C8                   iny
002551r 2  A5 0F                lda     FAC+1
002553r 2  91 46                sta     (BAS_FORPNT),y
002555r 2  C8                   iny
002556r 2  A5 10                lda     FAC+2
002558r 2  91 46                sta     (BAS_FORPNT),y
00255Ar 2                       ; StrLt2 pushed a temporary descriptor via PutNew.  The variable owns
00255Ar 2                       ; the heap copy now, so pop the temp -- do NOT use FreFac, which would
00255Ar 2                       ; reclaim the heap we just handed over.  Leaving temps unfreed leaks
00255Ar 2                       ; the 3-slot temp stack, both overflowing it (?FORMULA TOO COMPLEX)
00255Ar 2                       ; and corrupting later strings via stale descriptor pointers.
00255Ar 2  A5 11                lda     FAC+3
00255Cr 2  A4 12                ldy     FAC+4
00255Er 2  4C rr rr             jmp     FreTms
002561r 2               
002561r 2               BasCmdRead:
002561r 2  AE 1A 03             ldx     BAS_DATAPTR
002564r 2  AC 1B 03             ldy     BAS_DATAPTR+1
002567r 2  A9 98                lda     #$98                    ; INPUTFLG = $98 means READ mode
002569r 2  2C                   .byte   $2C
00256Ar 2               BasInpDoit:
00256Ar 2  A9 00                lda     #0
00256Cr 2  85 69                sta     BAS_INPUTFLG
00256Er 2  86 3A                stx     BAS_TMP1                ; TMP1 = data pointer
002570r 2  84 3B                sty     BAS_TMP1+1
002572r 2               @nextVar:
002572r 2                       ; TXTPTR currently points into program at variable name.
002572r 2  20 rr rr             jsr     PtrGet                  ; advances TXTPTR past var name
002575r 2  85 46                sta     BAS_FORPNT
002577r 2  84 47                sty     BAS_FORPNT+1
002579r 2                       ; Save program TXTPTR on hw stack, switch TXTPTR to data ptr.
002579r 2  A5 05                lda     TXTPTR+1
00257Br 2  48                   pha
00257Cr 2  A5 04                lda     TXTPTR
00257Er 2  48                   pha
00257Fr 2  A5 3A                lda     BAS_TMP1
002581r 2  85 04                sta     TXTPTR
002583r 2  A5 3B                lda     BAS_TMP1+1
002585r 2  85 05                sta     TXTPTR+1
002587r 2  20 rr rr             jsr     ChrGot
00258Ar 2  D0 08                bne     @gotData
00258Cr 2                       ; Out of items on this line - find next DATA.
00258Cr 2  20 rr rr             jsr     BasFindData
00258Fr 2  90 03                bcc     @gotData
002591r 2  4C rr rr             jmp     @oodata
002594r 2               @gotData:
002594r 2                       ; Advance past separator (',' between items, ' ' after DATA token,
002594r 2                       ; or quote-delimiter for strings).  ChrGet also skips spaces.
002594r 2  20 rr rr             jsr     ChrGet
002597r 2                       ; Parse value at TXTPTR (data side).
002597r 2  24 64                bit     VALTYP
002599r 2  30 0C                bmi     @readStr
00259Br 2                       ; Numeric.
00259Br 2  20 rr rr             jsr     Fin
00259Er 2  A6 46                ldx     BAS_FORPNT
0025A0r 2  A4 47                ldy     BAS_FORPNT+1
0025A2r 2  20 rr rr             jsr     StoreFacAtYxRounded
0025A5r 2  80 05                bra     @afterStore
0025A7r 2               @readStr:
0025A7r 2                       ; Previously this called StrLt2 without setting up its (A,Y) source
0025A7r 2                       ; argument at all, so every DATA string pointed into zero page: an
0025A7r 2                       ; unquoted item read back empty and a quoted one read back as garbage
0025A7r 2                       ; from $0022.  BasStrItem is INPUT's path, which had it right.
0025A7r 2  A2 3A                ldx     #':'                    ; a DATA item also ends at a statement break
0025A9r 2  20 rr rr             jsr     BasStrItem
0025ACr 2               @afterStore:
0025ACr 2                       ; Save updated data ptr.
0025ACr 2  A5 04                lda     TXTPTR
0025AEr 2  85 3A                sta     BAS_TMP1
0025B0r 2  A5 05                lda     TXTPTR+1
0025B2r 2  85 3B                sta     BAS_TMP1+1
0025B4r 2                       ; Restore program TXTPTR.
0025B4r 2  68                   pla
0025B5r 2  85 04                sta     TXTPTR
0025B7r 2  68                   pla
0025B8r 2  85 05                sta     TXTPTR+1
0025BAr 2                       ; If next program byte is ',', another variable follows.
0025BAr 2  20 rr rr             jsr     ChrGot
0025BDr 2  C9 2C                cmp     #','
0025BFr 2  D0 05                bne     @done
0025C1r 2  20 rr rr             jsr     ChrGet
0025C4r 2  80 AC                bra     @nextVar
0025C6r 2               @done:
0025C6r 2                       ; Persist data ptr.
0025C6r 2  A5 3A                lda     BAS_TMP1
0025C8r 2  8D 1A 03             sta     BAS_DATAPTR
0025CBr 2  A5 3B                lda     BAS_TMP1+1
0025CDr 2  8D 1B 03             sta     BAS_DATAPTR+1
0025D0r 2  60                   rts
0025D1r 2               @oodata:
0025D1r 2  A2 0E                ldx     #ERR_OD
0025D3r 2  4C rr rr             jmp     BasErrorVec
0025D6r 2               
0025D6r 2               ; ---------------------------------------------------------------------------
0025D6r 2               ; BasFindData -- starting from TXTPTR (positioned somewhere within a line's
0025D6r 2               ; payload), advance to the byte after the next DATA token in the program.
0025D6r 2               ; Returns carry SET on out-of-data, carry CLEAR with TXTPTR at first byte
0025D6r 2               ; AFTER the DATA token (i.e. at the first DATA item).
0025D6r 2               ; ---------------------------------------------------------------------------
0025D6r 2               BasFindData:
0025D6r 2               @scanByte:
0025D6r 2  A0 00                ldy     #0
0025D8r 2  B1 04                lda     (TXTPTR),y
0025DAr 2  F0 1F                beq     @atEnd
0025DCr 2  C9 83                cmp     #TOK_DATA
0025DEr 2  F0 2E                beq     @found
0025E0r 2  C9 22                cmp     #'"'
0025E2r 2  D0 12                bne     @advance1
0025E4r 2                       ; Skip quoted string (advance TXTPTR past closing quote or NUL).
0025E4r 2  20 rr rr             jsr     @incTxt
0025E7r 2               @inStr:
0025E7r 2  A0 00                ldy     #0
0025E9r 2  B1 04                lda     (TXTPTR),y
0025EBr 2  F0 0E                beq     @atEnd
0025EDr 2  20 rr rr             jsr     @incTxt
0025F0r 2  C9 22                cmp     #'"'
0025F2r 2  D0 F3                bne     @inStr
0025F4r 2  80 E0                bra     @scanByte
0025F6r 2               @advance1:
0025F6r 2  20 rr rr             jsr     @incTxt
0025F9r 2  80 DB                bra     @scanByte
0025FBr 2               @atEnd:
0025FBr 2                       ; (TXTPTR) is on the line's $00 terminator.  Bytes immediately after
0025FBr 2                       ; are the next line's [next-lo][next-hi][num-lo][num-hi][payload..].
0025FBr 2                       ; Check next-pointer at offset +2 (next-hi); if 0, end of program.
0025FBr 2  A0 02                ldy     #2
0025FDr 2  B1 04                lda     (TXTPTR),y
0025FFr 2  F0 0F                beq     @oodata
002601r 2                       ; Advance TXTPTR by 5: past terminator (1) + line header (4).
002601r 2  18                   clc
002602r 2  A5 04                lda     TXTPTR
002604r 2  69 05                adc     #5
002606r 2  85 04                sta     TXTPTR
002608r 2  90 CC                bcc     @scanByte
00260Ar 2  E6 05                inc     TXTPTR+1
00260Cr 2  80 C8                bra     @scanByte
00260Er 2               @found:
00260Er 2                       ; TXTPTR is left AT the TOK_DATA byte; caller's CHRGET advances past.
00260Er 2  18                   clc
00260Fr 2  60                   rts
002610r 2               @oodata:
002610r 2  38                   sec
002611r 2  60                   rts
002612r 2               @incTxt:
002612r 2  E6 04                inc     TXTPTR
002614r 2  D0 02                bne     @r
002616r 2  E6 05                inc     TXTPTR+1
002618r 2               @r:
002618r 2  60                   rts
002619r 2               
002619r 2               ; ---------------------------------------------------------------------------
002619r 2               ; Statement: FOR var = expr1 TO expr2 [STEP expr3]
002619r 2               ; Pushes 18-byte frame on CPU stack:
002619r 2               ;   [tag $81][VAR-lo][VAR-hi][STEP-FP (5)][STEP-sign][CURLIN-lo][CURLIN-hi]
002619r 2               ;   [TXTPTR-lo][TXTPTR-hi][LIMIT-FP (5)]
002619r 2               ; ---------------------------------------------------------------------------
002619r 2               BasCmdFor:
002619r 2                       ; Set SUBFLG so PtrGet doesn't recurse on FN.
002619r 2  A9 80                lda     #$80
00261Br 2  85 68                sta     SUBFLG
00261Dr 2  20 rr rr             jsr     BasCmdLet               ; consumes "var = expr"
002620r 2                       ; PtrGet (inside LET) saved VARPNT in FORPNT (hopefully). Re-fetch
002620r 2                       ; FORPNT from the assignment, but BasCmdLet doesn't set FORPNT in
002620r 2                       ; our impl.  Re-parse the variable name by rewinding TXTPTR via
002620r 2                       ; CURLIN scan.  Cheat: BasCmdLet leaves VARPNT current.
002620r 2  A5 3F                lda     VARPNT
002622r 2  85 46                sta     BAS_FORPNT
002624r 2  A5 40                lda     VARPNT+1
002626r 2  85 47                sta     BAS_FORPNT+1
002628r 2                       ; Discard any prior FOR frame for the same variable to avoid leak.
002628r 2  20 rr rr             jsr     GtForPnt
00262Br 2  90 00                bcc     @noOld                  ; carry clear -> no matching frame
00262Dr 2                       ; The prior-frame pop is still skipped: the runtime tolerates one stray
00262Dr 2                       ; frame, and msbasic re-uses the slot only when an explicit FOR with a
00262Dr 2                       ; matching variable already exists, which is rare. GtForPnt does now
00262Dr 2                       ; report found/not-found in carry (Z was ambiguous and unusable), so
00262Dr 2                       ; this branch is at least honest about which case it is in.
00262Dr 2               @noOld:
00262Dr 2                       ; Discard our caller's (BasExecuteStatement's) return address so
00262Dr 2                       ; that the FOR frame sits on the stack with no other junk above it.
00262Dr 2                       ; We will JMP BasNewstt at the end instead of RTSing.
00262Dr 2  68                   pla
00262Er 2  68                   pla
00262Fr 2                       ; Push limit (will be parsed below) -- we lay out the frame as:
00262Fr 2                       ;   pushed first (deepest): TXTPTR, CURLIN, LIMIT (5), STEP-sign,
00262Fr 2                       ;   STEP (5), VAR-addr, $81-tag.
00262Fr 2                       ; We don't know LIMIT/STEP yet; we push placeholders and patch.
00262Fr 2                       ; Easier: parse limit & step first, then push frame in one go.
00262Fr 2  A9 9C                lda     #TOK_TO
002631r 2  20 rr rr             jsr     SynChr
002634r 2  20 rr rr             jsr     FrmNum
002637r 2                       ; Strip sign info on limit (msbasic stores limit unsigned-magnitude
002637r 2                       ; with sign packed).  Pack FACSIGN bit 7 -> FAC+1 bit 7.
002637r 2  A5 13                lda     FACSIGN
002639r 2  09 7F                ora     #$7F
00263Br 2  25 0F                and     FAC+1
00263Dr 2  85 0F                sta     FAC+1
00263Fr 2                       ; Save LIMIT temporarily in BAS_TEMP1..+4 (5 bytes).
00263Fr 2  A2 04                ldx     #4
002641r 2               @saveLimit:
002641r 2  B5 0E                lda     FAC,x
002643r 2  95 4D                sta     BAS_TEMP1,x
002645r 2  CA                   dex
002646r 2  10 F9                bpl     @saveLimit
002648r 2                       ; STEP: default 1, or evaluate after TOK_STEP.
002648r 2  20 rr rr             jsr     ChrGot
00264Br 2  C9 A1                cmp     #TOK_STEP
00264Dr 2  D0 08                bne     @defStep
00264Fr 2  20 rr rr             jsr     ChrGet
002652r 2  20 rr rr             jsr     FrmNum
002655r 2  80 07                bra     @gotStep
002657r 2               @defStep:
002657r 2  A9 rr                lda     #<ConstOne
002659r 2  A0 rr                ldy     #>ConstOne
00265Br 2  20 rr rr             jsr     LoadFacFromYa
00265Er 2               @gotStep:
00265Er 2  20 rr rr             jsr     Sign                    ; A = step sign byte (-1/0/1)
002661r 2  85 52                sta     BAS_TEMP2               ; stash step sign
002663r 2                       ; Pack sign of FAC into FAC+1 bit7 then save STEP into BAS_TEMP2+1..+5.
002663r 2  A5 13                lda     FACSIGN
002665r 2  09 7F                ora     #$7F
002667r 2  25 0F                and     FAC+1
002669r 2  85 0F                sta     FAC+1
00266Br 2  A2 04                ldx     #4
00266Dr 2               @saveStep:
00266Dr 2  B5 0E                lda     FAC,x
00266Fr 2  95 53                sta     BAS_TEMP2+1,x
002671r 2  CA                   dex
002672r 2  10 F9                bpl     @saveStep
002674r 2                       ; Now push the frame on stack (deepest first):
002674r 2                       ;   TXTPTR-hi, TXTPTR-lo, CURLIN-hi, CURLIN-lo,
002674r 2                       ;   LIMIT[4..0]   (deepest=LIMIT[4], so LIMIT[0] ends at $010A,x),
002674r 2                       ;   STEP-sign,
002674r 2                       ;   STEP[4..0]    (deepest=STEP[4], so STEP[0]  ends at $0104,x),
002674r 2                       ;   VAR-hi, VAR-lo, $81
002674r 2  A5 05                lda     TXTPTR+1
002676r 2  48                   pha
002677r 2  A5 04                lda     TXTPTR
002679r 2  48                   pha
00267Ar 2  AD 6A 03             lda     BAS_CURLIN+1
00267Dr 2  48                   pha
00267Er 2  AD 69 03             lda     BAS_CURLIN
002681r 2  48                   pha
002682r 2  A2 04                ldx     #4
002684r 2               @pushLim:
002684r 2  B5 4D                lda     BAS_TEMP1,x
002686r 2  48                   pha
002687r 2  CA                   dex
002688r 2  10 FA                bpl     @pushLim
00268Ar 2  A5 52                lda     BAS_TEMP2               ; step sign
00268Cr 2  48                   pha
00268Dr 2  A2 05                ldx     #5
00268Fr 2               @pushStep:
00268Fr 2  B5 52                lda     BAS_TEMP2,x
002691r 2  48                   pha
002692r 2  CA                   dex
002693r 2  D0 FA                bne     @pushStep
002695r 2  A5 47                lda     BAS_FORPNT+1
002697r 2  48                   pha
002698r 2  A5 46                lda     BAS_FORPNT
00269Ar 2  48                   pha
00269Br 2  A9 81                lda     #TOK_FOR
00269Dr 2  48                   pha
00269Er 2  4C rr rr             jmp     BasNewstt               ; resume statement loop with frame in place
0026A1r 2               
0026A1r 2               ConstOne:
0026A1r 2  81 00 00 00          .byte   $81,$00,$00,$00,$00     ; FP +1.0
0026A5r 2  00           
0026A6r 2               
0026A6r 2               ; ---------------------------------------------------------------------------
0026A6r 2               ; Statement: NEXT [var]
0026A6r 2               ; Locate matching FOR frame, increment var by step, test against limit,
0026A6r 2               ; loop back if more iterations remain, else discard frame and continue.
0026A6r 2               ; ---------------------------------------------------------------------------
0026A6r 2               BasCmdNext:
0026A6r 2  20 rr rr             jsr     ChrGot
0026A9r 2  F0 0D                beq     @anyVar
0026ABr 2  C9 3A                cmp     #':'
0026ADr 2  F0 09                beq     @anyVar
0026AFr 2  20 rr rr             jsr     PtrGet
0026B2r 2  85 46                sta     BAS_FORPNT
0026B4r 2  84 47                sty     BAS_FORPNT+1
0026B6r 2  80 06                bra     @find
0026B8r 2               @anyVar:
0026B8r 2                       ; "NEXT" without a variable: set FORPNT = 0 so GtForPnt copies the
0026B8r 2                       ; stack-frame's var address into FORPNT and then trivially matches
0026B8r 2                       ; (any FOR frame is acceptable).
0026B8r 2  A9 00                lda     #0
0026BAr 2  85 46                sta     BAS_FORPNT
0026BCr 2  85 47                sta     BAS_FORPNT+1
0026BEr 2               @find:
0026BEr 2                       ; Carry, not Z: GtForPnt's not-found paths end in `lda #0`, which sets
0026BEr 2                       ; Z, so testing `beq` here read "no frame" as "found" -- a bare NEXT
0026BEr 2                       ; then did `txs` onto a garbage offset and died as ?SYNTAX ERROR IN 0
0026BEr 2                       ; instead of ?NEXT WITHOUT FOR.
0026BEr 2  20 rr rr             jsr     GtForPnt
0026C1r 2  B0 05                bcs     @found
0026C3r 2  A2 0D                ldx     #ERR_NF
0026C5r 2  4C rr rr             jmp     BasErrorVec
0026C8r 2               @found:
0026C8r 2                       ; X = stack offset of (tag - 1).  txs makes SP = X so the frame
0026C8r 2                       ; sits at $101+X..$112+X.  All subsequent accesses use $0101+offset,x
0026C8r 2                       ; just like msbasic.
0026C8r 2  9A                   txs
0026C9r 2                       ; Frame layout (tag at $0101+X):
0026C9r 2                       ;   $0101+X = $81 tag
0026C9r 2                       ;   $0102+X = VAR-lo
0026C9r 2                       ;   $0103+X = VAR-hi
0026C9r 2                       ;   $0104+X..$0108+X = STEP (5 bytes FP, FAC[0..4] ascending)
0026C9r 2                       ;   $0109+X = STEP-sign
0026C9r 2                       ;   $010A+X..$010E+X = LIMIT (5 bytes FP, FAC[0..4] ascending)
0026C9r 2                       ;   $010F+X = CURLIN-lo
0026C9r 2                       ;   $0110+X = CURLIN-hi
0026C9r 2                       ;   $0111+X = TXTPTR-lo
0026C9r 2                       ;   $0112+X = TXTPTR-hi
0026C9r 2                       ; Load STEP into FAC.
0026C9r 2  A9 01                lda     #$01
0026CBr 2  85 3B                sta     BAS_TMP1+1
0026CDr 2  8A                   txa
0026CEr 2  18                   clc
0026CFr 2  69 04                adc     #$04
0026D1r 2  85 3A                sta     BAS_TMP1                ; TMP1 -> STEP[0] at $0104,x
0026D3r 2  A5 3A                lda     BAS_TMP1
0026D5r 2  A4 3B                ldy     BAS_TMP1+1
0026D7r 2  20 rr rr             jsr     LoadFacFromYa
0026DAr 2                       ; FACSIGN := step sign byte at $0109,x.
0026DAr 2  BD 09 01             lda     $0109,x
0026DDr 2  85 13                sta     FACSIGN
0026DFr 2                       ; FAC += variable.
0026DFr 2  BD 02 01             lda     $0102,x
0026E2r 2  BC 03 01             ldy     $0103,x
0026E5r 2  85 46                sta     BAS_FORPNT
0026E7r 2  84 47                sty     BAS_FORPNT+1
0026E9r 2  20 rr rr             jsr     FAdd
0026ECr 2  20 rr rr             jsr     SetFor
0026EFr 2                       ; Compare FAC with LIMIT (at $010A,x).
0026EFr 2  BA                   tsx                             ; reload x (FAdd may have used it)
0026F0r 2  8A                   txa
0026F1r 2  18                   clc
0026F2r 2  69 0A                adc     #$0A
0026F4r 2  85 3A                sta     BAS_TMP1
0026F6r 2  A9 01                lda     #$01
0026F8r 2  85 3B                sta     BAS_TMP1+1
0026FAr 2  A5 3A                lda     BAS_TMP1
0026FCr 2  A4 3B                ldy     BAS_TMP1+1
0026FEr 2  20 rr rr             jsr     FComp
002701r 2  BA                   tsx
002702r 2  38                   sec
002703r 2  FD 09 01             sbc     $0109,x                 ; A - step-sign
002706r 2  F0 19                beq     @loopDone
002708r 2                       ; Continue: restore CURLIN/TXTPTR from frame, JMP NEWSTT (don't RTS).
002708r 2  BD 0F 01             lda     $010F,x
00270Br 2  8D 69 03             sta     BAS_CURLIN
00270Er 2  BD 10 01             lda     $0110,x
002711r 2  8D 6A 03             sta     BAS_CURLIN+1
002714r 2  BD 11 01             lda     $0111,x
002717r 2  85 04                sta     TXTPTR
002719r 2  BD 12 01             lda     $0112,x
00271Cr 2  85 05                sta     TXTPTR+1
00271Er 2  4C rr rr             jmp     BasNewstt
002721r 2               @loopDone:
002721r 2                       ; Discard frame: SP := X + 18.
002721r 2  8A                   txa
002722r 2  18                   clc
002723r 2  69 12                adc     #18
002725r 2  AA                   tax
002726r 2  9A                   txs
002727r 2                       ; Allow ", var" to chain into another NEXT.
002727r 2  20 rr rr             jsr     ChrGot
00272Ar 2  C9 2C                cmp     #','
00272Cr 2  D0 06                bne     @retNewstt
00272Er 2  20 rr rr             jsr     ChrGet
002731r 2  4C rr rr             jmp     BasCmdNext
002734r 2               @retNewstt:
002734r 2  4C rr rr             jmp     BasNewstt
002737r 2               
002737r 2               ; ---------------------------------------------------------------------------
002737r 2               ; Statement: DEF FN A(X) = expr
002737r 2               ; Stored in the variable's 5 value bytes:
002737r 2               ;   [TXTPTR-of-expr-lo][TXTPTR-of-expr-hi][param-name-lo][param-name-hi][0]
002737r 2               ; ---------------------------------------------------------------------------
002737r 2               BasCmdDef:
002737r 2                       ; Expect: FN <name>(<param>) = <expr>
002737r 2  A9 9D                lda     #TOK_FN
002739r 2  20 rr rr             jsr     SynChr
00273Cr 2  09 80                ora     #$80
00273Er 2  85 68                sta     SUBFLG                  ; tell PtrGet "this is a DEF FN var"
002740r 2  20 rr rr             jsr     PtrGet
002743r 2                       ; VARPNT = address of FN var slot.
002743r 2  85 81                sta     BAS_FNCNAM
002745r 2  84 82                sty     BAS_FNCNAM+1
002747r 2  20 rr rr             jsr     ChkNum
00274Ar 2                       ; Expect '(' name ')' = expr
00274Ar 2                       ; Param name parsed by recursive PtrGet inside FrmEvl on call;
00274Ar 2                       ; here we just record (param-name) by parsing it ourselves.
00274Ar 2  A9 28                lda     #'('
00274Cr 2  20 rr rr             jsr     SynChr
00274Fr 2  A9 80                lda     #$80
002751r 2  85 68                sta     SUBFLG
002753r 2  20 rr rr             jsr     PtrGet
002756r 2                       ; VARPNT = param var addr.  Save it.
002756r 2  A5 3F                lda     VARPNT
002758r 2  85 3A                sta     BAS_TMP1
00275Ar 2  A5 40                lda     VARPNT+1
00275Cr 2  85 3B                sta     BAS_TMP1+1
00275Er 2  20 rr rr             jsr     ChkNum
002761r 2  A9 29                lda     #')'
002763r 2  20 rr rr             jsr     SynChr
002766r 2  A9 3D                lda     #'='
002768r 2  20 rr rr             jsr     SynChr
00276Br 2                       ; Reject in direct mode.
00276Br 2  AD 6A 03             lda     BAS_CURLIN+1
00276Er 2  C9 FF                cmp     #$FF
002770r 2  D0 05                bne     @ok
002772r 2  A2 07                ldx     #ERR_ILLDIRECT
002774r 2  4C rr rr             jmp     BasErrorVec
002777r 2               @ok:
002777r 2                       ; Store [TXTPTR][param][0] in FN var.
002777r 2  A0 00                ldy     #0
002779r 2  A5 04                lda     TXTPTR
00277Br 2  91 81                sta     (BAS_FNCNAM),y
00277Dr 2  C8                   iny
00277Er 2  A5 05                lda     TXTPTR+1
002780r 2  91 81                sta     (BAS_FNCNAM),y
002782r 2  C8                   iny
002783r 2  A5 3A                lda     BAS_TMP1
002785r 2  91 81                sta     (BAS_FNCNAM),y
002787r 2  C8                   iny
002788r 2  A5 3B                lda     BAS_TMP1+1
00278Ar 2  91 81                sta     (BAS_FNCNAM),y
00278Cr 2  C8                   iny
00278Dr 2  A9 00                lda     #0
00278Fr 2  91 81                sta     (BAS_FNCNAM),y
002791r 2                       ; Skip past expression body.
002791r 2  20 rr rr             jsr     BasDatan
002794r 2  4C rr rr             jmp     BasAddon
002797r 2               
002797r 2               ; ---------------------------------------------------------------------------
002797r 2               ; FnCall -- evaluator-side handler for "FN A(expr)".
002797r 2               ; Called by FrmEvl when it sees TOK_FN.  Evaluates argument, swaps in the
002797r 2               ; param's stored value, executes the FN expression, and restores the param.
002797r 2               ; ---------------------------------------------------------------------------
002797r 2               FnCall:
002797r 2  20 rr rr             jsr     ChrGet                  ; consume FN
00279Ar 2  09 80                ora     #$80
00279Cr 2  85 68                sta     SUBFLG
00279Er 2  20 rr rr             jsr     PtrGet                  ; locate FN var
0027A1r 2  8D 73 03             sta     BAS_FNPTR               ; durable copy: FNCNAM lives in ZP and
0027A4r 2  8C 74 03             sty     BAS_FNPTR+1             ; is scratch for Garbag
0027A7r 2  85 81                sta     BAS_FNCNAM
0027A9r 2  84 82                sty     BAS_FNCNAM+1
0027ABr 2  20 rr rr             jsr     ChkNum
0027AEr 2                       ; Read param ptr from FN slot.
0027AEr 2  A0 02                ldy     #2
0027B0r 2  B1 81                lda     (BAS_FNCNAM),y
0027B2r 2  85 3F                sta     VARPNT
0027B4r 2  F0 57                beq     @undef
0027B6r 2  C8                   iny
0027B7r 2  B1 81                lda     (BAS_FNCNAM),y
0027B9r 2  85 40                sta     VARPNT+1
0027BBr 2                       ; Evaluate '(arg)'
0027BBr 2  A9 28                lda     #'('
0027BDr 2  20 rr rr             jsr     SynChr
0027C0r 2                       ; Save param's current FP value (5 bytes) on stack.
0027C0r 2  A0 04                ldy     #4
0027C2r 2               @savep:
0027C2r 2  B1 3F                lda     (VARPNT),y
0027C4r 2  48                   pha
0027C5r 2  88                   dey
0027C6r 2  10 FA                bpl     @savep
0027C8r 2                       ; Evaluate argument -> FAC.
0027C8r 2  20 rr rr             jsr     FrmNum
0027CBr 2  A9 29                lda     #')'
0027CDr 2  20 rr rr             jsr     SynChr
0027D0r 2                       ; Any variable reference in the argument re-pointed VARPNT (and Garbag
0027D0r 2                       ; may have eaten FNCNAM) — reload both before storing the argument.
0027D0r 2  20 rr rr             jsr     @reload
0027D3r 2                       ; Store FAC into param slot.
0027D3r 2  A6 3F                ldx     VARPNT
0027D5r 2  A4 40                ldy     VARPNT+1
0027D7r 2  20 rr rr             jsr     StoreFacAtYxRounded
0027DAr 2                       ; Save current TXTPTR.
0027DAr 2  A5 05                lda     TXTPTR+1
0027DCr 2  48                   pha
0027DDr 2  A5 04                lda     TXTPTR
0027DFr 2  48                   pha
0027E0r 2                       ; Switch TXTPTR to FN expression body.
0027E0r 2  A0 00                ldy     #0
0027E2r 2  B1 81                lda     (BAS_FNCNAM),y
0027E4r 2  85 04                sta     TXTPTR
0027E6r 2  C8                   iny
0027E7r 2  B1 81                lda     (BAS_FNCNAM),y
0027E9r 2  85 05                sta     TXTPTR+1
0027EBr 2                       ; Body TXTPTR is positioned at the first byte; we need it positioned
0027EBr 2                       ; one BEFORE so FrmNum's first ChrGet loads the first byte.  Decrement.
0027EBr 2  A5 04                lda     TXTPTR
0027EDr 2  D0 02                bne     @noBor
0027EFr 2  C6 05                dec     TXTPTR+1
0027F1r 2               @noBor:
0027F1r 2  C6 04                dec     TXTPTR
0027F3r 2                       ; Evaluate the FN expression body.
0027F3r 2  20 rr rr             jsr     ChrGet
0027F6r 2  20 rr rr             jsr     FrmNum
0027F9r 2                       ; Restore TXTPTR.
0027F9r 2  68                   pla
0027FAr 2  85 04                sta     TXTPTR
0027FCr 2  68                   pla
0027FDr 2  85 05                sta     TXTPTR+1
0027FFr 2                       ; Restore param.  VARPNT may have been clobbered; reload.
0027FFr 2  20 rr rr             jsr     @reload
002802r 2  A0 00                ldy     #0
002804r 2               @restp:
002804r 2  68                   pla
002805r 2  91 3F                sta     (VARPNT),y
002807r 2  C8                   iny
002808r 2  C0 05                cpy     #5
00280Ar 2  D0 F8                bne     @restp
00280Cr 2  60                   rts
00280Dr 2               @undef:
00280Dr 2  A2 03                ldx     #ERR_UNDEFSTMT
00280Fr 2  4C rr rr             jmp     BasErrorVec
002812r 2               ; Re-seed FNCNAM from BAS_FNPTR and VARPNT from the FN slot's param pointer.
002812r 2               ; Preserves FAC (touches A and Y only).
002812r 2               @reload:
002812r 2  AD 73 03             lda     BAS_FNPTR
002815r 2  85 81                sta     BAS_FNCNAM
002817r 2  AD 74 03             lda     BAS_FNPTR+1
00281Ar 2  85 82                sta     BAS_FNCNAM+1
00281Cr 2  A0 02                ldy     #2
00281Er 2  B1 81                lda     (BAS_FNCNAM),y
002820r 2  85 3F                sta     VARPNT
002822r 2  C8                   iny
002823r 2  B1 81                lda     (BAS_FNCNAM),y
002825r 2  85 40                sta     VARPNT+1
002827r 2  60                   rts
002828r 2               
002828r 2               ; ---------------------------------------------------------------------------
002828r 2               ; BasCmdDim -- DIM statement.  Dimension one or more arrays.
002828r 2               ;   On entry ChrGet has advanced past the DIM token, so A = first char of the
002828r 2               ;   first variable name.  For each name we call PtrGet2 with the from-DIM flag
002828r 2               ;   ($40) set in X; the '(' branch runs Array -> MakeNewArray, which allocates
002828r 2               ;   the array using the subscripts as sizes (0..N) and returns without looking
002828r 2               ;   up an element (DIMFLG nonzero).  Names are separated by commas.
002828r 2               ; ---------------------------------------------------------------------------
002828r 2               BasCmdDim:
002828r 2  A2 40                ldx     #$40                    ; from-DIM flag (bit 6)
00282Ar 2  20 rr rr             jsr     PtrGet2                 ; A = name char; create/dimension array
00282Dr 2  20 rr rr             jsr     ChrGot
002830r 2  C9 2C                cmp     #','
002832r 2  D0 05                bne     @done
002834r 2  20 rr rr             jsr     ChrGet                  ; consume comma, advance to next name
002837r 2  80 EF                bra     BasCmdDim
002839r 2               @done:
002839r 2  60                   rts
00283Ar 2               
00283Ar 2               ; ===========================================================================
00283Ar 2               ;   H A R D W A R E - E X T E N S I O N   S T A T E M E N T S
00283Ar 2               ; ===========================================================================
00283Ar 2               
00283Ar 2               ; --- Helpers --------------------------------------------------------------
00283Ar 2               
00283Ar 2               ; Raise ?NO DEVICE error.
00283Ar 2               NoDevErr:
00283Ar 2  A2 0F                ldx     #ERR_NODEV
00283Cr 2  4C rr rr             jmp     BasErrorVec
00283Fr 2               
00283Fr 2               ; Require A bits in HW_PRESENT (else ?NO DEVICE).
00283Fr 2               ;   Input : A = mask
00283Fr 2               ;   Output: A preserved on success
00283Fr 2               ReqHw:
00283Fr 2  2D 0D 03             and     HW_PRESENT
002842r 2  F0 F6                beq     NoDevErr
002844r 2  60                   rts
002845r 2               
002845r 2               ; Evaluate expression -> A in 0..255.
002845r 2               ;   On entry: ChrGot positioned at first byte of expression.
002845r 2               ;   On exit : A = byte, ChrGot returns char following expression.
002845r 2               EvalU8:
002845r 2  20 rr rr             jsr     GetByt                  ; X = byte, jmp ChrGot
002848r 2  8A                   txa
002849r 2  60                   rts
00284Ar 2               
00284Ar 2               ; Evaluate expression as 16-bit signed -> FAC+3 (hi), FAC+4 (lo).
00284Ar 2               EvalU16:
00284Ar 2  20 rr rr             jsr     FrmNum
00284Dr 2  20 rr rr             jsr     AyInt
002850r 2  4C rr rr             jmp     ChrGot
002853r 2               
002853r 2               ; Evaluate expression as 16-bit unsigned address (0..65535)
002853r 2               ;   -> FAC+3 (hi), FAC+4 (lo).  Used by SYS, POKE, PEEK, WAIT so the full
002853r 2               ;   6502 address space is reachable with positive decimal literals.
002853r 2               ;   Truncates fractional part.  Negative or >= 65536 raises ?ILLEGAL QUANTITY.
002853r 2               EvalAddrU16:
002853r 2  20 rr rr             jsr     FrmNum
002856r 2  20 rr rr             jsr     FacToU16
002859r 2  4C rr rr             jmp     ChrGot
00285Cr 2               
00285Cr 2               ; FacToU16 -- Convert FAC (must be 0..65535) to FAC+3 (hi), FAC+4 (lo).
00285Cr 2               ;   Negative or >= 65536 raises ?ILLEGAL QUANTITY.  Truncates fractional part.
00285Cr 2               FacToU16:
00285Cr 2  24 13                bit     FACSIGN
00285Er 2  30 34                bmi     @illqty
002860r 2  A5 0E                lda     FAC                     ; exponent byte (0 = value is zero)
002862r 2  F0 2B                beq     @zero
002864r 2  C9 91                cmp     #$91                    ; exp >= $91 means value >= 65536
002866r 2  B0 2C                bcs     @illqty
002868r 2                       ; Reconstruct top 16 bits of mantissa (with hidden 1 bit).
002868r 2  48                   pha                             ; save exponent byte
002869r 2  A5 0F                lda     FAC+1
00286Br 2  09 80                ora     #$80                    ; restore hidden bit
00286Dr 2  85 3B                sta     BAS_TMP1+1              ; hi
00286Fr 2  A5 10                lda     FAC+2
002871r 2  85 3A                sta     BAS_TMP1                ; lo
002873r 2                       ; Shift count = $90 - exp_byte (0..15).
002873r 2  68                   pla
002874r 2  38                   sec
002875r 2  E9 90                sbc     #$90
002877r 2  49 FF                eor     #$FF
002879r 2  18                   clc
00287Ar 2  69 01                adc     #1                      ; A = $90 - exp
00287Cr 2  F0 08                beq     @store                  ; zero shifts: already aligned
00287Er 2  AA                   tax
00287Fr 2               @shloop:
00287Fr 2  46 3B                lsr     BAS_TMP1+1
002881r 2  66 3A                ror     BAS_TMP1
002883r 2  CA                   dex
002884r 2  D0 F9                bne     @shloop
002886r 2               @store:
002886r 2  A5 3B                lda     BAS_TMP1+1
002888r 2  85 11                sta     FAC+3
00288Ar 2  A5 3A                lda     BAS_TMP1
00288Cr 2  85 12                sta     FAC+4
00288Er 2  60                   rts
00288Fr 2               @zero:
00288Fr 2  64 11                stz     FAC+3
002891r 2  64 12                stz     FAC+4
002893r 2  60                   rts
002894r 2               @illqty:
002894r 2  4C rr rr             jmp     IqErr
002897r 2               
002897r 2               ; Evaluate string expression -> copy up to 12 chars to BAS_FNAME,
002897r 2               ; null-terminate, set STR_PTR := BAS_FNAME, free temp string.
002897r 2               ; 12 = full 8.3 form ("NAME.EXT" = 8 name + '.' + 3 ext).
002897r 2               EvalString:
002897r 2  20 rr rr             jsr     FrmEvl
00289Ar 2  20 rr rr             jsr     ChkStr
00289Dr 2  A5 0F                lda     FAC+1
00289Fr 2  85 20                sta     INDEX
0028A1r 2  A5 10                lda     FAC+2
0028A3r 2  85 21                sta     INDEX+1
0028A5r 2  A0 00                ldy     #0
0028A7r 2  A6 0E                ldx     FAC                     ; length
0028A9r 2               @cpy:
0028A9r 2  C0 0C                cpy     #12
0028ABr 2  F0 0D                beq     @done
0028ADr 2  E0 00                cpx     #0
0028AFr 2  F0 09                beq     @done
0028B1r 2  B1 20                lda     (INDEX),y
0028B3r 2  99 81 03             sta     BAS_FNAME,y
0028B6r 2  C8                   iny
0028B7r 2  CA                   dex
0028B8r 2  80 EF                bra     @cpy
0028BAr 2               @done:
0028BAr 2  A9 00                lda     #0
0028BCr 2  99 81 03             sta     BAS_FNAME,y
0028BFr 2  A9 81                lda     #<BAS_FNAME
0028C1r 2  85 02                sta     STR_PTR
0028C3r 2  A9 03                lda     #>BAS_FNAME
0028C5r 2  85 03                sta     STR_PTR+1
0028C7r 2  4C rr rr             jmp     FreFac
0028CAr 2               
0028CAr 2               ; Print A as 2-digit decimal with leading zero (used by TIME/DATE).
0028CAr 2               BasPr2D:
0028CAr 2  A2 00                ldx     #0
0028CCr 2               @loop:
0028CCr 2  C9 0A                cmp     #10
0028CEr 2  90 05                bcc     @done
0028D0r 2  E9 0A                sbc     #10
0028D2r 2  E8                   inx
0028D3r 2  80 F7                bra     @loop
0028D5r 2               @done:
0028D5r 2  48                   pha
0028D6r 2  8A                   txa
0028D7r 2  09 30                ora     #'0'
0028D9r 2  20 rr rr             jsr     Chrout
0028DCr 2  68                   pla
0028DDr 2  09 30                ora     #'0'
0028DFr 2  4C rr rr             jmp     Chrout
0028E2r 2               
0028E2r 2               ; BasFixChain -- recompute end-of-program pointers after a program image load.
0028E2r 2               ; A program image is the raw bytes belonging at $0800 up: a tokenized line chain
0028E2r 2               ; and, for a .prg, machine code sitting past the chain's $0000 terminator.  A
0028E2r 2               ; chain walk alone only ever finds the end of the BASIC part, so the loader's
0028E2r 2               ; byte count has to be taken into account too.
0028E2r 2               ;   Input:  A = loaded image size lo, Y = size hi (0 = size unknown; chain only)
0028E2r 2               ;   Output: BAS_VARTAB = BAS_ARYTAB = BAS_STREND
0028E2r 2               ;             = max(chain-end + 2, PROGRAM_START + size)
0028E2r 2               ;   Note:   a size that would push the result past BAS_MEMSIZ is rejected and the
0028E2r 2               ;           chain-end candidate is used instead.
0028E2r 2               ; Mirroring VARTAB into ARYTAB/STREND matters on its own: Makenewvariable places
0028E2r 2               ; a new scalar at ARYTAB, so leaving it at its post-NEW $0802 makes the first
0028E2r 2               ; direct-mode assignment after a LOAD overwrite the program's first line.
0028E2r 2                       .assert (PROGRAM_START & $FF) = 0, error, "PROGRAM_START must be page-aligned"
0028E2r 2               BasFixChain:
0028E2r 2  85 3C                sta     BAS_TMP2                ; BAS_TMP2 = PROGRAM_START + size; the
0028E4r 2  98                   tya                             ; low byte passes through untouched
0028E5r 2  18                   clc                             ; because PROGRAM_START is page-aligned
0028E6r 2  69 08                adc     #>PROGRAM_START
0028E8r 2  85 3D                sta     BAS_TMP2+1
0028EAr 2  64 20                stz     INDEX
0028ECr 2  A9 08                lda     #>PROGRAM_START
0028EEr 2  85 21                sta     INDEX+1
0028F0r 2               @walk:
0028F0r 2  A0 01                ldy     #1
0028F2r 2  B1 20                lda     (INDEX),y               ; next-ptr hi
0028F4r 2  85 3A                sta     BAS_TMP1
0028F6r 2  88                   dey
0028F7r 2  11 20                ora     (INDEX),y               ; both bytes zero -> terminator
0028F9r 2  F0 15                beq     @end
0028FBr 2                       ; Lines ascend in memory.  LOAD accepts any file, so a corrupt or
0028FBr 2                       ; cyclic chain is reachable here — stop at the last good line rather
0028FBr 2                       ; than loop forever.
0028FBr 2  38                   sec
0028FCr 2  A5 20                lda     INDEX
0028FEr 2  F1 20                sbc     (INDEX),y
002900r 2  A5 21                lda     INDEX+1
002902r 2  E5 3A                sbc     BAS_TMP1
002904r 2  B0 0A                bcs     @end                    ; current >= next -> not a real chain
002906r 2  B1 20                lda     (INDEX),y               ; next-ptr lo
002908r 2  85 20                sta     INDEX
00290Ar 2  A5 3A                lda     BAS_TMP1
00290Cr 2  85 21                sta     INDEX+1
00290Er 2  80 E0                bra     @walk
002910r 2               @end:
002910r 2                       ; INDEX points at terminator ($00 $00).  Candidate A = INDEX + 2.
002910r 2  18                   clc
002911r 2  A5 20                lda     INDEX
002913r 2  69 02                adc     #2
002915r 2  8D 5F 03             sta     BAS_VARTAB
002918r 2  A5 21                lda     INDEX+1
00291Ar 2  69 00                adc     #0
00291Cr 2  8D 60 03             sta     BAS_VARTAB+1
00291Fr 2                       ; Candidate B = BAS_TMP2.  Keep it only when A <= B <= MEMSIZ, so a
00291Fr 2                       ; short or absent size loses the max and a bogus one cannot push
00291Fr 2                       ; VARTAB out of memory.
00291Fr 2  38                   sec
002920r 2  A5 3C                lda     BAS_TMP2
002922r 2  ED 5F 03             sbc     BAS_VARTAB
002925r 2  A5 3D                lda     BAS_TMP2+1
002927r 2  ED 60 03             sbc     BAS_VARTAB+1
00292Ar 2  90 17                bcc     @mirror                 ; B < A -> keep A
00292Cr 2  38                   sec
00292Dr 2  AD 67 03             lda     BAS_MEMSIZ
002930r 2  E5 3C                sbc     BAS_TMP2
002932r 2  AD 68 03             lda     BAS_MEMSIZ+1
002935r 2  E5 3D                sbc     BAS_TMP2+1
002937r 2  90 0A                bcc     @mirror                 ; B > MEMSIZ -> reject, keep A
002939r 2  A5 3C                lda     BAS_TMP2
00293Br 2  8D 5F 03             sta     BAS_VARTAB
00293Er 2  A5 3D                lda     BAS_TMP2+1
002940r 2  8D 60 03             sta     BAS_VARTAB+1
002943r 2               @mirror:
002943r 2                       ; ARYTAB / STREND follow VARTAB on a fresh load: no variables yet.
002943r 2  A2 01                ldx     #1
002945r 2               @copy:
002945r 2  BD 5F 03             lda     BAS_VARTAB,x
002948r 2  9D 61 03             sta     BAS_ARYTAB,x
00294Br 2  9D 63 03             sta     BAS_STREND,x
00294Er 2  CA                   dex
00294Fr 2  10 F4                bpl     @copy
002951r 2  60                   rts
002952r 2               
002952r 2               ; --- Statements -----------------------------------------------------------
002952r 2               
002952r 2               ; SYS addr[,a[,x[,y]]] -- call a machine-code routine; RTS comes back here.
002952r 2               ; A, X and Y are loaded from the optional arguments (0 when omitted) and the
002952r 2               ; routine is entered with decimal mode and the interrupt mask clear.  What it
002952r 2               ; returns in A, X, Y and P is left in BRK_A/X/Y/P (PEEK 787/788/789/784), the
002952r 2               ; bytes a BRK report reads from.  The arguments wait there too: FrmEvl owns
002952r 2               ; every zero-page scratch byte, and nothing else runs between the last
002952r 2               ; argument and the call.
002952r 2               BasCmdSys:
002952r 2  20 rr rr             jsr     EvalAddrU16
002955r 2  A5 12                lda     FAC+4                   ; lo, and hi, across the evaluations
002957r 2  48                   pha
002958r 2  A5 11                lda     FAC+3
00295Ar 2  48                   pha
00295Br 2  9C 13 03             stz     BRK_A
00295Er 2  9C 14 03             stz     BRK_X
002961r 2  9C 15 03             stz     BRK_Y
002964r 2  A2 00                ldx     #0
002966r 2               @arg:
002966r 2  20 rr rr             jsr     ChrGot
002969r 2  C9 2C                cmp     #','
00296Br 2  D0 0E                bne     @call
00296Dr 2  DA                   phx
00296Er 2  20 rr rr             jsr     GetComByt               ; X = value
002971r 2  8A                   txa
002972r 2  FA                   plx
002973r 2  9D 13 03             sta     BRK_A,x
002976r 2  E8                   inx
002977r 2  E0 03                cpx     #3
002979r 2  D0 EB                bne     @arg
00297Br 2               @call:
00297Br 2  68                   pla
00297Cr 2  85 21                sta     INDEX+1
00297Er 2  68                   pla
00297Fr 2  85 20                sta     INDEX
002981r 2  20 rr rr             jsr     @go
002984r 2  08                   php
002985r 2  8D 13 03             sta     BRK_A
002988r 2  8E 14 03             stx     BRK_X
00298Br 2  8C 15 03             sty     BRK_Y
00298Er 2  68                   pla
00298Fr 2  8D 10 03             sta     BRK_P
002992r 2  D8                   cld
002993r 2  60                   rts
002994r 2               @go:
002994r 2  AD 13 03             lda     BRK_A
002997r 2  AE 14 03             ldx     BRK_X
00299Ar 2  AC 15 03             ldy     BRK_Y
00299Dr 2  D8                   cld
00299Er 2  58                   cli
00299Fr 2  6C 20 00             jmp     (INDEX)
0029A2r 2               
0029A2r 2               ; ---------------------------------------------------------------------------
0029A2r 2               ; Byte arguments, with the ranges the README documents.
0029A2r 2               ;
0029A2r 2               ; GetByt itself only rejects a value that will not fit in a byte.  Every
0029A2r 2               ; statement below has a narrower range than that -- a volume of 0-15, a screen
0029A2r 2               ; row of 0-23, an hour of 0-23 -- and each of them used to take whatever byte
0029A2r 2               ; it was handed and fold it into something legal.  VOL 16 masked to 4 bits and
0029A2r 2               ; set the volume to *zero*; LOCATE 24,0 pointed the cursor past the end of the
0029A2r 2               ; name table; SETTIME 24,61,61 wrote BCD the DS1511Y has no values for.  None
0029A2r 2               ; of them said anything.
0029A2r 2               ;
0029A2r 2               ; So the range travels with the fetch.  A = one past the highest legal value;
0029A2r 2               ; anything from there up raises ILLEGAL QUANTITY, as NVRAM's address already
0029A2r 2               ; did.  GetComByteLim is the same thing preceded by the comma between two
0029A2r 2               ; arguments, and it costs a byte *less* per site than the `jsr ChkCom /
0029A2r 2               ; jsr GetByt` pair it replaces -- which is how thirteen range checks fit into
0029A2r 2               ; a segment that had one byte spare.
0029A2r 2               ;
0029A2r 2               ; The limit is parked on the stack across the fetch rather than in scratch:
0029A2r 2               ; GetByt runs the whole expression evaluator, which reaches BAS_TMP3 itself.
0029A2r 2               ; Between the `pla` and the `cpx` nothing runs at all, so the byte is safe
0029A2r 2               ; there and nowhere earlier.
0029A2r 2               ; ---------------------------------------------------------------------------
0029A2r 2               
0029A2r 2               ; GetComByt - a comma, then an unchecked byte argument.
0029A2r 2               GetComByt:
0029A2r 2  20 rr rr             jsr     ChkCom
0029A5r 2  4C rr rr             jmp     GetByt
0029A8r 2               
0029A8r 2               ; GetComByteLim / GetByteLim - the same, with a range.  X = value.
0029A8r 2               GetComByteLim:
0029A8r 2  48                   pha                             ; the limit, across the comma
0029A9r 2  20 rr rr             jsr     ChkCom
0029ACr 2  68                   pla
0029ADr 2               GetByteLim:
0029ADr 2  48                   pha                             ; and across the evaluator
0029AEr 2  20 rr rr             jsr     GetByt                  ; X = value
0029B1r 2  68                   pla
0029B2r 2  85 3E                sta     BAS_TMP3
0029B4r 2  E4 3E                cpx     BAS_TMP3
0029B6r 2  B0 01                bcs     BasRangeErr             ; value >= limit
0029B8r 2  60                   rts
0029B9r 2               BasRangeErr:
0029B9r 2  4C rr rr             jmp     IqErr
0029BCr 2               
0029BCr 2               ; The five statements below reach hardware that a machine may not have fitted,
0029BCr 2               ; and none of them raises ?NO DEVICE for it: a screen or a speaker has no answer
0029BCr 2               ; to return, so there is nothing an error could tell the program that silence
0029BCr 2               ; does not.  A game that beeps on a hit keeps playing on a machine with no sound
0029BCr 2               ; card.  The skip lives in the Kernal routine each one ends in, which is what
0029BCr 2               ; makes the same promise to a cartridge calling the slot directly; the arguments
0029BCr 2               ; are parsed and range-checked here either way, so a program is wrong or right
0029BCr 2               ; on every machine rather than on the one it was written on.
0029BCr 2               ;
0029BCr 2               ; The statements that read or write *data* — the CF and RTC ones below — do
0029BCr 2               ; raise ?NO DEVICE, and for the same reason: they have an answer to return and
0029BCr 2               ; cannot.
0029BCr 2               
0029BCr 2               ; CLS
0029BCr 2               BasCmdCls:
0029BCr 2  4C rr rr             jmp     VideoClear
0029BFr 2               
0029BFr 2               ; LOCATE row, col
0029BFr 2               BasCmdLocate:
0029BFr 2  A9 18                lda     #24                     ; rows 0-23
0029C1r 2  20 rr rr             jsr     GetByteLim              ; X = row
0029C4r 2  DA                   phx
0029C5r 2  A9 28                lda     #40                     ; columns 0-39
0029C7r 2  20 rr rr             jsr     GetComByteLim           ; X = col
0029CAr 2  7A                   ply                             ; Y = row
0029CBr 2  4C rr rr             jmp     VideoSetCursor
0029CEr 2               
0029CEr 2               ; COLOR fg[, bg[, border]]
0029CEr 2               ;   The pen for later output, through VideoSetColor, which also sets the border
0029CEr 2               ;   to bg.  bg defaults to the current pen's.  A border then writes register 7
0029CEr 2               ;   again as fg<<4 | border.
0029CEr 2               BasCmdColor:
0029CEr 2  A9 10                lda     #16                     ; colours 0-15
0029D0r 2  20 rr rr             jsr     GetByteLim              ; X = fg
0029D3r 2  8A                   txa
0029D4r 2  0A                   asl     a
0029D5r 2  0A                   asl     a
0029D6r 2  0A                   asl     a
0029D7r 2  0A                   asl     a
0029D8r 2  48                   pha                             ; fg must survive FrmEvl -> stack, not ZP
0029D9r 2  AD 91 03             lda     VID_PEN
0029DCr 2  29 0F                and     #$0F
0029DEr 2  AA                   tax                             ; X = bg if none is given
0029DFr 2  20 rr rr             jsr     ChrGot
0029E2r 2  C9 2C                cmp     #','
0029E4r 2  D0 05                bne     @bg
0029E6r 2  A9 10                lda     #16
0029E8r 2  20 rr rr             jsr     GetComByteLim           ; X = bg, already known to fit a nibble
0029EBr 2               @bg:
0029EBr 2  86 3A                stx     BAS_TMP1
0029EDr 2  68                   pla
0029EEr 2  48                   pha
0029EFr 2  05 3A                ora     BAS_TMP1
0029F1r 2  20 rr rr             jsr     VideoSetColor
0029F4r 2  20 rr rr             jsr     ChrGot
0029F7r 2  C9 2C                cmp     #','
0029F9r 2  D0 0F                bne     @done
0029FBr 2  A9 10                lda     #16
0029FDr 2  20 rr rr             jsr     GetComByteLim           ; X = border
002A00r 2  86 3A                stx     BAS_TMP1
002A02r 2  68                   pla
002A03r 2  05 3A                ora     BAS_TMP1
002A05r 2  A2 07                ldx     #VDP_COLOR
002A07r 2  4C rr rr             jmp     VdpWriteRegImpl         ; Skips without a card
002A0Ar 2               @done:
002A0Ar 2  68                   pla
002A0Br 2  60                   rts
002A0Cr 2               
002A0Cr 2               ; VOL n
002A0Cr 2               BasCmdVol:
002A0Cr 2  A9 10                lda     #16                     ; volume 0-15
002A0Er 2  20 rr rr             jsr     GetByteLim              ; X = vol
002A11r 2  8A                   txa
002A12r 2  4C rr rr             jmp     SidSetVolume
002A15r 2               
002A15r 2               ; SOUND voice, freq, dur (freq=Hz, dur=centisec)
002A15r 2               ;   Hz -> SID register: reg = Hz * 16.75 ≈ Hz<<4 + Hz - Hz/4
002A15r 2               BasCmdSound:
002A15r 2  A9 04                lda     #4                      ; voices 1-3, after Commodore BASIC V3.5
002A17r 2  20 rr rr             jsr     GetByteLim              ; X = voice
002A1Ar 2  CA                   dex                             ; 0-indexed for SidPlayNote
002A1Br 2  30 9C                bmi     BasRangeErr             ; voice 0 underflowed to $FF
002A1Dr 2  DA                   phx                             ; voice (0-indexed) on stack
002A1Er 2  20 rr rr             jsr     ChkCom
002A21r 2  20 rr rr             jsr     EvalU16                 ; freq Hz: hi=FAC+3, lo=FAC+4
002A24r 2                       ; Compute reg = Hz<<4 + Hz - Hz/4
002A24r 2  A5 12                lda     FAC+4
002A26r 2  85 3A                sta     BAS_TMP1
002A28r 2  A5 11                lda     FAC+3
002A2Ar 2  85 3B                sta     BAS_TMP1+1
002A2Cr 2  A5 3A                lda     BAS_TMP1
002A2Er 2  85 3C                sta     BAS_TMP2
002A30r 2  A5 3B                lda     BAS_TMP1+1
002A32r 2  85 3D                sta     BAS_TMP2+1
002A34r 2  A2 04                ldx     #4
002A36r 2               @shl:
002A36r 2  06 3A                asl     BAS_TMP1
002A38r 2  26 3B                rol     BAS_TMP1+1
002A3Ar 2  CA                   dex
002A3Br 2  D0 F9                bne     @shl
002A3Dr 2  18                   clc
002A3Er 2  A5 3A                lda     BAS_TMP1
002A40r 2  65 3C                adc     BAS_TMP2
002A42r 2  85 3A                sta     BAS_TMP1
002A44r 2  A5 3B                lda     BAS_TMP1+1
002A46r 2  65 3D                adc     BAS_TMP2+1
002A48r 2  85 3B                sta     BAS_TMP1+1
002A4Ar 2  46 3D                lsr     BAS_TMP2+1
002A4Cr 2  66 3C                ror     BAS_TMP2
002A4Er 2  46 3D                lsr     BAS_TMP2+1
002A50r 2  66 3C                ror     BAS_TMP2
002A52r 2  38                   sec
002A53r 2  A5 3A                lda     BAS_TMP1
002A55r 2  E5 3C                sbc     BAS_TMP2
002A57r 2  48                   pha                             ; freqLo
002A58r 2  A5 3B                lda     BAS_TMP1+1
002A5Ar 2  E5 3D                sbc     BAS_TMP2+1
002A5Cr 2  48                   pha                             ; freqHi
002A5Dr 2  20 rr rr             jsr     ChkCom
002A60r 2  20 rr rr             jsr     EvalU16                 ; dur in FAC+3/+4
002A63r 2                       ; Stack (top-down): freqHi, freqLo, voice
002A63r 2  7A                   ply                             ; Y = freqHi
002A64r 2  FA                   plx                             ; X = freqLo
002A65r 2  68                   pla                             ; A = voice
002A66r 2  20 rr rr             jsr     SidPlayNote
002A69r 2  A5 12                lda     FAC+4
002A6Br 2  A6 11                ldx     FAC+3
002A6Dr 2  20 rr rr             jsr     SysDelay
002A70r 2  4C rr rr             jmp     SidSilence
002A73r 2               
002A73r 2               ; TIME
002A73r 2               BasCmdTime:
002A73r 2  A9 04                lda     #HW_RTC
002A75r 2  20 rr rr             jsr     ReqHw
002A78r 2  20 rr rr             jsr     RtcReadTime             ; A=hours, X=min, Y=sec
002A7Br 2  5A                   phy
002A7Cr 2  DA                   phx
002A7Dr 2  20 rr rr             jsr     BasPr2D                 ; print hours
002A80r 2  A9 3A                lda     #':'
002A82r 2  20 rr rr             jsr     Chrout
002A85r 2  68                   pla
002A86r 2  20 rr rr             jsr     BasPr2D
002A89r 2  A9 3A                lda     #':'
002A8Br 2  20 rr rr             jsr     Chrout
002A8Er 2  68                   pla
002A8Fr 2  20 rr rr             jsr     BasPr2D
002A92r 2  4C rr rr             jmp     BasPrintCRLF
002A95r 2               
002A95r 2               ; DATE
002A95r 2               BasCmdDate:
002A95r 2  A9 04                lda     #HW_RTC
002A97r 2  20 rr rr             jsr     ReqHw
002A9Ar 2  20 rr rr             jsr     RtcReadDate             ; A=day, X=month, Y=year
002A9Dr 2  48                   pha
002A9Er 2  DA                   phx
002A9Fr 2  5A                   phy
002AA0r 2  AD 0B 03             lda     RTC_BUF_CENT
002AA3r 2  20 rr rr             jsr     BasPr2D
002AA6r 2  68                   pla
002AA7r 2  20 rr rr             jsr     BasPr2D
002AAAr 2  A9 2D                lda     #'-'
002AACr 2  20 rr rr             jsr     Chrout
002AAFr 2  68                   pla
002AB0r 2  20 rr rr             jsr     BasPr2D
002AB3r 2  A9 2D                lda     #'-'
002AB5r 2  20 rr rr             jsr     Chrout
002AB8r 2  68                   pla
002AB9r 2  20 rr rr             jsr     BasPr2D
002ABCr 2  4C rr rr             jmp     BasPrintCRLF
002ABFr 2               
002ABFr 2               ; SETTIME h, m, s
002ABFr 2               BasCmdSettime:
002ABFr 2  A9 04                lda     #HW_RTC
002AC1r 2  20 rr rr             jsr     ReqHw
002AC4r 2  A9 18                lda     #24                     ; hours 0-23
002AC6r 2  20 rr rr             jsr     GetByteLim              ; X = h
002AC9r 2  DA                   phx
002ACAr 2  A9 3C                lda     #60                     ; minutes 0-59
002ACCr 2  20 rr rr             jsr     GetComByteLim           ; X = m
002ACFr 2  DA                   phx
002AD0r 2  A9 3C                lda     #60                     ; seconds 0-59
002AD2r 2  20 rr rr             jsr     GetComByteLim           ; X = s
002AD5r 2  8A                   txa
002AD6r 2  A8                   tay                             ; Y = s
002AD7r 2  FA                   plx                             ; X = m
002AD8r 2  68                   pla                             ; A = h
002AD9r 2  4C rr rr             jmp     RtcWriteTime
002ADCr 2               
002ADCr 2               ; SETDATE c, y, m, d
002ADCr 2               BasCmdSetdate:
002ADCr 2  A9 04                lda     #HW_RTC
002ADEr 2  20 rr rr             jsr     ReqHw
002AE1r 2  A9 64                lda     #100                    ; century 0-99, as two BCD digits
002AE3r 2  20 rr rr             jsr     GetByteLim
002AE6r 2  8E 0B 03             stx     RTC_BUF_CENT
002AE9r 2  A9 64                lda     #100                    ; year 0-99
002AEBr 2  20 rr rr             jsr     GetComByteLim
002AEEr 2  DA                   phx                             ; year
002AEFr 2  A9 0D                lda     #13                     ; months 1-12, so reject 0 as well
002AF1r 2  20 rr rr             jsr     GetComByteLim
002AF4r 2  E0 01                cpx     #1
002AF6r 2  90 10                bcc     @bad
002AF8r 2  DA                   phx                             ; month
002AF9r 2  A9 20                lda     #32                     ; days 1-31.  Which months are short is
002AFBr 2  20 rr rr             jsr     GetComByteLim           ;   left alone: it needs a table and a
002AFEr 2  E0 01                cpx     #1                      ;   leap rule for one wrong day a year,
002B00r 2  90 06                bcc     @bad                    ;   and the DS1511Y does not check it
002B02r 2                                                       ;   either
002B02r 2  8A                   txa
002B03r 2  FA                   plx                             ; X=month
002B04r 2  7A                   ply                             ; Y=year
002B05r 2  4C rr rr             jmp     RtcWriteDate
002B08r 2               @bad:                                   ; BasRangeErr is out of branch reach
002B08r 2  4C rr rr             jmp     IqErr
002B0Br 2               
002B0Br 2               ; NVRAM addr, val
002B0Br 2               BasCmdNvram:
002B0Br 2  A9 04                lda     #HW_RTC
002B0Dr 2  20 rr rr             jsr     ReqHw
002B10r 2  20 rr rr             jsr     GetByt                  ; addr; GetByt's own 0-255 is the range
002B13r 2  DA                   phx
002B14r 2  20 rr rr             jsr     GetComByt               ; X=val
002B17r 2  8A                   txa                             ; A=val
002B18r 2  FA                   plx                             ; X=addr
002B19r 2  4C rr rr             jmp     RtcWriteNVRAM
002B1Cr 2               
002B1Cr 2               ; WAIT addr, mask
002B1Cr 2               ; As with POKE, the address must survive evaluation of the second argument,
002B1Cr 2               ; which is free to trample BAS_TMP1 (FacToU16, MID$/LEFT$/RIGHT$, ...).
002B1Cr 2               BasCmdWait:
002B1Cr 2  20 rr rr             jsr     EvalAddrU16
002B1Fr 2  A5 11                lda     FAC+3                   ; hi
002B21r 2  48                   pha
002B22r 2  A5 12                lda     FAC+4                   ; lo
002B24r 2  48                   pha
002B25r 2  20 rr rr             jsr     GetComByt               ; X = mask
002B28r 2  86 3C                stx     BAS_TMP2
002B2Ar 2  68                   pla
002B2Br 2  85 3A                sta     BAS_TMP1
002B2Dr 2  68                   pla
002B2Er 2  85 3B                sta     BAS_TMP1+1
002B30r 2               @poll:
002B30r 2  20 rr rr             jsr     BasCheckBreak
002B33r 2  A0 00                ldy     #0
002B35r 2  B1 3A                lda     (BAS_TMP1),y
002B37r 2  25 3C                and     BAS_TMP2
002B39r 2  F0 F5                beq     @poll
002B3Br 2  60                   rts
002B3Cr 2               
002B3Cr 2               ; PAUSE n (centiseconds)
002B3Cr 2               BasCmdPause:
002B3Cr 2  20 rr rr             jsr     EvalU16
002B3Fr 2  A5 12                lda     FAC+4
002B41r 2  A6 11                ldx     FAC+3
002B43r 2  4C rr rr             jmp     SysDelay
002B46r 2               
002B46r 2               ; BANK n
002B46r 2               BasCmdBank:
002B46r 2  A9 01                lda     #HW_RAM_L
002B48r 2  20 rr rr             jsr     ReqHw
002B4Br 2  20 rr rr             jsr     GetByt                  ; X = bank
002B4Er 2  8E FF 83             stx     RAM_BANK_L
002B51r 2  60                   rts
002B52r 2               
002B52r 2               ; POKE addr, val
002B52r 2               ; The value expression is evaluated BEFORE the address is parked in INDEX:
002B52r 2               ; FrmEvl clobbers every zero-page scratch pair (INDEX via LoadFacFromYa,
002B52r 2               ; BAS_TMP1 via FacToU16 / the string functions), so the address has to ride
002B52r 2               ; the hardware stack across the evaluation.
002B52r 2               BasCmdPoke:
002B52r 2  20 rr rr             jsr     EvalAddrU16
002B55r 2  A5 11                lda     FAC+3                   ; hi
002B57r 2  48                   pha
002B58r 2  A5 12                lda     FAC+4                   ; lo
002B5Ar 2  48                   pha
002B5Br 2  20 rr rr             jsr     ChkCom
002B5Er 2  20 rr rr             jsr     GetByt                  ; X = val
002B61r 2  68                   pla
002B62r 2  85 20                sta     INDEX
002B64r 2  68                   pla
002B65r 2  85 21                sta     INDEX+1
002B67r 2  8A                   txa
002B68r 2  A0 00                ldy     #0
002B6Ar 2  91 20                sta     (INDEX),y
002B6Cr 2  60                   rts
002B6Dr 2               
002B6Dr 2               ; LOAD ["name"] / LOAD (bare) / LOAD "name"
002B6Dr 2               BasCmdLoad:
002B6Dr 2  20 rr rr             jsr     ChrGot
002B70r 2  F0 02                beq     @bare
002B72r 2  80 19                bra     @cf                     ; any argument is a filename expression
002B74r 2               @bare:
002B74r 2  A9 10                lda     #HW_SC
002B76r 2  20 rr rr             jsr     ReqHw
002B79r 2  A9 00                lda     #<PROGRAM_START
002B7Br 2  85 2A                sta     XFER_PTR
002B7Dr 2  A9 08                lda     #>PROGRAM_START
002B7Fr 2  85 2B                sta     XFER_PTR+1
002B81r 2  20 rr rr             jsr     XModemLoad
002B84r 2                       ; XMODEM rounds up to a 128-byte block, so this can overshoot the true
002B84r 2                       ; end by up to 127 bytes: it wastes a little variable space, never
002B84r 2                       ; truncates.
002B84r 2  AD 17 03             lda     XFER_REMAIN
002B87r 2  AC 18 03             ldy     XFER_REMAIN+1
002B8Ar 2  4C rr rr             jmp     BasFixChain
002B8Dr 2               @cf:
002B8Dr 2  A9 08                lda     #HW_CF
002B8Fr 2  20 rr rr             jsr     ReqHw
002B92r 2  20 rr rr             jsr     EvalString
002B95r 2  20 rr rr             jsr     FsLoadFile
002B98r 2  B0 09                bcs     @err
002B9Ar 2  AD 4A 03             lda     FS_FILE_SIZE
002B9Dr 2  AC 4B 03             ldy     FS_FILE_SIZE+1
002BA0r 2  4C rr rr             jmp     BasFixChain
002BA3r 2               @err:
002BA3r 2  A9 rr                lda     #<MsgLoadErr
002BA5r 2  A0 rr                ldy     #>MsgLoadErr
002BA7r 2  4C rr rr             jmp     BasPrintStr
002BAAr 2               
002BAAr 2               ; SAVE / SAVE "name"
002BAAr 2               BasCmdSave:
002BAAr 2  20 rr rr             jsr     ChrGot
002BADr 2  F0 02                beq     @bare
002BAFr 2  80 21                bra     @cf                     ; any argument is a filename expression
002BB1r 2               @bare:
002BB1r 2  A9 10                lda     #HW_SC
002BB3r 2  20 rr rr             jsr     ReqHw
002BB6r 2  A9 00                lda     #<PROGRAM_START
002BB8r 2  85 2A                sta     XFER_PTR
002BBAr 2  A9 08                lda     #>PROGRAM_START
002BBCr 2  85 2B                sta     XFER_PTR+1
002BBEr 2  38                   sec
002BBFr 2  AD 5F 03             lda     BAS_VARTAB
002BC2r 2  E9 00                sbc     #<PROGRAM_START
002BC4r 2  8D 17 03             sta     XFER_REMAIN
002BC7r 2  AD 60 03             lda     BAS_VARTAB+1
002BCAr 2  E9 08                sbc     #>PROGRAM_START
002BCCr 2  8D 18 03             sta     XFER_REMAIN+1
002BCFr 2  4C rr rr             jmp     XModemSave
002BD2r 2               @cf:
002BD2r 2  A9 08                lda     #HW_CF
002BD4r 2  20 rr rr             jsr     ReqHw
002BD7r 2  20 rr rr             jsr     EvalString
002BDAr 2  38                   sec
002BDBr 2  AD 5F 03             lda     BAS_VARTAB
002BDEr 2  E9 00                sbc     #<PROGRAM_START
002BE0r 2  8D 4A 03             sta     FS_FILE_SIZE
002BE3r 2  AD 60 03             lda     BAS_VARTAB+1
002BE6r 2  E9 08                sbc     #>PROGRAM_START
002BE8r 2  8D 4B 03             sta     FS_FILE_SIZE+1
002BEBr 2  20 rr rr             jsr     FsSaveFile
002BEEr 2  B0 01                bcs     @err
002BF0r 2  60                   rts
002BF1r 2               @err:
002BF1r 2  A9 rr                lda     #<MsgSaveErr
002BF3r 2  A0 rr                ldy     #>MsgSaveErr
002BF5r 2  4C rr rr             jmp     BasPrintStr
002BF8r 2               
002BF8r 2               ; DIR
002BF8r 2               BasCmdDir:
002BF8r 2  A9 08                lda     #HW_CF
002BFAr 2  20 rr rr             jsr     ReqHw
002BFDr 2  4C rr rr             jmp     FsDirectory
002C00r 2               
002C00r 2               ; DEL "name"
002C00r 2               BasCmdDel:
002C00r 2  A9 08                lda     #HW_CF
002C02r 2  20 rr rr             jsr     ReqHw
002C05r 2  20 rr rr             jsr     EvalString
002C08r 2  20 rr rr             jsr     FsDeleteFile
002C0Br 2  B0 01                bcs     @err
002C0Dr 2  60                   rts
002C0Er 2               @err:
002C0Er 2  A9 rr                lda     #<MsgDelErr
002C10r 2  A0 rr                ldy     #>MsgDelErr
002C12r 2  4C rr rr             jmp     BasPrintStr
002C15r 2               
002C15r 2               ; MEM -- print "nnnnn BYTES FREE  HW=$xx"
002C15r 2               BasCmdMem:
002C15r 2                       ; Free bytes = MEMSIZ - VARTAB
002C15r 2  38                   sec
002C16r 2  AD 67 03             lda     BAS_MEMSIZ
002C19r 2  ED 5F 03             sbc     BAS_VARTAB
002C1Cr 2  A8                   tay
002C1Dr 2  AD 68 03             lda     BAS_MEMSIZ+1
002C20r 2  ED 60 03             sbc     BAS_VARTAB+1
002C23r 2  20 rr rr             jsr     GivAyf                  ; FAC = unsigned int from (Y,A)
002C26r 2                       ; Wait: GivAyf is signed.  For this simple display, OK if < 32768.
002C26r 2  20 rr rr             jsr     PrintNum
002C29r 2  A9 rr                lda     #<MsgFree
002C2Br 2  A0 rr                ldy     #>MsgFree
002C2Dr 2  20 rr rr             jsr     BasPrintStr
002C30r 2  A9 24                lda     #'$'
002C32r 2  20 rr rr             jsr     Chrout
002C35r 2  AD 0D 03             lda     HW_PRESENT
002C38r 2  20 rr rr             jsr     PrintHexByte
002C3Br 2  20 rr rr             jsr     BasPrintCRLF
002C3Er 2  4C rr rr             jmp     FsPrintDisk             ; print "DISK n" line
002C41r 2               
002C41r 2               ; DISK n -- select the current CF disk bank (0-255)
002C41r 2               BasCmdDisk:
002C41r 2  20 rr rr             jsr     GetByt                  ; X = value 0-255
002C44r 2  8E 0F 03             stx     CF_DISK
002C47r 2  60                   rts
002C48r 2               
002C48r 2               ; BLOAD addr[,"name"] -- load a file's raw bytes to addr, or with no name
002C48r 2               ; receive them over XModem.  The card each path needs is asked for once the
002C48r 2               ; arguments say which path it is.
002C48r 2               BasCmdBload:
002C48r 2  20 rr rr             jsr     EvalAddrU16             ; FAC+3 = hi, FAC+4 = lo
002C4Br 2  A5 12                lda     z:FAC+4
002C4Dr 2  8D 7F 03             sta     FS_IO_ADDR
002C50r 2  85 2A                sta     XFER_PTR
002C52r 2  A5 11                lda     z:FAC+3
002C54r 2  8D 80 03             sta     FS_IO_ADDR+1
002C57r 2  85 2B                sta     XFER_PTR+1
002C59r 2  20 rr rr             jsr     ChrGot
002C5Cr 2  D0 0A                bne     @cf
002C5Er 2  A9 10                lda     #HW_SC
002C60r 2  20 rr rr             jsr     ReqHw
002C63r 2  20 rr rr             jsr     XModemLoad
002C66r 2  80 0E                bra     @done
002C68r 2               @cf:
002C68r 2  A9 08                lda     #HW_CF
002C6Ar 2  20 rr rr             jsr     ReqHw
002C6Dr 2  20 rr rr             jsr     ChkCom
002C70r 2  20 rr rr             jsr     EvalString              ; filename -> BAS_FNAME, STR_PTR
002C73r 2  20 rr rr             jsr     FsLoadFileAddr
002C76r 2               @done:
002C76r 2  B0 01                bcs     BasLoadErr
002C78r 2  60                   rts
002C79r 2               BasLoadErr:
002C79r 2  A9 rr                lda     #<MsgLoadErr
002C7Br 2  A0 rr                ldy     #>MsgLoadErr
002C7Dr 2  4C rr rr             jmp     BasPrintStr
002C80r 2               
002C80r 2               ; BSAVE addr, len[,"name"] -- save len bytes from addr to a file, or with no
002C80r 2               ; name send them over XModem
002C80r 2               BasCmdBsave:
002C80r 2  20 rr rr             jsr     EvalAddrU16             ; addr
002C83r 2  A5 12                lda     z:FAC+4
002C85r 2  8D 7F 03             sta     FS_IO_ADDR
002C88r 2  85 2A                sta     XFER_PTR
002C8Ar 2  A5 11                lda     z:FAC+3
002C8Cr 2  8D 80 03             sta     FS_IO_ADDR+1
002C8Fr 2  85 2B                sta     XFER_PTR+1
002C91r 2  20 rr rr             jsr     ChkCom
002C94r 2  20 rr rr             jsr     EvalAddrU16             ; length in bytes
002C97r 2  A5 12                lda     z:FAC+4
002C99r 2  8D 4A 03             sta     FS_FILE_SIZE
002C9Cr 2  8D 17 03             sta     XFER_REMAIN
002C9Fr 2  A5 11                lda     z:FAC+3
002CA1r 2  8D 4B 03             sta     FS_FILE_SIZE+1
002CA4r 2  8D 18 03             sta     XFER_REMAIN+1
002CA7r 2  20 rr rr             jsr     ChrGot
002CAAr 2  D0 0A                bne     @cf
002CACr 2  A9 10                lda     #HW_SC
002CAEr 2  20 rr rr             jsr     ReqHw
002CB1r 2  20 rr rr             jsr     XModemSave
002CB4r 2  80 0E                bra     @done
002CB6r 2               @cf:
002CB6r 2  A9 08                lda     #HW_CF
002CB8r 2  20 rr rr             jsr     ReqHw
002CBBr 2  20 rr rr             jsr     ChkCom
002CBEr 2  20 rr rr             jsr     EvalString              ; filename
002CC1r 2  20 rr rr             jsr     FsSaveFileAddr
002CC4r 2               @done:
002CC4r 2  B0 01                bcs     @err
002CC6r 2  60                   rts
002CC7r 2               @err:
002CC7r 2  A9 rr                lda     #<MsgSaveErr
002CC9r 2  A0 rr                ldy     #>MsgSaveErr
002CCBr 2  4C rr rr             jmp     BasPrintStr
002CCEr 2               
002CCEr 2               ; FORMAT -- erase (zero) the current disk's directory, with confirmation
002CCEr 2               BasCmdFormat:
002CCEr 2  A9 08                lda     #HW_CF
002CD0r 2  20 rr rr             jsr     ReqHw
002CD3r 2  A9 rr                lda     #<MsgEraseDisk
002CD5r 2  A0 rr                ldy     #>MsgEraseDisk
002CD7r 2  20 rr rr             jsr     BasPrintStr
002CDAr 2  AD 0F 03             lda     CF_DISK
002CDDr 2  8D 4A 03             sta     FS_FILE_SIZE
002CE0r 2  9C 4B 03             stz     FS_FILE_SIZE+1
002CE3r 2  20 rr rr             jsr     FsPrintSize             ; print disk number (decimal)
002CE6r 2  A9 rr                lda     #<MsgConfirm
002CE8r 2  A0 rr                ldy     #>MsgConfirm
002CEAr 2  20 rr rr             jsr     BasPrintStr
002CEDr 2               @wait:
002CEDr 2  20 rr rr             jsr     Chrin                   ; wait for a key (echoes)
002CF0r 2  90 FB                bcc     @wait
002CF2r 2  29 DF                and     #$DF                    ; fold to uppercase
002CF4r 2  48                   pha
002CF5r 2  20 rr rr             jsr     BasPrintCRLF
002CF8r 2  68                   pla
002CF9r 2  C9 59                cmp     #'Y'
002CFBr 2  D0 03                bne     @abort
002CFDr 2  4C rr rr             jmp     FsFormatDisk            ; zero the directory (returns carry status)
002D00r 2               @abort:
002D00r 2  60                   rts
002D01r 2               
002D01r 2               ; ===========================================================================
002D01r 2               ;   P I C O V D P   S T A T E M E N T S
002D01r 2               ;
002D01r 2               ; Silent without a card, like CLS, LOCATE and COLOR: the arguments are parsed
002D01r 2               ; and range-checked, and then the Kernal entry each ends in skips.  Port A
002D01r 2               ; only, through the $A0B1-$A0D5 entries, so VID_MODE and the LxCTRL shadows
002D01r 2               ; stay true and BasTextConsole knows when a program has left Text mode.
002D01r 2               ; ===========================================================================
002D01r 2               
002D01r 2               ; SCREEN n -- 0 the Text console (InitVideo + CLS); 1 Compact, 2 Graphics,
002D01r 2               ; 3 Full.  The three graphics modes share one layout, which fits Full's 1200-
002D01r 2               ; byte tables (decision 2):
002D01r 2               ;
002D01r 2               ;   $0000 L0 names   $0800 L0 attributes   $1000 L1 names   $1800 L1 attributes
002D01r 2               ;   $2000 sprite attributes   $4000 L0 patterns   $8000 L1 patterns
002D01r 2               ;   $C000 sprite patterns
002D01r 2               ;
002D01r 2               ; Layer 0 4bpp with per-cell attributes, opaque and on; layer 1 the same but
002D01r 2               ; off and transparent; 64 sprites at 4bpp, all parked at Y = 240, below the
002D01r 2               ; picture.  The four tables at $0000-$1FFF are cleared; the pattern tables and
002D01r 2               ; the palette are the program's.  VMODE goes last, through VdpWriteReg, so
002D01r 2               ; VID_MODE says which mode the card is in.
002D01r 2               BasCmdScreen:
002D01r 2  A9 04                lda     #4                      ; 0-3
002D03r 2  20 rr rr             jsr     GetByteLim              ; X = n
002D06r 2  8A                   txa
002D07r 2  D0 06                bne     @graphics
002D09r 2  20 rr rr             jsr     InitVideo
002D0Cr 2  4C rr rr             jmp     VideoClear              ; Both skip without a card
002D0Fr 2               @graphics:
002D0Fr 2  2C 0D 03             bit     HW_PRESENT              ; Video is bit 7
002D12r 2  10 42                bpl     @done
002D14r 2  48                   pha                             ; n
002D15r 2  A0 00                ldy     #0
002D17r 2               @reg:
002D17r 2  BE rr rr             ldx     ScreenLayout,y
002D1Ar 2  B9 rr rr             lda     ScreenLayout+1,y
002D1Dr 2  20 rr rr             jsr     VdpWriteReg             ; Keeps X and Y
002D20r 2  C8                   iny
002D21r 2  C8                   iny
002D22r 2  C0 22                cpy     #(ScreenLayoutEnd - ScreenLayout)
002D24r 2  D0 F1                bne     @reg
002D26r 2  A9 40                lda     #$40                    ; $0000, write
002D28r 2  A2 00                ldx     #0
002D2Ar 2  A0 00                ldy     #0
002D2Cr 2  20 rr rr             jsr     VdpAddress
002D2Fr 2  A2 00                ldx     #0
002D31r 2  A0 20                ldy     #>$2000                 ; 32 pages, the four tables
002D33r 2               @clear:
002D33r 2  9C 00 9C             stz     VC_DATA
002D36r 2  E8                   inx
002D37r 2  D0 FA                bne     @clear
002D39r 2  88                   dey
002D3Ar 2  D0 F7                bne     @clear
002D3Cr 2  A2 40                ldx     #64                     ; On into the sprite table at $2000
002D3Er 2               @sprite:
002D3Er 2  A9 F0                lda     #240                    ; Y: the line below a 240-line picture
002D40r 2  8D 00 9C             sta     VC_DATA
002D43r 2  9C 00 9C             stz     VC_DATA                 ; X
002D46r 2  9C 00 9C             stz     VC_DATA                 ; Pattern
002D49r 2  9C 00 9C             stz     VC_DATA                 ; Attributes
002D4Cr 2  CA                   dex
002D4Dr 2  D0 EF                bne     @sprite
002D4Fr 2  68                   pla
002D50r 2  1A                   inc     a                       ; SCREEN 1-3 is VMODE 2-4
002D51r 2  A2 0D                ldx     #VDP_VMODE
002D53r 2  4C rr rr             jmp     VdpWriteReg
002D56r 2               @done:
002D56r 2  60                   rts
002D57r 2               
002D57r 2               ScreenLayout:                           ; Register, value
002D57r 2  01 40                .byte   VDP_MODE1,    $40       ; Display on, 8x8 sprites unmagnified
002D59r 2  10 00                .byte   VDP_L0NAME,   $00       ; $0000
002D5Br 2  11 02                .byte   VDP_L0ATTR,   $02       ; $0800
002D5Dr 2  12 08                .byte   VDP_L0PAT,    $08       ; $4000
002D5Fr 2  13 00                .byte   VDP_L0SCRX,   $00
002D61r 2  14 00                .byte   VDP_L0SCRY,   $00
002D63r 2  15 32                .byte   VDP_L0CTRL,   $32       ; 4bpp, per cell, on, index 0 opaque
002D65r 2  18 04                .byte   VDP_L1NAME,   $04       ; $1000
002D67r 2  19 06                .byte   VDP_L1ATTR,   $06       ; $1800
002D69r 2  1A 10                .byte   VDP_L1PAT,    $10       ; $8000
002D6Br 2  1B 00                .byte   VDP_L1SCRX,   $00
002D6Dr 2  1C 00                .byte   VDP_L1SCRY,   $00
002D6Fr 2  1D 02                .byte   VDP_L1CTRL,   $02       ; 4bpp, per cell, off, index 0 clear
002D71r 2  20 40                .byte   VDP_SPRATTR,  $40       ; $2000, where VdpSprite writes
002D73r 2  21 18                .byte   VDP_SPRPAT,   $18       ; $C000
002D75r 2  22 40                .byte   VDP_SPRCOUNT, 64
002D77r 2  23 23                .byte   VDP_SPRCTRL,  $23       ; On, collisions, no $D0 end, 4bpp
002D79r 2               ScreenLayoutEnd:
002D79r 2               
002D79r 2               ; VPOKE addr, value -- a byte anywhere in the 64 KB of VRAM
002D79r 2               ; The address rides the stack across the value's evaluation, as POKE's does.
002D79r 2               BasCmdVpoke:
002D79r 2  20 rr rr             jsr     EvalAddrU16
002D7Cr 2  A5 12                lda     FAC+4                   ; lo
002D7Er 2  48                   pha
002D7Fr 2  A5 11                lda     FAC+3                   ; hi
002D81r 2  48                   pha
002D82r 2  20 rr rr             jsr     GetComByt               ; X = value
002D85r 2  8A                   txa
002D86r 2  7A                   ply                             ; hi
002D87r 2  FA                   plx                             ; lo
002D88r 2  4C rr rr             jmp     VdpPoke
002D8Br 2               
002D8Br 2               ; VREG reg, value -- write register 0-127, through VdpWriteReg
002D8Br 2               BasCmdVreg:
002D8Br 2  A9 80                lda     #128
002D8Dr 2  20 rr rr             jsr     GetByteLim              ; X = reg
002D90r 2  DA                   phx
002D91r 2  20 rr rr             jsr     GetComByt               ; X = value
002D94r 2  8A                   txa
002D95r 2  FA                   plx
002D96r 2  4C rr rr             jmp     VdpWriteReg
002D99r 2               
002D99r 2               ; PALETTE index, r, g, b -- palette entry 0-255 at $FC00 + 2 * index, 0-15 each
002D99r 2               BasCmdPalette:
002D99r 2  20 rr rr             jsr     GetByt                  ; X = index
002D9Cr 2  DA                   phx
002D9Dr 2  A9 10                lda     #16
002D9Fr 2  20 rr rr             jsr     GetComByteLim           ; X = r
002DA2r 2  DA                   phx
002DA3r 2  A9 10                lda     #16
002DA5r 2  20 rr rr             jsr     GetComByteLim           ; X = g
002DA8r 2  DA                   phx
002DA9r 2  A9 10                lda     #16
002DABr 2  20 rr rr             jsr     GetComByteLim           ; X = b
002DAEr 2  86 3A                stx     BAS_TMP1
002DB0r 2  68                   pla                             ; g
002DB1r 2  0A                   asl     a
002DB2r 2  0A                   asl     a
002DB3r 2  0A                   asl     a
002DB4r 2  0A                   asl     a
002DB5r 2  05 3A                ora     BAS_TMP1
002DB7r 2  A8                   tay                             ; $GB
002DB8r 2  68                   pla                             ; $0R
002DB9r 2  FA                   plx                             ; index
002DBAr 2  4C rr rr             jmp     VdpSetPalette
002DBDr 2               
002DBDr 2               ; VSYNC -- wait for the start of the next vertical blank (2 cs without a card)
002DBDr 2               BasCmdVsync     := WaitVBlank
002DBDr 2               
002DBDr 2               ; VLOAD "name", addr -- a file from the current disk into VRAM at addr, its
002DBDr 2               ; exact length.  A data statement, so no CF card is ?NO DEVICE; no video card
002DBDr 2               ; reads nothing and says nothing.
002DBDr 2               BasCmdVload:
002DBDr 2  A9 08                lda     #HW_CF
002DBFr 2  20 rr rr             jsr     ReqHw
002DC2r 2  20 rr rr             jsr     EvalString              ; -> BAS_FNAME, STR_PTR
002DC5r 2  20 rr rr             jsr     ChkCom
002DC8r 2  20 rr rr             jsr     EvalAddrU16
002DCBr 2  A5 12                lda     FAC+4
002DCDr 2  8D 7F 03             sta     FS_IO_ADDR
002DD0r 2  A5 11                lda     FAC+3
002DD2r 2  8D 80 03             sta     FS_IO_ADDR+1
002DD5r 2  2C 0D 03             bit     HW_PRESENT              ; Video is bit 7
002DD8r 2  10 08                bpl     @done
002DDAr 2  20 rr rr             jsr     VdpLoadFile
002DDDr 2  90 03                bcc     @done
002DDFr 2  4C rr rr             jmp     BasLoadErr
002DE2r 2               @done:
002DE2r 2  60                   rts
002DE3r 2               
002DE3r 2               ; VPEEK(addr) -- the VRAM byte at addr; 0 without a card
002DE3r 2               FnVpeek:
002DE3r 2  20 rr rr             jsr     ParenNum
002DE6r 2  20 rr rr             jsr     FacToU16
002DE9r 2  A6 12                ldx     FAC+4
002DEBr 2  A4 11                ldy     FAC+3
002DEDr 2  A9 00                lda     #0                      ; What VdpPeek leaves in A without a card
002DEFr 2  20 rr rr             jsr     VdpPeek
002DF2r 2  A8                   tay
002DF3r 2  4C rr rr             jmp     SngFlt
002DF6r 2               
002DF6r 2               ; SPRITE n, x, y, pattern[, attr] -- sprite n (0-63) at x (0-511, 384-511 being
002DF6r 2               ; -128 to -1), y (0-255), with pattern (0-255) and attributes (0-127, default
002DF6r 2               ; 0; b6 priority, b5:4 flips, b3:0 sub-palette).  VdpSprite writes the four
002DF6r 2               ; bytes at $2000 + 4n, where SCREEN 1-3 put the table, with x's bit 8 as the
002DF6r 2               ; attribute's b7.
002DF6r 2               BasCmdSprite:
002DF6r 2  A9 40                lda     #64
002DF8r 2  20 rr rr             jsr     GetByteLim              ; X = n
002DFBr 2  DA                   phx
002DFCr 2  20 rr rr             jsr     ChkCom
002DFFr 2  20 rr rr             jsr     EvalAddrU16             ; x
002E02r 2  A5 11                lda     FAC+3
002E04r 2  C9 02                cmp     #2
002E06r 2  B0 31                bcs     BasVdpRangeErr          ; 512 and up
002E08r 2  8D 9B 03             sta     VDP_P3                  ; Bit 8, until the attributes are in
002E0Br 2  A5 12                lda     FAC+4
002E0Dr 2  8D 99 03             sta     VDP_P1
002E10r 2  20 rr rr             jsr     GetComByt               ; X = y
002E13r 2  8E 98 03             stx     VDP_P0
002E16r 2  20 rr rr             jsr     GetComByt               ; X = pattern
002E19r 2  8E 9A 03             stx     VDP_P2
002E1Cr 2  A2 00                ldx     #0                      ; attr if none is given
002E1Er 2  20 rr rr             jsr     ChrGot
002E21r 2  C9 2C                cmp     #','
002E23r 2  D0 05                bne     @attr
002E25r 2  A9 80                lda     #128
002E27r 2  20 rr rr             jsr     GetComByteLim           ; X = attr
002E2Ar 2               @attr:
002E2Ar 2  8A                   txa
002E2Br 2  4E 9B 03             lsr     VDP_P3                  ; Bit 8 into carry
002E2Er 2  90 02                bcc     @low
002E30r 2  09 80                ora     #$80
002E32r 2               @low:
002E32r 2  8D 9B 03             sta     VDP_P3
002E35r 2  FA                   plx                             ; n
002E36r 2  4C rr rr             jmp     VdpSprite
002E39r 2               
002E39r 2               BasVdpRangeErr:
002E39r 2  4C rr rr             jmp     IqErr
002E3Cr 2               
002E3Cr 2               ; SCROLL layer, x, y -- scroll layer 0-1 to x (0-319), y (0-255)
002E3Cr 2               BasCmdScroll:
002E3Cr 2  A9 02                lda     #2
002E3Er 2  20 rr rr             jsr     GetByteLim              ; X = layer
002E41r 2  DA                   phx
002E42r 2  20 rr rr             jsr     ChkCom
002E45r 2  20 rr rr             jsr     EvalAddrU16             ; x
002E48r 2  A5 11                lda     FAC+3
002E4Ar 2  8D 98 03             sta     VDP_P0                  ; Bit 8
002E4Dr 2  F0 0A                beq     @x
002E4Fr 2  C9 01                cmp     #1
002E51r 2  D0 E6                bne     BasVdpRangeErr
002E53r 2  A5 12                lda     FAC+4
002E55r 2  C9 40                cmp     #64                     ; 256 + 64 = 320
002E57r 2  B0 E0                bcs     BasVdpRangeErr
002E59r 2               @x:
002E59r 2  A5 12                lda     FAC+4
002E5Br 2  48                   pha
002E5Cr 2  20 rr rr             jsr     GetComByt               ; X = y
002E5Fr 2  8A                   txa
002E60r 2  A8                   tay
002E61r 2  68                   pla                             ; x bits 7:0
002E62r 2  FA                   plx                             ; layer
002E63r 2  4C rr rr             jmp     VdpSetScroll
002E66r 2               
002E66r 2               ; LAYER layer, on -- hide layer 0-1 (on = 0) or show it
002E66r 2               BasCmdLayer:
002E66r 2  A9 02                lda     #2
002E68r 2  20 rr rr             jsr     GetByteLim              ; X = layer
002E6Br 2  DA                   phx
002E6Cr 2  20 rr rr             jsr     GetComByt               ; X = on
002E6Fr 2  8A                   txa
002E70r 2  FA                   plx
002E71r 2  4C rr rr             jmp     VdpLayer
002E74r 2               
002E74r 2               ; VSTAT(n) -- status register n, 0-15; 0 without a card.  VSTAT(0) clears
002E74r 2               ; STAT0's flags, as reading it does.
002E74r 2               FnVstat:
002E74r 2  20 rr rr             jsr     ParenU8                 ; A = n
002E77r 2  C9 10                cmp     #16
002E79r 2  B0 BE                bcs     BasVdpRangeErr
002E7Br 2  AA                   tax
002E7Cr 2  A9 00                lda     #0                      ; What VdpStatus leaves in A without a card
002E7Er 2  20 rr rr             jsr     VdpStatus
002E81r 2  A8                   tay
002E82r 2  4C rr rr             jmp     SngFlt
002E85r 2               
002E85r 2               ; ===========================================================================
002E85r 2               ;   S A V E   S L O T   S T A T E M E N T S
002E85r 2               ;
002E85r 2               ; The Kernal's NvWrite, NvRead, NvErase, NvStat and NvFind, slot for slot
002E85r 2               ; (decision 3).  Like NVRAM, the statements raise ?NO DEVICE without an RTC
002E85r 2               ; card, and the functions answer quietly instead: NVSTAT is 0 (free), NVFIND
002E85r 2               ; -1 (nothing found).  The owner ID of a slot stays readable as NVRAM(slot*16).
002E85r 2               ; ===========================================================================
002E85r 2               
002E85r 2               ; NVSAVE slot, id, addr -- the 14 bytes at addr into slot 0-15, owner id 1-255
002E85r 2               BasCmdNvsave:
002E85r 2  A9 04                lda     #HW_RTC
002E87r 2  20 rr rr             jsr     ReqHw
002E8Ar 2  A9 10                lda     #NV_SLOTS
002E8Cr 2  20 rr rr             jsr     GetByteLim              ; X = slot
002E8Fr 2  DA                   phx
002E90r 2  20 rr rr             jsr     GetComByt               ; X = id
002E93r 2  8E 90 03             stx     NV_ID                   ; Kernal RAM: safe across FrmEvl
002E96r 2  8A                   txa
002E97r 2  F0 0E                beq     BasNvRangeErr           ; ID 0 marks a free slot
002E99r 2  20 rr rr             jsr     ChkCom
002E9Cr 2  20 rr rr             jsr     EvalAddrU16             ; addr
002E9Fr 2  A5 12                lda     FAC+4
002EA1r 2  A4 11                ldy     FAC+3
002EA3r 2  FA                   plx                             ; slot
002EA4r 2  4C rr rr             jmp     NvWrite                 ; Nothing left for it to refuse
002EA7r 2               
002EA7r 2               BasNvRangeErr:
002EA7r 2  4C rr rr             jmp     IqErr
002EAAr 2               
002EAAr 2               ; NVLOAD slot, addr -- a valid slot's 14 bytes to addr; ?LOAD ERROR, and
002EAAr 2               ; nothing copied, for a free or damaged one
002EAAr 2               BasCmdNvload:
002EAAr 2  A9 04                lda     #HW_RTC
002EACr 2  20 rr rr             jsr     ReqHw
002EAFr 2  A9 10                lda     #NV_SLOTS
002EB1r 2  20 rr rr             jsr     GetByteLim              ; X = slot
002EB4r 2  DA                   phx
002EB5r 2  20 rr rr             jsr     ChkCom
002EB8r 2  20 rr rr             jsr     EvalAddrU16             ; addr
002EBBr 2  A5 12                lda     FAC+4
002EBDr 2  A4 11                ldy     FAC+3
002EBFr 2  FA                   plx                             ; slot
002EC0r 2  20 rr rr             jsr     NvRead
002EC3r 2  90 03                bcc     @done
002EC5r 2  4C rr rr             jmp     BasLoadErr
002EC8r 2               @done:
002EC8r 2  60                   rts
002EC9r 2               
002EC9r 2               ; NVERASE slot -- zero all 16 bytes of slot 0-15
002EC9r 2               BasCmdNverase:
002EC9r 2  A9 04                lda     #HW_RTC
002ECBr 2  20 rr rr             jsr     ReqHw
002ECEr 2  A9 10                lda     #NV_SLOTS
002ED0r 2  20 rr rr             jsr     GetByteLim              ; X = slot
002ED3r 2  4C rr rr             jmp     NvErase
002ED6r 2               
002ED6r 2               ; NVSTAT(slot) -- 0 free, 1 valid, 2 damaged
002ED6r 2               FnNvstat:
002ED6r 2  20 rr rr             jsr     ParenU8                 ; A = slot
002ED9r 2  C9 10                cmp     #NV_SLOTS
002EDBr 2  B0 CA                bcs     BasNvRangeErr
002EDDr 2  AA                   tax
002EDEr 2  20 rr rr             jsr     NvStat                  ; Carry: no RTC card
002EE1r 2  90 02                bcc     @status
002EE3r 2  A9 00                lda     #NV_EMPTY
002EE5r 2               @status:
002EE5r 2  A8                   tay
002EE6r 2  4C rr rr             jmp     SngFlt
002EE9r 2               
002EE9r 2               ; NVFIND(id) -- the lowest slot owned by id (0: the lowest free slot), or -1
002EE9r 2               FnNvfind:
002EE9r 2  20 rr rr             jsr     ParenU8                 ; A = id
002EECr 2  20 rr rr             jsr     NvFind                  ; X = slot; carry: none, or no RTC card
002EEFr 2  B0 05                bcs     @none
002EF1r 2  8A                   txa
002EF2r 2  A8                   tay
002EF3r 2  4C rr rr             jmp     SngFlt
002EF6r 2               @none:
002EF6r 2  A9 FF                lda     #$FF                    ; -1
002EF8r 2  A8                   tay
002EF9r 2  4C rr rr             jmp     GivAyf
002EFCr 2               
002EFCr 2  20 42 59 54  MsgFree:        .byte   " BYTES FREE  HW=",0
002F00r 2  45 53 20 46  
002F04r 2  52 45 45 20  
002F0Dr 2  3F 4C 4F 41  MsgLoadErr:     .byte   "?LOAD ERROR",$0D,$0A,0
002F11r 2  44 20 45 52  
002F15r 2  52 4F 52 0D  
002F1Br 2  3F 53 41 56  MsgSaveErr:     .byte   "?SAVE ERROR",$0D,$0A,0
002F1Fr 2  45 20 45 52  
002F23r 2  52 4F 52 0D  
002F29r 2  3F 44 45 4C  MsgDelErr:      .byte   "?DEL ERROR",$0D,$0A,0
002F2Dr 2  20 45 52 52  
002F31r 2  4F 52 0D 0A  
002F36r 2  45 52 41 53  MsgEraseDisk:   .byte   "ERASE DISK ",0
002F3Ar 2  45 20 44 49  
002F3Er 2  53 4B 20 00  
002F42r 2  3F 20 28 59  MsgConfirm:     .byte   "? (Y/N) ",0
002F46r 2  2F 4E 29 20  
002F4Ar 2  00           
002F4Br 2               
002F4Br 2               ; Wrappers so the dispatch table can call existing routines that expect
002F4Br 2               ; TXTPTR positioned already.
002F4Br 2               BasCmdPrintW:
002F4Br 2                       ; We were entered via the dispatch trampoline, so TXTPTR is already
002F4Br 2                       ; past the PRINT token (ChrGet was tail-called).  But BasCmdPrint
002F4Br 2                       ; expects to consume the token itself with its first ChrGet; rewind.
002F4Br 2                       ; Easier: BasCmdPrint reads via ChrGet; here ChrGet was called before
002F4Br 2                       ; routine entry, so TXTPTR currently points at first arg.  Just call
002F4Br 2                       ; an internal entry that skips the leading ChrGet.
002F4Br 2  4C rr rr             jmp     BasPrLoop
002F4Er 2               
002F4Er 2               ; ---------------------------------------------------------------------------
002F4Er 2               ; Token-address dispatch table.  Indexed by (token - $80).  Each entry is
002F4Er 2               ; (routine_address - 1) since the dispatcher PHA-pushes it and uses the
002F4Er 2               ; "JMP ChrGet -> RTS" trick to enter.
002F4Er 2               ; ---------------------------------------------------------------------------
002F4Er 2               BasTokenAddrTbl:
002F4Er 2  rr rr                .word   BasCmdEnd-1             ; $80 END
002F50r 2  rr rr                .word   BasCmdFor-1             ; $81 FOR
002F52r 2  rr rr                .word   BasCmdNext-1            ; $82 NEXT
002F54r 2  rr rr                .word   BasCmdData-1            ; $83 DATA
002F56r 2  rr rr                .word   BasCmdInput-1           ; $84 INPUT
002F58r 2  rr rr                .word   BasCmdDim-1             ; $85 DIM
002F5Ar 2  rr rr                .word   BasCmdRead-1            ; $86 READ
002F5Cr 2  rr rr                .word   BasCmdLet-1             ; $87 LET
002F5Er 2  rr rr                .word   BasCmdGoto-1            ; $88 GOTO
002F60r 2  rr rr                .word   BasCmdRun-1             ; $89 RUN
002F62r 2  rr rr                .word   BasCmdIf-1              ; $8A IF
002F64r 2  rr rr                .word   BasCmdRestore-1         ; $8B RESTORE
002F66r 2  rr rr                .word   BasCmdGosub-1           ; $8C GOSUB
002F68r 2  rr rr                .word   BasCmdReturn-1          ; $8D RETURN
002F6Ar 2  rr rr                .word   BasCmdRem-1             ; $8E REM
002F6Cr 2  rr rr                .word   BasCmdStop-1            ; $8F STOP
002F6Er 2  rr rr                .word   BasCmdOn-1              ; $90 ON
002F70r 2  rr rr                .word   BasCmdWait-1            ; $91 WAIT
002F72r 2  rr rr                .word   BasCmdLoad-1            ; $92 LOAD
002F74r 2  rr rr                .word   BasCmdSave-1            ; $93 SAVE
002F76r 2  rr rr                .word   BasCmdDef-1             ; $94 DEF
002F78r 2  rr rr                .word   BasCmdPoke-1            ; $95 POKE
002F7Ar 2  rr rr                .word   BasCmdPrintW-1          ; $96 PRINT
002F7Cr 2  rr rr                .word   BasCmdCont-1            ; $97 CONT
002F7Er 2  rr rr                .word   BasCmdList-1            ; $98 LIST
002F80r 2  rr rr                .word   BasCmdClr-1             ; $99 CLR
002F82r 2  rr rr                .word   BasCmdNew-1             ; $9A NEW
002F84r 2  rr rr                .word   SynErr-1                ; $9B TAB  (function only)
002F86r 2  rr rr                .word   SynErr-1                ; $9C TO
002F88r 2  rr rr                .word   SynErr-1                ; $9D FN
002F8Ar 2  rr rr                .word   SynErr-1                ; $9E SPC
002F8Cr 2  rr rr                .word   SynErr-1                ; $9F THEN
002F8Er 2  rr rr                .word   SynErr-1                ; $A0 NOT
002F90r 2  rr rr                .word   SynErr-1                ; $A1 STEP
002F92r 2  rr rr                .word   SynErr-1                ; $A2 AND
002F94r 2  rr rr                .word   SynErr-1                ; $A3 OR
002F96r 2  rr rr                .word   BasCmdRem-1             ; $A4 ELSE (skip rest of line; THEN-branch ran)
002F98r 2  rr rr                .word   BasCmdSys-1             ; $A5 SYS
002F9Ar 2  rr rr                .word   BasCmdDir-1             ; $A6 DIR
002F9Cr 2  rr rr                .word   BasCmdDel-1             ; $A7 DEL
002F9Er 2  rr rr                .word   BasCmdCls-1             ; $A8 CLS
002FA0r 2  rr rr                .word   BasCmdLocate-1          ; $A9 LOCATE
002FA2r 2  rr rr                .word   BasCmdColor-1           ; $AA COLOR
002FA4r 2  rr rr                .word   BasCmdSound-1           ; $AB SOUND
002FA6r 2  rr rr                .word   BasCmdVol-1             ; $AC VOL
002FA8r 2  rr rr                .word   BasCmdTime-1            ; $AD TIME
002FAAr 2  rr rr                .word   BasCmdDate-1            ; $AE DATE
002FACr 2  rr rr                .word   BasCmdSettime-1         ; $AF SETTIME
002FAEr 2  rr rr                .word   BasCmdSetdate-1         ; $B0 SETDATE
002FB0r 2  rr rr                .word   BasCmdNvram-1           ; $B1 NVRAM
002FB2r 2  rr rr                .word   BasCmdPause-1           ; $B2 PAUSE
002FB4r 2  rr rr                .word   BasCmdBank-1            ; $B3 BANK
002FB6r 2  rr rr                .word   BasCmdScreen-1          ; $B4 SCREEN (BRK in 1.x)
002FB8r 2  rr rr                .word   BasCmdMem-1             ; $B5 MEM
002FBAr 2               
002FBAr 2               ; Extended statement tokens, from TOK_DISK ($D1).  Entries are (handler-1), as
002FBAr 2               ; above; BasExecuteStatement's @ext bounds the index.
002FBAr 2               BasExtAddrTbl:
002FBAr 2  rr rr                .word   BasCmdDisk-1            ; $D1 DISK
002FBCr 2  rr rr                .word   BasCmdBload-1           ; $D2 BLOAD
002FBEr 2  rr rr                .word   BasCmdBsave-1           ; $D3 BSAVE
002FC0r 2  rr rr                .word   BasCmdFormat-1          ; $D4 FORMAT
002FC2r 2  rr rr                .word   BasCmdVpoke-1           ; $D5 VPOKE
002FC4r 2  rr rr                .word   BasCmdVreg-1            ; $D6 VREG
002FC6r 2  rr rr                .word   BasCmdPalette-1         ; $D7 PALETTE
002FC8r 2  rr rr                .word   BasCmdVsync-1           ; $D8 VSYNC
002FCAr 2  rr rr                .word   BasCmdVload-1           ; $D9 VLOAD
002FCCr 2  rr rr                .word   BasCmdSprite-1          ; $DA SPRITE
002FCEr 2  rr rr                .word   BasCmdScroll-1          ; $DB SCROLL
002FD0r 2  rr rr                .word   BasCmdLayer-1           ; $DC LAYER
002FD2r 2  rr rr                .word   BasCmdNvsave-1          ; $DD NVSAVE
002FD4r 2  rr rr                .word   BasCmdNvload-1          ; $DE NVLOAD
002FD6r 2  rr rr                .word   BasCmdNverase-1         ; $DF NVERASE
002FD8r 2               
002FD8r 2               ; =============================================================================
002FD8r 2               ;   K E Y W O R D   T A B L E
002FD8r 2               ;
002FD8r 2               ;   Each keyword is its ASCII characters; the LAST byte has bit 7 set.
002FD8r 2               ;   Order MUST match TOK_xxx equates above (token = TOK_BASE + index).
002FD8r 2               ;   A trailing $00 terminates the table.
002FD8r 2               ; =============================================================================
002FD8r 2               
002FD8r 2               KeywordTbl:
002FD8r 2                       ; Statements
002FD8r 2  45 4E C4             .byte   "EN",'D'|$80            ; $80 END
002FDBr 2  46 4F D2             .byte   "FO",'R'|$80            ; $81 FOR
002FDEr 2  4E 45 58 D4          .byte   "NEX",'T'|$80           ; $82 NEXT
002FE2r 2  44 41 54 C1          .byte   "DAT",'A'|$80           ; $83 DATA
002FE6r 2  49 4E 50 55          .byte   "INPU",'T'|$80          ; $84 INPUT
002FEAr 2  D4           
002FEBr 2  44 49 CD             .byte   "DI",'M'|$80            ; $85 DIM
002FEEr 2  52 45 41 C4          .byte   "REA",'D'|$80           ; $86 READ
002FF2r 2  4C 45 D4             .byte   "LE",'T'|$80            ; $87 LET
002FF5r 2  47 4F 54 CF          .byte   "GOT",'O'|$80           ; $88 GOTO
002FF9r 2  52 55 CE             .byte   "RU",'N'|$80            ; $89 RUN
002FFCr 2  49 C6                .byte   "I",'F'|$80             ; $8A IF
002FFEr 2  52 45 53 54          .byte   "RESTOR",'E'|$80        ; $8B RESTORE
003002r 2  4F 52 C5     
003005r 2  47 4F 53 55          .byte   "GOSU",'B'|$80          ; $8C GOSUB
003009r 2  C2           
00300Ar 2  52 45 54 55          .byte   "RETUR",'N'|$80         ; $8D RETURN
00300Er 2  52 CE        
003010r 2  52 45 CD             .byte   "RE",'M'|$80            ; $8E REM
003013r 2  53 54 4F D0          .byte   "STO",'P'|$80           ; $8F STOP
003017r 2  4F CE                .byte   "O",'N'|$80             ; $90 ON
003019r 2  57 41 49 D4          .byte   "WAI",'T'|$80           ; $91 WAIT
00301Dr 2  4C 4F 41 C4          .byte   "LOA",'D'|$80           ; $92 LOAD
003021r 2  53 41 56 C5          .byte   "SAV",'E'|$80           ; $93 SAVE
003025r 2  44 45 C6             .byte   "DE",'F'|$80            ; $94 DEF
003028r 2  50 4F 4B C5          .byte   "POK",'E'|$80           ; $95 POKE
00302Cr 2  50 52 49 4E          .byte   "PRIN",'T'|$80          ; $96 PRINT
003030r 2  D4           
003031r 2  43 4F 4E D4          .byte   "CON",'T'|$80           ; $97 CONT
003035r 2  4C 49 53 D4          .byte   "LIS",'T'|$80           ; $98 LIST
003039r 2  43 4C D2             .byte   "CL",'R'|$80            ; $99 CLR
00303Cr 2  4E 45 D7             .byte   "NE",'W'|$80            ; $9A NEW
00303Fr 2  54 41 C2             .byte   "TA",'B'|$80            ; $9B TAB
003042r 2  54 CF                .byte   "T",'O'|$80             ; $9C TO
003044r 2  46 CE                .byte   "F",'N'|$80             ; $9D FN
003046r 2  53 50 C3             .byte   "SP",'C'|$80            ; $9E SPC
003049r 2  54 48 45 CE          .byte   "THE",'N'|$80           ; $9F THEN
00304Dr 2  4E 4F D4             .byte   "NO",'T'|$80            ; $A0 NOT
003050r 2  53 54 45 D0          .byte   "STE",'P'|$80           ; $A1 STEP
003054r 2  41 4E C4             .byte   "AN",'D'|$80            ; $A2 AND
003057r 2  4F D2                .byte   "O",'R'|$80             ; $A3 OR
003059r 2  45 4C 53 C5          .byte   "ELS",'E'|$80           ; $A4 ELSE
00305Dr 2  53 59 D3             .byte   "SY",'S'|$80            ; $A5 SYS
003060r 2  44 49 D2             .byte   "DI",'R'|$80            ; $A6 DIR
003063r 2  44 45 CC             .byte   "DE",'L'|$80            ; $A7 DEL
003066r 2  43 4C D3             .byte   "CL",'S'|$80            ; $A8 CLS
003069r 2  4C 4F 43 41          .byte   "LOCAT",'E'|$80         ; $A9 LOCATE
00306Dr 2  54 C5        
00306Fr 2  43 4F 4C 4F          .byte   "COLO",'R'|$80          ; $AA COLOR
003073r 2  D2           
003074r 2  53 4F 55 4E          .byte   "SOUN",'D'|$80          ; $AB SOUND
003078r 2  C4           
003079r 2  56 4F CC             .byte   "VO",'L'|$80            ; $AC VOL
00307Cr 2  54 49 4D C5          .byte   "TIM",'E'|$80           ; $AD TIME
003080r 2  44 41 54 C5          .byte   "DAT",'E'|$80           ; $AE DATE
003084r 2  53 45 54 54          .byte   "SETTIM",'E'|$80        ; $AF SETTIME
003088r 2  49 4D C5     
00308Br 2  53 45 54 44          .byte   "SETDAT",'E'|$80        ; $B0 SETDATE
00308Fr 2  41 54 C5     
003092r 2  4E 56 52 41          .byte   "NVRA",'M'|$80          ; $B1 NVRAM
003096r 2  CD           
003097r 2  50 41 55 53          .byte   "PAUS",'E'|$80          ; $B2 PAUSE
00309Br 2  C5           
00309Cr 2  42 41 4E CB          .byte   "BAN",'K'|$80           ; $B3 BANK
0030A0r 2  53 43 52 45          .byte   "SCREE",'N'|$80         ; $B4 SCREEN (BRK in 1.x)
0030A4r 2  45 CE        
0030A6r 2  4D 45 CD             .byte   "ME",'M'|$80            ; $B5 MEM
0030A9r 2                       ; Functions
0030A9r 2  53 47 CE             .byte   "SG",'N'|$80            ; $B6 Sgn
0030ACr 2  49 4E D4             .byte   "IN",'T'|$80            ; $B7 Int
0030AFr 2  41 42 D3             .byte   "AB",'S'|$80            ; $B8 Abs
0030B2r 2  46 52 C5             .byte   "FR",'E'|$80            ; $B9 FRE
0030B5r 2  50 4F D3             .byte   "PO",'S'|$80            ; $BA POS
0030B8r 2  53 51 D2             .byte   "SQ",'R'|$80            ; $BB Sqr
0030BBr 2  52 4E C4             .byte   "RN",'D'|$80            ; $BC Rnd
0030BEr 2  4C 4F C7             .byte   "LO",'G'|$80            ; $BD Log
0030C1r 2  45 58 D0             .byte   "EX",'P'|$80            ; $BE Exp
0030C4r 2  43 4F D3             .byte   "CO",'S'|$80            ; $BF Cos
0030C7r 2  53 49 CE             .byte   "SI",'N'|$80            ; $C0 Sin
0030CAr 2  54 41 CE             .byte   "TA",'N'|$80            ; $C1 Tan
0030CDr 2  41 54 CE             .byte   "AT",'N'|$80            ; $C2 Atn
0030D0r 2  50 45 45 CB          .byte   "PEE",'K'|$80           ; $C3 PEEK
0030D4r 2  4C 45 CE             .byte   "LE",'N'|$80            ; $C4 LEN
0030D7r 2  53 54 52 A4          .byte   "STR",'$'|$80           ; $C5 STR$
0030DBr 2  56 41 CC             .byte   "VA",'L'|$80            ; $C6 VAL
0030DEr 2  41 53 C3             .byte   "AS",'C'|$80            ; $C7 ASC
0030E1r 2  43 48 52 A4          .byte   "CHR",'$'|$80           ; $C8 CHR$
0030E5r 2  4C 45 46 54          .byte   "LEFT",'$'|$80          ; $C9 LEFT$
0030E9r 2  A4           
0030EAr 2  52 49 47 48          .byte   "RIGHT",'$'|$80         ; $CA RIGHT$
0030EEr 2  54 A4        
0030F0r 2  4D 49 44 A4          .byte   "MID",'$'|$80           ; $CB MID$
0030F4r 2  4A 4F D9             .byte   "JO",'Y'|$80            ; $CC JOY
0030F7r 2  49 4E 4B 45          .byte   "INKE",'Y'|$80          ; $CD INKEY
0030FBr 2  D9           
0030FCr 2  48 45 D8             .byte   "HE",'X'|$80            ; $CE HEX
0030FFr 2  4D 49 CE             .byte   "MI",'N'|$80            ; $CF MIN
003102r 2  4D 41 D8             .byte   "MA",'X'|$80            ; $D0 MAX
003105r 2  44 49 53 CB          .byte   "DIS",'K'|$80           ; $D1 DISK
003109r 2  42 4C 4F 41          .byte   "BLOA",'D'|$80          ; $D2 BLOAD
00310Dr 2  C4           
00310Er 2  42 53 41 56          .byte   "BSAV",'E'|$80          ; $D3 BSAVE
003112r 2  C5           
003113r 2  46 4F 52 4D          .byte   "FORMA",'T'|$80         ; $D4 FORMAT
003117r 2  41 D4        
003119r 2                       ; 2.0 statements
003119r 2  56 50 4F 4B          .byte   "VPOK",'E'|$80          ; $D5 VPOKE
00311Dr 2  C5           
00311Er 2  56 52 45 C7          .byte   "VRE",'G'|$80           ; $D6 VREG
003122r 2  50 41 4C 45          .byte   "PALETT",'E'|$80        ; $D7 PALETTE
003126r 2  54 54 C5     
003129r 2  56 53 59 4E          .byte   "VSYN",'C'|$80          ; $D8 VSYNC
00312Dr 2  C3           
00312Er 2  56 4C 4F 41          .byte   "VLOA",'D'|$80          ; $D9 VLOAD
003132r 2  C4           
003133r 2  53 50 52 49          .byte   "SPRIT",'E'|$80         ; $DA SPRITE
003137r 2  54 C5        
003139r 2  53 43 52 4F          .byte   "SCROL",'L'|$80         ; $DB SCROLL
00313Dr 2  4C CC        
00313Fr 2  4C 41 59 45          .byte   "LAYE",'R'|$80          ; $DC LAYER
003143r 2  D2           
003144r 2  4E 56 53 41          .byte   "NVSAV",'E'|$80         ; $DD NVSAVE
003148r 2  56 C5        
00314Ar 2  4E 56 4C 4F          .byte   "NVLOA",'D'|$80         ; $DE NVLOAD
00314Er 2  41 C4        
003150r 2  4E 56 45 52          .byte   "NVERAS",'E'|$80        ; $DF NVERASE
003154r 2  41 53 C5     
003157r 2                       ; 2.0 functions
003157r 2  56 50 45 45          .byte   "VPEE",'K'|$80          ; $E0 VPEEK
00315Br 2  CB           
00315Cr 2  56 53 54 41          .byte   "VSTA",'T'|$80          ; $E1 VSTAT
003160r 2  D4           
003161r 2  4E 56 53 54          .byte   "NVSTA",'T'|$80         ; $E2 NVSTAT
003165r 2  41 D4        
003167r 2  4E 56 46 49          .byte   "NVFIN",'D'|$80         ; $E3 NVFIND
00316Br 2  4E C4        
00316Dr 2  00                   .byte   0
00316Er 2               
