00178Fr 2               ; ---------------------------------------------------------------------------
00178Fr 2               ; BasCmdClr -- implement CLR (clear vars/arrays/strings without erasing program).
00178Fr 2               ;   VARTAB := PRGEND (already correct in our model)
00178Fr 2               ;   ARYTAB := STREND := VARTAB
00178Fr 2               ;   FRETOP := MEMSIZ
00178Fr 2               ;   TEMPPT := TEMPST, DATAPTR := TXTTAB-1, stacks emptied
00178Fr 2               ; ---------------------------------------------------------------------------
00178Fr 2               BasCmdClr:
00178Fr 2                       ; Reset the CPU stack, msbasic's STKINI: any FOR or GOSUB frame a
00178Fr 2                       ; suspended program left there is being abandoned along with its
00178Fr 2                       ; variables, and RUN starting on top of one would let a later NEXT find
00178Fr 2                       ; a loop from the previous run.  The return address rides across the
00178Fr 2                       ; reset so this is still an ordinary subroutine to its callers.
00178Fr 2  68                   pla                             ; return address low
001790r 2  A8                   tay
001791r 2  68                   pla                             ; return address high
001792r 2  A2 FF                ldx     #$FF
001794r 2  9A                   txs
001795r 2  8E 75 03             stx     BAS_STKBASE
001798r 2  48                   pha
001799r 2  98                   tya
00179Ar 2  48                   pha
00179Br 2                       ; ARYTAB = STREND = VARTAB
00179Br 2  AD 5F 03             lda     VARTAB
00179Er 2  8D 61 03             sta     ARYTAB
0017A1r 2  8D 63 03             sta     STREND
0017A4r 2  AD 60 03             lda     VARTAB+1
0017A7r 2  8D 62 03             sta     ARYTAB+1
0017AAr 2  8D 64 03             sta     STREND+1
0017ADr 2                       ; FRETOP = MEMSIZ
0017ADr 2  AD 67 03             lda     MEMSIZ
0017B0r 2  8D 65 03             sta     FRETOP
0017B3r 2  AD 68 03             lda     MEMSIZ+1
0017B6r 2  8D 66 03             sta     FRETOP+1
0017B9r 2                       ; Reset temp string descriptor stack.
0017B9r 2  A9 6E                lda     #BAS_TEMPST
0017BBr 2  85 6B                sta     TEMPPT
0017BDr 2  64 6C                stz     LASTPT
0017BFr 2  64 6D                stz     LASTPT+1
0017C1r 2                       ; CONT state, DATA pointer, pending key.
0017C1r 2                       ; DATAPTR := TXTTAB - 1 so first READ does FindData and lands on
0017C1r 2                       ; the first DATA item.
0017C1r 2  38                   sec
0017C2r 2  AD 5D 03             lda     TXTTAB
0017C5r 2  E9 01                sbc     #1
0017C7r 2  8D 1A 03             sta     BAS_DATAPTR
0017CAr 2  AD 5E 03             lda     TXTTAB+1
0017CDr 2  E9 00                sbc     #0
0017CFr 2  8D 1B 03             sta     BAS_DATAPTR+1
0017D2r 2  9C 6B 03             stz     BAS_OLDLIN
0017D5r 2  9C 6C 03             stz     BAS_OLDLIN+1
0017D8r 2  9C 6D 03             stz     BAS_OLDTEXT
0017DBr 2  9C 6E 03             stz     BAS_OLDTEXT+1
0017DEr 2  9C 1C 03             stz     BAS_STOPLINE
0017E1r 2  9C 1D 03             stz     BAS_STOPLINE+1
0017E4r 2  9C 1E 03             stz     BAS_STOPTXT
0017E7r 2  9C 1F 03             stz     BAS_STOPTXT+1
0017EAr 2  9C 0E 03             stz     BAS_PENDKEY
0017EDr 2  64 63                stz     DIMFLG
0017EFr 2  64 68                stz     SUBFLG
0017F1r 2  64 64                stz     VALTYP
0017F3r 2  64 65                stz     VALTYP+1
0017F5r 2  64 67                stz     DATAFLG
0017F7r 2  60                   rts
