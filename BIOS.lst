00090Dr 2  80 11          bra @Operand
00090Fr 2               @BitNum:
00090Fr 2  A5 34          lda MON_BYTE                  ; opcode encodes bit in upper nibble
000911r 2  4A             lsr a
000912r 2  4A             lsr a
000913r 2  4A             lsr a
000914r 2  4A             lsr a
