0011A2r 2               ; Parser predicates (operate on byte at TXTPTR; advance via ChrGet).
0011A2r 2               ; ---------------------------------------------------------------------------
0011A2r 2               ChkCom:
0011A2r 2  A9 2C                lda     #','
0011A4r 2  2C                   .byte   $2C                     ; BIT abs -> skip next 2 bytes
0011A5r 2               SynChr:
0011A5r 2                       ; Used by code that wants a specific char.  A on entry = required char.
0011A5r 2  A0 00                ldy     #0
0011A7r 2  D2 04                cmp     (TXTPTR)
0011A9r 2  D0 E5                bne     SynErr
0011ABr 2  4C rr rr             jmp     ChrGet
0011AEr 2               
