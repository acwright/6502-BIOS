0017DCr 2               VT_SetTxt:
0017DCr 2                       ; Set TXTPTR = VT_TXTPTR_TMP - 1 then ChrGet to load first char.
0017DCr 2                       ; Actually simpler: caller passes (Y,A) = pointer; we set TXTPTR =
0017DCr 2                       ; (Y,A) - 1 and call ChrGet to land on (Y,A).
0017DCr 2                       sta     TXTPTR
0017DCr 2                       sty     TXTPTR+1
0017DCr 2                       lda     TXTPTR
0017DCr 2                       bne     @nb
0017DCr 2                       dec     TXTPTR+1
