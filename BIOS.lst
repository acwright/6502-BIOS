000E92r 2               
000E92r 2               ; Addressing mode operand size table (bytes beyond opcode)
000E92r 2               DisModeSizes:
000E92r 2  00             .byte 0                  ; AM_IMP  = 0
000E93r 2  00             .byte 0                  ; AM_ACC  = 1
000E94r 2  01             .byte 1                  ; AM_IMM  = 2
000E95r 2  01             .byte 1                  ; AM_ZP   = 3
000E96r 2  01             .byte 1                  ; AM_ZPX  = 4
000E97r 2  01             .byte 1                  ; AM_ZPY  = 5
000E98r 2  02             .byte 2                  ; AM_ABS  = 6
000E99r 2  02             .byte 2                  ; AM_ABX  = 7
000E9Ar 2  02             .byte 2                  ; AM_ABY  = 8
000E9Br 2  02             .byte 2                  ; AM_IND  = 9
000E9Cr 2  01             .byte 1                  ; AM_IZX  = 10
000E9Dr 2  01             .byte 1                  ; AM_IZY  = 11
000E9Er 2  01             .byte 1                  ; AM_ZPI  = 12
000E9Fr 2  01             .byte 1                  ; AM_REL  = 13
000EA0r 2  02             .byte 2                  ; AM_ZPR  = 14
000EA1r 2  02             .byte 2                  ; AM_AIX  = 15
000EA2r 2               
000EA2r 2               ; Operand print dispatch table (16 addressing modes)
000EA2r 2               DisOperandJmpTable:
000EA2r 2  rr rr          .word DisOpImp             ; AM_IMP  = 0
000EA4r 2  rr rr          .word DisOpAcc             ; AM_ACC  = 1
000EA6r 2  rr rr          .word DisOpImm             ; AM_IMM  = 2
000EA8r 2  rr rr          .word DisOpZp              ; AM_ZP   = 3
000EAAr 2  rr rr          .word DisOpZpx             ; AM_ZPX  = 4
000EACr 2  rr rr          .word DisOpZpy             ; AM_ZPY  = 5
000EAEr 2  rr rr          .word DisOpAbs             ; AM_ABS  = 6
000EB0r 2  rr rr          .word DisOpAbx             ; AM_ABX  = 7
000EB2r 2  rr rr          .word DisOpAby             ; AM_ABY  = 8
000EB4r 2  rr rr          .word DisOpInd             ; AM_IND  = 9
000EB6r 2  rr rr          .word DisOpIzx             ; AM_IZX  = 10
000EB8r 2  rr rr          .word DisOpIzy             ; AM_IZY  = 11
000EBAr 2  rr rr          .word DisOpZpi             ; AM_ZPI  = 12
000EBCr 2  rr rr          .word DisOpRel             ; AM_REL  = 13
000EBEr 2  rr rr          .word DisOpZpr             ; AM_ZPR  = 14
000EC0r 2  rr rr          .word DisOpAix             ; AM_AIX  = 15
000EC2r 2               
000EC2r 2               ; 65C02 Opcode Table — 256 entries x 2 bytes (mnemonic index, addressing mode)
000EC2r 2               DisOpcodeTable:
000EC2r 2                 ; --- $0x ---
000EC2r 2  0D 00 25 0A    .byte MN_BRK,AM_IMP, MN_ORA,AM_IZX, MN_UND,AM_IMP, MN_UND,AM_IMP  ; $00-$03
000EC6r 2  46 00 46 00  
000ECAr 2  40 03 25 03    .byte MN_TSB,AM_ZP,  MN_ORA,AM_ZP,  MN_ASL,AM_ZP,  MN_RMB,AM_ZP   ; $04-$07
000ECEr 2  02 03 2E 03  
