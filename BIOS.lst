0017DCr 2                       jsr     VT_StoreFAC
0017DCr 2               
0017DCr 2                       lda     #<VT_NameB
0017DCr 2                       ldy     #>VT_NameB
0017DCr 2                       jsr     VT_SetTxt
0017DCr 2                       jsr     PtrGet                  ; creates B
0017DCr 2                       ; Save B's VARPNT.
0017DCr 2                       lda     VARPNT
0017DCr 2                       sta     VT_VPSAVE
0017DCr 2                       lda     VARPNT+1
0017DCr 2                       sta     VT_VPSAVE+1
0017DCr 2               
0017DCr 2                       ; Look up A again (already exists).
0017DCr 2                       lda     #<VT_NameA
0017DCr 2                       ldy     #>VT_NameA
0017DCr 2                       jsr     VT_SetTxt
0017DCr 2                       jsr     PtrGet
0017DCr 2                       jsr     VT_LoadFAC              ; FAC = A = 3.14
0017DCr 2                       ; Multiply by 2.
0017DCr 2                       lda     #<FpC2
0017DCr 2                       ldy     #>FpC2
0017DCr 2                       jsr     FMult                   ; FAC = 2 * FAC = 6.28
0017DCr 2                       ; Store into B.
0017DCr 2                       ldx     VT_VPSAVE
0017DCr 2                       ldy     VT_VPSAVE+1
0017DCr 2                       jsr     StoreFacAtYxRounded
0017DCr 2               
0017DCr 2                       ; Print result.
0017DCr 2                       lda     #<MsgVT_A
0017DCr 2                       ldy     #>MsgVT_A
0017DCr 2                       jsr     BasPrintStr
0017DCr 2                       ; Reload B and print.
0017DCr 2                       lda     VT_VPSAVE
0017DCr 2                       ldy     VT_VPSAVE+1
0017DCr 2                       jsr     LoadFacFromYa
0017DCr 2                       jsr     BasPrintFAC
0017DCr 2                       jsr     BasPrintCRLF
0017DCr 2               
0017DCr 2                       ; --- Test 2: A$="HELLO" ---
0017DCr 2                       lda     #<VT_NameAS
0017DCr 2                       ldy     #>VT_NameAS
0017DCr 2                       jsr     VT_SetTxt
0017DCr 2                       jsr     PtrGet                  ; creates A$
0017DCr 2                       ; Save VARPNT (A$ descriptor address).
0017DCr 2                       lda     VARPNT
0017DCr 2                       sta     VT_VPSAVE
0017DCr 2                       lda     VARPNT+1
0017DCr 2                       sta     VT_VPSAVE+1
0017DCr 2                       ; Allocate space, copy "HELLO" via StrLit.
0017DCr 2                       lda     #<VT_HelloLit
0017DCr 2                       ldy     #>VT_HelloLit
0017DCr 2                       jsr     StrLit                  ; FAC has descriptor, in temp stack
0017DCr 2                       ; Now copy descriptor (3 bytes from temp stack entry) to A$ var.
0017DCr 2                       ; FAC+3,4 points at the temp descriptor; FAC = length, FAC+1/2 = addr.
0017DCr 2                       ; The descriptor lives in TEMPST.  We just write [len][lo][hi] into
0017DCr 2                       ; (VARPNT) so the variable now references the heap copy.
0017DCr 2                       lda     FAC
0017DCr 2                       ldy     #$00
0017DCr 2                       sta     (VT_VPSAVE),y           ; length
0017DCr 2                       lda     FAC+1
0017DCr 2                       iny
0017DCr 2                       sta     (VT_VPSAVE),y           ; addr lo
0017DCr 2                       lda     FAC+2
0017DCr 2                       iny
0017DCr 2                       sta     (VT_VPSAVE),y           ; addr hi
0017DCr 2                       ; Print length.
0017DCr 2                       lda     #<MsgVT_AS
0017DCr 2                       ldy     #>MsgVT_AS
0017DCr 2                       jsr     BasPrintStr
0017DCr 2                       ldy     #$00
0017DCr 2                       lda     (VT_VPSAVE),y
0017DCr 2                       tay
0017DCr 2                       jsr     SngFlt
0017DCr 2                       jsr     BasPrintFAC
0017DCr 2                       jsr     BasPrintCRLF
0017DCr 2               
0017DCr 2                       ; --- Test 3: DIM N(10), N(5)=42 ---
0017DCr 2                       ; Build TXTPTR pointing at "N(10) " and call MakInt-equivalent path.
0017DCr 2                       ; Easier: directly construct array via PtrGet3 + Array by simulating
0017DCr 2                       ; a 1-D DIM of size 11 (indices 0..10).  We emulate the parser:
0017DCr 2                       ;   1. Set DIMFLG = $40, VARNAM = ('N','N'), call PtrGet3 with X=1?
0017DCr 2                       ;   2. Or: just do PtrGet3 entry by hand then jmp Array.
0017DCr 2                       ; Simplest: set TXTPTR at "N(10) ", DIMFLG <- $40 (from DIM
0017DCr 2                       ; statement), then PtrGet3 with VARNAM letter, jmp to '(' branch.
0017DCr 2                       lda     #<VT_DimN10
0017DCr 2                       ldy     #>VT_DimN10
0017DCr 2                       jsr     VT_SetTxt               ; A = 'N'
0017DCr 2                       ldx     #$40                    ; from-DIM flag (bit 6)
0017DCr 2                       jsr     PtrGet2                 ; will hit '(' -> Array -> create
0017DCr 2                       ; Now N(5)=42.  Re-parse "N(5)" to find element.
0017DCr 2                       lda     #<VT_DimN5
0017DCr 2                       ldy     #>VT_DimN5
0017DCr 2                       jsr     VT_SetTxt
0017DCr 2                       jsr     PtrGet                  ; element address in VARPNT
0017DCr 2                       ; Save VARPNT.
0017DCr 2                       lda     VARPNT
0017DCr 2                       sta     VT_VPSAVE
0017DCr 2                       lda     VARPNT+1
0017DCr 2                       sta     VT_VPSAVE+1
0017DCr 2                       ; FAC = 42.
0017DCr 2                       lda     #<Vt42
0017DCr 2                       ldy     #>Vt42
0017DCr 2                       jsr     LoadFacFromYa
0017DCr 2                       ldx     VT_VPSAVE
0017DCr 2                       ldy     VT_VPSAVE+1
0017DCr 2                       jsr     StoreFacAtYxRounded
0017DCr 2                       ; Read it back and print.
0017DCr 2                       lda     #<MsgVT_NewArr
0017DCr 2                       ldy     #>MsgVT_NewArr
0017DCr 2                       jsr     BasPrintStr
0017DCr 2                       lda     VT_VPSAVE
0017DCr 2                       ldy     VT_VPSAVE+1
0017DCr 2                       jsr     LoadFacFromYa
0017DCr 2                       jsr     BasPrintFAC
0017DCr 2                       jsr     BasPrintCRLF
0017DCr 2               
0017DCr 2                       ; --- Test 4: 8 string allocations + GC ---
0017DCr 2                       ldx     #8
0017DCr 2               @galloc:
0017DCr 2                       phx
0017DCr 2                       lda     #16
0017DCr 2                       jsr     StrSpa                  ; consumes 16 bytes; FAC has descriptor
0017DCr 2                       plx
0017DCr 2                       dex
0017DCr 2                       bne     @galloc
0017DCr 2                       ; Force GC (TEMPPT got bumped by StrSpa-via-StrIni? StrSpa itself
0017DCr 2                       ; doesn't call PutNew, so temp stack untouched here.)
0017DCr 2                       jsr     Garbag
0017DCr 2                       lda     #<MsgVT_GC
0017DCr 2                       ldy     #>MsgVT_GC
0017DCr 2                       jsr     BasPrintStr
0017DCr 2                       lda     FRETOP+1
0017DCr 2                       ldy     FRETOP
0017DCr 2                       jsr     GivAyf
0017DCr 2                       jsr     BasPrintFAC
0017DCr 2                       jsr     BasPrintCRLF
0017DCr 2               
0017DCr 2                       rts
0017DCr 2               .endif
0017DCr 2               
0017DCr 2               ; =============================================================================
0017DCr 2               ;   E X P R E S S I O N   E V A L U A T O R
0017DCr 2               ;
0017DCr 2               ;   Recursive-descent precedence climber.  Operates on tokenized text at
0017DCr 2               ;   TXTPTR (advanced via ChrGet/ChrGot).  Result lands in FAC (numeric)
0017DCr 2               ;   or as a 3-byte string descriptor at FAC..FAC+2 (string).  VALTYP
0017DCr 2               ;   selects: $00 = numeric, $FF = string.
0017DCr 2               ;
0017DCr 2               ;   Precedence (lowest -> highest):
0017DCr 2               ;     OR
0017DCr 2               ;     AND
0017DCr 2               ;     NOT  (right-assoc unary)
0017DCr 2               ;     comparison (= <> < > <= >=)
0017DCr 2               ;     + -
0017DCr 2               ;     * /
0017DCr 2               ;     ^    (right-assoc)
0017DCr 2               ;     unary -, unary +
0017DCr 2               ;     atom: number, variable, string-literal, "(" expr ")", function call
0017DCr 2               ; =============================================================================
0017DCr 2               
0017DCr 2               ; ---------------------------------------------------------------------------
0017DCr 2               ; ZP scratch used only during expression evaluation.
0017DCr 2               ;   BAS_LVTYP = saved VALTYP of left operand around binary ops
0017DCr 2               ; ---------------------------------------------------------------------------
0017DCr 2               BAS_LVTYP       := $86
0017DCr 2               
0017DCr 2               ; ---------------------------------------------------------------------------
0017DCr 2               ; FrmEvl -- top-level entry.  TXTPTR positioned so ChrGot returns the first
0017DCr 2               ; byte of the expression.  On exit TXTPTR is at the first byte AFTER the
0017DCr 2               ; expression.  Result in FAC + VALTYP.
0017DCr 2               ; ---------------------------------------------------------------------------
0017DCr 2               FrmEvl:
0017DCr 2  4C rr rr             jmp     EvalOr
0017DFr 2               
0017DFr 2               ; ---------------------------------------------------------------------------
0017DFr 2               ; PushFac -- push the current FAC + VALTYP onto the CPU stack (8 bytes).
0017DFr 2               ; Order pushed: VALTYP, FAC, FAC+1, FAC+2, FAC+3, FAC+4, FACSIGN, FACEXTENSION
0017DFr 2               ; (FACEXTENSION pushed last so it's pulled first by PullArg.)
0017DFr 2               ; Preserves the return address.
0017DFr 2               ; ---------------------------------------------------------------------------
0017DFr 2               PushFac:
0017DFr 2  68                   pla
0017E0r 2  A8                   tay                             ; Y = ret-addr lo
0017E1r 2  68                   pla
0017E2r 2  AA                   tax                             ; X = ret-addr hi
0017E3r 2  A5 64                lda     VALTYP
0017E5r 2  48                   pha
0017E6r 2  A5 0E                lda     FAC
0017E8r 2  48                   pha
0017E9r 2  A5 0F                lda     FAC+1
0017EBr 2  48                   pha
0017ECr 2  A5 10                lda     FAC+2
0017EEr 2  48                   pha
0017EFr 2  A5 11                lda     FAC+3
0017F1r 2  48                   pha
0017F2r 2  A5 12                lda     FAC+4
0017F4r 2  48                   pha
0017F5r 2  A5 13                lda     FACSIGN
0017F7r 2  48                   pha
0017F8r 2  A5 1D                lda     FACEXTENSION
0017FAr 2  48                   pha
0017FBr 2  8A                   txa
0017FCr 2  48                   pha
0017FDr 2  98                   tya
0017FEr 2  48                   pha
0017FFr 2  60                   rts
001800r 2               
001800r 2               ; ---------------------------------------------------------------------------
001800r 2               ; PullArg -- pop the previously-pushed FAC into ARG (signed FP value or
001800r 2               ; string descriptor in ARG..ARG+2/sign).  Sets BAS_LVTYP to the saved
001800r 2               ; left-operand VALTYP.  Preserves return address.
001800r 2               ; ---------------------------------------------------------------------------
001800r 2               PullArg:
001800r 2  68                   pla
001801r 2  A8                   tay                             ; Y = ret-addr lo
001802r 2  68                   pla
001803r 2  AA                   tax                             ; X = ret-addr hi
001804r 2  68                   pla
001805r 2  85 43                sta     ARGEXTENSION
001807r 2  68                   pla
001808r 2  85 1B                sta     ARGSIGN
00180Ar 2  68                   pla
00180Br 2  85 1A                sta     ARG+4
00180Dr 2  68                   pla
00180Er 2  85 19                sta     ARG+3
001810r 2  68                   pla
001811r 2  85 18                sta     ARG+2
001813r 2  68                   pla
001814r 2  85 17                sta     ARG+1
001816r 2  68                   pla
001817r 2  85 16                sta     ARG
001819r 2  68                   pla
00181Ar 2  85 86                sta     BAS_LVTYP
00181Cr 2  8A                   txa
00181Dr 2  48                   pha
00181Er 2  98                   tya
00181Fr 2  48                   pha
001820r 2  60                   rts
001821r 2               
001821r 2               ; ---------------------------------------------------------------------------
001821r 2               ; PullFac -- pop pushed FAC back into FAC (used to discard right side and
001821r 2               ; restore left, e.g. unused).
001821r 2               ; ---------------------------------------------------------------------------
001821r 2               PullFac:
001821r 2  68                   pla
001822r 2  A8                   tay
001823r 2  68                   pla
001824r 2  AA                   tax
001825r 2  68                   pla
001826r 2  85 1D                sta     FACEXTENSION
001828r 2  68                   pla
001829r 2  85 13                sta     FACSIGN
00182Br 2  68                   pla
00182Cr 2  85 12                sta     FAC+4
00182Er 2  68                   pla
00182Fr 2  85 11                sta     FAC+3
001831r 2  68                   pla
001832r 2  85 10                sta     FAC+2
001834r 2  68                   pla
001835r 2  85 0F                sta     FAC+1
001837r 2  68                   pla
001838r 2  85 0E                sta     FAC
00183Ar 2  68                   pla
00183Br 2  85 64                sta     VALTYP
00183Dr 2  8A                   txa
00183Er 2  48                   pha
00183Fr 2  98                   tya
001840r 2  48                   pha
001841r 2  60                   rts
001842r 2               
001842r 2               ; ---------------------------------------------------------------------------
001842r 2               ; TypeMismatch helper.
001842r 2               ; ---------------------------------------------------------------------------
001842r 2               EvalTypeErr:
001842r 2  A2 08                ldx     #ERR_TYPEMISM
001844r 2  4C rr rr             jmp     BasErrorVec
001847r 2               
001847r 2               ; ===========================================================================
001847r 2               ;   L E V E L 0  --  O R
001847r 2               ; ===========================================================================
001847r 2               EvalOr:
001847r 2  20 rr rr             jsr     EvalAnd
00184Ar 2               @loop:
00184Ar 2  20 rr rr             jsr     ChrGot
00184Dr 2  C9 A3                cmp     #TOK_OR
00184Fr 2  D0 17                bne     @done
001851r 2  20 rr rr             jsr     ChkNum                  ; left must be numeric
001854r 2  20 rr rr             jsr     ChrGet                  ; consume OR
001857r 2  20 rr rr             jsr     PushFac
00185Ar 2  20 rr rr             jsr     EvalAnd
00185Dr 2  20 rr rr             jsr     ChkNum                  ; right must be numeric
001860r 2  20 rr rr             jsr     PullArg
001863r 2  20 rr rr             jsr     OrOp
001866r 2  80 E2                bra     @loop
001868r 2               @done:
001868r 2  60                   rts
001869r 2               
001869r 2               ; ===========================================================================
001869r 2               ;   L E V E L 1  --  A N D
001869r 2               ; ===========================================================================
001869r 2               EvalAnd:
001869r 2  20 rr rr             jsr     EvalNot
00186Cr 2               @loop:
00186Cr 2  20 rr rr             jsr     ChrGot
00186Fr 2  C9 A2                cmp     #TOK_AND
001871r 2  D0 17                bne     @done
001873r 2  20 rr rr             jsr     ChkNum
001876r 2  20 rr rr             jsr     ChrGet
001879r 2  20 rr rr             jsr     PushFac
00187Cr 2  20 rr rr             jsr     EvalNot
00187Fr 2  20 rr rr             jsr     ChkNum
001882r 2  20 rr rr             jsr     PullArg
001885r 2  20 rr rr             jsr     AndOp
001888r 2  80 E2                bra     @loop
00188Ar 2               @done:
00188Ar 2  60                   rts
00188Br 2               
00188Br 2               ; ===========================================================================
00188Br 2               ;   L E V E L 2  --  N O T   (right-assoc unary prefix)
00188Br 2               ; ===========================================================================
00188Br 2               EvalNot:
00188Br 2  20 rr rr             jsr     ChrGot
00188Er 2  C9 A0                cmp     #TOK_NOT
001890r 2  D0 0C                bne     EvalCmp
001892r 2  20 rr rr             jsr     ChrGet
001895r 2  20 rr rr             jsr     EvalNot
001898r 2  20 rr rr             jsr     ChkNum
00189Br 2  4C rr rr             jmp     NotOp
00189Er 2               
00189Er 2               ; ===========================================================================
00189Er 2               ;   L E V E L 3  --  C O M P A R I S O N
00189Er 2               ;   Reads up to two of {<, =, >} forming a relop; if none, no-op.
00189Er 2               ;   Mask:  bit 0 = '>' present, bit 1 = '=' present, bit 2 = '<' present
00189Er 2               ; ===========================================================================
00189Er 2               EvalCmp:
00189Er 2  20 rr rr             jsr     EvalAdd
0018A1r 2  A2 00                ldx     #0                      ; relop mask
0018A3r 2               @scan:
0018A3r 2  20 rr rr             jsr     ChrGot
0018A6r 2  C9 3D                cmp     #'='
0018A8r 2  F0 0A                beq     @gotEq
0018AAr 2  C9 3C                cmp     #'<'
0018ACr 2  F0 0A                beq     @gotLt
0018AEr 2  C9 3E                cmp     #'>'
0018B0r 2  F0 0A                beq     @gotGt
0018B2r 2  80 1D                bra     @done
0018B4r 2               @gotEq:
0018B4r 2  A0 02                ldy     #2
0018B6r 2  80 06                bra     @setbit
0018B8r 2               @gotLt:
0018B8r 2  A0 04                ldy     #4
0018BAr 2  80 02                bra     @setbit
0018BCr 2               @gotGt:
0018BCr 2  A0 01                ldy     #1
0018BEr 2               @setbit:
0018BEr 2  84 45                sty     CPRMASK                 ; reuse as scratch
0018C0r 2  8A                   txa
0018C1r 2  25 45                and     CPRMASK
0018C3r 2  D0 09                bne     @synErr                 ; same char twice (e.g. "==")
0018C5r 2  8A                   txa
0018C6r 2  05 45                ora     CPRMASK
0018C8r 2  AA                   tax
0018C9r 2  20 rr rr             jsr     ChrGet
0018CCr 2  80 D5                bra     @scan
0018CEr 2               @synErr:
0018CEr 2  4C rr rr             jmp     SynErr
0018D1r 2               @done:
0018D1r 2  E0 00                cpx     #0
0018D3r 2  D0 01                bne     @doCmp
0018D5r 2  60                   rts
0018D6r 2               @doCmp:
0018D6r 2  86 45                stx     CPRMASK
0018D8r 2                       ; Save left operand, evaluate right
0018D8r 2  20 rr rr             jsr     PushFac
0018DBr 2  20 rr rr             jsr     EvalAdd
0018DEr 2  20 rr rr             jsr     PullArg                 ; ARG = left, BAS_LVTYP = left's type
0018E1r 2                       ; Type compatibility check.
0018E1r 2  A5 86                lda     BAS_LVTYP
0018E3r 2  45 64                eor     VALTYP
0018E5r 2  10 03 4C rr          jmi     EvalTypeErr             ; one numeric, one string -> mismatch
0018E9r 2  rr           
0018EAr 2  24 64                bit     VALTYP
0018ECr 2  30 03                bmi     @strCmp
0018EEr 2                       ; Numeric comparison.
0018EEr 2  4C rr rr             jmp     RelOpsNum
0018F1r 2               @strCmp:
0018F1r 2  4C rr rr             jmp     RelOpsStr
0018F4r 2               
0018F4r 2               ; ---------------------------------------------------------------------------
0018F4r 2               ; RelOpsNum -- numeric comparison.
0018F4r 2               ; Inputs: ARG = left, FAC = right, CPRMASK = relop mask (bit 0=>, 1==, 2=<).
0018F4r 2               ; Output: FAC = -1 if (ARG <op> FAC) is true, else 0.  VALTYP = numeric.
0018F4r 2               ; ---------------------------------------------------------------------------
0018F4r 2               RelOpsNum:
0018F4r 2                       ; Replicate msbasic ARG-pre-relop fixup: clear ARG+1 high bit, then
0018F4r 2                       ; set it from ARGSIGN's MSB.  This rebuilds the implicit-1 mantissa
0018F4r 2                       ; for FCOMP's signed comparison path.
0018F4r 2  A5 1B                lda     ARGSIGN
0018F6r 2  09 7F                ora     #$7F
0018F8r 2  25 17                and     ARG+1
0018FAr 2  85 17                sta     ARG+1
0018FCr 2  A9 16                lda     #<ARG
0018FEr 2  A0 00                ldy     #$00
001900r 2  20 rr rr             jsr     FComp                   ; A = sign(FAC - ARG)
001903r 2                       ; Map A to bit position:
001903r 2                       ;   FAC<ARG (A=$FF): ARG>FAC  -> bit 0 (mask 1)
001903r 2                       ;   FAC=ARG (A=$00):           -> bit 1 (mask 2)
001903r 2                       ;   FAC>ARG (A=$01): ARG<FAC  -> bit 2 (mask 4)
001903r 2  AA                   tax
001904r 2  30 06                bmi     @lt
001906r 2  F0 08                beq     @eq
001908r 2  A9 04                lda     #4
00190Ar 2  80 06                bra     @check
00190Cr 2               @lt:
00190Cr 2  A9 01                lda     #1
00190Er 2  80 02                bra     @check
001910r 2               @eq:
001910r 2  A9 02                lda     #2
001912r 2               @check:
001912r 2  25 45                and     CPRMASK
001914r 2  F0 07                beq     @false
001916r 2  A9 FF                lda     #$FF
001918r 2  A0 FF                ldy     #$FF
00191Ar 2  4C rr rr             jmp     GivAyf
00191Dr 2               @false:
00191Dr 2  A9 00                lda     #0
00191Fr 2  A8                   tay
001920r 2  4C rr rr             jmp     GivAyf
001923r 2               
001923r 2               ; ---------------------------------------------------------------------------
001923r 2               ; RelOpsStr -- bytewise string comparison.
001923r 2               ; ARG = left descriptor (ARG=len, ARG+1=lo, ARG+2=hi, ARGSIGN, ARGEXT pushed).
001923r 2               ; FAC = right descriptor.  CPRMASK as above.
001923r 2               ; ---------------------------------------------------------------------------
001923r 2               RelOpsStr:
001923r 2                       ; INDEX = left ptr, BAS_TMP1 = right ptr, BAS_TMP2 lo = left len,
001923r 2                       ; BAS_TMP2 hi = right len.
001923r 2  A5 17                lda     ARG+1
001925r 2  85 20                sta     INDEX
001927r 2  A5 18                lda     ARG+2
001929r 2  85 21                sta     INDEX+1
00192Br 2  A5 0F                lda     FAC+1
00192Dr 2  85 3A                sta     BAS_TMP1
00192Fr 2  A5 10                lda     FAC+2
001931r 2  85 3B                sta     BAS_TMP1+1
001933r 2  A5 16                lda     ARG
001935r 2  85 3C                sta     BAS_TMP2                ; left len
001937r 2  A5 0E                lda     FAC
001939r 2  85 3D                sta     BAS_TMP2+1              ; right len
00193Br 2                       ; Compare byte-by-byte up to min length.
00193Br 2  A0 00                ldy     #0
00193Dr 2               @cmp:
00193Dr 2                       ; Has either side ended?
00193Dr 2  C4 3C                cpy     BAS_TMP2
00193Fr 2  F0 17                beq     @leftEnd
001941r 2  C4 3D                cpy     BAS_TMP2+1
001943r 2  F0 1B                beq     @rightEnd               ; right ended first -> left > right
001945r 2  B1 20                lda     (INDEX),y
001947r 2  D1 3A                cmp     (BAS_TMP1),y
001949r 2  F0 0A                beq     @next
00194Br 2  90 04                bcc     @lt                     ; left < right
00194Dr 2                       ; left > right
00194Dr 2  A9 01                lda     #1
00194Fr 2  80 15                bra     @decide
001951r 2               @lt:
001951r 2  A9 04                lda     #4
001953r 2  80 11                bra     @decide
001955r 2               @next:
001955r 2  C8                   iny
001956r 2  80 E5                bra     @cmp
001958r 2               @leftEnd:
001958r 2                       ; Left ran out; check right
001958r 2  C4 3D                cpy     BAS_TMP2+1
00195Ar 2  F0 08                beq     @equal
00195Cr 2                       ; left < right (left is prefix)
00195Cr 2  A9 04                lda     #4
00195Er 2  80 06                bra     @decide
001960r 2               @rightEnd:
001960r 2                       ; right ran out, left has more; left > right
001960r 2  A9 01                lda     #1
001962r 2  80 02                bra     @decide
001964r 2               @equal:
001964r 2  A9 02                lda     #2
001966r 2               @decide:
001966r 2  25 45                and     CPRMASK
001968r 2  F0 05                beq     @false
00196Ar 2  A9 FF                lda     #$FF
00196Cr 2  A8                   tay
00196Dr 2  80 03                bra     @ret
00196Fr 2               @false:
00196Fr 2  A9 00                lda     #0
001971r 2  A8                   tay
001972r 2               @ret:
001972r 2                       ; Free temp strings before returning.  Save A,Y first.
001972r 2  48                   pha
001973r 2  5A                   phy
001974r 2                       ; Free FAC's temp string (right operand).
001974r 2  24 64                bit     VALTYP
001976r 2  10 03                bpl     @noFreeR
001978r 2  20 rr rr             jsr     FreFac
00197Br 2               @noFreeR:
00197Br 2                       ; Free ARG's temp string (left operand): manually restore VALTYP=$FF
00197Br 2                       ; and FAC := ARG, then FreFac.  (We don't always know if ARG is a
00197Br 2                       ; temp; FreTms inside FreTmp checks.)
00197Br 2  A5 16                lda     ARG
00197Dr 2  85 0E                sta     FAC
00197Fr 2  A5 17                lda     ARG+1
001981r 2  85 0F                sta     FAC+1
001983r 2  A5 18                lda     ARG+2
001985r 2  85 10                sta     FAC+2
001987r 2                       ; +3/+4 are the descriptor's own address, which is what FreFac frees
001987r 2                       ; by -- copying only the len/lo/hi above left FreFac looking at the
001987r 2                       ; right operand's slot, already popped, so it never matched LASTPT and
001987r 2                       ; the left temp was never reclaimed.  PushFac/PullArg carry these two
001987r 2                       ; bytes through for exactly this.  One leaked slot per comparison, and
001987r 2                       ; the third string compare in a program hit ?FORMULA TOO COMPLEX.
001987r 2  A5 19                lda     ARG+3
001989r 2  85 11                sta     FAC+3
00198Br 2  A5 1A                lda     ARG+4
00198Dr 2  85 12                sta     FAC+4
00198Fr 2  A9 FF                lda     #$FF
001991r 2  85 64                sta     VALTYP
001993r 2  20 rr rr             jsr     FreFac
001996r 2  7A                   ply
001997r 2  68                   pla
001998r 2  4C rr rr             jmp     GivAyf
00199Br 2               
00199Br 2               ; ===========================================================================
00199Br 2               ;   L E V E L 4  --  + / -
00199Br 2               ; ===========================================================================
00199Br 2               EvalAdd:
00199Br 2  20 rr rr             jsr     EvalMul
00199Er 2               @loop:
00199Er 2  20 rr rr             jsr     ChrGot
0019A1r 2  C9 2B                cmp     #'+'
0019A3r 2  F0 05                beq     @plus
0019A5r 2  C9 2D                cmp     #'-'
0019A7r 2  F0 27                beq     @minus
0019A9r 2  60                   rts
0019AAr 2               @plus:
0019AAr 2  20 rr rr             jsr     ChrGet
0019ADr 2  20 rr rr             jsr     PushFac
0019B0r 2  20 rr rr             jsr     EvalMul
0019B3r 2  20 rr rr             jsr     PullArg
0019B6r 2                       ; Type dispatch.
0019B6r 2  A5 86                lda     BAS_LVTYP
0019B8r 2  45 64                eor     VALTYP
0019BAr 2  10 03 4C rr          jmi     EvalTypeErr
0019BEr 2  rr           
0019BFr 2  24 64                bit     VALTYP
0019C1r 2  30 28                bmi     @cat
0019C3r 2                       ; numeric add: FAC = ARG + FAC
0019C3r 2                       ; FAddT expects: ARG is the operand, A=FAC's exponent on entry.
0019C3r 2                       ; Use entry "FAddT" preceded by sign work: msbasic does
0019C3r 2                       ;   bne <continue>; jmp CopyArgToFac
0019C3r 2                       ; But our FAddT entry already handles that.  We need to set
0019C3r 2                       ; SGNCPR = ARGSIGN ^ FACSIGN before FAddT.
0019C3r 2  A5 1B                lda     ARGSIGN
0019C5r 2  45 13                eor     FACSIGN
0019C7r 2  85 1C                sta     SGNCPR
0019C9r 2  A5 0E                lda     FAC
0019CBr 2  20 rr rr             jsr     FAddT
0019CEr 2  80 CE                bra     @loop
0019D0r 2               @minus:
0019D0r 2  20 rr rr             jsr     ChrGet
0019D3r 2  20 rr rr             jsr     PushFac
0019D6r 2  20 rr rr             jsr     EvalMul
0019D9r 2  20 rr rr             jsr     ChkNum
0019DCr 2                       ; left was pushed; check pushed type via TOS-byte? Easier: we already
0019DCr 2                       ; verified left is numeric on first iteration.  But left might have
0019DCr 2                       ; been a string from concatenation; require numeric here:
0019DCr 2  20 rr rr             jsr     PullArg
0019DFr 2  A5 86                lda     BAS_LVTYP
0019E1r 2  10 03 4C rr          jmi     EvalTypeErr
0019E5r 2  rr           
0019E6r 2                       ; FAC = ARG - FAC
0019E6r 2                       ; FSubT does: FACSIGN ^= $FF; SGNCPR = FACSIGN^ARGSIGN; jmp FAddT
0019E6r 2                       ; We need to call FSubT directly.
0019E6r 2  20 rr rr             jsr     FSubT
0019E9r 2  80 B3                bra     @loop
0019EBr 2               @cat:
0019EBr 2  20 rr rr             jsr     CatStr
0019EEr 2  80 AE                bra     @loop
0019F0r 2               
0019F0r 2               ; ---------------------------------------------------------------------------
0019F0r 2               ; CatStr -- concatenate ARG (left) + FAC (right), result in FAC.
0019F0r 2               ; ---------------------------------------------------------------------------
0019F0r 2               CatStr:
0019F0r 2                       ; Stash right's length+addr before we overwrite FAC.
0019F0r 2  A5 0E                lda     FAC
0019F2r 2  85 4D                sta     BAS_TEMP1               ; right len
0019F4r 2  A5 0F                lda     FAC+1
0019F6r 2  85 4E                sta     BAS_TEMP1+1
0019F8r 2  A5 10                lda     FAC+2
0019FAr 2  85 4F                sta     BAS_TEMP1+2
0019FCr 2                       ; Total length = ARG + FAC; abort if > 255.
0019FCr 2  18                   clc
0019FDr 2  A5 16                lda     ARG
0019FFr 2  65 4D                adc     BAS_TEMP1
001A01r 2  B0 40                bcs     @tooLong
001A03r 2  85 50                sta     BAS_TEMP1+3             ; total length
001A05r 2                       ; Free both source temps before allocating result -- otherwise we
001A05r 2                       ; pile up to 3 temps and the next PutNew throws ?FRMCPX.
001A05r 2  20 rr rr             jsr     FreeBothTemps
001A08r 2                       ; Allocate.
001A08r 2  A5 50                lda     BAS_TEMP1+3             ; total length
001A0Ar 2  20 rr rr             jsr     GetSpa                  ; A=total, FRESPC=buf
001A0Dr 2                       ; Copy left bytes (ARG -> FRESPC).
001A0Dr 2  A5 17                lda     ARG+1
001A0Fr 2  85 20                sta     INDEX
001A11r 2  A5 18                lda     ARG+2
001A13r 2  85 21                sta     INDEX+1
001A15r 2  A5 16                lda     ARG
001A17r 2  F0 03                beq     @right
001A19r 2  20 rr rr             jsr     MovStr1                 ; advances FRESPC by len
001A1Cr 2               @right:
001A1Cr 2                       ; Copy right bytes.
001A1Cr 2  A5 4E                lda     BAS_TEMP1+1
001A1Er 2  85 20                sta     INDEX
001A20r 2  A5 4F                lda     BAS_TEMP1+2
001A22r 2  85 21                sta     INDEX+1
001A24r 2  A5 4D                lda     BAS_TEMP1
001A26r 2  F0 03                beq     @desc
001A28r 2  20 rr rr             jsr     MovStr1
001A2Br 2               @desc:
001A2Br 2                       ; Descriptor: FAC := total len, FAC+1/2 := FRESPC - total.
001A2Br 2  A5 50                lda     BAS_TEMP1+3
001A2Dr 2  85 0E                sta     FAC
001A2Fr 2  38                   sec
001A30r 2  A5 84                lda     FRESPC
001A32r 2  E5 50                sbc     BAS_TEMP1+3
001A34r 2  85 0F                sta     FAC+1
001A36r 2  A5 85                lda     FRESPC+1
001A38r 2  E9 00                sbc     #0
001A3Ar 2  85 10                sta     FAC+2
001A3Cr 2  A9 FF                lda     #$FF
001A3Er 2  85 64                sta     VALTYP
001A40r 2  4C rr rr             jmp     PutNew
001A43r 2               @tooLong:
001A43r 2  A2 09                ldx     #ERR_STRLONG
001A45r 2  4C rr rr             jmp     BasErrorVec
001A48r 2               
001A48r 2               ; ===========================================================================
001A48r 2               ;   L E V E L 5  --  * / /
001A48r 2               ; ===========================================================================
001A48r 2               EvalMul:
001A48r 2  20 rr rr             jsr     EvalPow
001A4Br 2               @loop:
001A4Br 2  20 rr rr             jsr     ChrGot
001A4Er 2  C9 2A                cmp     #'*'
001A50r 2  F0 05                beq     @mul
001A52r 2  C9 2F                cmp     #'/'
001A54r 2  F0 27                beq     @div
001A56r 2  60                   rts
001A57r 2               @mul:
001A57r 2  20 rr rr             jsr     ChkNum
001A5Ar 2  20 rr rr             jsr     ChrGet
001A5Dr 2  20 rr rr             jsr     PushFac
001A60r 2  20 rr rr             jsr     EvalPow
001A63r 2  20 rr rr             jsr     ChkNum
001A66r 2  20 rr rr             jsr     PullArg
001A69r 2  A5 86                lda     BAS_LVTYP
001A6Br 2  10 03 4C rr          jmi     EvalTypeErr
001A6Fr 2  rr           
001A70r 2                       ; FAC = ARG * FAC: FMultT expects ARG + sign work.  See msbasic.
001A70r 2  A5 1B                lda     ARGSIGN
001A72r 2  45 13                eor     FACSIGN
001A74r 2  85 1C                sta     SGNCPR
001A76r 2  A5 0E                lda     FAC
001A78r 2  20 rr rr             jsr     FMultT
001A7Br 2  80 CE                bra     @loop
001A7Dr 2               @div:
001A7Dr 2  20 rr rr             jsr     ChkNum
001A80r 2  20 rr rr             jsr     ChrGet
001A83r 2  20 rr rr             jsr     PushFac
001A86r 2  20 rr rr             jsr     EvalPow
001A89r 2  20 rr rr             jsr     ChkNum
001A8Cr 2  20 rr rr             jsr     PullArg
001A8Fr 2  A5 86                lda     BAS_LVTYP
001A91r 2  10 03 4C rr          jmi     EvalTypeErr
001A95r 2  rr           
001A96r 2                       ; FAC = ARG / FAC: FDivT.
001A96r 2  A5 1B                lda     ARGSIGN
001A98r 2  45 13                eor     FACSIGN
001A9Ar 2  85 1C                sta     SGNCPR
001A9Cr 2  A5 0E                lda     FAC
001A9Er 2  20 rr rr             jsr     FDivT
001AA1r 2  80 A8                bra     @loop
001AA3r 2               
001AA3r 2               ; ===========================================================================
001AA3r 2               ;   L E V E L 6  --  ^   (right-associative)
001AA3r 2               ; ===========================================================================
001AA3r 2               EvalPow:
001AA3r 2  20 rr rr             jsr     EvalUnary
001AA6r 2               @loop:
001AA6r 2  20 rr rr             jsr     ChrGot
001AA9r 2  C9 5E                cmp     #'^'
001AABr 2  D0 20                bne     @done
001AADr 2  20 rr rr             jsr     ChkNum
001AB0r 2  20 rr rr             jsr     ChrGet
001AB3r 2  20 rr rr             jsr     PushFac
001AB6r 2                       ; Right-associative, which means the right-hand side is evaluated at
001AB6r 2                       ; this level rather than the one below: recursing into EvalPow lets
001AB6r 2                       ; the RHS take the rest of the chain, so 2^3^2 is 2^(3^2) = 512.
001AB6r 2                       ; Calling EvalUnary here instead made it (2^3)^2 = 64 -- left-assoc,
001AB6r 2                       ; contradicting this level's own heading.  EvalUnary still runs first
001AB6r 2                       ; inside the recursion, so a term is always consumed and the recursion
001AB6r 2                       ; is bounded by the length of the chain.
001AB6r 2  20 rr rr             jsr     EvalPow
001AB9r 2  20 rr rr             jsr     ChkNum
001ABCr 2  20 rr rr             jsr     PullArg
001ABFr 2  A5 86                lda     BAS_LVTYP
001AC1r 2  10 03 4C rr          jmi     EvalTypeErr
001AC5r 2  rr           
001AC6r 2                       ; FPwrt computes ARG ^ FAC.  Our ported FPwrt expects ARG = base,
001AC6r 2                       ; FAC = exponent, and A = FAC's exponent byte (FPwrt's first
001AC6r 2                       ; instruction is `beq Exp` to short-circuit FAC==0 -> 1).
001AC6r 2  A5 0E                lda     FAC
001AC8r 2  20 rr rr             jsr     FPwrt
001ACBr 2  80 D9                bra     @loop
001ACDr 2               @done:
001ACDr 2  60                   rts
001ACEr 2               
001ACEr 2               ; ===========================================================================
001ACEr 2               ;   L E V E L 7  --  U N A R Y
001ACEr 2               ; ===========================================================================
001ACEr 2               EvalUnary:
001ACEr 2  20 rr rr             jsr     ChrGot
001AD1r 2  C9 2D                cmp     #'-'
001AD3r 2  F0 07                beq     @neg
001AD5r 2  C9 2B                cmp     #'+'
001AD7r 2  F0 13                beq     @pos
001AD9r 2  4C rr rr             jmp     EvalAtom
001ADCr 2               @neg:
001ADCr 2  20 rr rr             jsr     ChrGet
001ADFr 2                       ; Evaluate the operand at the power level, not this one: the README
001ADFr 2                       ; puts `^` above unary `-`, so -2^2 is -(2^2) = -4.  Recursing into
001ADFr 2                       ; EvalUnary here bound the minus to the atom first and gave (-2)^2 = 4.
001ADFr 2                       ; The '-' is consumed above, so a term is always taken before this
001ADFr 2                       ; recurses and the depth is bounded by the run of signs.
001ADFr 2  20 rr rr             jsr     EvalPow
001AE2r 2  20 rr rr             jsr     ChkNum
001AE5r 2                       ; Negate FAC: flip FACSIGN bit 7.
001AE5r 2  A5 13                lda     FACSIGN
001AE7r 2  49 FF                eor     #$FF
001AE9r 2  85 13                sta     FACSIGN
001AEBr 2  60                   rts
001AECr 2               @pos:
001AECr 2  20 rr rr             jsr     ChrGet
001AEFr 2  4C rr rr             jmp     EvalUnary
001AF2r 2               
001AF2r 2               ; ===========================================================================
001AF2r 2               ;   L E V E L 8  --  A T O M
001AF2r 2               ; ===========================================================================
001AF2r 2               EvalAtom:
001AF2r 2  64 64                stz     VALTYP                  ; default to numeric; string paths override
001AF4r 2  20 rr rr             jsr     ChrGot
001AF7r 2  90 2A                bcc     @num                    ; digit
001AF9r 2  C9 2E                cmp     #'.'
001AFBr 2  F0 26                beq     @num
001AFDr 2  C9 22                cmp     #'"'
001AFFr 2  F0 25                beq     @str
001B01r 2  C9 28                cmp     #'('
001B03r 2  F0 39                beq     @paren
001B05r 2                       ; Letter? -> variable
001B05r 2  20 rr rr             jsr     IsLetC
001B08r 2  B0 3D                bcs     @var
001B0Ar 2                       ; Function token?
001B0Ar 2  C9 CD                cmp     #TOK_INKEY
001B0Cr 2  F0 60                beq     FnInkey
001B0Er 2  C9 9D                cmp     #TOK_FN
001B10r 2  F0 0E                beq     @fnCall                 ; FN A(...) — user-defined function
001B12r 2                       ; Hex literal in PRINT context: not here (no '$' literal supported).
001B12r 2                       ; NVRAM is dual-role (statement at $B1, function via FnTable);
001B12r 2                       ; allow it through even though it sits below TOK_SGN.
001B12r 2  C9 B1                cmp     #TOK_NVRAM
001B14r 2  F0 04                beq     @fnDisp
001B16r 2                       ; Try function dispatch.  Every token from SGN up goes to FnDispatch,
001B16r 2                       ; whose table holds $B6-$D0 and $E0-$E3: anything else it is handed --
001B16r 2                       ; the statements $D1-$DF in between -- is not in it, and is a SYNTAX
001B16r 2                       ; ERROR there.
001B16r 2  C9 B6                cmp     #TOK_SGN
001B18r 2  90 03                bcc     @synErr
001B1Ar 2               @fnDisp:
001B1Ar 2  4C rr rr             jmp     FnDispatch
001B1Dr 2               @synErr:
001B1Dr 2  4C rr rr             jmp     SynErr
001B20r 2               @fnCall:
001B20r 2  4C rr rr             jmp     FnCall
001B23r 2               @num:
001B23r 2                       ; ASCII numeric: jump to Fin.  Fin uses ChrGet to consume.
001B23r 2  4C rr rr             jmp     Fin
001B26r 2               @str:
001B26r 2                       ; '"' string literal.  Advance past the opening quote WITHOUT ChrGet:
001B26r 2                       ; ChrGet skips spaces, which would strip leading spaces inside the
001B26r 2                       ; string literal (e.g. PRINT "   X").  Bump TXTPTR by one byte instead.
001B26r 2  E6 04                inc     TXTPTR
001B28r 2  D0 02                bne     @strsrc
001B2Ar 2  E6 05                inc     TXTPTR+1
001B2Cr 2               @strsrc:
001B2Cr 2                       ; StrLit expects (Y,A) = src.  Source = TXTPTR.
001B2Cr 2  A5 04                lda     TXTPTR
001B2Er 2  A4 05                ldy     TXTPTR+1
001B30r 2  20 rr rr             jsr     StrLit
001B33r 2                       ; StrLit advances internal pointer; we need to update TXTPTR.
001B33r 2                       ; StrLit reads until $00 or '"' from (STRNG1)+y; FAC has length.
001B33r 2                       ; Compute new TXTPTR = STRNG2 (which StrLit set), or TXTPTR + len + maybe-quote.
001B33r 2                       ; STRNG2 = STRNG1 + len + (1 if hit quote else 0).  Use STRNG2.
001B33r 2  A5 1E                lda     STRNG2
001B35r 2  85 04                sta     TXTPTR
001B37r 2  A5 1F                lda     STRNG2+1
001B39r 2  85 05                sta     TXTPTR+1
001B3Br 2                       ; If we stopped at a closing quote, TXTPTR is past it (StrLit's
001B3Br 2                       ; @endquote path: tya/adc STRNG1 with carry set since cmp set C);
001B3Br 2                       ; if we ran into NUL, TXTPTR sits on the NUL (clc path).  Either
001B3Br 2                       ; is correct for ChrGot.
001B3Br 2  4C rr rr             jmp     ChrGot                  ; preload next char (for caller chains)
001B3Er 2               @paren:
001B3Er 2  20 rr rr             jsr     ChrGet                  ; consume '('
001B41r 2  20 rr rr             jsr     FrmEvl
001B44r 2  4C rr rr             jmp     ChkCls                  ; expects ')'; consumes via ChrGet
001B47r 2               @var:
001B47r 2                       ; Variable lookup.  PtrGet uses CHRGET internally and leaves
001B47r 2                       ; (A,Y) = VARPNT.  VALTYP is set to $00 or $FF.
001B47r 2  20 rr rr             jsr     PtrGet
001B4Ar 2                       ; Fetch value into FAC.
001B4Ar 2  24 64                bit     VALTYP
001B4Cr 2  30 07                bmi     @loadStr
001B4Er 2                       ; numeric: FAC = (VARPNT)
001B4Er 2  A5 3F                lda     VARPNT
001B50r 2  A4 40                ldy     VARPNT+1
001B52r 2  4C rr rr             jmp     LoadFacFromYa
001B55r 2               @loadStr:
001B55r 2                       ; string: copy descriptor [len][lo][hi] into FAC..FAC+2.
001B55r 2  A0 00                ldy     #0
001B57r 2  B1 3F                lda     (VARPNT),y
001B59r 2  85 0E                sta     FAC
001B5Br 2  C8                   iny
001B5Cr 2  B1 3F                lda     (VARPNT),y
001B5Er 2  85 0F                sta     FAC+1
001B60r 2  C8                   iny
001B61r 2  B1 3F                lda     (VARPNT),y
001B63r 2  85 10                sta     FAC+2
001B65r 2                       ; Record the descriptor's address (= VARPNT) in FAC+3/FAC+4 so the
001B65r 2                       ; temp-free logic (FreFac/FreTms) can tell this is a variable, not a
001B65r 2                       ; temp: VARPNT's high byte is nonzero (vars live at $08xx) so it can
001B65r 2                       ; never match a temp-stack slot (all in zero page) and will not be
001B65r 2                       ; freed or reclaimed.  Without this, a stale FAC+3/FAC+4 can spuriously
001B65r 2                       ; match LASTPT and free/reclaim a live string.
001B65r 2  A5 3F                lda     VARPNT
001B67r 2  85 11                sta     FAC+3
001B69r 2  A5 40                lda     VARPNT+1
001B6Br 2  85 12                sta     FAC+4
001B6Dr 2  60                   rts
001B6Er 2               
001B6Er 2               ; ---------------------------------------------------------------------------
001B6Er 2               ; FnInkey -- INKEY (no parens).  Reads BAS_PENDKEY first; else BufferSize/
001B6Er 2               ; ReadBuffer; else 0.  Result is unsigned 8-bit FP value.
001B6Er 2               ; ---------------------------------------------------------------------------
001B6Er 2               FnInkey:
001B6Er 2  20 rr rr             jsr     ChrGet                  ; consume INKEY token
001B71r 2  AD 0E 03             lda     BAS_PENDKEY
001B74r 2  F0 09                beq     @noPend
001B76r 2                       ; consume pending key.
001B76r 2  A0 00                ldy     #0
001B78r 2  8C 0E 03             sty     BAS_PENDKEY
001B7Br 2  A8                   tay
001B7Cr 2  4C rr rr             jmp     SngFlt
001B7Fr 2               @noPend:
001B7Fr 2  20 rr rr             jsr     BufferSize
001B82r 2  F0 07                beq     @zero
001B84r 2  20 rr rr             jsr     ReadBuffer
001B87r 2  A8                   tay
001B88r 2  4C rr rr             jmp     SngFlt
001B8Br 2               @zero:
001B8Br 2  A0 00                ldy     #0
001B8Dr 2  4C rr rr             jmp     SngFlt
001B90r 2               
001B90r 2               ; ---------------------------------------------------------------------------
001B90r 2               ; FnDispatch -- A holds a token from TOK_SGN up.  Dispatch via FnTable, which
001B90r 2               ; pairs (token, handler-1); a token the table does not hold is a SYNTAX ERROR.
001B90r 2               ; ---------------------------------------------------------------------------
001B90r 2               FnDispatch:
001B90r 2  A2 00                ldx     #0
001B92r 2               @find:
001B92r 2  BD rr rr             lda     FnTable,x
001B95r 2  F0 14                beq     @synErr                 ; reached terminator
001B97r 2  D2 04                cmp     (TXTPTR)
001B99r 2  F0 05                beq     @match
001B9Br 2  E8                   inx
001B9Cr 2  E8                   inx
001B9Dr 2  E8                   inx
001B9Er 2  80 F2                bra     @find
001BA0r 2               @match:
001BA0r 2                       ; Push handler-1 onto stack so RTS jumps to it after ChrGet.
001BA0r 2  BD rr rr             lda     FnTable+2,x
001BA3r 2  48                   pha
001BA4r 2  BD rr rr             lda     FnTable+1,x
001BA7r 2  48                   pha
001BA8r 2  4C rr rr             jmp     ChrGet                  ; consume token, return into handler
001BABr 2               @synErr:
001BABr 2  4C rr rr             jmp     SynErr
001BAEr 2               
001BAEr 2               ; ---------------------------------------------------------------------------
001BAEr 2               ; FnTable -- (token, handler-1) triples, $00-terminated.
001BAEr 2               ; "handler-1" because we push it through RTS which adds 1.
001BAEr 2               ; ---------------------------------------------------------------------------
001BAEr 2               FnTable:
001BAEr 2  B6                   .byte   TOK_SGN
001BAFr 2  rr rr                .word   FnSgn-1
001BB1r 2  B7                   .byte   TOK_INT
001BB2r 2  rr rr                .word   FnInt-1
001BB4r 2  B8                   .byte   TOK_ABS
001BB5r 2  rr rr                .word   FnAbs-1
001BB7r 2  B9                   .byte   TOK_FRE
001BB8r 2  rr rr                .word   FnFre-1
001BBAr 2  BA                   .byte   TOK_POS
001BBBr 2  rr rr                .word   FnPos-1
001BBDr 2  BB                   .byte   TOK_SQR
001BBEr 2  rr rr                .word   FnSqr-1
001BC0r 2  BC                   .byte   TOK_RND
001BC1r 2  rr rr                .word   FnRnd-1
001BC3r 2  BD                   .byte   TOK_LOG
001BC4r 2  rr rr                .word   FnLog-1
001BC6r 2  BE                   .byte   TOK_EXP
001BC7r 2  rr rr                .word   FnExp-1
001BC9r 2  BF                   .byte   TOK_COS
001BCAr 2  rr rr                .word   FnCos-1
001BCCr 2  C0                   .byte   TOK_SIN
001BCDr 2  rr rr                .word   FnSin-1
001BCFr 2  C1                   .byte   TOK_TAN
001BD0r 2  rr rr                .word   FnTan-1
001BD2r 2  C2                   .byte   TOK_ATN
001BD3r 2  rr rr                .word   FnAtn-1
001BD5r 2  C3                   .byte   TOK_PEEK
001BD6r 2  rr rr                .word   FnPeek-1
001BD8r 2  C4                   .byte   TOK_LEN
001BD9r 2  rr rr                .word   FnLen-1
001BDBr 2  C5                   .byte   TOK_STRSTR
001BDCr 2  rr rr                .word   FnStrStr-1
001BDEr 2  C6                   .byte   TOK_VAL
001BDFr 2  rr rr                .word   FnVal-1
001BE1r 2  C7                   .byte   TOK_ASC
001BE2r 2  rr rr                .word   FnAsc-1
001BE4r 2  C8                   .byte   TOK_CHRSTR
001BE5r 2  rr rr                .word   FnChrStr-1
001BE7r 2  C9                   .byte   TOK_LEFTSTR
001BE8r 2  rr rr                .word   FnLeftStr-1
001BEAr 2  CA                   .byte   TOK_RIGHTSTR
001BEBr 2  rr rr                .word   FnRightStr-1
001BEDr 2  CB                   .byte   TOK_MIDSTR
001BEEr 2  rr rr                .word   FnMidStr-1
001BF0r 2  CC                   .byte   TOK_JOY
001BF1r 2  rr rr                .word   FnJoy-1
001BF3r 2  B1                   .byte   TOK_NVRAM
001BF4r 2  rr rr                .word   FnNvram-1
001BF6r 2  CE                   .byte   TOK_HEX
001BF7r 2  rr rr                .word   FnHex-1
001BF9r 2  CF                   .byte   TOK_MIN
001BFAr 2  rr rr                .word   FnMin-1
001BFCr 2  D0                   .byte   TOK_MAX
001BFDr 2  rr rr                .word   FnMax-1
001BFFr 2  00                   .byte   0
001C00r 2               
001C00r 2               ; ---------------------------------------------------------------------------
001C00r 2               ; Numeric-arg helpers.
001C00r 2               ; ParenNum    -- expects "(" expr ")" with numeric result.  FAC = result.
001C00r 2               ; ParenStr    -- expects "(" expr ")" with string result.
001C00r 2               ; ParenU8     -- expects "(" expr ")" -> A = byte (0..255), or ?ILLQTY.
001C00r 2               ; ParenU16    -- expects "(" expr ")" -> AyInt result in FAC+3,+4.
001C00r 2               ; ---------------------------------------------------------------------------
001C00r 2               ParenNum:
001C00r 2  20 rr rr             jsr     ChkOpn
001C03r 2  20 rr rr             jsr     FrmEvl
001C06r 2  20 rr rr             jsr     ChkNum
001C09r 2  4C rr rr             jmp     ChkCls
001C0Cr 2               ParenStr:
001C0Cr 2  20 rr rr             jsr     ChkOpn
001C0Fr 2  20 rr rr             jsr     FrmEvl
001C12r 2  20 rr rr             jsr     ChkStr
001C15r 2  4C rr rr             jmp     ChkCls
001C18r 2               ParenU8:
001C18r 2  20 rr rr             jsr     ParenNum
001C1Br 2  20 rr rr             jsr     AyInt
001C1Er 2  A5 11                lda     FAC+3                   ; high byte must be 0
001C20r 2  D0 03                bne     @bad
001C22r 2  A5 12                lda     FAC+4                   ; low byte = result
001C24r 2  60                   rts
001C25r 2               @bad:
001C25r 2  4C rr rr             jmp     IqErr
001C28r 2               
001C28r 2               ; ---------------------------------------------------------------------------
001C28r 2               ; Unary numeric functions (single-arg "(" num ")") -- shared body.
001C28r 2               ; Each entry sets up A = handler entry to call after ChkOpn/FrmEvl/ChkNum/ChkCls.
001C28r 2               ; ---------------------------------------------------------------------------
001C28r 2               FnSgn:
001C28r 2  20 rr rr             jsr     ParenNum
001C2Br 2  4C rr rr             jmp     Sgn
001C2Er 2               FnInt:
001C2Er 2  20 rr rr             jsr     ParenNum
001C31r 2  4C rr rr             jmp     Int
001C34r 2               FnAbs:
001C34r 2  20 rr rr             jsr     ParenNum
001C37r 2  4C rr rr             jmp     Abs
001C3Ar 2               FnSqr:
001C3Ar 2  20 rr rr             jsr     ParenNum
001C3Dr 2  4C rr rr             jmp     Sqr
001C40r 2               FnLog:
001C40r 2  20 rr rr             jsr     ParenNum
001C43r 2  4C rr rr             jmp     Log
001C46r 2               FnExp:
001C46r 2  20 rr rr             jsr     ParenNum
001C49r 2  4C rr rr             jmp     Exp
001C4Cr 2               FnCos:
001C4Cr 2  20 rr rr             jsr     ParenNum
001C4Fr 2  4C rr rr             jmp     Cos
001C52r 2               FnSin:
001C52r 2  20 rr rr             jsr     ParenNum
001C55r 2  4C rr rr             jmp     Sin
001C58r 2               FnTan:
001C58r 2  20 rr rr             jsr     ParenNum
001C5Br 2  4C rr rr             jmp     Tan
001C5Er 2               FnAtn:
001C5Er 2  20 rr rr             jsr     ParenNum
001C61r 2  4C rr rr             jmp     Atn
001C64r 2               FnRnd:
001C64r 2  20 rr rr             jsr     ParenNum
001C67r 2  4C rr rr             jmp     Rnd
001C6Ar 2               FnHex:
001C6Ar 2                       ; In expression context: identity.
001C6Ar 2  4C rr rr             jmp     ParenNum
001C6Dr 2               
001C6Dr 2               ; ---------------------------------------------------------------------------
001C6Dr 2               ; FnFre -- FRE(n): returns FRETOP - STREND (free string heap).
001C6Dr 2               ; Argument is parsed and ignored.
001C6Dr 2               ; ---------------------------------------------------------------------------
001C6Dr 2               FnFre:
001C6Dr 2  20 rr rr             jsr     ParenNum
001C70r 2  38                   sec
001C71r 2  AD 65 03             lda     FRETOP
001C74r 2  ED 63 03             sbc     STREND
001C77r 2  A8                   tay
001C78r 2  AD 66 03             lda     FRETOP+1
001C7Br 2  ED 64 03             sbc     STREND+1
001C7Er 2  4C rr rr             jmp     GivAyf
001C81r 2               
001C81r 2               ; ---------------------------------------------------------------------------
001C81r 2               ; FnPos -- POS(n): current print column.  Argument is parsed and ignored.
001C81r 2               ; ---------------------------------------------------------------------------
001C81r 2               FnPos:
001C81r 2  20 rr rr             jsr     ParenNum
001C84r 2                       ; BAS_POSX is the live column PrintCh maintains and TAB and the comma
001C84r 2                       ; zones already read.  This returned a hardcoded 0 -- the column was
001C84r 2                       ; being tracked all along, POS just never looked at it.
001C84r 2  AC 70 03             ldy     BAS_POSX
001C87r 2  4C rr rr             jmp     SngFlt
001C8Ar 2               
001C8Ar 2               ; ---------------------------------------------------------------------------
001C8Ar 2               ; FnPeek -- PEEK(addr): byte at addr -> FP.
001C8Ar 2               ; ---------------------------------------------------------------------------
001C8Ar 2               FnPeek:
001C8Ar 2  20 rr rr             jsr     ParenNum
001C8Dr 2  20 rr rr             jsr     FacToU16
001C90r 2  A5 12                lda     FAC+4                   ; lo byte
001C92r 2  85 20                sta     INDEX
001C94r 2  A5 11                lda     FAC+3                   ; hi byte
001C96r 2  85 21                sta     INDEX+1
001C98r 2  A0 00                ldy     #0
001C9Ar 2  B1 20                lda     (INDEX),y
001C9Cr 2  A8                   tay
001C9Dr 2  4C rr rr             jmp     SngFlt
001CA0r 2               
001CA0r 2               ; ---------------------------------------------------------------------------
001CA0r 2               ; FnJoy -- JOY(n): 1 or 2.  If GPIO absent, returns 0.
001CA0r 2               ; ---------------------------------------------------------------------------
001CA0r 2               FnJoy:
001CA0r 2  20 rr rr             jsr     ParenU8
001CA3r 2  48                   pha
001CA4r 2  AD 0D 03             lda     HW_PRESENT
001CA7r 2  29 20                and     #HW_GPIO
001CA9r 2  F0 1C                beq     @absent
001CABr 2  68                   pla
001CACr 2  C9 01                cmp     #1
001CAEr 2  F0 09                beq     @j1
001CB0r 2  C9 02                cmp     #2
001CB2r 2  F0 0C                beq     @j2
001CB4r 2  A2 0B                ldx     #ERR_ILLQUAN
001CB6r 2  4C rr rr             jmp     BasErrorVec
001CB9r 2               @j1:
001CB9r 2  20 rr rr             jsr     ReadJoystick1
001CBCr 2  A8                   tay
001CBDr 2  4C rr rr             jmp     SngFlt
001CC0r 2               @j2:
001CC0r 2  20 rr rr             jsr     ReadJoystick2
001CC3r 2  A8                   tay
001CC4r 2  4C rr rr             jmp     SngFlt
001CC7r 2               @absent:
001CC7r 2  68                   pla
001CC8r 2                       ; $FF, not 0.  The ports are active low -- pulled high through 1K, and
001CC8r 2                       ; the stick's switches ground them -- so JOY returns the port raw and 0
001CC8r 2                       ; means every direction and button is held at once.  Reporting 0 for a
001CC8r 2                       ; machine with no VIA fitted told the caller exactly that; $FF is what
001CC8r 2                       ; an untouched stick reads, and so the honest answer for one that is
001CC8r 2                       ; not there at all.
001CC8r 2  A0 FF                ldy     #$FF
001CCAr 2  4C rr rr             jmp     SngFlt
001CCDr 2               
001CCDr 2               ; ---------------------------------------------------------------------------
001CCDr 2               ; FnNvram -- NVRAM(addr): if RTC absent, return 0.
001CCDr 2               ; ---------------------------------------------------------------------------
001CCDr 2               FnNvram:
001CCDr 2  20 rr rr             jsr     ParenU8
001CD0r 2  48                   pha
001CD1r 2  AD 0D 03             lda     HW_PRESENT
001CD4r 2  29 04                and     #HW_RTC
001CD6r 2  F0 09                beq     @absent
001CD8r 2  68                   pla
001CD9r 2  AA                   tax
001CDAr 2  20 rr rr             jsr     RtcReadNVRAM
001CDDr 2  A8                   tay
001CDEr 2  4C rr rr             jmp     SngFlt
001CE1r 2               @absent:
001CE1r 2  68                   pla
001CE2r 2  A0 00                ldy     #0
001CE4r 2  4C rr rr             jmp     SngFlt
001CE7r 2               
001CE7r 2               ; ---------------------------------------------------------------------------
001CE7r 2               ; FnMin / FnMax -- two numeric args, smaller / larger.
001CE7r 2               ; ---------------------------------------------------------------------------
001CE7r 2               FnMin:
001CE7r 2  20 rr rr             jsr     MinMaxArgs              ; ARG = a, FAC = b, BAS_TMP3 = sign(b-a)
001CEAr 2                       ; Want smaller: if b>=a return a (ARG); else return b (FAC).
001CEAr 2  10 01                bpl     @retArg                 ; sign>=0 means b>=a
001CECr 2  60                   rts                             ; FAC already = b
001CEDr 2               @retArg:
001CEDr 2  4C rr rr             jmp     CopyArgToFac
001CF0r 2               FnMax:
001CF0r 2  20 rr rr             jsr     MinMaxArgs
001CF3r 2                       ; Want larger: if b>=a return b (FAC); else return a (ARG).
001CF3r 2  10 03                bpl     @retFac
001CF5r 2  4C rr rr             jmp     CopyArgToFac
001CF8r 2               @retFac:
001CF8r 2  60                   rts
001CF9r 2               
001CF9r 2               ; MinMaxArgs -- consume "(" a "," b ")" with numerics; ARG=a, FAC=b.
001CF9r 2               ; Returns A = sign(b - a) (FF/00/01) and N flag set accordingly.
001CF9r 2               MinMaxArgs:
001CF9r 2  20 rr rr             jsr     ChkOpn
001CFCr 2  20 rr rr             jsr     FrmEvl
001CFFr 2  20 rr rr             jsr     ChkNum
001D02r 2  20 rr rr             jsr     PushFac                 ; save a
001D05r 2  20 rr rr             jsr     ChkCom
001D08r 2  20 rr rr             jsr     FrmEvl
001D0Br 2  20 rr rr             jsr     ChkNum
001D0Er 2  20 rr rr             jsr     ChkCls
001D11r 2  20 rr rr             jsr     PullArg                 ; ARG = a, FAC = b
001D14r 2                       ; Stash ARG so we can restore after FComp's destructive sign-pack.
001D14r 2  A5 16                lda     ARG
001D16r 2  85 4D                sta     BAS_TEMP1
001D18r 2  A5 17                lda     ARG+1
001D1Ar 2  85 4E                sta     BAS_TEMP1+1
001D1Cr 2  A5 18                lda     ARG+2
001D1Er 2  85 4F                sta     BAS_TEMP1+2
001D20r 2  A5 19                lda     ARG+3
001D22r 2  85 50                sta     BAS_TEMP1+3
001D24r 2  A5 1A                lda     ARG+4
001D26r 2  85 51                sta     BAS_TEMP1+4
001D28r 2  A5 1B                lda     ARGSIGN
001D2Ar 2  85 52                sta     BAS_TEMP1+5
001D2Cr 2                       ; Pack ARGSIGN into bit 7 of ARG+1 so FComp reads it correctly.
001D2Cr 2  A5 1B                lda     ARGSIGN
001D2Er 2  09 7F                ora     #$7F
001D30r 2  25 17                and     ARG+1
001D32r 2  85 17                sta     ARG+1
001D34r 2  A9 16                lda     #<ARG
001D36r 2  A0 00                ldy     #$00
001D38r 2  20 rr rr             jsr     FComp                   ; A = sign(FAC - ARG)
001D3Br 2  48                   pha
001D3Cr 2                       ; Restore ARG.
001D3Cr 2  A5 4D                lda     BAS_TEMP1
001D3Er 2  85 16                sta     ARG
001D40r 2  A5 4E                lda     BAS_TEMP1+1
001D42r 2  85 17                sta     ARG+1
001D44r 2  A5 4F                lda     BAS_TEMP1+2
001D46r 2  85 18                sta     ARG+2
001D48r 2  A5 50                lda     BAS_TEMP1+3
001D4Ar 2  85 19                sta     ARG+3
001D4Cr 2  A5 51                lda     BAS_TEMP1+4
001D4Er 2  85 1A                sta     ARG+4
001D50r 2  A5 52                lda     BAS_TEMP1+5
001D52r 2  85 1B                sta     ARGSIGN
001D54r 2  68                   pla                             ; restore A, sets N/Z flags
001D55r 2  60                   rts
001D56r 2               
001D56r 2               ; ---------------------------------------------------------------------------
001D56r 2               ; FnLen -- LEN(s$): length of string.
001D56r 2               ; ---------------------------------------------------------------------------
001D56r 2               FnLen:
001D56r 2  20 rr rr             jsr     ParenStr
001D59r 2  A5 0E                lda     FAC                     ; length
001D5Br 2  48                   pha                             ; FreFac returns with Y = descriptor hi
001D5Cr 2  20 rr rr             jsr     FreFac                  ; release temp string if any
001D5Fr 2  68                   pla
001D60r 2  A8                   tay
001D61r 2  4C rr rr             jmp     SngFlt
001D64r 2               
001D64r 2               ; ---------------------------------------------------------------------------
001D64r 2               ; FnAsc -- ASC(s$): code of first char; ?ILLQTY if empty.
001D64r 2               ; ---------------------------------------------------------------------------
001D64r 2               FnAsc:
001D64r 2  20 rr rr             jsr     ParenStr
001D67r 2  A5 0E                lda     FAC
001D69r 2  F0 15                beq     @bad
001D6Br 2                       ; Read first byte of string.
001D6Br 2  A5 0F                lda     FAC+1
001D6Dr 2  85 20                sta     INDEX
001D6Fr 2  A5 10                lda     FAC+2
001D71r 2  85 21                sta     INDEX+1
001D73r 2  A0 00                ldy     #0
001D75r 2  B1 20                lda     (INDEX),y
001D77r 2  48                   pha
001D78r 2  20 rr rr             jsr     FreFac
001D7Br 2  68                   pla
001D7Cr 2  A8                   tay
001D7Dr 2  4C rr rr             jmp     SngFlt
001D80r 2               @bad:
001D80r 2  4C rr rr             jmp     IqErr
001D83r 2               
001D83r 2               ; ---------------------------------------------------------------------------
001D83r 2               ; FnChrStr -- CHR$(n): 1-char string.
001D83r 2               ; ---------------------------------------------------------------------------
001D83r 2               FnChrStr:
001D83r 2  20 rr rr             jsr     ParenU8
001D86r 2  48                   pha
001D87r 2  A9 01                lda     #1
001D89r 2  20 rr rr             jsr     GetSpa                  ; (Y,X) = addr; A unchanged
001D8Cr 2  68                   pla
001D8Dr 2  A0 00                ldy     #0
001D8Fr 2  91 84                sta     (FRESPC),y
001D91r 2                       ; Build descriptor in FAC.
001D91r 2  A9 01                lda     #1
001D93r 2  85 0E                sta     FAC
001D95r 2  A5 84                lda     FRESPC
001D97r 2  85 0F                sta     FAC+1
001D99r 2  A5 85                lda     FRESPC+1
001D9Br 2  85 10                sta     FAC+2
001D9Dr 2                       ; Advance FRESPC past the byte we just wrote.
001D9Dr 2  E6 84                inc     FRESPC
001D9Fr 2  D0 02                bne     @nb
001DA1r 2  E6 85                inc     FRESPC+1
001DA3r 2               @nb:
001DA3r 2  4C rr rr             jmp     PutNew
001DA6r 2               
001DA6r 2               ; ---------------------------------------------------------------------------
001DA6r 2               ; FnStrStr -- STR$(n): convert numeric to string.
001DA6r 2               ; ---------------------------------------------------------------------------
001DA6r 2               FnStrStr:
001DA6r 2  20 rr rr             jsr     ParenNum
001DA9r 2  20 rr rr             jsr     Fout                    ; A=lo, Y=hi -> NUL-terminated buffer
001DACr 2                       ; (A,Y) = pointer to NUL-terminated ASCII number string in STACK2.
001DACr 2  20 rr rr             jsr     StrLit                  ; allocates + copies + PutNew
001DAFr 2  60                   rts
001DB0r 2               
001DB0r 2               ; ---------------------------------------------------------------------------
001DB0r 2               ; FnVal -- VAL(s$): parse leading numeric from string.
001DB0r 2               ; Temporarily NUL-terminates the string in place, redirects TXTPTR, calls
001DB0r 2               ; Fin, then restores.
001DB0r 2               ; ---------------------------------------------------------------------------
001DB0r 2               FnVal:
001DB0r 2  20 rr rr             jsr     ParenStr
001DB3r 2  A5 0E                lda     FAC
001DB5r 2  D0 08                bne     @nz
001DB7r 2                       ; empty string -> 0
001DB7r 2  20 rr rr             jsr     FreFac
001DBAr 2  64 64                stz     VALTYP                  ; result is numeric (ParenStr set $FF)
001DBCr 2  4C rr rr             jmp     ZeroFac
001DBFr 2               @nz:
001DBFr 2                       ; Stash length, address into TEMP1..TEMP1+2.
001DBFr 2  85 4D                sta     TEMP1                   ; length
001DC1r 2  A5 0F                lda     FAC+1
001DC3r 2  85 4E                sta     TEMP1+1
001DC5r 2  A5 10                lda     FAC+2
001DC7r 2  85 4F                sta     TEMP1+2
001DC9r 2                       ; Reclaim the argument's temp now, while FAC still holds its
001DC9r 2                       ; descriptor -- msbasic's VAL frees before parsing for the same
001DC9r 2                       ; reason.  It cannot wait until after Fin: FAC+3/+4 are the two bytes
001DC9r 2                       ; FreFac frees by, and by then they are mantissa of the parsed number.
001DC9r 2                       ; Freeing only releases the heap for reuse and nothing allocates
001DC9r 2                       ; between here and Fin, so the characters stay intact to parse.
001DC9r 2                       ; Without it the temp leaked: the empty-string path above frees, the
001DC9r 2                       ; parsing path did not, and three VALs of a literal in one program
001DC9r 2                       ; exhausted the 3-slot temp stack with ?FORMULA TOO COMPLEX.
001DC9r 2  20 rr rr             jsr     FreFac
001DCCr 2                       ; Save the byte at offset = length and replace with $00.
001DCCr 2  A5 4E                lda     TEMP1+1
001DCEr 2  85 20                sta     INDEX
001DD0r 2  A5 4F                lda     TEMP1+2
001DD2r 2  85 21                sta     INDEX+1
001DD4r 2  A4 4D                ldy     TEMP1
001DD6r 2  B1 20                lda     (INDEX),y
001DD8r 2  85 50                sta     TEMP1+3                 ; saved byte
001DDAr 2  A9 00                lda     #0
001DDCr 2  91 20                sta     (INDEX),y
001DDEr 2                       ; Save TXTPTR.
001DDEr 2  A5 04                lda     TXTPTR
001DE0r 2  48                   pha
001DE1r 2  A5 05                lda     TXTPTR+1
001DE3r 2  48                   pha
001DE4r 2                       ; TXTPTR := INDEX - 1, then ChrGet to load first char.
001DE4r 2  A5 4E                lda     TEMP1+1
001DE6r 2  85 04                sta     TXTPTR
001DE8r 2  A5 4F                lda     TEMP1+2
001DEAr 2  85 05                sta     TXTPTR+1
001DECr 2  A5 04                lda     TXTPTR
001DEEr 2  D0 02                bne     @nb
001DF0r 2  C6 05                dec     TXTPTR+1
001DF2r 2               @nb:
001DF2r 2  C6 04                dec     TXTPTR
001DF4r 2  20 rr rr             jsr     ChrGet                  ; first char
001DF7r 2  20 rr rr             jsr     Fin                     ; FAC := value
001DFAr 2                       ; Restore the saved byte.
001DFAr 2  A5 4E                lda     TEMP1+1
001DFCr 2  85 20                sta     INDEX
001DFEr 2  A5 4F                lda     TEMP1+2
001E00r 2  85 21                sta     INDEX+1
001E02r 2  A4 4D                ldy     TEMP1
001E04r 2  A5 50                lda     TEMP1+3
001E06r 2  91 20                sta     (INDEX),y
001E08r 2                       ; Restore TXTPTR.
001E08r 2  68                   pla
001E09r 2  85 05                sta     TXTPTR+1
001E0Br 2  68                   pla
001E0Cr 2  85 04                sta     TXTPTR
001E0Er 2  64 64                stz     VALTYP                  ; Fin left VALTYP = $FF from ParenStr
001E10r 2  60                   rts
001E11r 2               
001E11r 2               ; ---------------------------------------------------------------------------
001E11r 2               ; FnLeftStr -- LEFT$(s$, n): leftmost n chars.
001E11r 2               ; ---------------------------------------------------------------------------
001E11r 2               FnLeftStr:
001E11r 2  20 rr rr             jsr     ChkOpn
001E14r 2  20 rr rr             jsr     FrmEvl
001E17r 2  20 rr rr             jsr     ChkStr
001E1Ar 2  20 rr rr             jsr     ChkCom
001E1Dr 2  20 rr rr             jsr     PushFac                 ; save string descriptor
001E20r 2  20 rr rr             jsr     FrmEvl
001E23r 2  20 rr rr             jsr     ChkNum
001E26r 2  20 rr rr             jsr     ChkCls
001E29r 2  20 rr rr             jsr     AyInt
001E2Cr 2  20 rr rr             jsr     PullArg                 ; ARG = string descriptor (BAS_TMP1 clobbered)
001E2Fr 2                       ; FAC still holds the integer n; check range and copy now.
001E2Fr 2  A5 11                lda     FAC+3
001E31r 2  D0 16                bne     @bad
001E33r 2  A5 12                lda     FAC+4
001E35r 2  85 3B                sta     BAS_TMP1+1              ; n
001E37r 2                       ; Clamp n to ARG (length).
001E37r 2  A5 3B                lda     BAS_TMP1+1
001E39r 2  C5 16                cmp     ARG
001E3Br 2  90 02                bcc     @ok
001E3Dr 2  A5 16                lda     ARG
001E3Fr 2               @ok:
001E3Fr 2  85 3B                sta     BAS_TMP1+1
001E41r 2                       ; Free the source temp BEFORE allocating result so the slot frees up.
001E41r 2  20 rr rr             jsr     FreeArgString
001E44r 2                       ; Offset = 0 for LEFT$.
001E44r 2  64 3A                stz     BAS_TMP1
001E46r 2                       ; Allocate, copy first n bytes.
001E46r 2  4C rr rr             jmp     SubstrCommon            ; tail-call (rts to caller)
001E49r 2               @bad:
001E49r 2  4C rr rr             jmp     IqErr
001E4Cr 2               
001E4Cr 2               ; ---------------------------------------------------------------------------
001E4Cr 2               ; FnRightStr -- RIGHT$(s$, n): rightmost n chars.
001E4Cr 2               ; ---------------------------------------------------------------------------
001E4Cr 2               FnRightStr:
001E4Cr 2  20 rr rr             jsr     ChkOpn
001E4Fr 2  20 rr rr             jsr     FrmEvl
001E52r 2  20 rr rr             jsr     ChkStr
001E55r 2  20 rr rr             jsr     ChkCom
001E58r 2  20 rr rr             jsr     PushFac
001E5Br 2  20 rr rr             jsr     FrmEvl
001E5Er 2  20 rr rr             jsr     ChkNum
001E61r 2  20 rr rr             jsr     ChkCls
001E64r 2  20 rr rr             jsr     AyInt
001E67r 2  20 rr rr             jsr     PullArg                 ; ARG = string descriptor (BAS_TMP1 clobbered)
001E6Ar 2  A5 11                lda     FAC+3
001E6Cr 2  D0 1B                bne     @bad
001E6Er 2  A5 12                lda     FAC+4
001E70r 2  85 3B                sta     BAS_TMP1+1              ; n
001E72r 2                       ; Clamp n.
001E72r 2  A5 3B                lda     BAS_TMP1+1
001E74r 2  C5 16                cmp     ARG
001E76r 2  90 02                bcc     @ok
001E78r 2  A5 16                lda     ARG
001E7Ar 2               @ok:
001E7Ar 2  85 3B                sta     BAS_TMP1+1
001E7Cr 2                       ; offset = ARG - n.
001E7Cr 2  A5 16                lda     ARG
001E7Er 2  38                   sec
001E7Fr 2  E5 3B                sbc     BAS_TMP1+1
001E81r 2  85 3A                sta     BAS_TMP1                ; start offset
001E83r 2  20 rr rr             jsr     FreeArgString
001E86r 2  4C rr rr             jmp     SubstrCommon
001E89r 2               @bad:
001E89r 2  4C rr rr             jmp     IqErr
001E8Cr 2               
001E8Cr 2               ; ---------------------------------------------------------------------------
001E8Cr 2               ; FnMidStr -- MID$(s$, m [, n]): substring starting at m (1-based).
001E8Cr 2               ; ---------------------------------------------------------------------------
001E8Cr 2               FnMidStr:
001E8Cr 2  20 rr rr             jsr     ChkOpn
001E8Fr 2  20 rr rr             jsr     FrmEvl
001E92r 2  20 rr rr             jsr     ChkStr
001E95r 2  20 rr rr             jsr     ChkCom
001E98r 2  20 rr rr             jsr     PushFac
001E9Br 2                       ; Read m.
001E9Br 2  20 rr rr             jsr     FrmEvl
001E9Er 2  20 rr rr             jsr     ChkNum
001EA1r 2  20 rr rr             jsr     AyInt
001EA4r 2  A5 11                lda     FAC+3
001EA6r 2  D0 4B                bne     @bad
001EA8r 2  A5 12                lda     FAC+4
001EAAr 2  F0 47                beq     @bad                    ; m must be >= 1
001EACr 2  38                   sec
001EADr 2  E9 01                sbc     #1
001EAFr 2  48                   pha                             ; offset = m-1; FrmEvl below would
001EB0r 2                                                       ; clobber BAS_TMP1, so park it here
001EB0r 2                       ; Optional ", n".
001EB0r 2  20 rr rr             jsr     ChrGot
001EB3r 2  C9 2C                cmp     #','
001EB5r 2  F0 04                beq     @hasN
001EB7r 2                       ; No n: take rest -> n = 255 (will clamp).
001EB7r 2  A9 FF                lda     #255
001EB9r 2  80 12                bra     @gotN
001EBBr 2               @hasN:
001EBBr 2  20 rr rr             jsr     ChrGet
001EBEr 2  20 rr rr             jsr     FrmEvl
001EC1r 2  20 rr rr             jsr     ChkNum
001EC4r 2  20 rr rr             jsr     AyInt
001EC7r 2  A5 11                lda     FAC+3
001EC9r 2  D0 28                bne     @bad
001ECBr 2  A5 12                lda     FAC+4
001ECDr 2               @gotN:
001ECDr 2  85 3B                sta     BAS_TMP1+1
001ECFr 2  68                   pla
001ED0r 2  85 3A                sta     BAS_TMP1
001ED2r 2  20 rr rr             jsr     ChkCls
001ED5r 2  20 rr rr             jsr     PullArg                 ; ARG = string
001ED8r 2                       ; Clamp offset to length.
001ED8r 2  A5 3A                lda     BAS_TMP1
001EDAr 2  C5 16                cmp     ARG
001EDCr 2  90 04                bcc     @offOk
001EDEr 2  A5 16                lda     ARG                     ; offset = length -> empty result
001EE0r 2  85 3A                sta     BAS_TMP1
001EE2r 2               @offOk:
001EE2r 2                       ; Clamp n to (length - offset).
001EE2r 2  38                   sec
001EE3r 2  A5 16                lda     ARG
001EE5r 2  E5 3A                sbc     BAS_TMP1
001EE7r 2  C5 3B                cmp     BAS_TMP1+1
001EE9r 2  B0 02                bcs     @nOk
001EEBr 2  85 3B                sta     BAS_TMP1+1
001EEDr 2               @nOk:
001EEDr 2  20 rr rr             jsr     FreeArgString
001EF0r 2  4C rr rr             jmp     SubstrCommon
001EF3r 2               @bad:
001EF3r 2  4C rr rr             jmp     IqErr
001EF6r 2               
001EF6r 2               ; ---------------------------------------------------------------------------
001EF6r 2               ; SubstrCommon -- copy BAS_TMP1+1 bytes from ARG-string at offset BAS_TMP1
001EF6r 2               ; into a new heap allocation; result descriptor in FAC; PutNew.
001EF6r 2               ; ---------------------------------------------------------------------------
001EF6r 2               SubstrCommon:
001EF6r 2                       ; Allocate.
001EF6r 2  A5 3B                lda     BAS_TMP1+1
001EF8r 2  20 rr rr             jsr     GetSpa                  ; FRESPC = new buffer
001EFBr 2                       ; Source pointer = ARG+1 (lo/hi) + BAS_TMP1.
001EFBr 2  18                   clc
001EFCr 2  A5 17                lda     ARG+1
001EFEr 2  65 3A                adc     BAS_TMP1
001F00r 2  85 20                sta     INDEX
001F02r 2  A5 18                lda     ARG+2
001F04r 2  69 00                adc     #0
001F06r 2  85 21                sta     INDEX+1
001F08r 2                       ; Copy BAS_TMP1+1 bytes from (INDEX) to (FRESPC).
001F08r 2  A4 3B                ldy     BAS_TMP1+1
001F0Ar 2  F0 0B                beq     @done
001F0Cr 2  A0 00                ldy     #0
001F0Er 2               @cp:
001F0Er 2  B1 20                lda     (INDEX),y
001F10r 2  91 84                sta     (FRESPC),y
001F12r 2  C8                   iny
001F13r 2  C4 3B                cpy     BAS_TMP1+1
001F15r 2  D0 F7                bne     @cp
001F17r 2               @done:
001F17r 2                       ; Build descriptor.
001F17r 2  A5 3B                lda     BAS_TMP1+1
001F19r 2  85 0E                sta     FAC
001F1Br 2  A5 84                lda     FRESPC
001F1Dr 2  85 0F                sta     FAC+1
001F1Fr 2  A5 85                lda     FRESPC+1
001F21r 2  85 10                sta     FAC+2
001F23r 2                       ; Advance FRESPC by length consumed.
001F23r 2  18                   clc
001F24r 2  A5 84                lda     FRESPC
001F26r 2  65 3B                adc     BAS_TMP1+1
001F28r 2  85 84                sta     FRESPC
001F2Ar 2  90 02                bcc     @nb
001F2Cr 2  E6 85                inc     FRESPC+1
001F2Er 2               @nb:
001F2Er 2  4C rr rr             jmp     PutNew
001F31r 2               
001F31r 2               ; FreeArgString -- if ARG holds a temp string descriptor (most-recent
001F31r 2               ; on TEMPST), pop just the descriptor.  Heap is left intact so callers
001F31r 2               ; that still need the source bytes can copy them safely; orphaned heap
001F31r 2               ; will be reclaimed by Garbag.
001F31r 2               FreeArgString:
001F31r 2  A5 19                lda     ARG+3                   ; descriptor address lo
001F33r 2  A4 1A                ldy     ARG+4                   ; descriptor address hi (always $00)
001F35r 2  4C rr rr             jmp     FreTms
001F38r 2               
001F38r 2               ; Cleanup that releases both ARG's and FAC's temp descriptors (called from
001F38r 2               ; CatStr after content has been stashed but before new allocation).
001F38r 2               FreeBothTemps:
001F38r 2                       ; Free FAC's temp first (it is currently LASTPT).
001F38r 2  A5 11                lda     FAC+3
001F3Ar 2  A4 12                ldy     FAC+4
001F3Cr 2  20 rr rr             jsr     FreTms
001F3Fr 2                       ; Then ARG's (now LASTPT after FAC's removal).
001F3Fr 2  A5 19                lda     ARG+3
001F41r 2  A4 1A                ldy     ARG+4
001F43r 2  4C rr rr             jmp     FreTms
001F46r 2  60                   rts
001F47r 2               
001F47r 2               ; ===========================================================================
001F47r 2               ;   E V A L U A T O R   -   B I N A R Y   O P E R A T O R   H E L P E R S
001F47r 2               ; ===========================================================================
001F47r 2               
001F47r 2               ; ---------------------------------------------------------------------------
001F47r 2               ; AndOp -- FAC = ARG AND FAC (bitwise on 16-bit signed ints).
001F47r 2               ; ---------------------------------------------------------------------------
001F47r 2               AndOp:
001F47r 2  20 rr rr             jsr     AyInt                   ; FAC -> int (FAC+3=hi, FAC+4=lo)
001F4Ar 2  A5 11                lda     FAC+3
001F4Cr 2  85 3A                sta     BAS_TMP1                ; saved hi
001F4Er 2  A5 12                lda     FAC+4
001F50r 2  85 3B                sta     BAS_TMP1+1              ; saved lo
001F52r 2  20 rr rr             jsr     CopyArgToFac
001F55r 2  20 rr rr             jsr     AyInt
001F58r 2  A5 12                lda     FAC+4
001F5Ar 2  25 3B                and     BAS_TMP1+1
001F5Cr 2  A8                   tay                             ; Y = lo result
001F5Dr 2  A5 11                lda     FAC+3
001F5Fr 2  25 3A                and     BAS_TMP1                ; A = hi result
001F61r 2  4C rr rr             jmp     GivAyf
001F64r 2               
001F64r 2               ; ---------------------------------------------------------------------------
001F64r 2               ; OrOp -- FAC = ARG OR FAC.
001F64r 2               ; ---------------------------------------------------------------------------
001F64r 2               OrOp:
001F64r 2  20 rr rr             jsr     AyInt
001F67r 2  A5 11                lda     FAC+3
001F69r 2  85 3A                sta     BAS_TMP1                ; saved hi
001F6Br 2  A5 12                lda     FAC+4
001F6Dr 2  85 3B                sta     BAS_TMP1+1              ; saved lo
001F6Fr 2  20 rr rr             jsr     CopyArgToFac
001F72r 2  20 rr rr             jsr     AyInt
001F75r 2  A5 12                lda     FAC+4
001F77r 2  05 3B                ora     BAS_TMP1+1
001F79r 2  A8                   tay                             ; Y = lo
001F7Ar 2  A5 11                lda     FAC+3
001F7Cr 2  05 3A                ora     BAS_TMP1                ; A = hi
001F7Er 2  4C rr rr             jmp     GivAyf
001F81r 2               
001F81r 2               ; ---------------------------------------------------------------------------
001F81r 2               ; NotOp -- FAC = NOT FAC (bitwise complement of 16-bit signed int).
001F81r 2               ; ---------------------------------------------------------------------------
001F81r 2               NotOp:
001F81r 2  20 rr rr             jsr     AyInt
001F84r 2  A5 12                lda     FAC+4
001F86r 2  49 FF                eor     #$FF
001F88r 2  A8                   tay                             ; Y = lo
001F89r 2  A5 11                lda     FAC+3
001F8Br 2  49 FF                eor     #$FF                    ; A = hi
001F8Dr 2  4C rr rr             jmp     GivAyf
001F90r 2               
001F90r 2               ; ---------------------------------------------------------------------------
001F90r 2               ; BasCmdLet -- minimal LET (assignment).  Entered with ChrGot returning
001F90r 2               ; the first letter of the variable name.  No `LET` keyword required.
001F90r 2               ; ---------------------------------------------------------------------------
001F90r 2               BasCmdLet:
001F90r 2  20 rr rr             jsr     PtrGet                  ; VARPNT, VALTYP set; TXTPTR past name
001F93r 2                       ; Save VARPNT and the variable's VALTYP across FrmEvl.
001F93r 2  A5 3F                lda     VARPNT
001F95r 2  48                   pha
001F96r 2  A5 40                lda     VARPNT+1
001F98r 2  48                   pha
001F99r 2  A5 64                lda     VALTYP
001F9Br 2  48                   pha
001F9Cr 2  20 rr rr             jsr     ChrGot
001F9Fr 2  C9 3D                cmp     #'='
001FA1r 2  D0 36                bne     @synErr
001FA3r 2  20 rr rr             jsr     ChrGet
001FA6r 2  20 rr rr             jsr     FrmEvl
001FA9r 2  68                   pla                             ; saved variable VALTYP
001FAAr 2  85 3E                sta     BAS_TMP3
001FACr 2  45 64                eor     VALTYP
001FAEr 2  30 2F                bmi     @typeErr
001FB0r 2  68                   pla
001FB1r 2  85 40                sta     VARPNT+1
001FB3r 2  68                   pla
001FB4r 2  85 3F                sta     VARPNT
001FB6r 2  24 3E                bit     BAS_TMP3
001FB8r 2  30 07                bmi     @storeStr
001FBAr 2                       ; Numeric: store FAC into (VARPNT) (5 bytes).
001FBAr 2  A6 3F                ldx     VARPNT
001FBCr 2  A4 40                ldy     VARPNT+1
001FBEr 2  4C rr rr             jmp     StoreFacAtYxRounded
001FC1r 2               @storeStr:
001FC1r 2  A0 00                ldy     #0
001FC3r 2  A5 0E                lda     FAC
001FC5r 2  91 3F                sta     (VARPNT),y
001FC7r 2  C8                   iny
001FC8r 2  A5 0F                lda     FAC+1
001FCAr 2  91 3F                sta     (VARPNT),y
001FCCr 2  C8                   iny
001FCDr 2  A5 10                lda     FAC+2
001FCFr 2  91 3F                sta     (VARPNT),y
001FD1r 2                       ; If the RHS was a temporary string (StrLt2/PutNew pushed it and left
001FD1r 2                       ; its descriptor address in FAC+3/FAC+4 == LASTPT), pop it now that
001FD1r 2                       ; the variable owns the heap copy.  Pop only (FreTms), never FreFac --
001FD1r 2                       ; reclaiming would free the string we just stored.  For a plain
001FD1r 2                       ; variable RHS, @loadStr set FAC+3/FAC+4 to that variable's address
001FD1r 2                       ; (nonzero high byte), which cannot match a temp slot, so FreTms is a
001FD1r 2                       ; no-op.  Without this, >3 consecutive string LETs leak the 3-slot
001FD1r 2                       ; temp stack (?FORMULA TOO COMPLEX).
001FD1r 2  A5 11                lda     FAC+3
001FD3r 2  A4 12                ldy     FAC+4
001FD5r 2  20 rr rr             jsr     FreTms
001FD8r 2  60                   rts
001FD9r 2               @synErr:
001FD9r 2  68                   pla
001FDAr 2  68                   pla
001FDBr 2  68                   pla
001FDCr 2  4C rr rr             jmp     SynErr
001FDFr 2               @typeErr:
001FDFr 2  68                   pla
001FE0r 2  68                   pla
001FE1r 2  A2 08                ldx     #ERR_TYPEMISM
001FE3r 2  4C rr rr             jmp     BasErrorVec
001FE6r 2               
001FE6r 2               ; =============================================================================
001FE6r 2               ;   C O N T R O L   F L O W   /   S T A T E M E N T   L O O P
001FE6r 2               ;
001FE6r 2               ;   BasNewstt drives execution for both direct mode (TXTPTR in BAS_TOKBUF)
001FE6r 2               ;   and run mode (TXTPTR walks program lines from BAS_TXTTAB).  Statement
001FE6r 2               ;   dispatch follows the msbasic convention: push (routine_addr - 1) and
001FE6r 2               ;   tail-jump through ChrGet, so the routine entry is reached via RTS.
001FE6r 2               ;
001FE6r 2               ;   FOR and GOSUB store frames on the CPU stack and JMP back to BasNewstt;
001FE6r 2               ;   NEXT and RETURN scan the stack for a matching tag, then TXS to discard
001FE6r 2               ;   the frame and resume.
001FE6r 2               ; =============================================================================
001FE6r 2               
001FE6r 2               NUM_STMT_TOKENS = TOK_MEM + 1 - TOK_BASE       ; $36 entries
001FE6r 2               
001FE6r 2               BasNewstt:
001FE6r 2  20 rr rr             jsr     BasCheckBreak
001FE9r 2                       ; Save TXTPTR -> OLDTEXT for CONT, except in direct mode.
001FE9r 2  AD 6A 03             lda     BAS_CURLIN+1
001FECr 2  C9 FF                cmp     #$FF
001FEEr 2  F0 0E                beq     @noSave
001FF0r 2  A5 04                lda     TXTPTR
001FF2r 2  8D 6D 03             sta     BAS_OLDTEXT
001FF5r 2  A5 05                lda     TXTPTR+1
001FF7r 2  8D 6E 03             sta     BAS_OLDTEXT+1
001FFAr 2                       ; And the stack depth this statement starts at: FOR and GOSUB frames
001FFAr 2                       ; are below it, anything a statement pushes is above.  A break restores
001FFAr 2                       ; SP to here, so the frames survive it and the half-finished statement
001FFAr 2                       ; does not -- which is what lets CONT resume inside a loop.  Recorded
001FFAr 2                       ; only in run mode: a direct-mode line must not move the baseline it is
001FFAr 2                       ; itself being run from.
001FFAr 2  BA                   tsx
001FFBr 2  8E 75 03             stx     BAS_STKBASE
001FFEr 2               @noSave:
001FFEr 2  A0 00                ldy     #0
002000r 2  B1 04                lda     (TXTPTR),y
002002r 2  F0 10                beq     @endLine
002004r 2  C9 A4                cmp     #TOK_ELSE
002006r 2  F0 07                beq     @skipElse               ; THEN-branch ran; skip ELSE clause to EOL
002008r 2  C9 3A                cmp     #':'
00200Ar 2  F0 37                beq     @nextStmt
00200Cr 2  4C rr rr             jmp     SynErr
00200Fr 2               @skipElse:
00200Fr 2                       ; Advance TXTPTR until we land on a $00 terminator.
00200Fr 2               @skLoop:
00200Fr 2  20 rr rr             jsr     ChrGet
002012r 2  D0 FB                bne     @skLoop
002014r 2                       ; Fall through to @endLine with TXTPTR at $00.
002014r 2               @endLine:
002014r 2                       ; Direct mode: end of buffer -> back to REPL.
002014r 2  AD 6A 03             lda     BAS_CURLIN+1
002017r 2  C9 FF                cmp     #$FF
002019r 2  D0 03                bne     @walkNext
00201Br 2  4C rr rr             jmp     BasReadyLoop            ; OK is printed by BasReadyLoop
00201Er 2               @walkNext:
00201Er 2                       ; Run mode: examine next-pointer at offsets +1,+2.
00201Er 2  A0 02                ldy     #2
002020r 2  B1 04                lda     (TXTPTR),y
002022r 2  D0 09                bne     @loadLine               ; nonzero hi -> next line exists
002024r 2                       ; End of program -> halt and return to REPL.  The program ran off its
002024r 2                       ; last line rather than stopping, so its frames are finished with.
002024r 2  A2 FF                ldx     #$FF
002026r 2  9A                   txs
002027r 2  8E 75 03             stx     BAS_STKBASE
00202Ar 2  4C rr rr             jmp     BasReadyLoop
00202Dr 2               @loadLine:
00202Dr 2  C8                   iny                             ; y=3
00202Er 2  B1 04                lda     (TXTPTR),y
002030r 2  8D 69 03             sta     BAS_CURLIN
002033r 2  C8                   iny                             ; y=4
002034r 2  B1 04                lda     (TXTPTR),y
002036r 2  8D 6A 03             sta     BAS_CURLIN+1
002039r 2  98                   tya                             ; A=4
00203Ar 2  18                   clc
00203Br 2  65 04                adc     TXTPTR
00203Dr 2  85 04                sta     TXTPTR
00203Fr 2  90 02                bcc     @nextStmt
002041r 2  E6 05                inc     TXTPTR+1
002043r 2               @nextStmt:
002043r 2  20 rr rr             jsr     ChrGet
002046r 2  20 rr rr             jsr     BasExecuteStatement
002049r 2  4C rr rr             jmp     BasNewstt
00204Cr 2               
00204Cr 2               ; ---------------------------------------------------------------------------
00204Cr 2               ; BasExecuteStatement -- A = current tokenized byte (loaded by ChrGet).
00204Cr 2               ;   * A = 0  -> RTS (no-op; end of statement chain).
00204Cr 2               ;   * A < $80 (letter) -> JMP BasCmdLet.
00204Cr 2               ;   * A is a statement token ($80..TOK_MEM) -> dispatch via BasTokenAddrTbl.
00204Cr 2               ;   * Otherwise -> ?SYNTAX ERROR.
00204Cr 2               ; ---------------------------------------------------------------------------
00204Cr 2               BasExecuteStatement:
00204Cr 2  F0 30                beq     @ret
00204Er 2  38                   sec
00204Fr 2  E9 80                sbc     #TOK_BASE
002051r 2  90 25                bcc     @doLet
002053r 2  C9 36                cmp     #NUM_STMT_TOKENS
002055r 2  B0 0D                bcs     @ext
002057r 2  0A                   asl     a
002058r 2  A8                   tay
002059r 2  B9 rr rr             lda     BasTokenAddrTbl+1,y
00205Cr 2  48                   pha
00205Dr 2  B9 rr rr             lda     BasTokenAddrTbl,y
002060r 2  48                   pha
002061r 2  4C rr rr             jmp     ChrGet
002064r 2               @ext:
002064r 2                       ; Extended statement tokens DISK through NVERASE ($D1-$DF),
002064r 2                       ; dispatched through BasExtAddrTbl.
002064r 2  38                   sec
002065r 2  E9 51                sbc     #(TOK_DISK - TOK_BASE)
002067r 2  C9 0F                cmp     #(TOK_NVERASE + 1 - TOK_DISK)
002069r 2  B0 10                bcs     @synErr
00206Br 2  0A                   asl     a
00206Cr 2  A8                   tay
00206Dr 2  B9 rr rr             lda     BasExtAddrTbl+1,y
002070r 2  48                   pha
002071r 2  B9 rr rr             lda     BasExtAddrTbl,y
002074r 2  48                   pha
002075r 2  4C rr rr             jmp     ChrGet
002078r 2               @doLet:
002078r 2  4C rr rr             jmp     BasCmdLet
00207Br 2               @synErr:
00207Br 2  4C rr rr             jmp     SynErr
00207Er 2               @ret:
00207Er 2  60                   rts
00207Fr 2               
00207Fr 2               ; ---------------------------------------------------------------------------
00207Fr 2               ; BasCheckBreak -- poll input buffer for Ctrl-C / ESC.  On break, save
00207Fr 2               ; CONT context and bounce to REPL.  Other keys are stashed in BAS_PENDKEY
00207Fr 2               ; for INKEY to retrieve.
00207Fr 2               ; ---------------------------------------------------------------------------
00207Fr 2               BasCheckBreak:
00207Fr 2                       ; In direct mode (CURLIN hi == $FF) skip the break check entirely;
00207Fr 2                       ; otherwise we would drain pending REPL keystrokes and corrupt the
00207Fr 2                       ; next BasReadLine input.  Break is only meaningful while RUNning.
00207Fr 2  AD 6A 03             lda     BAS_CURLIN+1
002082r 2  C9 FF                cmp     #$FF
002084r 2  F0 13                beq     @no
002086r 2  20 rr rr             jsr     BufferSize
002089r 2  F0 0E                beq     @no
00208Br 2  20 rr rr             jsr     ReadBuffer
00208Er 2  C9 03                cmp     #$03
002090r 2  F0 08                beq     @break
002092r 2  C9 1B                cmp     #$1B
002094r 2  F0 04                beq     @break
002096r 2  8D 0E 03             sta     BAS_PENDKEY
002099r 2               @no:
002099r 2  60                   rts
00209Ar 2               @break:
00209Ar 2                       ; OLDLIN/OLDTEXT already track the executing line.  Make sure the
00209Ar 2                       ; saved values reflect the current line so CONT can resume.
00209Ar 2  AD 69 03             lda     BAS_CURLIN
00209Dr 2  8D 6B 03             sta     BAS_OLDLIN
0020A0r 2  AD 6A 03             lda     BAS_CURLIN+1
0020A3r 2  8D 6C 03             sta     BAS_OLDLIN+1
0020A6r 2  AE 75 03             ldx     BAS_STKBASE             ; Back to the statement boundary, not to
0020A9r 2  9A                   txs                             ;   an empty stack: the loop this broke
0020AAr 2                                                       ;   out of is meant to still be there
0020AAr 2  20 rr rr             jsr     BasPrintCRLF
0020ADr 2  A9 rr                lda     #<MsgBreak
0020AFr 2  A0 rr                ldy     #>MsgBreak
0020B1r 2  20 rr rr             jsr     BasPrintStr
0020B4r 2  4C rr rr             jmp     BasStopAtLine
0020B7r 2               
0020B7r 2  42 52 45 41  MsgBreak: .byte "BREAK",0
0020BBr 2  4B 00        
0020BDr 2               
0020BDr 2               ; ---------------------------------------------------------------------------
0020BDr 2               ; LinGet -- parse decimal digits at TXTPTR into BAS_LINNUM (16-bit).
0020BDr 2               ; Caller has set carry conditions appropriate to ChrGet entry.  TXTPTR
0020BDr 2               ; ends pointing at the first non-digit.
0020BDr 2               ; ---------------------------------------------------------------------------
0020BDr 2               LinGet:
0020BDr 2  A2 00                ldx     #0
0020BFr 2  86 08                stx     BAS_LINNUM
0020C1r 2  86 09                stx     BAS_LINNUM+1
0020C3r 2               @loop:
0020C3r 2  B0 3A                bcs     @done
0020C5r 2  E9 2F                sbc     #$2F                    ; carry already set
0020C7r 2  85 44                sta     CHARAC
0020C9r 2                       ; LINNUM *= 10
0020C9r 2  A5 08                lda     BAS_LINNUM
0020CBr 2  85 3A                sta     BAS_TMP1
0020CDr 2  A5 09                lda     BAS_LINNUM+1
0020CFr 2  85 3B                sta     BAS_TMP1+1
0020D1r 2  C9 19                cmp     #$19
0020D3r 2  B0 2B                bcs     @ovf
0020D5r 2  06 08                asl     BAS_LINNUM
0020D7r 2  26 09                rol     BAS_LINNUM+1
0020D9r 2  06 08                asl     BAS_LINNUM
0020DBr 2  26 09                rol     BAS_LINNUM+1
0020DDr 2  18                   clc
0020DEr 2  A5 08                lda     BAS_LINNUM
0020E0r 2  65 3A                adc     BAS_TMP1
0020E2r 2  85 08                sta     BAS_LINNUM
0020E4r 2  A5 09                lda     BAS_LINNUM+1
0020E6r 2  65 3B                adc     BAS_TMP1+1
0020E8r 2  85 09                sta     BAS_LINNUM+1
0020EAr 2  06 08                asl     BAS_LINNUM
0020ECr 2  26 09                rol     BAS_LINNUM+1
0020EEr 2  18                   clc
0020EFr 2  A5 08                lda     BAS_LINNUM
0020F1r 2  65 44                adc     CHARAC
0020F3r 2  85 08                sta     BAS_LINNUM
0020F5r 2  90 02                bcc     @nextDigit
0020F7r 2  E6 09                inc     BAS_LINNUM+1
0020F9r 2               @nextDigit:
0020F9r 2  20 rr rr             jsr     ChrGet
0020FCr 2  4C rr rr             jmp     @loop
0020FFr 2               @done:
0020FFr 2  60                   rts
002100r 2               @ovf:
002100r 2  A2 00                ldx     #ERR_SYNTAX
002102r 2  4C rr rr             jmp     BasErrorVec
002105r 2               
002105r 2               ; ---------------------------------------------------------------------------
002105r 2               ; FndLin -- find program line whose number matches BAS_LINNUM.
002105r 2               ;   On success: carry SET, BAS_TMP1 (LOWTR alias) = address of line.
002105r 2               ;   On failure: carry CLEAR, BAS_TMP1 = address where line would belong.
002105r 2               ; ---------------------------------------------------------------------------
002105r 2               FndLin:
002105r 2  AD 5D 03             lda     BAS_TXTTAB
002108r 2  AE 5E 03             ldx     BAS_TXTTAB+1
00210Br 2               @walk:
00210Br 2  85 3A                sta     BAS_TMP1
00210Dr 2  86 3B                stx     BAS_TMP1+1
00210Fr 2  A0 01                ldy     #1
002111r 2  B1 3A                lda     (BAS_TMP1),y
002113r 2  F0 20                beq     @notFound               ; next-hi=0 -> end of program
002115r 2  A0 03                ldy     #3                      ; line-num-lo offset
002117r 2  A5 09                lda     BAS_LINNUM+1
002119r 2  D1 3A                cmp     (BAS_TMP1),y            ; compare hi byte at +3? need iny
00211Br 2                       ; Actually format: +0 next-lo, +1 next-hi, +2 num-lo, +3 num-hi
00211Br 2  90 18                bcc     @notFound               ; LINNUM-hi < line-hi -> miss
00211Dr 2  D0 09                bne     @advance                ; LINNUM-hi > line-hi -> next line
00211Fr 2  88                   dey                             ; y=2 = num-lo
002120r 2  A5 08                lda     BAS_LINNUM
002122r 2  D1 3A                cmp     (BAS_TMP1),y
002124r 2  90 0F                bcc     @notFound
002126r 2  F0 0F                beq     @found
002128r 2               @advance:
002128r 2  A0 00                ldy     #0
00212Ar 2  B1 3A                lda     (BAS_TMP1),y
00212Cr 2  48                   pha
00212Dr 2  A0 01                ldy     #1
00212Fr 2  B1 3A                lda     (BAS_TMP1),y
002131r 2  AA                   tax
002132r 2  68                   pla
002133r 2  B0 D6                bcs     @walk                   ; carry=1 means continue (always)
002135r 2               @notFound:
002135r 2  18                   clc
002136r 2  60                   rts
002137r 2               @found:
002137r 2  38                   sec
002138r 2  60                   rts
002139r 2               
002139r 2               ; ---------------------------------------------------------------------------
002139r 2               ; BasCmdGoto -- TXTPTR points at line-number digits.
002139r 2               ; ---------------------------------------------------------------------------
002139r 2               BasCmdGoto:
002139r 2  20 rr rr             jsr     LinGet
00213Cr 2  20 rr rr             jsr     BasRemn                 ; skip remainder of statement
00213Fr 2  20 rr rr             jsr     FndLin
002142r 2  90 0E                bcc     @undef
002144r 2                       ; LOWTR (BAS_TMP1) = target line addr.  TXTPTR = LOWTR - 1
002144r 2                       ; (so NEWSTT sees the previous line's $00 terminator at offset 0).
002144r 2  38                   sec
002145r 2  A5 3A                lda     BAS_TMP1
002147r 2  E9 01                sbc     #1
002149r 2  85 04                sta     TXTPTR
00214Br 2  A5 3B                lda     BAS_TMP1+1
00214Dr 2  E9 00                sbc     #0
00214Fr 2  85 05                sta     TXTPTR+1
002151r 2  60                   rts
002152r 2               @undef:
002152r 2  A2 03                ldx     #ERR_UNDEFSTMT
002154r 2  4C rr rr             jmp     BasErrorVec
002157r 2               
002157r 2               ; ---------------------------------------------------------------------------
002157r 2               ; BasCmdGosub -- push 5-byte frame on stack, then GOTO target.
002157r 2               ; Frame layout (top-down): [tag $8C][CURLIN-lo][CURLIN-hi][TXTPTR-lo][TXTPTR-hi]
002157r 2               ; ---------------------------------------------------------------------------
002157r 2               BasCmdGosub:
002157r 2                       ; Refuse to nest deeper than page 1 can hold.  msbasic guards every
002157r 2                       ; stack-frame push with GETSTK; this is that check specialised to
002157r 2                       ; GOSUB's fixed frame (msbasic's `LDA #3 : JSR GETSTK`, i.e. 3*2
002157r 2                       ; bytes of frame plus GETSTK's $3E-byte margin for the interpreter's
002157r 2                       ; own JSR nesting inside the subroutine).  Without it the frames run
002157r 2                       ; off the bottom of the stack and corrupt page 1 instead of raising
002157r 2                       ; an error.
002157r 2  BA                   tsx
002158r 2  E0 44                cpx     #GOSUB_STACK_MIN
00215Ar 2  90 1A                bcc     @outOfMemory
00215Cr 2  A5 05                lda     TXTPTR+1
00215Er 2  48                   pha
00215Fr 2  A5 04                lda     TXTPTR
002161r 2  48                   pha
002162r 2  AD 6A 03             lda     BAS_CURLIN+1
002165r 2  48                   pha
002166r 2  AD 69 03             lda     BAS_CURLIN
002169r 2  48                   pha
00216Ar 2  A9 8C                lda     #TOK_GOSUB
00216Cr 2  48                   pha
00216Dr 2  20 rr rr             jsr     ChrGot
002170r 2  20 rr rr             jsr     BasCmdGoto
002173r 2  4C rr rr             jmp     BasNewstt
002176r 2               @outOfMemory:
002176r 2  A9 02                lda     #ERR_OUTOFMEM
002178r 2  4C rr rr             jmp     BasError
00217Br 2               
00217Br 2               ; ---------------------------------------------------------------------------
00217Br 2               ; BasCmdReturn -- locate GOSUB frame on stack and resume at saved TXTPTR.
00217Br 2               ; Per msbasic: scan the CPU stack from SP+5 (skipping return-routine's caller
00217Br 2               ; return + this scan's own JSR return).  RTS at end pops the leaked
00217Br 2               ; EXEC-return that GOSUB left behind.
00217Br 2               ; ---------------------------------------------------------------------------
00217Br 2               BasCmdReturn:
00217Br 2  20 rr rr             jsr     GtForPnt
00217Er 2                       ; X now points to the slot just BELOW a frame tag (or end of stack).
00217Er 2  9A                   txs
00217Fr 2  C9 8C                cmp     #TOK_GOSUB
002181r 2  F0 05                beq     @ok
002183r 2  A2 0C                ldx     #ERR_RG
002185r 2  4C rr rr             jmp     BasErrorVec
002188r 2               @ok:
002188r 2  68                   pla                             ; tag (already in A, this discards)
002189r 2  68                   pla
00218Ar 2  8D 69 03             sta     BAS_CURLIN
00218Dr 2  68                   pla
00218Er 2  8D 6A 03             sta     BAS_CURLIN+1
002191r 2  68                   pla
002192r 2  85 04                sta     TXTPTR
002194r 2  68                   pla
002195r 2  85 05                sta     TXTPTR+1
002197r 2                       ; Skip remainder of GOSUB-target statement (DATAN-style).
002197r 2  20 rr rr             jsr     BasDatan
00219Ar 2                       ; Advance TXTPTR by Y (number of bytes to terminator).
00219Ar 2  98                   tya
00219Br 2  18                   clc
00219Cr 2  65 04                adc     TXTPTR
00219Er 2  85 04                sta     TXTPTR
0021A0r 2  90 02                bcc     @noinc
0021A2r 2  E6 05                inc     TXTPTR+1
0021A4r 2               @noinc:
0021A4r 2  60                   rts
0021A5r 2               
0021A5r 2               ; ---------------------------------------------------------------------------
0021A5r 2               ; GtForPnt -- scan CPU stack for FOR/GOSUB frames.
0021A5r 2               ;   On entry: BAS_FORPNT (FORPNT) = $FFxx for "match any tag".
0021A5r 2               ;   Returns: X = stack pointer where the matching frame's tag-1 lives,
0021A5r 2               ;            A = tag byte found (or 0 if end-of-stack).  Z=1 if found tag,
0021A5r 2               ;            Z=0 (A=0) if no frame found.
0021A5r 2               ; ---------------------------------------------------------------------------
0021A5r 2               GtForPnt:
0021A5r 2  BA                   tsx
0021A6r 2  E8                   inx
0021A7r 2  E8                   inx
0021A8r 2  E8                   inx
0021A9r 2  E8                   inx
0021AAr 2               @scan:
0021AAr 2  BD 01 01             lda     $0101,x                 ; tag candidate
0021ADr 2  C9 81                cmp     #TOK_FOR
0021AFr 2  D0 25                bne     @notFor
0021B1r 2                       ; Compare frame's variable address to FORPNT.
0021B1r 2  A5 47                lda     BAS_FORPNT+1
0021B3r 2  D0 0A                bne     @skipVar                ; FORPNT+1 = $FF -> skip variable test
0021B5r 2  BD 02 01             lda     $0102,x
0021B8r 2  85 46                sta     BAS_FORPNT
0021BAr 2  BD 03 01             lda     $0103,x
0021BDr 2  85 47                sta     BAS_FORPNT+1
0021BFr 2               @skipVar:
0021BFr 2  DD 03 01             cmp     $0103,x
0021C2r 2  D0 07                bne     @advance
0021C4r 2  A5 46                lda     BAS_FORPNT
0021C6r 2  DD 02 01             cmp     $0102,x
0021C9r 2  F0 13                beq     @found
0021CBr 2               @advance:
0021CBr 2  8A                   txa
0021CCr 2  18                   clc
0021CDr 2  69 12                adc     #18                     ; BYTES_PER_FRAME (FOR)
0021CFr 2  AA                   tax
0021D0r 2  D0 D8                bne     @scan
0021D2r 2                       ; Walked off stack
0021D2r 2  A9 00                lda     #0
0021D4r 2  18                   clc                             ; not found
0021D5r 2  60                   rts
0021D6r 2               @notFor:
0021D6r 2  C9 8C                cmp     #TOK_GOSUB
0021D8r 2  F0 04                beq     @found
0021DAr 2  A9 00                lda     #0
0021DCr 2  18                   clc                             ; not found
0021DDr 2  60                   rts
0021DEr 2               @found:
0021DEr 2  38                   sec                             ; found; A still holds the tag or FORPNT
0021DFr 2  60                   rts
0021E0r 2               
0021E0r 2               ; ---------------------------------------------------------------------------
0021E0r 2               ; BasRemn -- scan TXTPTR forward to next ':' or end-of-line.
0021E0r 2               ; Sets Y to byte offset of terminator from current TXTPTR.  Honours quotes.
0021E0r 2               ; ---------------------------------------------------------------------------
0021E0r 2               BasDatan:
0021E0r 2  A2 3A                ldx     #':'
0021E2r 2  2C                   .byte   $2C                     ; BIT abs absorbs next 2-byte LDX
0021E3r 2               BasRemn:
0021E3r 2  A2 00                ldx     #0
0021E5r 2  86 44                stx     CHARAC
0021E7r 2  A0 00                ldy     #0
0021E9r 2  84 6A                sty     ENDCHR
0021EBr 2               @swap:
0021EBr 2  A5 6A                lda     ENDCHR
0021EDr 2  A6 44                ldx     CHARAC
0021EFr 2  85 44                sta     CHARAC
0021F1r 2  86 6A                stx     ENDCHR
0021F3r 2               @scan:
0021F3r 2  B1 04                lda     (TXTPTR),y
0021F5r 2  F0 0B                beq     @done
0021F7r 2  C5 6A                cmp     ENDCHR
0021F9r 2  F0 07                beq     @done
0021FBr 2  C8                   iny
0021FCr 2  C9 22                cmp     #'"'
0021FEr 2  F0 EB                beq     @swap
002200r 2  D0 F1                bne     @scan
002202r 2               @done:
002202r 2  60                   rts
002203r 2               
002203r 2               ; ---------------------------------------------------------------------------
002203r 2               ; Statement: REM -- skip to end of line.
002203r 2               ; Statement: DATA -- treated like REM at execution time (just skip).
002203r 2               ; ---------------------------------------------------------------------------
002203r 2               BasCmdRem:
002203r 2  20 rr rr             jsr     BasRemn
002206r 2  80 03                bra     BasAddon
002208r 2               BasCmdData:
002208r 2  20 rr rr             jsr     BasDatan
00220Br 2               BasAddon:
00220Br 2  98                   tya
00220Cr 2  18                   clc
00220Dr 2  65 04                adc     TXTPTR
00220Fr 2  85 04                sta     TXTPTR
002211r 2  90 02                bcc     @done
002213r 2  E6 05                inc     TXTPTR+1
002215r 2               @done:
002215r 2  60                   rts
002216r 2               
002216r 2               ; ---------------------------------------------------------------------------
002216r 2               ; Statement: IF expr THEN (linenum | stmt) [ELSE stmt]
002216r 2               ;   IF expr GOTO linenum is also accepted.
002216r 2               ;   If expr is false, skip rest of line (REM-style).
002216r 2               ;   ELSE: scan ahead for TOK_ELSE on this line.
002216r 2               ; ---------------------------------------------------------------------------
002216r 2               BasCmdIf:
002216r 2  20 rr rr             jsr     FrmEvl
002219r 2  20 rr rr             jsr     ChrGot
00221Cr 2  C9 88                cmp     #TOK_GOTO
00221Er 2  F0 05                beq     @testTrue
002220r 2  A9 9F                lda     #TOK_THEN
002222r 2  20 rr rr             jsr     SynChr
002225r 2               @testTrue:
002225r 2  A5 0E                lda     FAC
002227r 2  D0 1E                bne     @true
002229r 2                       ; FALSE: scan to end-of-line OR a TOK_ELSE; if ELSE found, advance
002229r 2                       ; TXTPTR past it and resume execution there.
002229r 2  A0 00                ldy     #0
00222Br 2               @searchElse:
00222Br 2  B1 04                lda     (TXTPTR),y
00222Dr 2  F0 07                beq     @noElse
00222Fr 2  C9 A4                cmp     #TOK_ELSE
002231r 2  F0 09                beq     @gotElse
002233r 2  C8                   iny
002234r 2  D0 F5                bne     @searchElse
002236r 2               @noElse:
002236r 2                       ; Skip remainder of line (no ELSE).
002236r 2  20 rr rr             jsr     BasRemn
002239r 2  4C rr rr             jmp     BasAddon
00223Cr 2               @gotElse:
00223Cr 2                       ; Advance TXTPTR past ELSE token, then run the ELSE branch as a
00223Cr 2                       ; statement.  Falling through to @true's tail is deliberate: the
00223Cr 2                       ; branch after ELSE is dispatched exactly like the one after THEN,
00223Cr 2                       ; so `ELSE <linenum>` is an implicit GOTO too.  Returning here
00223Cr 2                       ; instead would leave TXTPTR mid-statement and the interpreter loop
00223Cr 2                       ; would report ?SYNTAX ERROR.
00223Cr 2  C8                   iny
00223Dr 2  98                   tya
00223Er 2  18                   clc
00223Fr 2  65 04                adc     TXTPTR
002241r 2  85 04                sta     TXTPTR
002243r 2  90 02                bcc     @true
002245r 2  E6 05                inc     TXTPTR+1
002247r 2               @true:
002247r 2                       ; TRUE: if next is a digit, IF expr THEN <linenum> -> implicit GOTO.
002247r 2  20 rr rr             jsr     ChrGot
00224Ar 2  90 03                bcc     @goto                   ; carry CLEAR -> digit
00224Cr 2                       ; Otherwise dispatch as a statement (msbasic: jmp EXECUTE_STATEMENT).
00224Cr 2  4C rr rr             jmp     BasExecuteStatement
00224Fr 2               @goto:
00224Fr 2  4C rr rr             jmp     BasCmdGoto
002252r 2               
002252r 2               ; ---------------------------------------------------------------------------
002252r 2               ; Statement: ON expr GOTO/GOSUB linenum,linenum,...
002252r 2               ; ---------------------------------------------------------------------------
002252r 2               BasCmdOn:
002252r 2  20 rr rr             jsr     GetByt                  ; X = expr byte (1..255)
002255r 2  48                   pha                             ; save GOTO/GOSUB token byte
002256r 2  C9 8C                cmp     #TOK_GOSUB
002258r 2  F0 04                beq     @loop
00225Ar 2  C9 88                cmp     #TOK_GOTO
00225Cr 2  D0 14                bne     @synErr
00225Er 2               @loop:
00225Er 2  C6 12                dec     FAC+4
002260r 2  D0 04                bne     @next
002262r 2  68                   pla
002263r 2                       ; Re-dispatch through statement table so trampoline ChrGet skips the
002263r 2                       ; current separator (',' or 0) before the GOTO/GOSUB handler runs.
002263r 2  4C rr rr             jmp     BasExecuteStatement
002266r 2               @next:
002266r 2  20 rr rr             jsr     ChrGet
002269r 2  20 rr rr             jsr     LinGet
00226Cr 2  C9 2C                cmp     #','
00226Er 2  F0 EE                beq     @loop
002270r 2  68                   pla
002271r 2  60                   rts
002272r 2               @synErr:
002272r 2  68                   pla
002273r 2  4C rr rr             jmp     SynErr
002276r 2               
002276r 2               ; ---------------------------------------------------------------------------
002276r 2               ; GetByt / GtByteCom -- evaluate expression in TXTPTR to byte 0..255 in X.
002276r 2               ;   GetByt: TXTPTR is at first byte of expression.
002276r 2               ;   GtByteCom: consume comma first.
002276r 2               ; ---------------------------------------------------------------------------
002276r 2               GtByteCom:
002276r 2  20 rr rr             jsr     ChrGet
002279r 2               GetByt:
002279r 2  20 rr rr             jsr     FrmNum
00227Cr 2  20 rr rr             jsr     MkInt
00227Fr 2  A6 11                ldx     FAC+3
002281r 2  D0 05                bne     @ovf
002283r 2  A6 12                ldx     FAC+4
002285r 2  4C rr rr             jmp     ChrGot
002288r 2               @ovf:
002288r 2  4C rr rr             jmp     IqErr
00228Br 2               
00228Br 2               ; ---------------------------------------------------------------------------
00228Br 2               ; Statement: RUN [linenum]
00228Br 2               ; ---------------------------------------------------------------------------
00228Br 2               BasCmdRun:
00228Br 2  20 rr rr             jsr     ChrGot
00228Er 2  D0 21                bne     @withLine
002290r 2  20 rr rr             jsr     BasCmdClr
002293r 2                       ; Set TXTPTR = TXTTAB - 1 ; ensure that byte = 0.
002293r 2  38                   sec
002294r 2  AD 5D 03             lda     BAS_TXTTAB
002297r 2  E9 01                sbc     #1
002299r 2  85 04                sta     TXTPTR
00229Br 2  AD 5E 03             lda     BAS_TXTTAB+1
00229Er 2  E9 00                sbc     #0
0022A0r 2  85 05                sta     TXTPTR+1
0022A2r 2                       ; Force the byte at TXTTAB-1 to be zero so NEWSTT walks the chain.
0022A2r 2  A9 00                lda     #0
0022A4r 2  A0 00                ldy     #0
0022A6r 2  91 04                sta     (TXTPTR),y
0022A8r 2                       ; Leave direct-mode (CURLIN+1=$FF); @loadLine will set real value.
0022A8r 2  9C 69 03             stz     BAS_CURLIN
0022ABr 2  9C 6A 03             stz     BAS_CURLIN+1
0022AEr 2                       ; Straight back into the statement loop rather than RTS, as msbasic's
0022AEr 2                       ; RUN does: CLR above has just reset the stack, so the return address
0022AEr 2                       ; this was dispatched with is no longer on it -- which is the point.  A
0022AEr 2                       ; program that starts on top of a suspended one's FOR frames is a
0022AEr 2                       ; program whose first NEXT can find the wrong loop.
0022AEr 2  4C rr rr             jmp     BasNewstt
0022B1r 2               @withLine:
0022B1r 2  20 rr rr             jsr     BasCmdClr
0022B4r 2  20 rr rr             jsr     ChrGot
0022B7r 2  20 rr rr             jsr     BasCmdGoto              ; does not return if the line is undefined
0022BAr 2                       ; Leave direct mode, exactly as the bare RUN path above does.
0022BAr 2                       ; BasCmdGoto only moves TXTPTR; while CURLIN+1 is still $FF, BasNewstt
0022BAr 2                       ; treats the branch target as an immediate-mode statement and returns
0022BAr 2                       ; to the READY loop after it -- so `RUN 20` printed nothing at all.
0022BAr 2                       ; Set after the branch, not before, so an undefined line still reports
0022BAr 2                       ; `?UNDEF'D STATEMENT ERROR` with no spurious `IN 0` line number.
0022BAr 2  9C 69 03             stz     BAS_CURLIN
0022BDr 2  9C 6A 03             stz     BAS_CURLIN+1
0022C0r 2  4C rr rr             jmp     BasNewstt               ; as the bare path above: CLR reset the
0022C3r 2                                                       ;   stack this was dispatched from
0022C3r 2               
0022C3r 2               ; ---------------------------------------------------------------------------
0022C3r 2               ; Statement: END / STOP -- save CONT context and return to REPL.
0022C3r 2               ; ---------------------------------------------------------------------------
0022C3r 2               BasCmdEnd:
0022C3r 2  18                   clc
0022C4r 2  24                   .byte   $24                     ; BIT zp -> skip next byte (sec)
0022C5r 2               BasCmdStop:
0022C5r 2  38                   sec
0022C6r 2                       ; Save the END/STOP flag (carry) before ChrGot clobbers it.
0022C6r 2  08                   php
0022C7r 2  20 rr rr             jsr     ChrGot
0022CAr 2  D0 2D                bne     @synErrPlp
0022CCr 2  28                   plp
0022CDr 2                       ; Save CONT state.
0022CDr 2  A5 04                lda     TXTPTR
0022CFr 2  8D 6D 03             sta     BAS_OLDTEXT
0022D2r 2  A5 05                lda     TXTPTR+1
0022D4r 2  8D 6E 03             sta     BAS_OLDTEXT+1
0022D7r 2  AD 69 03             lda     BAS_CURLIN
0022DAr 2  8D 6B 03             sta     BAS_OLDLIN
0022DDr 2  AD 6A 03             lda     BAS_CURLIN+1
0022E0r 2  8D 6C 03             sta     BAS_OLDLIN+1
0022E3r 2  AE 75 03             ldx     BAS_STKBASE             ; As with a Ctrl+C break: keep the FOR
0022E6r 2  9A                   txs                             ;   and GOSUB frames for CONT
0022E7r 2  90 0D                bcc     @end
0022E9r 2                       ; STOP path: print "BREAK[ IN nnnn]".
0022E9r 2  20 rr rr             jsr     BasPrintCRLF
0022ECr 2  A9 rr                lda     #<MsgBreak
0022EEr 2  A0 rr                ldy     #>MsgBreak
0022F0r 2  20 rr rr             jsr     BasPrintStr
0022F3r 2  4C rr rr             jmp     BasStopAtLine
0022F6r 2               @end:
0022F6r 2  4C rr rr             jmp     BasStopDirect
0022F9r 2               @synErrPlp:
0022F9r 2  28                   plp
0022FAr 2               @synErr:
0022FAr 2  4C rr rr             jmp     SynErr
0022FDr 2               
0022FDr 2               ; ---------------------------------------------------------------------------
0022FDr 2               ; Statement: CONT -- resume execution from saved OLDTEXT/OLDLIN.
0022FDr 2               ; ---------------------------------------------------------------------------
0022FDr 2               BasCmdCont:
0022FDr 2  20 rr rr             jsr     ChrGot
002300r 2  D0 21                bne     @synErr
002302r 2  AD 6E 03             lda     BAS_OLDTEXT+1
002305r 2  D0 05                bne     @canCont
002307r 2  A2 10                ldx     #ERR_CANTCONT
002309r 2  4C rr rr             jmp     BasErrorVec
00230Cr 2               @canCont:
00230Cr 2  AD 6D 03             lda     BAS_OLDTEXT
00230Fr 2  85 04                sta     TXTPTR
002311r 2  AD 6E 03             lda     BAS_OLDTEXT+1
002314r 2  85 05                sta     TXTPTR+1
002316r 2  AD 6B 03             lda     BAS_OLDLIN
002319r 2  8D 69 03             sta     BAS_CURLIN
00231Cr 2  AD 6C 03             lda     BAS_OLDLIN+1
00231Fr 2  8D 6A 03             sta     BAS_CURLIN+1
002322r 2  60                   rts
002323r 2               @synErr:
002323r 2  4C rr rr             jmp     SynErr
002326r 2               
002326r 2               ; ---------------------------------------------------------------------------
002326r 2               ; Statement: RESTORE -- DATAPTR := TXTTAB - 1.
002326r 2               ; ---------------------------------------------------------------------------
002326r 2               BasCmdRestore:
002326r 2  38                   sec
002327r 2  AD 5D 03             lda     BAS_TXTTAB
00232Ar 2  E9 01                sbc     #1
00232Cr 2  8D 1A 03             sta     BAS_DATAPTR
00232Fr 2  AD 5E 03             lda     BAS_TXTTAB+1
002332r 2  E9 00                sbc     #0
002334r 2  8D 1B 03             sta     BAS_DATAPTR+1
002337r 2  60                   rts
002338r 2               
002338r 2               ; ---------------------------------------------------------------------------
002338r 2               ; Statement: INPUT [<"prompt">{,;}] var[,var,...]
002338r 2               ;   Prompts user for input, reads a line, parses it into the variable list.
002338r 2               ;   "abc";VAR  prints  abc?    (question + space appended)
002338r 2               ;   "abc",VAR  prints  abc      (no question mark)
002338r 2               ;   no prompt: prints  ?
002338r 2               ;   On bad numeric input or premature end-of-line: "?REDO FROM START"
002338r 2               ;   and reprompt.  Trailing un-consumed input: "?EXTRA IGNORED".
002338r 2               ; ---------------------------------------------------------------------------
002338r 2               BasCmdInput:
002338r 2                       ; INPUT is illegal in direct mode.
002338r 2  AD 6A 03             lda     BAS_CURLIN+1
00233Br 2  C9 FF                cmp     #$FF
00233Dr 2  D0 05                bne     @notDirect
00233Fr 2  A2 07                ldx     #ERR_ILLDIRECT
002341r 2  4C rr rr             jmp     BasErrorVec
002344r 2               @notDirect:
002344r 2                       ; ChrGot returns first char after the INPUT token.
002344r 2  20 rr rr             jsr     ChrGot
002347r 2  C9 22                cmp     #'"'
002349r 2  D0 27                bne     @noPrompt
00234Br 2                       ; Parse string literal & print it; FrmEvl will leave descriptor in FAC.
00234Br 2  20 rr rr             jsr     FrmEvl
00234Er 2  20 rr rr             jsr     ChkStr
002351r 2  20 rr rr             jsr     PrintStrFAC
002354r 2  20 rr rr             jsr     FreFac
002357r 2  20 rr rr             jsr     ChrGot
00235Ar 2  C9 3B                cmp     #';'
00235Cr 2  F0 09                beq     @semi
00235Er 2  C9 2C                cmp     #','
002360r 2  D0 0D                bne     @badPrompt
002362r 2  20 rr rr             jsr     ChrGet                  ; consume ','
002365r 2  80 0E                bra     @afterPrompt
002367r 2               @semi:
002367r 2  20 rr rr             jsr     ChrGet                  ; consume ';'
00236Ar 2  20 rr rr             jsr     BasInpQues              ; '? '
00236Dr 2  80 06                bra     @afterPrompt
00236Fr 2               @badPrompt:
00236Fr 2  4C rr rr             jmp     SynErr
002372r 2               @noPrompt:
002372r 2  20 rr rr             jsr     BasInpQues              ; '? '
002375r 2               @afterPrompt:
002375r 2                       ; Save program TXTPTR (start of var-list) for REDO retry.
002375r 2  A5 04                lda     TXTPTR
002377r 2  8D 71 03             sta     BAS_INPSAV
00237Ar 2  A5 05                lda     TXTPTR+1
00237Cr 2  8D 72 03             sta     BAS_INPSAV+1
00237Fr 2               @retry:
00237Fr 2  20 rr rr             jsr     BasReadLine             ; reads to BAS_LINBUF, NUL-terminated, prints CRLF
002382r 2                       ; Set up data pointer with leading ',' sentinel just before LINBUF.
002382r 2  A9 2C                lda     #','
002384r 2  8D FF 03             sta     BAS_LINBUF-1
002387r 2  A9 FF                lda     #<(BAS_LINBUF-1)
002389r 2  85 3A                sta     BAS_TMP1
00238Br 2  A9 03                lda     #>(BAS_LINBUF-1)
00238Dr 2  85 3B                sta     BAS_TMP1+1
00238Fr 2                       ; Restore program TXTPTR.
00238Fr 2  AD 71 03             lda     BAS_INPSAV
002392r 2  85 04                sta     TXTPTR
002394r 2  AD 72 03             lda     BAS_INPSAV+1
002397r 2  85 05                sta     TXTPTR+1
002399r 2  64 69                stz     BAS_INPUTFLG            ; INPUT mode ($00)
00239Br 2               @nextVar:
00239Br 2  20 rr rr             jsr     PtrGet                  ; advance program TXTPTR past var name
00239Er 2  85 46                sta     BAS_FORPNT
0023A0r 2  84 47                sty     BAS_FORPNT+1
0023A2r 2                       ; Save program TXTPTR; switch to data side.
0023A2r 2  A5 05                lda     TXTPTR+1
0023A4r 2  48                   pha
0023A5r 2  A5 04                lda     TXTPTR
0023A7r 2  48                   pha
0023A8r 2  A5 3A                lda     BAS_TMP1
0023AAr 2  85 04                sta     TXTPTR
0023ACr 2  A5 3B                lda     BAS_TMP1+1
0023AEr 2  85 05                sta     TXTPTR+1
0023B0r 2  20 rr rr             jsr     ChrGot
0023B3r 2  D0 05                bne     @gotData
0023B5r 2                       ; Out of input data before var list exhausted -> REDO.
0023B5r 2  68                   pla
0023B6r 2  68                   pla
0023B7r 2  4C rr rr             jmp     @doRedo
0023BAr 2               @gotData:
0023BAr 2  20 rr rr             jsr     ChrGet                  ; consume the separator/sentinel
0023BDr 2  24 64                bit     VALTYP
0023BFr 2  30 2E                bmi     @inpStr
0023C1r 2                       ; Numeric: must start with digit, '+', '-' or '.'; else REDO.
0023C1r 2  20 rr rr             jsr     ChrGot
0023C4r 2  90 11                bcc     @numOk                  ; carry clear == digit
0023C6r 2  C9 2D                cmp     #'-'
0023C8r 2  F0 0D                beq     @numOk
0023CAr 2  C9 2B                cmp     #'+'
0023CCr 2  F0 09                beq     @numOk
0023CEr 2  C9 2E                cmp     #'.'
0023D0r 2  F0 05                beq     @numOk
0023D2r 2                       ; bad numeric
0023D2r 2  68                   pla
0023D3r 2  68                   pla
0023D4r 2  4C rr rr             jmp     @doRedo
0023D7r 2               @numOk:
0023D7r 2  20 rr rr             jsr     Fin
0023DAr 2  A6 46                ldx     BAS_FORPNT
0023DCr 2  A4 47                ldy     BAS_FORPNT+1
0023DEr 2  20 rr rr             jsr     StoreFacAtYxRounded
0023E1r 2                       ; After Fin, ChrGot result must be NUL or ',' (Fin/ChrGot skips spaces).
0023E1r 2  20 rr rr             jsr     ChrGot
0023E4r 2  F0 0E                beq     @afterStore
0023E6r 2  C9 2C                cmp     #','
0023E8r 2  F0 0A                beq     @afterStore
0023EAr 2                       ; Garbage trailing the number -> REDO.
0023EAr 2  68                   pla
0023EBr 2  68                   pla
0023ECr 2  4C rr rr             jmp     @doRedo
0023EFr 2               @inpStr:
0023EFr 2  A2 00                ldx     #0                      ; INPUT stops an unquoted item at ',' only
0023F1r 2  20 rr rr             jsr     BasStrItem
0023F4r 2               @afterStore:
0023F4r 2                       ; Save data ptr; restore program TXTPTR.
0023F4r 2  A5 04                lda     TXTPTR
0023F6r 2  85 3A                sta     BAS_TMP1
0023F8r 2  A5 05                lda     TXTPTR+1
0023FAr 2  85 3B                sta     BAS_TMP1+1
0023FCr 2  68                   pla
0023FDr 2  85 04                sta     TXTPTR
0023FFr 2  68                   pla
002400r 2  85 05                sta     TXTPTR+1
002402r 2                       ; More variables?
002402r 2  20 rr rr             jsr     ChrGot
002405r 2  C9 2C                cmp     #','
002407r 2  D0 06                bne     @doneVars
002409r 2  20 rr rr             jsr     ChrGet                  ; consume ','
00240Cr 2  4C rr rr             jmp     @nextVar
00240Fr 2               @doneVars:
00240Fr 2                       ; Check for un-consumed input (EXTRA IGNORED).
00240Fr 2  A0 00                ldy     #0
002411r 2  B1 3A                lda     (BAS_TMP1),y
002413r 2  F0 12                beq     @inpDone
002415r 2                       ; Skip leading spaces; anything else is "extra".
002415r 2               @chkExtra:
002415r 2  B1 3A                lda     (BAS_TMP1),y
002417r 2  F0 0E                beq     @inpDone
002419r 2  C9 20                cmp     #' '
00241Br 2  D0 03                bne     @hasExtra
00241Dr 2  C8                   iny
00241Er 2  D0 F5                bne     @chkExtra
002420r 2               @hasExtra:
002420r 2  A9 rr                lda     #<MsgExtra
002422r 2  A0 rr                ldy     #>MsgExtra
002424r 2  20 rr rr             jsr     BasPrintStr
002427r 2               @inpDone:
002427r 2  60                   rts
002428r 2               @doRedo:
002428r 2  A9 rr                lda     #<MsgRedo
00242Ar 2  A0 rr                ldy     #>MsgRedo
00242Cr 2  20 rr rr             jsr     BasPrintStr
00242Fr 2  4C rr rr             jmp     @retry
002432r 2               
002432r 2               ; Print "? " prompt (used by INPUT and the ';' prompt-suffix path).
002432r 2               BasInpQues:
002432r 2  A9 3F                lda     #'?'
002434r 2  20 rr rr             jsr     PrintCh
002437r 2  A9 20                lda     #' '
002439r 2  4C rr rr             jmp     PrintCh
00243Cr 2               
00243Cr 2               MsgRedo:
00243Cr 2  3F 52 45 44          .byte   "?REDO FROM START", $0D, $0A, 0
002440r 2  4F 20 46 52  
002444r 2  4F 4D 20 53  
00244Fr 2               MsgExtra:
00244Fr 2  3F 45 58 54          .byte   "?EXTRA IGNORED", $0D, $0A, 0
002453r 2  52 41 20 49  
002457r 2  47 4E 4F 52  
002460r 2               
002460r 2               ; ---------------------------------------------------------------------------
002460r 2               ; Statement: READ var[,var,...] -- pull next DATA item from BAS_DATAPTR
002460r 2               ; into the variable pointed to by PtrGet.
002460r 2               ; ---------------------------------------------------------------------------
002460r 2               ; ---------------------------------------------------------------------------
002460r 2               ; BasStrItem -- read one string item at TXTPTR into the variable BAS_FORPNT
002460r 2               ; points at.  Shared by INPUT and READ, which differ only in what ends an
002460r 2               ; unquoted item: INPUT stops at ',' or NUL, READ also stops at ':' because a
002460r 2               ; DATA statement can be followed by another statement on the same line.
002460r 2               ;
002460r 2               ; On entry : X        = the extra unquoted terminator (StrLt2's CHARAC)
002460r 2               ;            TXTPTR   = first character of the item
002460r 2               ;            FORPNT   = the variable's 3-byte descriptor slot
002460r 2               ; On exit  : TXTPTR advanced past the item, descriptor stored, temp popped.
002460r 2               ; ---------------------------------------------------------------------------
002460r 2               BasStrItem:
002460r 2                       ; A '"' here means quote-mode (terminator '"' or NUL); anything else
002460r 2                       ; is a bare item running to X, ',' or NUL.
002460r 2  A0 00                ldy     #0
002462r 2  B1 04                lda     (TXTPTR),y
002464r 2  C9 22                cmp     #'"'
002466r 2  F0 0C                beq     @quoted
002468r 2  86 44                stx     CHARAC
00246Ar 2  A9 2C                lda     #','
00246Cr 2  85 6A                sta     ENDCHR
00246Er 2  A5 04                lda     TXTPTR                  ; StrLt2's source = TXTPTR
002470r 2  A4 05                ldy     TXTPTR+1
002472r 2  80 0E                bra     @call
002474r 2               @quoted:
002474r 2  85 44                sta     CHARAC                  ; A is still '"' from the compare
002476r 2  85 6A                sta     ENDCHR
002478r 2  18                   clc                             ; skip it: source = TXTPTR + 1
002479r 2  A5 04                lda     TXTPTR
00247Br 2  69 01                adc     #1
00247Dr 2  A4 05                ldy     TXTPTR+1
00247Fr 2  90 01                bcc     @call
002481r 2  C8                   iny
002482r 2               @call:
002482r 2  20 rr rr             jsr     StrLt2
002485r 2                       ; StrLt2 leaves STRNG2 past the text it consumed -- at the terminator
002485r 2                       ; for an unquoted item, just past the closing '"' for a quoted one.
002485r 2                       ; TXTPTR has to follow it: for INPUT so the trailing-extra check sees
002485r 2                       ; only what really remained on the line, and for READ so the next one
002485r 2                       ; doesn't start again in the middle of the item this one took.
002485r 2  A5 1E                lda     STRNG2
002487r 2  85 04                sta     TXTPTR
002489r 2  A5 1F                lda     STRNG2+1
00248Br 2  85 05                sta     TXTPTR+1
00248Dr 2  A0 00                ldy     #0
00248Fr 2  A5 0E                lda     FAC
002491r 2  91 46                sta     (BAS_FORPNT),y
002493r 2  C8                   iny
002494r 2  A5 0F                lda     FAC+1
002496r 2  91 46                sta     (BAS_FORPNT),y
002498r 2  C8                   iny
002499r 2  A5 10                lda     FAC+2
00249Br 2  91 46                sta     (BAS_FORPNT),y
00249Dr 2                       ; StrLt2 pushed a temporary descriptor via PutNew.  The variable owns
00249Dr 2                       ; the heap copy now, so pop the temp -- do NOT use FreFac, which would
00249Dr 2                       ; reclaim the heap we just handed over.  Leaving temps unfreed leaks
00249Dr 2                       ; the 3-slot temp stack, both overflowing it (?FORMULA TOO COMPLEX)
00249Dr 2                       ; and corrupting later strings via stale descriptor pointers.
00249Dr 2  A5 11                lda     FAC+3
00249Fr 2  A4 12                ldy     FAC+4
0024A1r 2  4C rr rr             jmp     FreTms
0024A4r 2               
0024A4r 2               BasCmdRead:
0024A4r 2  AE 1A 03             ldx     BAS_DATAPTR
0024A7r 2  AC 1B 03             ldy     BAS_DATAPTR+1
0024AAr 2  A9 98                lda     #$98                    ; INPUTFLG = $98 means READ mode
0024ACr 2  2C                   .byte   $2C
0024ADr 2               BasInpDoit:
0024ADr 2  A9 00                lda     #0
0024AFr 2  85 69                sta     BAS_INPUTFLG
0024B1r 2  86 3A                stx     BAS_TMP1                ; TMP1 = data pointer
0024B3r 2  84 3B                sty     BAS_TMP1+1
0024B5r 2               @nextVar:
0024B5r 2                       ; TXTPTR currently points into program at variable name.
0024B5r 2  20 rr rr             jsr     PtrGet                  ; advances TXTPTR past var name
0024B8r 2  85 46                sta     BAS_FORPNT
0024BAr 2  84 47                sty     BAS_FORPNT+1
0024BCr 2                       ; Save program TXTPTR on hw stack, switch TXTPTR to data ptr.
0024BCr 2  A5 05                lda     TXTPTR+1
0024BEr 2  48                   pha
0024BFr 2  A5 04                lda     TXTPTR
0024C1r 2  48                   pha
0024C2r 2  A5 3A                lda     BAS_TMP1
0024C4r 2  85 04                sta     TXTPTR
0024C6r 2  A5 3B                lda     BAS_TMP1+1
0024C8r 2  85 05                sta     TXTPTR+1
0024CAr 2  20 rr rr             jsr     ChrGot
0024CDr 2  D0 08                bne     @gotData
0024CFr 2                       ; Out of items on this line - find next DATA.
0024CFr 2  20 rr rr             jsr     BasFindData
0024D2r 2  90 03                bcc     @gotData
0024D4r 2  4C rr rr             jmp     @oodata
0024D7r 2               @gotData:
0024D7r 2                       ; Advance past separator (',' between items, ' ' after DATA token,
0024D7r 2                       ; or quote-delimiter for strings).  ChrGet also skips spaces.
0024D7r 2  20 rr rr             jsr     ChrGet
0024DAr 2                       ; Parse value at TXTPTR (data side).
0024DAr 2  24 64                bit     VALTYP
0024DCr 2  30 0C                bmi     @readStr
0024DEr 2                       ; Numeric.
0024DEr 2  20 rr rr             jsr     Fin
0024E1r 2  A6 46                ldx     BAS_FORPNT
0024E3r 2  A4 47                ldy     BAS_FORPNT+1
0024E5r 2  20 rr rr             jsr     StoreFacAtYxRounded
0024E8r 2  80 05                bra     @afterStore
0024EAr 2               @readStr:
0024EAr 2                       ; Previously this called StrLt2 without setting up its (A,Y) source
0024EAr 2                       ; argument at all, so every DATA string pointed into zero page: an
0024EAr 2                       ; unquoted item read back empty and a quoted one read back as garbage
0024EAr 2                       ; from $0022.  BasStrItem is INPUT's path, which had it right.
0024EAr 2  A2 3A                ldx     #':'                    ; a DATA item also ends at a statement break
0024ECr 2  20 rr rr             jsr     BasStrItem
0024EFr 2               @afterStore:
0024EFr 2                       ; Save updated data ptr.
0024EFr 2  A5 04                lda     TXTPTR
0024F1r 2  85 3A                sta     BAS_TMP1
0024F3r 2  A5 05                lda     TXTPTR+1
0024F5r 2  85 3B                sta     BAS_TMP1+1
0024F7r 2                       ; Restore program TXTPTR.
0024F7r 2  68                   pla
0024F8r 2  85 04                sta     TXTPTR
0024FAr 2  68                   pla
0024FBr 2  85 05                sta     TXTPTR+1
0024FDr 2                       ; If next program byte is ',', another variable follows.
0024FDr 2  20 rr rr             jsr     ChrGot
002500r 2  C9 2C                cmp     #','
002502r 2  D0 05                bne     @done
002504r 2  20 rr rr             jsr     ChrGet
002507r 2  80 AC                bra     @nextVar
002509r 2               @done:
002509r 2                       ; Persist data ptr.
002509r 2  A5 3A                lda     BAS_TMP1
00250Br 2  8D 1A 03             sta     BAS_DATAPTR
00250Er 2  A5 3B                lda     BAS_TMP1+1
002510r 2  8D 1B 03             sta     BAS_DATAPTR+1
002513r 2  60                   rts
002514r 2               @oodata:
002514r 2  A2 0E                ldx     #ERR_OD
002516r 2  4C rr rr             jmp     BasErrorVec
002519r 2               
002519r 2               ; ---------------------------------------------------------------------------
002519r 2               ; BasFindData -- starting from TXTPTR (positioned somewhere within a line's
002519r 2               ; payload), advance to the byte after the next DATA token in the program.
002519r 2               ; Returns carry SET on out-of-data, carry CLEAR with TXTPTR at first byte
002519r 2               ; AFTER the DATA token (i.e. at the first DATA item).
002519r 2               ; ---------------------------------------------------------------------------
002519r 2               BasFindData:
002519r 2               @scanByte:
002519r 2  A0 00                ldy     #0
00251Br 2  B1 04                lda     (TXTPTR),y
00251Dr 2  F0 1F                beq     @atEnd
00251Fr 2  C9 83                cmp     #TOK_DATA
002521r 2  F0 2E                beq     @found
002523r 2  C9 22                cmp     #'"'
002525r 2  D0 12                bne     @advance1
002527r 2                       ; Skip quoted string (advance TXTPTR past closing quote or NUL).
002527r 2  20 rr rr             jsr     @incTxt
00252Ar 2               @inStr:
00252Ar 2  A0 00                ldy     #0
00252Cr 2  B1 04                lda     (TXTPTR),y
00252Er 2  F0 0E                beq     @atEnd
002530r 2  20 rr rr             jsr     @incTxt
002533r 2  C9 22                cmp     #'"'
002535r 2  D0 F3                bne     @inStr
002537r 2  80 E0                bra     @scanByte
002539r 2               @advance1:
002539r 2  20 rr rr             jsr     @incTxt
00253Cr 2  80 DB                bra     @scanByte
00253Er 2               @atEnd:
00253Er 2                       ; (TXTPTR) is on the line's $00 terminator.  Bytes immediately after
00253Er 2                       ; are the next line's [next-lo][next-hi][num-lo][num-hi][payload..].
00253Er 2                       ; Check next-pointer at offset +2 (next-hi); if 0, end of program.
00253Er 2  A0 02                ldy     #2
002540r 2  B1 04                lda     (TXTPTR),y
002542r 2  F0 0F                beq     @oodata
002544r 2                       ; Advance TXTPTR by 5: past terminator (1) + line header (4).
002544r 2  18                   clc
002545r 2  A5 04                lda     TXTPTR
002547r 2  69 05                adc     #5
002549r 2  85 04                sta     TXTPTR
00254Br 2  90 CC                bcc     @scanByte
00254Dr 2  E6 05                inc     TXTPTR+1
00254Fr 2  80 C8                bra     @scanByte
002551r 2               @found:
002551r 2                       ; TXTPTR is left AT the TOK_DATA byte; caller's CHRGET advances past.
002551r 2  18                   clc
002552r 2  60                   rts
002553r 2               @oodata:
002553r 2  38                   sec
002554r 2  60                   rts
002555r 2               @incTxt:
002555r 2  E6 04                inc     TXTPTR
002557r 2  D0 02                bne     @r
002559r 2  E6 05                inc     TXTPTR+1
00255Br 2               @r:
00255Br 2  60                   rts
00255Cr 2               
00255Cr 2               ; ---------------------------------------------------------------------------
00255Cr 2               ; Statement: FOR var = expr1 TO expr2 [STEP expr3]
00255Cr 2               ; Pushes 18-byte frame on CPU stack:
00255Cr 2               ;   [tag $81][VAR-lo][VAR-hi][STEP-FP (5)][STEP-sign][CURLIN-lo][CURLIN-hi]
00255Cr 2               ;   [TXTPTR-lo][TXTPTR-hi][LIMIT-FP (5)]
00255Cr 2               ; ---------------------------------------------------------------------------
00255Cr 2               BasCmdFor:
00255Cr 2                       ; Set SUBFLG so PtrGet doesn't recurse on FN.
00255Cr 2  A9 80                lda     #$80
00255Er 2  85 68                sta     SUBFLG
002560r 2  20 rr rr             jsr     BasCmdLet               ; consumes "var = expr"
002563r 2                       ; PtrGet (inside LET) saved VARPNT in FORPNT (hopefully). Re-fetch
002563r 2                       ; FORPNT from the assignment, but BasCmdLet doesn't set FORPNT in
002563r 2                       ; our impl.  Re-parse the variable name by rewinding TXTPTR via
002563r 2                       ; CURLIN scan.  Cheat: BasCmdLet leaves VARPNT current.
002563r 2  A5 3F                lda     VARPNT
002565r 2  85 46                sta     BAS_FORPNT
002567r 2  A5 40                lda     VARPNT+1
002569r 2  85 47                sta     BAS_FORPNT+1
00256Br 2                       ; Discard any prior FOR frame for the same variable to avoid leak.
00256Br 2  20 rr rr             jsr     GtForPnt
00256Er 2  90 00                bcc     @noOld                  ; carry clear -> no matching frame
002570r 2                       ; The prior-frame pop is still skipped: the runtime tolerates one stray
002570r 2                       ; frame, and msbasic re-uses the slot only when an explicit FOR with a
002570r 2                       ; matching variable already exists, which is rare. GtForPnt does now
002570r 2                       ; report found/not-found in carry (Z was ambiguous and unusable), so
002570r 2                       ; this branch is at least honest about which case it is in.
002570r 2               @noOld:
002570r 2                       ; Discard our caller's (BasExecuteStatement's) return address so
002570r 2                       ; that the FOR frame sits on the stack with no other junk above it.
002570r 2                       ; We will JMP BasNewstt at the end instead of RTSing.
002570r 2  68                   pla
002571r 2  68                   pla
002572r 2                       ; Push limit (will be parsed below) -- we lay out the frame as:
002572r 2                       ;   pushed first (deepest): TXTPTR, CURLIN, LIMIT (5), STEP-sign,
002572r 2                       ;   STEP (5), VAR-addr, $81-tag.
002572r 2                       ; We don't know LIMIT/STEP yet; we push placeholders and patch.
002572r 2                       ; Easier: parse limit & step first, then push frame in one go.
002572r 2  A9 9C                lda     #TOK_TO
002574r 2  20 rr rr             jsr     SynChr
002577r 2  20 rr rr             jsr     FrmNum
00257Ar 2                       ; Strip sign info on limit (msbasic stores limit unsigned-magnitude
00257Ar 2                       ; with sign packed).  Pack FACSIGN bit 7 -> FAC+1 bit 7.
00257Ar 2  A5 13                lda     FACSIGN
00257Cr 2  09 7F                ora     #$7F
00257Er 2  25 0F                and     FAC+1
002580r 2  85 0F                sta     FAC+1
002582r 2                       ; Save LIMIT temporarily in BAS_TEMP1..+4 (5 bytes).
002582r 2  A2 04                ldx     #4
002584r 2               @saveLimit:
002584r 2  B5 0E                lda     FAC,x
002586r 2  95 4D                sta     BAS_TEMP1,x
002588r 2  CA                   dex
002589r 2  10 F9                bpl     @saveLimit
00258Br 2                       ; STEP: default 1, or evaluate after TOK_STEP.
00258Br 2  20 rr rr             jsr     ChrGot
00258Er 2  C9 A1                cmp     #TOK_STEP
002590r 2  D0 08                bne     @defStep
002592r 2  20 rr rr             jsr     ChrGet
002595r 2  20 rr rr             jsr     FrmNum
002598r 2  80 07                bra     @gotStep
00259Ar 2               @defStep:
00259Ar 2  A9 rr                lda     #<ConstOne
00259Cr 2  A0 rr                ldy     #>ConstOne
00259Er 2  20 rr rr             jsr     LoadFacFromYa
0025A1r 2               @gotStep:
0025A1r 2  20 rr rr             jsr     Sign                    ; A = step sign byte (-1/0/1)
0025A4r 2  85 52                sta     BAS_TEMP2               ; stash step sign
0025A6r 2                       ; Pack sign of FAC into FAC+1 bit7 then save STEP into BAS_TEMP2+1..+5.
0025A6r 2  A5 13                lda     FACSIGN
0025A8r 2  09 7F                ora     #$7F
0025AAr 2  25 0F                and     FAC+1
0025ACr 2  85 0F                sta     FAC+1
0025AEr 2  A2 04                ldx     #4
0025B0r 2               @saveStep:
0025B0r 2  B5 0E                lda     FAC,x
0025B2r 2  95 53                sta     BAS_TEMP2+1,x
0025B4r 2  CA                   dex
0025B5r 2  10 F9                bpl     @saveStep
0025B7r 2                       ; Now push the frame on stack (deepest first):
0025B7r 2                       ;   TXTPTR-hi, TXTPTR-lo, CURLIN-hi, CURLIN-lo,
0025B7r 2                       ;   LIMIT[4..0]   (deepest=LIMIT[4], so LIMIT[0] ends at $010A,x),
0025B7r 2                       ;   STEP-sign,
0025B7r 2                       ;   STEP[4..0]    (deepest=STEP[4], so STEP[0]  ends at $0104,x),
0025B7r 2                       ;   VAR-hi, VAR-lo, $81
0025B7r 2  A5 05                lda     TXTPTR+1
0025B9r 2  48                   pha
0025BAr 2  A5 04                lda     TXTPTR
0025BCr 2  48                   pha
0025BDr 2  AD 6A 03             lda     BAS_CURLIN+1
0025C0r 2  48                   pha
0025C1r 2  AD 69 03             lda     BAS_CURLIN
0025C4r 2  48                   pha
0025C5r 2  A2 04                ldx     #4
0025C7r 2               @pushLim:
0025C7r 2  B5 4D                lda     BAS_TEMP1,x
0025C9r 2  48                   pha
0025CAr 2  CA                   dex
0025CBr 2  10 FA                bpl     @pushLim
0025CDr 2  A5 52                lda     BAS_TEMP2               ; step sign
0025CFr 2  48                   pha
0025D0r 2  A2 05                ldx     #5
0025D2r 2               @pushStep:
0025D2r 2  B5 52                lda     BAS_TEMP2,x
0025D4r 2  48                   pha
0025D5r 2  CA                   dex
0025D6r 2  D0 FA                bne     @pushStep
0025D8r 2  A5 47                lda     BAS_FORPNT+1
0025DAr 2  48                   pha
0025DBr 2  A5 46                lda     BAS_FORPNT
0025DDr 2  48                   pha
0025DEr 2  A9 81                lda     #TOK_FOR
0025E0r 2  48                   pha
0025E1r 2  4C rr rr             jmp     BasNewstt               ; resume statement loop with frame in place
0025E4r 2               
0025E4r 2               ConstOne:
0025E4r 2  81 00 00 00          .byte   $81,$00,$00,$00,$00     ; FP +1.0
0025E8r 2  00           
0025E9r 2               
0025E9r 2               ; ---------------------------------------------------------------------------
0025E9r 2               ; Statement: NEXT [var]
0025E9r 2               ; Locate matching FOR frame, increment var by step, test against limit,
0025E9r 2               ; loop back if more iterations remain, else discard frame and continue.
0025E9r 2               ; ---------------------------------------------------------------------------
0025E9r 2               BasCmdNext:
0025E9r 2  20 rr rr             jsr     ChrGot
0025ECr 2  F0 0D                beq     @anyVar
0025EEr 2  C9 3A                cmp     #':'
0025F0r 2  F0 09                beq     @anyVar
0025F2r 2  20 rr rr             jsr     PtrGet
0025F5r 2  85 46                sta     BAS_FORPNT
0025F7r 2  84 47                sty     BAS_FORPNT+1
0025F9r 2  80 06                bra     @find
0025FBr 2               @anyVar:
0025FBr 2                       ; "NEXT" without a variable: set FORPNT = 0 so GtForPnt copies the
0025FBr 2                       ; stack-frame's var address into FORPNT and then trivially matches
0025FBr 2                       ; (any FOR frame is acceptable).
0025FBr 2  A9 00                lda     #0
0025FDr 2  85 46                sta     BAS_FORPNT
0025FFr 2  85 47                sta     BAS_FORPNT+1
002601r 2               @find:
002601r 2                       ; Carry, not Z: GtForPnt's not-found paths end in `lda #0`, which sets
002601r 2                       ; Z, so testing `beq` here read "no frame" as "found" -- a bare NEXT
002601r 2                       ; then did `txs` onto a garbage offset and died as ?SYNTAX ERROR IN 0
002601r 2                       ; instead of ?NEXT WITHOUT FOR.
002601r 2  20 rr rr             jsr     GtForPnt
002604r 2  B0 05                bcs     @found
002606r 2  A2 0D                ldx     #ERR_NF
002608r 2  4C rr rr             jmp     BasErrorVec
00260Br 2               @found:
00260Br 2                       ; X = stack offset of (tag - 1).  txs makes SP = X so the frame
00260Br 2                       ; sits at $101+X..$112+X.  All subsequent accesses use $0101+offset,x
00260Br 2                       ; just like msbasic.
00260Br 2  9A                   txs
00260Cr 2                       ; Frame layout (tag at $0101+X):
00260Cr 2                       ;   $0101+X = $81 tag
00260Cr 2                       ;   $0102+X = VAR-lo
00260Cr 2                       ;   $0103+X = VAR-hi
00260Cr 2                       ;   $0104+X..$0108+X = STEP (5 bytes FP, FAC[0..4] ascending)
00260Cr 2                       ;   $0109+X = STEP-sign
00260Cr 2                       ;   $010A+X..$010E+X = LIMIT (5 bytes FP, FAC[0..4] ascending)
00260Cr 2                       ;   $010F+X = CURLIN-lo
00260Cr 2                       ;   $0110+X = CURLIN-hi
00260Cr 2                       ;   $0111+X = TXTPTR-lo
00260Cr 2                       ;   $0112+X = TXTPTR-hi
00260Cr 2                       ; Load STEP into FAC.
00260Cr 2  A9 01                lda     #$01
00260Er 2  85 3B                sta     BAS_TMP1+1
002610r 2  8A                   txa
002611r 2  18                   clc
002612r 2  69 04                adc     #$04
002614r 2  85 3A                sta     BAS_TMP1                ; TMP1 -> STEP[0] at $0104,x
002616r 2  A5 3A                lda     BAS_TMP1
002618r 2  A4 3B                ldy     BAS_TMP1+1
00261Ar 2  20 rr rr             jsr     LoadFacFromYa
00261Dr 2                       ; FACSIGN := step sign byte at $0109,x.
00261Dr 2  BD 09 01             lda     $0109,x
002620r 2  85 13                sta     FACSIGN
002622r 2                       ; FAC += variable.
002622r 2  BD 02 01             lda     $0102,x
002625r 2  BC 03 01             ldy     $0103,x
002628r 2  85 46                sta     BAS_FORPNT
00262Ar 2  84 47                sty     BAS_FORPNT+1
00262Cr 2  20 rr rr             jsr     FAdd
00262Fr 2  20 rr rr             jsr     SetFor
002632r 2                       ; Compare FAC with LIMIT (at $010A,x).
002632r 2  BA                   tsx                             ; reload x (FAdd may have used it)
002633r 2  8A                   txa
002634r 2  18                   clc
002635r 2  69 0A                adc     #$0A
002637r 2  85 3A                sta     BAS_TMP1
002639r 2  A9 01                lda     #$01
00263Br 2  85 3B                sta     BAS_TMP1+1
00263Dr 2  A5 3A                lda     BAS_TMP1
00263Fr 2  A4 3B                ldy     BAS_TMP1+1
002641r 2  20 rr rr             jsr     FComp
002644r 2  BA                   tsx
002645r 2  38                   sec
002646r 2  FD 09 01             sbc     $0109,x                 ; A - step-sign
002649r 2  F0 19                beq     @loopDone
00264Br 2                       ; Continue: restore CURLIN/TXTPTR from frame, JMP NEWSTT (don't RTS).
00264Br 2  BD 0F 01             lda     $010F,x
00264Er 2  8D 69 03             sta     BAS_CURLIN
002651r 2  BD 10 01             lda     $0110,x
002654r 2  8D 6A 03             sta     BAS_CURLIN+1
002657r 2  BD 11 01             lda     $0111,x
00265Ar 2  85 04                sta     TXTPTR
00265Cr 2  BD 12 01             lda     $0112,x
00265Fr 2  85 05                sta     TXTPTR+1
002661r 2  4C rr rr             jmp     BasNewstt
002664r 2               @loopDone:
002664r 2                       ; Discard frame: SP := X + 18.
002664r 2  8A                   txa
002665r 2  18                   clc
002666r 2  69 12                adc     #18
002668r 2  AA                   tax
002669r 2  9A                   txs
00266Ar 2                       ; Allow ", var" to chain into another NEXT.
00266Ar 2  20 rr rr             jsr     ChrGot
00266Dr 2  C9 2C                cmp     #','
00266Fr 2  D0 06                bne     @retNewstt
002671r 2  20 rr rr             jsr     ChrGet
002674r 2  4C rr rr             jmp     BasCmdNext
002677r 2               @retNewstt:
002677r 2  4C rr rr             jmp     BasNewstt
00267Ar 2               
00267Ar 2               ; ---------------------------------------------------------------------------
00267Ar 2               ; Statement: DEF FN A(X) = expr
00267Ar 2               ; Stored in the variable's 5 value bytes:
00267Ar 2               ;   [TXTPTR-of-expr-lo][TXTPTR-of-expr-hi][param-name-lo][param-name-hi][0]
00267Ar 2               ; ---------------------------------------------------------------------------
00267Ar 2               BasCmdDef:
00267Ar 2                       ; Expect: FN <name>(<param>) = <expr>
00267Ar 2  A9 9D                lda     #TOK_FN
00267Cr 2  20 rr rr             jsr     SynChr
00267Fr 2  09 80                ora     #$80
002681r 2  85 68                sta     SUBFLG                  ; tell PtrGet "this is a DEF FN var"
002683r 2  20 rr rr             jsr     PtrGet
002686r 2                       ; VARPNT = address of FN var slot.
002686r 2  85 81                sta     BAS_FNCNAM
002688r 2  84 82                sty     BAS_FNCNAM+1
00268Ar 2  20 rr rr             jsr     ChkNum
00268Dr 2                       ; Expect '(' name ')' = expr
00268Dr 2                       ; Param name parsed by recursive PtrGet inside FrmEvl on call;
00268Dr 2                       ; here we just record (param-name) by parsing it ourselves.
00268Dr 2  A9 28                lda     #'('
00268Fr 2  20 rr rr             jsr     SynChr
002692r 2  A9 80                lda     #$80
002694r 2  85 68                sta     SUBFLG
002696r 2  20 rr rr             jsr     PtrGet
002699r 2                       ; VARPNT = param var addr.  Save it.
002699r 2  A5 3F                lda     VARPNT
00269Br 2  85 3A                sta     BAS_TMP1
00269Dr 2  A5 40                lda     VARPNT+1
00269Fr 2  85 3B                sta     BAS_TMP1+1
0026A1r 2  20 rr rr             jsr     ChkNum
0026A4r 2  A9 29                lda     #')'
0026A6r 2  20 rr rr             jsr     SynChr
0026A9r 2  A9 3D                lda     #'='
0026ABr 2  20 rr rr             jsr     SynChr
0026AEr 2                       ; Reject in direct mode.
0026AEr 2  AD 6A 03             lda     BAS_CURLIN+1
0026B1r 2  C9 FF                cmp     #$FF
0026B3r 2  D0 05                bne     @ok
0026B5r 2  A2 07                ldx     #ERR_ILLDIRECT
0026B7r 2  4C rr rr             jmp     BasErrorVec
0026BAr 2               @ok:
0026BAr 2                       ; Store [TXTPTR][param][0] in FN var.
0026BAr 2  A0 00                ldy     #0
0026BCr 2  A5 04                lda     TXTPTR
0026BEr 2  91 81                sta     (BAS_FNCNAM),y
0026C0r 2  C8                   iny
0026C1r 2  A5 05                lda     TXTPTR+1
0026C3r 2  91 81                sta     (BAS_FNCNAM),y
0026C5r 2  C8                   iny
0026C6r 2  A5 3A                lda     BAS_TMP1
0026C8r 2  91 81                sta     (BAS_FNCNAM),y
0026CAr 2  C8                   iny
0026CBr 2  A5 3B                lda     BAS_TMP1+1
0026CDr 2  91 81                sta     (BAS_FNCNAM),y
0026CFr 2  C8                   iny
0026D0r 2  A9 00                lda     #0
0026D2r 2  91 81                sta     (BAS_FNCNAM),y
0026D4r 2                       ; Skip past expression body.
0026D4r 2  20 rr rr             jsr     BasDatan
0026D7r 2  4C rr rr             jmp     BasAddon
0026DAr 2               
0026DAr 2               ; ---------------------------------------------------------------------------
0026DAr 2               ; FnCall -- evaluator-side handler for "FN A(expr)".
0026DAr 2               ; Called by FrmEvl when it sees TOK_FN.  Evaluates argument, swaps in the
0026DAr 2               ; param's stored value, executes the FN expression, and restores the param.
0026DAr 2               ; ---------------------------------------------------------------------------
0026DAr 2               FnCall:
0026DAr 2  20 rr rr             jsr     ChrGet                  ; consume FN
0026DDr 2  09 80                ora     #$80
0026DFr 2  85 68                sta     SUBFLG
0026E1r 2  20 rr rr             jsr     PtrGet                  ; locate FN var
0026E4r 2  8D 73 03             sta     BAS_FNPTR               ; durable copy: FNCNAM lives in ZP and
0026E7r 2  8C 74 03             sty     BAS_FNPTR+1             ; is scratch for Garbag
0026EAr 2  85 81                sta     BAS_FNCNAM
0026ECr 2  84 82                sty     BAS_FNCNAM+1
0026EEr 2  20 rr rr             jsr     ChkNum
0026F1r 2                       ; Read param ptr from FN slot.
0026F1r 2  A0 02                ldy     #2
0026F3r 2  B1 81                lda     (BAS_FNCNAM),y
0026F5r 2  85 3F                sta     VARPNT
0026F7r 2  F0 57                beq     @undef
0026F9r 2  C8                   iny
0026FAr 2  B1 81                lda     (BAS_FNCNAM),y
0026FCr 2  85 40                sta     VARPNT+1
0026FEr 2                       ; Evaluate '(arg)'
0026FEr 2  A9 28                lda     #'('
002700r 2  20 rr rr             jsr     SynChr
002703r 2                       ; Save param's current FP value (5 bytes) on stack.
002703r 2  A0 04                ldy     #4
002705r 2               @savep:
002705r 2  B1 3F                lda     (VARPNT),y
002707r 2  48                   pha
002708r 2  88                   dey
002709r 2  10 FA                bpl     @savep
00270Br 2                       ; Evaluate argument -> FAC.
00270Br 2  20 rr rr             jsr     FrmNum
00270Er 2  A9 29                lda     #')'
002710r 2  20 rr rr             jsr     SynChr
002713r 2                       ; Any variable reference in the argument re-pointed VARPNT (and Garbag
002713r 2                       ; may have eaten FNCNAM) — reload both before storing the argument.
002713r 2  20 rr rr             jsr     @reload
002716r 2                       ; Store FAC into param slot.
002716r 2  A6 3F                ldx     VARPNT
002718r 2  A4 40                ldy     VARPNT+1
00271Ar 2  20 rr rr             jsr     StoreFacAtYxRounded
00271Dr 2                       ; Save current TXTPTR.
00271Dr 2  A5 05                lda     TXTPTR+1
00271Fr 2  48                   pha
002720r 2  A5 04                lda     TXTPTR
002722r 2  48                   pha
002723r 2                       ; Switch TXTPTR to FN expression body.
002723r 2  A0 00                ldy     #0
002725r 2  B1 81                lda     (BAS_FNCNAM),y
002727r 2  85 04                sta     TXTPTR
002729r 2  C8                   iny
00272Ar 2  B1 81                lda     (BAS_FNCNAM),y
00272Cr 2  85 05                sta     TXTPTR+1
00272Er 2                       ; Body TXTPTR is positioned at the first byte; we need it positioned
00272Er 2                       ; one BEFORE so FrmNum's first ChrGet loads the first byte.  Decrement.
00272Er 2  A5 04                lda     TXTPTR
002730r 2  D0 02                bne     @noBor
002732r 2  C6 05                dec     TXTPTR+1
002734r 2               @noBor:
002734r 2  C6 04                dec     TXTPTR
002736r 2                       ; Evaluate the FN expression body.
002736r 2  20 rr rr             jsr     ChrGet
002739r 2  20 rr rr             jsr     FrmNum
00273Cr 2                       ; Restore TXTPTR.
00273Cr 2  68                   pla
00273Dr 2  85 04                sta     TXTPTR
00273Fr 2  68                   pla
002740r 2  85 05                sta     TXTPTR+1
002742r 2                       ; Restore param.  VARPNT may have been clobbered; reload.
002742r 2  20 rr rr             jsr     @reload
002745r 2  A0 00                ldy     #0
002747r 2               @restp:
002747r 2  68                   pla
002748r 2  91 3F                sta     (VARPNT),y
00274Ar 2  C8                   iny
00274Br 2  C0 05                cpy     #5
00274Dr 2  D0 F8                bne     @restp
00274Fr 2  60                   rts
002750r 2               @undef:
002750r 2  A2 03                ldx     #ERR_UNDEFSTMT
002752r 2  4C rr rr             jmp     BasErrorVec
002755r 2               ; Re-seed FNCNAM from BAS_FNPTR and VARPNT from the FN slot's param pointer.
002755r 2               ; Preserves FAC (touches A and Y only).
002755r 2               @reload:
002755r 2  AD 73 03             lda     BAS_FNPTR
002758r 2  85 81                sta     BAS_FNCNAM
00275Ar 2  AD 74 03             lda     BAS_FNPTR+1
00275Dr 2  85 82                sta     BAS_FNCNAM+1
00275Fr 2  A0 02                ldy     #2
002761r 2  B1 81                lda     (BAS_FNCNAM),y
002763r 2  85 3F                sta     VARPNT
002765r 2  C8                   iny
002766r 2  B1 81                lda     (BAS_FNCNAM),y
002768r 2  85 40                sta     VARPNT+1
00276Ar 2  60                   rts
00276Br 2               
00276Br 2               ; ---------------------------------------------------------------------------
00276Br 2               ; BasCmdDim -- DIM statement.  Dimension one or more arrays.
00276Br 2               ;   On entry ChrGet has advanced past the DIM token, so A = first char of the
00276Br 2               ;   first variable name.  For each name we call PtrGet2 with the from-DIM flag
00276Br 2               ;   ($40) set in X; the '(' branch runs Array -> MakeNewArray, which allocates
00276Br 2               ;   the array using the subscripts as sizes (0..N) and returns without looking
00276Br 2               ;   up an element (DIMFLG nonzero).  Names are separated by commas.
00276Br 2               ; ---------------------------------------------------------------------------
00276Br 2               BasCmdDim:
00276Br 2  A2 40                ldx     #$40                    ; from-DIM flag (bit 6)
00276Dr 2  20 rr rr             jsr     PtrGet2                 ; A = name char; create/dimension array
002770r 2  20 rr rr             jsr     ChrGot
002773r 2  C9 2C                cmp     #','
002775r 2  D0 05                bne     @done
002777r 2  20 rr rr             jsr     ChrGet                  ; consume comma, advance to next name
00277Ar 2  80 EF                bra     BasCmdDim
00277Cr 2               @done:
00277Cr 2  60                   rts
00277Dr 2               
00277Dr 2               ; ===========================================================================
00277Dr 2               ;   H A R D W A R E - E X T E N S I O N   S T A T E M E N T S
00277Dr 2               ; ===========================================================================
00277Dr 2               
00277Dr 2               ; --- Helpers --------------------------------------------------------------
00277Dr 2               
00277Dr 2               ; Raise ?NO DEVICE error.
00277Dr 2               NoDevErr:
00277Dr 2  A2 0F                ldx     #ERR_NODEV
00277Fr 2  4C rr rr             jmp     BasErrorVec
002782r 2               
002782r 2               ; Require A bits in HW_PRESENT (else ?NO DEVICE).
002782r 2               ;   Input : A = mask
002782r 2               ;   Output: A preserved on success
002782r 2               ReqHw:
002782r 2  2D 0D 03             and     HW_PRESENT
002785r 2  F0 F6                beq     NoDevErr
002787r 2  60                   rts
002788r 2               
002788r 2               ; Evaluate expression -> A in 0..255.
002788r 2               ;   On entry: ChrGot positioned at first byte of expression.
002788r 2               ;   On exit : A = byte, ChrGot returns char following expression.
002788r 2               EvalU8:
002788r 2  20 rr rr             jsr     GetByt                  ; X = byte, jmp ChrGot
00278Br 2  8A                   txa
00278Cr 2  60                   rts
00278Dr 2               
00278Dr 2               ; Evaluate expression as 16-bit signed -> FAC+3 (hi), FAC+4 (lo).
00278Dr 2               EvalU16:
00278Dr 2  20 rr rr             jsr     FrmNum
002790r 2  20 rr rr             jsr     AyInt
002793r 2  4C rr rr             jmp     ChrGot
002796r 2               
002796r 2               ; Evaluate expression as 16-bit unsigned address (0..65535)
002796r 2               ;   -> FAC+3 (hi), FAC+4 (lo).  Used by SYS, POKE, PEEK, WAIT so the full
002796r 2               ;   6502 address space is reachable with positive decimal literals.
002796r 2               ;   Truncates fractional part.  Negative or >= 65536 raises ?ILLEGAL QUANTITY.
002796r 2               EvalAddrU16:
002796r 2  20 rr rr             jsr     FrmNum
002799r 2  20 rr rr             jsr     FacToU16
00279Cr 2  4C rr rr             jmp     ChrGot
00279Fr 2               
00279Fr 2               ; FacToU16 -- Convert FAC (must be 0..65535) to FAC+3 (hi), FAC+4 (lo).
00279Fr 2               ;   Negative or >= 65536 raises ?ILLEGAL QUANTITY.  Truncates fractional part.
00279Fr 2               FacToU16:
00279Fr 2  24 13                bit     FACSIGN
0027A1r 2  30 34                bmi     @illqty
0027A3r 2  A5 0E                lda     FAC                     ; exponent byte (0 = value is zero)
0027A5r 2  F0 2B                beq     @zero
0027A7r 2  C9 91                cmp     #$91                    ; exp >= $91 means value >= 65536
0027A9r 2  B0 2C                bcs     @illqty
0027ABr 2                       ; Reconstruct top 16 bits of mantissa (with hidden 1 bit).
0027ABr 2  48                   pha                             ; save exponent byte
0027ACr 2  A5 0F                lda     FAC+1
0027AEr 2  09 80                ora     #$80                    ; restore hidden bit
0027B0r 2  85 3B                sta     BAS_TMP1+1              ; hi
0027B2r 2  A5 10                lda     FAC+2
0027B4r 2  85 3A                sta     BAS_TMP1                ; lo
0027B6r 2                       ; Shift count = $90 - exp_byte (0..15).
0027B6r 2  68                   pla
0027B7r 2  38                   sec
0027B8r 2  E9 90                sbc     #$90
0027BAr 2  49 FF                eor     #$FF
0027BCr 2  18                   clc
0027BDr 2  69 01                adc     #1                      ; A = $90 - exp
0027BFr 2  F0 08                beq     @store                  ; zero shifts: already aligned
0027C1r 2  AA                   tax
0027C2r 2               @shloop:
0027C2r 2  46 3B                lsr     BAS_TMP1+1
0027C4r 2  66 3A                ror     BAS_TMP1
0027C6r 2  CA                   dex
0027C7r 2  D0 F9                bne     @shloop
0027C9r 2               @store:
0027C9r 2  A5 3B                lda     BAS_TMP1+1
0027CBr 2  85 11                sta     FAC+3
0027CDr 2  A5 3A                lda     BAS_TMP1
0027CFr 2  85 12                sta     FAC+4
0027D1r 2  60                   rts
0027D2r 2               @zero:
0027D2r 2  64 11                stz     FAC+3
0027D4r 2  64 12                stz     FAC+4
0027D6r 2  60                   rts
0027D7r 2               @illqty:
0027D7r 2  4C rr rr             jmp     IqErr
0027DAr 2               
0027DAr 2               ; Evaluate string expression -> copy up to 12 chars to BAS_FNAME,
0027DAr 2               ; null-terminate, set STR_PTR := BAS_FNAME, free temp string.
0027DAr 2               ; 12 = full 8.3 form ("NAME.EXT" = 8 name + '.' + 3 ext).
0027DAr 2               EvalString:
0027DAr 2  20 rr rr             jsr     FrmEvl
0027DDr 2  20 rr rr             jsr     ChkStr
0027E0r 2  A5 0F                lda     FAC+1
0027E2r 2  85 20                sta     INDEX
0027E4r 2  A5 10                lda     FAC+2
0027E6r 2  85 21                sta     INDEX+1
0027E8r 2  A0 00                ldy     #0
0027EAr 2  A6 0E                ldx     FAC                     ; length
0027ECr 2               @cpy:
0027ECr 2  C0 0C                cpy     #12
0027EEr 2  F0 0D                beq     @done
0027F0r 2  E0 00                cpx     #0
0027F2r 2  F0 09                beq     @done
0027F4r 2  B1 20                lda     (INDEX),y
0027F6r 2  99 81 03             sta     BAS_FNAME,y
0027F9r 2  C8                   iny
0027FAr 2  CA                   dex
0027FBr 2  80 EF                bra     @cpy
0027FDr 2               @done:
0027FDr 2  A9 00                lda     #0
0027FFr 2  99 81 03             sta     BAS_FNAME,y
002802r 2  A9 81                lda     #<BAS_FNAME
002804r 2  85 02                sta     STR_PTR
002806r 2  A9 03                lda     #>BAS_FNAME
002808r 2  85 03                sta     STR_PTR+1
00280Ar 2  4C rr rr             jmp     FreFac
00280Dr 2               
00280Dr 2               ; Print A as 2-digit decimal with leading zero (used by TIME/DATE).
00280Dr 2               BasPr2D:
00280Dr 2  A2 00                ldx     #0
00280Fr 2               @loop:
00280Fr 2  C9 0A                cmp     #10
002811r 2  90 05                bcc     @done
002813r 2  E9 0A                sbc     #10
002815r 2  E8                   inx
002816r 2  80 F7                bra     @loop
002818r 2               @done:
002818r 2  48                   pha
002819r 2  8A                   txa
00281Ar 2  09 30                ora     #'0'
00281Cr 2  20 rr rr             jsr     Chrout
00281Fr 2  68                   pla
002820r 2  09 30                ora     #'0'
002822r 2  4C rr rr             jmp     Chrout
002825r 2               
002825r 2               ; BasFixChain -- recompute end-of-program pointers after a program image load.
002825r 2               ; A program image is the raw bytes belonging at $0800 up: a tokenized line chain
002825r 2               ; and, for a .prg, machine code sitting past the chain's $0000 terminator.  A
002825r 2               ; chain walk alone only ever finds the end of the BASIC part, so the loader's
002825r 2               ; byte count has to be taken into account too.
002825r 2               ;   Input:  A = loaded image size lo, Y = size hi (0 = size unknown; chain only)
002825r 2               ;   Output: BAS_VARTAB = BAS_ARYTAB = BAS_STREND
002825r 2               ;             = max(chain-end + 2, PROGRAM_START + size)
002825r 2               ;   Note:   a size that would push the result past BAS_MEMSIZ is rejected and the
002825r 2               ;           chain-end candidate is used instead.
002825r 2               ; Mirroring VARTAB into ARYTAB/STREND matters on its own: Makenewvariable places
002825r 2               ; a new scalar at ARYTAB, so leaving it at its post-NEW $0802 makes the first
002825r 2               ; direct-mode assignment after a LOAD overwrite the program's first line.
002825r 2                       .assert (PROGRAM_START & $FF) = 0, error, "PROGRAM_START must be page-aligned"
002825r 2               BasFixChain:
002825r 2  85 3C                sta     BAS_TMP2                ; BAS_TMP2 = PROGRAM_START + size; the
002827r 2  98                   tya                             ; low byte passes through untouched
002828r 2  18                   clc                             ; because PROGRAM_START is page-aligned
002829r 2  69 08                adc     #>PROGRAM_START
00282Br 2  85 3D                sta     BAS_TMP2+1
00282Dr 2  64 20                stz     INDEX
00282Fr 2  A9 08                lda     #>PROGRAM_START
002831r 2  85 21                sta     INDEX+1
002833r 2               @walk:
002833r 2  A0 01                ldy     #1
002835r 2  B1 20                lda     (INDEX),y               ; next-ptr hi
002837r 2  85 3A                sta     BAS_TMP1
002839r 2  88                   dey
00283Ar 2  11 20                ora     (INDEX),y               ; both bytes zero -> terminator
00283Cr 2  F0 15                beq     @end
00283Er 2                       ; Lines ascend in memory.  LOAD accepts any file, so a corrupt or
00283Er 2                       ; cyclic chain is reachable here — stop at the last good line rather
00283Er 2                       ; than loop forever.
00283Er 2  38                   sec
00283Fr 2  A5 20                lda     INDEX
002841r 2  F1 20                sbc     (INDEX),y
002843r 2  A5 21                lda     INDEX+1
002845r 2  E5 3A                sbc     BAS_TMP1
002847r 2  B0 0A                bcs     @end                    ; current >= next -> not a real chain
002849r 2  B1 20                lda     (INDEX),y               ; next-ptr lo
00284Br 2  85 20                sta     INDEX
00284Dr 2  A5 3A                lda     BAS_TMP1
00284Fr 2  85 21                sta     INDEX+1
002851r 2  80 E0                bra     @walk
002853r 2               @end:
002853r 2                       ; INDEX points at terminator ($00 $00).  Candidate A = INDEX + 2.
002853r 2  18                   clc
002854r 2  A5 20                lda     INDEX
002856r 2  69 02                adc     #2
002858r 2  8D 5F 03             sta     BAS_VARTAB
00285Br 2  A5 21                lda     INDEX+1
00285Dr 2  69 00                adc     #0
00285Fr 2  8D 60 03             sta     BAS_VARTAB+1
002862r 2                       ; Candidate B = BAS_TMP2.  Keep it only when A <= B <= MEMSIZ, so a
002862r 2                       ; short or absent size loses the max and a bogus one cannot push
002862r 2                       ; VARTAB out of memory.
002862r 2  38                   sec
002863r 2  A5 3C                lda     BAS_TMP2
002865r 2  ED 5F 03             sbc     BAS_VARTAB
002868r 2  A5 3D                lda     BAS_TMP2+1
00286Ar 2  ED 60 03             sbc     BAS_VARTAB+1
00286Dr 2  90 17                bcc     @mirror                 ; B < A -> keep A
00286Fr 2  38                   sec
002870r 2  AD 67 03             lda     BAS_MEMSIZ
002873r 2  E5 3C                sbc     BAS_TMP2
002875r 2  AD 68 03             lda     BAS_MEMSIZ+1
002878r 2  E5 3D                sbc     BAS_TMP2+1
00287Ar 2  90 0A                bcc     @mirror                 ; B > MEMSIZ -> reject, keep A
00287Cr 2  A5 3C                lda     BAS_TMP2
00287Er 2  8D 5F 03             sta     BAS_VARTAB
002881r 2  A5 3D                lda     BAS_TMP2+1
002883r 2  8D 60 03             sta     BAS_VARTAB+1
002886r 2               @mirror:
002886r 2                       ; ARYTAB / STREND follow VARTAB on a fresh load: no variables yet.
002886r 2  A2 01                ldx     #1
002888r 2               @copy:
002888r 2  BD 5F 03             lda     BAS_VARTAB,x
00288Br 2  9D 61 03             sta     BAS_ARYTAB,x
00288Er 2  9D 63 03             sta     BAS_STREND,x
002891r 2  CA                   dex
002892r 2  10 F4                bpl     @copy
002894r 2  60                   rts
002895r 2               
002895r 2               ; --- Statements -----------------------------------------------------------
002895r 2               
002895r 2               ; SYS addr[,a[,x[,y]]] -- call a machine-code routine; RTS comes back here.
002895r 2               ; A, X and Y are loaded from the optional arguments (0 when omitted) and the
002895r 2               ; routine is entered with decimal mode and the interrupt mask clear.  What it
002895r 2               ; returns in A, X, Y and P is left in BRK_A/X/Y/P (PEEK 787/788/789/784), the
002895r 2               ; bytes a BRK report reads from.  The arguments wait there too: FrmEvl owns
002895r 2               ; every zero-page scratch byte, and nothing else runs between the last
002895r 2               ; argument and the call.
002895r 2               BasCmdSys:
002895r 2  20 rr rr             jsr     EvalAddrU16
002898r 2  A5 12                lda     FAC+4                   ; lo, and hi, across the evaluations
00289Ar 2  48                   pha
00289Br 2  A5 11                lda     FAC+3
00289Dr 2  48                   pha
00289Er 2  9C 13 03             stz     BRK_A
0028A1r 2  9C 14 03             stz     BRK_X
0028A4r 2  9C 15 03             stz     BRK_Y
0028A7r 2  A2 00                ldx     #0
0028A9r 2               @arg:
0028A9r 2  20 rr rr             jsr     ChrGot
0028ACr 2  C9 2C                cmp     #','
0028AEr 2  D0 0E                bne     @call
0028B0r 2  DA                   phx
0028B1r 2  20 rr rr             jsr     GetComByt               ; X = value
0028B4r 2  8A                   txa
0028B5r 2  FA                   plx
0028B6r 2  9D 13 03             sta     BRK_A,x
0028B9r 2  E8                   inx
0028BAr 2  E0 03                cpx     #3
0028BCr 2  D0 EB                bne     @arg
0028BEr 2               @call:
0028BEr 2  68                   pla
0028BFr 2  85 21                sta     INDEX+1
0028C1r 2  68                   pla
0028C2r 2  85 20                sta     INDEX
0028C4r 2  20 rr rr             jsr     @go
0028C7r 2  08                   php
0028C8r 2  8D 13 03             sta     BRK_A
0028CBr 2  8E 14 03             stx     BRK_X
0028CEr 2  8C 15 03             sty     BRK_Y
0028D1r 2  68                   pla
0028D2r 2  8D 10 03             sta     BRK_P
0028D5r 2  D8                   cld
0028D6r 2  60                   rts
0028D7r 2               @go:
0028D7r 2  AD 13 03             lda     BRK_A
0028DAr 2  AE 14 03             ldx     BRK_X
0028DDr 2  AC 15 03             ldy     BRK_Y
0028E0r 2  D8                   cld
0028E1r 2  58                   cli
0028E2r 2  6C 20 00             jmp     (INDEX)
0028E5r 2               
0028E5r 2               ; ---------------------------------------------------------------------------
0028E5r 2               ; Byte arguments, with the ranges the README documents.
0028E5r 2               ;
0028E5r 2               ; GetByt itself only rejects a value that will not fit in a byte.  Every
0028E5r 2               ; statement below has a narrower range than that -- a volume of 0-15, a screen
0028E5r 2               ; row of 0-23, an hour of 0-23 -- and each of them used to take whatever byte
0028E5r 2               ; it was handed and fold it into something legal.  VOL 16 masked to 4 bits and
0028E5r 2               ; set the volume to *zero*; LOCATE 24,0 pointed the cursor past the end of the
0028E5r 2               ; name table; SETTIME 24,61,61 wrote BCD the DS1511Y has no values for.  None
0028E5r 2               ; of them said anything.
0028E5r 2               ;
0028E5r 2               ; So the range travels with the fetch.  A = one past the highest legal value;
0028E5r 2               ; anything from there up raises ILLEGAL QUANTITY, as NVRAM's address already
0028E5r 2               ; did.  GetComByteLim is the same thing preceded by the comma between two
0028E5r 2               ; arguments, and it costs a byte *less* per site than the `jsr ChkCom /
0028E5r 2               ; jsr GetByt` pair it replaces -- which is how thirteen range checks fit into
0028E5r 2               ; a segment that had one byte spare.
0028E5r 2               ;
0028E5r 2               ; The limit is parked on the stack across the fetch rather than in scratch:
0028E5r 2               ; GetByt runs the whole expression evaluator, which reaches BAS_TMP3 itself.
0028E5r 2               ; Between the `pla` and the `cpx` nothing runs at all, so the byte is safe
0028E5r 2               ; there and nowhere earlier.
0028E5r 2               ; ---------------------------------------------------------------------------
0028E5r 2               
0028E5r 2               ; GetComByt - a comma, then an unchecked byte argument.
0028E5r 2               GetComByt:
0028E5r 2  20 rr rr             jsr     ChkCom
0028E8r 2  4C rr rr             jmp     GetByt
0028EBr 2               
0028EBr 2               ; GetComByteLim / GetByteLim - the same, with a range.  X = value.
0028EBr 2               GetComByteLim:
0028EBr 2  48                   pha                             ; the limit, across the comma
0028ECr 2  20 rr rr             jsr     ChkCom
0028EFr 2  68                   pla
0028F0r 2               GetByteLim:
0028F0r 2  48                   pha                             ; and across the evaluator
0028F1r 2  20 rr rr             jsr     GetByt                  ; X = value
0028F4r 2  68                   pla
0028F5r 2  85 3E                sta     BAS_TMP3
0028F7r 2  E4 3E                cpx     BAS_TMP3
0028F9r 2  B0 01                bcs     BasRangeErr             ; value >= limit
0028FBr 2  60                   rts
0028FCr 2               BasRangeErr:
0028FCr 2  4C rr rr             jmp     IqErr
0028FFr 2               
0028FFr 2               ; The five statements below reach hardware that a machine may not have fitted,
0028FFr 2               ; and none of them raises ?NO DEVICE for it: a screen or a speaker has no answer
0028FFr 2               ; to return, so there is nothing an error could tell the program that silence
0028FFr 2               ; does not.  A game that beeps on a hit keeps playing on a machine with no sound
0028FFr 2               ; card.  The skip lives in the Kernal routine each one ends in, which is what
0028FFr 2               ; makes the same promise to a cartridge calling the slot directly; the arguments
0028FFr 2               ; are parsed and range-checked here either way, so a program is wrong or right
0028FFr 2               ; on every machine rather than on the one it was written on.
0028FFr 2               ;
0028FFr 2               ; The statements that read or write *data* — the CF and RTC ones below — do
0028FFr 2               ; raise ?NO DEVICE, and for the same reason: they have an answer to return and
0028FFr 2               ; cannot.
0028FFr 2               
0028FFr 2               ; CLS
0028FFr 2               BasCmdCls:
0028FFr 2  4C rr rr             jmp     VideoClear
002902r 2               
002902r 2               ; LOCATE row, col
002902r 2               BasCmdLocate:
002902r 2  A9 18                lda     #24                     ; rows 0-23
002904r 2  20 rr rr             jsr     GetByteLim              ; X = row
002907r 2  DA                   phx
002908r 2  A9 28                lda     #40                     ; columns 0-39
00290Ar 2  20 rr rr             jsr     GetComByteLim           ; X = col
00290Dr 2  7A                   ply                             ; Y = row
00290Er 2  4C rr rr             jmp     VideoSetCursor
002911r 2               
002911r 2               ; COLOR fg[, bg[, border]]
002911r 2               ;   The pen for later output, through VideoSetColor, which also sets the border
002911r 2               ;   to bg.  bg defaults to the current pen's.  A border then writes register 7
002911r 2               ;   again as fg<<4 | border.
002911r 2               BasCmdColor:
002911r 2  A9 10                lda     #16                     ; colours 0-15
002913r 2  20 rr rr             jsr     GetByteLim              ; X = fg
002916r 2  8A                   txa
002917r 2  0A                   asl     a
002918r 2  0A                   asl     a
002919r 2  0A                   asl     a
00291Ar 2  0A                   asl     a
00291Br 2  48                   pha                             ; fg must survive FrmEvl -> stack, not ZP
00291Cr 2  AD 91 03             lda     VID_PEN
00291Fr 2  29 0F                and     #$0F
002921r 2  AA                   tax                             ; X = bg if none is given
002922r 2  20 rr rr             jsr     ChrGot
002925r 2  C9 2C                cmp     #','
002927r 2  D0 05                bne     @bg
002929r 2  A9 10                lda     #16
00292Br 2  20 rr rr             jsr     GetComByteLim           ; X = bg, already known to fit a nibble
00292Er 2               @bg:
00292Er 2  86 3A                stx     BAS_TMP1
002930r 2  68                   pla
002931r 2  48                   pha
002932r 2  05 3A                ora     BAS_TMP1
002934r 2  20 rr rr             jsr     VideoSetColor
002937r 2  20 rr rr             jsr     ChrGot
00293Ar 2  C9 2C                cmp     #','
00293Cr 2  D0 0F                bne     @done
00293Er 2  A9 10                lda     #16
002940r 2  20 rr rr             jsr     GetComByteLim           ; X = border
002943r 2  86 3A                stx     BAS_TMP1
002945r 2  68                   pla
002946r 2  05 3A                ora     BAS_TMP1
002948r 2  A2 07                ldx     #VDP_COLOR
00294Ar 2  4C rr rr             jmp     VdpWriteRegImpl         ; Skips without a card
00294Dr 2               @done:
00294Dr 2  68                   pla
00294Er 2  60                   rts
00294Fr 2               
00294Fr 2               ; VOL n
00294Fr 2               BasCmdVol:
00294Fr 2  A9 10                lda     #16                     ; volume 0-15
002951r 2  20 rr rr             jsr     GetByteLim              ; X = vol
002954r 2  8A                   txa
002955r 2  4C rr rr             jmp     SidSetVolume
002958r 2               
002958r 2               ; SOUND voice, freq, dur (freq=Hz, dur=centisec)
002958r 2               ;   Hz -> SID register: reg = Hz * 16.75 ≈ Hz<<4 + Hz - Hz/4
002958r 2               BasCmdSound:
002958r 2  A9 04                lda     #4                      ; voices 1-3, after Commodore BASIC V3.5
00295Ar 2  20 rr rr             jsr     GetByteLim              ; X = voice
00295Dr 2  CA                   dex                             ; 0-indexed for SidPlayNote
00295Er 2  30 9C                bmi     BasRangeErr             ; voice 0 underflowed to $FF
002960r 2  DA                   phx                             ; voice (0-indexed) on stack
002961r 2  20 rr rr             jsr     ChkCom
002964r 2  20 rr rr             jsr     EvalU16                 ; freq Hz: hi=FAC+3, lo=FAC+4
002967r 2                       ; Compute reg = Hz<<4 + Hz - Hz/4
002967r 2  A5 12                lda     FAC+4
002969r 2  85 3A                sta     BAS_TMP1
00296Br 2  A5 11                lda     FAC+3
00296Dr 2  85 3B                sta     BAS_TMP1+1
00296Fr 2  A5 3A                lda     BAS_TMP1
002971r 2  85 3C                sta     BAS_TMP2
002973r 2  A5 3B                lda     BAS_TMP1+1
002975r 2  85 3D                sta     BAS_TMP2+1
002977r 2  A2 04                ldx     #4
002979r 2               @shl:
002979r 2  06 3A                asl     BAS_TMP1
00297Br 2  26 3B                rol     BAS_TMP1+1
00297Dr 2  CA                   dex
00297Er 2  D0 F9                bne     @shl
002980r 2  18                   clc
002981r 2  A5 3A                lda     BAS_TMP1
002983r 2  65 3C                adc     BAS_TMP2
002985r 2  85 3A                sta     BAS_TMP1
002987r 2  A5 3B                lda     BAS_TMP1+1
002989r 2  65 3D                adc     BAS_TMP2+1
00298Br 2  85 3B                sta     BAS_TMP1+1
00298Dr 2  46 3D                lsr     BAS_TMP2+1
00298Fr 2  66 3C                ror     BAS_TMP2
002991r 2  46 3D                lsr     BAS_TMP2+1
002993r 2  66 3C                ror     BAS_TMP2
002995r 2  38                   sec
002996r 2  A5 3A                lda     BAS_TMP1
002998r 2  E5 3C                sbc     BAS_TMP2
00299Ar 2  48                   pha                             ; freqLo
00299Br 2  A5 3B                lda     BAS_TMP1+1
00299Dr 2  E5 3D                sbc     BAS_TMP2+1
00299Fr 2  48                   pha                             ; freqHi
0029A0r 2  20 rr rr             jsr     ChkCom
0029A3r 2  20 rr rr             jsr     EvalU16                 ; dur in FAC+3/+4
0029A6r 2                       ; Stack (top-down): freqHi, freqLo, voice
0029A6r 2  7A                   ply                             ; Y = freqHi
0029A7r 2  FA                   plx                             ; X = freqLo
0029A8r 2  68                   pla                             ; A = voice
0029A9r 2  20 rr rr             jsr     SidPlayNote
0029ACr 2  A5 12                lda     FAC+4
0029AEr 2  A6 11                ldx     FAC+3
0029B0r 2  20 rr rr             jsr     SysDelay
0029B3r 2  4C rr rr             jmp     SidSilence
0029B6r 2               
0029B6r 2               ; TIME
0029B6r 2               BasCmdTime:
0029B6r 2  A9 04                lda     #HW_RTC
0029B8r 2  20 rr rr             jsr     ReqHw
0029BBr 2  20 rr rr             jsr     RtcReadTime             ; A=hours, X=min, Y=sec
0029BEr 2  5A                   phy
0029BFr 2  DA                   phx
0029C0r 2  20 rr rr             jsr     BasPr2D                 ; print hours
0029C3r 2  A9 3A                lda     #':'
0029C5r 2  20 rr rr             jsr     Chrout
0029C8r 2  68                   pla
0029C9r 2  20 rr rr             jsr     BasPr2D
0029CCr 2  A9 3A                lda     #':'
0029CEr 2  20 rr rr             jsr     Chrout
0029D1r 2  68                   pla
0029D2r 2  20 rr rr             jsr     BasPr2D
0029D5r 2  4C rr rr             jmp     BasPrintCRLF
0029D8r 2               
0029D8r 2               ; DATE
0029D8r 2               BasCmdDate:
0029D8r 2  A9 04                lda     #HW_RTC
0029DAr 2  20 rr rr             jsr     ReqHw
0029DDr 2  20 rr rr             jsr     RtcReadDate             ; A=day, X=month, Y=year
0029E0r 2  48                   pha
0029E1r 2  DA                   phx
0029E2r 2  5A                   phy
0029E3r 2  AD 0B 03             lda     RTC_BUF_CENT
0029E6r 2  20 rr rr             jsr     BasPr2D
0029E9r 2  68                   pla
0029EAr 2  20 rr rr             jsr     BasPr2D
0029EDr 2  A9 2D                lda     #'-'
0029EFr 2  20 rr rr             jsr     Chrout
0029F2r 2  68                   pla
0029F3r 2  20 rr rr             jsr     BasPr2D
0029F6r 2  A9 2D                lda     #'-'
0029F8r 2  20 rr rr             jsr     Chrout
0029FBr 2  68                   pla
0029FCr 2  20 rr rr             jsr     BasPr2D
0029FFr 2  4C rr rr             jmp     BasPrintCRLF
002A02r 2               
002A02r 2               ; SETTIME h, m, s
002A02r 2               BasCmdSettime:
002A02r 2  A9 04                lda     #HW_RTC
002A04r 2  20 rr rr             jsr     ReqHw
002A07r 2  A9 18                lda     #24                     ; hours 0-23
002A09r 2  20 rr rr             jsr     GetByteLim              ; X = h
002A0Cr 2  DA                   phx
002A0Dr 2  A9 3C                lda     #60                     ; minutes 0-59
002A0Fr 2  20 rr rr             jsr     GetComByteLim           ; X = m
002A12r 2  DA                   phx
002A13r 2  A9 3C                lda     #60                     ; seconds 0-59
002A15r 2  20 rr rr             jsr     GetComByteLim           ; X = s
002A18r 2  8A                   txa
002A19r 2  A8                   tay                             ; Y = s
002A1Ar 2  FA                   plx                             ; X = m
002A1Br 2  68                   pla                             ; A = h
002A1Cr 2  4C rr rr             jmp     RtcWriteTime
002A1Fr 2               
002A1Fr 2               ; SETDATE c, y, m, d
002A1Fr 2               BasCmdSetdate:
002A1Fr 2  A9 04                lda     #HW_RTC
002A21r 2  20 rr rr             jsr     ReqHw
002A24r 2  A9 64                lda     #100                    ; century 0-99, as two BCD digits
002A26r 2  20 rr rr             jsr     GetByteLim
002A29r 2  8E 0B 03             stx     RTC_BUF_CENT
002A2Cr 2  A9 64                lda     #100                    ; year 0-99
002A2Er 2  20 rr rr             jsr     GetComByteLim
002A31r 2  DA                   phx                             ; year
002A32r 2  A9 0D                lda     #13                     ; months 1-12, so reject 0 as well
002A34r 2  20 rr rr             jsr     GetComByteLim
002A37r 2  E0 01                cpx     #1
002A39r 2  90 10                bcc     @bad
002A3Br 2  DA                   phx                             ; month
002A3Cr 2  A9 20                lda     #32                     ; days 1-31.  Which months are short is
002A3Er 2  20 rr rr             jsr     GetComByteLim           ;   left alone: it needs a table and a
002A41r 2  E0 01                cpx     #1                      ;   leap rule for one wrong day a year,
002A43r 2  90 06                bcc     @bad                    ;   and the DS1511Y does not check it
002A45r 2                                                       ;   either
002A45r 2  8A                   txa
002A46r 2  FA                   plx                             ; X=month
002A47r 2  7A                   ply                             ; Y=year
002A48r 2  4C rr rr             jmp     RtcWriteDate
002A4Br 2               @bad:                                   ; BasRangeErr is out of branch reach
002A4Br 2  4C rr rr             jmp     IqErr
002A4Er 2               
002A4Er 2               ; NVRAM addr, val
002A4Er 2               BasCmdNvram:
002A4Er 2  A9 04                lda     #HW_RTC
002A50r 2  20 rr rr             jsr     ReqHw
002A53r 2  20 rr rr             jsr     GetByt                  ; addr; GetByt's own 0-255 is the range
002A56r 2  DA                   phx
002A57r 2  20 rr rr             jsr     GetComByt               ; X=val
002A5Ar 2  8A                   txa                             ; A=val
002A5Br 2  FA                   plx                             ; X=addr
002A5Cr 2  4C rr rr             jmp     RtcWriteNVRAM
002A5Fr 2               
002A5Fr 2               ; WAIT addr, mask
002A5Fr 2               ; As with POKE, the address must survive evaluation of the second argument,
002A5Fr 2               ; which is free to trample BAS_TMP1 (FacToU16, MID$/LEFT$/RIGHT$, ...).
002A5Fr 2               BasCmdWait:
002A5Fr 2  20 rr rr             jsr     EvalAddrU16
002A62r 2  A5 11                lda     FAC+3                   ; hi
002A64r 2  48                   pha
002A65r 2  A5 12                lda     FAC+4                   ; lo
002A67r 2  48                   pha
002A68r 2  20 rr rr             jsr     GetComByt               ; X = mask
002A6Br 2  86 3C                stx     BAS_TMP2
002A6Dr 2  68                   pla
002A6Er 2  85 3A                sta     BAS_TMP1
002A70r 2  68                   pla
002A71r 2  85 3B                sta     BAS_TMP1+1
002A73r 2               @poll:
002A73r 2  20 rr rr             jsr     BasCheckBreak
002A76r 2  A0 00                ldy     #0
002A78r 2  B1 3A                lda     (BAS_TMP1),y
002A7Ar 2  25 3C                and     BAS_TMP2
002A7Cr 2  F0 F5                beq     @poll
002A7Er 2  60                   rts
002A7Fr 2               
002A7Fr 2               ; PAUSE n (centiseconds)
002A7Fr 2               BasCmdPause:
002A7Fr 2  20 rr rr             jsr     EvalU16
002A82r 2  A5 12                lda     FAC+4
002A84r 2  A6 11                ldx     FAC+3
002A86r 2  4C rr rr             jmp     SysDelay
002A89r 2               
002A89r 2               ; BANK n
002A89r 2               BasCmdBank:
002A89r 2  A9 01                lda     #HW_RAM_L
002A8Br 2  20 rr rr             jsr     ReqHw
002A8Er 2  20 rr rr             jsr     GetByt                  ; X = bank
002A91r 2  8E FF 83             stx     RAM_BANK_L
002A94r 2  60                   rts
002A95r 2               
002A95r 2               ; POKE addr, val
002A95r 2               ; The value expression is evaluated BEFORE the address is parked in INDEX:
002A95r 2               ; FrmEvl clobbers every zero-page scratch pair (INDEX via LoadFacFromYa,
002A95r 2               ; BAS_TMP1 via FacToU16 / the string functions), so the address has to ride
002A95r 2               ; the hardware stack across the evaluation.
002A95r 2               BasCmdPoke:
002A95r 2  20 rr rr             jsr     EvalAddrU16
002A98r 2  A5 11                lda     FAC+3                   ; hi
002A9Ar 2  48                   pha
002A9Br 2  A5 12                lda     FAC+4                   ; lo
002A9Dr 2  48                   pha
002A9Er 2  20 rr rr             jsr     ChkCom
002AA1r 2  20 rr rr             jsr     GetByt                  ; X = val
002AA4r 2  68                   pla
002AA5r 2  85 20                sta     INDEX
002AA7r 2  68                   pla
002AA8r 2  85 21                sta     INDEX+1
002AAAr 2  8A                   txa
002AABr 2  A0 00                ldy     #0
002AADr 2  91 20                sta     (INDEX),y
002AAFr 2  60                   rts
002AB0r 2               
002AB0r 2               ; LOAD ["name"] / LOAD (bare) / LOAD "name"
002AB0r 2               BasCmdLoad:
002AB0r 2  20 rr rr             jsr     ChrGot
002AB3r 2  F0 02                beq     @bare
002AB5r 2  80 19                bra     @cf                     ; any argument is a filename expression
002AB7r 2               @bare:
002AB7r 2  A9 10                lda     #HW_SC
002AB9r 2  20 rr rr             jsr     ReqHw
002ABCr 2  A9 00                lda     #<PROGRAM_START
002ABEr 2  85 2A                sta     XFER_PTR
002AC0r 2  A9 08                lda     #>PROGRAM_START
002AC2r 2  85 2B                sta     XFER_PTR+1
002AC4r 2  20 rr rr             jsr     XModemLoad
002AC7r 2                       ; XMODEM rounds up to a 128-byte block, so this can overshoot the true
002AC7r 2                       ; end by up to 127 bytes: it wastes a little variable space, never
002AC7r 2                       ; truncates.
002AC7r 2  AD 17 03             lda     XFER_REMAIN
002ACAr 2  AC 18 03             ldy     XFER_REMAIN+1
002ACDr 2  4C rr rr             jmp     BasFixChain
002AD0r 2               @cf:
002AD0r 2  A9 08                lda     #HW_CF
002AD2r 2  20 rr rr             jsr     ReqHw
002AD5r 2  20 rr rr             jsr     EvalString
002AD8r 2  20 rr rr             jsr     FsLoadFile
002ADBr 2  B0 09                bcs     @err
002ADDr 2  AD 4A 03             lda     FS_FILE_SIZE
002AE0r 2  AC 4B 03             ldy     FS_FILE_SIZE+1
002AE3r 2  4C rr rr             jmp     BasFixChain
002AE6r 2               @err:
002AE6r 2  A9 rr                lda     #<MsgLoadErr
002AE8r 2  A0 rr                ldy     #>MsgLoadErr
002AEAr 2  4C rr rr             jmp     BasPrintStr
002AEDr 2               
002AEDr 2               ; SAVE / SAVE "name"
002AEDr 2               BasCmdSave:
002AEDr 2  20 rr rr             jsr     ChrGot
002AF0r 2  F0 02                beq     @bare
002AF2r 2  80 21                bra     @cf                     ; any argument is a filename expression
002AF4r 2               @bare:
002AF4r 2  A9 10                lda     #HW_SC
002AF6r 2  20 rr rr             jsr     ReqHw
002AF9r 2  A9 00                lda     #<PROGRAM_START
002AFBr 2  85 2A                sta     XFER_PTR
002AFDr 2  A9 08                lda     #>PROGRAM_START
002AFFr 2  85 2B                sta     XFER_PTR+1
002B01r 2  38                   sec
002B02r 2  AD 5F 03             lda     BAS_VARTAB
002B05r 2  E9 00                sbc     #<PROGRAM_START
002B07r 2  8D 17 03             sta     XFER_REMAIN
002B0Ar 2  AD 60 03             lda     BAS_VARTAB+1
002B0Dr 2  E9 08                sbc     #>PROGRAM_START
002B0Fr 2  8D 18 03             sta     XFER_REMAIN+1
002B12r 2  4C rr rr             jmp     XModemSave
002B15r 2               @cf:
002B15r 2  A9 08                lda     #HW_CF
002B17r 2  20 rr rr             jsr     ReqHw
002B1Ar 2  20 rr rr             jsr     EvalString
002B1Dr 2  38                   sec
002B1Er 2  AD 5F 03             lda     BAS_VARTAB
002B21r 2  E9 00                sbc     #<PROGRAM_START
002B23r 2  8D 4A 03             sta     FS_FILE_SIZE
002B26r 2  AD 60 03             lda     BAS_VARTAB+1
002B29r 2  E9 08                sbc     #>PROGRAM_START
002B2Br 2  8D 4B 03             sta     FS_FILE_SIZE+1
002B2Er 2  20 rr rr             jsr     FsSaveFile
002B31r 2  B0 01                bcs     @err
002B33r 2  60                   rts
002B34r 2               @err:
002B34r 2  A9 rr                lda     #<MsgSaveErr
002B36r 2  A0 rr                ldy     #>MsgSaveErr
002B38r 2  4C rr rr             jmp     BasPrintStr
002B3Br 2               
002B3Br 2               ; DIR
002B3Br 2               BasCmdDir:
002B3Br 2  A9 08                lda     #HW_CF
002B3Dr 2  20 rr rr             jsr     ReqHw
002B40r 2  4C rr rr             jmp     FsDirectory
002B43r 2               
002B43r 2               ; DEL "name"
002B43r 2               BasCmdDel:
002B43r 2  A9 08                lda     #HW_CF
002B45r 2  20 rr rr             jsr     ReqHw
002B48r 2  20 rr rr             jsr     EvalString
002B4Br 2  20 rr rr             jsr     FsDeleteFile
002B4Er 2  B0 01                bcs     @err
002B50r 2  60                   rts
002B51r 2               @err:
002B51r 2  A9 rr                lda     #<MsgDelErr
002B53r 2  A0 rr                ldy     #>MsgDelErr
002B55r 2  4C rr rr             jmp     BasPrintStr
002B58r 2               
002B58r 2               ; MEM -- print "nnnnn BYTES FREE  HW=$xx"
002B58r 2               BasCmdMem:
002B58r 2                       ; Free bytes = MEMSIZ - VARTAB
002B58r 2  38                   sec
002B59r 2  AD 67 03             lda     BAS_MEMSIZ
002B5Cr 2  ED 5F 03             sbc     BAS_VARTAB
002B5Fr 2  A8                   tay
002B60r 2  AD 68 03             lda     BAS_MEMSIZ+1
002B63r 2  ED 60 03             sbc     BAS_VARTAB+1
002B66r 2  20 rr rr             jsr     GivAyf                  ; FAC = unsigned int from (Y,A)
002B69r 2                       ; Wait: GivAyf is signed.  For this simple display, OK if < 32768.
002B69r 2  20 rr rr             jsr     PrintNum
002B6Cr 2  A9 rr                lda     #<MsgFree
002B6Er 2  A0 rr                ldy     #>MsgFree
002B70r 2  20 rr rr             jsr     BasPrintStr
002B73r 2  A9 24                lda     #'$'
002B75r 2  20 rr rr             jsr     Chrout
002B78r 2  AD 0D 03             lda     HW_PRESENT
002B7Br 2  20 rr rr             jsr     PrintHexByte
002B7Er 2  20 rr rr             jsr     BasPrintCRLF
002B81r 2  4C rr rr             jmp     FsPrintDisk             ; print "DISK n" line
002B84r 2               
002B84r 2               ; DISK n -- select the current CF disk bank (0-255)
002B84r 2               BasCmdDisk:
002B84r 2  20 rr rr             jsr     GetByt                  ; X = value 0-255
002B87r 2  8E 0F 03             stx     CF_DISK
002B8Ar 2  60                   rts
002B8Br 2               
002B8Br 2               ; BLOAD addr[,"name"] -- load a file's raw bytes to addr, or with no name
002B8Br 2               ; receive them over XModem.  The card each path needs is asked for once the
002B8Br 2               ; arguments say which path it is.
002B8Br 2               BasCmdBload:
002B8Br 2  20 rr rr             jsr     EvalAddrU16             ; FAC+3 = hi, FAC+4 = lo
002B8Er 2  A5 12                lda     z:FAC+4
002B90r 2  8D 7F 03             sta     FS_IO_ADDR
002B93r 2  85 2A                sta     XFER_PTR
002B95r 2  A5 11                lda     z:FAC+3
002B97r 2  8D 80 03             sta     FS_IO_ADDR+1
002B9Ar 2  85 2B                sta     XFER_PTR+1
002B9Cr 2  20 rr rr             jsr     ChrGot
002B9Fr 2  D0 0A                bne     @cf
002BA1r 2  A9 10                lda     #HW_SC
002BA3r 2  20 rr rr             jsr     ReqHw
002BA6r 2  20 rr rr             jsr     XModemLoad
002BA9r 2  80 0E                bra     @done
002BABr 2               @cf:
002BABr 2  A9 08                lda     #HW_CF
002BADr 2  20 rr rr             jsr     ReqHw
002BB0r 2  20 rr rr             jsr     ChkCom
002BB3r 2  20 rr rr             jsr     EvalString              ; filename -> BAS_FNAME, STR_PTR
002BB6r 2  20 rr rr             jsr     FsLoadFileAddr
002BB9r 2               @done:
002BB9r 2  B0 01                bcs     @err
002BBBr 2  60                   rts
002BBCr 2               @err:
002BBCr 2  A9 rr                lda     #<MsgLoadErr
002BBEr 2  A0 rr                ldy     #>MsgLoadErr
002BC0r 2  4C rr rr             jmp     BasPrintStr
002BC3r 2               
002BC3r 2               ; BSAVE addr, len[,"name"] -- save len bytes from addr to a file, or with no
002BC3r 2               ; name send them over XModem
002BC3r 2               BasCmdBsave:
002BC3r 2  20 rr rr             jsr     EvalAddrU16             ; addr
002BC6r 2  A5 12                lda     z:FAC+4
002BC8r 2  8D 7F 03             sta     FS_IO_ADDR
002BCBr 2  85 2A                sta     XFER_PTR
002BCDr 2  A5 11                lda     z:FAC+3
002BCFr 2  8D 80 03             sta     FS_IO_ADDR+1
002BD2r 2  85 2B                sta     XFER_PTR+1
002BD4r 2  20 rr rr             jsr     ChkCom
002BD7r 2  20 rr rr             jsr     EvalAddrU16             ; length in bytes
002BDAr 2  A5 12                lda     z:FAC+4
002BDCr 2  8D 4A 03             sta     FS_FILE_SIZE
002BDFr 2  8D 17 03             sta     XFER_REMAIN
002BE2r 2  A5 11                lda     z:FAC+3
002BE4r 2  8D 4B 03             sta     FS_FILE_SIZE+1
002BE7r 2  8D 18 03             sta     XFER_REMAIN+1
002BEAr 2  20 rr rr             jsr     ChrGot
002BEDr 2  D0 0A                bne     @cf
002BEFr 2  A9 10                lda     #HW_SC
002BF1r 2  20 rr rr             jsr     ReqHw
002BF4r 2  20 rr rr             jsr     XModemSave
002BF7r 2  80 0E                bra     @done
002BF9r 2               @cf:
002BF9r 2  A9 08                lda     #HW_CF
002BFBr 2  20 rr rr             jsr     ReqHw
002BFEr 2  20 rr rr             jsr     ChkCom
002C01r 2  20 rr rr             jsr     EvalString              ; filename
002C04r 2  20 rr rr             jsr     FsSaveFileAddr
002C07r 2               @done:
002C07r 2  B0 01                bcs     @err
002C09r 2  60                   rts
002C0Ar 2               @err:
002C0Ar 2  A9 rr                lda     #<MsgSaveErr
002C0Cr 2  A0 rr                ldy     #>MsgSaveErr
002C0Er 2  4C rr rr             jmp     BasPrintStr
002C11r 2               
002C11r 2               ; FORMAT -- erase (zero) the current disk's directory, with confirmation
002C11r 2               BasCmdFormat:
002C11r 2  A9 08                lda     #HW_CF
002C13r 2  20 rr rr             jsr     ReqHw
002C16r 2  A9 rr                lda     #<MsgEraseDisk
002C18r 2  A0 rr                ldy     #>MsgEraseDisk
002C1Ar 2  20 rr rr             jsr     BasPrintStr
002C1Dr 2  AD 0F 03             lda     CF_DISK
002C20r 2  8D 4A 03             sta     FS_FILE_SIZE
002C23r 2  9C 4B 03             stz     FS_FILE_SIZE+1
002C26r 2  20 rr rr             jsr     FsPrintSize             ; print disk number (decimal)
002C29r 2  A9 rr                lda     #<MsgConfirm
002C2Br 2  A0 rr                ldy     #>MsgConfirm
002C2Dr 2  20 rr rr             jsr     BasPrintStr
002C30r 2               @wait:
002C30r 2  20 rr rr             jsr     Chrin                   ; wait for a key (echoes)
002C33r 2  90 FB                bcc     @wait
002C35r 2  29 DF                and     #$DF                    ; fold to uppercase
002C37r 2  48                   pha
002C38r 2  20 rr rr             jsr     BasPrintCRLF
002C3Br 2  68                   pla
002C3Cr 2  C9 59                cmp     #'Y'
002C3Er 2  D0 03                bne     @abort
002C40r 2  4C rr rr             jmp     FsFormatDisk            ; zero the directory (returns carry status)
002C43r 2               @abort:
002C43r 2  60                   rts
002C44r 2               
002C44r 2  20 42 59 54  MsgFree:        .byte   " BYTES FREE  HW=",0
002C48r 2  45 53 20 46  
002C4Cr 2  52 45 45 20  
002C55r 2  3F 4C 4F 41  MsgLoadErr:     .byte   "?LOAD ERROR",$0D,$0A,0
002C59r 2  44 20 45 52  
002C5Dr 2  52 4F 52 0D  
002C63r 2  3F 53 41 56  MsgSaveErr:     .byte   "?SAVE ERROR",$0D,$0A,0
002C67r 2  45 20 45 52  
002C6Br 2  52 4F 52 0D  
002C71r 2  3F 44 45 4C  MsgDelErr:      .byte   "?DEL ERROR",$0D,$0A,0
002C75r 2  20 45 52 52  
002C79r 2  4F 52 0D 0A  
002C7Er 2  45 52 41 53  MsgEraseDisk:   .byte   "ERASE DISK ",0
002C82r 2  45 20 44 49  
002C86r 2  53 4B 20 00  
002C8Ar 2  3F 20 28 59  MsgConfirm:     .byte   "? (Y/N) ",0
002C8Er 2  2F 4E 29 20  
002C92r 2  00           
002C93r 2               
002C93r 2               ; Wrappers so the dispatch table can call existing routines that expect
002C93r 2               ; TXTPTR positioned already.
002C93r 2               BasCmdPrintW:
002C93r 2                       ; We were entered via the dispatch trampoline, so TXTPTR is already
002C93r 2                       ; past the PRINT token (ChrGet was tail-called).  But BasCmdPrint
002C93r 2                       ; expects to consume the token itself with its first ChrGet; rewind.
002C93r 2                       ; Easier: BasCmdPrint reads via ChrGet; here ChrGet was called before
002C93r 2                       ; routine entry, so TXTPTR currently points at first arg.  Just call
002C93r 2                       ; an internal entry that skips the leading ChrGet.
002C93r 2  4C rr rr             jmp     BasPrLoop
002C96r 2               
002C96r 2               ; ---------------------------------------------------------------------------
002C96r 2               ; Token-address dispatch table.  Indexed by (token - $80).  Each entry is
002C96r 2               ; (routine_address - 1) since the dispatcher PHA-pushes it and uses the
002C96r 2               ; "JMP ChrGet -> RTS" trick to enter.
002C96r 2               ; ---------------------------------------------------------------------------
002C96r 2               BasTokenAddrTbl:
002C96r 2  rr rr                .word   BasCmdEnd-1             ; $80 END
002C98r 2  rr rr                .word   BasCmdFor-1             ; $81 FOR
002C9Ar 2  rr rr                .word   BasCmdNext-1            ; $82 NEXT
002C9Cr 2  rr rr                .word   BasCmdData-1            ; $83 DATA
002C9Er 2  rr rr                .word   BasCmdInput-1           ; $84 INPUT
002CA0r 2  rr rr                .word   BasCmdDim-1             ; $85 DIM
002CA2r 2  rr rr                .word   BasCmdRead-1            ; $86 READ
002CA4r 2  rr rr                .word   BasCmdLet-1             ; $87 LET
002CA6r 2  rr rr                .word   BasCmdGoto-1            ; $88 GOTO
002CA8r 2  rr rr                .word   BasCmdRun-1             ; $89 RUN
002CAAr 2  rr rr                .word   BasCmdIf-1              ; $8A IF
002CACr 2  rr rr                .word   BasCmdRestore-1         ; $8B RESTORE
002CAEr 2  rr rr                .word   BasCmdGosub-1           ; $8C GOSUB
002CB0r 2  rr rr                .word   BasCmdReturn-1          ; $8D RETURN
002CB2r 2  rr rr                .word   BasCmdRem-1             ; $8E REM
002CB4r 2  rr rr                .word   BasCmdStop-1            ; $8F STOP
002CB6r 2  rr rr                .word   BasCmdOn-1              ; $90 ON
002CB8r 2  rr rr                .word   BasCmdWait-1            ; $91 WAIT
002CBAr 2  rr rr                .word   BasCmdLoad-1            ; $92 LOAD
002CBCr 2  rr rr                .word   BasCmdSave-1            ; $93 SAVE
002CBEr 2  rr rr                .word   BasCmdDef-1             ; $94 DEF
002CC0r 2  rr rr                .word   BasCmdPoke-1            ; $95 POKE
002CC2r 2  rr rr                .word   BasCmdPrintW-1          ; $96 PRINT
002CC4r 2  rr rr                .word   BasCmdCont-1            ; $97 CONT
002CC6r 2  rr rr                .word   BasCmdList-1            ; $98 LIST
002CC8r 2  rr rr                .word   BasCmdClr-1             ; $99 CLR
002CCAr 2  rr rr                .word   BasCmdNew-1             ; $9A NEW
002CCCr 2  rr rr                .word   SynErr-1                ; $9B TAB  (function only)
002CCEr 2  rr rr                .word   SynErr-1                ; $9C TO
002CD0r 2  rr rr                .word   SynErr-1                ; $9D FN
002CD2r 2  rr rr                .word   SynErr-1                ; $9E SPC
002CD4r 2  rr rr                .word   SynErr-1                ; $9F THEN
002CD6r 2  rr rr                .word   SynErr-1                ; $A0 NOT
002CD8r 2  rr rr                .word   SynErr-1                ; $A1 STEP
002CDAr 2  rr rr                .word   SynErr-1                ; $A2 AND
002CDCr 2  rr rr                .word   SynErr-1                ; $A3 OR
002CDEr 2  rr rr                .word   BasCmdRem-1             ; $A4 ELSE (skip rest of line; THEN-branch ran)
002CE0r 2  rr rr                .word   BasCmdSys-1             ; $A5 SYS
002CE2r 2  rr rr                .word   BasCmdDir-1             ; $A6 DIR
002CE4r 2  rr rr                .word   BasCmdDel-1             ; $A7 DEL
002CE6r 2  rr rr                .word   BasCmdCls-1             ; $A8 CLS
002CE8r 2  rr rr                .word   BasCmdLocate-1          ; $A9 LOCATE
002CEAr 2  rr rr                .word   BasCmdColor-1           ; $AA COLOR
002CECr 2  rr rr                .word   BasCmdSound-1           ; $AB SOUND
002CEEr 2  rr rr                .word   BasCmdVol-1             ; $AC VOL
002CF0r 2  rr rr                .word   BasCmdTime-1            ; $AD TIME
002CF2r 2  rr rr                .word   BasCmdDate-1            ; $AE DATE
002CF4r 2  rr rr                .word   BasCmdSettime-1         ; $AF SETTIME
002CF6r 2  rr rr                .word   BasCmdSetdate-1         ; $B0 SETDATE
002CF8r 2  rr rr                .word   BasCmdNvram-1           ; $B1 NVRAM
002CFAr 2  rr rr                .word   BasCmdPause-1           ; $B2 PAUSE
002CFCr 2  rr rr                .word   BasCmdBank-1            ; $B3 BANK
002CFEr 2  rr rr                .word   SynErr-1                ; $B4 SCREEN
002D00r 2  rr rr                .word   BasCmdMem-1             ; $B5 MEM
002D02r 2               
002D02r 2               ; Extended statement tokens, from TOK_DISK ($D1).  Entries are (handler-1), as
002D02r 2               ; above; BasExecuteStatement's @ext bounds the index.
002D02r 2               BasExtAddrTbl:
002D02r 2  rr rr                .word   BasCmdDisk-1            ; $D1 DISK
002D04r 2  rr rr                .word   BasCmdBload-1           ; $D2 BLOAD
002D06r 2  rr rr                .word   BasCmdBsave-1           ; $D3 BSAVE
002D08r 2  rr rr                .word   BasCmdFormat-1          ; $D4 FORMAT
002D0Ar 2  rr rr                .word   SynErr-1                ; $D5 VPOKE
002D0Cr 2  rr rr                .word   SynErr-1                ; $D6 VREG
002D0Er 2  rr rr                .word   SynErr-1                ; $D7 PALETTE
002D10r 2  rr rr                .word   SynErr-1                ; $D8 VSYNC
002D12r 2  rr rr                .word   SynErr-1                ; $D9 VLOAD
002D14r 2  rr rr                .word   SynErr-1                ; $DA SPRITE
002D16r 2  rr rr                .word   SynErr-1                ; $DB SCROLL
002D18r 2  rr rr                .word   SynErr-1                ; $DC LAYER
002D1Ar 2  rr rr                .word   SynErr-1                ; $DD NVSAVE
002D1Cr 2  rr rr                .word   SynErr-1                ; $DE NVLOAD
002D1Er 2  rr rr                .word   SynErr-1                ; $DF NVERASE
002D20r 2               
002D20r 2               ; =============================================================================
002D20r 2               ;   K E Y W O R D   T A B L E
002D20r 2               ;
002D20r 2               ;   Each keyword is its ASCII characters; the LAST byte has bit 7 set.
002D20r 2               ;   Order MUST match TOK_xxx equates above (token = TOK_BASE + index).
002D20r 2               ;   A trailing $00 terminates the table.
002D20r 2               ; =============================================================================
002D20r 2               
002D20r 2               KeywordTbl:
002D20r 2                       ; Statements
002D20r 2  45 4E C4             .byte   "EN",'D'|$80            ; $80 END
002D23r 2  46 4F D2             .byte   "FO",'R'|$80            ; $81 FOR
002D26r 2  4E 45 58 D4          .byte   "NEX",'T'|$80           ; $82 NEXT
002D2Ar 2  44 41 54 C1          .byte   "DAT",'A'|$80           ; $83 DATA
002D2Er 2  49 4E 50 55          .byte   "INPU",'T'|$80          ; $84 INPUT
002D32r 2  D4           
002D33r 2  44 49 CD             .byte   "DI",'M'|$80            ; $85 DIM
002D36r 2  52 45 41 C4          .byte   "REA",'D'|$80           ; $86 READ
002D3Ar 2  4C 45 D4             .byte   "LE",'T'|$80            ; $87 LET
002D3Dr 2  47 4F 54 CF          .byte   "GOT",'O'|$80           ; $88 GOTO
002D41r 2  52 55 CE             .byte   "RU",'N'|$80            ; $89 RUN
002D44r 2  49 C6                .byte   "I",'F'|$80             ; $8A IF
002D46r 2  52 45 53 54          .byte   "RESTOR",'E'|$80        ; $8B RESTORE
002D4Ar 2  4F 52 C5     
002D4Dr 2  47 4F 53 55          .byte   "GOSU",'B'|$80          ; $8C GOSUB
002D51r 2  C2           
002D52r 2  52 45 54 55          .byte   "RETUR",'N'|$80         ; $8D RETURN
002D56r 2  52 CE        
002D58r 2  52 45 CD             .byte   "RE",'M'|$80            ; $8E REM
002D5Br 2  53 54 4F D0          .byte   "STO",'P'|$80           ; $8F STOP
002D5Fr 2  4F CE                .byte   "O",'N'|$80             ; $90 ON
002D61r 2  57 41 49 D4          .byte   "WAI",'T'|$80           ; $91 WAIT
002D65r 2  4C 4F 41 C4          .byte   "LOA",'D'|$80           ; $92 LOAD
002D69r 2  53 41 56 C5          .byte   "SAV",'E'|$80           ; $93 SAVE
002D6Dr 2  44 45 C6             .byte   "DE",'F'|$80            ; $94 DEF
002D70r 2  50 4F 4B C5          .byte   "POK",'E'|$80           ; $95 POKE
002D74r 2  50 52 49 4E          .byte   "PRIN",'T'|$80          ; $96 PRINT
002D78r 2  D4           
002D79r 2  43 4F 4E D4          .byte   "CON",'T'|$80           ; $97 CONT
002D7Dr 2  4C 49 53 D4          .byte   "LIS",'T'|$80           ; $98 LIST
002D81r 2  43 4C D2             .byte   "CL",'R'|$80            ; $99 CLR
002D84r 2  4E 45 D7             .byte   "NE",'W'|$80            ; $9A NEW
002D87r 2  54 41 C2             .byte   "TA",'B'|$80            ; $9B TAB
002D8Ar 2  54 CF                .byte   "T",'O'|$80             ; $9C TO
002D8Cr 2  46 CE                .byte   "F",'N'|$80             ; $9D FN
002D8Er 2  53 50 C3             .byte   "SP",'C'|$80            ; $9E SPC
002D91r 2  54 48 45 CE          .byte   "THE",'N'|$80           ; $9F THEN
002D95r 2  4E 4F D4             .byte   "NO",'T'|$80            ; $A0 NOT
002D98r 2  53 54 45 D0          .byte   "STE",'P'|$80           ; $A1 STEP
002D9Cr 2  41 4E C4             .byte   "AN",'D'|$80            ; $A2 AND
002D9Fr 2  4F D2                .byte   "O",'R'|$80             ; $A3 OR
002DA1r 2  45 4C 53 C5          .byte   "ELS",'E'|$80           ; $A4 ELSE
002DA5r 2  53 59 D3             .byte   "SY",'S'|$80            ; $A5 SYS
002DA8r 2  44 49 D2             .byte   "DI",'R'|$80            ; $A6 DIR
002DABr 2  44 45 CC             .byte   "DE",'L'|$80            ; $A7 DEL
002DAEr 2  43 4C D3             .byte   "CL",'S'|$80            ; $A8 CLS
002DB1r 2  4C 4F 43 41          .byte   "LOCAT",'E'|$80         ; $A9 LOCATE
002DB5r 2  54 C5        
002DB7r 2  43 4F 4C 4F          .byte   "COLO",'R'|$80          ; $AA COLOR
002DBBr 2  D2           
002DBCr 2  53 4F 55 4E          .byte   "SOUN",'D'|$80          ; $AB SOUND
002DC0r 2  C4           
002DC1r 2  56 4F CC             .byte   "VO",'L'|$80            ; $AC VOL
002DC4r 2  54 49 4D C5          .byte   "TIM",'E'|$80           ; $AD TIME
002DC8r 2  44 41 54 C5          .byte   "DAT",'E'|$80           ; $AE DATE
002DCCr 2  53 45 54 54          .byte   "SETTIM",'E'|$80        ; $AF SETTIME
002DD0r 2  49 4D C5     
002DD3r 2  53 45 54 44          .byte   "SETDAT",'E'|$80        ; $B0 SETDATE
002DD7r 2  41 54 C5     
002DDAr 2  4E 56 52 41          .byte   "NVRA",'M'|$80          ; $B1 NVRAM
002DDEr 2  CD           
002DDFr 2  50 41 55 53          .byte   "PAUS",'E'|$80          ; $B2 PAUSE
002DE3r 2  C5           
002DE4r 2  42 41 4E CB          .byte   "BAN",'K'|$80           ; $B3 BANK
002DE8r 2  53 43 52 45          .byte   "SCREE",'N'|$80         ; $B4 SCREEN (BRK in 1.x)
002DECr 2  45 CE        
002DEEr 2  4D 45 CD             .byte   "ME",'M'|$80            ; $B5 MEM
002DF1r 2                       ; Functions
002DF1r 2  53 47 CE             .byte   "SG",'N'|$80            ; $B6 Sgn
002DF4r 2  49 4E D4             .byte   "IN",'T'|$80            ; $B7 Int
002DF7r 2  41 42 D3             .byte   "AB",'S'|$80            ; $B8 Abs
002DFAr 2  46 52 C5             .byte   "FR",'E'|$80            ; $B9 FRE
002DFDr 2  50 4F D3             .byte   "PO",'S'|$80            ; $BA POS
002E00r 2  53 51 D2             .byte   "SQ",'R'|$80            ; $BB Sqr
002E03r 2  52 4E C4             .byte   "RN",'D'|$80            ; $BC Rnd
002E06r 2  4C 4F C7             .byte   "LO",'G'|$80            ; $BD Log
002E09r 2  45 58 D0             .byte   "EX",'P'|$80            ; $BE Exp
002E0Cr 2  43 4F D3             .byte   "CO",'S'|$80            ; $BF Cos
002E0Fr 2  53 49 CE             .byte   "SI",'N'|$80            ; $C0 Sin
002E12r 2  54 41 CE             .byte   "TA",'N'|$80            ; $C1 Tan
002E15r 2  41 54 CE             .byte   "AT",'N'|$80            ; $C2 Atn
002E18r 2  50 45 45 CB          .byte   "PEE",'K'|$80           ; $C3 PEEK
002E1Cr 2  4C 45 CE             .byte   "LE",'N'|$80            ; $C4 LEN
002E1Fr 2  53 54 52 A4          .byte   "STR",'$'|$80           ; $C5 STR$
002E23r 2  56 41 CC             .byte   "VA",'L'|$80            ; $C6 VAL
002E26r 2  41 53 C3             .byte   "AS",'C'|$80            ; $C7 ASC
002E29r 2  43 48 52 A4          .byte   "CHR",'$'|$80           ; $C8 CHR$
002E2Dr 2  4C 45 46 54          .byte   "LEFT",'$'|$80          ; $C9 LEFT$
002E31r 2  A4           
002E32r 2  52 49 47 48          .byte   "RIGHT",'$'|$80         ; $CA RIGHT$
002E36r 2  54 A4        
002E38r 2  4D 49 44 A4          .byte   "MID",'$'|$80           ; $CB MID$
002E3Cr 2  4A 4F D9             .byte   "JO",'Y'|$80            ; $CC JOY
002E3Fr 2  49 4E 4B 45          .byte   "INKE",'Y'|$80          ; $CD INKEY
002E43r 2  D9           
002E44r 2  48 45 D8             .byte   "HE",'X'|$80            ; $CE HEX
002E47r 2  4D 49 CE             .byte   "MI",'N'|$80            ; $CF MIN
002E4Ar 2  4D 41 D8             .byte   "MA",'X'|$80            ; $D0 MAX
002E4Dr 2  44 49 53 CB          .byte   "DIS",'K'|$80           ; $D1 DISK
002E51r 2  42 4C 4F 41          .byte   "BLOA",'D'|$80          ; $D2 BLOAD
002E55r 2  C4           
002E56r 2  42 53 41 56          .byte   "BSAV",'E'|$80          ; $D3 BSAVE
002E5Ar 2  C5           
002E5Br 2  46 4F 52 4D          .byte   "FORMA",'T'|$80         ; $D4 FORMAT
002E5Fr 2  41 D4        
002E61r 2                       ; 2.0 statements
002E61r 2  56 50 4F 4B          .byte   "VPOK",'E'|$80          ; $D5 VPOKE
002E65r 2  C5           
002E66r 2  56 52 45 C7          .byte   "VRE",'G'|$80           ; $D6 VREG
002E6Ar 2  50 41 4C 45          .byte   "PALETT",'E'|$80        ; $D7 PALETTE
002E6Er 2  54 54 C5     
002E71r 2  56 53 59 4E          .byte   "VSYN",'C'|$80          ; $D8 VSYNC
002E75r 2  C3           
002E76r 2  56 4C 4F 41          .byte   "VLOA",'D'|$80          ; $D9 VLOAD
002E7Ar 2  C4           
002E7Br 2  53 50 52 49          .byte   "SPRIT",'E'|$80         ; $DA SPRITE
002E7Fr 2  54 C5        
002E81r 2  53 43 52 4F          .byte   "SCROL",'L'|$80         ; $DB SCROLL
002E85r 2  4C CC        
002E87r 2  4C 41 59 45          .byte   "LAYE",'R'|$80          ; $DC LAYER
002E8Br 2  D2           
002E8Cr 2  4E 56 53 41          .byte   "NVSAV",'E'|$80         ; $DD NVSAVE
002E90r 2  56 C5        
002E92r 2  4E 56 4C 4F          .byte   "NVLOA",'D'|$80         ; $DE NVLOAD
002E96r 2  41 C4        
002E98r 2  4E 56 45 52          .byte   "NVERAS",'E'|$80        ; $DF NVERASE
002E9Cr 2  41 53 C5     
002E9Fr 2                       ; 2.0 functions
002E9Fr 2  56 50 45 45          .byte   "VPEE",'K'|$80          ; $E0 VPEEK
002EA3r 2  CB           
002EA4r 2  56 53 54 41          .byte   "VSTA",'T'|$80          ; $E1 VSTAT
002EA8r 2  D4           
002EA9r 2  4E 56 53 54          .byte   "NVSTA",'T'|$80         ; $E2 NVSTAT
002EADr 2  41 D4        
002EAFr 2  4E 56 46 49          .byte   "NVFIN",'D'|$80         ; $E3 NVFIND
002EB3r 2  4E C4        
002EB5r 2  00                   .byte   0
002EB6r 2               
002EB6r 2               ; =============================================================================
002EB6r 2               ;   E R R O R   M E S S A G E   T A B L E   (NUL-terminated strings)
002EB6r 2               ; =============================================================================
002EB6r 2               
002EB6r 2               ErrorMessages:
002EB6r 2  53 59 4E 54          .byte   "SYNTAX",0              ; ERR_SYNTAX
002EBAr 2  41 58 00     
002EBDr 2  4F 56 45 52          .byte   "OVERFLOW",0            ; ERR_OVERFLOW
002EC1r 2  46 4C 4F 57  
002EC5r 2  00           
002EC6r 2  4F 55 54 20          .byte   "OUT OF MEMORY",0       ; ERR_OUTOFMEM
002ECAr 2  4F 46 20 4D  
002ECEr 2  45 4D 4F 52  
002ED4r 2  55 4E 44 45          .byte   "UNDEF'D STATEMENT",0   ; ERR_UNDEFSTMT
002ED8r 2  46 27 44 20  
002EDCr 2  53 54 41 54  
002EE6r 2  42 41 44 20          .byte   "BAD SUBSCRIPT",0       ; ERR_BADSUBSCR
002EEAr 2  53 55 42 53  
002EEEr 2  43 52 49 50  
002EF4r 2  52 45 44 49          .byte   "REDIM'D ARRAY",0       ; ERR_REDIM
002EF8r 2  4D 27 44 20  
002EFCr 2  41 52 52 41  
002F02r 2  44 49 56 49          .byte   "DIVISION BY ZERO",0    ; ERR_DIVZERO
002F06r 2  53 49 4F 4E  
002F0Ar 2  20 42 59 20  
002F13r 2  49 4C 4C 45          .byte   "ILLEGAL DIRECT",0      ; ERR_ILLDIRECT
002F17r 2  47 41 4C 20  
002F1Br 2  44 49 52 45  
002F22r 2  54 59 50 45          .byte   "TYPE MISMATCH",0       ; ERR_TYPEMISM
002F26r 2  20 4D 49 53  
002F2Ar 2  4D 41 54 43  
002F30r 2  53 54 52 49          .byte   "STRING TOO LONG",0     ; ERR_LONGSTR
002F34r 2  4E 47 20 54  
002F38r 2  4F 4F 20 4C  
002F40r 2  46 4F 52 4D          .byte   "FORMULA TOO COMPLEX",0 ; ERR_FORMULA
002F44r 2  55 4C 41 20  
002F48r 2  54 4F 4F 20  
002F54r 2  49 4C 4C 45          .byte   "ILLEGAL QUANTITY",0    ; ERR_ILLQUAN
002F58r 2  47 41 4C 20  
002F5Cr 2  51 55 41 4E  
002F65r 2  52 45 54 55          .byte   "RETURN WITHOUT GOSUB",0; ERR_RG
002F69r 2  52 4E 20 57  
002F6Dr 2  49 54 48 4F  
002F7Ar 2  4E 45 58 54          .byte   "NEXT WITHOUT FOR",0    ; ERR_NF
002F7Er 2  20 57 49 54  
002F82r 2  48 4F 55 54  
002F8Br 2  4F 55 54 20          .byte   "OUT OF DATA",0         ; ERR_OD
002F8Fr 2  4F 46 20 44  
002F93r 2  41 54 41 00  
002F97r 2  4E 4F 20 44          .byte   "NO DEVICE",0           ; ERR_NODEV
002F9Br 2  45 56 49 43  
002F9Fr 2  45 00        
002FA1r 2  43 41 4E 27          .byte   "CAN'T CONTINUE",0      ; ERR_CANTCONT
002FA5r 2  54 20 43 4F  
002FA9r 2  4E 54 49 4E  
002FB0r 2               
002FB0r 2               ; =============================================================================
002FB0r 2               ;   S T R I N G   C O N S T A N T S
002FB0r 2               ; =============================================================================
002FB0r 2               
002FB0r 2               ; Built from the version equates rather than typed, so the header and
002FB0r 2               ; KernalVersion ($A07B) cannot disagree about which ROM this is.
002FB0r 2               MsgHeader:
002FB0r 2  36 35 30 32          .byte   .sprintf("6502 BIOS v%d.%d", BIOS_VERSION_MAJOR, BIOS_VERSION_MINOR),0
002FB4r 2  20 42 49 4F  
002FB8r 2  53 20 76 32  
002FBFr 2               
002FBFr 2               MsgBytesFreeNL:
002FBFr 2  20 42 59 54          .byte   " BYTES FREE",$0D,$0A,0
002FC3r 2  45 53 20 46  
002FC7r 2  52 45 45 0D  
002FCDr 2               
002FCDr 2               MsgOK:
002FCDr 2  4F 4B 0D 0A          .byte   "OK",$0D,$0A,0
002FD1r 2  00           
002FD2r 2               
002FD2r 2               MsgErrorWord:
002FD2r 2  20 45 52 52          .byte   " ERROR",0
002FD6r 2  4F 52 00     
002FD9r 2               
002FD9r 2               MsgInWord:
002FD9r 2  20 49 4E 20          .byte   " IN ",0
002FDDr 2  00           
002FDEr 2               
002FDEr 1               .segment "WOZMON"
000000r 1               .include "Wozmon.asm"
000000r 2               ; =============================================================================
000000r 2               ; WOZMON  —  Woz Monitor (Steve Wozniak's original Apple 1 monitor, ported)
000000r 2               ;             for AC6502 Homebrew Computer
000000r 2               ;
000000r 2               ;   ROM Region  :  $FF00-$FFF9  (250 bytes / $00FA)
000000r 2               ;   Segment     :  WOZMON
000000r 2               ;   Entry point :  WozMon  (first byte of segment = $FF00)
000000r 2               ;   Assembler   :  ca65  (cc65 toolchain)
000000r 2               ;   Linker cfg  :  BIOS.cfg
000000r 2               ;
000000r 2               ;   Commands    :  <addr>                        Examine
000000r 2               ;                   <addr>.<addr>                 Block examine
000000r 2               ;                   <addr>: <byte> [<byte> ...]   Store
000000r 2               ;                   <addr>R                        Run
000000r 2               ;
000000r 2               ;   Reachable from the Monitor with "G FF00" or from BASIC with "SYS $FF00".
000000r 2               ; =============================================================================
000000r 2               
000000r 2               WOZ_XAML  = $24               ; Last "opened" location Low
000000r 2               WOZ_XAMH  = $25               ; Last "opened" location High
000000r 2               WOZ_STL   = $26               ; Store address Low
000000r 2               WOZ_STH   = $27               ; Store address High
000000r 2               WOZ_L     = $28               ; Hex value parsing Low
000000r 2               WOZ_H     = $29               ; Hex value parsing High
000000r 2               WOZ_YSAV  = $2A               ; Used to see if hex value is given
000000r 2               WOZ_MODE  = $2B               ; $00=XAM, $7F=STOR, $AE=BLOCK XAM
000000r 2               WOZ_IN    = USER_VARS         ; Input buffer
000000r 2               
000000r 2               WozMon:
000000r 2  A9 1B          lda     #$1B                ; Begin with escape
000002r 2               
000002r 2               WozNotCr:
000002r 2  C9 08          cmp     #$08                ; Backspace key?
000004r 2  F0 18          beq     WozBackspace        ; Yes
000006r 2  C9 1B          cmp     #$1B                ; ESC?
000008r 2  F0 03          beq     WozEscape           ; Yes
00000Ar 2  C8             iny                         ; Advance text index
00000Br 2  10 14          bpl     WozNextchar         ; Auto ESC if line longer than 127
00000Dr 2               
00000Dr 2               WozEscape:
00000Dr 2  A9 5C          lda     #$5C                ; "\"
00000Fr 2  20 rr rr       jsr     WozEcho             ; Output it
000012r 2               
000012r 2               WozGetline:
000012r 2  A9 0D          lda     #$0D                ; Send CR
000014r 2  20 rr rr       jsr     WozEcho
000017r 2  A9 0A          lda     #$0A                ; Send LF
000019r 2  20 rr rr       jsr     WozEcho
00001Cr 2               
00001Cr 2  A0 01          ldy     #$01                ; Initialize text index
00001Er 2               WozBackspace:
00001Er 2  88             dey                         ; Back up text index
00001Fr 2  30 F1          bmi     WozGetline          ; Beyond start of line, reinitialize
000021r 2               
000021r 2               WozNextchar:
000021r 2  20 rr rr       jsr     Chrin               ; Get next character
000024r 2  90 FB          bcc     WozNextchar         ; No character found
000026r 2  99 00 04       sta     WOZ_IN,y            ; Add to text buffer
000029r 2  C9 0D          cmp     #$0D                ; CR?
00002Br 2  D0 D5          bne     WozNotCr            ; No
00002Dr 2               
00002Dr 2  A0 FF          ldy     #$FF                ; Reset text index
00002Fr 2  A9 00          lda     #$00                ; For XAM mode
000031r 2  AA             tax                         ; X=0
000032r 2               WozSetblock:
000032r 2  0A             asl
000033r 2               WozSetstor:
000033r 2  0A             asl                         ; Leaves $7B if setting STOR mode
000034r 2  85 2B          sta     WOZ_MODE            ; $00 = XAM, $74 = STOR, $B8 = BLOK XAM
000036r 2               WozBlskip:
000036r 2  C8             iny                         ; Advance text index
000037r 2               WozNextitem:
000037r 2  B9 00 04       lda     WOZ_IN,y            ; Get character
00003Ar 2  C9 0D          cmp     #$0D                ; CR?
00003Cr 2  F0 D4          beq     WozGetline          ; Yes, done this line
00003Er 2  C9 2E          cmp     #$2E                ; "."?
000040r 2  90 F4          bcc     WozBlskip           ; Skip delimiter
000042r 2  F0 EE          beq     WozSetblock         ; Set BLOCK XAM mode
000044r 2  C9 3A          cmp     #$3A                ; ":"?
000046r 2  F0 EB          beq     WozSetstor          ; Yes, set STOR mode
000048r 2  C9 52          cmp     #$52                ; "R"?
00004Ar 2  F0 3B          beq     WozRun              ; Yes, run user program
00004Cr 2  86 28          stx     WOZ_L               ; $00 -> L
00004Er 2  86 29          stx     WOZ_H               ;    and H
000050r 2  84 2A          sty     WOZ_YSAV            ; Save Y for comparison
000052r 2               
000052r 2               WozNexthex:
000052r 2  B9 00 04       lda     WOZ_IN,y            ; Get character for hex test
000055r 2  49 30          eor     #$30                ; Map digits to $0-9
000057r 2  C9 0A          cmp     #$0A                ; Digit?
000059r 2  90 06          bcc     WozDig              ; Yes
00005Br 2  69 88          adc     #$88                ; Map letter "A"-"F" to $FA-FF
00005Dr 2  C9 FA          cmp     #$FA                ; Hex letter?
00005Fr 2  90 11          bcc     WozNothex           ; No, character not hex
000061r 2               WozDig:
000061r 2  0A             asl
000062r 2  0A             asl                         ; Hex digit to MSD of A
000063r 2  0A             asl
000064r 2  0A             asl
000065r 2               
000065r 2  A2 04          ldx     #$04                ; Shift count
000067r 2               WozHexshift:
000067r 2  0A             asl                         ; Hex digit left, MSB to carry
000068r 2  26 28          rol     WOZ_L               ; Rotate into LSD
00006Ar 2  26 29          rol     WOZ_H               ; Rotate into MSD's
00006Cr 2  CA             dex                         ; Done 4 shifts?
00006Dr 2  D0 F8          bne     WozHexshift         ; No, loop
00006Fr 2  C8             iny                         ; Advance text index
000070r 2  D0 E0          bne     WozNexthex          ; Always taken. Check next character for hex
000072r 2               
000072r 2               WozNothex:
000072r 2  C4 2A          cpy     WOZ_YSAV            ; Check if L, H empty (no hex digits)
000074r 2  F0 97          beq     WozEscape           ; Yes, generate ESC sequence
000076r 2               
000076r 2  24 2B          bit     WOZ_MODE            ; Test MODE byte
000078r 2  50 16          bvc     WozNotstor          ; B6=0 is STOR, 1 is XAM and BLOCK XAM
00007Ar 2               
00007Ar 2  A5 28          lda     WOZ_L               ; LSD's of hex data
00007Cr 2  81 26          sta     (WOZ_STL,x)         ; Store current 'store index'
00007Er 2  E6 26          inc     WOZ_STL             ; Increment store index
000080r 2  D0 B5          bne     WozNextitem         ; Get next item (no carry)
000082r 2  E6 27          inc     WOZ_STH             ; Add carry to 'store index' high order
000084r 2               WozTonextitem:
000084r 2  4C rr rr       jmp     WozNextitem         ; Get next command item
000087r 2               
000087r 2               WozRun:
000087r 2  20 rr rr       jsr     WozJump             ; Begin executing at XAM index
00008Ar 2  4C rr rr       jmp     WozMon              ; After returning we reset
00008Dr 2               WozJump:
00008Dr 2  6C 24 00       jmp     (WOZ_XAML)          ; Run at current XAM index
000090r 2               
000090r 2               WozNotstor:
000090r 2  30 30          bmi     WozXamnext          ; B7 = 0 for XAM, 1 for BLOCK XAM
000092r 2               
000092r 2  A2 02          ldx     #$02                ; Byte count
000094r 2               WozSetadr:
000094r 2  B5 27          lda     WOZ_L-1,x           ; Copy hex data to
000096r 2  95 25          sta     WOZ_STL-1,x         ;  'store index'
000098r 2  95 23          sta     WOZ_XAML-1,x        ; And to 'XAM index'
00009Ar 2  CA             dex                         ; Next of 2 bytes
00009Br 2  D0 F7          bne     WozSetadr           ; Loop unless X = 0
00009Dr 2               
00009Dr 2               WozNxtprnt:
00009Dr 2  D0 19          bne     WozPrdata           ; NE means no address to print
00009Fr 2  A9 0D          lda     #$0D                ; CR
0000A1r 2  20 rr rr       jsr     WozEcho             ; Output it
0000A4r 2  A9 0A          lda     #$0A                ; LF
0000A6r 2  20 rr rr       jsr     WozEcho             ; Output it
0000A9r 2  A5 25          lda     WOZ_XAMH            ; 'Examine index' high-order byte
0000ABr 2  20 rr rr       jsr     WozPrbyte           ; Output it in hex format
0000AEr 2  A5 24          lda     WOZ_XAML            ; Low-order 'examine index' byte
0000B0r 2  20 rr rr       jsr     WozPrbyte           ; Output it in hex format
0000B3r 2  A9 3A          lda     #$3A                ; ":"
0000B5r 2  20 rr rr       jsr     WozEcho             ; Output it
0000B8r 2               
0000B8r 2               WozPrdata:
0000B8r 2  A9 20          lda     #$20                ; Blank
0000BAr 2  20 rr rr       jsr     WozEcho             ; Output it
0000BDr 2  A1 24          lda     (WOZ_XAML,x)        ; Get data byte at 'examine index'
0000BFr 2  20 rr rr       jsr     WozPrbyte           ; Output it in hex format
0000C2r 2               WozXamnext:
0000C2r 2  86 2B          stx     WOZ_MODE            ; 0 -> MODE (XAM mode)
0000C4r 2  A5 24          lda     WOZ_XAML
0000C6r 2  C5 28          cmp     WOZ_L               ; Compare 'examine index' to hex data
0000C8r 2  A5 25          lda     WOZ_XAMH
0000CAr 2  E5 29          sbc     WOZ_H
0000CCr 2  B0 B6          bcs     WozTonextitem       ; Not less, so no more data to output
0000CEr 2               
0000CEr 2  E6 24          inc     WOZ_XAML
0000D0r 2  D0 02          bne     WozMod8chk          ; Increment 'examine index'
0000D2r 2  E6 25          inc     WOZ_XAMH
0000D4r 2               
0000D4r 2               WozMod8chk:
0000D4r 2  A5 24          lda     WOZ_XAML            ; Check low-order 'examine index' byte
0000D6r 2  29 07          and     #$07                ; For MOD 8 = 0
0000D8r 2  10 C3          bpl     WozNxtprnt          ; Always taken
0000DAr 2               
0000DAr 2               WozPrbyte:
0000DAr 2  48             pha                         ; Save A for LSD
0000DBr 2  4A             lsr
0000DCr 2  4A             lsr
0000DDr 2  4A             lsr                         ; MSD to LSD position
0000DEr 2  4A             lsr
0000DFr 2  20 rr rr       jsr     WozPrhex            ; Output hex digit
0000E2r 2  68             pla                         ; Restore A
0000E3r 2               
0000E3r 2               WozPrhex:
0000E3r 2  29 0F          and     #$0F                ; Mask LSD for hex print
0000E5r 2  09 30          ora     #$30                ; Add "0"
0000E7r 2  C9 3A          cmp     #$3A                ; Digit?
0000E9r 2  90 02          bcc     WozEcho             ; Yes, output it
0000EBr 2  69 06          adc     #$06                ; Add offset for letter
0000EDr 2               
0000EDr 2               WozEcho:
0000EDr 2  20 rr rr       jsr Chrout                  ; Output the character
0000F0r 2  60             rts                         ; Return
0000F1r 2               
0000F1r 1               .segment "VECTORS"
000000r 1               .include "Vectors.asm"
000000r 2               ; =============================================================================
000000r 2               ; VECTORS  —  Hardware Interrupt Vectors (NMI / RESET / IRQ)
000000r 2               ;              for AC6502 Homebrew Computer
000000r 2               ;
000000r 2               ;   ROM Region  :  $FFFA-$FFFF  (6 bytes / $0006)
000000r 2               ;   Segment     :  VECTORS
000000r 2               ;   Assembler   :  ca65  (cc65 toolchain)
000000r 2               ;   Linker cfg  :  BIOS.cfg
000000r 2               ;
000000r 2               ;   Contents    :  Three .word entries read by the 65C02 at reset/interrupt
000000r 2               ;                   time. Targets (NmiVec, ResetVec, IrqVec) are defined in
000000r 2               ;                   Kernal.asm.
000000r 2               ; =============================================================================
000000r 2               
000000r 2  rr rr        .word   NmiVec           ; NMI vector
000002r 2  rr rr        .word   ResetVec         ; RESET vector
000004r 2  rr rr        .word   IrqVec           ; IRQ vector
000006r 2               
000006r 1               
