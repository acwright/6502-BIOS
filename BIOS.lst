0008E1r 2  20 rr rr       jsr MonPrintHex2
0008E4r 2  80 09          bra @AfterBytes
0008E6r 2               @Pad2:
0008E6r 2  20 rr rr       jsr MonPrintSpace
0008E9r 2  20 rr rr       jsr MonPrintSpace
0008ECr 2  20 rr rr       jsr MonPrintSpace
0008EFr 2               @AfterBytes:
0008EFr 2                 ; Separator before mnemonic
0008EFr 2  20 rr rr       jsr MonPrintSpace
0008F2r 2  20 rr rr       jsr MonPrintSpace
0008F5r 2                 ; Print mnemonic (3 chars)
0008F5r 2  20 rr rr       jsr DisPrintMnemonic
0008F8r 2                 ; For RMB/SMB/BBR/BBS, append bit number digit
0008F8r 2  A5 32          lda MON_TMP
0008FAr 2  C9 03          cmp #MN_BBR
0008FCr 2  F0 11          beq @BitNum
0008FEr 2  C9 04          cmp #MN_BBS
000900r 2  F0 0D          beq @BitNum
