0011AEr 2  A9 29                lda     #')'
0011B0r 2  80 F3                bra     SynChr
0011B2r 2               
0011B2r 2               ChkOpn:
0011B2r 2  A9 28                lda     #'('
0011B4r 2  80 EF                bra     SynChr
0011B6r 2               
