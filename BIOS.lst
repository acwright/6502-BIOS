002DC0r 2               
002DC0r 1               .segment "MONITOR"
000000r 1               .include "Monitor.asm"
000000r 2               ; ***             ***
000000r 2               ; ***   MONITOR   ***
000000r 2               ; ***             ***
000000r 2               
000000r 2               ; Machine Code Monitor — Supermon-style command set
000000r 2               ; Segment: $EE00-$FEFF (~4KB)
000000r 2               ;
000000r 2               ; Entry points:
000000r 2               ;   MonitorEntry    ($EE00) — Cold entry from boot menu or X return
000000r 2               ;   MonitorBrkEntry ($EE03) — BRK entry with register display
000000r 2               
000000r 2               ; ============================================================================
000000r 2               ; Monitor Constants
000000r 2               ; ============================================================================
000000r 2               
000000r 2               MON_LINBUF          = BAS_LINBUF         ; Share BASIC's line buffer ($0434)
000000r 2               MON_LINBUF_SIZE     = 200                ; Max input line length
000000r 2               MON_PROMPT          = '.'                ; Supermon-style prompt character
000000r 2               
000000r 2               ; Mnemonic Indices (for disassembler)
000000r 2               MN_ADC = 0
000000r 2               MN_AND = 1
000000r 2               MN_ASL = 2
000000r 2               MN_BBR = 3
000000r 2               MN_BBS = 4
000000r 2               MN_BCC = 5
000000r 2               MN_BCS = 6
000000r 2               MN_BEQ = 7
000000r 2               MN_BIT = 8
000000r 2               MN_BMI = 9
000000r 2               MN_BNE = 10
000000r 2               MN_BPL = 11
000000r 2               MN_BRA = 12
000000r 2               MN_BRK = 13
000000r 2               MN_BVC = 14
000000r 2               MN_BVS = 15
000000r 2               MN_CLC = 16
000000r 2               MN_CLD = 17
000000r 2               MN_CLI = 18
000000r 2               MN_CLV = 19
000000r 2               MN_CMP = 20
000000r 2               MN_CPX = 21
000000r 2               MN_CPY = 22
000000r 2               MN_DEC = 23
000000r 2               MN_DEX = 24
000000r 2               MN_DEY = 25
000000r 2               MN_EOR = 26
000000r 2               MN_INC = 27
000000r 2               MN_INX = 28
000000r 2               MN_INY = 29
000000r 2               MN_JMP = 30
000000r 2               MN_JSR = 31
000000r 2               MN_LDA = 32
000000r 2               MN_LDX = 33
000000r 2               MN_LDY = 34
000000r 2               MN_LSR = 35
000000r 2               MN_NOP = 36
000000r 2               MN_ORA = 37
000000r 2               MN_PHA = 38
000000r 2               MN_PHP = 39
000000r 2               MN_PHX = 40
000000r 2               MN_PHY = 41
000000r 2               MN_PLA = 42
000000r 2               MN_PLP = 43
000000r 2               MN_PLX = 44
000000r 2               MN_PLY = 45
000000r 2               MN_RMB = 46
000000r 2               MN_ROL = 47
000000r 2               MN_ROR = 48
000000r 2               MN_RTI = 49
000000r 2               MN_RTS = 50
000000r 2               MN_SBC = 51
000000r 2               MN_SEC = 52
000000r 2               MN_SED = 53
000000r 2               MN_SEI = 54
000000r 2               MN_SMB = 55
000000r 2               MN_STA = 56
000000r 2               MN_STP = 57
000000r 2               MN_STX = 58
000000r 2               MN_STY = 59
000000r 2               MN_STZ = 60
000000r 2               MN_TAX = 61
000000r 2               MN_TAY = 62
000000r 2               MN_TRB = 63
000000r 2               MN_TSB = 64
000000r 2               MN_TSX = 65
000000r 2               MN_TXA = 66
000000r 2               MN_TXS = 67
000000r 2               MN_TYA = 68
000000r 2               MN_WAI = 69
000000r 2               MN_UND = 70
000000r 2               
000000r 2               ; Addressing Mode Indices
000000r 2               AM_IMP = 0
000000r 2               AM_ACC = 1
000000r 2               AM_IMM = 2
000000r 2               AM_ZP  = 3
000000r 2               AM_ZPX = 4
000000r 2               AM_ZPY = 5
000000r 2               AM_ABS = 6
000000r 2               AM_ABX = 7
000000r 2               AM_ABY = 8
000000r 2               AM_IND = 9
000000r 2               AM_IZX = 10
000000r 2               AM_IZY = 11
000000r 2               AM_ZPI = 12
000000r 2               AM_REL = 13
000000r 2               AM_ZPR = 14
000000r 2               AM_AIX = 15
000000r 2               
000000r 2               ; ============================================================================
000000r 2               ; Entry Points
000000r 2               ; ============================================================================
000000r 2               
000000r 2               MonitorEntry:
000000r 2  4C rr rr       jmp MonColdEntry              ; $EE00 - Cold entry (boot menu / return)
000003r 2               
000003r 2               MonitorBrkEntry:
000003r 2  4C rr rr       jmp MonBrkEntry               ; $C003 - BRK entry (register display)
000006r 2               
000006r 2               ; ============================================================================
000006r 2               ; Cold Entry — print banner and enter command loop
000006r 2               ; ============================================================================
000006r 2               
000006r 2               MonColdEntry:
000006r 2  A2 FF          ldx #$FF
000008r 2  9A             txs                           ; Reset stack pointer
000009r 2  D8             cld                           ; Ensure binary mode
00000Ar 2  20 rr rr       jsr VideoClear                ; Clear screen
00000Dr 2  20 rr rr       jsr MonPrintBanner            ; Print "MONITOR" banner
000010r 2  4C rr rr       jmp MonCmdLoop
000013r 2               
000013r 2               ; ============================================================================
000013r 2               ; BRK Entry — print BRK address, display registers, enter command loop
000013r 2               ; ============================================================================
000013r 2               
000013r 2               MonBrkEntry:
000013r 2  A2 FF          ldx #$FF
000015r 2  9A             txs                           ; Reset stack pointer
000016r 2  D8             cld
000017r 2  20 rr rr       jsr VideoClear                ; Clear screen
00001Ar 2  20 rr rr       jsr MonPrintBanner            ; Print "MONITOR" banner
00001Dr 2                 ; Print "BRK AT $"
00001Dr 2  A2 00          ldx #0
00001Fr 2               @BrkMsgLoop:
00001Fr 2  BD rr rr       lda MonStrBrk,x
000022r 2  F0 06          beq @BrkMsgDone
000024r 2  20 rr rr       jsr Chrout
000027r 2  E8             inx
000028r 2  80 F5          bra @BrkMsgLoop
00002Ar 2               @BrkMsgDone:
00002Ar 2                 ; Print PC address (adjusted: BRK_PC points to BRK+2, subtract 2 for actual BRK location)
00002Ar 2  38             sec
00002Br 2  AD 11 03       lda BRK_PCL
00002Er 2  E9 02          sbc #2
000030r 2  85 2E          sta MON_ADDR
000032r 2  AD 12 03       lda BRK_PCH
000035r 2  E9 00          sbc #0
000037r 2  85 2F          sta MON_ADDR + 1
000039r 2  20 rr rr       jsr MonPrintHex4
00003Cr 2  20 rr rr       jsr MonPrintCRLF
00003Fr 2                 ; Display registers
00003Fr 2  20 rr rr       jsr MonShowRegs
000042r 2  4C rr rr       jmp MonCmdLoop
000045r 2               
000045r 2               ; ============================================================================
000045r 2               ; Command Loop — prompt, read, parse, dispatch
000045r 2               ; ============================================================================
000045r 2               
000045r 2               MonCmdLoop:
000045r 2                 ; Print prompt
000045r 2  A9 2E          lda #MON_PROMPT
000047r 2  20 rr rr       jsr Chrout
00004Ar 2  A9 20          lda #' '
00004Cr 2  20 rr rr       jsr Chrout
00004Fr 2               
00004Fr 2                 ; Read input line
00004Fr 2  20 rr rr       jsr MonReadLine
000052r 2               
000052r 2                 ; Parse and dispatch
000052r 2  20 rr rr       jsr MonParseLine
000055r 2               
000055r 2                 ; Loop back for next command
000055r 2  4C rr rr       jmp MonCmdLoop
000058r 2               
000058r 2               ; ============================================================================
000058r 2               ; MonReadLine — Read a line of input into MON_LINBUF
000058r 2               ; Returns: MON_LINBUF contains null-terminated input, Y = length
000058r 2               ; ============================================================================
000058r 2               
000058r 2               MonReadLine:
000058r 2  A0 00          ldy #0                        ; Index into line buffer
00005Ar 2               @ReadWait:
00005Ar 2  20 rr rr       jsr Chrin                     ; Try to read a character (carry set = got one)
00005Dr 2  90 FB          bcc @ReadWait                 ; No char available, keep waiting
00005Fr 2                 ; Got a character in A
00005Fr 2  C9 0D          cmp #$0D                      ; Carriage return?
000061r 2  F0 21          beq @ReadDone
000063r 2  C9 0A          cmp #$0A                      ; Line feed? (treat same as CR)
000065r 2  F0 1D          beq @ReadDone
000067r 2  C9 08          cmp #$08                      ; Backspace?
000069r 2  F0 12          beq @ReadBS
00006Br 2  C9 7F          cmp #$7F                      ; Delete? (treat as backspace)
00006Dr 2  F0 0E          beq @ReadBS
00006Fr 2                 ; Skip non-printable characters ($00-$1F)
00006Fr 2  C9 20          cmp #$20
000071r 2  90 E7          bcc @ReadWait
000073r 2                 ; Printable character — store if room
000073r 2  C0 C8          cpy #MON_LINBUF_SIZE
000075r 2  B0 E3          bcs @ReadWait                 ; Buffer full, ignore
000077r 2  99 00 04       sta MON_LINBUF,y
00007Ar 2  C8             iny
00007Br 2  80 DD          bra @ReadWait
00007Dr 2               @ReadBS:
00007Dr 2  C0 00          cpy #0                        ; Anything to delete?
00007Fr 2  F0 D9          beq @ReadWait                 ; No, ignore
000081r 2  88             dey                           ; Back up one position
000082r 2  80 D6          bra @ReadWait
000084r 2               @ReadDone:
000084r 2  A9 0D          lda #$0D                      ; Echo CR
000086r 2  20 rr rr       jsr Chrout
000089r 2  A9 0A          lda #$0A                      ; Echo LF
00008Br 2  20 rr rr       jsr Chrout
00008Er 2  A9 00          lda #0
000090r 2  99 00 04       sta MON_LINBUF,y              ; Null-terminate
000093r 2  60             rts
000094r 2               
000094r 2               ; ============================================================================
000094r 2               ; MonParseLine — Parse first char and dispatch to command handler
000094r 2               ; ============================================================================
000094r 2               
000094r 2               MonParseLine:
000094r 2  64 35          stz MON_IDX                   ; Reset parse index
000096r 2  20 rr rr       jsr MonSkipSpaces             ; Skip leading whitespace
000099r 2  A4 35          ldy MON_IDX
00009Br 2  B9 00 04       lda MON_LINBUF,y              ; Get command character
00009Er 2  F0 2A          beq @ParseDone                ; Empty line — just return
0000A0r 2                 ; Convert to uppercase
0000A0r 2  C9 61          cmp #'a'
0000A2r 2  90 06          bcc @ParseNoConv
0000A4r 2  C9 7B          cmp #'z'+1
0000A6r 2  B0 02          bcs @ParseNoConv
0000A8r 2  29 DF          and #$DF                      ; Convert lowercase to uppercase
0000AAr 2               @ParseNoConv:
0000AAr 2  E6 35          inc MON_IDX                   ; Advance past command char
0000ACr 2                 ; Search dispatch table
0000ACr 2  A2 00          ldx #0
0000AEr 2               @DispatchLoop:
0000AEr 2  BC rr rr       ldy MonCmdTable,x             ; Load command character from table
0000B1r 2  F0 14          beq @ParseError               ; End of table (null terminator) — unknown command
0000B3r 2  DD rr rr       cmp MonCmdTable,x             ; Compare with input character
0000B6r 2  F0 05          beq @DispatchFound
0000B8r 2  E8             inx                           ; Skip char
0000B9r 2  E8             inx                           ; Skip address low
0000BAr 2  E8             inx                           ; Skip address high
0000BBr 2  80 F1          bra @DispatchLoop
0000BDr 2               @DispatchFound:
0000BDr 2  E8             inx                           ; Point to address low byte
0000BEr 2  BD rr rr       lda MonCmdTable+1,x           ; Handler address high byte — push first (big-endian on stack)
0000C1r 2  48             pha
0000C2r 2  BD rr rr       lda MonCmdTable,x             ; Handler address low byte
0000C5r 2  48             pha
0000C6r 2  60             rts                           ; "Return" to handler address (RTS adds 1 to address)
0000C7r 2               @ParseError:
0000C7r 2  20 rr rr       jsr MonPrintError
0000CAr 2               @ParseDone:
0000CAr 2  60             rts
0000CBr 2               
0000CBr 2               ; ============================================================================
0000CBr 2               ; Command Dispatch Table
0000CBr 2               ; Format: command char (1 byte), handler address - 1 (2 bytes, low/high for RTS trick)
0000CBr 2               ; ============================================================================
0000CBr 2               
0000CBr 2               MonCmdTable:
0000CBr 2  58             .byte 'X'
0000CCr 2  rr rr          .word MonCmdX - 1
0000CEr 2  52             .byte 'R'
0000CFr 2  rr rr          .word MonCmdR - 1
0000D1r 2  4D             .byte 'M'
0000D2r 2  rr rr          .word MonCmdM - 1
0000D4r 2  44             .byte 'D'
0000D5r 2  rr rr          .word MonCmdD - 1
0000D7r 2  3E             .byte '>'
0000D8r 2  rr rr          .word MonCmdDeposit - 1
0000DAr 2  46             .byte 'F'
0000DBr 2  rr rr          .word MonCmdFill - 1
0000DDr 2  54             .byte 'T'
0000DEr 2  rr rr          .word MonCmdTransfer - 1
0000E0r 2  48             .byte 'H'
0000E1r 2  rr rr          .word MonCmdHunt - 1
0000E3r 2  43             .byte 'C'
0000E4r 2  rr rr          .word MonCmdCompare - 1
0000E6r 2  47             .byte 'G'
0000E7r 2  rr rr          .word MonCmdGo - 1
0000E9r 2  4A             .byte 'J'
0000EAr 2  rr rr          .word MonCmdJsr - 1
0000ECr 2  3B             .byte ';'
0000EDr 2  rr rr          .word MonCmdModRegs - 1
0000EFr 2  4C             .byte 'L'
0000F0r 2  rr rr          .word MonCmdLoad - 1
0000F2r 2  53             .byte 'S'
0000F3r 2  rr rr          .word MonCmdSave - 1
0000F5r 2  40             .byte '@'
0000F6r 2  rr rr          .word MonCmdDir - 1
0000F8r 2  4E             .byte 'N'
0000F9r 2  rr rr          .word MonCmdNum - 1
0000FBr 2  23             .byte '#'
0000FCr 2  rr rr          .word MonCmdDisk - 1
0000FEr 2  00             .byte 0                       ; End of table sentinel
0000FFr 2               
0000FFr 2               ; ============================================================================
0000FFr 2               ; MonCmdX — Exit to BASIC
0000FFr 2               ; ============================================================================
0000FFr 2               
0000FFr 2               MonCmdX:
0000FFr 2  20 rr rr       jsr VideoClear                ; Clear screen before entering BASIC
000102r 2  4C rr rr       jmp BasEntry
000105r 2               
000105r 2               ; ============================================================================
000105r 2               ; MonCmdR — Display CPU registers
000105r 2               ; ============================================================================
000105r 2               
000105r 2               MonCmdR:
000105r 2  20 rr rr       jsr MonShowRegs
000108r 2  60             rts
000109r 2               
000109r 2               ; ============================================================================
000109r 2               ; MonCmdDeposit — Deposit (write) bytes to memory
000109r 2               ; Syntax: > ADDR XX [XX XX ...]
000109r 2               ; ============================================================================
000109r 2               
000109r 2               MonCmdDeposit:
000109r 2  20 rr rr       jsr MonSkipSpaces
00010Cr 2  20 rr rr       jsr MonParseHex4              ; Parse target address into MON_ADDR
00010Fr 2  90 16          bcc @DepError                 ; No address → error
000111r 2  A0 00          ldy #0                        ; Byte offset from MON_ADDR
000113r 2               @DepLoop:
000113r 2  5A             phy                           ; Save byte offset (Y clobbered by parse routines)
000114r 2  20 rr rr       jsr MonSkipSpaces
000117r 2  20 rr rr       jsr MonParseHex2              ; Parse next byte into A
00011Ar 2  7A             ply                           ; Restore byte offset (PLY doesn't affect carry)
00011Br 2  90 05          bcc @DepDone                  ; No more bytes → done
00011Dr 2  91 2E          sta (MON_ADDR),y
00011Fr 2  C8             iny
000120r 2  D0 F1          bne @DepLoop                  ; Up to 256 bytes (Y wraps)
000122r 2               @DepDone:
000122r 2  C0 00          cpy #0                        ; Did we deposit at least one byte?
000124r 2  F0 01          beq @DepError                 ; No bytes given → error
000126r 2  60             rts
000127r 2               @DepError:
000127r 2  4C rr rr       jmp MonPrintError
00012Ar 2               
00012Ar 2               ; ============================================================================
00012Ar 2               ; MonCmdFill — Fill memory range with a byte value
00012Ar 2               ; Syntax: F ADDR1 ADDR2 XX
00012Ar 2               ; ============================================================================
00012Ar 2               
00012Ar 2               MonCmdFill:
00012Ar 2  20 rr rr       jsr MonSkipSpaces
00012Dr 2  20 rr rr       jsr MonParseHex4              ; Parse start address → MON_ADDR
000130r 2  90 43          bcc @FillError
000132r 2  A5 2E          lda MON_ADDR
000134r 2  85 32          sta MON_TMP
000136r 2  A5 2F          lda MON_ADDR+1
000138r 2  85 33          sta MON_TMP+1                 ; Save start in MON_TMP
00013Ar 2  20 rr rr       jsr MonSkipSpaces
00013Dr 2  20 rr rr       jsr MonParseHex4              ; Parse end address → MON_ADDR
000140r 2  90 33          bcc @FillError
000142r 2  A5 2E          lda MON_ADDR
000144r 2  85 30          sta MON_END
000146r 2  A5 2F          lda MON_ADDR+1
000148r 2  85 31          sta MON_END+1                 ; Save end in MON_END
00014Ar 2                 ; Restore start into MON_ADDR
00014Ar 2  A5 32          lda MON_TMP
00014Cr 2  85 2E          sta MON_ADDR
00014Er 2  A5 33          lda MON_TMP+1
000150r 2  85 2F          sta MON_ADDR+1
000152r 2  20 rr rr       jsr MonSkipSpaces
000155r 2  20 rr rr       jsr MonParseHex2              ; Parse fill byte → A
000158r 2  90 1B          bcc @FillError
00015Ar 2                 ; A = fill byte, MON_ADDR = start, MON_END = end (inclusive)
00015Ar 2  A0 00          ldy #0
00015Cr 2               @FillLoop:
00015Cr 2  91 2E          sta (MON_ADDR),y
00015Er 2                 ; Check if MON_ADDR == MON_END
00015Er 2  A6 2F          ldx MON_ADDR+1
000160r 2  E4 31          cpx MON_END+1
000162r 2  D0 06          bne @FillNext
000164r 2  A6 2E          ldx MON_ADDR
000166r 2  E4 30          cpx MON_END
000168r 2  F0 0A          beq @FillDone
00016Ar 2               @FillNext:
00016Ar 2                 ; Advance MON_ADDR
00016Ar 2  48             pha                           ; Save fill byte
00016Br 2  E6 2E          inc MON_ADDR
00016Dr 2  D0 02          bne @FillNoHi
00016Fr 2  E6 2F          inc MON_ADDR+1
000171r 2               @FillNoHi:
000171r 2  68             pla                           ; Restore fill byte
000172r 2  80 E8          bra @FillLoop
000174r 2               @FillDone:
000174r 2  60             rts
000175r 2               @FillError:
000175r 2  4C rr rr       jmp MonPrintError
000178r 2               
000178r 2               ; ============================================================================
000178r 2               ; MonCmdTransfer — Copy memory block (handles overlapping regions)
000178r 2               ; Syntax: T SRC_START SRC_END DEST
000178r 2               ; ============================================================================
000178r 2               
000178r 2               MonCmdTransfer:
000178r 2  20 rr rr       jsr MonSkipSpaces
00017Br 2  20 rr rr       jsr MonParseHex4              ; Parse source start → MON_ADDR
00017Er 2  B0 03          bcs @XferGotStart
000180r 2  4C rr rr       jmp @XferError                ; No address → error
000183r 2               @XferGotStart:
000183r 2  A5 2E          lda MON_ADDR
000185r 2  85 32          sta MON_TMP
000187r 2  A5 2F          lda MON_ADDR+1
000189r 2  85 33          sta MON_TMP+1                 ; MON_TMP = source start
00018Br 2  20 rr rr       jsr MonSkipSpaces
00018Er 2  20 rr rr       jsr MonParseHex4              ; Parse source end → MON_ADDR
000191r 2  B0 03          bcs @XferGotEnd
000193r 2  4C rr rr       jmp @XferError
000196r 2               @XferGotEnd:
000196r 2  A5 2E          lda MON_ADDR
000198r 2  85 30          sta MON_END
00019Ar 2  A5 2F          lda MON_ADDR+1
00019Cr 2  85 31          sta MON_END+1                 ; MON_END = source end (inclusive)
00019Er 2  20 rr rr       jsr MonSkipSpaces
0001A1r 2  20 rr rr       jsr MonParseHex4              ; Parse dest → MON_ADDR
0001A4r 2  B0 03          bcs @XferGotDest
0001A6r 2  4C rr rr       jmp @XferError
0001A9r 2               @XferGotDest:
0001A9r 2                 ; MON_ADDR = dest, MON_TMP = src start, MON_END = src end
0001A9r 2                 ; Determine copy direction: if dest > src_start, copy backward to handle overlap
0001A9r 2  A5 2F          lda MON_ADDR+1
0001ABr 2  C5 33          cmp MON_TMP+1
0001ADr 2  90 5C          bcc @CopyForward              ; dest < src → forward is safe
0001AFr 2  D0 08          bne @CopyBackward             ; dest > src → need backward
0001B1r 2  A5 2E          lda MON_ADDR
0001B3r 2  C5 32          cmp MON_TMP
0001B5r 2  90 54          bcc @CopyForward
0001B7r 2  F0 72          beq @XferDone                 ; dest == src → nothing to do
0001B9r 2               @CopyBackward:
0001B9r 2                 ; Compute offset = src_end - src_start
0001B9r 2  38             sec
0001BAr 2  A5 30          lda MON_END
0001BCr 2  E5 32          sbc MON_TMP
0001BEr 2  85 34          sta MON_BYTE                  ; low byte of offset
0001C0r 2  A5 31          lda MON_END+1
0001C2r 2  E5 33          sbc MON_TMP+1
0001C4r 2  85 35          sta MON_IDX                   ; high byte of offset (reuse MON_IDX as scratch)
0001C6r 2                 ; Point MON_TMP to src_end, MON_ADDR to dest + offset
0001C6r 2                 ; MON_TMP already needs to be src_end (currently src_start)
0001C6r 2                 ; Swap: MON_TMP = MON_END (src_end)
0001C6r 2  A5 30          lda MON_END
0001C8r 2  48             pha
0001C9r 2  A5 31          lda MON_END+1
0001CBr 2  48             pha
0001CCr 2                 ; MON_END = src_start (save for later comparison)
0001CCr 2  A5 32          lda MON_TMP
0001CEr 2  85 30          sta MON_END
0001D0r 2  A5 33          lda MON_TMP+1
0001D2r 2  85 31          sta MON_END+1
0001D4r 2                 ; MON_TMP = src_end
0001D4r 2  68             pla
0001D5r 2  85 33          sta MON_TMP+1
0001D7r 2  68             pla
0001D8r 2  85 32          sta MON_TMP
0001DAr 2                 ; dest_end = MON_ADDR + offset
0001DAr 2  18             clc
0001DBr 2  A5 2E          lda MON_ADDR
0001DDr 2  65 34          adc MON_BYTE
0001DFr 2  85 2E          sta MON_ADDR
0001E1r 2  A5 2F          lda MON_ADDR+1
0001E3r 2  65 35          adc MON_IDX
0001E5r 2  85 2F          sta MON_ADDR+1
0001E7r 2               @BackLoop:
0001E7r 2  A0 00          ldy #0
0001E9r 2  B1 32          lda (MON_TMP),y
0001EBr 2  91 2E          sta (MON_ADDR),y
0001EDr 2                 ; Check if MON_TMP == MON_END (src start, our stop address)
0001EDr 2  A5 33          lda MON_TMP+1
0001EFr 2  C5 31          cmp MON_END+1
0001F1r 2  D0 06          bne @BackDec
0001F3r 2  A5 32          lda MON_TMP
0001F5r 2  C5 30          cmp MON_END
0001F7r 2  F0 32          beq @XferDone
0001F9r 2               @BackDec:
0001F9r 2                 ; Decrement both pointers
0001F9r 2  A5 32          lda MON_TMP
0001FBr 2  D0 02          bne @BackDecTmpLo
0001FDr 2  C6 33          dec MON_TMP+1
0001FFr 2               @BackDecTmpLo:
0001FFr 2  C6 32          dec MON_TMP
000201r 2  A5 2E          lda MON_ADDR
000203r 2  D0 02          bne @BackDecDstLo
000205r 2  C6 2F          dec MON_ADDR+1
000207r 2               @BackDecDstLo:
000207r 2  C6 2E          dec MON_ADDR
000209r 2  80 DC          bra @BackLoop
00020Br 2               
00020Br 2               @CopyForward:
00020Br 2                 ; Copy from MON_TMP (src) to MON_ADDR (dest), up to MON_END (src end)
00020Br 2  A0 00          ldy #0
00020Dr 2               @FwdLoop:
00020Dr 2  B1 32          lda (MON_TMP),y
00020Fr 2  91 2E          sta (MON_ADDR),y
000211r 2                 ; Check if MON_TMP == MON_END
000211r 2  A5 33          lda MON_TMP+1
000213r 2  C5 31          cmp MON_END+1
000215r 2  D0 06          bne @FwdNext
000217r 2  A5 32          lda MON_TMP
000219r 2  C5 30          cmp MON_END
00021Br 2  F0 0E          beq @XferDone
00021Dr 2               @FwdNext:
00021Dr 2                 ; Advance both pointers
00021Dr 2  E6 32          inc MON_TMP
00021Fr 2  D0 02          bne @FwdNoDstCarry
000221r 2  E6 33          inc MON_TMP+1
000223r 2               @FwdNoDstCarry:
000223r 2  E6 2E          inc MON_ADDR
000225r 2  D0 E6          bne @FwdLoop
000227r 2  E6 2F          inc MON_ADDR+1
000229r 2  80 E2          bra @FwdLoop
00022Br 2               
00022Br 2               @XferDone:
00022Br 2  60             rts
00022Cr 2               @XferError:
00022Cr 2  4C rr rr       jmp MonPrintError
00022Fr 2               
00022Fr 2               ; ============================================================================
00022Fr 2               ; MonCmdHunt — Search for byte pattern in memory range
00022Fr 2               ; Syntax: H ADDR1 ADDR2 XX [XX XX ...]
00022Fr 2               ; Prints address of each match on its own line.
00022Fr 2               ; ============================================================================
00022Fr 2               
00022Fr 2               ; Hunt uses a temp buffer at end of MON_LINBUF area for the pattern.
00022Fr 2               ; Pattern bytes stored at MON_LINBUF+128, max 64 pattern bytes.
00022Fr 2               MON_HUNT_PAT        = MON_LINBUF + 128
00022Fr 2               MON_HUNT_PAT_MAX    = 64
00022Fr 2               
00022Fr 2               MonCmdHunt:
00022Fr 2  20 rr rr       jsr MonSkipSpaces
000232r 2  20 rr rr       jsr MonParseHex4              ; Parse start address → MON_ADDR
000235r 2  90 65          bcc @HuntError
000237r 2  A5 2E          lda MON_ADDR
000239r 2  85 32          sta MON_TMP
00023Br 2  A5 2F          lda MON_ADDR+1
00023Dr 2  85 33          sta MON_TMP+1                 ; MON_TMP = search start
00023Fr 2  20 rr rr       jsr MonSkipSpaces
000242r 2  20 rr rr       jsr MonParseHex4              ; Parse end address → MON_ADDR
000245r 2  90 55          bcc @HuntError
000247r 2  A5 2E          lda MON_ADDR
000249r 2  85 30          sta MON_END
00024Br 2  A5 2F          lda MON_ADDR+1
00024Dr 2  85 31          sta MON_END+1                 ; MON_END = search end
00024Fr 2                 ; Restore start
00024Fr 2  A5 32          lda MON_TMP
000251r 2  85 2E          sta MON_ADDR
000253r 2  A5 33          lda MON_TMP+1
000255r 2  85 2F          sta MON_ADDR+1
000257r 2                 ; Parse pattern bytes into MON_HUNT_PAT
000257r 2  A2 00          ldx #0                        ; Pattern length counter
000259r 2               @HuntParseByte:
000259r 2  DA             phx                           ; Save pattern counter (X clobbered by MonParseHex2)
00025Ar 2  20 rr rr       jsr MonSkipSpaces
00025Dr 2  20 rr rr       jsr MonParseHex2              ; Next byte → A
000260r 2  FA             plx                           ; Restore pattern counter (PLX doesn't affect carry)
000261r 2  90 0A          bcc @HuntParseEnd
000263r 2  E0 40          cpx #MON_HUNT_PAT_MAX
000265r 2  B0 06          bcs @HuntParseEnd             ; Pattern buffer full
000267r 2  9D 80 04       sta MON_HUNT_PAT,x
00026Ar 2  E8             inx
00026Br 2  80 EC          bra @HuntParseByte
00026Dr 2               @HuntParseEnd:
00026Dr 2  E0 00          cpx #0
00026Fr 2  F0 2B          beq @HuntError                ; No pattern bytes → error
000271r 2  86 34          stx MON_BYTE                  ; MON_BYTE = pattern length
000273r 2                 ; Search: scan MON_ADDR to MON_END for pattern match
000273r 2               @HuntScanLoop:
000273r 2  A0 00          ldy #0                        ; Pattern match index
000275r 2               @HuntMatchLoop:
000275r 2  B1 2E          lda (MON_ADDR),y
000277r 2  D9 80 04       cmp MON_HUNT_PAT,y
00027Ar 2  D0 0B          bne @HuntNoMatch
00027Cr 2  C8             iny
00027Dr 2  C4 34          cpy MON_BYTE                  ; Matched all pattern bytes?
00027Fr 2  90 F4          bcc @HuntMatchLoop
000281r 2                 ; Full match — print address
000281r 2  20 rr rr       jsr MonPrintHex4
000284r 2  20 rr rr       jsr MonPrintCRLF
000287r 2               @HuntNoMatch:
000287r 2                 ; Check if MON_ADDR == MON_END
000287r 2  A5 2F          lda MON_ADDR+1
000289r 2  C5 31          cmp MON_END+1
00028Br 2  D0 06          bne @HuntAdvance
00028Dr 2  A5 2E          lda MON_ADDR
00028Fr 2  C5 30          cmp MON_END
000291r 2  F0 08          beq @HuntDone
000293r 2               @HuntAdvance:
000293r 2  E6 2E          inc MON_ADDR
000295r 2  D0 DC          bne @HuntScanLoop
000297r 2  E6 2F          inc MON_ADDR+1
000299r 2  80 D8          bra @HuntScanLoop
00029Br 2               @HuntDone:
00029Br 2  60             rts
00029Cr 2               @HuntError:
00029Cr 2  4C rr rr       jmp MonPrintError
00029Fr 2               
00029Fr 2               ; ============================================================================
00029Fr 2               ; MonCmdCompare — Compare two memory regions
00029Fr 2               ; Syntax: C ADDR1 ADDR2 ADDR3
00029Fr 2               ; Compares [addr1,addr2] with block at addr3, prints differing addresses.
00029Fr 2               ; ============================================================================
00029Fr 2               
00029Fr 2               MonCmdCompare:
00029Fr 2  20 rr rr       jsr MonSkipSpaces
0002A2r 2  20 rr rr       jsr MonParseHex4              ; Parse addr1 (region1 start) → MON_ADDR
0002A5r 2  90 57          bcc @CmpError
0002A7r 2                 ; Save addr1 on stack
0002A7r 2  A5 2F          lda MON_ADDR+1
0002A9r 2  48             pha
0002AAr 2  A5 2E          lda MON_ADDR
0002ACr 2  48             pha
0002ADr 2  20 rr rr       jsr MonSkipSpaces
0002B0r 2  20 rr rr       jsr MonParseHex4              ; Parse addr2 (region1 end) → MON_ADDR
0002B3r 2  90 47          bcc @CmpErrorPop
0002B5r 2  A5 2E          lda MON_ADDR
0002B7r 2  85 30          sta MON_END
0002B9r 2  A5 2F          lda MON_ADDR+1
0002BBr 2  85 31          sta MON_END+1                 ; MON_END = region1 end (inclusive)
0002BDr 2  20 rr rr       jsr MonSkipSpaces
0002C0r 2  20 rr rr       jsr MonParseHex4              ; Parse addr3 (region2 base) → MON_ADDR
0002C3r 2  90 37          bcc @CmpErrorPop
0002C5r 2  A5 2E          lda MON_ADDR
0002C7r 2  85 32          sta MON_TMP
0002C9r 2  A5 2F          lda MON_ADDR+1
0002CBr 2  85 33          sta MON_TMP+1                 ; MON_TMP = region2 pointer
0002CDr 2                 ; Restore addr1 → MON_ADDR
0002CDr 2  68             pla
0002CEr 2  85 2E          sta MON_ADDR
0002D0r 2  68             pla
0002D1r 2  85 2F          sta MON_ADDR+1
0002D3r 2                 ; Compare loop: [MON_ADDR..MON_END] vs [MON_TMP..]
0002D3r 2  A0 00          ldy #0
0002D5r 2               @CmpLoop:
0002D5r 2  B1 2E          lda (MON_ADDR),y
0002D7r 2  D1 32          cmp (MON_TMP),y
0002D9r 2  F0 06          beq @CmpMatch
0002DBr 2                 ; Mismatch — print addr1 address
0002DBr 2  20 rr rr       jsr MonPrintHex4
0002DEr 2  20 rr rr       jsr MonPrintCRLF
0002E1r 2               @CmpMatch:
0002E1r 2                 ; Check if MON_ADDR == MON_END
0002E1r 2  A5 2F          lda MON_ADDR+1
0002E3r 2  C5 31          cmp MON_END+1
0002E5r 2  D0 06          bne @CmpNext
0002E7r 2  A5 2E          lda MON_ADDR
0002E9r 2  C5 30          cmp MON_END
0002EBr 2  F0 0E          beq @CmpDone
0002EDr 2               @CmpNext:
0002EDr 2                 ; Advance both pointers
0002EDr 2  E6 2E          inc MON_ADDR
0002EFr 2  D0 02          bne @CmpNoHi1
0002F1r 2  E6 2F          inc MON_ADDR+1
0002F3r 2               @CmpNoHi1:
0002F3r 2  E6 32          inc MON_TMP
0002F5r 2  D0 DE          bne @CmpLoop
0002F7r 2  E6 33          inc MON_TMP+1
0002F9r 2  80 DA          bra @CmpLoop
0002FBr 2               @CmpDone:
0002FBr 2  60             rts
0002FCr 2               @CmpErrorPop:
0002FCr 2  68             pla                           ; Clean up stack
0002FDr 2  68             pla
0002FEr 2               @CmpError:
0002FEr 2  4C rr rr       jmp MonPrintError
000301r 2               
000301r 2               ; ============================================================================
000301r 2               ; MonCmdGo — Go (JMP to address with full register restore via RTI)
000301r 2               ; Syntax: G [addr]
000301r 2               ; If addr given, sets BRK_PCL/PCH. Restores A, X, Y, P, SP via RTI.
000301r 2               ; Program runs until BRK returns to monitor or forever.
000301r 2               ; ============================================================================
000301r 2               
000301r 2               MonCmdGo:
000301r 2  20 rr rr       jsr MonSkipSpaces
000304r 2  20 rr rr       jsr MonParseHex4
000307r 2  90 0A          bcc @GoNoAddr
000309r 2                 ; Address given — store to BRK_PCL/PCH
000309r 2  A5 2E          lda MON_ADDR
00030Br 2  8D 11 03       sta BRK_PCL
00030Er 2  A5 2F          lda MON_ADDR+1
000310r 2  8D 12 03       sta BRK_PCH
000313r 2               @GoNoAddr:
000313r 2  78             sei                           ; Disable interrupts during stack manipulation
000314r 2                 ; Restore user's stack pointer
000314r 2                 ; BRK_SP = SP at Break entry (user's original SP - 3 from BRK hardware push)
000314r 2                 ; We need SP = BRK_SP + 3 before our pushes, so RTI leaves SP at original
000314r 2  AE 16 03       ldx BRK_SP
000317r 2  E8             inx
000318r 2  E8             inx
000319r 2  E8             inx
00031Ar 2  9A             txs                           ; SP = user's original SP
00031Br 2                 ; Push PCH, PCL, P for RTI (RTI pops P first, then PCL, PCH)
00031Br 2  AD 12 03       lda BRK_PCH
00031Er 2  48             pha
00031Fr 2  AD 11 03       lda BRK_PCL
000322r 2  48             pha
000323r 2  AD 10 03       lda BRK_P
000326r 2  48             pha
000327r 2                 ; Restore registers
000327r 2  AC 15 03       ldy BRK_Y
00032Ar 2  AE 14 03       ldx BRK_X
00032Dr 2  AD 13 03       lda BRK_A
000330r 2  40             rti                           ; Pop P, PC → jump to target with full register state
000331r 2               
000331r 2               ; ============================================================================
000331r 2               ; MonCmdJsr — Call subroutine and return to monitor on RTS
000331r 2               ; Syntax: J [addr]
000331r 2               ; Pushes monitor return address, restores A/X/Y, JMPs to target.
000331r 2               ; When target does RTS, saves registers and re-enters monitor.
000331r 2               ; ============================================================================
000331r 2               
000331r 2               MonCmdJsr:
000331r 2  20 rr rr       jsr MonSkipSpaces
000334r 2  20 rr rr       jsr MonParseHex4
000337r 2  90 0A          bcc @JsrNoAddr
000339r 2                 ; Address given — store to BRK_PCL/PCH
000339r 2  A5 2E          lda MON_ADDR
00033Br 2  8D 11 03       sta BRK_PCL
00033Er 2  A5 2F          lda MON_ADDR+1
000340r 2  8D 12 03       sta BRK_PCH
000343r 2               @JsrNoAddr:
000343r 2                 ; Push return address (MonJsrReturn - 1) for RTS trick
000343r 2  A9 rr          lda #>(MonJsrReturn - 1)
000345r 2  48             pha
000346r 2  A9 rr          lda #<(MonJsrReturn - 1)
000348r 2  48             pha
000349r 2                 ; Restore registers as inputs to subroutine
000349r 2  AC 15 03       ldy BRK_Y
00034Cr 2  AE 14 03       ldx BRK_X
00034Fr 2  AD 13 03       lda BRK_A
000352r 2  6C 11 03       jmp (BRK_PCL)                 ; Jump to target — its RTS returns to MonJsrReturn
000355r 2               
000355r 2               ; MonJsrReturn — Landing point when user's subroutine does RTS
000355r 2               MonJsrReturn:
000355r 2  8D 13 03       sta BRK_A                     ; Save returned A
000358r 2  8E 14 03       stx BRK_X                    ; Save returned X
00035Br 2  8C 15 03       sty BRK_Y                    ; Save returned Y
00035Er 2  08             php                           ; Push current P
00035Fr 2  68             pla
000360r 2  8D 10 03       sta BRK_P                    ; Save processor status
000363r 2  BA             tsx
000364r 2  8E 16 03       stx BRK_SP                   ; Save current stack pointer
000367r 2                 ; Show registers and re-enter command loop
000367r 2  20 rr rr       jsr MonShowRegs
00036Ar 2  4C rr rr       jmp MonCmdLoop
00036Dr 2               
00036Dr 2               ; ============================================================================
00036Dr 2               ; MonCmdModRegs — Modify saved CPU registers
00036Dr 2               ; Syntax: ; PC xxxx A xx X xx Y xx SP xx P xx
00036Dr 2               ; Any subset, any order. Labels: PC, A, X, Y, SP, P
00036Dr 2               ; ============================================================================
00036Dr 2               
00036Dr 2               MonCmdModRegs:
00036Dr 2               @ModLoop:
00036Dr 2  20 rr rr       jsr MonSkipSpaces
000370r 2  A4 35          ldy MON_IDX
000372r 2  B9 00 04       lda MON_LINBUF,y
000375r 2  D0 03          bne @ModNotEnd
000377r 2  4C rr rr       jmp @ModDone                  ; End of line — trampoline (too far for beq)
00037Ar 2               @ModNotEnd:
00037Ar 2                 ; Convert to uppercase
00037Ar 2  C9 61          cmp #'a'
00037Cr 2  90 06          bcc @ModNoConv
00037Er 2  C9 7B          cmp #'z'+1
000380r 2  B0 02          bcs @ModNoConv
000382r 2  29 DF          and #$DF
000384r 2               @ModNoConv:
000384r 2  C9 50          cmp #'P'
000386r 2  F0 13          beq @ModCheckPCorP
000388r 2  C9 41          cmp #'A'
00038Ar 2  F0 4F          beq @ModA
00038Cr 2  C9 58          cmp #'X'
00038Er 2  F0 5E          beq @ModX
000390r 2  C9 59          cmp #'Y'
000392r 2  F0 6D          beq @ModY
000394r 2  C9 53          cmp #'S'
000396r 2  F0 7C          beq @ModCheckSP
000398r 2  4C rr rr       jmp @ModError                 ; Unknown label — trampoline (too far for bra)
00039Br 2               
00039Br 2               @ModCheckPCorP:
00039Br 2                 ; Could be "PC" (program counter) or "P" (processor status)
00039Br 2  E6 35          inc MON_IDX
00039Dr 2  A4 35          ldy MON_IDX
00039Fr 2  B9 00 04       lda MON_LINBUF,y
0003A2r 2                 ; Convert to uppercase
0003A2r 2  C9 61          cmp #'a'
0003A4r 2  90 06          bcc @ModPCNoConv
0003A6r 2  C9 7B          cmp #'z'+1
0003A8r 2  B0 02          bcs @ModPCNoConv
0003AAr 2  29 DF          and #$DF
0003ACr 2               @ModPCNoConv:
0003ACr 2  C9 43          cmp #'C'
0003AEr 2  F0 11          beq @ModPC
0003B0r 2                 ; It's just 'P' (processor status) — don't advance past the non-'C' char
0003B0r 2  20 rr rr       jsr MonSkipSpaces
0003B3r 2  20 rr rr       jsr MonParseHex2
0003B6r 2  B0 03          bcs @ModPOk
0003B8r 2  4C rr rr       jmp @ModError
0003BBr 2               @ModPOk:
0003BBr 2  8D 10 03       sta BRK_P
0003BEr 2  4C rr rr       jmp @ModLoop
0003C1r 2               
0003C1r 2               @ModPC:
0003C1r 2  E6 35          inc MON_IDX                   ; Advance past 'C'
0003C3r 2  20 rr rr       jsr MonSkipSpaces
0003C6r 2  20 rr rr       jsr MonParseHex4
0003C9r 2  B0 03          bcs @ModPCOk
0003CBr 2  4C rr rr       jmp @ModError
0003CEr 2               @ModPCOk:
0003CEr 2  A5 2E          lda MON_ADDR
0003D0r 2  8D 11 03       sta BRK_PCL
0003D3r 2  A5 2F          lda MON_ADDR+1
0003D5r 2  8D 12 03       sta BRK_PCH
0003D8r 2  4C rr rr       jmp @ModLoop
0003DBr 2               
0003DBr 2               @ModA:
0003DBr 2  E6 35          inc MON_IDX                   ; Advance past 'A'
0003DDr 2  20 rr rr       jsr MonSkipSpaces
0003E0r 2  20 rr rr       jsr MonParseHex2
0003E3r 2  B0 03          bcs @ModAOk
0003E5r 2  4C rr rr       jmp @ModError
0003E8r 2               @ModAOk:
0003E8r 2  8D 13 03       sta BRK_A
0003EBr 2  4C rr rr       jmp @ModLoop
0003EEr 2               
0003EEr 2               @ModX:
0003EEr 2  E6 35          inc MON_IDX                   ; Advance past 'X'
0003F0r 2  20 rr rr       jsr MonSkipSpaces
0003F3r 2  20 rr rr       jsr MonParseHex2
0003F6r 2  B0 03          bcs @ModXOk
0003F8r 2  4C rr rr       jmp @ModError
0003FBr 2               @ModXOk:
0003FBr 2  8D 14 03       sta BRK_X
0003FEr 2  4C rr rr       jmp @ModLoop
000401r 2               
000401r 2               @ModY:
000401r 2  E6 35          inc MON_IDX                   ; Advance past 'Y'
000403r 2  20 rr rr       jsr MonSkipSpaces
000406r 2  20 rr rr       jsr MonParseHex2
000409r 2  B0 03          bcs @ModYOk
00040Br 2  4C rr rr       jmp @ModError
00040Er 2               @ModYOk:
00040Er 2  8D 15 03       sta BRK_Y
000411r 2  4C rr rr       jmp @ModLoop
000414r 2               
000414r 2               @ModCheckSP:
000414r 2                 ; Expect "SP" — must see 'P' next
000414r 2  E6 35          inc MON_IDX
000416r 2  A4 35          ldy MON_IDX
000418r 2  B9 00 04       lda MON_LINBUF,y
00041Br 2  C9 50          cmp #'P'
00041Dr 2  F0 07          beq @ModSPGotP
00041Fr 2  C9 70          cmp #'p'
000421r 2  F0 03          beq @ModSPGotP
000423r 2  4C rr rr       jmp @ModError                 ; Just 'S' alone is invalid
000426r 2               @ModSPGotP:
000426r 2  E6 35          inc MON_IDX                   ; Advance past 'P'
000428r 2  20 rr rr       jsr MonSkipSpaces
00042Br 2  20 rr rr       jsr MonParseHex2
00042Er 2  B0 03          bcs @ModSPOk
000430r 2  4C rr rr       jmp @ModError
000433r 2               @ModSPOk:
000433r 2  8D 16 03       sta BRK_SP
000436r 2  4C rr rr       jmp @ModLoop
000439r 2               
000439r 2               @ModError:
000439r 2  4C rr rr       jmp MonPrintError
00043Cr 2               @ModDone:
00043Cr 2                 ; Display updated registers
00043Cr 2  20 rr rr       jsr MonShowRegs
00043Fr 2  60             rts
000440r 2               
000440r 2               ; ============================================================================
000440r 2               ; MonCmdDir — Display CF directory listing
000440r 2               ; Syntax: @
000440r 2               ; ============================================================================
000440r 2               
000440r 2               MonCmdDir:
000440r 2  20 rr rr       jsr FsDirectory
000443r 2  60             rts
000444r 2               
000444r 2               ; ============================================================================
000444r 2               ; MonCmdDisk — Select / report the current CF disk bank
000444r 2               ; Syntax: # NN   (hex disk 00-FF selects); # alone reports the current disk
000444r 2               ; ============================================================================
000444r 2               
000444r 2               MonCmdDisk:
000444r 2  20 rr rr       jsr MonSkipSpaces
000447r 2  20 rr rr       jsr MonParseHex2
00044Ar 2  90 03          bcc @MonDiskShow              ; No argument — just report current disk
00044Cr 2  20 rr rr       jsr FsSetDisk                 ; CF_DISK = A
00044Fr 2               @MonDiskShow:
00044Fr 2  20 rr rr       jsr FsPrintDisk               ; Print "DISK n"
000452r 2  60             rts
000453r 2               
000453r 2               ; ============================================================================
000453r 2               ; MonCmdNum — Number base conversion
000453r 2               ; Syntax: N $XXXX  or  N +DDDDD  or  N %BBBBBBBBBBBBBBBB
000453r 2               ; Output: $XXXX  +DDDDD  %BBBBBBBBBBBBBBBB
000453r 2               ; ============================================================================
000453r 2               
000453r 2               MonCmdNum:
000453r 2  20 rr rr       jsr MonSkipSpaces
000456r 2  A4 35          ldy MON_IDX
000458r 2  B9 00 04       lda MON_LINBUF,y
00045Br 2  C9 24          cmp #'$'
00045Dr 2  F0 0A          beq @NumHex
00045Fr 2  C9 2B          cmp #'+'
000461r 2  F0 10          beq @NumDec
000463r 2  C9 25          cmp #'%'
000465r 2  F0 16          beq @NumBin
000467r 2                 ; Default: try hex (no prefix)
000467r 2  80 02          bra @NumHexDirect
000469r 2               @NumHex:
000469r 2  E6 35          inc MON_IDX                   ; Skip '$'
00046Br 2               @NumHexDirect:
00046Br 2  20 rr rr       jsr MonParseHex4
00046Er 2  B0 17          bcs @NumPrint
000470r 2  4C rr rr       jmp MonPrintError
000473r 2               @NumDec:
000473r 2  E6 35          inc MON_IDX                   ; Skip '+'
000475r 2  20 rr rr       jsr MonParseDec16
000478r 2  B0 0D          bcs @NumPrint
00047Ar 2  4C rr rr       jmp MonPrintError
00047Dr 2               @NumBin:
00047Dr 2  E6 35          inc MON_IDX                   ; Skip '%'
00047Fr 2  20 rr rr       jsr MonParseBin16
000482r 2  B0 03          bcs @NumPrint
000484r 2  4C rr rr       jmp MonPrintError
000487r 2               @NumPrint:
000487r 2                 ; Value is in MON_ADDR
000487r 2  A9 24          lda #'$'
000489r 2  20 rr rr       jsr Chrout
00048Cr 2  20 rr rr       jsr MonPrintHex4
00048Fr 2  20 rr rr       jsr MonPrintSpace
000492r 2  20 rr rr       jsr MonPrintSpace
000495r 2  A9 2B          lda #'+'
000497r 2  20 rr rr       jsr Chrout
00049Ar 2  20 rr rr       jsr MonPrintDec16
00049Dr 2  20 rr rr       jsr MonPrintSpace
0004A0r 2  20 rr rr       jsr MonPrintSpace
0004A3r 2  A9 25          lda #'%'
0004A5r 2  20 rr rr       jsr Chrout
0004A8r 2  20 rr rr       jsr MonPrintBin16
0004ABr 2  20 rr rr       jsr MonPrintCRLF
0004AEr 2  60             rts
0004AFr 2               
0004AFr 2               ; ============================================================================
0004AFr 2               ; MonCmdLoad — Load from CF (with quoted filename) or XModem (without)
0004AFr 2               ; Syntax: L ["FILE"] [ADDR]
0004AFr 2               ; CF path:     L "FILENAME" [ADDR] — load file to addr (default $0800)
0004AFr 2               ; Serial path: L [ADDR]            — receive via XModem to addr (default $0800)
0004AFr 2               ; ============================================================================
0004AFr 2               
0004AFr 2               MonCmdLoad:
0004AFr 2  20 rr rr       jsr MonSkipSpaces
0004B2r 2  A4 35          ldy MON_IDX
0004B4r 2  B9 00 04       lda MON_LINBUF,y
0004B7r 2  C9 22          cmp #'"'
0004B9r 2  D0 03          bne @LoadSerial
0004BBr 2  4C rr rr       jmp @LoadCF
0004BEr 2               
0004BEr 2                 ; --- Serial path (XModem) ---
0004BEr 2               @LoadSerial:
0004BEr 2  20 rr rr       jsr MonParseHex4              ; Optional address
0004C1r 2  90 0A          bcc @LoadSerDefault
0004C3r 2                 ; Got address
0004C3r 2  A5 2E          lda MON_ADDR
0004C5r 2  85 2A          sta XFER_PTR
0004C7r 2  A5 2F          lda MON_ADDR+1
0004C9r 2  85 2B          sta XFER_PTR+1
0004CBr 2  80 08          bra @LoadSerStart
0004CDr 2               @LoadSerDefault:
0004CDr 2  A9 00          lda #<PROGRAM_START
0004CFr 2  85 2A          sta XFER_PTR
0004D1r 2  A9 08          lda #>PROGRAM_START
0004D3r 2  85 2B          sta XFER_PTR+1
0004D5r 2               @LoadSerStart:
0004D5r 2                 ; Save load address for success message
0004D5r 2  A5 2A          lda XFER_PTR
0004D7r 2  85 30          sta MON_END
0004D9r 2  A5 2B          lda XFER_PTR+1
0004DBr 2  85 31          sta MON_END+1
0004DDr 2                 ; Receive via XModem
0004DDr 2  20 rr rr       jsr XModemLoad
0004E0r 2  B0 11          bcs @LoadSerErr
0004E2r 2                 ; XFER_REMAIN = total bytes received
0004E2r 2  AD 17 03       lda XFER_REMAIN
0004E5r 2  85 2E          sta MON_ADDR
0004E7r 2  AD 18 03       lda XFER_REMAIN+1
0004EAr 2  85 2F          sta MON_ADDR+1
0004ECr 2  20 rr rr       jsr MonNoteImage
0004EFr 2  20 rr rr       jsr MonPrintLoaded            ; Print "LOADED nnnn BYTES AT $xxxx"
0004F2r 2  60             rts
0004F3r 2               @LoadSerErr:
0004F3r 2  20 rr rr       jsr MonPrintIOErr
0004F6r 2  60             rts
0004F7r 2               
0004F7r 2                 ; --- CF path ---
0004F7r 2               @LoadCF:
0004F7r 2  E6 35          inc MON_IDX                   ; Skip opening quote
0004F9r 2                 ; Point STR_PTR into line buffer at the filename
0004F9r 2  A4 35          ldy MON_IDX
0004FBr 2  98             tya
0004FCr 2  18             clc
0004FDr 2  69 00          adc #<MON_LINBUF
0004FFr 2  85 02          sta STR_PTR
000501r 2  A9 04          lda #>MON_LINBUF
000503r 2  69 00          adc #0
000505r 2  85 03          sta STR_PTR+1
000507r 2                 ; Find closing quote and null-terminate
000507r 2               @LoadCFFindQ:
000507r 2  B9 00 04       lda MON_LINBUF,y
00050Ar 2  F0 0D          beq @LoadCFQDone              ; End of line — use as-is
00050Cr 2  C9 22          cmp #'"'
00050Er 2  F0 03          beq @LoadCFGotQ
000510r 2  C8             iny
000511r 2  80 F4          bra @LoadCFFindQ
000513r 2               @LoadCFGotQ:
000513r 2  A9 00          lda #0
000515r 2  99 00 04       sta MON_LINBUF,y              ; Null-terminate at closing quote
000518r 2  C8             iny                           ; Advance past closing quote
000519r 2               @LoadCFQDone:
000519r 2  84 35          sty MON_IDX
00051Br 2                 ; Parse filename into FS_FNAME_BUF
00051Br 2  20 rr rr       jsr FsParseName
00051Er 2                 ; Read directory
00051Er 2  20 rr rr       jsr FsReadDir
000521r 2  90 03          bcc @LoadCFReadOk
000523r 2  4C rr rr       jmp @LoadCFErr
000526r 2               @LoadCFReadOk:
000526r 2                 ; Find file
000526r 2  20 rr rr       jsr FsFindFile
000529r 2  90 03          bcc @LoadCFFound
00052Br 2  4C rr rr       jmp @LoadCFNotFound
00052Er 2               @LoadCFFound:
00052Er 2                 ; Read file metadata
00052Er 2  A0 0C          ldy #FS_ENTRY_START
000530r 2  B1 24          lda (CF_BUF_PTR),y
000532r 2  8D 48 03       sta FS_START_SEC
000535r 2  C8             iny
000536r 2  B1 24          lda (CF_BUF_PTR),y
000538r 2  8D 49 03       sta FS_START_SEC+1
00053Br 2  A0 0E          ldy #FS_ENTRY_FSIZE
00053Dr 2  B1 24          lda (CF_BUF_PTR),y
00053Fr 2  8D 4A 03       sta FS_FILE_SIZE
000542r 2  C8             iny
000543r 2  B1 24          lda (CF_BUF_PTR),y
000545r 2  8D 4B 03       sta FS_FILE_SIZE+1
000548r 2                 ; Calculate sector count = ceil(size / 512)
000548r 2  AD 4B 03       lda FS_FILE_SIZE+1
00054Br 2  4A             lsr a
00054Cr 2  8D 4C 03       sta FS_SEC_COUNT
00054Fr 2  AD 4B 03       lda FS_FILE_SIZE+1
000552r 2  29 01          and #$01
000554r 2  D0 05          bne @LoadCFRound
000556r 2  AD 4A 03       lda FS_FILE_SIZE
000559r 2  F0 03          beq @LoadCFNoRound
00055Br 2               @LoadCFRound:
00055Br 2  EE 4C 03       inc FS_SEC_COUNT
00055Er 2               @LoadCFNoRound:
00055Er 2                 ; Parse optional load address
00055Er 2  20 rr rr       jsr MonSkipSpaces
000561r 2  20 rr rr       jsr MonParseHex4
000564r 2  90 0A          bcc @LoadCFDefAddr
000566r 2                 ; Got address — use it
000566r 2  A5 2E          lda MON_ADDR
000568r 2  85 24          sta CF_BUF_PTR
00056Ar 2  A5 2F          lda MON_ADDR+1
00056Cr 2  85 25          sta CF_BUF_PTR+1
00056Er 2  80 08          bra @LoadCFSetLBA
000570r 2               @LoadCFDefAddr:
000570r 2  A9 00          lda #<PROGRAM_START
000572r 2  85 24          sta CF_BUF_PTR
000574r 2  A9 08          lda #>PROGRAM_START
000576r 2  85 25          sta CF_BUF_PTR+1
000578r 2               @LoadCFSetLBA:
000578r 2                 ; Save load base address for message
000578r 2  A5 24          lda CF_BUF_PTR
00057Ar 2  85 30          sta MON_END
00057Cr 2  A5 25          lda CF_BUF_PTR+1
00057Er 2  85 31          sta MON_END+1
000580r 2                 ; Set up LBA
000580r 2  AD 48 03       lda FS_START_SEC
000583r 2  85 26          sta CF_LBA
000585r 2  AD 49 03       lda FS_START_SEC+1
000588r 2  85 27          sta CF_LBA+1
00058Ar 2  64 28          stz CF_LBA+2
00058Cr 2  64 29          stz CF_LBA+3
00058Er 2                 ; Read sectors
00058Er 2  AE 4C 03       ldx FS_SEC_COUNT
000591r 2  F0 10          beq @LoadCFOk
000593r 2               @LoadCFSec:
000593r 2  DA             phx
000594r 2  20 rr rr       jsr StReadSector              ; Reads 512 bytes, advances CF_BUF_PTR
000597r 2  B0 1B          bcs @LoadCFSecErr
000599r 2  E6 26          inc CF_LBA
00059Br 2  D0 02          bne @LoadCFSecNext
00059Dr 2  E6 27          inc CF_LBA+1
00059Fr 2               @LoadCFSecNext:
00059Fr 2  FA             plx
0005A0r 2  CA             dex
0005A1r 2  D0 F0          bne @LoadCFSec
0005A3r 2               @LoadCFOk:
0005A3r 2                 ; Print success
0005A3r 2  AD 4A 03       lda FS_FILE_SIZE
0005A6r 2  85 2E          sta MON_ADDR
0005A8r 2  AD 4B 03       lda FS_FILE_SIZE+1
0005ABr 2  85 2F          sta MON_ADDR+1
0005ADr 2  20 rr rr       jsr MonNoteImage
0005B0r 2  20 rr rr       jsr MonPrintLoaded            ; Print "LOADED nnnn BYTES AT $xxxx"
0005B3r 2  60             rts
0005B4r 2               @LoadCFSecErr:
0005B4r 2  FA             plx                           ; Balance stack
0005B5r 2               @LoadCFErr:
0005B5r 2  20 rr rr       jsr MonPrintIOErr
0005B8r 2  60             rts
0005B9r 2               @LoadCFNotFound:
0005B9r 2  A2 00          ldx #0
0005BBr 2               @LoadCFNFLoop:
0005BBr 2  BD rr rr       lda MonStrNotFound,x
0005BEr 2  F0 06          beq @LoadCFNFDone
0005C0r 2  20 rr rr       jsr Chrout
0005C3r 2  E8             inx
0005C4r 2  80 F5          bra @LoadCFNFLoop
0005C6r 2               @LoadCFNFDone:
0005C6r 2  20 rr rr       jsr MonPrintCRLF
0005C9r 2  60             rts
0005CAr 2               
0005CAr 2               ; ============================================================================
0005CAr 2               ; MonNoteImage — Record a program image loaded to PROGRAM_START, so that BASIC
0005CAr 2               ; can size it correctly on entry.  'L' is the one raw loader that can land a
0005CAr 2               ; .prg where BASIC expects one; without the byte count BASIC would walk the
0005CAr 2               ; line chain, stop at the stub's end marker, and leave the machine code
0005CAr 2               ; unprotected below VARTAB.
0005CAr 2               ; Input: MON_END = load address, MON_ADDR = byte count
0005CAr 2               ; Output: PRG_IMAGE_END set, but only for a load to PROGRAM_START — a load to
0005CAr 2               ;         any other address is BLOAD-shaped and must not touch BASIC's state.
0005CAr 2               ; Modifies: Flags, A
0005CAr 2               ; ============================================================================
0005CAr 2               
0005CAr 2               MonNoteImage:
0005CAr 2  A5 30          lda MON_END
0005CCr 2  C9 00          cmp #<PROGRAM_START
0005CEr 2  D0 15          bne @NoteDone
0005D0r 2  A5 31          lda MON_END+1
0005D2r 2  C9 08          cmp #>PROGRAM_START
0005D4r 2  D0 0F          bne @NoteDone
0005D6r 2  18             clc
0005D7r 2  A5 2E          lda MON_ADDR
0005D9r 2  69 00          adc #<PROGRAM_START
0005DBr 2  8D 8E 03       sta PRG_IMAGE_END
0005DEr 2  A5 2F          lda MON_ADDR+1
0005E0r 2  69 08          adc #>PROGRAM_START
0005E2r 2  8D 8F 03       sta PRG_IMAGE_END+1
0005E5r 2               @NoteDone:
0005E5r 2  60             rts
0005E6r 2               
0005E6r 2               ; ============================================================================
0005E6r 2               ; MonCmdSave — Save to CF (with quoted filename) or XModem (without)
0005E6r 2               ; Syntax: S ["FILE"] ADDR1 ADDR2
0005E6r 2               ; CF path:     S "FILENAME" ADDR1 ADDR2 — save [addr1,addr2) to file
0005E6r 2               ; Serial path: S ADDR1 ADDR2            — send [addr1,addr2) via XModem
0005E6r 2               ; ============================================================================
0005E6r 2               
0005E6r 2               MonCmdSave:
0005E6r 2  20 rr rr       jsr MonSkipSpaces
0005E9r 2  A4 35          ldy MON_IDX
0005EBr 2  B9 00 04       lda MON_LINBUF,y
0005EEr 2  C9 22          cmp #'"'
0005F0r 2  D0 03          bne @SaveSerial
0005F2r 2  4C rr rr       jmp @SaveCF
0005F5r 2               
0005F5r 2                 ; --- Serial path ---
0005F5r 2                 ; --- Serial path (XModem) ---
0005F5r 2               @SaveSerial:
0005F5r 2  20 rr rr       jsr MonParseHex4              ; Parse start address
0005F8r 2  B0 03          bcs @SaveSerGotStart
0005FAr 2  4C rr rr       jmp @SaveError
0005FDr 2               @SaveSerGotStart:
0005FDr 2  A5 2E          lda MON_ADDR
0005FFr 2  85 2A          sta XFER_PTR
000601r 2  A5 2F          lda MON_ADDR+1
000603r 2  85 2B          sta XFER_PTR+1
000605r 2  20 rr rr       jsr MonSkipSpaces
000608r 2  20 rr rr       jsr MonParseHex4              ; Parse end address
00060Br 2  B0 03          bcs @SaveSerGotEnd
00060Dr 2  4C rr rr       jmp @SaveError
000610r 2               @SaveSerGotEnd:
000610r 2                 ; Calculate size = end - start
000610r 2  38             sec
000611r 2  A5 2E          lda MON_ADDR
000613r 2  E5 2A          sbc XFER_PTR
000615r 2  8D 17 03       sta XFER_REMAIN
000618r 2  A5 2F          lda MON_ADDR+1
00061Ar 2  E5 2B          sbc XFER_PTR+1
00061Cr 2  8D 18 03       sta XFER_REMAIN+1
00061Fr 2                 ; Save size for message
00061Fr 2  AD 17 03       lda XFER_REMAIN
000622r 2  85 30          sta MON_END
000624r 2  AD 18 03       lda XFER_REMAIN+1
000627r 2  85 31          sta MON_END+1
000629r 2                 ; Send via XModem
000629r 2  20 rr rr       jsr XModemSave
00062Cr 2  B0 0C          bcs @SaveSerErr
00062Er 2                 ; Print "SAVED nnnn BYTES"
00062Er 2  A5 30          lda MON_END
000630r 2  85 2E          sta MON_ADDR
000632r 2  A5 31          lda MON_END+1
000634r 2  85 2F          sta MON_ADDR+1
000636r 2  20 rr rr       jsr MonPrintSaved
000639r 2  60             rts
00063Ar 2               @SaveSerErr:
00063Ar 2  20 rr rr       jsr MonPrintIOErr
00063Dr 2  60             rts
00063Er 2               
00063Er 2                 ; --- CF path ---
00063Er 2               @SaveCF:
00063Er 2  E6 35          inc MON_IDX                   ; Skip opening quote
000640r 2                 ; Point STR_PTR into line buffer at the filename
000640r 2  A4 35          ldy MON_IDX
000642r 2  98             tya
000643r 2  18             clc
000644r 2  69 00          adc #<MON_LINBUF
000646r 2  85 02          sta STR_PTR
000648r 2  A9 04          lda #>MON_LINBUF
00064Ar 2  69 00          adc #0
00064Cr 2  85 03          sta STR_PTR+1
00064Er 2                 ; Find closing quote and null-terminate
00064Er 2               @SaveCFFindQ:
00064Er 2  B9 00 04       lda MON_LINBUF,y
000651r 2  F0 0D          beq @SaveCFQDone
000653r 2  C9 22          cmp #'"'
000655r 2  F0 03          beq @SaveCFGotQ
000657r 2  C8             iny
000658r 2  80 F4          bra @SaveCFFindQ
00065Ar 2               @SaveCFGotQ:
00065Ar 2  A9 00          lda #0
00065Cr 2  99 00 04       sta MON_LINBUF,y              ; Null-terminate at closing quote
00065Fr 2  C8             iny
000660r 2               @SaveCFQDone:
000660r 2  84 35          sty MON_IDX
000662r 2                 ; Parse filename
000662r 2  20 rr rr       jsr FsParseName
000665r 2                 ; Parse start address
000665r 2  20 rr rr       jsr MonSkipSpaces
000668r 2  20 rr rr       jsr MonParseHex4
00066Br 2  B0 03          bcs @SaveCFGotStart
00066Dr 2  4C rr rr       jmp @SaveError
000670r 2               @SaveCFGotStart:
000670r 2  A5 2E          lda MON_ADDR
000672r 2  85 32          sta MON_TMP                   ; MON_TMP = start address
000674r 2  A5 2F          lda MON_ADDR+1
000676r 2  85 33          sta MON_TMP+1
000678r 2                 ; Parse end address
000678r 2  20 rr rr       jsr MonSkipSpaces
00067Br 2  20 rr rr       jsr MonParseHex4
00067Er 2  B0 03          bcs @SaveCFGotEnd
000680r 2  4C rr rr       jmp @SaveError
000683r 2               @SaveCFGotEnd:
000683r 2                 ; Calculate size = end - start
000683r 2  38             sec
000684r 2  A5 2E          lda MON_ADDR
000686r 2  E5 32          sbc MON_TMP
000688r 2  8D 4A 03       sta FS_FILE_SIZE
00068Br 2  A5 2F          lda MON_ADDR+1
00068Dr 2  E5 33          sbc MON_TMP+1
00068Fr 2  8D 4B 03       sta FS_FILE_SIZE+1
000692r 2                 ; Read directory
000692r 2  20 rr rr       jsr FsReadDir
000695r 2  90 03          bcc @SaveCFReadOk
000697r 2  4C rr rr       jmp @SaveCFIOErr
00069Ar 2               @SaveCFReadOk:
00069Ar 2                 ; Try to find existing file with same name
00069Ar 2  20 rr rr       jsr FsFindFile
00069Dr 2  90 08          bcc @SaveCFOverwrite
00069Fr 2                 ; Not found — find a free slot
00069Fr 2  20 rr rr       jsr FsFindFree
0006A2r 2  90 11          bcc @SaveCFAlloc
0006A4r 2  4C rr rr       jmp @SaveCFDirFull
0006A7r 2               @SaveCFOverwrite:
0006A7r 2                 ; Clear old entry's flags
0006A7r 2  A0 0B          ldy #FS_ENTRY_FLAGS
0006A9r 2  A9 00          lda #$00
0006ABr 2  91 24          sta (CF_BUF_PTR),y
0006ADr 2                 ; Find a free slot (could be the one we just freed)
0006ADr 2  20 rr rr       jsr FsFindFree
0006B0r 2  90 03          bcc @SaveCFAllocOk
0006B2r 2  4C rr rr       jmp @SaveCFDirFull
0006B5r 2               @SaveCFAllocOk:
0006B5r 2               @SaveCFAlloc:
0006B5r 2                 ; Save CF_BUF_PTR (points to free entry)
0006B5r 2  A5 24          lda CF_BUF_PTR
0006B7r 2  48             pha
0006B8r 2  A5 25          lda CF_BUF_PTR+1
0006BAr 2  48             pha
0006BBr 2                 ; Calculate next free sector
0006BBr 2  20 rr rr       jsr FsCalcNextSec
0006BEr 2                 ; Restore CF_BUF_PTR
0006BEr 2  68             pla
0006BFr 2  85 25          sta CF_BUF_PTR+1
0006C1r 2  68             pla
0006C2r 2  85 24          sta CF_BUF_PTR
0006C4r 2                 ; Calculate sectors needed
0006C4r 2  AD 4B 03       lda FS_FILE_SIZE+1
0006C7r 2  4A             lsr a
0006C8r 2  8D 4C 03       sta FS_SEC_COUNT
0006CBr 2  AD 4B 03       lda FS_FILE_SIZE+1
0006CEr 2  29 01          and #$01
0006D0r 2  D0 05          bne @SaveCFRound
0006D2r 2  AD 4A 03       lda FS_FILE_SIZE
0006D5r 2  F0 03          beq @SaveCFNoRound
0006D7r 2               @SaveCFRound:
0006D7r 2  EE 4C 03       inc FS_SEC_COUNT
0006DAr 2               @SaveCFNoRound:
0006DAr 2                 ; Fill in directory entry
0006DAr 2                 ; Copy filename (11 bytes)
0006DAr 2  A0 00          ldy #0
0006DCr 2               @SaveCFCopyName:
0006DCr 2  B9 50 03       lda FS_FNAME_BUF,y
0006DFr 2  91 24          sta (CF_BUF_PTR),y
0006E1r 2  C8             iny
0006E2r 2  C0 0B          cpy #11
0006E4r 2  D0 F6          bne @SaveCFCopyName
0006E6r 2                 ; Set flags = in use
0006E6r 2  A9 01          lda #FS_FLAG_USED
0006E8r 2  91 24          sta (CF_BUF_PTR),y            ; Y = 11 = FS_ENTRY_FLAGS
0006EAr 2                 ; Set start sector
0006EAr 2  A0 0C          ldy #FS_ENTRY_START
0006ECr 2  AD 4E 03       lda FS_NEXT_SEC
0006EFr 2  91 24          sta (CF_BUF_PTR),y
0006F1r 2  8D 48 03       sta FS_START_SEC
0006F4r 2  C8             iny
0006F5r 2  AD 4F 03       lda FS_NEXT_SEC+1
0006F8r 2  91 24          sta (CF_BUF_PTR),y
0006FAr 2  8D 49 03       sta FS_START_SEC+1
0006FDr 2                 ; Set file size
0006FDr 2  A0 0E          ldy #FS_ENTRY_FSIZE
0006FFr 2  AD 4A 03       lda FS_FILE_SIZE
000702r 2  91 24          sta (CF_BUF_PTR),y
000704r 2  C8             iny
000705r 2  AD 4B 03       lda FS_FILE_SIZE+1
000708r 2  91 24          sta (CF_BUF_PTR),y
00070Ar 2                 ; Clear reserved bytes
00070Ar 2  A0 10          ldy #$10
00070Cr 2  A9 00          lda #$00
00070Er 2               @SaveCFClrRsv:
00070Er 2  91 24          sta (CF_BUF_PTR),y
000710r 2  C8             iny
000711r 2  C0 20          cpy #FS_ENTRY_SIZE
000713r 2  D0 F9          bne @SaveCFClrRsv
000715r 2                 ; Write updated directory
000715r 2  20 rr rr       jsr FsWriteDir
000718r 2  B0 3A          bcs @SaveCFIOErr
00071Ar 2                 ; Write data sectors from user-specified start address (MON_TMP)
00071Ar 2  AD 48 03       lda FS_START_SEC
00071Dr 2  85 26          sta CF_LBA
00071Fr 2  AD 49 03       lda FS_START_SEC+1
000722r 2  85 27          sta CF_LBA+1
000724r 2  64 28          stz CF_LBA+2
000726r 2  64 29          stz CF_LBA+3
000728r 2                 ; Source = MON_TMP (start address)
000728r 2  A5 32          lda MON_TMP
00072Ar 2  85 24          sta CF_BUF_PTR
00072Cr 2  A5 33          lda MON_TMP+1
00072Er 2  85 25          sta CF_BUF_PTR+1
000730r 2  AE 4C 03       ldx FS_SEC_COUNT
000733r 2  F0 10          beq @SaveCFOk
000735r 2               @SaveCFSec:
000735r 2  DA             phx
000736r 2  20 rr rr       jsr StWriteSector             ; Writes 512 bytes, advances CF_BUF_PTR
000739r 2  B0 18          bcs @SaveCFSecErr
00073Br 2  E6 26          inc CF_LBA
00073Dr 2  D0 02          bne @SaveCFSecNext
00073Fr 2  E6 27          inc CF_LBA+1
000741r 2               @SaveCFSecNext:
000741r 2  FA             plx
000742r 2  CA             dex
000743r 2  D0 F0          bne @SaveCFSec
000745r 2               @SaveCFOk:
000745r 2  AD 4A 03       lda FS_FILE_SIZE
000748r 2  85 2E          sta MON_ADDR
00074Ar 2  AD 4B 03       lda FS_FILE_SIZE+1
00074Dr 2  85 2F          sta MON_ADDR+1
00074Fr 2  20 rr rr       jsr MonPrintSaved             ; Print "SAVED nnnn BYTES"
000752r 2  60             rts
000753r 2               @SaveCFSecErr:
000753r 2  FA             plx                           ; Balance stack
000754r 2               @SaveCFIOErr:
000754r 2  20 rr rr       jsr MonPrintIOErr
000757r 2  60             rts
000758r 2               @SaveCFDirFull:
000758r 2  A2 00          ldx #0
00075Ar 2               @SaveCFDFLoop:
00075Ar 2  BD rr rr       lda MonStrDirFull,x
00075Dr 2  F0 06          beq @SaveCFDFDone
00075Fr 2  20 rr rr       jsr Chrout
000762r 2  E8             inx
000763r 2  80 F5          bra @SaveCFDFLoop
000765r 2               @SaveCFDFDone:
000765r 2  20 rr rr       jsr MonPrintCRLF
000768r 2  60             rts
000769r 2               @SaveError:
000769r 2  4C rr rr       jmp MonPrintError
00076Cr 2               
00076Cr 2               ; ============================================================================
00076Cr 2               ; MonCmdM — Memory dump (hex + ASCII, 8 bytes/row)
00076Cr 2               ; Syntax: M [addr] [addr]
00076Cr 2               ; Default: 8 lines (64 bytes). Remembers position for continuation.
00076Cr 2               ; ============================================================================
00076Cr 2               
00076Cr 2               MonCmdM:
00076Cr 2  20 rr rr       jsr MonSkipSpaces
00076Fr 2  20 rr rr       jsr MonParseHex4
000772r 2  90 2A          bcc @UseDefault               ; No address given — use current MON_ADDR
000774r 2                 ; Got first address in MON_ADDR — save it
000774r 2  A5 2E          lda MON_ADDR
000776r 2  85 32          sta MON_TMP
000778r 2  A5 2F          lda MON_ADDR+1
00077Ar 2  85 33          sta MON_TMP+1
00077Cr 2  20 rr rr       jsr MonSkipSpaces
00077Fr 2  20 rr rr       jsr MonParseHex4
000782r 2  90 12          bcc @StartOnly
000784r 2                 ; Got second address (end) in MON_ADDR
000784r 2  A5 2E          lda MON_ADDR
000786r 2  85 30          sta MON_END
000788r 2  A5 2F          lda MON_ADDR+1
00078Ar 2  85 31          sta MON_END+1
00078Cr 2                 ; Restore start address
00078Cr 2  A5 32          lda MON_TMP
00078Er 2  85 2E          sta MON_ADDR
000790r 2  A5 33          lda MON_TMP+1
000792r 2  85 2F          sta MON_ADDR+1
000794r 2  80 15          bra @DumpRange
000796r 2               @StartOnly:
000796r 2                 ; Only start address — restore from MON_TMP
000796r 2  A5 32          lda MON_TMP
000798r 2  85 2E          sta MON_ADDR
00079Ar 2  A5 33          lda MON_TMP+1
00079Cr 2  85 2F          sta MON_ADDR+1
00079Er 2               @UseDefault:
00079Er 2                 ; Set end = start + 63 (8 lines x 8 bytes)
00079Er 2  18             clc
00079Fr 2  A5 2E          lda MON_ADDR
0007A1r 2  69 3F          adc #63
0007A3r 2  85 30          sta MON_END
0007A5r 2  A5 2F          lda MON_ADDR+1
0007A7r 2  69 00          adc #0
0007A9r 2  85 31          sta MON_END+1
0007ABr 2               @DumpRange:
0007ABr 2  20 rr rr       jsr MonDumpLine
0007AEr 2  B0 0E          bcs @DumpDone                 ; Carry set = address wrapped past $FFFF
0007B0r 2                 ; Check if MON_ADDR > MON_END
0007B0r 2  A5 31          lda MON_END+1
0007B2r 2  C5 2F          cmp MON_ADDR+1
0007B4r 2  90 08          bcc @DumpDone
0007B6r 2  D0 F3          bne @DumpRange
0007B8r 2  A5 30          lda MON_END
0007BAr 2  C5 2E          cmp MON_ADDR
0007BCr 2  B0 ED          bcs @DumpRange
0007BEr 2               @DumpDone:
0007BEr 2  60             rts
0007BFr 2               
0007BFr 2               ; MonDumpLine — Dump 8 bytes at MON_ADDR as hex + ASCII, advance by 8
0007BFr 2               
0007BFr 2               MonDumpLine:
0007BFr 2                 ; Print ".:ADDR " (39 chars/line avoids 40-col auto-wrap + CRLF double-newline)
0007BFr 2  A9 2E          lda #'.'
0007C1r 2  20 rr rr       jsr Chrout
0007C4r 2  A9 3A          lda #':'
0007C6r 2  20 rr rr       jsr Chrout
0007C9r 2  20 rr rr       jsr MonPrintHex4
0007CCr 2  20 rr rr       jsr MonPrintSpace
0007CFr 2                 ; Print 8 hex bytes
0007CFr 2  A0 00          ldy #0
0007D1r 2               @HexLoop:
0007D1r 2  B1 2E          lda (MON_ADDR),y
0007D3r 2  5A             phy
0007D4r 2  20 rr rr       jsr MonPrintHex2
0007D7r 2  20 rr rr       jsr MonPrintSpace
0007DAr 2  7A             ply
0007DBr 2  C8             iny
0007DCr 2  C0 08          cpy #8
0007DEr 2  90 F1          bcc @HexLoop
0007E0r 2                 ; Print 8 ASCII characters (no extra space — fits 40 cols)
0007E0r 2  A0 00          ldy #0
0007E2r 2               @AsciiLoop:
0007E2r 2  B1 2E          lda (MON_ADDR),y
0007E4r 2  C9 20          cmp #$20
0007E6r 2  90 04          bcc @NotPrint
0007E8r 2  C9 7F          cmp #$7F
0007EAr 2  90 02          bcc @DoPrint
0007ECr 2               @NotPrint:
0007ECr 2  A9 2E          lda #'.'
0007EEr 2               @DoPrint:
0007EEr 2  5A             phy
0007EFr 2  20 rr rr       jsr Chrout
0007F2r 2  7A             ply
0007F3r 2  C8             iny
0007F4r 2  C0 08          cpy #8
0007F6r 2  90 EA          bcc @AsciiLoop
0007F8r 2                 ; Advance MON_ADDR by 8
0007F8r 2  18             clc
0007F9r 2  A5 2E          lda MON_ADDR
0007FBr 2  69 08          adc #8
0007FDr 2  85 2E          sta MON_ADDR
0007FFr 2  90 04          bcc @NoCarry
000801r 2  E6 2F          inc MON_ADDR+1
000803r 2  F0 05          beq @Wrapped                  ; High byte became $00 = wrapped past $FFFF
000805r 2               @NoCarry:
000805r 2  20 rr rr       jsr MonPrintCRLF
000808r 2  18             clc                           ; Signal no overflow
000809r 2  60             rts
00080Ar 2               @Wrapped:
00080Ar 2  20 rr rr       jsr MonPrintCRLF
00080Dr 2  38             sec                           ; Signal overflow
00080Er 2  60             rts
00080Fr 2               
00080Fr 2               ; ============================================================================
00080Fr 2               ; MonCmdD — Disassemble 65C02 instructions
00080Fr 2               ; Syntax: D [addr] [addr]
00080Fr 2               ; Default: 20 lines. Remembers position for continuation.
00080Fr 2               ; ============================================================================
00080Fr 2               
00080Fr 2               MonCmdD:
00080Fr 2  20 rr rr       jsr MonSkipSpaces
000812r 2  20 rr rr       jsr MonParseHex4
000815r 2  90 2A          bcc @UseDefault
000817r 2                 ; Got first address
000817r 2  A5 2E          lda MON_ADDR
000819r 2  85 32          sta MON_TMP
00081Br 2  A5 2F          lda MON_ADDR+1
00081Dr 2  85 33          sta MON_TMP+1
00081Fr 2  20 rr rr       jsr MonSkipSpaces
000822r 2  20 rr rr       jsr MonParseHex4
000825r 2  90 12          bcc @StartOnly
000827r 2                 ; Got end address
000827r 2  A5 2E          lda MON_ADDR
000829r 2  85 30          sta MON_END
00082Br 2  A5 2F          lda MON_ADDR+1
00082Dr 2  85 31          sta MON_END+1
00082Fr 2  A5 32          lda MON_TMP
000831r 2  85 2E          sta MON_ADDR
000833r 2  A5 33          lda MON_TMP+1
000835r 2  85 2F          sta MON_ADDR+1
000837r 2  80 15          bra @DisRange
000839r 2               @StartOnly:
000839r 2  A5 32          lda MON_TMP
00083Br 2  85 2E          sta MON_ADDR
00083Dr 2  A5 33          lda MON_TMP+1
00083Fr 2  85 2F          sta MON_ADDR+1
000841r 2               @UseDefault:
000841r 2                 ; Disassemble 20 lines
000841r 2  A2 14          ldx #20
000843r 2               @DisCountLoop:
000843r 2  DA             phx
000844r 2  20 rr rr       jsr DisOneLine
000847r 2  FA             plx
000848r 2  B0 17          bcs @DisDone                  ; Carry set = address wrapped past $FFFF
00084Ar 2  CA             dex
00084Br 2  D0 F6          bne @DisCountLoop
00084Dr 2  60             rts
00084Er 2               @DisRange:
00084Er 2  20 rr rr       jsr DisOneLine
000851r 2  B0 0E          bcs @DisDone                  ; Carry set = address wrapped past $FFFF
000853r 2                 ; Check if MON_ADDR > MON_END
000853r 2  A5 31          lda MON_END+1
000855r 2  C5 2F          cmp MON_ADDR+1
000857r 2  90 08          bcc @DisDone
000859r 2  D0 F3          bne @DisRange
00085Br 2  A5 30          lda MON_END
00085Dr 2  C5 2E          cmp MON_ADDR
00085Fr 2  B0 ED          bcs @DisRange
000861r 2               @DisDone:
000861r 2  60             rts
000862r 2               
000862r 2               ; ============================================================================
000862r 2               ; DisOneLine — Disassemble one instruction at MON_ADDR
000862r 2               ; Prints line, advances MON_ADDR by instruction length.
000862r 2               ; Uses: MON_BYTE=opcode, MON_TMP=mnemonic idx, MON_TMP+1=mode
000862r 2               ;       Stack holds instruction length throughout.
000862r 2               ; ============================================================================
000862r 2               
000862r 2               DisOneLine:
000862r 2                 ; Read opcode and look up table
000862r 2  A0 00          ldy #0
000864r 2  B1 2E          lda (MON_ADDR),y
000866r 2  85 34          sta MON_BYTE                  ; save opcode
000868r 2  0A             asl a                         ; opcode * 2 for table index
000869r 2  AA             tax
00086Ar 2  90 0C          bcc @LowHalf                  ; carry clear = opcodes $00-$7F
00086Cr 2  BD rr rr       lda DisOpcodeTable+256,x      ; opcodes $80-$FF: offset by 256
00086Fr 2  85 32          sta MON_TMP                   ; mnemonic index
000871r 2  BD rr rr       lda DisOpcodeTable+257,x
000874r 2  85 33          sta MON_TMP+1                 ; addressing mode
000876r 2  80 0A          bra @GotEntry
000878r 2               @LowHalf:
000878r 2  BD rr rr       lda DisOpcodeTable,x
00087Br 2  85 32          sta MON_TMP                   ; mnemonic index
00087Dr 2  BD rr rr       lda DisOpcodeTable+1,x
000880r 2  85 33          sta MON_TMP+1                 ; addressing mode
000882r 2               @GotEntry:
000882r 2                 ; Get instruction length from mode
000882r 2  A6 33          ldx MON_TMP+1
000884r 2  BD rr rr       lda DisModeSizes,x
000887r 2  1A             inc a                         ; +1 for opcode = total length
000888r 2  48             pha                           ; save on stack (stays until end)
000889r 2                 ; Print prefix ".,ADDR" (no space — consistent with M command's .:ADDR)
000889r 2  A9 2E          lda #'.'
00088Br 2  20 rr rr       jsr Chrout
00088Er 2  A9 2C          lda #','
000890r 2  20 rr rr       jsr Chrout
000893r 2                 ; Print address
000893r 2  20 rr rr       jsr MonPrintHex4
000896r 2  20 rr rr       jsr MonPrintSpace
000899r 2  20 rr rr       jsr MonPrintSpace
00089Cr 2                 ; Print opcode byte
00089Cr 2  A5 34          lda MON_BYTE
00089Er 2  20 rr rr       jsr MonPrintHex2
0008A1r 2                 ; Print 2nd byte or padding
0008A1r 2  68             pla
0008A2r 2  48             pha                           ; peek at length
0008A3r 2  C9 02          cmp #2
0008A5r 2  90 0C          bcc @Pad1
0008A7r 2  20 rr rr       jsr MonPrintSpace
0008AAr 2  A0 01          ldy #1
0008ACr 2  B1 2E          lda (MON_ADDR),y
0008AEr 2  20 rr rr       jsr MonPrintHex2
0008B1r 2  80 09          bra @Check3
0008B3r 2               @Pad1:
0008B3r 2  20 rr rr       jsr MonPrintSpace
0008B6r 2  20 rr rr       jsr MonPrintSpace
0008B9r 2  20 rr rr       jsr MonPrintSpace
0008BCr 2               @Check3:
0008BCr 2  68             pla
0008BDr 2  48             pha
0008BEr 2  C9 03          cmp #3
0008C0r 2  90 0C          bcc @Pad2
0008C2r 2  20 rr rr       jsr MonPrintSpace
0008C5r 2  A0 02          ldy #2
0008C7r 2  B1 2E          lda (MON_ADDR),y
0008C9r 2  20 rr rr       jsr MonPrintHex2
0008CCr 2  80 09          bra @AfterBytes
0008CEr 2               @Pad2:
0008CEr 2  20 rr rr       jsr MonPrintSpace
0008D1r 2  20 rr rr       jsr MonPrintSpace
0008D4r 2  20 rr rr       jsr MonPrintSpace
0008D7r 2               @AfterBytes:
0008D7r 2                 ; Separator before mnemonic
0008D7r 2  20 rr rr       jsr MonPrintSpace
0008DAr 2  20 rr rr       jsr MonPrintSpace
0008DDr 2                 ; Print mnemonic (3 chars)
0008DDr 2  20 rr rr       jsr DisPrintMnemonic
0008E0r 2                 ; For RMB/SMB/BBR/BBS, append bit number digit
0008E0r 2  A5 32          lda MON_TMP
0008E2r 2  C9 03          cmp #MN_BBR
0008E4r 2  F0 11          beq @BitNum
0008E6r 2  C9 04          cmp #MN_BBS
0008E8r 2  F0 0D          beq @BitNum
0008EAr 2  C9 2E          cmp #MN_RMB
0008ECr 2  F0 09          beq @BitNum
0008EEr 2  C9 37          cmp #MN_SMB
0008F0r 2  F0 05          beq @BitNum
0008F2r 2  20 rr rr       jsr MonPrintSpace             ; normal mnemonic — space separator
0008F5r 2  80 11          bra @Operand
0008F7r 2               @BitNum:
0008F7r 2  A5 34          lda MON_BYTE                  ; opcode encodes bit in upper nibble
0008F9r 2  4A             lsr a
0008FAr 2  4A             lsr a
0008FBr 2  4A             lsr a
0008FCr 2  4A             lsr a
0008FDr 2  29 07          and #$07
0008FFr 2  18             clc
000900r 2  69 30          adc #'0'
000902r 2  20 rr rr       jsr Chrout
000905r 2  20 rr rr       jsr MonPrintSpace
000908r 2               @Operand:
000908r 2                 ; Print operand based on addressing mode
000908r 2  A5 33          lda MON_TMP+1
00090Ar 2  20 rr rr       jsr DisPrintOperand
00090Dr 2                 ; CRLF
00090Dr 2  20 rr rr       jsr MonPrintCRLF
000910r 2                 ; Advance MON_ADDR by instruction length
000910r 2  68             pla                           ; length from stack
000911r 2  18             clc
000912r 2  65 2E          adc MON_ADDR
000914r 2  85 2E          sta MON_ADDR
000916r 2  90 04          bcc @NoWrap
000918r 2  E6 2F          inc MON_ADDR+1
00091Ar 2  F0 02          beq @DisWrapped               ; High byte became $00 = wrapped past $FFFF
00091Cr 2               @NoWrap:
00091Cr 2  18             clc                           ; Signal no overflow
00091Dr 2  60             rts
00091Er 2               @DisWrapped:
00091Er 2  38             sec                           ; Signal overflow
00091Fr 2  60             rts
000920r 2               
000920r 2               ; DisPrintMnemonic — Print 3-char mnemonic from MON_TMP index
000920r 2               
000920r 2               DisPrintMnemonic:
000920r 2  A5 32          lda MON_TMP                   ; mnemonic index
000922r 2  0A             asl a                         ; index * 2
000923r 2  18             clc
000924r 2  65 32          adc MON_TMP                   ; + index = index * 3
000926r 2  AA             tax
000927r 2  BD rr rr       lda DisMnemonics,x
00092Ar 2  DA             phx
00092Br 2  20 rr rr       jsr Chrout
00092Er 2  FA             plx
00092Fr 2  BD rr rr       lda DisMnemonics+1,x
000932r 2  DA             phx
000933r 2  20 rr rr       jsr Chrout
000936r 2  FA             plx
000937r 2  BD rr rr       lda DisMnemonics+2,x
00093Ar 2  4C rr rr       jmp Chrout
00093Dr 2               
00093Dr 2               ; DisPrintOperand — Dispatch to addressing mode operand printer
00093Dr 2               ; Input: A = addressing mode index
