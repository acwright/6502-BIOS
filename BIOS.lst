0016E6r 2               ; BasCmdClr -- implement CLR (clear vars/arrays/strings without erasing program).
0016E6r 2               ;   VARTAB := PRGEND (already correct in our model)
0016E6r 2               ;   ARYTAB := STREND := VARTAB
0016E6r 2               ;   FRETOP := MEMSIZ
0016E6r 2               ;   TEMPPT := TEMPST, DATAPTR := TXTTAB-1, stacks emptied
0016E6r 2               ; ---------------------------------------------------------------------------
0016E6r 2               BasCmdClr:
0016E6r 2                       ; ARYTAB = STREND = VARTAB
0016E6r 2  AD 5F 03             lda     VARTAB
