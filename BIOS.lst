000879r 2  60             rts
00087Ar 2               
00087Ar 2               ; ============================================================================
00087Ar 2               ; DisOneLine — Disassemble one instruction at MON_ADDR
00087Ar 2               ; Prints line, advances MON_ADDR by instruction length.
00087Ar 2               ; Uses: MON_BYTE=opcode, MON_TMP=mnemonic idx, MON_TMP+1=mode
00087Ar 2               ;       Stack holds instruction length throughout.
00087Ar 2               ; ============================================================================
00087Ar 2               
00087Ar 2               DisOneLine:
00087Ar 2                 ; Read opcode and look up table
00087Ar 2  A0 00          ldy #0
00087Cr 2  B1 2E          lda (MON_ADDR),y
00087Er 2  85 34          sta MON_BYTE                  ; save opcode
000880r 2  0A             asl a                         ; opcode * 2 for table index
000881r 2  AA             tax
000882r 2  90 0C          bcc @LowHalf                  ; carry clear = opcodes $00-$7F
000884r 2  BD rr rr       lda DisOpcodeTable+256,x      ; opcodes $80-$FF: offset by 256
000887r 2  85 32          sta MON_TMP                   ; mnemonic index
000889r 2  BD rr rr       lda DisOpcodeTable+257,x
00088Cr 2  85 33          sta MON_TMP+1                 ; addressing mode
00088Er 2  80 0A          bra @GotEntry
000890r 2               @LowHalf:
000890r 2  BD rr rr       lda DisOpcodeTable,x
000893r 2  85 32          sta MON_TMP                   ; mnemonic index
000895r 2  BD rr rr       lda DisOpcodeTable+1,x
000898r 2  85 33          sta MON_TMP+1                 ; addressing mode
00089Ar 2               @GotEntry:
00089Ar 2                 ; Get instruction length from mode
00089Ar 2  A6 33          ldx MON_TMP+1
00089Cr 2  BD rr rr       lda DisModeSizes,x
00089Fr 2  1A             inc a                         ; +1 for opcode = total length
0008A0r 2  48             pha                           ; save on stack (stays until end)
0008A1r 2                 ; Print prefix ".,ADDR" (no space — consistent with M command's .:ADDR)
0008A1r 2  A9 2E          lda #'.'
0008A3r 2  20 rr rr       jsr Chrout
0008A6r 2  A9 2C          lda #','
0008A8r 2  20 rr rr       jsr Chrout
0008ABr 2                 ; Print address
0008ABr 2  20 rr rr       jsr MonPrintHex4
0008AEr 2  20 rr rr       jsr MonPrintSpace
0008B1r 2  20 rr rr       jsr MonPrintSpace
0008B4r 2                 ; Print opcode byte
0008B4r 2  A5 34          lda MON_BYTE
0008B6r 2  20 rr rr       jsr MonPrintHex2
0008B9r 2                 ; Print 2nd byte or padding
0008B9r 2  68             pla
0008BAr 2  48             pha                           ; peek at length
0008BBr 2  C9 02          cmp #2
0008BDr 2  90 0C          bcc @Pad1
0008BFr 2  20 rr rr       jsr MonPrintSpace
0008C2r 2  A0 01          ldy #1
0008C4r 2  B1 2E          lda (MON_ADDR),y
0008C6r 2  20 rr rr       jsr MonPrintHex2
0008C9r 2  80 09          bra @Check3
