0008D5r 2  48             pha
0008D6r 2  C9 03          cmp #3
0008D8r 2  90 0C          bcc @Pad2
0008DAr 2  20 rr rr       jsr MonPrintSpace
0008DDr 2  A0 02          ldy #2
