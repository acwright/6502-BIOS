002D1Cr 2  51 55 41 4E  
002D25r 2  52 45 54 55          .byte   "RETURN WITHOUT GOSUB",0; ERR_RG
002D29r 2  52 4E 20 57  
002D2Dr 2  49 54 48 4F  
002D3Ar 2  4E 45 58 54          .byte   "NEXT WITHOUT FOR",0    ; ERR_NF
002D3Er 2  20 57 49 54  
002D42r 2  48 4F 55 54  
002D4Br 2  4F 55 54 20          .byte   "OUT OF DATA",0         ; ERR_OD
002D4Fr 2  4F 46 20 44  
002D53r 2  41 54 41 00  
002D57r 2  4E 4F 20 44          .byte   "NO DEVICE",0           ; ERR_NODEV
002D5Br 2  45 56 49 43  
002D5Fr 2  45 00        
002D61r 2  43 41 4E 27          .byte   "CAN'T CONTINUE",0      ; ERR_CANTCONT
002D65r 2  54 20 43 4F  
002D69r 2  4E 54 49 4E  
002D70r 2               
002D70r 2               ; =============================================================================
002D70r 2               ;   S T R I N G   C O N S T A N T S
002D70r 2               ; =============================================================================
002D70r 2               
002D70r 2               MsgBanner:
002D70r 2  0D 0A 36 35          .byte   $0D,$0A,"6502 BASIC V2.1",$0D,$0A,0
002D74r 2  30 32 20 42  
002D78r 2  41 53 49 43  
002D84r 2               
002D84r 2               MsgBytesFreeNL:
002D84r 2  20 42 59 54          .byte   " BYTES FREE",$0D,$0A,0
002D88r 2  45 53 20 46  
002D8Cr 2  52 45 45 0D  
002D92r 2               
002D92r 2               MsgOK:
002D92r 2  4F 4B 0D 0A          .byte   "OK",$0D,$0A,0
002D96r 2  00           
002D97r 2               
002D97r 2               MsgErrorWord:
002D97r 2  20 45 52 52          .byte   " ERROR",0
002D9Br 2  4F 52 00     
002D9Er 2               
002D9Er 2               MsgInWord:
002D9Er 2  20 49 4E 20          .byte   " IN ",0
002DA2r 2  00           
002DA3r 2               
002DA3r 1               .segment "MONITOR"
000000r 1               .include "Monitor.asm"
000000r 2               ; ***             ***
000000r 2               ; ***   MONITOR   ***
000000r 2               ; ***             ***
000000r 2               
000000r 2               ; Machine Code Monitor — Supermon-style command set
000000r 2               ; Segment: $EE00-$FEFF (~4KB)
000000r 2               ;
000000r 2               ; Entry points:
000000r 2               ;   MonitorEntry    ($EE00) — Cold entry from boot menu or X return
000000r 2               ;   MonitorBrkEntry ($EE03) — BRK entry with register display
000000r 2               
000000r 2               ; ============================================================================
000000r 2               ; Monitor Constants
000000r 2               ; ============================================================================
000000r 2               
000000r 2               MON_LINBUF          = BAS_LINBUF         ; Share BASIC's line buffer ($0434)
000000r 2               MON_LINBUF_SIZE     = 200                ; Max input line length
000000r 2               MON_PROMPT          = '.'                ; Supermon-style prompt character
000000r 2               
000000r 2               ; Mnemonic Indices (for disassembler)
000000r 2               MN_ADC = 0
000000r 2               MN_AND = 1
000000r 2               MN_ASL = 2
000000r 2               MN_BBR = 3
000000r 2               MN_BBS = 4
000000r 2               MN_BCC = 5
000000r 2               MN_BCS = 6
000000r 2               MN_BEQ = 7
000000r 2               MN_BIT = 8
000000r 2               MN_BMI = 9
000000r 2               MN_BNE = 10
000000r 2               MN_BPL = 11
000000r 2               MN_BRA = 12
000000r 2               MN_BRK = 13
000000r 2               MN_BVC = 14
000000r 2               MN_BVS = 15
000000r 2               MN_CLC = 16
000000r 2               MN_CLD = 17
000000r 2               MN_CLI = 18
000000r 2               MN_CLV = 19
000000r 2               MN_CMP = 20
000000r 2               MN_CPX = 21
000000r 2               MN_CPY = 22
000000r 2               MN_DEC = 23
000000r 2               MN_DEX = 24
000000r 2               MN_DEY = 25
000000r 2               MN_EOR = 26
000000r 2               MN_INC = 27
000000r 2               MN_INX = 28
000000r 2               MN_INY = 29
000000r 2               MN_JMP = 30
000000r 2               MN_JSR = 31
000000r 2               MN_LDA = 32
000000r 2               MN_LDX = 33
000000r 2               MN_LDY = 34
000000r 2               MN_LSR = 35
000000r 2               MN_NOP = 36
000000r 2               MN_ORA = 37
000000r 2               MN_PHA = 38
000000r 2               MN_PHP = 39
000000r 2               MN_PHX = 40
000000r 2               MN_PHY = 41
000000r 2               MN_PLA = 42
000000r 2               MN_PLP = 43
000000r 2               MN_PLX = 44
000000r 2               MN_PLY = 45
000000r 2               MN_RMB = 46
000000r 2               MN_ROL = 47
000000r 2               MN_ROR = 48
000000r 2               MN_RTI = 49
000000r 2               MN_RTS = 50
000000r 2               MN_SBC = 51
000000r 2               MN_SEC = 52
000000r 2               MN_SED = 53
000000r 2               MN_SEI = 54
000000r 2               MN_SMB = 55
000000r 2               MN_STA = 56
000000r 2               MN_STP = 57
000000r 2               MN_STX = 58
000000r 2               MN_STY = 59
000000r 2               MN_STZ = 60
000000r 2               MN_TAX = 61
000000r 2               MN_TAY = 62
000000r 2               MN_TRB = 63
000000r 2               MN_TSB = 64
000000r 2               MN_TSX = 65
000000r 2               MN_TXA = 66
000000r 2               MN_TXS = 67
000000r 2               MN_TYA = 68
000000r 2               MN_WAI = 69
000000r 2               MN_UND = 70
000000r 2               
000000r 2               ; Addressing Mode Indices
000000r 2               AM_IMP = 0
000000r 2               AM_ACC = 1
000000r 2               AM_IMM = 2
000000r 2               AM_ZP  = 3
000000r 2               AM_ZPX = 4
000000r 2               AM_ZPY = 5
000000r 2               AM_ABS = 6
000000r 2               AM_ABX = 7
000000r 2               AM_ABY = 8
000000r 2               AM_IND = 9
000000r 2               AM_IZX = 10
000000r 2               AM_IZY = 11
000000r 2               AM_ZPI = 12
000000r 2               AM_REL = 13
000000r 2               AM_ZPR = 14
000000r 2               AM_AIX = 15
000000r 2               
000000r 2               ; ============================================================================
000000r 2               ; Entry Points
000000r 2               ; ============================================================================
000000r 2               
000000r 2               MonitorEntry:
000000r 2  4C rr rr       jmp MonColdEntry              ; $EE00 - Cold entry (boot menu / return)
000003r 2               
000003r 2               MonitorBrkEntry:
000003r 2  4C rr rr       jmp MonBrkEntry               ; $C003 - BRK entry (register display)
000006r 2               
000006r 2               ; ============================================================================
000006r 2               ; Cold Entry — print banner and enter command loop
000006r 2               ; ============================================================================
000006r 2               
000006r 2               MonColdEntry:
000006r 2  A2 FF          ldx #$FF
000008r 2  9A             txs                           ; Reset stack pointer
000009r 2  D8             cld                           ; Ensure binary mode
00000Ar 2  20 rr rr       jsr VideoClear                ; Clear screen
00000Dr 2  20 rr rr       jsr MonPrintBanner            ; Print "MONITOR" banner
000010r 2  4C rr rr       jmp MonCmdLoop
000013r 2               
000013r 2               ; ============================================================================
000013r 2               ; BRK Entry — print BRK address, display registers, enter command loop
000013r 2               ; ============================================================================
000013r 2               
000013r 2               MonBrkEntry:
000013r 2  A2 FF          ldx #$FF
000015r 2  9A             txs                           ; Reset stack pointer
000016r 2  D8             cld
000017r 2  20 rr rr       jsr VideoClear                ; Clear screen
00001Ar 2  20 rr rr       jsr MonPrintBanner            ; Print "MONITOR" banner
00001Dr 2                 ; Print "BRK AT $"
00001Dr 2  A2 00          ldx #0
00001Fr 2               @BrkMsgLoop:
00001Fr 2  BD rr rr       lda MonStrBrk,x
000022r 2  F0 06          beq @BrkMsgDone
000024r 2  20 rr rr       jsr Chrout
000027r 2  E8             inx
000028r 2  80 F5          bra @BrkMsgLoop
00002Ar 2               @BrkMsgDone:
00002Ar 2                 ; Print PC address (adjusted: BRK_PC points to BRK+2, subtract 2 for actual BRK location)
00002Ar 2  38             sec
00002Br 2  AD 11 03       lda BRK_PCL
00002Er 2  E9 02          sbc #2
000030r 2  85 2E          sta MON_ADDR
000032r 2  AD 12 03       lda BRK_PCH
000035r 2  E9 00          sbc #0
000037r 2  85 2F          sta MON_ADDR + 1
000039r 2  20 rr rr       jsr MonPrintHex4
00003Cr 2  20 rr rr       jsr MonPrintCRLF
00003Fr 2                 ; Display registers
00003Fr 2  20 rr rr       jsr MonShowRegs
000042r 2  4C rr rr       jmp MonCmdLoop
000045r 2               
000045r 2               ; ============================================================================
000045r 2               ; Command Loop — prompt, read, parse, dispatch
000045r 2               ; ============================================================================
000045r 2               
000045r 2               MonCmdLoop:
000045r 2                 ; Print prompt
000045r 2  A9 2E          lda #MON_PROMPT
000047r 2  20 rr rr       jsr Chrout
00004Ar 2  A9 20          lda #' '
00004Cr 2  20 rr rr       jsr Chrout
00004Fr 2               
00004Fr 2                 ; Read input line
00004Fr 2  20 rr rr       jsr MonReadLine
000052r 2               
000052r 2                 ; Parse and dispatch
000052r 2  20 rr rr       jsr MonParseLine
000055r 2               
000055r 2                 ; Loop back for next command
000055r 2  4C rr rr       jmp MonCmdLoop
000058r 2               
000058r 2               ; ============================================================================
000058r 2               ; MonReadLine — Read a line of input into MON_LINBUF
000058r 2               ; Returns: MON_LINBUF contains null-terminated input, Y = length
000058r 2               ; ============================================================================
000058r 2               
000058r 2               MonReadLine:
000058r 2  A0 00          ldy #0                        ; Index into line buffer
00005Ar 2               @ReadWait:
00005Ar 2  20 rr rr       jsr Chrin                     ; Try to read a character (carry set = got one)
00005Dr 2  90 FB          bcc @ReadWait                 ; No char available, keep waiting
00005Fr 2                 ; Got a character in A
00005Fr 2  C9 0D          cmp #$0D                      ; Carriage return?
000061r 2  F0 21          beq @ReadDone
000063r 2  C9 0A          cmp #$0A                      ; Line feed? (treat same as CR)
000065r 2  F0 1D          beq @ReadDone
000067r 2  C9 08          cmp #$08                      ; Backspace?
000069r 2  F0 12          beq @ReadBS
00006Br 2  C9 7F          cmp #$7F                      ; Delete? (treat as backspace)
00006Dr 2  F0 0E          beq @ReadBS
00006Fr 2                 ; Skip non-printable characters ($00-$1F)
00006Fr 2  C9 20          cmp #$20
000071r 2  90 E7          bcc @ReadWait
000073r 2                 ; Printable character — store if room
000073r 2  C0 C8          cpy #MON_LINBUF_SIZE
000075r 2  B0 E3          bcs @ReadWait                 ; Buffer full, ignore
000077r 2  99 00 04       sta MON_LINBUF,y
00007Ar 2  C8             iny
00007Br 2  80 DD          bra @ReadWait
00007Dr 2               @ReadBS:
00007Dr 2  C0 00          cpy #0                        ; Anything to delete?
00007Fr 2  F0 D9          beq @ReadWait                 ; No, ignore
000081r 2  88             dey                           ; Back up one position
000082r 2  80 D6          bra @ReadWait
000084r 2               @ReadDone:
000084r 2  A9 0D          lda #$0D                      ; Echo CR
000086r 2  20 rr rr       jsr Chrout
000089r 2  A9 0A          lda #$0A                      ; Echo LF
00008Br 2  20 rr rr       jsr Chrout
00008Er 2  A9 00          lda #0
000090r 2  99 00 04       sta MON_LINBUF,y              ; Null-terminate
000093r 2  60             rts
000094r 2               
000094r 2               ; ============================================================================
000094r 2               ; MonParseLine — Parse first char and dispatch to command handler
000094r 2               ; ============================================================================
000094r 2               
000094r 2               MonParseLine:
000094r 2  64 35          stz MON_IDX                   ; Reset parse index
000096r 2  20 rr rr       jsr MonSkipSpaces             ; Skip leading whitespace
000099r 2  A4 35          ldy MON_IDX
00009Br 2  B9 00 04       lda MON_LINBUF,y              ; Get command character
00009Er 2  F0 2A          beq @ParseDone                ; Empty line — just return
0000A0r 2                 ; Convert to uppercase
0000A0r 2  C9 61          cmp #'a'
0000A2r 2  90 06          bcc @ParseNoConv
0000A4r 2  C9 7B          cmp #'z'+1
0000A6r 2  B0 02          bcs @ParseNoConv
0000A8r 2  29 DF          and #$DF                      ; Convert lowercase to uppercase
0000AAr 2               @ParseNoConv:
0000AAr 2  E6 35          inc MON_IDX                   ; Advance past command char
0000ACr 2                 ; Search dispatch table
0000ACr 2  A2 00          ldx #0
0000AEr 2               @DispatchLoop:
0000AEr 2  BC rr rr       ldy MonCmdTable,x             ; Load command character from table
0000B1r 2  F0 14          beq @ParseError               ; End of table (null terminator) — unknown command
0000B3r 2  DD rr rr       cmp MonCmdTable,x             ; Compare with input character
0000B6r 2  F0 05          beq @DispatchFound
0000B8r 2  E8             inx                           ; Skip char
0000B9r 2  E8             inx                           ; Skip address low
0000BAr 2  E8             inx                           ; Skip address high
0000BBr 2  80 F1          bra @DispatchLoop
0000BDr 2               @DispatchFound:
0000BDr 2  E8             inx                           ; Point to address low byte
0000BEr 2  BD rr rr       lda MonCmdTable+1,x           ; Handler address high byte — push first (big-endian on stack)
0000C1r 2  48             pha
0000C2r 2  BD rr rr       lda MonCmdTable,x             ; Handler address low byte
0000C5r 2  48             pha
0000C6r 2  60             rts                           ; "Return" to handler address (RTS adds 1 to address)
0000C7r 2               @ParseError:
0000C7r 2  20 rr rr       jsr MonPrintError
0000CAr 2               @ParseDone:
0000CAr 2  60             rts
0000CBr 2               
0000CBr 2               ; ============================================================================
0000CBr 2               ; Command Dispatch Table
0000CBr 2               ; Format: command char (1 byte), handler address - 1 (2 bytes, low/high for RTS trick)
0000CBr 2               ; ============================================================================
0000CBr 2               
0000CBr 2               MonCmdTable:
0000CBr 2  58             .byte 'X'
0000CCr 2  rr rr          .word MonCmdX - 1
0000CEr 2  52             .byte 'R'
0000CFr 2  rr rr          .word MonCmdR - 1
0000D1r 2  4D             .byte 'M'
0000D2r 2  rr rr          .word MonCmdM - 1
0000D4r 2  44             .byte 'D'
0000D5r 2  rr rr          .word MonCmdD - 1
0000D7r 2  3E             .byte '>'
0000D8r 2  rr rr          .word MonCmdDeposit - 1
0000DAr 2  46             .byte 'F'
0000DBr 2  rr rr          .word MonCmdFill - 1
0000DDr 2  54             .byte 'T'
0000DEr 2  rr rr          .word MonCmdTransfer - 1
0000E0r 2  48             .byte 'H'
0000E1r 2  rr rr          .word MonCmdHunt - 1
0000E3r 2  43             .byte 'C'
0000E4r 2  rr rr          .word MonCmdCompare - 1
0000E6r 2  47             .byte 'G'
0000E7r 2  rr rr          .word MonCmdGo - 1
0000E9r 2  4A             .byte 'J'
0000EAr 2  rr rr          .word MonCmdJsr - 1
0000ECr 2  3B             .byte ';'
0000EDr 2  rr rr          .word MonCmdModRegs - 1
0000EFr 2  4C             .byte 'L'
0000F0r 2  rr rr          .word MonCmdLoad - 1
0000F2r 2  53             .byte 'S'
0000F3r 2  rr rr          .word MonCmdSave - 1
0000F5r 2  40             .byte '@'
0000F6r 2  rr rr          .word MonCmdDir - 1
0000F8r 2  4E             .byte 'N'
0000F9r 2  rr rr          .word MonCmdNum - 1
0000FBr 2  23             .byte '#'
0000FCr 2  rr rr          .word MonCmdDisk - 1
0000FEr 2  00             .byte 0                       ; End of table sentinel
0000FFr 2               
0000FFr 2               ; ============================================================================
0000FFr 2               ; MonCmdX — Exit to BASIC
0000FFr 2               ; ============================================================================
0000FFr 2               
0000FFr 2               MonCmdX:
0000FFr 2  20 rr rr       jsr VideoClear                ; Clear screen before entering BASIC
000102r 2  4C rr rr       jmp BasEntry
000105r 2               
000105r 2               ; ============================================================================
000105r 2               ; MonCmdR — Display CPU registers
000105r 2               ; ============================================================================
000105r 2               
000105r 2               MonCmdR:
000105r 2  20 rr rr       jsr MonShowRegs
000108r 2  60             rts
000109r 2               
000109r 2               ; ============================================================================
000109r 2               ; MonCmdDeposit — Deposit (write) bytes to memory
000109r 2               ; Syntax: > ADDR XX [XX XX ...]
000109r 2               ; ============================================================================
000109r 2               
000109r 2               MonCmdDeposit:
000109r 2  20 rr rr       jsr MonSkipSpaces
00010Cr 2  20 rr rr       jsr MonParseHex4              ; Parse target address into MON_ADDR
00010Fr 2  90 16          bcc @DepError                 ; No address → error
000111r 2  A0 00          ldy #0                        ; Byte offset from MON_ADDR
000113r 2               @DepLoop:
000113r 2  5A             phy                           ; Save byte offset (Y clobbered by parse routines)
000114r 2  20 rr rr       jsr MonSkipSpaces
000117r 2  20 rr rr       jsr MonParseHex2              ; Parse next byte into A
00011Ar 2  7A             ply                           ; Restore byte offset (PLY doesn't affect carry)
00011Br 2  90 05          bcc @DepDone                  ; No more bytes → done
00011Dr 2  91 2E          sta (MON_ADDR),y
00011Fr 2  C8             iny
000120r 2  D0 F1          bne @DepLoop                  ; Up to 256 bytes (Y wraps)
000122r 2               @DepDone:
000122r 2  C0 00          cpy #0                        ; Did we deposit at least one byte?
000124r 2  F0 01          beq @DepError                 ; No bytes given → error
000126r 2  60             rts
000127r 2               @DepError:
000127r 2  4C rr rr       jmp MonPrintError
00012Ar 2               
00012Ar 2               ; ============================================================================
00012Ar 2               ; MonCmdFill — Fill memory range with a byte value
00012Ar 2               ; Syntax: F ADDR1 ADDR2 XX
00012Ar 2               ; ============================================================================
00012Ar 2               
00012Ar 2               MonCmdFill:
00012Ar 2  20 rr rr       jsr MonSkipSpaces
00012Dr 2  20 rr rr       jsr MonParseHex4              ; Parse start address → MON_ADDR
000130r 2  90 43          bcc @FillError
000132r 2  A5 2E          lda MON_ADDR
000134r 2  85 32          sta MON_TMP
000136r 2  A5 2F          lda MON_ADDR+1
000138r 2  85 33          sta MON_TMP+1                 ; Save start in MON_TMP
00013Ar 2  20 rr rr       jsr MonSkipSpaces
00013Dr 2  20 rr rr       jsr MonParseHex4              ; Parse end address → MON_ADDR
000140r 2  90 33          bcc @FillError
000142r 2  A5 2E          lda MON_ADDR
000144r 2  85 30          sta MON_END
000146r 2  A5 2F          lda MON_ADDR+1
000148r 2  85 31          sta MON_END+1                 ; Save end in MON_END
00014Ar 2                 ; Restore start into MON_ADDR
00014Ar 2  A5 32          lda MON_TMP
00014Cr 2  85 2E          sta MON_ADDR
00014Er 2  A5 33          lda MON_TMP+1
000150r 2  85 2F          sta MON_ADDR+1
000152r 2  20 rr rr       jsr MonSkipSpaces
000155r 2  20 rr rr       jsr MonParseHex2              ; Parse fill byte → A
000158r 2  90 1B          bcc @FillError
00015Ar 2                 ; A = fill byte, MON_ADDR = start, MON_END = end (inclusive)
00015Ar 2  A0 00          ldy #0
00015Cr 2               @FillLoop:
00015Cr 2  91 2E          sta (MON_ADDR),y
00015Er 2                 ; Check if MON_ADDR == MON_END
00015Er 2  A6 2F          ldx MON_ADDR+1
000160r 2  E4 31          cpx MON_END+1
000162r 2  D0 06          bne @FillNext
000164r 2  A6 2E          ldx MON_ADDR
000166r 2  E4 30          cpx MON_END
000168r 2  F0 0A          beq @FillDone
00016Ar 2               @FillNext:
00016Ar 2                 ; Advance MON_ADDR
00016Ar 2  48             pha                           ; Save fill byte
00016Br 2  E6 2E          inc MON_ADDR
00016Dr 2  D0 02          bne @FillNoHi
00016Fr 2  E6 2F          inc MON_ADDR+1
000171r 2               @FillNoHi:
000171r 2  68             pla                           ; Restore fill byte
000172r 2  80 E8          bra @FillLoop
000174r 2               @FillDone:
000174r 2  60             rts
000175r 2               @FillError:
000175r 2  4C rr rr       jmp MonPrintError
000178r 2               
000178r 2               ; ============================================================================
000178r 2               ; MonCmdTransfer — Copy memory block (handles overlapping regions)
000178r 2               ; Syntax: T SRC_START SRC_END DEST
000178r 2               ; ============================================================================
000178r 2               
000178r 2               MonCmdTransfer:
000178r 2  20 rr rr       jsr MonSkipSpaces
00017Br 2  20 rr rr       jsr MonParseHex4              ; Parse source start → MON_ADDR
00017Er 2  B0 03          bcs @XferGotStart
000180r 2  4C rr rr       jmp @XferError                ; No address → error
000183r 2               @XferGotStart:
000183r 2  A5 2E          lda MON_ADDR
000185r 2  85 32          sta MON_TMP
000187r 2  A5 2F          lda MON_ADDR+1
000189r 2  85 33          sta MON_TMP+1                 ; MON_TMP = source start
00018Br 2  20 rr rr       jsr MonSkipSpaces
00018Er 2  20 rr rr       jsr MonParseHex4              ; Parse source end → MON_ADDR
000191r 2  B0 03          bcs @XferGotEnd
000193r 2  4C rr rr       jmp @XferError
000196r 2               @XferGotEnd:
000196r 2  A5 2E          lda MON_ADDR
000198r 2  85 30          sta MON_END
00019Ar 2  A5 2F          lda MON_ADDR+1
00019Cr 2  85 31          sta MON_END+1                 ; MON_END = source end (inclusive)
00019Er 2  20 rr rr       jsr MonSkipSpaces
0001A1r 2  20 rr rr       jsr MonParseHex4              ; Parse dest → MON_ADDR
0001A4r 2  B0 03          bcs @XferGotDest
0001A6r 2  4C rr rr       jmp @XferError
0001A9r 2               @XferGotDest:
0001A9r 2                 ; MON_ADDR = dest, MON_TMP = src start, MON_END = src end
0001A9r 2                 ; Determine copy direction: if dest > src_start, copy backward to handle overlap
0001A9r 2  A5 2F          lda MON_ADDR+1
0001ABr 2  C5 33          cmp MON_TMP+1
0001ADr 2  90 5C          bcc @CopyForward              ; dest < src → forward is safe
0001AFr 2  D0 08          bne @CopyBackward             ; dest > src → need backward
0001B1r 2  A5 2E          lda MON_ADDR
0001B3r 2  C5 32          cmp MON_TMP
0001B5r 2  90 54          bcc @CopyForward
0001B7r 2  F0 72          beq @XferDone                 ; dest == src → nothing to do
0001B9r 2               @CopyBackward:
0001B9r 2                 ; Compute offset = src_end - src_start
0001B9r 2  38             sec
0001BAr 2  A5 30          lda MON_END
0001BCr 2  E5 32          sbc MON_TMP
0001BEr 2  85 34          sta MON_BYTE                  ; low byte of offset
0001C0r 2  A5 31          lda MON_END+1
0001C2r 2  E5 33          sbc MON_TMP+1
0001C4r 2  85 35          sta MON_IDX                   ; high byte of offset (reuse MON_IDX as scratch)
0001C6r 2                 ; Point MON_TMP to src_end, MON_ADDR to dest + offset
0001C6r 2                 ; MON_TMP already needs to be src_end (currently src_start)
0001C6r 2                 ; Swap: MON_TMP = MON_END (src_end)
0001C6r 2  A5 30          lda MON_END
0001C8r 2  48             pha
0001C9r 2  A5 31          lda MON_END+1
0001CBr 2  48             pha
0001CCr 2                 ; MON_END = src_start (save for later comparison)
0001CCr 2  A5 32          lda MON_TMP
0001CEr 2  85 30          sta MON_END
0001D0r 2  A5 33          lda MON_TMP+1
0001D2r 2  85 31          sta MON_END+1
0001D4r 2                 ; MON_TMP = src_end
0001D4r 2  68             pla
0001D5r 2  85 33          sta MON_TMP+1
0001D7r 2  68             pla
0001D8r 2  85 32          sta MON_TMP
0001DAr 2                 ; dest_end = MON_ADDR + offset
0001DAr 2  18             clc
0001DBr 2  A5 2E          lda MON_ADDR
0001DDr 2  65 34          adc MON_BYTE
0001DFr 2  85 2E          sta MON_ADDR
0001E1r 2  A5 2F          lda MON_ADDR+1
0001E3r 2  65 35          adc MON_IDX
0001E5r 2  85 2F          sta MON_ADDR+1
0001E7r 2               @BackLoop:
0001E7r 2  A0 00          ldy #0
0001E9r 2  B1 32          lda (MON_TMP),y
0001EBr 2  91 2E          sta (MON_ADDR),y
0001EDr 2                 ; Check if MON_TMP == MON_END (src start, our stop address)
0001EDr 2  A5 33          lda MON_TMP+1
0001EFr 2  C5 31          cmp MON_END+1
0001F1r 2  D0 06          bne @BackDec
0001F3r 2  A5 32          lda MON_TMP
0001F5r 2  C5 30          cmp MON_END
0001F7r 2  F0 32          beq @XferDone
0001F9r 2               @BackDec:
0001F9r 2                 ; Decrement both pointers
0001F9r 2  A5 32          lda MON_TMP
0001FBr 2  D0 02          bne @BackDecTmpLo
0001FDr 2  C6 33          dec MON_TMP+1
0001FFr 2               @BackDecTmpLo:
0001FFr 2  C6 32          dec MON_TMP
000201r 2  A5 2E          lda MON_ADDR
000203r 2  D0 02          bne @BackDecDstLo
000205r 2  C6 2F          dec MON_ADDR+1
000207r 2               @BackDecDstLo:
000207r 2  C6 2E          dec MON_ADDR
000209r 2  80 DC          bra @BackLoop
00020Br 2               
00020Br 2               @CopyForward:
00020Br 2                 ; Copy from MON_TMP (src) to MON_ADDR (dest), up to MON_END (src end)
00020Br 2  A0 00          ldy #0
00020Dr 2               @FwdLoop:
00020Dr 2  B1 32          lda (MON_TMP),y
00020Fr 2  91 2E          sta (MON_ADDR),y
000211r 2                 ; Check if MON_TMP == MON_END
000211r 2  A5 33          lda MON_TMP+1
000213r 2  C5 31          cmp MON_END+1
000215r 2  D0 06          bne @FwdNext
000217r 2  A5 32          lda MON_TMP
000219r 2  C5 30          cmp MON_END
00021Br 2  F0 0E          beq @XferDone
00021Dr 2               @FwdNext:
00021Dr 2                 ; Advance both pointers
00021Dr 2  E6 32          inc MON_TMP
00021Fr 2  D0 02          bne @FwdNoDstCarry
000221r 2  E6 33          inc MON_TMP+1
000223r 2               @FwdNoDstCarry:
000223r 2  E6 2E          inc MON_ADDR
000225r 2  D0 E6          bne @FwdLoop
000227r 2  E6 2F          inc MON_ADDR+1
000229r 2  80 E2          bra @FwdLoop
00022Br 2               
00022Br 2               @XferDone:
00022Br 2  60             rts
00022Cr 2               @XferError:
00022Cr 2  4C rr rr       jmp MonPrintError
00022Fr 2               
00022Fr 2               ; ============================================================================
00022Fr 2               ; MonCmdHunt — Search for byte pattern in memory range
00022Fr 2               ; Syntax: H ADDR1 ADDR2 XX [XX XX ...]
00022Fr 2               ; Prints address of each match on its own line.
00022Fr 2               ; ============================================================================
00022Fr 2               
00022Fr 2               ; Hunt uses a temp buffer at end of MON_LINBUF area for the pattern.
00022Fr 2               ; Pattern bytes stored at MON_LINBUF+128, max 64 pattern bytes.
00022Fr 2               MON_HUNT_PAT        = MON_LINBUF + 128
00022Fr 2               MON_HUNT_PAT_MAX    = 64
00022Fr 2               
00022Fr 2               MonCmdHunt:
00022Fr 2  20 rr rr       jsr MonSkipSpaces
000232r 2  20 rr rr       jsr MonParseHex4              ; Parse start address → MON_ADDR
000235r 2  90 65          bcc @HuntError
000237r 2  A5 2E          lda MON_ADDR
000239r 2  85 32          sta MON_TMP
00023Br 2  A5 2F          lda MON_ADDR+1
00023Dr 2  85 33          sta MON_TMP+1                 ; MON_TMP = search start
00023Fr 2  20 rr rr       jsr MonSkipSpaces
000242r 2  20 rr rr       jsr MonParseHex4              ; Parse end address → MON_ADDR
000245r 2  90 55          bcc @HuntError
000247r 2  A5 2E          lda MON_ADDR
000249r 2  85 30          sta MON_END
00024Br 2  A5 2F          lda MON_ADDR+1
00024Dr 2  85 31          sta MON_END+1                 ; MON_END = search end
00024Fr 2                 ; Restore start
00024Fr 2  A5 32          lda MON_TMP
000251r 2  85 2E          sta MON_ADDR
000253r 2  A5 33          lda MON_TMP+1
000255r 2  85 2F          sta MON_ADDR+1
000257r 2                 ; Parse pattern bytes into MON_HUNT_PAT
000257r 2  A2 00          ldx #0                        ; Pattern length counter
000259r 2               @HuntParseByte:
000259r 2  DA             phx                           ; Save pattern counter (X clobbered by MonParseHex2)
00025Ar 2  20 rr rr       jsr MonSkipSpaces
00025Dr 2  20 rr rr       jsr MonParseHex2              ; Next byte → A
000260r 2  FA             plx                           ; Restore pattern counter (PLX doesn't affect carry)
000261r 2  90 0A          bcc @HuntParseEnd
000263r 2  E0 40          cpx #MON_HUNT_PAT_MAX
000265r 2  B0 06          bcs @HuntParseEnd             ; Pattern buffer full
000267r 2  9D 80 04       sta MON_HUNT_PAT,x
00026Ar 2  E8             inx
00026Br 2  80 EC          bra @HuntParseByte
00026Dr 2               @HuntParseEnd:
00026Dr 2  E0 00          cpx #0
00026Fr 2  F0 2B          beq @HuntError                ; No pattern bytes → error
000271r 2  86 34          stx MON_BYTE                  ; MON_BYTE = pattern length
000273r 2                 ; Search: scan MON_ADDR to MON_END for pattern match
000273r 2               @HuntScanLoop:
000273r 2  A0 00          ldy #0                        ; Pattern match index
000275r 2               @HuntMatchLoop:
000275r 2  B1 2E          lda (MON_ADDR),y
000277r 2  D9 80 04       cmp MON_HUNT_PAT,y
00027Ar 2  D0 0B          bne @HuntNoMatch
00027Cr 2  C8             iny
00027Dr 2  C4 34          cpy MON_BYTE                  ; Matched all pattern bytes?
00027Fr 2  90 F4          bcc @HuntMatchLoop
000281r 2                 ; Full match — print address
000281r 2  20 rr rr       jsr MonPrintHex4
000284r 2  20 rr rr       jsr MonPrintCRLF
000287r 2               @HuntNoMatch:
000287r 2                 ; Check if MON_ADDR == MON_END
000287r 2  A5 2F          lda MON_ADDR+1
000289r 2  C5 31          cmp MON_END+1
00028Br 2  D0 06          bne @HuntAdvance
00028Dr 2  A5 2E          lda MON_ADDR
00028Fr 2  C5 30          cmp MON_END
000291r 2  F0 08          beq @HuntDone
000293r 2               @HuntAdvance:
000293r 2  E6 2E          inc MON_ADDR
000295r 2  D0 DC          bne @HuntScanLoop
000297r 2  E6 2F          inc MON_ADDR+1
000299r 2  80 D8          bra @HuntScanLoop
00029Br 2               @HuntDone:
00029Br 2  60             rts
00029Cr 2               @HuntError:
00029Cr 2  4C rr rr       jmp MonPrintError
00029Fr 2               
00029Fr 2               ; ============================================================================
00029Fr 2               ; MonCmdCompare — Compare two memory regions
00029Fr 2               ; Syntax: C ADDR1 ADDR2 ADDR3
00029Fr 2               ; Compares [addr1,addr2] with block at addr3, prints differing addresses.
00029Fr 2               ; ============================================================================
00029Fr 2               
00029Fr 2               MonCmdCompare:
00029Fr 2  20 rr rr       jsr MonSkipSpaces
0002A2r 2  20 rr rr       jsr MonParseHex4              ; Parse addr1 (region1 start) → MON_ADDR
0002A5r 2  90 57          bcc @CmpError
0002A7r 2                 ; Save addr1 on stack
0002A7r 2  A5 2F          lda MON_ADDR+1
0002A9r 2  48             pha
0002AAr 2  A5 2E          lda MON_ADDR
0002ACr 2  48             pha
0002ADr 2  20 rr rr       jsr MonSkipSpaces
0002B0r 2  20 rr rr       jsr MonParseHex4              ; Parse addr2 (region1 end) → MON_ADDR
0002B3r 2  90 47          bcc @CmpErrorPop
0002B5r 2  A5 2E          lda MON_ADDR
0002B7r 2  85 30          sta MON_END
0002B9r 2  A5 2F          lda MON_ADDR+1
0002BBr 2  85 31          sta MON_END+1                 ; MON_END = region1 end (inclusive)
0002BDr 2  20 rr rr       jsr MonSkipSpaces
0002C0r 2  20 rr rr       jsr MonParseHex4              ; Parse addr3 (region2 base) → MON_ADDR
0002C3r 2  90 37          bcc @CmpErrorPop
0002C5r 2  A5 2E          lda MON_ADDR
0002C7r 2  85 32          sta MON_TMP
0002C9r 2  A5 2F          lda MON_ADDR+1
0002CBr 2  85 33          sta MON_TMP+1                 ; MON_TMP = region2 pointer
0002CDr 2                 ; Restore addr1 → MON_ADDR
0002CDr 2  68             pla
0002CEr 2  85 2E          sta MON_ADDR
0002D0r 2  68             pla
0002D1r 2  85 2F          sta MON_ADDR+1
0002D3r 2                 ; Compare loop: [MON_ADDR..MON_END] vs [MON_TMP..]
0002D3r 2  A0 00          ldy #0
0002D5r 2               @CmpLoop:
0002D5r 2  B1 2E          lda (MON_ADDR),y
0002D7r 2  D1 32          cmp (MON_TMP),y
0002D9r 2  F0 06          beq @CmpMatch
0002DBr 2                 ; Mismatch — print addr1 address
0002DBr 2  20 rr rr       jsr MonPrintHex4
0002DEr 2  20 rr rr       jsr MonPrintCRLF
0002E1r 2               @CmpMatch:
0002E1r 2                 ; Check if MON_ADDR == MON_END
0002E1r 2  A5 2F          lda MON_ADDR+1
0002E3r 2  C5 31          cmp MON_END+1
0002E5r 2  D0 06          bne @CmpNext
0002E7r 2  A5 2E          lda MON_ADDR
0002E9r 2  C5 30          cmp MON_END
0002EBr 2  F0 0E          beq @CmpDone
0002EDr 2               @CmpNext:
0002EDr 2                 ; Advance both pointers
0002EDr 2  E6 2E          inc MON_ADDR
0002EFr 2  D0 02          bne @CmpNoHi1
0002F1r 2  E6 2F          inc MON_ADDR+1
0002F3r 2               @CmpNoHi1:
0002F3r 2  E6 32          inc MON_TMP
0002F5r 2  D0 DE          bne @CmpLoop
0002F7r 2  E6 33          inc MON_TMP+1
0002F9r 2  80 DA          bra @CmpLoop
0002FBr 2               @CmpDone:
0002FBr 2  60             rts
0002FCr 2               @CmpErrorPop:
0002FCr 2  68             pla                           ; Clean up stack
0002FDr 2  68             pla
0002FEr 2               @CmpError:
0002FEr 2  4C rr rr       jmp MonPrintError
000301r 2               
000301r 2               ; ============================================================================
000301r 2               ; MonCmdGo — Go (JMP to address with full register restore via RTI)
000301r 2               ; Syntax: G [addr]
000301r 2               ; If addr given, sets BRK_PCL/PCH. Restores A, X, Y, P, SP via RTI.
000301r 2               ; Program runs until BRK returns to monitor or forever.
000301r 2               ; ============================================================================
000301r 2               
000301r 2               MonCmdGo:
000301r 2  20 rr rr       jsr MonSkipSpaces
000304r 2  20 rr rr       jsr MonParseHex4
000307r 2  90 0A          bcc @GoNoAddr
000309r 2                 ; Address given — store to BRK_PCL/PCH
000309r 2  A5 2E          lda MON_ADDR
00030Br 2  8D 11 03       sta BRK_PCL
00030Er 2  A5 2F          lda MON_ADDR+1
000310r 2  8D 12 03       sta BRK_PCH
000313r 2               @GoNoAddr:
000313r 2  78             sei                           ; Disable interrupts during stack manipulation
000314r 2                 ; Restore user's stack pointer
000314r 2                 ; BRK_SP = SP at Break entry (user's original SP - 3 from BRK hardware push)
000314r 2                 ; We need SP = BRK_SP + 3 before our pushes, so RTI leaves SP at original
000314r 2  AE 16 03       ldx BRK_SP
000317r 2  E8             inx
000318r 2  E8             inx
000319r 2  E8             inx
00031Ar 2  9A             txs                           ; SP = user's original SP
00031Br 2                 ; Push PCH, PCL, P for RTI (RTI pops P first, then PCL, PCH)
00031Br 2  AD 12 03       lda BRK_PCH
00031Er 2  48             pha
00031Fr 2  AD 11 03       lda BRK_PCL
000322r 2  48             pha
000323r 2  AD 10 03       lda BRK_P
000326r 2  48             pha
000327r 2                 ; Restore registers
000327r 2  AC 15 03       ldy BRK_Y
00032Ar 2  AE 14 03       ldx BRK_X
00032Dr 2  AD 13 03       lda BRK_A
000330r 2  40             rti                           ; Pop P, PC → jump to target with full register state
000331r 2               
000331r 2               ; ============================================================================
000331r 2               ; MonCmdJsr — Call subroutine and return to monitor on RTS
000331r 2               ; Syntax: J [addr]
000331r 2               ; Pushes monitor return address, restores A/X/Y, JMPs to target.
000331r 2               ; When target does RTS, saves registers and re-enters monitor.
000331r 2               ; ============================================================================
000331r 2               
000331r 2               MonCmdJsr:
000331r 2  20 rr rr       jsr MonSkipSpaces
000334r 2  20 rr rr       jsr MonParseHex4
000337r 2  90 0A          bcc @JsrNoAddr
000339r 2                 ; Address given — store to BRK_PCL/PCH
000339r 2  A5 2E          lda MON_ADDR
00033Br 2  8D 11 03       sta BRK_PCL
00033Er 2  A5 2F          lda MON_ADDR+1
000340r 2  8D 12 03       sta BRK_PCH
000343r 2               @JsrNoAddr:
000343r 2                 ; Push return address (MonJsrReturn - 1) for RTS trick
000343r 2  A9 rr          lda #>(MonJsrReturn - 1)
000345r 2  48             pha
000346r 2  A9 rr          lda #<(MonJsrReturn - 1)
000348r 2  48             pha
000349r 2                 ; Restore registers as inputs to subroutine
000349r 2  AC 15 03       ldy BRK_Y
00034Cr 2  AE 14 03       ldx BRK_X
00034Fr 2  AD 13 03       lda BRK_A
000352r 2  6C 11 03       jmp (BRK_PCL)                 ; Jump to target — its RTS returns to MonJsrReturn
000355r 2               
000355r 2               ; MonJsrReturn — Landing point when user's subroutine does RTS
000355r 2               MonJsrReturn:
000355r 2  8D 13 03       sta BRK_A                     ; Save returned A
000358r 2  8E 14 03       stx BRK_X                    ; Save returned X
00035Br 2  8C 15 03       sty BRK_Y                    ; Save returned Y
00035Er 2  08             php                           ; Push current P
00035Fr 2  68             pla
000360r 2  8D 10 03       sta BRK_P                    ; Save processor status
000363r 2  BA             tsx
000364r 2  8E 16 03       stx BRK_SP                   ; Save current stack pointer
000367r 2                 ; Show registers and re-enter command loop
000367r 2  20 rr rr       jsr MonShowRegs
00036Ar 2  4C rr rr       jmp MonCmdLoop
00036Dr 2               
00036Dr 2               ; ============================================================================
00036Dr 2               ; MonCmdModRegs — Modify saved CPU registers
00036Dr 2               ; Syntax: ; PC xxxx A xx X xx Y xx SP xx P xx
00036Dr 2               ; Any subset, any order. Labels: PC, A, X, Y, SP, P
00036Dr 2               ; ============================================================================
00036Dr 2               
00036Dr 2               MonCmdModRegs:
00036Dr 2               @ModLoop:
00036Dr 2  20 rr rr       jsr MonSkipSpaces
000370r 2  A4 35          ldy MON_IDX
000372r 2  B9 00 04       lda MON_LINBUF,y
000375r 2  D0 03          bne @ModNotEnd
000377r 2  4C rr rr       jmp @ModDone                  ; End of line — trampoline (too far for beq)
00037Ar 2               @ModNotEnd:
00037Ar 2                 ; Convert to uppercase
00037Ar 2  C9 61          cmp #'a'
00037Cr 2  90 06          bcc @ModNoConv
00037Er 2  C9 7B          cmp #'z'+1
000380r 2  B0 02          bcs @ModNoConv
000382r 2  29 DF          and #$DF
000384r 2               @ModNoConv:
000384r 2  C9 50          cmp #'P'
000386r 2  F0 13          beq @ModCheckPCorP
000388r 2  C9 41          cmp #'A'
00038Ar 2  F0 4F          beq @ModA
00038Cr 2  C9 58          cmp #'X'
00038Er 2  F0 5E          beq @ModX
000390r 2  C9 59          cmp #'Y'
000392r 2  F0 6D          beq @ModY
000394r 2  C9 53          cmp #'S'
000396r 2  F0 7C          beq @ModCheckSP
000398r 2  4C rr rr       jmp @ModError                 ; Unknown label — trampoline (too far for bra)
00039Br 2               
00039Br 2               @ModCheckPCorP:
00039Br 2                 ; Could be "PC" (program counter) or "P" (processor status)
00039Br 2  E6 35          inc MON_IDX
00039Dr 2  A4 35          ldy MON_IDX
00039Fr 2  B9 00 04       lda MON_LINBUF,y
0003A2r 2                 ; Convert to uppercase
0003A2r 2  C9 61          cmp #'a'
0003A4r 2  90 06          bcc @ModPCNoConv
0003A6r 2  C9 7B          cmp #'z'+1
0003A8r 2  B0 02          bcs @ModPCNoConv
0003AAr 2  29 DF          and #$DF
0003ACr 2               @ModPCNoConv:
0003ACr 2  C9 43          cmp #'C'
0003AEr 2  F0 11          beq @ModPC
0003B0r 2                 ; It's just 'P' (processor status) — don't advance past the non-'C' char
0003B0r 2  20 rr rr       jsr MonSkipSpaces
0003B3r 2  20 rr rr       jsr MonParseHex2
0003B6r 2  B0 03          bcs @ModPOk
0003B8r 2  4C rr rr       jmp @ModError
0003BBr 2               @ModPOk:
0003BBr 2  8D 10 03       sta BRK_P
0003BEr 2  4C rr rr       jmp @ModLoop
0003C1r 2               
0003C1r 2               @ModPC:
0003C1r 2  E6 35          inc MON_IDX                   ; Advance past 'C'
0003C3r 2  20 rr rr       jsr MonSkipSpaces
0003C6r 2  20 rr rr       jsr MonParseHex4
0003C9r 2  B0 03          bcs @ModPCOk
0003CBr 2  4C rr rr       jmp @ModError
0003CEr 2               @ModPCOk:
0003CEr 2  A5 2E          lda MON_ADDR
0003D0r 2  8D 11 03       sta BRK_PCL
0003D3r 2  A5 2F          lda MON_ADDR+1
0003D5r 2  8D 12 03       sta BRK_PCH
0003D8r 2  4C rr rr       jmp @ModLoop
0003DBr 2               
0003DBr 2               @ModA:
0003DBr 2  E6 35          inc MON_IDX                   ; Advance past 'A'
0003DDr 2  20 rr rr       jsr MonSkipSpaces
0003E0r 2  20 rr rr       jsr MonParseHex2
0003E3r 2  B0 03          bcs @ModAOk
0003E5r 2  4C rr rr       jmp @ModError
0003E8r 2               @ModAOk:
0003E8r 2  8D 13 03       sta BRK_A
0003EBr 2  4C rr rr       jmp @ModLoop
0003EEr 2               
0003EEr 2               @ModX:
0003EEr 2  E6 35          inc MON_IDX                   ; Advance past 'X'
0003F0r 2  20 rr rr       jsr MonSkipSpaces
0003F3r 2  20 rr rr       jsr MonParseHex2
0003F6r 2  B0 03          bcs @ModXOk
0003F8r 2  4C rr rr       jmp @ModError
0003FBr 2               @ModXOk:
0003FBr 2  8D 14 03       sta BRK_X
0003FEr 2  4C rr rr       jmp @ModLoop
000401r 2               
000401r 2               @ModY:
000401r 2  E6 35          inc MON_IDX                   ; Advance past 'Y'
000403r 2  20 rr rr       jsr MonSkipSpaces
000406r 2  20 rr rr       jsr MonParseHex2
000409r 2  B0 03          bcs @ModYOk
00040Br 2  4C rr rr       jmp @ModError
00040Er 2               @ModYOk:
00040Er 2  8D 15 03       sta BRK_Y
000411r 2  4C rr rr       jmp @ModLoop
000414r 2               
000414r 2               @ModCheckSP:
000414r 2                 ; Expect "SP" — must see 'P' next
000414r 2  E6 35          inc MON_IDX
000416r 2  A4 35          ldy MON_IDX
000418r 2  B9 00 04       lda MON_LINBUF,y
00041Br 2  C9 50          cmp #'P'
00041Dr 2  F0 07          beq @ModSPGotP
00041Fr 2  C9 70          cmp #'p'
000421r 2  F0 03          beq @ModSPGotP
000423r 2  4C rr rr       jmp @ModError                 ; Just 'S' alone is invalid
000426r 2               @ModSPGotP:
000426r 2  E6 35          inc MON_IDX                   ; Advance past 'P'
000428r 2  20 rr rr       jsr MonSkipSpaces
00042Br 2  20 rr rr       jsr MonParseHex2
00042Er 2  B0 03          bcs @ModSPOk
000430r 2  4C rr rr       jmp @ModError
000433r 2               @ModSPOk:
000433r 2  8D 16 03       sta BRK_SP
000436r 2  4C rr rr       jmp @ModLoop
000439r 2               
000439r 2               @ModError:
000439r 2  4C rr rr       jmp MonPrintError
00043Cr 2               @ModDone:
00043Cr 2                 ; Display updated registers
00043Cr 2  20 rr rr       jsr MonShowRegs
00043Fr 2  60             rts
000440r 2               
000440r 2               ; ============================================================================
000440r 2               ; MonCmdDir — Display CF directory listing
000440r 2               ; Syntax: @
000440r 2               ; ============================================================================
000440r 2               
000440r 2               MonCmdDir:
000440r 2  20 rr rr       jsr FsDirectory
000443r 2  60             rts
000444r 2               
000444r 2               ; ============================================================================
000444r 2               ; MonCmdDisk — Select / report the current CF disk bank
000444r 2               ; Syntax: # NN   (hex disk 00-FF selects); # alone reports the current disk
000444r 2               ; ============================================================================
000444r 2               
000444r 2               MonCmdDisk:
000444r 2  20 rr rr       jsr MonSkipSpaces
000447r 2  20 rr rr       jsr MonParseHex2
00044Ar 2  90 03          bcc @MonDiskShow              ; No argument — just report current disk
00044Cr 2  20 rr rr       jsr FsSetDisk                 ; CF_DISK = A
00044Fr 2               @MonDiskShow:
00044Fr 2  20 rr rr       jsr FsPrintDisk               ; Print "DISK n"
000452r 2  60             rts
000453r 2               
000453r 2               ; ============================================================================
000453r 2               ; MonCmdNum — Number base conversion
000453r 2               ; Syntax: N $XXXX  or  N +DDDDD  or  N %BBBBBBBBBBBBBBBB
000453r 2               ; Output: $XXXX  +DDDDD  %BBBBBBBBBBBBBBBB
000453r 2               ; ============================================================================
000453r 2               
000453r 2               MonCmdNum:
000453r 2  20 rr rr       jsr MonSkipSpaces
000456r 2  A4 35          ldy MON_IDX
000458r 2  B9 00 04       lda MON_LINBUF,y
00045Br 2  C9 24          cmp #'$'
00045Dr 2  F0 0A          beq @NumHex
00045Fr 2  C9 2B          cmp #'+'
000461r 2  F0 10          beq @NumDec
000463r 2  C9 25          cmp #'%'
000465r 2  F0 16          beq @NumBin
000467r 2                 ; Default: try hex (no prefix)
000467r 2  80 02          bra @NumHexDirect
000469r 2               @NumHex:
000469r 2  E6 35          inc MON_IDX                   ; Skip '$'
00046Br 2               @NumHexDirect:
00046Br 2  20 rr rr       jsr MonParseHex4
00046Er 2  B0 17          bcs @NumPrint
000470r 2  4C rr rr       jmp MonPrintError
000473r 2               @NumDec:
000473r 2  E6 35          inc MON_IDX                   ; Skip '+'
000475r 2  20 rr rr       jsr MonParseDec16
000478r 2  B0 0D          bcs @NumPrint
00047Ar 2  4C rr rr       jmp MonPrintError
00047Dr 2               @NumBin:
00047Dr 2  E6 35          inc MON_IDX                   ; Skip '%'
00047Fr 2  20 rr rr       jsr MonParseBin16
000482r 2  B0 03          bcs @NumPrint
000484r 2  4C rr rr       jmp MonPrintError
000487r 2               @NumPrint:
000487r 2                 ; Value is in MON_ADDR
000487r 2  A9 24          lda #'$'
000489r 2  20 rr rr       jsr Chrout
00048Cr 2  20 rr rr       jsr MonPrintHex4
00048Fr 2  20 rr rr       jsr MonPrintSpace
000492r 2  20 rr rr       jsr MonPrintSpace
000495r 2  A9 2B          lda #'+'
000497r 2  20 rr rr       jsr Chrout
00049Ar 2  20 rr rr       jsr MonPrintDec16
00049Dr 2  20 rr rr       jsr MonPrintSpace
0004A0r 2  20 rr rr       jsr MonPrintSpace
0004A3r 2  A9 25          lda #'%'
0004A5r 2  20 rr rr       jsr Chrout
0004A8r 2  20 rr rr       jsr MonPrintBin16
0004ABr 2  20 rr rr       jsr MonPrintCRLF
0004AEr 2  60             rts
0004AFr 2               
0004AFr 2               ; ============================================================================
0004AFr 2               ; MonCmdLoad — Load from CF (with quoted filename) or XModem (without)
0004AFr 2               ; Syntax: L ["FILE"] [ADDR]
0004AFr 2               ; CF path:     L "FILENAME" [ADDR] — load file to addr (default $0800)
0004AFr 2               ; Serial path: L [ADDR]            — receive via XModem to addr (default $0800)
0004AFr 2               ; ============================================================================
0004AFr 2               
0004AFr 2               MonCmdLoad:
0004AFr 2  20 rr rr       jsr MonSkipSpaces
0004B2r 2  A4 35          ldy MON_IDX
0004B4r 2  B9 00 04       lda MON_LINBUF,y
0004B7r 2  C9 22          cmp #'"'
0004B9r 2  D0 03          bne @LoadSerial
0004BBr 2  4C rr rr       jmp @LoadCF
0004BEr 2               
0004BEr 2                 ; --- Serial path (XModem) ---
0004BEr 2               @LoadSerial:
0004BEr 2  20 rr rr       jsr MonParseHex4              ; Optional address
0004C1r 2  90 0A          bcc @LoadSerDefault
0004C3r 2                 ; Got address
0004C3r 2  A5 2E          lda MON_ADDR
0004C5r 2  85 2A          sta XFER_PTR
0004C7r 2  A5 2F          lda MON_ADDR+1
0004C9r 2  85 2B          sta XFER_PTR+1
0004CBr 2  80 08          bra @LoadSerStart
0004CDr 2               @LoadSerDefault:
0004CDr 2  A9 00          lda #<PROGRAM_START
0004CFr 2  85 2A          sta XFER_PTR
0004D1r 2  A9 08          lda #>PROGRAM_START
0004D3r 2  85 2B          sta XFER_PTR+1
0004D5r 2               @LoadSerStart:
0004D5r 2                 ; Save load address for success message
0004D5r 2  A5 2A          lda XFER_PTR
0004D7r 2  85 30          sta MON_END
0004D9r 2  A5 2B          lda XFER_PTR+1
0004DBr 2  85 31          sta MON_END+1
0004DDr 2                 ; Receive via XModem
0004DDr 2  20 rr rr       jsr XModemLoad
0004E0r 2  B0 0E          bcs @LoadSerErr
0004E2r 2                 ; XFER_REMAIN = total bytes received
0004E2r 2  AD 17 03       lda XFER_REMAIN
0004E5r 2  85 2E          sta MON_ADDR
0004E7r 2  AD 18 03       lda XFER_REMAIN+1
0004EAr 2  85 2F          sta MON_ADDR+1
0004ECr 2  20 rr rr       jsr MonPrintLoaded            ; Print "LOADED nnnn BYTES AT $xxxx"
0004EFr 2  60             rts
0004F0r 2               @LoadSerErr:
0004F0r 2  20 rr rr       jsr MonPrintIOErr
0004F3r 2  60             rts
0004F4r 2               
0004F4r 2                 ; --- CF path ---
0004F4r 2               @LoadCF:
0004F4r 2  E6 35          inc MON_IDX                   ; Skip opening quote
0004F6r 2                 ; Point STR_PTR into line buffer at the filename
0004F6r 2  A4 35          ldy MON_IDX
0004F8r 2  98             tya
0004F9r 2  18             clc
0004FAr 2  69 00          adc #<MON_LINBUF
0004FCr 2  85 02          sta STR_PTR
0004FEr 2  A9 04          lda #>MON_LINBUF
000500r 2  69 00          adc #0
000502r 2  85 03          sta STR_PTR+1
000504r 2                 ; Find closing quote and null-terminate
000504r 2               @LoadCFFindQ:
000504r 2  B9 00 04       lda MON_LINBUF,y
000507r 2  F0 0D          beq @LoadCFQDone              ; End of line — use as-is
000509r 2  C9 22          cmp #'"'
00050Br 2  F0 03          beq @LoadCFGotQ
00050Dr 2  C8             iny
00050Er 2  80 F4          bra @LoadCFFindQ
000510r 2               @LoadCFGotQ:
000510r 2  A9 00          lda #0
000512r 2  99 00 04       sta MON_LINBUF,y              ; Null-terminate at closing quote
000515r 2  C8             iny                           ; Advance past closing quote
000516r 2               @LoadCFQDone:
000516r 2  84 35          sty MON_IDX
000518r 2                 ; Parse filename into FS_FNAME_BUF
000518r 2  20 rr rr       jsr FsParseName
00051Br 2                 ; Read directory
00051Br 2  20 rr rr       jsr FsReadDir
00051Er 2  90 03          bcc @LoadCFReadOk
000520r 2  4C rr rr       jmp @LoadCFErr
000523r 2               @LoadCFReadOk:
000523r 2                 ; Find file
000523r 2  20 rr rr       jsr FsFindFile
000526r 2  90 03          bcc @LoadCFFound
000528r 2  4C rr rr       jmp @LoadCFNotFound
00052Br 2               @LoadCFFound:
00052Br 2                 ; Read file metadata
00052Br 2  A0 0C          ldy #FS_ENTRY_START
00052Dr 2  B1 24          lda (CF_BUF_PTR),y
00052Fr 2  8D 48 03       sta FS_START_SEC
000532r 2  C8             iny
000533r 2  B1 24          lda (CF_BUF_PTR),y
000535r 2  8D 49 03       sta FS_START_SEC+1
000538r 2  A0 0E          ldy #FS_ENTRY_FSIZE
00053Ar 2  B1 24          lda (CF_BUF_PTR),y
00053Cr 2  8D 4A 03       sta FS_FILE_SIZE
00053Fr 2  C8             iny
000540r 2  B1 24          lda (CF_BUF_PTR),y
000542r 2  8D 4B 03       sta FS_FILE_SIZE+1
000545r 2                 ; Calculate sector count = ceil(size / 512)
000545r 2  AD 4B 03       lda FS_FILE_SIZE+1
000548r 2  4A             lsr a
000549r 2  8D 4C 03       sta FS_SEC_COUNT
00054Cr 2  AD 4B 03       lda FS_FILE_SIZE+1
00054Fr 2  29 01          and #$01
000551r 2  D0 05          bne @LoadCFRound
000553r 2  AD 4A 03       lda FS_FILE_SIZE
000556r 2  F0 03          beq @LoadCFNoRound
000558r 2               @LoadCFRound:
000558r 2  EE 4C 03       inc FS_SEC_COUNT
00055Br 2               @LoadCFNoRound:
00055Br 2                 ; Parse optional load address
00055Br 2  20 rr rr       jsr MonSkipSpaces
00055Er 2  20 rr rr       jsr MonParseHex4
000561r 2  90 0A          bcc @LoadCFDefAddr
000563r 2                 ; Got address — use it
000563r 2  A5 2E          lda MON_ADDR
000565r 2  85 24          sta CF_BUF_PTR
000567r 2  A5 2F          lda MON_ADDR+1
000569r 2  85 25          sta CF_BUF_PTR+1
00056Br 2  80 08          bra @LoadCFSetLBA
00056Dr 2               @LoadCFDefAddr:
00056Dr 2  A9 00          lda #<PROGRAM_START
00056Fr 2  85 24          sta CF_BUF_PTR
000571r 2  A9 08          lda #>PROGRAM_START
000573r 2  85 25          sta CF_BUF_PTR+1
000575r 2               @LoadCFSetLBA:
000575r 2                 ; Save load base address for message
000575r 2  A5 24          lda CF_BUF_PTR
000577r 2  85 30          sta MON_END
000579r 2  A5 25          lda CF_BUF_PTR+1
00057Br 2  85 31          sta MON_END+1
00057Dr 2                 ; Set up LBA
00057Dr 2  AD 48 03       lda FS_START_SEC
000580r 2  85 26          sta CF_LBA
000582r 2  AD 49 03       lda FS_START_SEC+1
000585r 2  85 27          sta CF_LBA+1
000587r 2  64 28          stz CF_LBA+2
000589r 2  64 29          stz CF_LBA+3
00058Br 2                 ; Read sectors
00058Br 2  AE 4C 03       ldx FS_SEC_COUNT
00058Er 2  F0 10          beq @LoadCFOk
000590r 2               @LoadCFSec:
000590r 2  DA             phx
000591r 2  20 rr rr       jsr StReadSector              ; Reads 512 bytes, advances CF_BUF_PTR
000594r 2  B0 18          bcs @LoadCFSecErr
000596r 2  E6 26          inc CF_LBA
000598r 2  D0 02          bne @LoadCFSecNext
00059Ar 2  E6 27          inc CF_LBA+1
00059Cr 2               @LoadCFSecNext:
00059Cr 2  FA             plx
00059Dr 2  CA             dex
00059Er 2  D0 F0          bne @LoadCFSec
0005A0r 2               @LoadCFOk:
0005A0r 2                 ; Print success
0005A0r 2  AD 4A 03       lda FS_FILE_SIZE
0005A3r 2  85 2E          sta MON_ADDR
0005A5r 2  AD 4B 03       lda FS_FILE_SIZE+1
0005A8r 2  85 2F          sta MON_ADDR+1
0005AAr 2  20 rr rr       jsr MonPrintLoaded            ; Print "LOADED nnnn BYTES AT $xxxx"
0005ADr 2  60             rts
0005AEr 2               @LoadCFSecErr:
0005AEr 2  FA             plx                           ; Balance stack
0005AFr 2               @LoadCFErr:
0005AFr 2  20 rr rr       jsr MonPrintIOErr
0005B2r 2  60             rts
0005B3r 2               @LoadCFNotFound:
0005B3r 2  A2 00          ldx #0
0005B5r 2               @LoadCFNFLoop:
0005B5r 2  BD rr rr       lda MonStrNotFound,x
0005B8r 2  F0 06          beq @LoadCFNFDone
0005BAr 2  20 rr rr       jsr Chrout
0005BDr 2  E8             inx
0005BEr 2  80 F5          bra @LoadCFNFLoop
0005C0r 2               @LoadCFNFDone:
0005C0r 2  20 rr rr       jsr MonPrintCRLF
0005C3r 2  60             rts
