002293r 2  85 08                sta     BAS_LINNUM
002295r 2  AD 6A 03             lda     BAS_CURLIN+1
002298r 2  85 09                sta     BAS_LINNUM+1
00229Ar 2  20 rr rr             jsr     BasPrintLineNum
00229Dr 2               @endNoLine:
