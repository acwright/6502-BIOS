0009F1r 2  4C rr rr       jmp Chrout
0009F4r 2               
0009F4r 2               DisOpRel:
0009F4r 2                 ; Target = current_addr + 2 + signed_offset
0009F4r 2  A0 01          ldy #1
0009F6r 2  B1 2E          lda (MON_ADDR),y              ; offset byte
0009F8r 2  30 0D          bmi @Neg
0009FAr 2                 ; Positive offset
0009FAr 2  18             clc
0009FBr 2  65 2E          adc MON_ADDR
0009FDr 2  85 32          sta MON_TMP
0009FFr 2  A5 2F          lda MON_ADDR+1
000A01r 2  69 00          adc #0
000A03r 2  85 33          sta MON_TMP+1
000A05r 2  80 0B          bra @Add2
000A07r 2               @Neg:
000A07r 2  18             clc
000A08r 2  65 2E          adc MON_ADDR
000A0Ar 2  85 32          sta MON_TMP
000A0Cr 2  A5 2F          lda MON_ADDR+1
000A0Er 2  69 FF          adc #$FF                      ; sign extension
000A10r 2  85 33          sta MON_TMP+1
000A12r 2               @Add2:
000A12r 2  18             clc
000A13r 2  A5 32          lda MON_TMP
000A15r 2  69 02          adc #2
000A17r 2  85 32          sta MON_TMP
000A19r 2  A5 33          lda MON_TMP+1
000A1Br 2  69 00          adc #0
000A1Dr 2  85 33          sta MON_TMP+1
000A1Fr 2                 ; Print "$XXXX"
000A1Fr 2  A9 24          lda #'$'
000A21r 2  20 rr rr       jsr Chrout
000A24r 2  A5 33          lda MON_TMP+1
000A26r 2  20 rr rr       jsr MonPrintHex2
000A29r 2  A5 32          lda MON_TMP
000A2Br 2  4C rr rr       jmp MonPrintHex2
000A2Er 2               
000A2Er 2               DisOpZpr:
000A2Er 2                 ; ZP byte first
000A2Er 2  A9 24          lda #'$'
000A30r 2  20 rr rr       jsr Chrout
000A33r 2  A0 01          ldy #1
000A35r 2  B1 2E          lda (MON_ADDR),y
000A37r 2  20 rr rr       jsr MonPrintHex2
000A3Ar 2  A9 2C          lda #','
000A3Cr 2  20 rr rr       jsr Chrout
000A3Fr 2                 ; Branch target = addr + 3 + signed_offset(byte 2)
000A3Fr 2  A0 02          ldy #2
000A41r 2  B1 2E          lda (MON_ADDR),y
000A43r 2  30 0D          bmi @Neg
000A45r 2  18             clc
000A46r 2  65 2E          adc MON_ADDR
000A48r 2  85 32          sta MON_TMP
000A4Ar 2  A5 2F          lda MON_ADDR+1
000A4Cr 2  69 00          adc #0
000A4Er 2  85 33          sta MON_TMP+1
000A50r 2  80 0B          bra @Add3
000A52r 2               @Neg:
000A52r 2  18             clc
000A53r 2  65 2E          adc MON_ADDR
000A55r 2  85 32          sta MON_TMP
000A57r 2  A5 2F          lda MON_ADDR+1
000A59r 2  69 FF          adc #$FF
000A5Br 2  85 33          sta MON_TMP+1
000A5Dr 2               @Add3:
000A5Dr 2  18             clc
000A5Er 2  A5 32          lda MON_TMP
000A60r 2  69 03          adc #3
000A62r 2  85 32          sta MON_TMP
000A64r 2  A5 33          lda MON_TMP+1
000A66r 2  69 00          adc #0
000A68r 2  85 33          sta MON_TMP+1
000A6Ar 2  A9 24          lda #'$'
000A6Cr 2  20 rr rr       jsr Chrout
000A6Fr 2  A5 33          lda MON_TMP+1
000A71r 2  20 rr rr       jsr MonPrintHex2
000A74r 2  A5 32          lda MON_TMP
000A76r 2  4C rr rr       jmp MonPrintHex2
000A79r 2               
