0029B9r 2               
0029B9r 2               ; BRK
0029B9r 2               BasCmdBrk:
0029B9r 2  00                   brk
0029BAr 2  00                   .byte   0
0029BBr 2  60                   rts
0029BCr 2               
0029BCr 2               ; POKE addr, val
0029BCr 2               ; The value expression is evaluated BEFORE the address is parked in INDEX:
0029BCr 2               ; FrmEvl clobbers every zero-page scratch pair (INDEX via LoadFacFromYa,
0029BCr 2               ; BAS_TMP1 via FacToU16 / the string functions), so the address has to ride
0029BCr 2               ; the hardware stack across the evaluation.
0029BCr 2               BasCmdPoke:
0029BCr 2  20 rr rr             jsr     EvalAddrU16
0029BFr 2  A5 11                lda     FAC+3                   ; hi
0029C1r 2  48                   pha
0029C2r 2  A5 12                lda     FAC+4                   ; lo
0029C4r 2  48                   pha
0029C5r 2  20 rr rr             jsr     ChkCom
0029C8r 2  20 rr rr             jsr     GetByt                  ; X = val
0029CBr 2  68                   pla
0029CCr 2  85 20                sta     INDEX
0029CEr 2  68                   pla
0029CFr 2  85 21                sta     INDEX+1
0029D1r 2  8A                   txa
0029D2r 2  A0 00                ldy     #0
0029D4r 2  91 20                sta     (INDEX),y
0029D6r 2  60                   rts
0029D7r 2               
0029D7r 2               ; LOAD ["name"] / LOAD (bare) / LOAD "name"
0029D7r 2               BasCmdLoad:
0029D7r 2  20 rr rr             jsr     ChrGot
0029DAr 2  F0 02                beq     @bare
0029DCr 2  80 19                bra     @cf                     ; any argument is a filename expression
0029DEr 2               @bare:
0029DEr 2  A9 10                lda     #HW_SC
0029E0r 2  20 rr rr             jsr     ReqHw
0029E3r 2  A9 00                lda     #<PROGRAM_START
0029E5r 2  85 2A                sta     XFER_PTR
0029E7r 2  A9 08                lda     #>PROGRAM_START
0029E9r 2  85 2B                sta     XFER_PTR+1
0029EBr 2  20 rr rr             jsr     XModemLoad
0029EEr 2                       ; XMODEM rounds up to a 128-byte block, so this can overshoot the true
0029EEr 2                       ; end by up to 127 bytes: it wastes a little variable space, never
0029EEr 2                       ; truncates.
0029EEr 2  AD 17 03             lda     XFER_REMAIN
0029F1r 2  AC 18 03             ldy     XFER_REMAIN+1
0029F4r 2  4C rr rr             jmp     BasFixChain
0029F7r 2               @cf:
0029F7r 2  A9 08                lda     #HW_CF
0029F9r 2  20 rr rr             jsr     ReqHw
0029FCr 2  20 rr rr             jsr     EvalString
0029FFr 2  20 rr rr             jsr     FsLoadFile
002A02r 2  B0 09                bcs     @err
002A04r 2  AD 4A 03             lda     FS_FILE_SIZE
002A07r 2  AC 4B 03             ldy     FS_FILE_SIZE+1
002A0Ar 2  4C rr rr             jmp     BasFixChain
002A0Dr 2               @err:
002A0Dr 2  A9 rr                lda     #<MsgLoadErr
002A0Fr 2  A0 rr                ldy     #>MsgLoadErr
002A11r 2  4C rr rr             jmp     BasPrintStr
002A14r 2               
002A14r 2               ; SAVE / SAVE "name"
002A14r 2               BasCmdSave:
002A14r 2  20 rr rr             jsr     ChrGot
002A17r 2  F0 02                beq     @bare
