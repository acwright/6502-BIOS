000B51r 2               ; ============================================================================
000B51r 2               ; Hex Parsing Utilities
000B51r 2               ; ============================================================================
000B51r 2               
000B51r 2               ; MonParseHex4 — Parse up to 4 hex digits from MON_LINBUF into MON_ADDR
000B51r 2               ; Input:  MON_IDX points to current position in MON_LINBUF
000B51r 2               ; Output: MON_ADDR/MON_ADDR+1 = parsed 16-bit value, carry set if valid
000B51r 2               ;         MON_IDX advanced past parsed digits
000B51r 2               
000B51r 2               MonParseHex4:
000B51r 2  64 2E          stz MON_ADDR
000B53r 2  64 2F          stz MON_ADDR + 1
000B55r 2  A2 00          ldx #0                        ; Digit count
000B57r 2               @ParseLoop:
000B57r 2  A4 35          ldy MON_IDX
000B59r 2  B9 00 04       lda MON_LINBUF,y
000B5Cr 2  20 rr rr       jsr MonCharToNibble           ; Convert ASCII to 0-15, carry clear if valid
000B5Fr 2  B0 1B          bcs @ParseDone                ; Not a hex digit — stop
000B61r 2                 ; Shift result left 4 bits and OR in new nibble
000B61r 2  06 2E          asl MON_ADDR
000B63r 2  26 2F          rol MON_ADDR + 1
000B65r 2  06 2E          asl MON_ADDR
000B67r 2  26 2F          rol MON_ADDR + 1
000B69r 2  06 2E          asl MON_ADDR
000B6Br 2  26 2F          rol MON_ADDR + 1
000B6Dr 2  06 2E          asl MON_ADDR
000B6Fr 2  26 2F          rol MON_ADDR + 1
000B71r 2  05 2E          ora MON_ADDR
000B73r 2  85 2E          sta MON_ADDR
000B75r 2  E6 35          inc MON_IDX
000B77r 2  E8             inx
000B78r 2  E0 04          cpx #4                        ; Max 4 digits
000B7Ar 2  90 DB          bcc @ParseLoop
000B7Cr 2               @ParseDone:
000B7Cr 2  E0 00          cpx #0                        ; Did we parse at least one digit?
000B7Er 2  F0 02          beq @ParseFail
000B80r 2  38             sec                           ; Success
000B81r 2  60             rts
000B82r 2               @ParseFail:
000B82r 2  18             clc                           ; Failure — no digits parsed
000B83r 2  60             rts
000B84r 2               
000B84r 2               ; MonParseHex2 — Parse up to 2 hex digits from MON_LINBUF into A
000B84r 2               ; Input:  MON_IDX points to current position in MON_LINBUF
000B84r 2               ; Output: A = parsed 8-bit value, carry set if valid
000B84r 2               ;         MON_IDX advanced past parsed digits
000B84r 2               
000B84r 2               MonParseHex2:
000B84r 2  64 34          stz MON_BYTE
000B86r 2  A2 00          ldx #0                        ; Digit count
000B88r 2               @ParseLoop:
000B88r 2  A4 35          ldy MON_IDX
000B8Ar 2  B9 00 04       lda MON_LINBUF,y
000B8Dr 2  20 rr rr       jsr MonCharToNibble
000B90r 2  B0 13          bcs @ParseDone
000B92r 2  06 34          asl MON_BYTE
000B94r 2  06 34          asl MON_BYTE
000B96r 2  06 34          asl MON_BYTE
000B98r 2  06 34          asl MON_BYTE
000B9Ar 2  05 34          ora MON_BYTE
000B9Cr 2  85 34          sta MON_BYTE
000B9Er 2  E6 35          inc MON_IDX
000BA0r 2  E8             inx
000BA1r 2  E0 02          cpx #2
000BA3r 2  90 E3          bcc @ParseLoop
000BA5r 2               @ParseDone:
000BA5r 2  E0 00          cpx #0
000BA7r 2  F0 04          beq @ParseFail
000BA9r 2  A5 34          lda MON_BYTE
000BABr 2  38             sec
000BACr 2  60             rts
000BADr 2               @ParseFail:
000BADr 2  18             clc
000BAEr 2  60             rts
000BAFr 2               
000BAFr 2               ; MonCharToNibble — Convert ASCII hex char in A to nibble value 0-15
000BAFr 2               ; Input:  A = ASCII character
000BAFr 2               ; Output: A = 0-15 if valid hex digit, carry clear
000BAFr 2               ;         carry set if not a valid hex digit (A preserved)
000BAFr 2               
000BAFr 2               MonCharToNibble:
000BAFr 2  C9 30          cmp #'0'
000BB1r 2  90 23          bcc @NotHex
000BB3r 2  C9 3A          cmp #'9'+1
000BB5r 2  90 15          bcc @IsDigit
000BB7r 2  C9 41          cmp #'A'
000BB9r 2  90 04          bcc @CheckLower
000BBBr 2  C9 47          cmp #'F'+1
000BBDr 2  90 12          bcc @IsUpper
000BBFr 2               @CheckLower:
000BBFr 2  C9 61          cmp #'a'
000BC1r 2  90 13          bcc @NotHex
000BC3r 2  C9 67          cmp #'f'+1
000BC5r 2  B0 0F          bcs @NotHex
000BC7r 2                 ; Lowercase a-f
000BC7r 2  38             sec
000BC8r 2  E9 57          sbc #('a' - 10)
000BCAr 2  18             clc
000BCBr 2  60             rts
000BCCr 2               @IsDigit:
000BCCr 2  38             sec
000BCDr 2  E9 30          sbc #'0'
000BCFr 2  18             clc
000BD0r 2  60             rts
000BD1r 2               @IsUpper:
000BD1r 2  38             sec
000BD2r 2  E9 37          sbc #('A' - 10)
000BD4r 2  18             clc
000BD5r 2  60             rts
000BD6r 2               @NotHex:
000BD6r 2  38             sec
000BD7r 2  60             rts
000BD8r 2               
000BD8r 2               ; MonSkipSpaces — Advance MON_IDX past whitespace in MON_LINBUF
000BD8r 2               
000BD8r 2               MonSkipSpaces:
000BD8r 2  A4 35          ldy MON_IDX
000BDAr 2  B9 00 04       lda MON_LINBUF,y
000BDDr 2  C9 20          cmp #' '
000BDFr 2  D0 04          bne @Done
000BE1r 2  E6 35          inc MON_IDX
000BE3r 2  80 F3          bra MonSkipSpaces
000BE5r 2               @Done:
000BE5r 2  60             rts
000BE6r 2               
000BE6r 2               ; ============================================================================
000BE6r 2               ; Decimal & Binary Parsing Utilities
000BE6r 2               ; ============================================================================
000BE6r 2               
000BE6r 2               ; MonParseDec16 — Parse decimal digits from MON_LINBUF into MON_ADDR
000BE6r 2               ; Input:  MON_IDX points to current position in MON_LINBUF
000BE6r 2               ; Output: MON_ADDR = parsed 16-bit value, carry set if valid
000BE6r 2               ;         MON_IDX advanced past parsed digits
000BE6r 2               ; Modifies: A, X, Y, MON_ADDR, MON_TMP
000BE6r 2               
000BE6r 2               MonParseDec16:
000BE6r 2  64 2E          stz MON_ADDR
000BE8r 2  64 2F          stz MON_ADDR+1
000BEAr 2  A2 00          ldx #0                        ; Digit count
000BECr 2               @DecLoop:
000BECr 2  A4 35          ldy MON_IDX
000BEEr 2  B9 00 04       lda MON_LINBUF,y
000BF1r 2  C9 30          cmp #'0'
000BF3r 2  90 3A          bcc @DecDone
000BF5r 2  C9 3A          cmp #'9'+1
000BF7r 2  B0 36          bcs @DecDone
000BF9r 2  38             sec
000BFAr 2  E9 30          sbc #'0'                      ; A = digit 0-9
000BFCr 2  48             pha                           ; Save digit
000BFDr 2                 ; MON_ADDR = MON_ADDR * 10 + digit
000BFDr 2                 ; *10 = (*2 + *8): save *2, then *8, add
000BFDr 2  06 2E          asl MON_ADDR
000BFFr 2  26 2F          rol MON_ADDR+1
000C01r 2  A5 2E          lda MON_ADDR
000C03r 2  85 32          sta MON_TMP
000C05r 2  A5 2F          lda MON_ADDR+1
000C07r 2  85 33          sta MON_TMP+1                 ; MON_TMP = *2
000C09r 2  06 2E          asl MON_ADDR
000C0Br 2  26 2F          rol MON_ADDR+1                ; *4
000C0Dr 2  06 2E          asl MON_ADDR
000C0Fr 2  26 2F          rol MON_ADDR+1                ; *8
000C11r 2  18             clc
000C12r 2  A5 2E          lda MON_ADDR
000C14r 2  65 32          adc MON_TMP
000C16r 2  85 2E          sta MON_ADDR
000C18r 2  A5 2F          lda MON_ADDR+1
000C1Ar 2  65 33          adc MON_TMP+1
000C1Cr 2  85 2F          sta MON_ADDR+1                ; *10
000C1Er 2                 ; + digit
000C1Er 2  68             pla
000C1Fr 2  18             clc
000C20r 2  65 2E          adc MON_ADDR
000C22r 2  85 2E          sta MON_ADDR
000C24r 2  90 02          bcc @DecNoCarry
000C26r 2  E6 2F          inc MON_ADDR+1
000C28r 2               @DecNoCarry:
000C28r 2  E6 35          inc MON_IDX
000C2Ar 2  E8             inx
000C2Br 2  E0 05          cpx #5                        ; Max 5 digits (65535)
000C2Dr 2  90 BD          bcc @DecLoop
000C2Fr 2               @DecDone:
000C2Fr 2  E0 00          cpx #0
000C31r 2  F0 02          beq @DecFail
000C33r 2  38             sec                           ; Success
000C34r 2  60             rts
000C35r 2               @DecFail:
000C35r 2  18             clc                           ; Failure
000C36r 2  60             rts
000C37r 2               
000C37r 2               ; MonParseBin16 — Parse binary digits from MON_LINBUF into MON_ADDR
000C37r 2               ; Input:  MON_IDX points to current position in MON_LINBUF
000C37r 2               ; Output: MON_ADDR = parsed 16-bit value, carry set if valid
000C37r 2               ;         MON_IDX advanced past parsed digits
000C37r 2               ; Modifies: A, X, Y, MON_ADDR
000C37r 2               
000C37r 2               MonParseBin16:
000C37r 2  64 2E          stz MON_ADDR
000C39r 2  64 2F          stz MON_ADDR+1
000C3Br 2  A2 00          ldx #0                        ; Digit count
000C3Dr 2               @BinLoop:
000C3Dr 2  A4 35          ldy MON_IDX
000C3Fr 2  B9 00 04       lda MON_LINBUF,y
000C42r 2  C9 30          cmp #'0'
000C44r 2  F0 06          beq @BinGot
000C46r 2  C9 31          cmp #'1'
000C48r 2  F0 02          beq @BinGot
000C4Ar 2  80 0F          bra @BinDone
000C4Cr 2               @BinGot:
000C4Cr 2  38             sec
000C4Dr 2  E9 30          sbc #'0'                      ; A = 0 or 1
000C4Fr 2  4A             lsr a                         ; Bit into carry
000C50r 2  26 2E          rol MON_ADDR
000C52r 2  26 2F          rol MON_ADDR+1
000C54r 2  E6 35          inc MON_IDX
000C56r 2  E8             inx
000C57r 2  E0 10          cpx #16                       ; Max 16 bits
000C59r 2  90 E2          bcc @BinLoop
000C5Br 2               @BinDone:
000C5Br 2  E0 00          cpx #0
000C5Dr 2  F0 02          beq @BinFail
000C5Fr 2  38             sec                           ; Success
000C60r 2  60             rts
000C61r 2               @BinFail:
000C61r 2  18             clc                           ; Failure
000C62r 2  60             rts
000C63r 2               
000C63r 2               ; ============================================================================
000C63r 2               ; Decimal & Binary Output Utilities
000C63r 2               ; ============================================================================
000C63r 2               
000C63r 2               ; MonPrintDec16 — Print MON_ADDR as up to 5 decimal digits
000C63r 2               ; Uses successive subtraction of powers of 10
000C63r 2               ; Modifies: A, X, Y, MON_TMP, MON_BYTE
000C63r 2               
000C63r 2               MonPrintDec16:
000C63r 2                 ; Copy value to MON_TMP so we don't destroy MON_ADDR
000C63r 2  A5 2E          lda MON_ADDR
000C65r 2  85 32          sta MON_TMP
000C67r 2  A5 2F          lda MON_ADDR+1
000C69r 2  85 33          sta MON_TMP+1
000C6Br 2  A2 00          ldx #0                        ; Leading zero suppression flag
000C6Dr 2  A0 00          ldy #0                        ; Power-of-10 index
000C6Fr 2               @Dec16Loop:
000C6Fr 2  A9 2F          lda #'0'-1
000C71r 2  85 34          sta MON_BYTE                  ; Digit scratch
000C73r 2               @Dec16Sub:
000C73r 2  E6 34          inc MON_BYTE
000C75r 2  A5 32          lda MON_TMP
000C77r 2  38             sec
000C78r 2  F9 rr rr       sbc @Dec16Pow10Lo,y
000C7Br 2  48             pha
000C7Cr 2  A5 33          lda MON_TMP+1
000C7Er 2  F9 rr rr       sbc @Dec16Pow10Hi,y
000C81r 2  90 07          bcc @Dec16Digit               ; Underflow — digit done
000C83r 2  85 33          sta MON_TMP+1
000C85r 2  68             pla
000C86r 2  85 32          sta MON_TMP
000C88r 2  80 E9          bra @Dec16Sub
000C8Ar 2               @Dec16Digit:
000C8Ar 2  68             pla                           ; Discard underflowed low byte
000C8Br 2  A5 34          lda MON_BYTE
000C8Dr 2  C9 30          cmp #'0'
000C8Fr 2  D0 04          bne @Dec16Print               ; Non-zero → print
000C91r 2  E0 00          cpx #0
000C93r 2  F0 08          beq @Dec16Skip                ; Leading zero → skip
000C95r 2               @Dec16Print:
000C95r 2  DA             phx
000C96r 2  5A             phy
000C97r 2  20 rr rr       jsr Chrout
000C9Ar 2  7A             ply
000C9Br 2  FA             plx
000C9Cr 2  E8             inx                           ; Mark we've printed a digit
000C9Dr 2               @Dec16Skip:
000C9Dr 2  C8             iny
000C9Er 2  C0 04          cpy #4                        ; 4 powers: 10000, 1000, 100, 10
000CA0r 2  D0 CD          bne @Dec16Loop
000CA2r 2                 ; Always print ones digit
000CA2r 2  A5 32          lda MON_TMP
000CA4r 2  09 30          ora #'0'
000CA6r 2  20 rr rr       jsr Chrout
000CA9r 2  60             rts
000CAAr 2  10 E8 64 0A  @Dec16Pow10Lo: .byte <10000, <1000, <100, <10
000CAEr 2  27 03 00 00  @Dec16Pow10Hi: .byte >10000, >1000, >100, >10
000CB2r 2               
000CB2r 2               ; MonPrintBin16 — Print MON_ADDR as 16 binary digits (MSB first)
000CB2r 2               ; Modifies: A, X
000CB2r 2               
000CB2r 2               MonPrintBin16:
000CB2r 2  A5 2F          lda MON_ADDR+1                ; High byte first
000CB4r 2  20 rr rr       jsr @PrintBin8
000CB7r 2  A5 2E          lda MON_ADDR                  ; Then low byte
000CB9r 2               @PrintBin8:
000CB9r 2  A2 08          ldx #8
000CBBr 2               @BinBitLoop:
000CBBr 2  0A             asl a                         ; Shift MSB into carry
000CBCr 2  48             pha
000CBDr 2  A9 30          lda #'0'
000CBFr 2  69 00          adc #0                        ; +1 if carry → '1'
000CC1r 2  20 rr rr       jsr Chrout
000CC4r 2  68             pla
000CC5r 2  CA             dex
000CC6r 2  D0 F3          bne @BinBitLoop
000CC8r 2  60             rts
000CC9r 2               
000CC9r 2               ; ============================================================================
000CC9r 2               ; Message Print Helpers (Phase 5)
000CC9r 2               ; ============================================================================
000CC9r 2               
000CC9r 2               ; MonPrintLoaded — Print "LOADED nnnn BYTES AT $xxxx"
000CC9r 2               ; Input: MON_ADDR = byte count, MON_END = load address
000CC9r 2               ; Modifies: A, X, Y, MON_TMP, MON_BYTE
000CC9r 2               
000CC9r 2               MonPrintLoaded:
000CC9r 2  A2 00          ldx #0
000CCBr 2               @PLoop1:
000CCBr 2  BD rr rr       lda MonStrLoadPfx,x
000CCEr 2  F0 06          beq @PDone1
000CD0r 2  20 rr rr       jsr Chrout
000CD3r 2  E8             inx
000CD4r 2  80 F5          bra @PLoop1
000CD6r 2               @PDone1:
000CD6r 2  20 rr rr       jsr MonPrintDec16             ; Print byte count from MON_ADDR
000CD9r 2  A2 00          ldx #0
000CDBr 2               @PLoop2:
000CDBr 2  BD rr rr       lda MonStrBytesAt,x
000CDEr 2  F0 06          beq @PDone2
000CE0r 2  20 rr rr       jsr Chrout
000CE3r 2  E8             inx
000CE4r 2  80 F5          bra @PLoop2
000CE6r 2               @PDone2:
000CE6r 2                 ; Print address from MON_END
000CE6r 2  A5 30          lda MON_END
000CE8r 2  85 2E          sta MON_ADDR
000CEAr 2  A5 31          lda MON_END+1
000CECr 2  85 2F          sta MON_ADDR+1
000CEEr 2  20 rr rr       jsr MonPrintHex4
000CF1r 2  4C rr rr       jmp MonPrintCRLF
000CF4r 2               
000CF4r 2               ; MonPrintSaved — Print "SAVED nnnn BYTES"
000CF4r 2               ; Input: MON_ADDR = byte count
000CF4r 2               ; Modifies: A, X, Y, MON_TMP, MON_BYTE
000CF4r 2               
000CF4r 2               MonPrintSaved:
000CF4r 2  A2 00          ldx #0
000CF6r 2               @SLoop1:
000CF6r 2  BD rr rr       lda MonStrSavePfx,x
000CF9r 2  F0 06          beq @SDone1
000CFBr 2  20 rr rr       jsr Chrout
000CFEr 2  E8             inx
000CFFr 2  80 F5          bra @SLoop1
000D01r 2               @SDone1:
000D01r 2  20 rr rr       jsr MonPrintDec16             ; Print byte count from MON_ADDR
000D04r 2  A2 00          ldx #0
000D06r 2               @SLoop2:
000D06r 2  BD rr rr       lda MonStrBytes,x
000D09r 2  F0 06          beq @SDone2
000D0Br 2  20 rr rr       jsr Chrout
000D0Er 2  E8             inx
000D0Fr 2  80 F5          bra @SLoop2
000D11r 2               @SDone2:
000D11r 2  4C rr rr       jmp MonPrintCRLF
000D14r 2               
000D14r 2               ; MonPrintIOErr — Print "I/O ERROR"
000D14r 2               ; Modifies: A, X
000D14r 2               
000D14r 2               MonPrintIOErr:
000D14r 2  A2 00          ldx #0
000D16r 2               @ELoop:
000D16r 2  BD rr rr       lda MonStrIOErr,x
000D19r 2  F0 06          beq @EDone
000D1Br 2  20 rr rr       jsr Chrout
000D1Er 2  E8             inx
000D1Fr 2  80 F5          bra @ELoop
000D21r 2               @EDone:
000D21r 2  4C rr rr       jmp MonPrintCRLF
000D24r 2               
000D24r 2               ; ============================================================================
000D24r 2               ; Hex Output Utilities
000D24r 2               ; ============================================================================
000D24r 2               
000D24r 2               ; MonPrintHex2 — Print A as two hex digits
000D24r 2               ; Input:  A = byte to print
000D24r 2               ; Modifies: A, flags
000D24r 2               
000D24r 2               MonPrintHex2:
000D24r 2  48             pha                           ; Save original byte
000D25r 2  4A             lsr                           ; Shift high nibble down
000D26r 2  4A             lsr
000D27r 2  4A             lsr
000D28r 2  4A             lsr
000D29r 2  20 rr rr       jsr @PrintNibble              ; Print high nibble
000D2Cr 2  68             pla                           ; Restore original byte
000D2Dr 2  29 0F          and #$0F                      ; Isolate low nibble
000D2Fr 2               @PrintNibble:
000D2Fr 2  C9 0A          cmp #10
000D31r 2  90 06          bcc @IsDigit
000D33r 2  18             clc
000D34r 2  69 37          adc #('A' - 10)
000D36r 2  4C rr rr       jmp Chrout
000D39r 2               @IsDigit:
000D39r 2  18             clc
000D3Ar 2  69 30          adc #'0'
000D3Cr 2  4C rr rr       jmp Chrout
000D3Fr 2               
000D3Fr 2               ; MonPrintHex4 — Print MON_ADDR as four hex digits
000D3Fr 2               ; Input:  MON_ADDR, MON_ADDR+1 = 16-bit value
000D3Fr 2               ; Modifies: A, flags
000D3Fr 2               
000D3Fr 2               MonPrintHex4:
000D3Fr 2  A5 2F          lda MON_ADDR + 1              ; High byte first
000D41r 2  20 rr rr       jsr MonPrintHex2
000D44r 2  A5 2E          lda MON_ADDR                  ; Then low byte
000D46r 2  4C rr rr       jmp MonPrintHex2
000D49r 2               
000D49r 2               ; MonPrintSpace — Print a space character
000D49r 2               
000D49r 2               MonPrintSpace:
000D49r 2  A9 20          lda #' '
000D4Br 2  4C rr rr       jmp Chrout
000D4Er 2               
000D4Er 2               ; MonPrintCRLF — Print carriage return + line feed
000D4Er 2               
000D4Er 2               MonPrintCRLF:
000D4Er 2  A9 0D          lda #$0D
000D50r 2  20 rr rr       jsr Chrout
000D53r 2  A9 0A          lda #$0A
000D55r 2  4C rr rr       jmp Chrout
000D58r 2               
000D58r 2               ; MonPrintError — Print "?" for unrecognized command
000D58r 2               
000D58r 2               MonPrintError:
000D58r 2  A9 3F          lda #'?'
000D5Ar 2  20 rr rr       jsr Chrout
000D5Dr 2  4C rr rr       jmp MonPrintCRLF
000D60r 2               
000D60r 2               ; MonPrintBanner — Print the monitor banner string
000D60r 2               
000D60r 2               MonPrintBanner:
000D60r 2  A2 00          ldx #0
000D62r 2               @Loop:
000D62r 2  BD rr rr       lda MonStrBanner,x
000D65r 2  F0 06          beq @Done
000D67r 2  20 rr rr       jsr Chrout
000D6Ar 2  E8             inx
000D6Br 2  80 F5          bra @Loop
000D6Dr 2               @Done:
000D6Dr 2  60             rts
000D6Er 2               
000D6Er 2               ; ============================================================================
000D6Er 2               ; String Data
000D6Er 2               ; ============================================================================
000D6Er 2               
000D6Er 2               MonStrBanner:
000D6Er 2  36 35 30 32    .byte "6502 MONITOR v1.1", $0D, $0A, 0
000D72r 2  20 4D 4F 4E  
000D76r 2  49 54 4F 52  
000D82r 2               MonStrBrk:
000D82r 2  42 52 4B 20    .byte "BRK AT $", 0
000D86r 2  41 54 20 24  
000D8Ar 2  00           
000D8Br 2               MonStrNotFound:
000D8Br 2  46 49 4C 45    .byte "FILE NOT FOUND", 0
000D8Fr 2  20 4E 4F 54  
000D93r 2  20 46 4F 55  
000D9Ar 2               MonStrDirFull:
000D9Ar 2  44 49 52 45    .byte "DIRECTORY FULL", 0
000D9Er 2  43 54 4F 52  
000DA2r 2  59 20 46 55  
000DA9r 2               MonStrLoadPfx:
000DA9r 2  4C 4F 41 44    .byte "LOADED ", 0
000DADr 2  45 44 20 00  
000DB1r 2               MonStrSavePfx:
000DB1r 2  53 41 56 45    .byte "SAVED ", 0
000DB5r 2  44 20 00     
000DB8r 2               MonStrBytesAt:
000DB8r 2  20 42 59 54    .byte " BYTES AT $", 0
000DBCr 2  45 53 20 41  
000DC0r 2  54 20 24 00  
000DC4r 2               MonStrBytes:
000DC4r 2  20 42 59 54    .byte " BYTES", 0
000DC8r 2  45 53 00     
000DCBr 2               MonStrIOErr:
000DCBr 2  49 2F 4F 20    .byte "I/O ERROR", 0
000DCFr 2  45 52 52 4F  
000DD3r 2  52 00        
000DD5r 2               
000DD5r 2               ; ============================================================================
000DD5r 2               ; Disassembler Data Tables
000DD5r 2               ; ============================================================================
000DD5r 2               
000DD5r 2               ; Mnemonic string table — 71 entries x 3 chars = 213 bytes
000DD5r 2               DisMnemonics:
000DD5r 2  41 44 43       .byte "ADC"              ; 0
000DD8r 2  41 4E 44       .byte "AND"              ; 1
000DDBr 2  41 53 4C       .byte "ASL"              ; 2
000DDEr 2  42 42 52       .byte "BBR"              ; 3
000DE1r 2  42 42 53       .byte "BBS"              ; 4
000DE4r 2  42 43 43       .byte "BCC"              ; 5
000DE7r 2  42 43 53       .byte "BCS"              ; 6
000DEAr 2  42 45 51       .byte "BEQ"              ; 7
000DEDr 2  42 49 54       .byte "BIT"              ; 8
000DF0r 2  42 4D 49       .byte "BMI"              ; 9
000DF3r 2  42 4E 45       .byte "BNE"              ; 10
000DF6r 2  42 50 4C       .byte "BPL"              ; 11
000DF9r 2  42 52 41       .byte "BRA"              ; 12
000DFCr 2  42 52 4B       .byte "BRK"              ; 13
000DFFr 2  42 56 43       .byte "BVC"              ; 14
000E02r 2  42 56 53       .byte "BVS"              ; 15
000E05r 2  43 4C 43       .byte "CLC"              ; 16
000E08r 2  43 4C 44       .byte "CLD"              ; 17
000E0Br 2  43 4C 49       .byte "CLI"              ; 18
000E0Er 2  43 4C 56       .byte "CLV"              ; 19
000E11r 2  43 4D 50       .byte "CMP"              ; 20
000E14r 2  43 50 58       .byte "CPX"              ; 21
000E17r 2  43 50 59       .byte "CPY"              ; 22
000E1Ar 2  44 45 43       .byte "DEC"              ; 23
000E1Dr 2  44 45 58       .byte "DEX"              ; 24
000E20r 2  44 45 59       .byte "DEY"              ; 25
000E23r 2  45 4F 52       .byte "EOR"              ; 26
000E26r 2  49 4E 43       .byte "INC"              ; 27
000E29r 2  49 4E 58       .byte "INX"              ; 28
000E2Cr 2  49 4E 59       .byte "INY"              ; 29
000E2Fr 2  4A 4D 50       .byte "JMP"              ; 30
000E32r 2  4A 53 52       .byte "JSR"              ; 31
000E35r 2  4C 44 41       .byte "LDA"              ; 32
000E38r 2  4C 44 58       .byte "LDX"              ; 33
000E3Br 2  4C 44 59       .byte "LDY"              ; 34
000E3Er 2  4C 53 52       .byte "LSR"              ; 35
000E41r 2  4E 4F 50       .byte "NOP"              ; 36
000E44r 2  4F 52 41       .byte "ORA"              ; 37
000E47r 2  50 48 41       .byte "PHA"              ; 38
