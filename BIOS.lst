000AC8r 2  AD 15 03       lda BRK_Y
000ACBr 2  20 rr rr       jsr MonPrintHex2
000ACEr 2  A9 20          lda #' '
000AD0r 2  20 rr rr       jsr Chrout
000AD3r 2               
000AD3r 2                 ; "SP="
000AD3r 2  A9 53          lda #'S'
000AD5r 2  20 rr rr       jsr Chrout
000AD8r 2  A9 50          lda #'P'
000ADAr 2  20 rr rr       jsr Chrout
000ADDr 2  A9 3D          lda #'='
000ADFr 2  20 rr rr       jsr Chrout
000AE2r 2  AD 16 03       lda BRK_SP
000AE5r 2  20 rr rr       jsr MonPrintHex2
000AE8r 2  A9 20          lda #' '
000AEAr 2  20 rr rr       jsr Chrout
000AEDr 2               
000AEDr 2                 ; Flags: NV-BDIZC
000AEDr 2  AD 10 03       lda BRK_P
000AF0r 2  85 34          sta MON_BYTE                  ; Save flags for bit testing
000AF2r 2  A2 00          ldx #0
000AF4r 2               @FlagLoop:
000AF4r 2  BD rr rr       lda MonFlagChars,x
000AF7r 2  F0 11          beq @FlagsDone
000AF9r 2  06 34          asl MON_BYTE                  ; Shift next flag bit into carry
000AFBr 2  B0 04          bcs @FlagSet
000AFDr 2  A9 2D          lda #'-'                      ; Flag clear — print dash
000AFFr 2  80 03          bra @FlagPrint
000B01r 2               @FlagSet:
000B01r 2                 ; A already has the flag character
000B01r 2  BD rr rr       lda MonFlagChars,x
000B04r 2               @FlagPrint:
000B04r 2  20 rr rr       jsr Chrout
000B07r 2  E8             inx
000B08r 2  80 EA          bra @FlagLoop
000B0Ar 2               @FlagsDone:
000B0Ar 2  20 rr rr       jsr MonPrintCRLF
000B0Dr 2  60             rts
000B0Er 2               
000B0Er 2               MonFlagChars:
000B0Er 2  4E 56 2D 42    .byte "NV-BDIZC", 0
000B12r 2  44 49 5A 43  
000B16r 2  00           
000B17r 2               
000B17r 2               ; ============================================================================
000B17r 2               ; Hex Parsing Utilities
000B17r 2               ; ============================================================================
000B17r 2               
000B17r 2               ; MonParseHex4 — Parse up to 4 hex digits from MON_LINBUF into MON_ADDR
000B17r 2               ; Input:  MON_IDX points to current position in MON_LINBUF
000B17r 2               ; Output: MON_ADDR/MON_ADDR+1 = parsed 16-bit value, carry set if valid
000B17r 2               ;         MON_IDX advanced past parsed digits
000B17r 2               
000B17r 2               MonParseHex4:
000B17r 2  64 2E          stz MON_ADDR
000B19r 2  64 2F          stz MON_ADDR + 1
000B1Br 2  A2 00          ldx #0                        ; Digit count
000B1Dr 2               @ParseLoop:
000B1Dr 2  A4 35          ldy MON_IDX
000B1Fr 2  B9 00 04       lda MON_LINBUF,y
000B22r 2  20 rr rr       jsr MonCharToNibble           ; Convert ASCII to 0-15, carry clear if valid
000B25r 2  B0 1B          bcs @ParseDone                ; Not a hex digit — stop
000B27r 2                 ; Shift result left 4 bits and OR in new nibble
000B27r 2  06 2E          asl MON_ADDR
000B29r 2  26 2F          rol MON_ADDR + 1
000B2Br 2  06 2E          asl MON_ADDR
000B2Dr 2  26 2F          rol MON_ADDR + 1
000B2Fr 2  06 2E          asl MON_ADDR
000B31r 2  26 2F          rol MON_ADDR + 1
000B33r 2  06 2E          asl MON_ADDR
000B35r 2  26 2F          rol MON_ADDR + 1
000B37r 2  05 2E          ora MON_ADDR
000B39r 2  85 2E          sta MON_ADDR
000B3Br 2  E6 35          inc MON_IDX
000B3Dr 2  E8             inx
000B3Er 2  E0 04          cpx #4                        ; Max 4 digits
000B40r 2  90 DB          bcc @ParseLoop
000B42r 2               @ParseDone:
000B42r 2  E0 00          cpx #0                        ; Did we parse at least one digit?
000B44r 2  F0 02          beq @ParseFail
000B46r 2  38             sec                           ; Success
000B47r 2  60             rts
000B48r 2               @ParseFail:
000B48r 2  18             clc                           ; Failure — no digits parsed
000B49r 2  60             rts
000B4Ar 2               
000B4Ar 2               ; MonParseHex2 — Parse up to 2 hex digits from MON_LINBUF into A
000B4Ar 2               ; Input:  MON_IDX points to current position in MON_LINBUF
000B4Ar 2               ; Output: A = parsed 8-bit value, carry set if valid
000B4Ar 2               ;         MON_IDX advanced past parsed digits
000B4Ar 2               
000B4Ar 2               MonParseHex2:
000B4Ar 2  64 34          stz MON_BYTE
000B4Cr 2  A2 00          ldx #0                        ; Digit count
000B4Er 2               @ParseLoop:
000B4Er 2  A4 35          ldy MON_IDX
000B50r 2  B9 00 04       lda MON_LINBUF,y
000B53r 2  20 rr rr       jsr MonCharToNibble
000B56r 2  B0 13          bcs @ParseDone
000B58r 2  06 34          asl MON_BYTE
000B5Ar 2  06 34          asl MON_BYTE
000B5Cr 2  06 34          asl MON_BYTE
000B5Er 2  06 34          asl MON_BYTE
000B60r 2  05 34          ora MON_BYTE
000B62r 2  85 34          sta MON_BYTE
000B64r 2  E6 35          inc MON_IDX
000B66r 2  E8             inx
000B67r 2  E0 02          cpx #2
000B69r 2  90 E3          bcc @ParseLoop
000B6Br 2               @ParseDone:
000B6Br 2  E0 00          cpx #0
000B6Dr 2  F0 04          beq @ParseFail
000B6Fr 2  A5 34          lda MON_BYTE
000B71r 2  38             sec
000B72r 2  60             rts
000B73r 2               @ParseFail:
000B73r 2  18             clc
000B74r 2  60             rts
000B75r 2               
000B75r 2               ; MonCharToNibble — Convert ASCII hex char in A to nibble value 0-15
000B75r 2               ; Input:  A = ASCII character
000B75r 2               ; Output: A = 0-15 if valid hex digit, carry clear
000B75r 2               ;         carry set if not a valid hex digit (A preserved)
000B75r 2               
000B75r 2               MonCharToNibble:
000B75r 2  C9 30          cmp #'0'
000B77r 2  90 23          bcc @NotHex
000B79r 2  C9 3A          cmp #'9'+1
000B7Br 2  90 15          bcc @IsDigit
000B7Dr 2  C9 41          cmp #'A'
000B7Fr 2  90 04          bcc @CheckLower
000B81r 2  C9 47          cmp #'F'+1
000B83r 2  90 12          bcc @IsUpper
000B85r 2               @CheckLower:
000B85r 2  C9 61          cmp #'a'
000B87r 2  90 13          bcc @NotHex
000B89r 2  C9 67          cmp #'f'+1
000B8Br 2  B0 0F          bcs @NotHex
000B8Dr 2                 ; Lowercase a-f
000B8Dr 2  38             sec
000B8Er 2  E9 57          sbc #('a' - 10)
000B90r 2  18             clc
000B91r 2  60             rts
000B92r 2               @IsDigit:
000B92r 2  38             sec
000B93r 2  E9 30          sbc #'0'
000B95r 2  18             clc
000B96r 2  60             rts
000B97r 2               @IsUpper:
000B97r 2  38             sec
000B98r 2  E9 37          sbc #('A' - 10)
000B9Ar 2  18             clc
000B9Br 2  60             rts
000B9Cr 2               @NotHex:
000B9Cr 2  38             sec
000B9Dr 2  60             rts
000B9Er 2               
000B9Er 2               ; MonSkipSpaces — Advance MON_IDX past whitespace in MON_LINBUF
000B9Er 2               
000B9Er 2               MonSkipSpaces:
000B9Er 2  A4 35          ldy MON_IDX
000BA0r 2  B9 00 04       lda MON_LINBUF,y
000BA3r 2  C9 20          cmp #' '
000BA5r 2  D0 04          bne @Done
000BA7r 2  E6 35          inc MON_IDX
000BA9r 2  80 F3          bra MonSkipSpaces
000BABr 2               @Done:
000BABr 2  60             rts
000BACr 2               
000BACr 2               ; ============================================================================
000BACr 2               ; Decimal & Binary Parsing Utilities
000BACr 2               ; ============================================================================
000BACr 2               
000BACr 2               ; MonParseDec16 — Parse decimal digits from MON_LINBUF into MON_ADDR
000BACr 2               ; Input:  MON_IDX points to current position in MON_LINBUF
000BACr 2               ; Output: MON_ADDR = parsed 16-bit value, carry set if valid
000BACr 2               ;         MON_IDX advanced past parsed digits
000BACr 2               ; Modifies: A, X, Y, MON_ADDR, MON_TMP
000BACr 2               
000BACr 2               MonParseDec16:
000BACr 2  64 2E          stz MON_ADDR
000BAEr 2  64 2F          stz MON_ADDR+1
000BB0r 2  A2 00          ldx #0                        ; Digit count
000BB2r 2               @DecLoop:
000BB2r 2  A4 35          ldy MON_IDX
000BB4r 2  B9 00 04       lda MON_LINBUF,y
000BB7r 2  C9 30          cmp #'0'
000BB9r 2  90 3A          bcc @DecDone
000BBBr 2  C9 3A          cmp #'9'+1
000BBDr 2  B0 36          bcs @DecDone
000BBFr 2  38             sec
000BC0r 2  E9 30          sbc #'0'                      ; A = digit 0-9
000BC2r 2  48             pha                           ; Save digit
000BC3r 2                 ; MON_ADDR = MON_ADDR * 10 + digit
000BC3r 2                 ; *10 = (*2 + *8): save *2, then *8, add
000BC3r 2  06 2E          asl MON_ADDR
000BC5r 2  26 2F          rol MON_ADDR+1
000BC7r 2  A5 2E          lda MON_ADDR
000BC9r 2  85 32          sta MON_TMP
000BCBr 2  A5 2F          lda MON_ADDR+1
000BCDr 2  85 33          sta MON_TMP+1                 ; MON_TMP = *2
000BCFr 2  06 2E          asl MON_ADDR
000BD1r 2  26 2F          rol MON_ADDR+1                ; *4
000BD3r 2  06 2E          asl MON_ADDR
000BD5r 2  26 2F          rol MON_ADDR+1                ; *8
000BD7r 2  18             clc
000BD8r 2  A5 2E          lda MON_ADDR
000BDAr 2  65 32          adc MON_TMP
000BDCr 2  85 2E          sta MON_ADDR
000BDEr 2  A5 2F          lda MON_ADDR+1
000BE0r 2  65 33          adc MON_TMP+1
000BE2r 2  85 2F          sta MON_ADDR+1                ; *10
000BE4r 2                 ; + digit
000BE4r 2  68             pla
000BE5r 2  18             clc
000BE6r 2  65 2E          adc MON_ADDR
000BE8r 2  85 2E          sta MON_ADDR
000BEAr 2  90 02          bcc @DecNoCarry
000BECr 2  E6 2F          inc MON_ADDR+1
000BEEr 2               @DecNoCarry:
000BEEr 2  E6 35          inc MON_IDX
000BF0r 2  E8             inx
000BF1r 2  E0 05          cpx #5                        ; Max 5 digits (65535)
000BF3r 2  90 BD          bcc @DecLoop
000BF5r 2               @DecDone:
000BF5r 2  E0 00          cpx #0
000BF7r 2  F0 02          beq @DecFail
000BF9r 2  38             sec                           ; Success
000BFAr 2  60             rts
000BFBr 2               @DecFail:
000BFBr 2  18             clc                           ; Failure
000BFCr 2  60             rts
000BFDr 2               
000BFDr 2               ; MonParseBin16 — Parse binary digits from MON_LINBUF into MON_ADDR
000BFDr 2               ; Input:  MON_IDX points to current position in MON_LINBUF
000BFDr 2               ; Output: MON_ADDR = parsed 16-bit value, carry set if valid
000BFDr 2               ;         MON_IDX advanced past parsed digits
000BFDr 2               ; Modifies: A, X, Y, MON_ADDR
000BFDr 2               
000BFDr 2               MonParseBin16:
000BFDr 2  64 2E          stz MON_ADDR
000BFFr 2  64 2F          stz MON_ADDR+1
000C01r 2  A2 00          ldx #0                        ; Digit count
000C03r 2               @BinLoop:
000C03r 2  A4 35          ldy MON_IDX
000C05r 2  B9 00 04       lda MON_LINBUF,y
000C08r 2  C9 30          cmp #'0'
000C0Ar 2  F0 06          beq @BinGot
000C0Cr 2  C9 31          cmp #'1'
000C0Er 2  F0 02          beq @BinGot
000C10r 2  80 0F          bra @BinDone
000C12r 2               @BinGot:
000C12r 2  38             sec
000C13r 2  E9 30          sbc #'0'                      ; A = 0 or 1
000C15r 2  4A             lsr a                         ; Bit into carry
000C16r 2  26 2E          rol MON_ADDR
000C18r 2  26 2F          rol MON_ADDR+1
000C1Ar 2  E6 35          inc MON_IDX
000C1Cr 2  E8             inx
000C1Dr 2  E0 10          cpx #16                       ; Max 16 bits
000C1Fr 2  90 E2          bcc @BinLoop
000C21r 2               @BinDone:
000C21r 2  E0 00          cpx #0
000C23r 2  F0 02          beq @BinFail
000C25r 2  38             sec                           ; Success
000C26r 2  60             rts
000C27r 2               @BinFail:
000C27r 2  18             clc                           ; Failure
000C28r 2  60             rts
000C29r 2               
000C29r 2               ; ============================================================================
000C29r 2               ; Decimal & Binary Output Utilities
000C29r 2               ; ============================================================================
000C29r 2               
000C29r 2               ; MonPrintDec16 — Print MON_ADDR as up to 5 decimal digits
000C29r 2               ; Uses successive subtraction of powers of 10
000C29r 2               ; Modifies: A, X, Y, MON_TMP, MON_BYTE
000C29r 2               
000C29r 2               MonPrintDec16:
000C29r 2                 ; Copy value to MON_TMP so we don't destroy MON_ADDR
000C29r 2  A5 2E          lda MON_ADDR
000C2Br 2  85 32          sta MON_TMP
000C2Dr 2  A5 2F          lda MON_ADDR+1
000C2Fr 2  85 33          sta MON_TMP+1
000C31r 2  A2 00          ldx #0                        ; Leading zero suppression flag
000C33r 2  A0 00          ldy #0                        ; Power-of-10 index
000C35r 2               @Dec16Loop:
000C35r 2  A9 2F          lda #'0'-1
000C37r 2  85 34          sta MON_BYTE                  ; Digit scratch
000C39r 2               @Dec16Sub:
000C39r 2  E6 34          inc MON_BYTE
000C3Br 2  A5 32          lda MON_TMP
000C3Dr 2  38             sec
000C3Er 2  F9 rr rr       sbc @Dec16Pow10Lo,y
000C41r 2  48             pha
000C42r 2  A5 33          lda MON_TMP+1
000C44r 2  F9 rr rr       sbc @Dec16Pow10Hi,y
000C47r 2  90 07          bcc @Dec16Digit               ; Underflow — digit done
000C49r 2  85 33          sta MON_TMP+1
000C4Br 2  68             pla
000C4Cr 2  85 32          sta MON_TMP
000C4Er 2  80 E9          bra @Dec16Sub
000C50r 2               @Dec16Digit:
000C50r 2  68             pla                           ; Discard underflowed low byte
000C51r 2  A5 34          lda MON_BYTE
000C53r 2  C9 30          cmp #'0'
000C55r 2  D0 04          bne @Dec16Print               ; Non-zero → print
000C57r 2  E0 00          cpx #0
000C59r 2  F0 08          beq @Dec16Skip                ; Leading zero → skip
000C5Br 2               @Dec16Print:
000C5Br 2  DA             phx
000C5Cr 2  5A             phy
000C5Dr 2  20 rr rr       jsr Chrout
000C60r 2  7A             ply
000C61r 2  FA             plx
000C62r 2  E8             inx                           ; Mark we've printed a digit
000C63r 2               @Dec16Skip:
000C63r 2  C8             iny
000C64r 2  C0 04          cpy #4                        ; 4 powers: 10000, 1000, 100, 10
000C66r 2  D0 CD          bne @Dec16Loop
000C68r 2                 ; Always print ones digit
000C68r 2  A5 32          lda MON_TMP
000C6Ar 2  09 30          ora #'0'
000C6Cr 2  20 rr rr       jsr Chrout
000C6Fr 2  60             rts
000C70r 2  10 E8 64 0A  @Dec16Pow10Lo: .byte <10000, <1000, <100, <10
000C74r 2  27 03 00 00  @Dec16Pow10Hi: .byte >10000, >1000, >100, >10
000C78r 2               
000C78r 2               ; MonPrintBin16 — Print MON_ADDR as 16 binary digits (MSB first)
000C78r 2               ; Modifies: A, X
000C78r 2               
000C78r 2               MonPrintBin16:
000C78r 2  A5 2F          lda MON_ADDR+1                ; High byte first
000C7Ar 2  20 rr rr       jsr @PrintBin8
000C7Dr 2  A5 2E          lda MON_ADDR                  ; Then low byte
000C7Fr 2               @PrintBin8:
000C7Fr 2  A2 08          ldx #8
000C81r 2               @BinBitLoop:
000C81r 2  0A             asl a                         ; Shift MSB into carry
000C82r 2  48             pha
000C83r 2  A9 30          lda #'0'
000C85r 2  69 00          adc #0                        ; +1 if carry → '1'
000C87r 2  20 rr rr       jsr Chrout
000C8Ar 2  68             pla
000C8Br 2  CA             dex
000C8Cr 2  D0 F3          bne @BinBitLoop
000C8Er 2  60             rts
000C8Fr 2               
000C8Fr 2               ; ============================================================================
000C8Fr 2               ; Message Print Helpers (Phase 5)
000C8Fr 2               ; ============================================================================
000C8Fr 2               
000C8Fr 2               ; MonPrintLoaded — Print "LOADED nnnn BYTES AT $xxxx"
000C8Fr 2               ; Input: MON_ADDR = byte count, MON_END = load address
000C8Fr 2               ; Modifies: A, X, Y, MON_TMP, MON_BYTE
000C8Fr 2               
000C8Fr 2               MonPrintLoaded:
000C8Fr 2  A2 00          ldx #0
000C91r 2               @PLoop1:
000C91r 2  BD rr rr       lda MonStrLoadPfx,x
000C94r 2  F0 06          beq @PDone1
000C96r 2  20 rr rr       jsr Chrout
000C99r 2  E8             inx
000C9Ar 2  80 F5          bra @PLoop1
000C9Cr 2               @PDone1:
000C9Cr 2  20 rr rr       jsr MonPrintDec16             ; Print byte count from MON_ADDR
000C9Fr 2  A2 00          ldx #0
000CA1r 2               @PLoop2:
000CA1r 2  BD rr rr       lda MonStrBytesAt,x
000CA4r 2  F0 06          beq @PDone2
000CA6r 2  20 rr rr       jsr Chrout
000CA9r 2  E8             inx
000CAAr 2  80 F5          bra @PLoop2
000CACr 2               @PDone2:
000CACr 2                 ; Print address from MON_END
000CACr 2  A5 30          lda MON_END
000CAEr 2  85 2E          sta MON_ADDR
000CB0r 2  A5 31          lda MON_END+1
000CB2r 2  85 2F          sta MON_ADDR+1
000CB4r 2  20 rr rr       jsr MonPrintHex4
000CB7r 2  4C rr rr       jmp MonPrintCRLF
000CBAr 2               
000CBAr 2               ; MonPrintSaved — Print "SAVED nnnn BYTES"
000CBAr 2               ; Input: MON_ADDR = byte count
000CBAr 2               ; Modifies: A, X, Y, MON_TMP, MON_BYTE
000CBAr 2               
000CBAr 2               MonPrintSaved:
000CBAr 2  A2 00          ldx #0
000CBCr 2               @SLoop1:
000CBCr 2  BD rr rr       lda MonStrSavePfx,x
000CBFr 2  F0 06          beq @SDone1
000CC1r 2  20 rr rr       jsr Chrout
000CC4r 2  E8             inx
000CC5r 2  80 F5          bra @SLoop1
000CC7r 2               @SDone1:
000CC7r 2  20 rr rr       jsr MonPrintDec16             ; Print byte count from MON_ADDR
000CCAr 2  A2 00          ldx #0
000CCCr 2               @SLoop2:
000CCCr 2  BD rr rr       lda MonStrBytes,x
000CCFr 2  F0 06          beq @SDone2
000CD1r 2  20 rr rr       jsr Chrout
000CD4r 2  E8             inx
000CD5r 2  80 F5          bra @SLoop2
000CD7r 2               @SDone2:
000CD7r 2  4C rr rr       jmp MonPrintCRLF
000CDAr 2               
000CDAr 2               ; MonPrintIOErr — Print "I/O ERROR"
000CDAr 2               ; Modifies: A, X
000CDAr 2               
000CDAr 2               MonPrintIOErr:
000CDAr 2  A2 00          ldx #0
000CDCr 2               @ELoop:
000CDCr 2  BD rr rr       lda MonStrIOErr,x
000CDFr 2  F0 06          beq @EDone
000CE1r 2  20 rr rr       jsr Chrout
000CE4r 2  E8             inx
000CE5r 2  80 F5          bra @ELoop
000CE7r 2               @EDone:
000CE7r 2  4C rr rr       jmp MonPrintCRLF
000CEAr 2               
000CEAr 2               ; ============================================================================
000CEAr 2               ; Hex Output Utilities
000CEAr 2               ; ============================================================================
000CEAr 2               
000CEAr 2               ; MonPrintHex2 — Print A as two hex digits
000CEAr 2               ; Input:  A = byte to print
000CEAr 2               ; Modifies: A, flags
000CEAr 2               
000CEAr 2               MonPrintHex2:
000CEAr 2  48             pha                           ; Save original byte
000CEBr 2  4A             lsr                           ; Shift high nibble down
000CECr 2  4A             lsr
000CEDr 2  4A             lsr
000CEEr 2  4A             lsr
000CEFr 2  20 rr rr       jsr @PrintNibble              ; Print high nibble
000CF2r 2  68             pla                           ; Restore original byte
000CF3r 2  29 0F          and #$0F                      ; Isolate low nibble
000CF5r 2               @PrintNibble:
000CF5r 2  C9 0A          cmp #10
000CF7r 2  90 06          bcc @IsDigit
000CF9r 2  18             clc
000CFAr 2  69 37          adc #('A' - 10)
000CFCr 2  4C rr rr       jmp Chrout
000CFFr 2               @IsDigit:
000CFFr 2  18             clc
000D00r 2  69 30          adc #'0'
000D02r 2  4C rr rr       jmp Chrout
000D05r 2               
000D05r 2               ; MonPrintHex4 — Print MON_ADDR as four hex digits
000D05r 2               ; Input:  MON_ADDR, MON_ADDR+1 = 16-bit value
000D05r 2               ; Modifies: A, flags
000D05r 2               
000D05r 2               MonPrintHex4:
000D05r 2  A5 2F          lda MON_ADDR + 1              ; High byte first
000D07r 2  20 rr rr       jsr MonPrintHex2
000D0Ar 2  A5 2E          lda MON_ADDR                  ; Then low byte
000D0Cr 2  4C rr rr       jmp MonPrintHex2
000D0Fr 2               
000D0Fr 2               ; MonPrintSpace — Print a space character
000D0Fr 2               
000D0Fr 2               MonPrintSpace:
000D0Fr 2  A9 20          lda #' '
000D11r 2  4C rr rr       jmp Chrout
000D14r 2               
000D14r 2               ; MonPrintCRLF — Print carriage return + line feed
000D14r 2               
000D14r 2               MonPrintCRLF:
000D14r 2  A9 0D          lda #$0D
000D16r 2  20 rr rr       jsr Chrout
000D19r 2  A9 0A          lda #$0A
000D1Br 2  4C rr rr       jmp Chrout
000D1Er 2               
000D1Er 2               ; MonPrintError — Print "?" for unrecognized command
000D1Er 2               
000D1Er 2               MonPrintError:
000D1Er 2  A9 3F          lda #'?'
000D20r 2  20 rr rr       jsr Chrout
000D23r 2  4C rr rr       jmp MonPrintCRLF
000D26r 2               
000D26r 2               ; MonPrintBanner — Print the monitor banner string
000D26r 2               
000D26r 2               MonPrintBanner:
000D26r 2  A2 00          ldx #0
000D28r 2               @Loop:
000D28r 2  BD rr rr       lda MonStrBanner,x
000D2Br 2  F0 06          beq @Done
000D2Dr 2  20 rr rr       jsr Chrout
000D30r 2  E8             inx
000D31r 2  80 F5          bra @Loop
000D33r 2               @Done:
000D33r 2  60             rts
000D34r 2               
000D34r 2               ; ============================================================================
000D34r 2               ; String Data
000D34r 2               ; ============================================================================
000D34r 2               
000D34r 2               MonStrBanner:
000D34r 2  36 35 30 32    .byte "6502 MONITOR v1.1", $0D, $0A, 0
000D38r 2  20 4D 4F 4E  
000D3Cr 2  49 54 4F 52  
000D48r 2               MonStrBrk:
000D48r 2  42 52 4B 20    .byte "BRK AT $", 0
000D4Cr 2  41 54 20 24  
