0021B0r 2               ; ---------------------------------------------------------------------------
0021B0r 2               ; Statement: IF expr THEN (linenum | stmt) [ELSE stmt]
0021B0r 2               ;   IF expr GOTO linenum is also accepted.
0021B0r 2               ;   If expr is false, skip rest of line (REM-style).
0021B0r 2               ;   ELSE: scan ahead for TOK_ELSE on this line.
0021B0r 2               ; ---------------------------------------------------------------------------
0021B0r 2               BasCmdIf:
0021B0r 2  20 rr rr             jsr     FrmEvl
0021B3r 2  20 rr rr             jsr     ChrGot
0021B6r 2  C9 88                cmp     #TOK_GOTO
