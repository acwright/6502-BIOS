000ACCr 2  A9 29          lda #')'
000ACEr 2  4C rr rr       jmp Chrout
000AD1r 2               
000AD1r 2               ; ============================================================================
000AD1r 2               ; MonShowRegs — Print saved register state
000AD1r 2               ; Format: PC=xxxx A=xx X=xx Y=xx SP=xx NV-BDIZC
000AD1r 2               ; ============================================================================
000AD1r 2               
000AD1r 2               MonShowRegs:
000AD1r 2                 ; "PC="
000AD1r 2  A9 50          lda #'P'
000AD3r 2  20 rr rr       jsr Chrout
000AD6r 2  A9 43          lda #'C'
000AD8r 2  20 rr rr       jsr Chrout
000ADBr 2  A9 3D          lda #'='
000ADDr 2  20 rr rr       jsr Chrout
000AE0r 2                 ; Print the saved PC as it stands.  This used to subtract 2, to name the BRK
000AE0r 2                 ; instruction rather than the address after it -- but `;` and `G` both treat
000AE0r 2                 ; the field literally, so `; PC 1234` displayed as PC=1232 and ran from 1234.
000AE0r 2                 ; A display that does not round-trip with the command that sets it is worse
000AE0r 2                 ; than one that needs a second line to interpret, and the break location is
000AE0r 2                 ; not lost: MonBrkEntry prints "BRK AT $" with its own adjustment. What R
000AE0r 2                 ; reports now is where G will resume, which is what the saved register is.
000AE0r 2  AD 11 03       lda BRK_PCL
000AE3r 2  85 2E          sta MON_ADDR
000AE5r 2  AD 12 03       lda BRK_PCH
000AE8r 2  85 2F          sta MON_ADDR + 1
000AEAr 2  20 rr rr       jsr MonPrintHex4
000AEDr 2  A9 20          lda #' '
000AEFr 2  20 rr rr       jsr Chrout
000AF2r 2               
000AF2r 2                 ; "A="
000AF2r 2  A9 41          lda #'A'
000AF4r 2  20 rr rr       jsr Chrout
000AF7r 2  A9 3D          lda #'='
000AF9r 2  20 rr rr       jsr Chrout
000AFCr 2  AD 13 03       lda BRK_A
000AFFr 2  20 rr rr       jsr MonPrintHex2
000B02r 2  A9 20          lda #' '
000B04r 2  20 rr rr       jsr Chrout
000B07r 2               
000B07r 2                 ; "X="
000B07r 2  A9 58          lda #'X'
000B09r 2  20 rr rr       jsr Chrout
000B0Cr 2  A9 3D          lda #'='
000B0Er 2  20 rr rr       jsr Chrout
000B11r 2  AD 14 03       lda BRK_X
000B14r 2  20 rr rr       jsr MonPrintHex2
000B17r 2  A9 20          lda #' '
000B19r 2  20 rr rr       jsr Chrout
000B1Cr 2               
000B1Cr 2                 ; "Y="
000B1Cr 2  A9 59          lda #'Y'
000B1Er 2  20 rr rr       jsr Chrout
000B21r 2  A9 3D          lda #'='
000B23r 2  20 rr rr       jsr Chrout
000B26r 2  AD 15 03       lda BRK_Y
000B29r 2  20 rr rr       jsr MonPrintHex2
000B2Cr 2  A9 20          lda #' '
000B2Er 2  20 rr rr       jsr Chrout
000B31r 2               
000B31r 2                 ; "SP="
000B31r 2  A9 53          lda #'S'
000B33r 2  20 rr rr       jsr Chrout
000B36r 2  A9 50          lda #'P'
000B38r 2  20 rr rr       jsr Chrout
000B3Br 2  A9 3D          lda #'='
000B3Dr 2  20 rr rr       jsr Chrout
000B40r 2  AD 16 03       lda BRK_SP
000B43r 2  20 rr rr       jsr MonPrintHex2
000B46r 2  A9 20          lda #' '
000B48r 2  20 rr rr       jsr Chrout
000B4Br 2               
000B4Br 2                 ; Flags: NV-BDIZC
000B4Br 2  AD 10 03       lda BRK_P
000B4Er 2  85 34          sta MON_BYTE                  ; Save flags for bit testing
000B50r 2  A2 00          ldx #0
000B52r 2               @FlagLoop:
000B52r 2  BD rr rr       lda MonFlagChars,x
000B55r 2  F0 11          beq @FlagsDone
000B57r 2  06 34          asl MON_BYTE                  ; Shift next flag bit into carry
000B59r 2  B0 04          bcs @FlagSet
000B5Br 2  A9 2D          lda #'-'                      ; Flag clear — print dash
000B5Dr 2  80 03          bra @FlagPrint
000B5Fr 2               @FlagSet:
000B5Fr 2                 ; A already has the flag character
000B5Fr 2  BD rr rr       lda MonFlagChars,x
000B62r 2               @FlagPrint:
000B62r 2  20 rr rr       jsr Chrout
000B65r 2  E8             inx
000B66r 2  80 EA          bra @FlagLoop
000B68r 2               @FlagsDone:
000B68r 2  20 rr rr       jsr MonPrintCRLF
000B6Br 2  60             rts
000B6Cr 2               
000B6Cr 2               MonFlagChars:
000B6Cr 2  4E 56 2D 42    .byte "NV-BDIZC", 0
000B70r 2  44 49 5A 43  
000B74r 2  00           
000B75r 2               
000B75r 2               ; ============================================================================
000B75r 2               ; Hex Parsing Utilities
000B75r 2               ; ============================================================================
000B75r 2               
000B75r 2               ; MonParseHex4 — Parse up to 4 hex digits from MON_LINBUF into MON_ADDR
000B75r 2               ; Input:  MON_IDX points to current position in MON_LINBUF
000B75r 2               ; Output: MON_ADDR/MON_ADDR+1 = parsed 16-bit value, carry set if valid
000B75r 2               ;         MON_IDX advanced past parsed digits
000B75r 2               
000B75r 2               MonParseHex4:
000B75r 2  64 2E          stz MON_ADDR
000B77r 2  64 2F          stz MON_ADDR + 1
000B79r 2  A2 00          ldx #0                        ; Digit count
000B7Br 2               @ParseLoop:
000B7Br 2  A4 35          ldy MON_IDX
000B7Dr 2  B9 00 04       lda MON_LINBUF,y
000B80r 2  20 rr rr       jsr MonCharToNibble           ; Convert ASCII to 0-15, carry clear if valid
000B83r 2  B0 1B          bcs @ParseDone                ; Not a hex digit — stop
000B85r 2                 ; Shift result left 4 bits and OR in new nibble
000B85r 2  06 2E          asl MON_ADDR
000B87r 2  26 2F          rol MON_ADDR + 1
000B89r 2  06 2E          asl MON_ADDR
000B8Br 2  26 2F          rol MON_ADDR + 1
000B8Dr 2  06 2E          asl MON_ADDR
000B8Fr 2  26 2F          rol MON_ADDR + 1
000B91r 2  06 2E          asl MON_ADDR
000B93r 2  26 2F          rol MON_ADDR + 1
000B95r 2  05 2E          ora MON_ADDR
000B97r 2  85 2E          sta MON_ADDR
000B99r 2  E6 35          inc MON_IDX
000B9Br 2  E8             inx
000B9Cr 2  E0 04          cpx #4                        ; Max 4 digits
000B9Er 2  90 DB          bcc @ParseLoop
000BA0r 2               @ParseDone:
000BA0r 2  E0 00          cpx #0                        ; Did we parse at least one digit?
000BA2r 2  F0 02          beq @ParseFail
000BA4r 2  38             sec                           ; Success
000BA5r 2  60             rts
000BA6r 2               @ParseFail:
000BA6r 2  18             clc                           ; Failure — no digits parsed
000BA7r 2  60             rts
000BA8r 2               
000BA8r 2               ; MonParseHex2 — Parse up to 2 hex digits from MON_LINBUF into A
000BA8r 2               ; Input:  MON_IDX points to current position in MON_LINBUF
000BA8r 2               ; Output: A = parsed 8-bit value, carry set if valid
000BA8r 2               ;         MON_IDX advanced past parsed digits
000BA8r 2               
000BA8r 2               MonParseHex2:
000BA8r 2  64 34          stz MON_BYTE
000BAAr 2  A2 00          ldx #0                        ; Digit count
000BACr 2               @ParseLoop:
000BACr 2  A4 35          ldy MON_IDX
000BAEr 2  B9 00 04       lda MON_LINBUF,y
000BB1r 2  20 rr rr       jsr MonCharToNibble
000BB4r 2  B0 13          bcs @ParseDone
000BB6r 2  06 34          asl MON_BYTE
000BB8r 2  06 34          asl MON_BYTE
000BBAr 2  06 34          asl MON_BYTE
000BBCr 2  06 34          asl MON_BYTE
000BBEr 2  05 34          ora MON_BYTE
000BC0r 2  85 34          sta MON_BYTE
000BC2r 2  E6 35          inc MON_IDX
000BC4r 2  E8             inx
000BC5r 2  E0 02          cpx #2
000BC7r 2  90 E3          bcc @ParseLoop
000BC9r 2               @ParseDone:
000BC9r 2  E0 00          cpx #0
000BCBr 2  F0 04          beq @ParseFail
000BCDr 2  A5 34          lda MON_BYTE
000BCFr 2  38             sec
000BD0r 2  60             rts
000BD1r 2               @ParseFail:
000BD1r 2  18             clc
000BD2r 2  60             rts
000BD3r 2               
000BD3r 2               ; MonCharToNibble — Convert ASCII hex char in A to nibble value 0-15
000BD3r 2               ; Input:  A = ASCII character
000BD3r 2               ; Output: A = 0-15 if valid hex digit, carry clear
000BD3r 2               ;         carry set if not a valid hex digit (A preserved)
000BD3r 2               
000BD3r 2               MonCharToNibble:
000BD3r 2  C9 30          cmp #'0'
000BD5r 2  90 23          bcc @NotHex
000BD7r 2  C9 3A          cmp #'9'+1
000BD9r 2  90 15          bcc @IsDigit
000BDBr 2  C9 41          cmp #'A'
000BDDr 2  90 04          bcc @CheckLower
000BDFr 2  C9 47          cmp #'F'+1
000BE1r 2  90 12          bcc @IsUpper
000BE3r 2               @CheckLower:
000BE3r 2  C9 61          cmp #'a'
000BE5r 2  90 13          bcc @NotHex
000BE7r 2  C9 67          cmp #'f'+1
000BE9r 2  B0 0F          bcs @NotHex
000BEBr 2                 ; Lowercase a-f
000BEBr 2  38             sec
000BECr 2  E9 57          sbc #('a' - 10)
000BEEr 2  18             clc
000BEFr 2  60             rts
000BF0r 2               @IsDigit:
000BF0r 2  38             sec
000BF1r 2  E9 30          sbc #'0'
000BF3r 2  18             clc
000BF4r 2  60             rts
000BF5r 2               @IsUpper:
000BF5r 2  38             sec
000BF6r 2  E9 37          sbc #('A' - 10)
000BF8r 2  18             clc
000BF9r 2  60             rts
000BFAr 2               @NotHex:
000BFAr 2  38             sec
000BFBr 2  60             rts
000BFCr 2               
000BFCr 2               ; MonSkipSpaces — Advance MON_IDX past whitespace in MON_LINBUF
000BFCr 2               
000BFCr 2               MonSkipSpaces:
000BFCr 2  A4 35          ldy MON_IDX
000BFEr 2  B9 00 04       lda MON_LINBUF,y
000C01r 2  C9 20          cmp #' '
000C03r 2  D0 04          bne @Done
000C05r 2  E6 35          inc MON_IDX
000C07r 2  80 F3          bra MonSkipSpaces
000C09r 2               @Done:
000C09r 2  60             rts
000C0Ar 2               
000C0Ar 2               ; ============================================================================
000C0Ar 2               ; Decimal & Binary Parsing Utilities
000C0Ar 2               ; ============================================================================
000C0Ar 2               
000C0Ar 2               ; MonParseDec16 — Parse decimal digits from MON_LINBUF into MON_ADDR
000C0Ar 2               ; Input:  MON_IDX points to current position in MON_LINBUF
000C0Ar 2               ; Output: MON_ADDR = parsed 16-bit value, carry set if valid
000C0Ar 2               ;         MON_IDX advanced past parsed digits
000C0Ar 2               ; Modifies: A, X, Y, MON_ADDR, MON_TMP
000C0Ar 2               
000C0Ar 2               MonParseDec16:
000C0Ar 2  64 2E          stz MON_ADDR
000C0Cr 2  64 2F          stz MON_ADDR+1
000C0Er 2  A2 00          ldx #0                        ; Digit count
000C10r 2               @DecLoop:
000C10r 2  A4 35          ldy MON_IDX
000C12r 2  B9 00 04       lda MON_LINBUF,y
000C15r 2  C9 30          cmp #'0'
000C17r 2  90 3A          bcc @DecDone
000C19r 2  C9 3A          cmp #'9'+1
000C1Br 2  B0 36          bcs @DecDone
000C1Dr 2  38             sec
000C1Er 2  E9 30          sbc #'0'                      ; A = digit 0-9
000C20r 2  48             pha                           ; Save digit
000C21r 2                 ; MON_ADDR = MON_ADDR * 10 + digit
000C21r 2                 ; *10 = (*2 + *8): save *2, then *8, add
000C21r 2  06 2E          asl MON_ADDR
000C23r 2  26 2F          rol MON_ADDR+1
000C25r 2  A5 2E          lda MON_ADDR
000C27r 2  85 32          sta MON_TMP
000C29r 2  A5 2F          lda MON_ADDR+1
000C2Br 2  85 33          sta MON_TMP+1                 ; MON_TMP = *2
000C2Dr 2  06 2E          asl MON_ADDR
000C2Fr 2  26 2F          rol MON_ADDR+1                ; *4
000C31r 2  06 2E          asl MON_ADDR
000C33r 2  26 2F          rol MON_ADDR+1                ; *8
000C35r 2  18             clc
000C36r 2  A5 2E          lda MON_ADDR
000C38r 2  65 32          adc MON_TMP
000C3Ar 2  85 2E          sta MON_ADDR
000C3Cr 2  A5 2F          lda MON_ADDR+1
000C3Er 2  65 33          adc MON_TMP+1
000C40r 2  85 2F          sta MON_ADDR+1                ; *10
000C42r 2                 ; + digit
000C42r 2  68             pla
000C43r 2  18             clc
000C44r 2  65 2E          adc MON_ADDR
000C46r 2  85 2E          sta MON_ADDR
000C48r 2  90 02          bcc @DecNoCarry
000C4Ar 2  E6 2F          inc MON_ADDR+1
000C4Cr 2               @DecNoCarry:
000C4Cr 2  E6 35          inc MON_IDX
000C4Er 2  E8             inx
000C4Fr 2  E0 05          cpx #5                        ; Max 5 digits (65535)
000C51r 2  90 BD          bcc @DecLoop
000C53r 2               @DecDone:
000C53r 2  E0 00          cpx #0
000C55r 2  F0 02          beq @DecFail
000C57r 2  38             sec                           ; Success
000C58r 2  60             rts
000C59r 2               @DecFail:
000C59r 2  18             clc                           ; Failure
000C5Ar 2  60             rts
000C5Br 2               
000C5Br 2               ; MonParseBin16 — Parse binary digits from MON_LINBUF into MON_ADDR
000C5Br 2               ; Input:  MON_IDX points to current position in MON_LINBUF
000C5Br 2               ; Output: MON_ADDR = parsed 16-bit value, carry set if valid
000C5Br 2               ;         MON_IDX advanced past parsed digits
000C5Br 2               ; Modifies: A, X, Y, MON_ADDR
000C5Br 2               
000C5Br 2               MonParseBin16:
000C5Br 2  64 2E          stz MON_ADDR
000C5Dr 2  64 2F          stz MON_ADDR+1
000C5Fr 2  A2 00          ldx #0                        ; Digit count
000C61r 2               @BinLoop:
000C61r 2  A4 35          ldy MON_IDX
000C63r 2  B9 00 04       lda MON_LINBUF,y
000C66r 2  C9 30          cmp #'0'
000C68r 2  F0 06          beq @BinGot
000C6Ar 2  C9 31          cmp #'1'
000C6Cr 2  F0 02          beq @BinGot
000C6Er 2  80 0F          bra @BinDone
000C70r 2               @BinGot:
000C70r 2  38             sec
000C71r 2  E9 30          sbc #'0'                      ; A = 0 or 1
000C73r 2  4A             lsr a                         ; Bit into carry
000C74r 2  26 2E          rol MON_ADDR
000C76r 2  26 2F          rol MON_ADDR+1
000C78r 2  E6 35          inc MON_IDX
000C7Ar 2  E8             inx
000C7Br 2  E0 10          cpx #16                       ; Max 16 bits
000C7Dr 2  90 E2          bcc @BinLoop
000C7Fr 2               @BinDone:
000C7Fr 2  E0 00          cpx #0
000C81r 2  F0 02          beq @BinFail
000C83r 2  38             sec                           ; Success
000C84r 2  60             rts
000C85r 2               @BinFail:
000C85r 2  18             clc                           ; Failure
000C86r 2  60             rts
000C87r 2               
000C87r 2               ; ============================================================================
000C87r 2               ; Decimal & Binary Output Utilities
000C87r 2               ; ============================================================================
000C87r 2               
000C87r 2               ; MonPrintDec16 — Print MON_ADDR as up to 5 decimal digits
000C87r 2               ; Uses successive subtraction of powers of 10
000C87r 2               ; Modifies: A, X, Y, MON_TMP, MON_BYTE
000C87r 2               
000C87r 2               MonPrintDec16:
000C87r 2                 ; Copy value to MON_TMP so we don't destroy MON_ADDR
000C87r 2  A5 2E          lda MON_ADDR
000C89r 2  85 32          sta MON_TMP
000C8Br 2  A5 2F          lda MON_ADDR+1
000C8Dr 2  85 33          sta MON_TMP+1
000C8Fr 2  A2 00          ldx #0                        ; Leading zero suppression flag
000C91r 2  A0 00          ldy #0                        ; Power-of-10 index
000C93r 2               @Dec16Loop:
000C93r 2  A9 2F          lda #'0'-1
000C95r 2  85 34          sta MON_BYTE                  ; Digit scratch
000C97r 2               @Dec16Sub:
000C97r 2  E6 34          inc MON_BYTE
000C99r 2  A5 32          lda MON_TMP
000C9Br 2  38             sec
000C9Cr 2  F9 rr rr       sbc @Dec16Pow10Lo,y
000C9Fr 2  48             pha
000CA0r 2  A5 33          lda MON_TMP+1
000CA2r 2  F9 rr rr       sbc @Dec16Pow10Hi,y
000CA5r 2  90 07          bcc @Dec16Digit               ; Underflow — digit done
000CA7r 2  85 33          sta MON_TMP+1
000CA9r 2  68             pla
000CAAr 2  85 32          sta MON_TMP
000CACr 2  80 E9          bra @Dec16Sub
000CAEr 2               @Dec16Digit:
000CAEr 2  68             pla                           ; Discard underflowed low byte
000CAFr 2  A5 34          lda MON_BYTE
000CB1r 2  C9 30          cmp #'0'
000CB3r 2  D0 04          bne @Dec16Print               ; Non-zero → print
000CB5r 2  E0 00          cpx #0
000CB7r 2  F0 08          beq @Dec16Skip                ; Leading zero → skip
000CB9r 2               @Dec16Print:
000CB9r 2  DA             phx
000CBAr 2  5A             phy
000CBBr 2  20 rr rr       jsr Chrout
000CBEr 2  7A             ply
000CBFr 2  FA             plx
000CC0r 2  E8             inx                           ; Mark we've printed a digit
000CC1r 2               @Dec16Skip:
000CC1r 2  C8             iny
000CC2r 2  C0 04          cpy #4                        ; 4 powers: 10000, 1000, 100, 10
000CC4r 2  D0 CD          bne @Dec16Loop
000CC6r 2                 ; Always print ones digit
000CC6r 2  A5 32          lda MON_TMP
000CC8r 2  09 30          ora #'0'
000CCAr 2  20 rr rr       jsr Chrout
000CCDr 2  60             rts
000CCEr 2  10 E8 64 0A  @Dec16Pow10Lo: .byte <10000, <1000, <100, <10
000CD2r 2  27 03 00 00  @Dec16Pow10Hi: .byte >10000, >1000, >100, >10
000CD6r 2               
000CD6r 2               ; MonPrintBin16 — Print MON_ADDR as 16 binary digits (MSB first)
000CD6r 2               ; Modifies: A, X
000CD6r 2               
000CD6r 2               MonPrintBin16:
000CD6r 2  A5 2F          lda MON_ADDR+1                ; High byte first
000CD8r 2  20 rr rr       jsr @PrintBin8
000CDBr 2  A5 2E          lda MON_ADDR                  ; Then low byte
000CDDr 2               @PrintBin8:
000CDDr 2  A2 08          ldx #8
000CDFr 2               @BinBitLoop:
000CDFr 2  0A             asl a                         ; Shift MSB into carry
000CE0r 2  48             pha
000CE1r 2  A9 30          lda #'0'
000CE3r 2  69 00          adc #0                        ; +1 if carry → '1'
000CE5r 2  20 rr rr       jsr Chrout
000CE8r 2  68             pla
000CE9r 2  CA             dex
000CEAr 2  D0 F3          bne @BinBitLoop
000CECr 2  60             rts
000CEDr 2               
000CEDr 2               ; ============================================================================
000CEDr 2               ; Message Print Helpers (Phase 5)
000CEDr 2               ; ============================================================================
000CEDr 2               
000CEDr 2               ; MonPrintLoaded — Print "LOADED nnnn BYTES AT $xxxx"
000CEDr 2               ; Input: MON_ADDR = byte count, MON_END = load address
000CEDr 2               ; Modifies: A, X, Y, MON_TMP, MON_BYTE
000CEDr 2               
000CEDr 2               MonPrintLoaded:
000CEDr 2  A2 00          ldx #0
000CEFr 2               @PLoop1:
000CEFr 2  BD rr rr       lda MonStrLoadPfx,x
000CF2r 2  F0 06          beq @PDone1
000CF4r 2  20 rr rr       jsr Chrout
000CF7r 2  E8             inx
000CF8r 2  80 F5          bra @PLoop1
000CFAr 2               @PDone1:
000CFAr 2  20 rr rr       jsr MonPrintDec16             ; Print byte count from MON_ADDR
000CFDr 2  A2 00          ldx #0
000CFFr 2               @PLoop2:
000CFFr 2  BD rr rr       lda MonStrBytesAt,x
000D02r 2  F0 06          beq @PDone2
000D04r 2  20 rr rr       jsr Chrout
000D07r 2  E8             inx
000D08r 2  80 F5          bra @PLoop2
000D0Ar 2               @PDone2:
000D0Ar 2                 ; Print address from MON_END
000D0Ar 2  A5 30          lda MON_END
000D0Cr 2  85 2E          sta MON_ADDR
000D0Er 2  A5 31          lda MON_END+1
000D10r 2  85 2F          sta MON_ADDR+1
000D12r 2  20 rr rr       jsr MonPrintHex4
000D15r 2  4C rr rr       jmp MonPrintCRLF
000D18r 2               
000D18r 2               ; MonPrintSaved — Print "SAVED nnnn BYTES"
000D18r 2               ; Input: MON_ADDR = byte count
000D18r 2               ; Modifies: A, X, Y, MON_TMP, MON_BYTE
000D18r 2               
000D18r 2               MonPrintSaved:
000D18r 2  A2 00          ldx #0
000D1Ar 2               @SLoop1:
000D1Ar 2  BD rr rr       lda MonStrSavePfx,x
000D1Dr 2  F0 06          beq @SDone1
000D1Fr 2  20 rr rr       jsr Chrout
000D22r 2  E8             inx
000D23r 2  80 F5          bra @SLoop1
000D25r 2               @SDone1:
000D25r 2  20 rr rr       jsr MonPrintDec16             ; Print byte count from MON_ADDR
000D28r 2  A2 00          ldx #0
000D2Ar 2               @SLoop2:
000D2Ar 2  BD rr rr       lda MonStrBytes,x
000D2Dr 2  F0 06          beq @SDone2
000D2Fr 2  20 rr rr       jsr Chrout
000D32r 2  E8             inx
000D33r 2  80 F5          bra @SLoop2
000D35r 2               @SDone2:
000D35r 2  4C rr rr       jmp MonPrintCRLF
000D38r 2               
000D38r 2               ; MonPrintIOErr — Print "I/O ERROR"
000D38r 2               ; Modifies: A, X
000D38r 2               
000D38r 2               MonPrintIOErr:
000D38r 2  A2 00          ldx #0
000D3Ar 2               @ELoop:
000D3Ar 2  BD rr rr       lda MonStrIOErr,x
000D3Dr 2  F0 06          beq @EDone
000D3Fr 2  20 rr rr       jsr Chrout
000D42r 2  E8             inx
000D43r 2  80 F5          bra @ELoop
000D45r 2               @EDone:
000D45r 2  4C rr rr       jmp MonPrintCRLF
000D48r 2               
000D48r 2               ; ============================================================================
000D48r 2               ; Hex Output Utilities
000D48r 2               ; ============================================================================
000D48r 2               
000D48r 2               ; MonPrintHex2 — Print A as two hex digits
000D48r 2               ; Input:  A = byte to print
000D48r 2               ; Modifies: A, flags
000D48r 2               
000D48r 2               MonPrintHex2:
000D48r 2  48             pha                           ; Save original byte
000D49r 2  4A             lsr                           ; Shift high nibble down
000D4Ar 2  4A             lsr
000D4Br 2  4A             lsr
000D4Cr 2  4A             lsr
000D4Dr 2  20 rr rr       jsr @PrintNibble              ; Print high nibble
000D50r 2  68             pla                           ; Restore original byte
000D51r 2  29 0F          and #$0F                      ; Isolate low nibble
000D53r 2               @PrintNibble:
000D53r 2  C9 0A          cmp #10
000D55r 2  90 06          bcc @IsDigit
000D57r 2  18             clc
000D58r 2  69 37          adc #('A' - 10)
000D5Ar 2  4C rr rr       jmp Chrout
000D5Dr 2               @IsDigit:
000D5Dr 2  18             clc
000D5Er 2  69 30          adc #'0'
000D60r 2  4C rr rr       jmp Chrout
000D63r 2               
000D63r 2               ; MonPrintHex4 — Print MON_ADDR as four hex digits
000D63r 2               ; Input:  MON_ADDR, MON_ADDR+1 = 16-bit value
000D63r 2               ; Modifies: A, flags
000D63r 2               
000D63r 2               MonPrintHex4:
000D63r 2  A5 2F          lda MON_ADDR + 1              ; High byte first
000D65r 2  20 rr rr       jsr MonPrintHex2
000D68r 2  A5 2E          lda MON_ADDR                  ; Then low byte
000D6Ar 2  4C rr rr       jmp MonPrintHex2
000D6Dr 2               
000D6Dr 2               ; MonPrintSpace — Print a space character
000D6Dr 2               
000D6Dr 2               MonPrintSpace:
000D6Dr 2  A9 20          lda #' '
000D6Fr 2  4C rr rr       jmp Chrout
000D72r 2               
000D72r 2               ; MonPrintCRLF — Print carriage return + line feed
000D72r 2               
000D72r 2               MonPrintCRLF:
000D72r 2  A9 0D          lda #$0D
000D74r 2  20 rr rr       jsr Chrout
000D77r 2  A9 0A          lda #$0A
000D79r 2  4C rr rr       jmp Chrout
000D7Cr 2               
000D7Cr 2               ; MonPrintError — Print "?" for unrecognized command
000D7Cr 2               
000D7Cr 2               MonPrintError:
000D7Cr 2  A9 3F          lda #'?'
000D7Er 2  20 rr rr       jsr Chrout
000D81r 2  4C rr rr       jmp MonPrintCRLF
000D84r 2               
000D84r 2               ; MonPrintBanner — Print the monitor banner string
000D84r 2               
000D84r 2               MonPrintBanner:
000D84r 2  A2 00          ldx #0
000D86r 2               @Loop:
000D86r 2  BD rr rr       lda MonStrBanner,x
000D89r 2  F0 06          beq @Done
000D8Br 2  20 rr rr       jsr Chrout
000D8Er 2  E8             inx
000D8Fr 2  80 F5          bra @Loop
000D91r 2               @Done:
000D91r 2  60             rts
