0016D6r 2               ; ---------------------------------------------------------------------------
0016D6r 2               ; BasCmdClr -- implement CLR (clear vars/arrays/strings without erasing program).
0016D6r 2               ;   VARTAB := PRGEND (already correct in our model)
0016D6r 2               ;   ARYTAB := STREND := VARTAB
0016D6r 2               ;   FRETOP := MEMSIZ
0016D6r 2               ;   TEMPPT := TEMPST, DATAPTR := TXTTAB-1, stacks emptied
0016D6r 2               ; ---------------------------------------------------------------------------
0016D6r 2               BasCmdClr:
0016D6r 2                       ; ARYTAB = STREND = VARTAB
0016D6r 2  AD 5F 03             lda     VARTAB
0016D9r 2  8D 61 03             sta     ARYTAB
0016DCr 2  8D 63 03             sta     STREND
0016DFr 2  AD 60 03             lda     VARTAB+1
0016E2r 2  8D 62 03             sta     ARYTAB+1
0016E5r 2  8D 64 03             sta     STREND+1
0016E8r 2                       ; FRETOP = MEMSIZ
0016E8r 2  AD 67 03             lda     MEMSIZ
0016EBr 2  8D 65 03             sta     FRETOP
0016EEr 2  AD 68 03             lda     MEMSIZ+1
0016F1r 2  8D 66 03             sta     FRETOP+1
0016F4r 2                       ; Reset temp string descriptor stack.
0016F4r 2  A9 6E                lda     #BAS_TEMPST
0016F6r 2  85 6B                sta     TEMPPT
