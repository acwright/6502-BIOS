001773r 2               ; ---------------------------------------------------------------------------
001773r 2               ; BasCmdClr -- implement CLR (clear vars/arrays/strings without erasing program).
001773r 2               ;   VARTAB := PRGEND (already correct in our model)
001773r 2               ;   ARYTAB := STREND := VARTAB
001773r 2               ;   FRETOP := MEMSIZ
001773r 2               ;   TEMPPT := TEMPST, DATAPTR := TXTTAB-1, stacks emptied
001773r 2               ; ---------------------------------------------------------------------------
001773r 2               BasCmdClr:
001773r 2                       ; Reset the CPU stack, msbasic's STKINI: any FOR or GOSUB frame a
001773r 2                       ; suspended program left there is being abandoned along with its
001773r 2                       ; variables, and RUN starting on top of one would let a later NEXT find
001773r 2                       ; a loop from the previous run.  The return address rides across the
001773r 2                       ; reset so this is still an ordinary subroutine to its callers.
001773r 2  68                   pla                             ; return address low
001774r 2  A8                   tay
001775r 2  68                   pla                             ; return address high
001776r 2  A2 FF                ldx     #$FF
001778r 2  9A                   txs
001779r 2  8E 75 03             stx     BAS_STKBASE
00177Cr 2  48                   pha
00177Dr 2  98                   tya
00177Er 2  48                   pha
00177Fr 2                       ; ARYTAB = STREND = VARTAB
00177Fr 2  AD 5F 03             lda     VARTAB
001782r 2  8D 61 03             sta     ARYTAB
001785r 2  8D 63 03             sta     STREND
001788r 2  AD 60 03             lda     VARTAB+1
00178Br 2  8D 62 03             sta     ARYTAB+1
00178Er 2  8D 64 03             sta     STREND+1
001791r 2                       ; FRETOP = MEMSIZ
001791r 2  AD 67 03             lda     MEMSIZ
001794r 2  8D 65 03             sta     FRETOP
001797r 2  AD 68 03             lda     MEMSIZ+1
00179Ar 2  8D 66 03             sta     FRETOP+1
00179Dr 2                       ; Reset temp string descriptor stack.
00179Dr 2  A9 6E                lda     #BAS_TEMPST
00179Fr 2  85 6B                sta     TEMPPT
0017A1r 2  64 6C                stz     LASTPT
0017A3r 2  64 6D                stz     LASTPT+1
0017A5r 2                       ; CONT state, DATA pointer, pending key.
0017A5r 2                       ; DATAPTR := TXTTAB - 1 so first READ does FindData and lands on
0017A5r 2                       ; the first DATA item.
0017A5r 2  38                   sec
0017A6r 2  AD 5D 03             lda     TXTTAB
0017A9r 2  E9 01                sbc     #1
0017ABr 2  8D 1A 03             sta     BAS_DATAPTR
0017AEr 2  AD 5E 03             lda     TXTTAB+1
0017B1r 2  E9 00                sbc     #0
0017B3r 2  8D 1B 03             sta     BAS_DATAPTR+1
0017B6r 2  9C 6B 03             stz     BAS_OLDLIN
0017B9r 2  9C 6C 03             stz     BAS_OLDLIN+1
0017BCr 2  9C 6D 03             stz     BAS_OLDTEXT
0017BFr 2  9C 6E 03             stz     BAS_OLDTEXT+1
0017C2r 2  9C 1C 03             stz     BAS_STOPLINE
0017C5r 2  9C 1D 03             stz     BAS_STOPLINE+1
0017C8r 2  9C 1E 03             stz     BAS_STOPTXT
0017CBr 2  9C 1F 03             stz     BAS_STOPTXT+1
0017CEr 2  9C 0E 03             stz     BAS_PENDKEY
0017D1r 2  64 63                stz     DIMFLG
0017D3r 2  64 68                stz     SUBFLG
0017D5r 2  64 64                stz     VALTYP
0017D7r 2  64 65                stz     VALTYP+1
0017D9r 2  64 67                stz     DATAFLG
0017DBr 2  60                   rts
