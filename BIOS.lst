00173Er 2  9C 6C 03             stz     BAS_OLDLIN+1
001741r 2  9C 6D 03             stz     BAS_OLDTEXT
001744r 2  9C 6E 03             stz     BAS_OLDTEXT+1
001747r 2  9C 1C 03             stz     BAS_STOPLINE
00174Ar 2  9C 1D 03             stz     BAS_STOPLINE+1
00174Dr 2  9C 1E 03             stz     BAS_STOPTXT
001750r 2  9C 1F 03             stz     BAS_STOPTXT+1
001753r 2  9C 0E 03             stz     BAS_PENDKEY
001756r 2  64 63                stz     DIMFLG
001758r 2  64 68                stz     SUBFLG
00175Ar 2  64 64                stz     VALTYP
00175Cr 2  64 65                stz     VALTYP+1
00175Er 2  64 67                stz     DATAFLG
001760r 2  60                   rts
001761r 2               
001761r 2               .if 0
001761r 2               ; (Removed in Phase 8: _VARTEST debug harness lived here.)
001761r 2               VT_SetTxt:
001761r 2                       ; Set TXTPTR = VT_TXTPTR_TMP - 1 then ChrGet to load first char.
001761r 2                       ; Actually simpler: caller passes (Y,A) = pointer; we set TXTPTR =
001761r 2                       ; (Y,A) - 1 and call ChrGet to land on (Y,A).
001761r 2                       sta     TXTPTR
001761r 2                       sty     TXTPTR+1
001761r 2                       lda     TXTPTR
001761r 2                       bne     @nb
001761r 2                       dec     TXTPTR+1
001761r 2               @nb:
001761r 2                       dec     TXTPTR
001761r 2                       jmp     ChrGet
001761r 2               
001761r 2               VT_StoreFAC:
001761r 2                       ; Round and store FAC at (VARPNT).
001761r 2                       ldx     VARPNT
001761r 2                       ldy     VARPNT+1
001761r 2                       jmp     StoreFacAtYxRounded
001761r 2               
001761r 2               VT_LoadFAC:
001761r 2                       ; Load FAC from (VARPNT).
001761r 2                       lda     VARPNT
001761r 2                       ldy     VARPNT+1
001761r 2                       jmp     LoadFacFromYa
001761r 2               
001761r 2               VT_VPSAVE       = $86           ; 2-byte ZP VARPNT save (_VARTEST debug)
001761r 2               
001761r 2               BasCmdVarTest:
001761r 2                       jsr     BasCmdClr
001761r 2               
001761r 2                       ; --- Test 1: A=3.14, B=A*2 ---
001761r 2                       lda     #<VT_NameA
001761r 2                       ldy     #>VT_NameA
001761r 2                       jsr     VT_SetTxt
001761r 2                       jsr     PtrGet                  ; creates A; VARPNT -> A's value
001761r 2                       ; FAC = 3.14
001761r 2                       lda     #<VT_pi
001761r 2                       ldy     #>VT_pi
001761r 2                       jsr     LoadFacFromYa
001761r 2                       jsr     VT_StoreFAC
001761r 2               
001761r 2                       lda     #<VT_NameB
001761r 2                       ldy     #>VT_NameB
001761r 2                       jsr     VT_SetTxt
001761r 2                       jsr     PtrGet                  ; creates B
001761r 2                       ; Save B's VARPNT.
001761r 2                       lda     VARPNT
001761r 2                       sta     VT_VPSAVE
001761r 2                       lda     VARPNT+1
001761r 2                       sta     VT_VPSAVE+1
001761r 2               
001761r 2                       ; Look up A again (already exists).
001761r 2                       lda     #<VT_NameA
001761r 2                       ldy     #>VT_NameA
001761r 2                       jsr     VT_SetTxt
001761r 2                       jsr     PtrGet
001761r 2                       jsr     VT_LoadFAC              ; FAC = A = 3.14
001761r 2                       ; Multiply by 2.
001761r 2                       lda     #<FpC2
001761r 2                       ldy     #>FpC2
001761r 2                       jsr     FMult                   ; FAC = 2 * FAC = 6.28
001761r 2                       ; Store into B.
001761r 2                       ldx     VT_VPSAVE
001761r 2                       ldy     VT_VPSAVE+1
001761r 2                       jsr     StoreFacAtYxRounded
001761r 2               
001761r 2                       ; Print result.
001761r 2                       lda     #<MsgVT_A
001761r 2                       ldy     #>MsgVT_A
001761r 2                       jsr     BasPrintStr
001761r 2                       ; Reload B and print.
001761r 2                       lda     VT_VPSAVE
001761r 2                       ldy     VT_VPSAVE+1
001761r 2                       jsr     LoadFacFromYa
001761r 2                       jsr     BasPrintFAC
001761r 2                       jsr     BasPrintCRLF
001761r 2               
001761r 2                       ; --- Test 2: A$="HELLO" ---
001761r 2                       lda     #<VT_NameAS
001761r 2                       ldy     #>VT_NameAS
001761r 2                       jsr     VT_SetTxt
001761r 2                       jsr     PtrGet                  ; creates A$
001761r 2                       ; Save VARPNT (A$ descriptor address).
001761r 2                       lda     VARPNT
001761r 2                       sta     VT_VPSAVE
001761r 2                       lda     VARPNT+1
001761r 2                       sta     VT_VPSAVE+1
001761r 2                       ; Allocate space, copy "HELLO" via StrLit.
001761r 2                       lda     #<VT_HelloLit
001761r 2                       ldy     #>VT_HelloLit
001761r 2                       jsr     StrLit                  ; FAC has descriptor, in temp stack
001761r 2                       ; Now copy descriptor (3 bytes from temp stack entry) to A$ var.
001761r 2                       ; FAC+3,4 points at the temp descriptor; FAC = length, FAC+1/2 = addr.
001761r 2                       ; The descriptor lives in TEMPST.  We just write [len][lo][hi] into
001761r 2                       ; (VARPNT) so the variable now references the heap copy.
001761r 2                       lda     FAC
001761r 2                       ldy     #$00
001761r 2                       sta     (VT_VPSAVE),y           ; length
001761r 2                       lda     FAC+1
001761r 2                       iny
001761r 2                       sta     (VT_VPSAVE),y           ; addr lo
001761r 2                       lda     FAC+2
001761r 2                       iny
001761r 2                       sta     (VT_VPSAVE),y           ; addr hi
001761r 2                       ; Print length.
001761r 2                       lda     #<MsgVT_AS
001761r 2                       ldy     #>MsgVT_AS
001761r 2                       jsr     BasPrintStr
001761r 2                       ldy     #$00
001761r 2                       lda     (VT_VPSAVE),y
001761r 2                       tay
001761r 2                       jsr     SngFlt
001761r 2                       jsr     BasPrintFAC
001761r 2                       jsr     BasPrintCRLF
001761r 2               
001761r 2                       ; --- Test 3: DIM N(10), N(5)=42 ---
001761r 2                       ; Build TXTPTR pointing at "N(10) " and call MakInt-equivalent path.
001761r 2                       ; Easier: directly construct array via PtrGet3 + Array by simulating
001761r 2                       ; a 1-D DIM of size 11 (indices 0..10).  We emulate the parser:
001761r 2                       ;   1. Set DIMFLG = $40, VARNAM = ('N','N'), call PtrGet3 with X=1?
001761r 2                       ;   2. Or: just do PtrGet3 entry by hand then jmp Array.
001761r 2                       ; Simplest: set TXTPTR at "N(10) ", DIMFLG <- $40 (from DIM
001761r 2                       ; statement), then PtrGet3 with VARNAM letter, jmp to '(' branch.
001761r 2                       lda     #<VT_DimN10
001761r 2                       ldy     #>VT_DimN10
001761r 2                       jsr     VT_SetTxt               ; A = 'N'
001761r 2                       ldx     #$40                    ; from-DIM flag (bit 6)
001761r 2                       jsr     PtrGet2                 ; will hit '(' -> Array -> create
001761r 2                       ; Now N(5)=42.  Re-parse "N(5)" to find element.
001761r 2                       lda     #<VT_DimN5
001761r 2                       ldy     #>VT_DimN5
001761r 2                       jsr     VT_SetTxt
001761r 2                       jsr     PtrGet                  ; element address in VARPNT
001761r 2                       ; Save VARPNT.
001761r 2                       lda     VARPNT
001761r 2                       sta     VT_VPSAVE
001761r 2                       lda     VARPNT+1
001761r 2                       sta     VT_VPSAVE+1
001761r 2                       ; FAC = 42.
001761r 2                       lda     #<Vt42
001761r 2                       ldy     #>Vt42
001761r 2                       jsr     LoadFacFromYa
001761r 2                       ldx     VT_VPSAVE
001761r 2                       ldy     VT_VPSAVE+1
001761r 2                       jsr     StoreFacAtYxRounded
001761r 2                       ; Read it back and print.
001761r 2                       lda     #<MsgVT_NewArr
001761r 2                       ldy     #>MsgVT_NewArr
001761r 2                       jsr     BasPrintStr
001761r 2                       lda     VT_VPSAVE
001761r 2                       ldy     VT_VPSAVE+1
001761r 2                       jsr     LoadFacFromYa
001761r 2                       jsr     BasPrintFAC
001761r 2                       jsr     BasPrintCRLF
001761r 2               
001761r 2                       ; --- Test 4: 8 string allocations + GC ---
001761r 2                       ldx     #8
001761r 2               @galloc:
001761r 2                       phx
001761r 2                       lda     #16
001761r 2                       jsr     StrSpa                  ; consumes 16 bytes; FAC has descriptor
001761r 2                       plx
001761r 2                       dex
001761r 2                       bne     @galloc
001761r 2                       ; Force GC (TEMPPT got bumped by StrSpa-via-StrIni? StrSpa itself
001761r 2                       ; doesn't call PutNew, so temp stack untouched here.)
001761r 2                       jsr     Garbag
001761r 2                       lda     #<MsgVT_GC
001761r 2                       ldy     #>MsgVT_GC
001761r 2                       jsr     BasPrintStr
001761r 2                       lda     FRETOP+1
001761r 2                       ldy     FRETOP
001761r 2                       jsr     GivAyf
001761r 2                       jsr     BasPrintFAC
001761r 2                       jsr     BasPrintCRLF
001761r 2               
001761r 2                       rts
001761r 2               .endif
001761r 2               
001761r 2               ; =============================================================================
001761r 2               ;   E X P R E S S I O N   E V A L U A T O R
001761r 2               ;
001761r 2               ;   Recursive-descent precedence climber.  Operates on tokenized text at
001761r 2               ;   TXTPTR (advanced via ChrGet/ChrGot).  Result lands in FAC (numeric)
001761r 2               ;   or as a 3-byte string descriptor at FAC..FAC+2 (string).  VALTYP
001761r 2               ;   selects: $00 = numeric, $FF = string.
001761r 2               ;
001761r 2               ;   Precedence (lowest -> highest):
001761r 2               ;     OR
001761r 2               ;     AND
001761r 2               ;     NOT  (right-assoc unary)
001761r 2               ;     comparison (= <> < > <= >=)
001761r 2               ;     + -
001761r 2               ;     * /
001761r 2               ;     ^    (right-assoc)
001761r 2               ;     unary -, unary +
001761r 2               ;     atom: number, variable, string-literal, "(" expr ")", function call
001761r 2               ; =============================================================================
001761r 2               
001761r 2               ; ---------------------------------------------------------------------------
001761r 2               ; ZP scratch used only during expression evaluation.
001761r 2               ;   BAS_LVTYP = saved VALTYP of left operand around binary ops
001761r 2               ; ---------------------------------------------------------------------------
001761r 2               BAS_LVTYP       := $86
001761r 2               
001761r 2               ; ---------------------------------------------------------------------------
001761r 2               ; FrmEvl -- top-level entry.  TXTPTR positioned so ChrGot returns the first
001761r 2               ; byte of the expression.  On exit TXTPTR is at the first byte AFTER the
001761r 2               ; expression.  Result in FAC + VALTYP.
001761r 2               ; ---------------------------------------------------------------------------
001761r 2               FrmEvl:
001761r 2  4C rr rr             jmp     EvalOr
001764r 2               
001764r 2               ; ---------------------------------------------------------------------------
001764r 2               ; PushFac -- push the current FAC + VALTYP onto the CPU stack (8 bytes).
001764r 2               ; Order pushed: VALTYP, FAC, FAC+1, FAC+2, FAC+3, FAC+4, FACSIGN, FACEXTENSION
001764r 2               ; (FACEXTENSION pushed last so it's pulled first by PullArg.)
001764r 2               ; Preserves the return address.
001764r 2               ; ---------------------------------------------------------------------------
001764r 2               PushFac:
001764r 2  68                   pla
001765r 2  A8                   tay                             ; Y = ret-addr lo
001766r 2  68                   pla
001767r 2  AA                   tax                             ; X = ret-addr hi
001768r 2  A5 64                lda     VALTYP
00176Ar 2  48                   pha
00176Br 2  A5 0E                lda     FAC
00176Dr 2  48                   pha
00176Er 2  A5 0F                lda     FAC+1
001770r 2  48                   pha
001771r 2  A5 10                lda     FAC+2
001773r 2  48                   pha
001774r 2  A5 11                lda     FAC+3
001776r 2  48                   pha
001777r 2  A5 12                lda     FAC+4
001779r 2  48                   pha
00177Ar 2  A5 13                lda     FACSIGN
00177Cr 2  48                   pha
00177Dr 2  A5 1D                lda     FACEXTENSION
00177Fr 2  48                   pha
001780r 2  8A                   txa
001781r 2  48                   pha
001782r 2  98                   tya
001783r 2  48                   pha
001784r 2  60                   rts
001785r 2               
001785r 2               ; ---------------------------------------------------------------------------
001785r 2               ; PullArg -- pop the previously-pushed FAC into ARG (signed FP value or
001785r 2               ; string descriptor in ARG..ARG+2/sign).  Sets BAS_LVTYP to the saved
001785r 2               ; left-operand VALTYP.  Preserves return address.
001785r 2               ; ---------------------------------------------------------------------------
001785r 2               PullArg:
001785r 2  68                   pla
001786r 2  A8                   tay                             ; Y = ret-addr lo
001787r 2  68                   pla
001788r 2  AA                   tax                             ; X = ret-addr hi
001789r 2  68                   pla
00178Ar 2  85 43                sta     ARGEXTENSION
00178Cr 2  68                   pla
00178Dr 2  85 1B                sta     ARGSIGN
00178Fr 2  68                   pla
001790r 2  85 1A                sta     ARG+4
001792r 2  68                   pla
001793r 2  85 19                sta     ARG+3
001795r 2  68                   pla
001796r 2  85 18                sta     ARG+2
001798r 2  68                   pla
001799r 2  85 17                sta     ARG+1
00179Br 2  68                   pla
00179Cr 2  85 16                sta     ARG
00179Er 2  68                   pla
00179Fr 2  85 86                sta     BAS_LVTYP
0017A1r 2  8A                   txa
0017A2r 2  48                   pha
0017A3r 2  98                   tya
0017A4r 2  48                   pha
0017A5r 2  60                   rts
0017A6r 2               
0017A6r 2               ; ---------------------------------------------------------------------------
0017A6r 2               ; PullFac -- pop pushed FAC back into FAC (used to discard right side and
0017A6r 2               ; restore left, e.g. unused).
0017A6r 2               ; ---------------------------------------------------------------------------
0017A6r 2               PullFac:
0017A6r 2  68                   pla
0017A7r 2  A8                   tay
0017A8r 2  68                   pla
0017A9r 2  AA                   tax
0017AAr 2  68                   pla
0017ABr 2  85 1D                sta     FACEXTENSION
0017ADr 2  68                   pla
0017AEr 2  85 13                sta     FACSIGN
0017B0r 2  68                   pla
0017B1r 2  85 12                sta     FAC+4
0017B3r 2  68                   pla
0017B4r 2  85 11                sta     FAC+3
0017B6r 2  68                   pla
0017B7r 2  85 10                sta     FAC+2
0017B9r 2  68                   pla
0017BAr 2  85 0F                sta     FAC+1
0017BCr 2  68                   pla
0017BDr 2  85 0E                sta     FAC
0017BFr 2  68                   pla
0017C0r 2  85 64                sta     VALTYP
0017C2r 2  8A                   txa
0017C3r 2  48                   pha
0017C4r 2  98                   tya
0017C5r 2  48                   pha
0017C6r 2  60                   rts
0017C7r 2               
0017C7r 2               ; ---------------------------------------------------------------------------
0017C7r 2               ; TypeMismatch helper.
0017C7r 2               ; ---------------------------------------------------------------------------
0017C7r 2               EvalTypeErr:
0017C7r 2  A2 08                ldx     #ERR_TYPEMISM
0017C9r 2  4C rr rr             jmp     BasErrorVec
0017CCr 2               
0017CCr 2               ; ===========================================================================
0017CCr 2               ;   L E V E L 0  --  O R
0017CCr 2               ; ===========================================================================
0017CCr 2               EvalOr:
0017CCr 2  20 rr rr             jsr     EvalAnd
0017CFr 2               @loop:
0017CFr 2  20 rr rr             jsr     ChrGot
0017D2r 2  C9 A3                cmp     #TOK_OR
0017D4r 2  D0 17                bne     @done
0017D6r 2  20 rr rr             jsr     ChkNum                  ; left must be numeric
0017D9r 2  20 rr rr             jsr     ChrGet                  ; consume OR
0017DCr 2  20 rr rr             jsr     PushFac
0017DFr 2  20 rr rr             jsr     EvalAnd
0017E2r 2  20 rr rr             jsr     ChkNum                  ; right must be numeric
0017E5r 2  20 rr rr             jsr     PullArg
0017E8r 2  20 rr rr             jsr     OrOp
0017EBr 2  80 E2                bra     @loop
0017EDr 2               @done:
0017EDr 2  60                   rts
0017EEr 2               
0017EEr 2               ; ===========================================================================
0017EEr 2               ;   L E V E L 1  --  A N D
0017EEr 2               ; ===========================================================================
0017EEr 2               EvalAnd:
0017EEr 2  20 rr rr             jsr     EvalNot
0017F1r 2               @loop:
0017F1r 2  20 rr rr             jsr     ChrGot
0017F4r 2  C9 A2                cmp     #TOK_AND
0017F6r 2  D0 17                bne     @done
0017F8r 2  20 rr rr             jsr     ChkNum
0017FBr 2  20 rr rr             jsr     ChrGet
0017FEr 2  20 rr rr             jsr     PushFac
001801r 2  20 rr rr             jsr     EvalNot
001804r 2  20 rr rr             jsr     ChkNum
001807r 2  20 rr rr             jsr     PullArg
00180Ar 2  20 rr rr             jsr     AndOp
00180Dr 2  80 E2                bra     @loop
00180Fr 2               @done:
00180Fr 2  60                   rts
001810r 2               
001810r 2               ; ===========================================================================
001810r 2               ;   L E V E L 2  --  N O T   (right-assoc unary prefix)
001810r 2               ; ===========================================================================
001810r 2               EvalNot:
001810r 2  20 rr rr             jsr     ChrGot
001813r 2  C9 A0                cmp     #TOK_NOT
001815r 2  D0 0C                bne     EvalCmp
001817r 2  20 rr rr             jsr     ChrGet
00181Ar 2  20 rr rr             jsr     EvalNot
00181Dr 2  20 rr rr             jsr     ChkNum
001820r 2  4C rr rr             jmp     NotOp
001823r 2               
001823r 2               ; ===========================================================================
001823r 2               ;   L E V E L 3  --  C O M P A R I S O N
001823r 2               ;   Reads up to two of {<, =, >} forming a relop; if none, no-op.
001823r 2               ;   Mask:  bit 0 = '>' present, bit 1 = '=' present, bit 2 = '<' present
001823r 2               ; ===========================================================================
001823r 2               EvalCmp:
001823r 2  20 rr rr             jsr     EvalAdd
001826r 2  A2 00                ldx     #0                      ; relop mask
001828r 2               @scan:
001828r 2  20 rr rr             jsr     ChrGot
00182Br 2  C9 3D                cmp     #'='
00182Dr 2  F0 0A                beq     @gotEq
00182Fr 2  C9 3C                cmp     #'<'
001831r 2  F0 0A                beq     @gotLt
001833r 2  C9 3E                cmp     #'>'
001835r 2  F0 0A                beq     @gotGt
001837r 2  80 1D                bra     @done
001839r 2               @gotEq:
001839r 2  A0 02                ldy     #2
00183Br 2  80 06                bra     @setbit
00183Dr 2               @gotLt:
00183Dr 2  A0 04                ldy     #4
00183Fr 2  80 02                bra     @setbit
001841r 2               @gotGt:
001841r 2  A0 01                ldy     #1
001843r 2               @setbit:
001843r 2  84 45                sty     CPRMASK                 ; reuse as scratch
001845r 2  8A                   txa
001846r 2  25 45                and     CPRMASK
001848r 2  D0 09                bne     @synErr                 ; same char twice (e.g. "==")
00184Ar 2  8A                   txa
00184Br 2  05 45                ora     CPRMASK
00184Dr 2  AA                   tax
00184Er 2  20 rr rr             jsr     ChrGet
001851r 2  80 D5                bra     @scan
001853r 2               @synErr:
001853r 2  4C rr rr             jmp     SynErr
001856r 2               @done:
001856r 2  E0 00                cpx     #0
001858r 2  D0 01                bne     @doCmp
00185Ar 2  60                   rts
00185Br 2               @doCmp:
00185Br 2  86 45                stx     CPRMASK
00185Dr 2                       ; Save left operand, evaluate right
00185Dr 2  20 rr rr             jsr     PushFac
001860r 2  20 rr rr             jsr     EvalAdd
001863r 2  20 rr rr             jsr     PullArg                 ; ARG = left, BAS_LVTYP = left's type
001866r 2                       ; Type compatibility check.
001866r 2  A5 86                lda     BAS_LVTYP
001868r 2  45 64                eor     VALTYP
00186Ar 2  10 03 4C rr          jmi     EvalTypeErr             ; one numeric, one string -> mismatch
00186Er 2  rr           
00186Fr 2  24 64                bit     VALTYP
001871r 2  30 03                bmi     @strCmp
001873r 2                       ; Numeric comparison.
001873r 2  4C rr rr             jmp     RelOpsNum
001876r 2               @strCmp:
001876r 2  4C rr rr             jmp     RelOpsStr
001879r 2               
001879r 2               ; ---------------------------------------------------------------------------
001879r 2               ; RelOpsNum -- numeric comparison.
001879r 2               ; Inputs: ARG = left, FAC = right, CPRMASK = relop mask (bit 0=>, 1==, 2=<).
001879r 2               ; Output: FAC = -1 if (ARG <op> FAC) is true, else 0.  VALTYP = numeric.
001879r 2               ; ---------------------------------------------------------------------------
001879r 2               RelOpsNum:
001879r 2                       ; Replicate msbasic ARG-pre-relop fixup: clear ARG+1 high bit, then
001879r 2                       ; set it from ARGSIGN's MSB.  This rebuilds the implicit-1 mantissa
001879r 2                       ; for FCOMP's signed comparison path.
001879r 2  A5 1B                lda     ARGSIGN
00187Br 2  09 7F                ora     #$7F
00187Dr 2  25 17                and     ARG+1
00187Fr 2  85 17                sta     ARG+1
001881r 2  A9 16                lda     #<ARG
001883r 2  A0 00                ldy     #$00
001885r 2  20 rr rr             jsr     FComp                   ; A = sign(FAC - ARG)
001888r 2                       ; Map A to bit position:
001888r 2                       ;   FAC<ARG (A=$FF): ARG>FAC  -> bit 0 (mask 1)
001888r 2                       ;   FAC=ARG (A=$00):           -> bit 1 (mask 2)
001888r 2                       ;   FAC>ARG (A=$01): ARG<FAC  -> bit 2 (mask 4)
001888r 2  AA                   tax
001889r 2  30 06                bmi     @lt
00188Br 2  F0 08                beq     @eq
00188Dr 2  A9 04                lda     #4
00188Fr 2  80 06                bra     @check
001891r 2               @lt:
001891r 2  A9 01                lda     #1
001893r 2  80 02                bra     @check
001895r 2               @eq:
001895r 2  A9 02                lda     #2
001897r 2               @check:
001897r 2  25 45                and     CPRMASK
001899r 2  F0 07                beq     @false
00189Br 2  A9 FF                lda     #$FF
00189Dr 2  A0 FF                ldy     #$FF
00189Fr 2  4C rr rr             jmp     GivAyf
0018A2r 2               @false:
0018A2r 2  A9 00                lda     #0
0018A4r 2  A8                   tay
0018A5r 2  4C rr rr             jmp     GivAyf
0018A8r 2               
0018A8r 2               ; ---------------------------------------------------------------------------
0018A8r 2               ; RelOpsStr -- bytewise string comparison.
0018A8r 2               ; ARG = left descriptor (ARG=len, ARG+1=lo, ARG+2=hi, ARGSIGN, ARGEXT pushed).
0018A8r 2               ; FAC = right descriptor.  CPRMASK as above.
0018A8r 2               ; ---------------------------------------------------------------------------
0018A8r 2               RelOpsStr:
0018A8r 2                       ; INDEX = left ptr, BAS_TMP1 = right ptr, BAS_TMP2 lo = left len,
0018A8r 2                       ; BAS_TMP2 hi = right len.
0018A8r 2  A5 17                lda     ARG+1
0018AAr 2  85 20                sta     INDEX
0018ACr 2  A5 18                lda     ARG+2
0018AEr 2  85 21                sta     INDEX+1
0018B0r 2  A5 0F                lda     FAC+1
0018B2r 2  85 3A                sta     BAS_TMP1
0018B4r 2  A5 10                lda     FAC+2
0018B6r 2  85 3B                sta     BAS_TMP1+1
0018B8r 2  A5 16                lda     ARG
0018BAr 2  85 3C                sta     BAS_TMP2                ; left len
0018BCr 2  A5 0E                lda     FAC
0018BEr 2  85 3D                sta     BAS_TMP2+1              ; right len
0018C0r 2                       ; Compare byte-by-byte up to min length.
0018C0r 2  A0 00                ldy     #0
0018C2r 2               @cmp:
0018C2r 2                       ; Has either side ended?
0018C2r 2  C4 3C                cpy     BAS_TMP2
0018C4r 2  F0 17                beq     @leftEnd
0018C6r 2  C4 3D                cpy     BAS_TMP2+1
0018C8r 2  F0 1B                beq     @rightEnd               ; right ended first -> left > right
0018CAr 2  B1 20                lda     (INDEX),y
0018CCr 2  D1 3A                cmp     (BAS_TMP1),y
0018CEr 2  F0 0A                beq     @next
0018D0r 2  90 04                bcc     @lt                     ; left < right
0018D2r 2                       ; left > right
0018D2r 2  A9 01                lda     #1
0018D4r 2  80 15                bra     @decide
0018D6r 2               @lt:
0018D6r 2  A9 04                lda     #4
0018D8r 2  80 11                bra     @decide
0018DAr 2               @next:
0018DAr 2  C8                   iny
0018DBr 2  80 E5                bra     @cmp
0018DDr 2               @leftEnd:
0018DDr 2                       ; Left ran out; check right
0018DDr 2  C4 3D                cpy     BAS_TMP2+1
0018DFr 2  F0 08                beq     @equal
0018E1r 2                       ; left < right (left is prefix)
0018E1r 2  A9 04                lda     #4
0018E3r 2  80 06                bra     @decide
0018E5r 2               @rightEnd:
0018E5r 2                       ; right ran out, left has more; left > right
0018E5r 2  A9 01                lda     #1
0018E7r 2  80 02                bra     @decide
0018E9r 2               @equal:
0018E9r 2  A9 02                lda     #2
0018EBr 2               @decide:
0018EBr 2  25 45                and     CPRMASK
0018EDr 2  F0 05                beq     @false
0018EFr 2  A9 FF                lda     #$FF
0018F1r 2  A8                   tay
0018F2r 2  80 03                bra     @ret
0018F4r 2               @false:
0018F4r 2  A9 00                lda     #0
0018F6r 2  A8                   tay
0018F7r 2               @ret:
0018F7r 2                       ; Free temp strings before returning.  Save A,Y first.
0018F7r 2  48                   pha
0018F8r 2  5A                   phy
0018F9r 2                       ; Free FAC's temp string (right operand).
0018F9r 2  24 64                bit     VALTYP
0018FBr 2  10 03                bpl     @noFreeR
0018FDr 2  20 rr rr             jsr     FreFac
001900r 2               @noFreeR:
001900r 2                       ; Free ARG's temp string (left operand): manually restore VALTYP=$FF
001900r 2                       ; and FAC := ARG, then FreFac.  (We don't always know if ARG is a
001900r 2                       ; temp; FreTms inside FreTmp checks.)
001900r 2  A5 16                lda     ARG
001902r 2  85 0E                sta     FAC
001904r 2  A5 17                lda     ARG+1
001906r 2  85 0F                sta     FAC+1
001908r 2  A5 18                lda     ARG+2
00190Ar 2  85 10                sta     FAC+2
00190Cr 2                       ; +3/+4 are the descriptor's own address, which is what FreFac frees
00190Cr 2                       ; by -- copying only the len/lo/hi above left FreFac looking at the
00190Cr 2                       ; right operand's slot, already popped, so it never matched LASTPT and
00190Cr 2                       ; the left temp was never reclaimed.  PushFac/PullArg carry these two
00190Cr 2                       ; bytes through for exactly this.  One leaked slot per comparison, and
00190Cr 2                       ; the third string compare in a program hit ?FORMULA TOO COMPLEX.
00190Cr 2  A5 19                lda     ARG+3
00190Er 2  85 11                sta     FAC+3
001910r 2  A5 1A                lda     ARG+4
001912r 2  85 12                sta     FAC+4
001914r 2  A9 FF                lda     #$FF
001916r 2  85 64                sta     VALTYP
001918r 2  20 rr rr             jsr     FreFac
00191Br 2  7A                   ply
00191Cr 2  68                   pla
00191Dr 2  4C rr rr             jmp     GivAyf
001920r 2               
001920r 2               ; ===========================================================================
001920r 2               ;   L E V E L 4  --  + / -
001920r 2               ; ===========================================================================
001920r 2               EvalAdd:
001920r 2  20 rr rr             jsr     EvalMul
001923r 2               @loop:
001923r 2  20 rr rr             jsr     ChrGot
001926r 2  C9 2B                cmp     #'+'
001928r 2  F0 05                beq     @plus
00192Ar 2  C9 2D                cmp     #'-'
00192Cr 2  F0 27                beq     @minus
00192Er 2  60                   rts
00192Fr 2               @plus:
00192Fr 2  20 rr rr             jsr     ChrGet
001932r 2  20 rr rr             jsr     PushFac
001935r 2  20 rr rr             jsr     EvalMul
001938r 2  20 rr rr             jsr     PullArg
00193Br 2                       ; Type dispatch.
00193Br 2  A5 86                lda     BAS_LVTYP
00193Dr 2  45 64                eor     VALTYP
00193Fr 2  10 03 4C rr          jmi     EvalTypeErr
001943r 2  rr           
001944r 2  24 64                bit     VALTYP
001946r 2  30 28                bmi     @cat
001948r 2                       ; numeric add: FAC = ARG + FAC
001948r 2                       ; FAddT expects: ARG is the operand, A=FAC's exponent on entry.
001948r 2                       ; Use entry "FAddT" preceded by sign work: msbasic does
001948r 2                       ;   bne <continue>; jmp CopyArgToFac
001948r 2                       ; But our FAddT entry already handles that.  We need to set
001948r 2                       ; SGNCPR = ARGSIGN ^ FACSIGN before FAddT.
001948r 2  A5 1B                lda     ARGSIGN
00194Ar 2  45 13                eor     FACSIGN
00194Cr 2  85 1C                sta     SGNCPR
00194Er 2  A5 0E                lda     FAC
001950r 2  20 rr rr             jsr     FAddT
001953r 2  80 CE                bra     @loop
001955r 2               @minus:
001955r 2  20 rr rr             jsr     ChrGet
001958r 2  20 rr rr             jsr     PushFac
00195Br 2  20 rr rr             jsr     EvalMul
00195Er 2  20 rr rr             jsr     ChkNum
001961r 2                       ; left was pushed; check pushed type via TOS-byte? Easier: we already
001961r 2                       ; verified left is numeric on first iteration.  But left might have
001961r 2                       ; been a string from concatenation; require numeric here:
001961r 2  20 rr rr             jsr     PullArg
001964r 2  A5 86                lda     BAS_LVTYP
001966r 2  10 03 4C rr          jmi     EvalTypeErr
00196Ar 2  rr           
00196Br 2                       ; FAC = ARG - FAC
00196Br 2                       ; FSubT does: FACSIGN ^= $FF; SGNCPR = FACSIGN^ARGSIGN; jmp FAddT
00196Br 2                       ; We need to call FSubT directly.
00196Br 2  20 rr rr             jsr     FSubT
00196Er 2  80 B3                bra     @loop
001970r 2               @cat:
001970r 2  20 rr rr             jsr     CatStr
001973r 2  80 AE                bra     @loop
001975r 2               
001975r 2               ; ---------------------------------------------------------------------------
001975r 2               ; CatStr -- concatenate ARG (left) + FAC (right), result in FAC.
001975r 2               ; ---------------------------------------------------------------------------
001975r 2               CatStr:
001975r 2                       ; Stash right's length+addr before we overwrite FAC.
001975r 2  A5 0E                lda     FAC
001977r 2  85 4D                sta     BAS_TEMP1               ; right len
001979r 2  A5 0F                lda     FAC+1
00197Br 2  85 4E                sta     BAS_TEMP1+1
00197Dr 2  A5 10                lda     FAC+2
00197Fr 2  85 4F                sta     BAS_TEMP1+2
001981r 2                       ; Total length = ARG + FAC; abort if > 255.
001981r 2  18                   clc
001982r 2  A5 16                lda     ARG
001984r 2  65 4D                adc     BAS_TEMP1
001986r 2  B0 40                bcs     @tooLong
001988r 2  85 50                sta     BAS_TEMP1+3             ; total length
00198Ar 2                       ; Free both source temps before allocating result -- otherwise we
00198Ar 2                       ; pile up to 3 temps and the next PutNew throws ?FRMCPX.
00198Ar 2  20 rr rr             jsr     FreeBothTemps
00198Dr 2                       ; Allocate.
00198Dr 2  A5 50                lda     BAS_TEMP1+3             ; total length
00198Fr 2  20 rr rr             jsr     GetSpa                  ; A=total, FRESPC=buf
001992r 2                       ; Copy left bytes (ARG -> FRESPC).
001992r 2  A5 17                lda     ARG+1
001994r 2  85 20                sta     INDEX
001996r 2  A5 18                lda     ARG+2
001998r 2  85 21                sta     INDEX+1
00199Ar 2  A5 16                lda     ARG
00199Cr 2  F0 03                beq     @right
00199Er 2  20 rr rr             jsr     MovStr1                 ; advances FRESPC by len
0019A1r 2               @right:
0019A1r 2                       ; Copy right bytes.
0019A1r 2  A5 4E                lda     BAS_TEMP1+1
0019A3r 2  85 20                sta     INDEX
0019A5r 2  A5 4F                lda     BAS_TEMP1+2
0019A7r 2  85 21                sta     INDEX+1
0019A9r 2  A5 4D                lda     BAS_TEMP1
0019ABr 2  F0 03                beq     @desc
0019ADr 2  20 rr rr             jsr     MovStr1
0019B0r 2               @desc:
0019B0r 2                       ; Descriptor: FAC := total len, FAC+1/2 := FRESPC - total.
0019B0r 2  A5 50                lda     BAS_TEMP1+3
0019B2r 2  85 0E                sta     FAC
0019B4r 2  38                   sec
0019B5r 2  A5 84                lda     FRESPC
0019B7r 2  E5 50                sbc     BAS_TEMP1+3
0019B9r 2  85 0F                sta     FAC+1
0019BBr 2  A5 85                lda     FRESPC+1
0019BDr 2  E9 00                sbc     #0
0019BFr 2  85 10                sta     FAC+2
0019C1r 2  A9 FF                lda     #$FF
0019C3r 2  85 64                sta     VALTYP
0019C5r 2  4C rr rr             jmp     PutNew
0019C8r 2               @tooLong:
0019C8r 2  A2 09                ldx     #ERR_STRLONG
0019CAr 2  4C rr rr             jmp     BasErrorVec
0019CDr 2               
0019CDr 2               ; ===========================================================================
0019CDr 2               ;   L E V E L 5  --  * / /
0019CDr 2               ; ===========================================================================
0019CDr 2               EvalMul:
0019CDr 2  20 rr rr             jsr     EvalPow
0019D0r 2               @loop:
0019D0r 2  20 rr rr             jsr     ChrGot
0019D3r 2  C9 2A                cmp     #'*'
0019D5r 2  F0 05                beq     @mul
0019D7r 2  C9 2F                cmp     #'/'
0019D9r 2  F0 27                beq     @div
0019DBr 2  60                   rts
0019DCr 2               @mul:
0019DCr 2  20 rr rr             jsr     ChkNum
0019DFr 2  20 rr rr             jsr     ChrGet
0019E2r 2  20 rr rr             jsr     PushFac
0019E5r 2  20 rr rr             jsr     EvalPow
0019E8r 2  20 rr rr             jsr     ChkNum
0019EBr 2  20 rr rr             jsr     PullArg
0019EEr 2  A5 86                lda     BAS_LVTYP
0019F0r 2  10 03 4C rr          jmi     EvalTypeErr
0019F4r 2  rr           
0019F5r 2                       ; FAC = ARG * FAC: FMultT expects ARG + sign work.  See msbasic.
0019F5r 2  A5 1B                lda     ARGSIGN
0019F7r 2  45 13                eor     FACSIGN
0019F9r 2  85 1C                sta     SGNCPR
0019FBr 2  A5 0E                lda     FAC
0019FDr 2  20 rr rr             jsr     FMultT
001A00r 2  80 CE                bra     @loop
001A02r 2               @div:
001A02r 2  20 rr rr             jsr     ChkNum
001A05r 2  20 rr rr             jsr     ChrGet
001A08r 2  20 rr rr             jsr     PushFac
001A0Br 2  20 rr rr             jsr     EvalPow
001A0Er 2  20 rr rr             jsr     ChkNum
001A11r 2  20 rr rr             jsr     PullArg
001A14r 2  A5 86                lda     BAS_LVTYP
001A16r 2  10 03 4C rr          jmi     EvalTypeErr
001A1Ar 2  rr           
001A1Br 2                       ; FAC = ARG / FAC: FDivT.
001A1Br 2  A5 1B                lda     ARGSIGN
001A1Dr 2  45 13                eor     FACSIGN
001A1Fr 2  85 1C                sta     SGNCPR
001A21r 2  A5 0E                lda     FAC
001A23r 2  20 rr rr             jsr     FDivT
001A26r 2  80 A8                bra     @loop
001A28r 2               
001A28r 2               ; ===========================================================================
001A28r 2               ;   L E V E L 6  --  ^   (right-associative)
001A28r 2               ; ===========================================================================
001A28r 2               EvalPow:
001A28r 2  20 rr rr             jsr     EvalUnary
001A2Br 2               @loop:
001A2Br 2  20 rr rr             jsr     ChrGot
001A2Er 2  C9 5E                cmp     #'^'
001A30r 2  D0 20                bne     @done
001A32r 2  20 rr rr             jsr     ChkNum
001A35r 2  20 rr rr             jsr     ChrGet
001A38r 2  20 rr rr             jsr     PushFac
001A3Br 2                       ; Right-associative, which means the right-hand side is evaluated at
001A3Br 2                       ; this level rather than the one below: recursing into EvalPow lets
001A3Br 2                       ; the RHS take the rest of the chain, so 2^3^2 is 2^(3^2) = 512.
001A3Br 2                       ; Calling EvalUnary here instead made it (2^3)^2 = 64 -- left-assoc,
001A3Br 2                       ; contradicting this level's own heading.  EvalUnary still runs first
001A3Br 2                       ; inside the recursion, so a term is always consumed and the recursion
001A3Br 2                       ; is bounded by the length of the chain.
001A3Br 2  20 rr rr             jsr     EvalPow
001A3Er 2  20 rr rr             jsr     ChkNum
001A41r 2  20 rr rr             jsr     PullArg
001A44r 2  A5 86                lda     BAS_LVTYP
001A46r 2  10 03 4C rr          jmi     EvalTypeErr
001A4Ar 2  rr           
001A4Br 2                       ; FPwrt computes ARG ^ FAC.  Our ported FPwrt expects ARG = base,
001A4Br 2                       ; FAC = exponent, and A = FAC's exponent byte (FPwrt's first
001A4Br 2                       ; instruction is `beq Exp` to short-circuit FAC==0 -> 1).
001A4Br 2  A5 0E                lda     FAC
001A4Dr 2  20 rr rr             jsr     FPwrt
001A50r 2  80 D9                bra     @loop
001A52r 2               @done:
001A52r 2  60                   rts
001A53r 2               
001A53r 2               ; ===========================================================================
001A53r 2               ;   L E V E L 7  --  U N A R Y
001A53r 2               ; ===========================================================================
001A53r 2               EvalUnary:
001A53r 2  20 rr rr             jsr     ChrGot
001A56r 2  C9 2D                cmp     #'-'
001A58r 2  F0 07                beq     @neg
001A5Ar 2  C9 2B                cmp     #'+'
001A5Cr 2  F0 13                beq     @pos
001A5Er 2  4C rr rr             jmp     EvalAtom
001A61r 2               @neg:
001A61r 2  20 rr rr             jsr     ChrGet
001A64r 2                       ; Evaluate the operand at the power level, not this one: the README
001A64r 2                       ; puts `^` above unary `-`, so -2^2 is -(2^2) = -4.  Recursing into
001A64r 2                       ; EvalUnary here bound the minus to the atom first and gave (-2)^2 = 4.
001A64r 2                       ; The '-' is consumed above, so a term is always taken before this
001A64r 2                       ; recurses and the depth is bounded by the run of signs.
001A64r 2  20 rr rr             jsr     EvalPow
001A67r 2  20 rr rr             jsr     ChkNum
001A6Ar 2                       ; Negate FAC: flip FACSIGN bit 7.
001A6Ar 2  A5 13                lda     FACSIGN
001A6Cr 2  49 FF                eor     #$FF
001A6Er 2  85 13                sta     FACSIGN
001A70r 2  60                   rts
001A71r 2               @pos:
001A71r 2  20 rr rr             jsr     ChrGet
001A74r 2  4C rr rr             jmp     EvalUnary
001A77r 2               
001A77r 2               ; ===========================================================================
001A77r 2               ;   L E V E L 8  --  A T O M
001A77r 2               ; ===========================================================================
001A77r 2               EvalAtom:
001A77r 2  64 64                stz     VALTYP                  ; default to numeric; string paths override
001A79r 2  20 rr rr             jsr     ChrGot
001A7Cr 2  90 2E                bcc     @num                    ; digit
001A7Er 2  C9 2E                cmp     #'.'
001A80r 2  F0 2A                beq     @num
001A82r 2  C9 22                cmp     #'"'
001A84r 2  F0 29                beq     @str
001A86r 2  C9 28                cmp     #'('
001A88r 2  F0 3D                beq     @paren
001A8Ar 2                       ; Letter? -> variable
001A8Ar 2  20 rr rr             jsr     IsLetC
001A8Dr 2  B0 41                bcs     @var
001A8Fr 2                       ; Function token?
001A8Fr 2  C9 CD                cmp     #TOK_INKEY
001A91r 2  F0 64                beq     FnInkey
001A93r 2  C9 9D                cmp     #TOK_FN
001A95r 2  F0 12                beq     @fnCall                 ; FN A(...) — user-defined function
001A97r 2                       ; Hex literal in PRINT context: not here (no '$' literal supported).
001A97r 2                       ; NVRAM is dual-role (statement at $B1, function via FnTable);
001A97r 2                       ; allow it through even though it sits below TOK_SGN.
001A97r 2  C9 B1                cmp     #TOK_NVRAM
001A99r 2  F0 08                beq     @fnDisp
001A9Br 2                       ; Try function dispatch.
001A9Br 2  C9 B6                cmp     #TOK_SGN
001A9Dr 2  90 07                bcc     @synErr
001A9Fr 2  C9 D1                cmp     #TOK_MAX+1
001AA1r 2  B0 03                bcs     @synErr
001AA3r 2               @fnDisp:
001AA3r 2  4C rr rr             jmp     FnDispatch
001AA6r 2               @synErr:
001AA6r 2  4C rr rr             jmp     SynErr
001AA9r 2               @fnCall:
001AA9r 2  4C rr rr             jmp     FnCall
001AACr 2               @num:
001AACr 2                       ; ASCII numeric: jump to Fin.  Fin uses ChrGet to consume.
001AACr 2  4C rr rr             jmp     Fin
001AAFr 2               @str:
001AAFr 2                       ; '"' string literal.  Advance past the opening quote WITHOUT ChrGet:
001AAFr 2                       ; ChrGet skips spaces, which would strip leading spaces inside the
001AAFr 2                       ; string literal (e.g. PRINT "   X").  Bump TXTPTR by one byte instead.
001AAFr 2  E6 04                inc     TXTPTR
001AB1r 2  D0 02                bne     @strsrc
001AB3r 2  E6 05                inc     TXTPTR+1
001AB5r 2               @strsrc:
001AB5r 2                       ; StrLit expects (Y,A) = src.  Source = TXTPTR.
001AB5r 2  A5 04                lda     TXTPTR
001AB7r 2  A4 05                ldy     TXTPTR+1
001AB9r 2  20 rr rr             jsr     StrLit
001ABCr 2                       ; StrLit advances internal pointer; we need to update TXTPTR.
001ABCr 2                       ; StrLit reads until $00 or '"' from (STRNG1)+y; FAC has length.
001ABCr 2                       ; Compute new TXTPTR = STRNG2 (which StrLit set), or TXTPTR + len + maybe-quote.
001ABCr 2                       ; STRNG2 = STRNG1 + len + (1 if hit quote else 0).  Use STRNG2.
001ABCr 2  A5 1E                lda     STRNG2
001ABEr 2  85 04                sta     TXTPTR
001AC0r 2  A5 1F                lda     STRNG2+1
001AC2r 2  85 05                sta     TXTPTR+1
001AC4r 2                       ; If we stopped at a closing quote, TXTPTR is past it (StrLit's
001AC4r 2                       ; @endquote path: tya/adc STRNG1 with carry set since cmp set C);
001AC4r 2                       ; if we ran into NUL, TXTPTR sits on the NUL (clc path).  Either
001AC4r 2                       ; is correct for ChrGot.
001AC4r 2  4C rr rr             jmp     ChrGot                  ; preload next char (for caller chains)
001AC7r 2               @paren:
001AC7r 2  20 rr rr             jsr     ChrGet                  ; consume '('
001ACAr 2  20 rr rr             jsr     FrmEvl
001ACDr 2  4C rr rr             jmp     ChkCls                  ; expects ')'; consumes via ChrGet
001AD0r 2               @var:
001AD0r 2                       ; Variable lookup.  PtrGet uses CHRGET internally and leaves
001AD0r 2                       ; (A,Y) = VARPNT.  VALTYP is set to $00 or $FF.
001AD0r 2  20 rr rr             jsr     PtrGet
001AD3r 2                       ; Fetch value into FAC.
001AD3r 2  24 64                bit     VALTYP
001AD5r 2  30 07                bmi     @loadStr
001AD7r 2                       ; numeric: FAC = (VARPNT)
001AD7r 2  A5 3F                lda     VARPNT
001AD9r 2  A4 40                ldy     VARPNT+1
001ADBr 2  4C rr rr             jmp     LoadFacFromYa
001ADEr 2               @loadStr:
001ADEr 2                       ; string: copy descriptor [len][lo][hi] into FAC..FAC+2.
001ADEr 2  A0 00                ldy     #0
001AE0r 2  B1 3F                lda     (VARPNT),y
001AE2r 2  85 0E                sta     FAC
001AE4r 2  C8                   iny
001AE5r 2  B1 3F                lda     (VARPNT),y
001AE7r 2  85 0F                sta     FAC+1
001AE9r 2  C8                   iny
001AEAr 2  B1 3F                lda     (VARPNT),y
001AECr 2  85 10                sta     FAC+2
001AEEr 2                       ; Record the descriptor's address (= VARPNT) in FAC+3/FAC+4 so the
001AEEr 2                       ; temp-free logic (FreFac/FreTms) can tell this is a variable, not a
001AEEr 2                       ; temp: VARPNT's high byte is nonzero (vars live at $08xx) so it can
001AEEr 2                       ; never match a temp-stack slot (all in zero page) and will not be
001AEEr 2                       ; freed or reclaimed.  Without this, a stale FAC+3/FAC+4 can spuriously
001AEEr 2                       ; match LASTPT and free/reclaim a live string.
001AEEr 2  A5 3F                lda     VARPNT
001AF0r 2  85 11                sta     FAC+3
001AF2r 2  A5 40                lda     VARPNT+1
001AF4r 2  85 12                sta     FAC+4
001AF6r 2  60                   rts
001AF7r 2               
001AF7r 2               ; ---------------------------------------------------------------------------
001AF7r 2               ; FnInkey -- INKEY (no parens).  Reads BAS_PENDKEY first; else BufferSize/
001AF7r 2               ; ReadBuffer; else 0.  Result is unsigned 8-bit FP value.
001AF7r 2               ; ---------------------------------------------------------------------------
001AF7r 2               FnInkey:
001AF7r 2  20 rr rr             jsr     ChrGet                  ; consume INKEY token
001AFAr 2  AD 0E 03             lda     BAS_PENDKEY
001AFDr 2  F0 09                beq     @noPend
001AFFr 2                       ; consume pending key.
001AFFr 2  A0 00                ldy     #0
001B01r 2  8C 0E 03             sty     BAS_PENDKEY
001B04r 2  A8                   tay
001B05r 2  4C rr rr             jmp     SngFlt
001B08r 2               @noPend:
001B08r 2  20 rr rr             jsr     BufferSize
001B0Br 2  F0 07                beq     @zero
001B0Dr 2  20 rr rr             jsr     ReadBuffer
001B10r 2  A8                   tay
001B11r 2  4C rr rr             jmp     SngFlt
001B14r 2               @zero:
001B14r 2  A0 00                ldy     #0
001B16r 2  4C rr rr             jmp     SngFlt
001B19r 2               
001B19r 2               ; ---------------------------------------------------------------------------
001B19r 2               ; FnDispatch -- A holds a function token in [TOK_SGN..TOK_MAX].  Dispatch
001B19r 2               ; via FnTable, which pairs (token, handler-1).
001B19r 2               ; ---------------------------------------------------------------------------
001B19r 2               FnDispatch:
001B19r 2  A2 00                ldx     #0
001B1Br 2               @find:
001B1Br 2  BD rr rr             lda     FnTable,x
001B1Er 2  F0 14                beq     @synErr                 ; reached terminator
001B20r 2  D2 04                cmp     (TXTPTR)
001B22r 2  F0 05                beq     @match
001B24r 2  E8                   inx
001B25r 2  E8                   inx
001B26r 2  E8                   inx
001B27r 2  80 F2                bra     @find
001B29r 2               @match:
001B29r 2                       ; Push handler-1 onto stack so RTS jumps to it after ChrGet.
001B29r 2  BD rr rr             lda     FnTable+2,x
001B2Cr 2  48                   pha
001B2Dr 2  BD rr rr             lda     FnTable+1,x
001B30r 2  48                   pha
001B31r 2  4C rr rr             jmp     ChrGet                  ; consume token, return into handler
001B34r 2               @synErr:
001B34r 2  4C rr rr             jmp     SynErr
001B37r 2               
001B37r 2               ; ---------------------------------------------------------------------------
001B37r 2               ; FnTable -- (token, handler-1) triples, $00-terminated.
001B37r 2               ; "handler-1" because we push it through RTS which adds 1.
001B37r 2               ; ---------------------------------------------------------------------------
001B37r 2               FnTable:
001B37r 2  B6                   .byte   TOK_SGN
001B38r 2  rr rr                .word   FnSgn-1
001B3Ar 2  B7                   .byte   TOK_INT
001B3Br 2  rr rr                .word   FnInt-1
001B3Dr 2  B8                   .byte   TOK_ABS
001B3Er 2  rr rr                .word   FnAbs-1
001B40r 2  B9                   .byte   TOK_FRE
001B41r 2  rr rr                .word   FnFre-1
001B43r 2  BA                   .byte   TOK_POS
001B44r 2  rr rr                .word   FnPos-1
001B46r 2  BB                   .byte   TOK_SQR
001B47r 2  rr rr                .word   FnSqr-1
001B49r 2  BC                   .byte   TOK_RND
001B4Ar 2  rr rr                .word   FnRnd-1
001B4Cr 2  BD                   .byte   TOK_LOG
001B4Dr 2  rr rr                .word   FnLog-1
001B4Fr 2  BE                   .byte   TOK_EXP
001B50r 2  rr rr                .word   FnExp-1
001B52r 2  BF                   .byte   TOK_COS
001B53r 2  rr rr                .word   FnCos-1
001B55r 2  C0                   .byte   TOK_SIN
001B56r 2  rr rr                .word   FnSin-1
001B58r 2  C1                   .byte   TOK_TAN
001B59r 2  rr rr                .word   FnTan-1
001B5Br 2  C2                   .byte   TOK_ATN
001B5Cr 2  rr rr                .word   FnAtn-1
001B5Er 2  C3                   .byte   TOK_PEEK
001B5Fr 2  rr rr                .word   FnPeek-1
001B61r 2  C4                   .byte   TOK_LEN
001B62r 2  rr rr                .word   FnLen-1
001B64r 2  C5                   .byte   TOK_STRSTR
001B65r 2  rr rr                .word   FnStrStr-1
001B67r 2  C6                   .byte   TOK_VAL
001B68r 2  rr rr                .word   FnVal-1
001B6Ar 2  C7                   .byte   TOK_ASC
001B6Br 2  rr rr                .word   FnAsc-1
001B6Dr 2  C8                   .byte   TOK_CHRSTR
001B6Er 2  rr rr                .word   FnChrStr-1
001B70r 2  C9                   .byte   TOK_LEFTSTR
001B71r 2  rr rr                .word   FnLeftStr-1
001B73r 2  CA                   .byte   TOK_RIGHTSTR
001B74r 2  rr rr                .word   FnRightStr-1
001B76r 2  CB                   .byte   TOK_MIDSTR
001B77r 2  rr rr                .word   FnMidStr-1
001B79r 2  CC                   .byte   TOK_JOY
001B7Ar 2  rr rr                .word   FnJoy-1
001B7Cr 2  B1                   .byte   TOK_NVRAM
001B7Dr 2  rr rr                .word   FnNvram-1
001B7Fr 2  CE                   .byte   TOK_HEX
001B80r 2  rr rr                .word   FnHex-1
001B82r 2  CF                   .byte   TOK_MIN
001B83r 2  rr rr                .word   FnMin-1
001B85r 2  D0                   .byte   TOK_MAX
001B86r 2  rr rr                .word   FnMax-1
001B88r 2  00                   .byte   0
001B89r 2               
001B89r 2               ; ---------------------------------------------------------------------------
001B89r 2               ; Numeric-arg helpers.
001B89r 2               ; ParenNum    -- expects "(" expr ")" with numeric result.  FAC = result.
001B89r 2               ; ParenStr    -- expects "(" expr ")" with string result.
001B89r 2               ; ParenU8     -- expects "(" expr ")" -> A = byte (0..255), or ?ILLQTY.
001B89r 2               ; ParenU16    -- expects "(" expr ")" -> AyInt result in FAC+3,+4.
001B89r 2               ; ---------------------------------------------------------------------------
001B89r 2               ParenNum:
001B89r 2  20 rr rr             jsr     ChkOpn
001B8Cr 2  20 rr rr             jsr     FrmEvl
001B8Fr 2  20 rr rr             jsr     ChkNum
001B92r 2  4C rr rr             jmp     ChkCls
001B95r 2               ParenStr:
001B95r 2  20 rr rr             jsr     ChkOpn
001B98r 2  20 rr rr             jsr     FrmEvl
001B9Br 2  20 rr rr             jsr     ChkStr
001B9Er 2  4C rr rr             jmp     ChkCls
001BA1r 2               ParenU8:
001BA1r 2  20 rr rr             jsr     ParenNum
001BA4r 2  20 rr rr             jsr     AyInt
001BA7r 2  A5 11                lda     FAC+3                   ; high byte must be 0
001BA9r 2  D0 03                bne     @bad
001BABr 2  A5 12                lda     FAC+4                   ; low byte = result
001BADr 2  60                   rts
001BAEr 2               @bad:
001BAEr 2  4C rr rr             jmp     IqErr
001BB1r 2               
001BB1r 2               ; ---------------------------------------------------------------------------
001BB1r 2               ; Unary numeric functions (single-arg "(" num ")") -- shared body.
001BB1r 2               ; Each entry sets up A = handler entry to call after ChkOpn/FrmEvl/ChkNum/ChkCls.
001BB1r 2               ; ---------------------------------------------------------------------------
001BB1r 2               FnSgn:
001BB1r 2  20 rr rr             jsr     ParenNum
001BB4r 2  4C rr rr             jmp     Sgn
001BB7r 2               FnInt:
001BB7r 2  20 rr rr             jsr     ParenNum
001BBAr 2  4C rr rr             jmp     Int
001BBDr 2               FnAbs:
001BBDr 2  20 rr rr             jsr     ParenNum
001BC0r 2  4C rr rr             jmp     Abs
001BC3r 2               FnSqr:
001BC3r 2  20 rr rr             jsr     ParenNum
001BC6r 2  4C rr rr             jmp     Sqr
001BC9r 2               FnLog:
001BC9r 2  20 rr rr             jsr     ParenNum
001BCCr 2  4C rr rr             jmp     Log
001BCFr 2               FnExp:
001BCFr 2  20 rr rr             jsr     ParenNum
001BD2r 2  4C rr rr             jmp     Exp
001BD5r 2               FnCos:
001BD5r 2  20 rr rr             jsr     ParenNum
001BD8r 2  4C rr rr             jmp     Cos
001BDBr 2               FnSin:
001BDBr 2  20 rr rr             jsr     ParenNum
001BDEr 2  4C rr rr             jmp     Sin
001BE1r 2               FnTan:
001BE1r 2  20 rr rr             jsr     ParenNum
001BE4r 2  4C rr rr             jmp     Tan
001BE7r 2               FnAtn:
001BE7r 2  20 rr rr             jsr     ParenNum
001BEAr 2  4C rr rr             jmp     Atn
001BEDr 2               FnRnd:
001BEDr 2  20 rr rr             jsr     ParenNum
001BF0r 2  4C rr rr             jmp     Rnd
001BF3r 2               FnHex:
001BF3r 2                       ; In expression context: identity.
001BF3r 2  4C rr rr             jmp     ParenNum
001BF6r 2               
001BF6r 2               ; ---------------------------------------------------------------------------
001BF6r 2               ; FnFre -- FRE(n): returns FRETOP - STREND (free string heap).
001BF6r 2               ; Argument is parsed and ignored.
001BF6r 2               ; ---------------------------------------------------------------------------
001BF6r 2               FnFre:
001BF6r 2  20 rr rr             jsr     ParenNum
001BF9r 2  38                   sec
001BFAr 2  AD 65 03             lda     FRETOP
001BFDr 2  ED 63 03             sbc     STREND
001C00r 2  A8                   tay
001C01r 2  AD 66 03             lda     FRETOP+1
001C04r 2  ED 64 03             sbc     STREND+1
001C07r 2  4C rr rr             jmp     GivAyf
001C0Ar 2               
001C0Ar 2               ; ---------------------------------------------------------------------------
001C0Ar 2               ; FnPos -- POS(n): current print column.  Argument is parsed and ignored.
001C0Ar 2               ; ---------------------------------------------------------------------------
001C0Ar 2               FnPos:
001C0Ar 2  20 rr rr             jsr     ParenNum
001C0Dr 2                       ; BAS_POSX is the live column PrintCh maintains and TAB and the comma
001C0Dr 2                       ; zones already read.  This returned a hardcoded 0 -- the column was
001C0Dr 2                       ; being tracked all along, POS just never looked at it.
001C0Dr 2  AC 70 03             ldy     BAS_POSX
001C10r 2  4C rr rr             jmp     SngFlt
001C13r 2               
001C13r 2               ; ---------------------------------------------------------------------------
001C13r 2               ; FnPeek -- PEEK(addr): byte at addr -> FP.
001C13r 2               ; ---------------------------------------------------------------------------
001C13r 2               FnPeek:
001C13r 2  20 rr rr             jsr     ParenNum
001C16r 2  20 rr rr             jsr     FacToU16
001C19r 2  A5 12                lda     FAC+4                   ; lo byte
001C1Br 2  85 20                sta     INDEX
001C1Dr 2  A5 11                lda     FAC+3                   ; hi byte
001C1Fr 2  85 21                sta     INDEX+1
001C21r 2  A0 00                ldy     #0
001C23r 2  B1 20                lda     (INDEX),y
001C25r 2  A8                   tay
001C26r 2  4C rr rr             jmp     SngFlt
001C29r 2               
001C29r 2               ; ---------------------------------------------------------------------------
001C29r 2               ; FnJoy -- JOY(n): 1 or 2.  If GPIO absent, returns 0.
001C29r 2               ; ---------------------------------------------------------------------------
001C29r 2               FnJoy:
001C29r 2  20 rr rr             jsr     ParenU8
001C2Cr 2  48                   pha
001C2Dr 2  AD 0D 03             lda     HW_PRESENT
001C30r 2  29 20                and     #HW_GPIO
001C32r 2  F0 1C                beq     @absent
001C34r 2  68                   pla
001C35r 2  C9 01                cmp     #1
001C37r 2  F0 09                beq     @j1
001C39r 2  C9 02                cmp     #2
001C3Br 2  F0 0C                beq     @j2
001C3Dr 2  A2 0B                ldx     #ERR_ILLQUAN
001C3Fr 2  4C rr rr             jmp     BasErrorVec
001C42r 2               @j1:
001C42r 2  20 rr rr             jsr     ReadJoystick1
001C45r 2  A8                   tay
001C46r 2  4C rr rr             jmp     SngFlt
001C49r 2               @j2:
001C49r 2  20 rr rr             jsr     ReadJoystick2
001C4Cr 2  A8                   tay
001C4Dr 2  4C rr rr             jmp     SngFlt
001C50r 2               @absent:
001C50r 2  68                   pla
001C51r 2                       ; $FF, not 0.  The ports are active low -- pulled high through 1K, and
001C51r 2                       ; the stick's switches ground them -- so JOY returns the port raw and 0
001C51r 2                       ; means every direction and button is held at once.  Reporting 0 for a
001C51r 2                       ; machine with no VIA fitted told the caller exactly that; $FF is what
001C51r 2                       ; an untouched stick reads, and so the honest answer for one that is
001C51r 2                       ; not there at all.
001C51r 2  A0 FF                ldy     #$FF
001C53r 2  4C rr rr             jmp     SngFlt
001C56r 2               
001C56r 2               ; ---------------------------------------------------------------------------
001C56r 2               ; FnNvram -- NVRAM(addr): if RTC absent, return 0.
001C56r 2               ; ---------------------------------------------------------------------------
001C56r 2               FnNvram:
001C56r 2  20 rr rr             jsr     ParenU8
001C59r 2  48                   pha
001C5Ar 2  AD 0D 03             lda     HW_PRESENT
001C5Dr 2  29 04                and     #HW_RTC
001C5Fr 2  F0 09                beq     @absent
001C61r 2  68                   pla
001C62r 2  AA                   tax
001C63r 2  20 rr rr             jsr     RtcReadNVRAM
001C66r 2  A8                   tay
001C67r 2  4C rr rr             jmp     SngFlt
001C6Ar 2               @absent:
001C6Ar 2  68                   pla
001C6Br 2  A0 00                ldy     #0
001C6Dr 2  4C rr rr             jmp     SngFlt
001C70r 2               
001C70r 2               ; ---------------------------------------------------------------------------
001C70r 2               ; FnMin / FnMax -- two numeric args, smaller / larger.
001C70r 2               ; ---------------------------------------------------------------------------
001C70r 2               FnMin:
001C70r 2  20 rr rr             jsr     MinMaxArgs              ; ARG = a, FAC = b, BAS_TMP3 = sign(b-a)
001C73r 2                       ; Want smaller: if b>=a return a (ARG); else return b (FAC).
001C73r 2  10 01                bpl     @retArg                 ; sign>=0 means b>=a
001C75r 2  60                   rts                             ; FAC already = b
001C76r 2               @retArg:
001C76r 2  4C rr rr             jmp     CopyArgToFac
001C79r 2               FnMax:
001C79r 2  20 rr rr             jsr     MinMaxArgs
001C7Cr 2                       ; Want larger: if b>=a return b (FAC); else return a (ARG).
001C7Cr 2  10 03                bpl     @retFac
001C7Er 2  4C rr rr             jmp     CopyArgToFac
001C81r 2               @retFac:
001C81r 2  60                   rts
001C82r 2               
001C82r 2               ; MinMaxArgs -- consume "(" a "," b ")" with numerics; ARG=a, FAC=b.
001C82r 2               ; Returns A = sign(b - a) (FF/00/01) and N flag set accordingly.
001C82r 2               MinMaxArgs:
001C82r 2  20 rr rr             jsr     ChkOpn
001C85r 2  20 rr rr             jsr     FrmEvl
001C88r 2  20 rr rr             jsr     ChkNum
001C8Br 2  20 rr rr             jsr     PushFac                 ; save a
001C8Er 2  20 rr rr             jsr     ChkCom
001C91r 2  20 rr rr             jsr     FrmEvl
001C94r 2  20 rr rr             jsr     ChkNum
001C97r 2  20 rr rr             jsr     ChkCls
001C9Ar 2  20 rr rr             jsr     PullArg                 ; ARG = a, FAC = b
001C9Dr 2                       ; Stash ARG so we can restore after FComp's destructive sign-pack.
001C9Dr 2  A5 16                lda     ARG
001C9Fr 2  85 4D                sta     BAS_TEMP1
001CA1r 2  A5 17                lda     ARG+1
001CA3r 2  85 4E                sta     BAS_TEMP1+1
001CA5r 2  A5 18                lda     ARG+2
001CA7r 2  85 4F                sta     BAS_TEMP1+2
001CA9r 2  A5 19                lda     ARG+3
001CABr 2  85 50                sta     BAS_TEMP1+3
001CADr 2  A5 1A                lda     ARG+4
001CAFr 2  85 51                sta     BAS_TEMP1+4
001CB1r 2  A5 1B                lda     ARGSIGN
001CB3r 2  85 52                sta     BAS_TEMP1+5
001CB5r 2                       ; Pack ARGSIGN into bit 7 of ARG+1 so FComp reads it correctly.
001CB5r 2  A5 1B                lda     ARGSIGN
001CB7r 2  09 7F                ora     #$7F
001CB9r 2  25 17                and     ARG+1
001CBBr 2  85 17                sta     ARG+1
001CBDr 2  A9 16                lda     #<ARG
001CBFr 2  A0 00                ldy     #$00
001CC1r 2  20 rr rr             jsr     FComp                   ; A = sign(FAC - ARG)
001CC4r 2  48                   pha
001CC5r 2                       ; Restore ARG.
001CC5r 2  A5 4D                lda     BAS_TEMP1
001CC7r 2  85 16                sta     ARG
001CC9r 2  A5 4E                lda     BAS_TEMP1+1
001CCBr 2  85 17                sta     ARG+1
001CCDr 2  A5 4F                lda     BAS_TEMP1+2
001CCFr 2  85 18                sta     ARG+2
001CD1r 2  A5 50                lda     BAS_TEMP1+3
001CD3r 2  85 19                sta     ARG+3
001CD5r 2  A5 51                lda     BAS_TEMP1+4
001CD7r 2  85 1A                sta     ARG+4
001CD9r 2  A5 52                lda     BAS_TEMP1+5
001CDBr 2  85 1B                sta     ARGSIGN
001CDDr 2  68                   pla                             ; restore A, sets N/Z flags
001CDEr 2  60                   rts
001CDFr 2               
001CDFr 2               ; ---------------------------------------------------------------------------
001CDFr 2               ; FnLen -- LEN(s$): length of string.
001CDFr 2               ; ---------------------------------------------------------------------------
001CDFr 2               FnLen:
001CDFr 2  20 rr rr             jsr     ParenStr
001CE2r 2  A5 0E                lda     FAC                     ; length
001CE4r 2  48                   pha                             ; FreFac returns with Y = descriptor hi
001CE5r 2  20 rr rr             jsr     FreFac                  ; release temp string if any
001CE8r 2  68                   pla
001CE9r 2  A8                   tay
001CEAr 2  4C rr rr             jmp     SngFlt
001CEDr 2               
001CEDr 2               ; ---------------------------------------------------------------------------
001CEDr 2               ; FnAsc -- ASC(s$): code of first char; ?ILLQTY if empty.
001CEDr 2               ; ---------------------------------------------------------------------------
001CEDr 2               FnAsc:
001CEDr 2  20 rr rr             jsr     ParenStr
001CF0r 2  A5 0E                lda     FAC
001CF2r 2  F0 15                beq     @bad
001CF4r 2                       ; Read first byte of string.
001CF4r 2  A5 0F                lda     FAC+1
001CF6r 2  85 20                sta     INDEX
001CF8r 2  A5 10                lda     FAC+2
001CFAr 2  85 21                sta     INDEX+1
001CFCr 2  A0 00                ldy     #0
001CFEr 2  B1 20                lda     (INDEX),y
001D00r 2  48                   pha
001D01r 2  20 rr rr             jsr     FreFac
001D04r 2  68                   pla
001D05r 2  A8                   tay
001D06r 2  4C rr rr             jmp     SngFlt
001D09r 2               @bad:
001D09r 2  4C rr rr             jmp     IqErr
001D0Cr 2               
001D0Cr 2               ; ---------------------------------------------------------------------------
001D0Cr 2               ; FnChrStr -- CHR$(n): 1-char string.
001D0Cr 2               ; ---------------------------------------------------------------------------
001D0Cr 2               FnChrStr:
001D0Cr 2  20 rr rr             jsr     ParenU8
001D0Fr 2  48                   pha
001D10r 2  A9 01                lda     #1
001D12r 2  20 rr rr             jsr     GetSpa                  ; (Y,X) = addr; A unchanged
001D15r 2  68                   pla
001D16r 2  A0 00                ldy     #0
001D18r 2  91 84                sta     (FRESPC),y
001D1Ar 2                       ; Build descriptor in FAC.
001D1Ar 2  A9 01                lda     #1
001D1Cr 2  85 0E                sta     FAC
001D1Er 2  A5 84                lda     FRESPC
001D20r 2  85 0F                sta     FAC+1
001D22r 2  A5 85                lda     FRESPC+1
001D24r 2  85 10                sta     FAC+2
001D26r 2                       ; Advance FRESPC past the byte we just wrote.
001D26r 2  E6 84                inc     FRESPC
001D28r 2  D0 02                bne     @nb
001D2Ar 2  E6 85                inc     FRESPC+1
001D2Cr 2               @nb:
001D2Cr 2  4C rr rr             jmp     PutNew
001D2Fr 2               
001D2Fr 2               ; ---------------------------------------------------------------------------
001D2Fr 2               ; FnStrStr -- STR$(n): convert numeric to string.
001D2Fr 2               ; ---------------------------------------------------------------------------
001D2Fr 2               FnStrStr:
001D2Fr 2  20 rr rr             jsr     ParenNum
001D32r 2  20 rr rr             jsr     Fout                    ; A=lo, Y=hi -> NUL-terminated buffer
001D35r 2                       ; (A,Y) = pointer to NUL-terminated ASCII number string in STACK2.
001D35r 2  20 rr rr             jsr     StrLit                  ; allocates + copies + PutNew
001D38r 2  60                   rts
001D39r 2               
001D39r 2               ; ---------------------------------------------------------------------------
001D39r 2               ; FnVal -- VAL(s$): parse leading numeric from string.
001D39r 2               ; Temporarily NUL-terminates the string in place, redirects TXTPTR, calls
001D39r 2               ; Fin, then restores.
001D39r 2               ; ---------------------------------------------------------------------------
001D39r 2               FnVal:
001D39r 2  20 rr rr             jsr     ParenStr
001D3Cr 2  A5 0E                lda     FAC
001D3Er 2  D0 08                bne     @nz
001D40r 2                       ; empty string -> 0
001D40r 2  20 rr rr             jsr     FreFac
001D43r 2  64 64                stz     VALTYP                  ; result is numeric (ParenStr set $FF)
001D45r 2  4C rr rr             jmp     ZeroFac
001D48r 2               @nz:
001D48r 2                       ; Stash length, address into TEMP1..TEMP1+2.
001D48r 2  85 4D                sta     TEMP1                   ; length
001D4Ar 2  A5 0F                lda     FAC+1
001D4Cr 2  85 4E                sta     TEMP1+1
001D4Er 2  A5 10                lda     FAC+2
001D50r 2  85 4F                sta     TEMP1+2
001D52r 2                       ; Reclaim the argument's temp now, while FAC still holds its
001D52r 2                       ; descriptor -- msbasic's VAL frees before parsing for the same
001D52r 2                       ; reason.  It cannot wait until after Fin: FAC+3/+4 are the two bytes
001D52r 2                       ; FreFac frees by, and by then they are mantissa of the parsed number.
001D52r 2                       ; Freeing only releases the heap for reuse and nothing allocates
001D52r 2                       ; between here and Fin, so the characters stay intact to parse.
001D52r 2                       ; Without it the temp leaked: the empty-string path above frees, the
001D52r 2                       ; parsing path did not, and three VALs of a literal in one program
001D52r 2                       ; exhausted the 3-slot temp stack with ?FORMULA TOO COMPLEX.
001D52r 2  20 rr rr             jsr     FreFac
001D55r 2                       ; Save the byte at offset = length and replace with $00.
001D55r 2  A5 4E                lda     TEMP1+1
001D57r 2  85 20                sta     INDEX
001D59r 2  A5 4F                lda     TEMP1+2
001D5Br 2  85 21                sta     INDEX+1
001D5Dr 2  A4 4D                ldy     TEMP1
001D5Fr 2  B1 20                lda     (INDEX),y
001D61r 2  85 50                sta     TEMP1+3                 ; saved byte
001D63r 2  A9 00                lda     #0
001D65r 2  91 20                sta     (INDEX),y
001D67r 2                       ; Save TXTPTR.
001D67r 2  A5 04                lda     TXTPTR
001D69r 2  48                   pha
001D6Ar 2  A5 05                lda     TXTPTR+1
001D6Cr 2  48                   pha
001D6Dr 2                       ; TXTPTR := INDEX - 1, then ChrGet to load first char.
001D6Dr 2  A5 4E                lda     TEMP1+1
001D6Fr 2  85 04                sta     TXTPTR
001D71r 2  A5 4F                lda     TEMP1+2
001D73r 2  85 05                sta     TXTPTR+1
001D75r 2  A5 04                lda     TXTPTR
001D77r 2  D0 02                bne     @nb
001D79r 2  C6 05                dec     TXTPTR+1
001D7Br 2               @nb:
001D7Br 2  C6 04                dec     TXTPTR
001D7Dr 2  20 rr rr             jsr     ChrGet                  ; first char
001D80r 2  20 rr rr             jsr     Fin                     ; FAC := value
001D83r 2                       ; Restore the saved byte.
001D83r 2  A5 4E                lda     TEMP1+1
001D85r 2  85 20                sta     INDEX
001D87r 2  A5 4F                lda     TEMP1+2
001D89r 2  85 21                sta     INDEX+1
001D8Br 2  A4 4D                ldy     TEMP1
001D8Dr 2  A5 50                lda     TEMP1+3
001D8Fr 2  91 20                sta     (INDEX),y
001D91r 2                       ; Restore TXTPTR.
001D91r 2  68                   pla
001D92r 2  85 05                sta     TXTPTR+1
001D94r 2  68                   pla
001D95r 2  85 04                sta     TXTPTR
001D97r 2  64 64                stz     VALTYP                  ; Fin left VALTYP = $FF from ParenStr
001D99r 2  60                   rts
001D9Ar 2               
001D9Ar 2               ; ---------------------------------------------------------------------------
001D9Ar 2               ; FnLeftStr -- LEFT$(s$, n): leftmost n chars.
001D9Ar 2               ; ---------------------------------------------------------------------------
001D9Ar 2               FnLeftStr:
001D9Ar 2  20 rr rr             jsr     ChkOpn
001D9Dr 2  20 rr rr             jsr     FrmEvl
001DA0r 2  20 rr rr             jsr     ChkStr
001DA3r 2  20 rr rr             jsr     ChkCom
001DA6r 2  20 rr rr             jsr     PushFac                 ; save string descriptor
001DA9r 2  20 rr rr             jsr     FrmEvl
001DACr 2  20 rr rr             jsr     ChkNum
001DAFr 2  20 rr rr             jsr     ChkCls
001DB2r 2  20 rr rr             jsr     AyInt
001DB5r 2  20 rr rr             jsr     PullArg                 ; ARG = string descriptor (BAS_TMP1 clobbered)
001DB8r 2                       ; FAC still holds the integer n; check range and copy now.
001DB8r 2  A5 11                lda     FAC+3
001DBAr 2  D0 16                bne     @bad
001DBCr 2  A5 12                lda     FAC+4
001DBEr 2  85 3B                sta     BAS_TMP1+1              ; n
001DC0r 2                       ; Clamp n to ARG (length).
001DC0r 2  A5 3B                lda     BAS_TMP1+1
001DC2r 2  C5 16                cmp     ARG
001DC4r 2  90 02                bcc     @ok
001DC6r 2  A5 16                lda     ARG
001DC8r 2               @ok:
001DC8r 2  85 3B                sta     BAS_TMP1+1
001DCAr 2                       ; Free the source temp BEFORE allocating result so the slot frees up.
001DCAr 2  20 rr rr             jsr     FreeArgString
001DCDr 2                       ; Offset = 0 for LEFT$.
001DCDr 2  64 3A                stz     BAS_TMP1
001DCFr 2                       ; Allocate, copy first n bytes.
001DCFr 2  4C rr rr             jmp     SubstrCommon            ; tail-call (rts to caller)
001DD2r 2               @bad:
001DD2r 2  4C rr rr             jmp     IqErr
001DD5r 2               
001DD5r 2               ; ---------------------------------------------------------------------------
001DD5r 2               ; FnRightStr -- RIGHT$(s$, n): rightmost n chars.
001DD5r 2               ; ---------------------------------------------------------------------------
001DD5r 2               FnRightStr:
001DD5r 2  20 rr rr             jsr     ChkOpn
001DD8r 2  20 rr rr             jsr     FrmEvl
001DDBr 2  20 rr rr             jsr     ChkStr
001DDEr 2  20 rr rr             jsr     ChkCom
001DE1r 2  20 rr rr             jsr     PushFac
001DE4r 2  20 rr rr             jsr     FrmEvl
001DE7r 2  20 rr rr             jsr     ChkNum
001DEAr 2  20 rr rr             jsr     ChkCls
001DEDr 2  20 rr rr             jsr     AyInt
001DF0r 2  20 rr rr             jsr     PullArg                 ; ARG = string descriptor (BAS_TMP1 clobbered)
001DF3r 2  A5 11                lda     FAC+3
001DF5r 2  D0 1B                bne     @bad
001DF7r 2  A5 12                lda     FAC+4
001DF9r 2  85 3B                sta     BAS_TMP1+1              ; n
001DFBr 2                       ; Clamp n.
001DFBr 2  A5 3B                lda     BAS_TMP1+1
001DFDr 2  C5 16                cmp     ARG
001DFFr 2  90 02                bcc     @ok
001E01r 2  A5 16                lda     ARG
001E03r 2               @ok:
001E03r 2  85 3B                sta     BAS_TMP1+1
001E05r 2                       ; offset = ARG - n.
001E05r 2  A5 16                lda     ARG
001E07r 2  38                   sec
001E08r 2  E5 3B                sbc     BAS_TMP1+1
001E0Ar 2  85 3A                sta     BAS_TMP1                ; start offset
001E0Cr 2  20 rr rr             jsr     FreeArgString
001E0Fr 2  4C rr rr             jmp     SubstrCommon
001E12r 2               @bad:
001E12r 2  4C rr rr             jmp     IqErr
001E15r 2               
001E15r 2               ; ---------------------------------------------------------------------------
001E15r 2               ; FnMidStr -- MID$(s$, m [, n]): substring starting at m (1-based).
001E15r 2               ; ---------------------------------------------------------------------------
001E15r 2               FnMidStr:
001E15r 2  20 rr rr             jsr     ChkOpn
001E18r 2  20 rr rr             jsr     FrmEvl
001E1Br 2  20 rr rr             jsr     ChkStr
001E1Er 2  20 rr rr             jsr     ChkCom
001E21r 2  20 rr rr             jsr     PushFac
001E24r 2                       ; Read m.
001E24r 2  20 rr rr             jsr     FrmEvl
001E27r 2  20 rr rr             jsr     ChkNum
001E2Ar 2  20 rr rr             jsr     AyInt
001E2Dr 2  A5 11                lda     FAC+3
001E2Fr 2  D0 4B                bne     @bad
001E31r 2  A5 12                lda     FAC+4
001E33r 2  F0 47                beq     @bad                    ; m must be >= 1
001E35r 2  38                   sec
001E36r 2  E9 01                sbc     #1
001E38r 2  48                   pha                             ; offset = m-1; FrmEvl below would
001E39r 2                                                       ; clobber BAS_TMP1, so park it here
001E39r 2                       ; Optional ", n".
001E39r 2  20 rr rr             jsr     ChrGot
001E3Cr 2  C9 2C                cmp     #','
001E3Er 2  F0 04                beq     @hasN
001E40r 2                       ; No n: take rest -> n = 255 (will clamp).
001E40r 2  A9 FF                lda     #255
001E42r 2  80 12                bra     @gotN
001E44r 2               @hasN:
001E44r 2  20 rr rr             jsr     ChrGet
001E47r 2  20 rr rr             jsr     FrmEvl
001E4Ar 2  20 rr rr             jsr     ChkNum
001E4Dr 2  20 rr rr             jsr     AyInt
001E50r 2  A5 11                lda     FAC+3
001E52r 2  D0 28                bne     @bad
001E54r 2  A5 12                lda     FAC+4
001E56r 2               @gotN:
001E56r 2  85 3B                sta     BAS_TMP1+1
001E58r 2  68                   pla
001E59r 2  85 3A                sta     BAS_TMP1
001E5Br 2  20 rr rr             jsr     ChkCls
001E5Er 2  20 rr rr             jsr     PullArg                 ; ARG = string
001E61r 2                       ; Clamp offset to length.
001E61r 2  A5 3A                lda     BAS_TMP1
001E63r 2  C5 16                cmp     ARG
001E65r 2  90 04                bcc     @offOk
001E67r 2  A5 16                lda     ARG                     ; offset = length -> empty result
001E69r 2  85 3A                sta     BAS_TMP1
001E6Br 2               @offOk:
001E6Br 2                       ; Clamp n to (length - offset).
001E6Br 2  38                   sec
001E6Cr 2  A5 16                lda     ARG
001E6Er 2  E5 3A                sbc     BAS_TMP1
001E70r 2  C5 3B                cmp     BAS_TMP1+1
001E72r 2  B0 02                bcs     @nOk
001E74r 2  85 3B                sta     BAS_TMP1+1
001E76r 2               @nOk:
001E76r 2  20 rr rr             jsr     FreeArgString
001E79r 2  4C rr rr             jmp     SubstrCommon
001E7Cr 2               @bad:
001E7Cr 2  4C rr rr             jmp     IqErr
001E7Fr 2               
001E7Fr 2               ; ---------------------------------------------------------------------------
001E7Fr 2               ; SubstrCommon -- copy BAS_TMP1+1 bytes from ARG-string at offset BAS_TMP1
001E7Fr 2               ; into a new heap allocation; result descriptor in FAC; PutNew.
001E7Fr 2               ; ---------------------------------------------------------------------------
001E7Fr 2               SubstrCommon:
001E7Fr 2                       ; Allocate.
001E7Fr 2  A5 3B                lda     BAS_TMP1+1
001E81r 2  20 rr rr             jsr     GetSpa                  ; FRESPC = new buffer
001E84r 2                       ; Source pointer = ARG+1 (lo/hi) + BAS_TMP1.
001E84r 2  18                   clc
001E85r 2  A5 17                lda     ARG+1
001E87r 2  65 3A                adc     BAS_TMP1
001E89r 2  85 20                sta     INDEX
001E8Br 2  A5 18                lda     ARG+2
001E8Dr 2  69 00                adc     #0
001E8Fr 2  85 21                sta     INDEX+1
001E91r 2                       ; Copy BAS_TMP1+1 bytes from (INDEX) to (FRESPC).
001E91r 2  A4 3B                ldy     BAS_TMP1+1
001E93r 2  F0 0B                beq     @done
001E95r 2  A0 00                ldy     #0
001E97r 2               @cp:
001E97r 2  B1 20                lda     (INDEX),y
001E99r 2  91 84                sta     (FRESPC),y
001E9Br 2  C8                   iny
001E9Cr 2  C4 3B                cpy     BAS_TMP1+1
001E9Er 2  D0 F7                bne     @cp
001EA0r 2               @done:
001EA0r 2                       ; Build descriptor.
001EA0r 2  A5 3B                lda     BAS_TMP1+1
001EA2r 2  85 0E                sta     FAC
001EA4r 2  A5 84                lda     FRESPC
001EA6r 2  85 0F                sta     FAC+1
001EA8r 2  A5 85                lda     FRESPC+1
001EAAr 2  85 10                sta     FAC+2
001EACr 2                       ; Advance FRESPC by length consumed.
001EACr 2  18                   clc
001EADr 2  A5 84                lda     FRESPC
001EAFr 2  65 3B                adc     BAS_TMP1+1
001EB1r 2  85 84                sta     FRESPC
001EB3r 2  90 02                bcc     @nb
001EB5r 2  E6 85                inc     FRESPC+1
001EB7r 2               @nb:
001EB7r 2  4C rr rr             jmp     PutNew
001EBAr 2               
001EBAr 2               ; FreeArgString -- if ARG holds a temp string descriptor (most-recent
001EBAr 2               ; on TEMPST), pop just the descriptor.  Heap is left intact so callers
001EBAr 2               ; that still need the source bytes can copy them safely; orphaned heap
001EBAr 2               ; will be reclaimed by Garbag.
001EBAr 2               FreeArgString:
001EBAr 2  A5 19                lda     ARG+3                   ; descriptor address lo
001EBCr 2  A4 1A                ldy     ARG+4                   ; descriptor address hi (always $00)
001EBEr 2  4C rr rr             jmp     FreTms
001EC1r 2               
001EC1r 2               ; Cleanup that releases both ARG's and FAC's temp descriptors (called from
001EC1r 2               ; CatStr after content has been stashed but before new allocation).
001EC1r 2               FreeBothTemps:
001EC1r 2                       ; Free FAC's temp first (it is currently LASTPT).
001EC1r 2  A5 11                lda     FAC+3
001EC3r 2  A4 12                ldy     FAC+4
001EC5r 2  20 rr rr             jsr     FreTms
001EC8r 2                       ; Then ARG's (now LASTPT after FAC's removal).
001EC8r 2  A5 19                lda     ARG+3
001ECAr 2  A4 1A                ldy     ARG+4
001ECCr 2  4C rr rr             jmp     FreTms
001ECFr 2  60                   rts
001ED0r 2               
001ED0r 2               ; ===========================================================================
001ED0r 2               ;   E V A L U A T O R   -   B I N A R Y   O P E R A T O R   H E L P E R S
001ED0r 2               ; ===========================================================================
001ED0r 2               
001ED0r 2               ; ---------------------------------------------------------------------------
001ED0r 2               ; AndOp -- FAC = ARG AND FAC (bitwise on 16-bit signed ints).
001ED0r 2               ; ---------------------------------------------------------------------------
001ED0r 2               AndOp:
001ED0r 2  20 rr rr             jsr     AyInt                   ; FAC -> int (FAC+3=hi, FAC+4=lo)
001ED3r 2  A5 11                lda     FAC+3
001ED5r 2  85 3A                sta     BAS_TMP1                ; saved hi
001ED7r 2  A5 12                lda     FAC+4
001ED9r 2  85 3B                sta     BAS_TMP1+1              ; saved lo
001EDBr 2  20 rr rr             jsr     CopyArgToFac
001EDEr 2  20 rr rr             jsr     AyInt
001EE1r 2  A5 12                lda     FAC+4
001EE3r 2  25 3B                and     BAS_TMP1+1
001EE5r 2  A8                   tay                             ; Y = lo result
001EE6r 2  A5 11                lda     FAC+3
001EE8r 2  25 3A                and     BAS_TMP1                ; A = hi result
001EEAr 2  4C rr rr             jmp     GivAyf
001EEDr 2               
001EEDr 2               ; ---------------------------------------------------------------------------
001EEDr 2               ; OrOp -- FAC = ARG OR FAC.
001EEDr 2               ; ---------------------------------------------------------------------------
001EEDr 2               OrOp:
001EEDr 2  20 rr rr             jsr     AyInt
001EF0r 2  A5 11                lda     FAC+3
001EF2r 2  85 3A                sta     BAS_TMP1                ; saved hi
001EF4r 2  A5 12                lda     FAC+4
001EF6r 2  85 3B                sta     BAS_TMP1+1              ; saved lo
001EF8r 2  20 rr rr             jsr     CopyArgToFac
001EFBr 2  20 rr rr             jsr     AyInt
001EFEr 2  A5 12                lda     FAC+4
001F00r 2  05 3B                ora     BAS_TMP1+1
001F02r 2  A8                   tay                             ; Y = lo
001F03r 2  A5 11                lda     FAC+3
001F05r 2  05 3A                ora     BAS_TMP1                ; A = hi
001F07r 2  4C rr rr             jmp     GivAyf
001F0Ar 2               
001F0Ar 2               ; ---------------------------------------------------------------------------
001F0Ar 2               ; NotOp -- FAC = NOT FAC (bitwise complement of 16-bit signed int).
001F0Ar 2               ; ---------------------------------------------------------------------------
001F0Ar 2               NotOp:
001F0Ar 2  20 rr rr             jsr     AyInt
001F0Dr 2  A5 12                lda     FAC+4
001F0Fr 2  49 FF                eor     #$FF
001F11r 2  A8                   tay                             ; Y = lo
001F12r 2  A5 11                lda     FAC+3
001F14r 2  49 FF                eor     #$FF                    ; A = hi
001F16r 2  4C rr rr             jmp     GivAyf
001F19r 2               
001F19r 2               ; ---------------------------------------------------------------------------
001F19r 2               ; BasCmdLet -- minimal LET (assignment).  Entered with ChrGot returning
001F19r 2               ; the first letter of the variable name.  No `LET` keyword required.
001F19r 2               ; ---------------------------------------------------------------------------
001F19r 2               BasCmdLet:
001F19r 2  20 rr rr             jsr     PtrGet                  ; VARPNT, VALTYP set; TXTPTR past name
001F1Cr 2                       ; Save VARPNT and the variable's VALTYP across FrmEvl.
001F1Cr 2  A5 3F                lda     VARPNT
001F1Er 2  48                   pha
001F1Fr 2  A5 40                lda     VARPNT+1
001F21r 2  48                   pha
001F22r 2  A5 64                lda     VALTYP
001F24r 2  48                   pha
001F25r 2  20 rr rr             jsr     ChrGot
001F28r 2  C9 3D                cmp     #'='
001F2Ar 2  D0 36                bne     @synErr
001F2Cr 2  20 rr rr             jsr     ChrGet
001F2Fr 2  20 rr rr             jsr     FrmEvl
001F32r 2  68                   pla                             ; saved variable VALTYP
001F33r 2  85 3E                sta     BAS_TMP3
001F35r 2  45 64                eor     VALTYP
001F37r 2  30 2F                bmi     @typeErr
001F39r 2  68                   pla
001F3Ar 2  85 40                sta     VARPNT+1
001F3Cr 2  68                   pla
001F3Dr 2  85 3F                sta     VARPNT
001F3Fr 2  24 3E                bit     BAS_TMP3
001F41r 2  30 07                bmi     @storeStr
001F43r 2                       ; Numeric: store FAC into (VARPNT) (5 bytes).
001F43r 2  A6 3F                ldx     VARPNT
001F45r 2  A4 40                ldy     VARPNT+1
001F47r 2  4C rr rr             jmp     StoreFacAtYxRounded
001F4Ar 2               @storeStr:
001F4Ar 2  A0 00                ldy     #0
001F4Cr 2  A5 0E                lda     FAC
001F4Er 2  91 3F                sta     (VARPNT),y
001F50r 2  C8                   iny
001F51r 2  A5 0F                lda     FAC+1
001F53r 2  91 3F                sta     (VARPNT),y
001F55r 2  C8                   iny
001F56r 2  A5 10                lda     FAC+2
001F58r 2  91 3F                sta     (VARPNT),y
001F5Ar 2                       ; If the RHS was a temporary string (StrLt2/PutNew pushed it and left
001F5Ar 2                       ; its descriptor address in FAC+3/FAC+4 == LASTPT), pop it now that
001F5Ar 2                       ; the variable owns the heap copy.  Pop only (FreTms), never FreFac --
001F5Ar 2                       ; reclaiming would free the string we just stored.  For a plain
001F5Ar 2                       ; variable RHS, @loadStr set FAC+3/FAC+4 to that variable's address
001F5Ar 2                       ; (nonzero high byte), which cannot match a temp slot, so FreTms is a
001F5Ar 2                       ; no-op.  Without this, >3 consecutive string LETs leak the 3-slot
001F5Ar 2                       ; temp stack (?FORMULA TOO COMPLEX).
001F5Ar 2  A5 11                lda     FAC+3
001F5Cr 2  A4 12                ldy     FAC+4
001F5Er 2  20 rr rr             jsr     FreTms
001F61r 2  60                   rts
001F62r 2               @synErr:
001F62r 2  68                   pla
001F63r 2  68                   pla
001F64r 2  68                   pla
001F65r 2  4C rr rr             jmp     SynErr
001F68r 2               @typeErr:
001F68r 2  68                   pla
001F69r 2  68                   pla
001F6Ar 2  A2 08                ldx     #ERR_TYPEMISM
001F6Cr 2  4C rr rr             jmp     BasErrorVec
001F6Fr 2               
001F6Fr 2               ; =============================================================================
001F6Fr 2               ;   C O N T R O L   F L O W   /   S T A T E M E N T   L O O P
001F6Fr 2               ;
001F6Fr 2               ;   BasNewstt drives execution for both direct mode (TXTPTR in BAS_TOKBUF)
001F6Fr 2               ;   and run mode (TXTPTR walks program lines from BAS_TXTTAB).  Statement
001F6Fr 2               ;   dispatch follows the msbasic convention: push (routine_addr - 1) and
001F6Fr 2               ;   tail-jump through ChrGet, so the routine entry is reached via RTS.
001F6Fr 2               ;
001F6Fr 2               ;   FOR and GOSUB store frames on the CPU stack and JMP back to BasNewstt;
001F6Fr 2               ;   NEXT and RETURN scan the stack for a matching tag, then TXS to discard
001F6Fr 2               ;   the frame and resume.
001F6Fr 2               ; =============================================================================
001F6Fr 2               
001F6Fr 2               NUM_STMT_TOKENS = TOK_MEM + 1 - TOK_BASE       ; $36 entries
001F6Fr 2               
001F6Fr 2               BasNewstt:
001F6Fr 2  20 rr rr             jsr     BasCheckBreak
001F72r 2                       ; Save TXTPTR -> OLDTEXT for CONT, except in direct mode.
001F72r 2  AD 6A 03             lda     BAS_CURLIN+1
001F75r 2  C9 FF                cmp     #$FF
001F77r 2  F0 0A                beq     @noSave
001F79r 2  A5 04                lda     TXTPTR
001F7Br 2  8D 6D 03             sta     BAS_OLDTEXT
001F7Er 2  A5 05                lda     TXTPTR+1
001F80r 2  8D 6E 03             sta     BAS_OLDTEXT+1
001F83r 2               @noSave:
001F83r 2  A0 00                ldy     #0
001F85r 2  B1 04                lda     (TXTPTR),y
001F87r 2  F0 10                beq     @endLine
001F89r 2  C9 A4                cmp     #TOK_ELSE
001F8Br 2  F0 07                beq     @skipElse               ; THEN-branch ran; skip ELSE clause to EOL
001F8Dr 2  C9 3A                cmp     #':'
001F8Fr 2  F0 34                beq     @nextStmt
001F91r 2  4C rr rr             jmp     SynErr
001F94r 2               @skipElse:
001F94r 2                       ; Advance TXTPTR until we land on a $00 terminator.
001F94r 2               @skLoop:
001F94r 2  20 rr rr             jsr     ChrGet
001F97r 2  D0 FB                bne     @skLoop
001F99r 2                       ; Fall through to @endLine with TXTPTR at $00.
001F99r 2               @endLine:
001F99r 2                       ; Direct mode: end of buffer -> back to REPL.
001F99r 2  AD 6A 03             lda     BAS_CURLIN+1
001F9Cr 2  C9 FF                cmp     #$FF
001F9Er 2  D0 03                bne     @walkNext
001FA0r 2  4C rr rr             jmp     BasReadyLoop            ; OK is printed by BasReadyLoop
001FA3r 2               @walkNext:
001FA3r 2                       ; Run mode: examine next-pointer at offsets +1,+2.
001FA3r 2  A0 02                ldy     #2
001FA5r 2  B1 04                lda     (TXTPTR),y
001FA7r 2  D0 06                bne     @loadLine               ; nonzero hi -> next line exists
001FA9r 2                       ; End of program -> halt and return to REPL.
001FA9r 2  A2 FF                ldx     #$FF
001FABr 2  9A                   txs
001FACr 2  4C rr rr             jmp     BasReadyLoop
001FAFr 2               @loadLine:
001FAFr 2  C8                   iny                             ; y=3
001FB0r 2  B1 04                lda     (TXTPTR),y
001FB2r 2  8D 69 03             sta     BAS_CURLIN
001FB5r 2  C8                   iny                             ; y=4
001FB6r 2  B1 04                lda     (TXTPTR),y
001FB8r 2  8D 6A 03             sta     BAS_CURLIN+1
001FBBr 2  98                   tya                             ; A=4
001FBCr 2  18                   clc
001FBDr 2  65 04                adc     TXTPTR
001FBFr 2  85 04                sta     TXTPTR
001FC1r 2  90 02                bcc     @nextStmt
001FC3r 2  E6 05                inc     TXTPTR+1
001FC5r 2               @nextStmt:
001FC5r 2  20 rr rr             jsr     ChrGet
001FC8r 2  20 rr rr             jsr     BasExecuteStatement
001FCBr 2  4C rr rr             jmp     BasNewstt
001FCEr 2               
001FCEr 2               ; ---------------------------------------------------------------------------
001FCEr 2               ; BasExecuteStatement -- A = current tokenized byte (loaded by ChrGet).
001FCEr 2               ;   * A = 0  -> RTS (no-op; end of statement chain).
001FCEr 2               ;   * A < $80 (letter) -> JMP BasCmdLet.
001FCEr 2               ;   * A is a statement token ($80..TOK_MEM) -> dispatch via BasTokenAddrTbl.
001FCEr 2               ;   * Otherwise -> ?SYNTAX ERROR.
001FCEr 2               ; ---------------------------------------------------------------------------
001FCEr 2               BasExecuteStatement:
001FCEr 2  F0 30                beq     @ret
001FD0r 2  38                   sec
001FD1r 2  E9 80                sbc     #TOK_BASE
001FD3r 2  90 25                bcc     @doLet
001FD5r 2  C9 36                cmp     #NUM_STMT_TOKENS
001FD7r 2  B0 0D                bcs     @ext
001FD9r 2  0A                   asl     a
001FDAr 2  A8                   tay
001FDBr 2  B9 rr rr             lda     BasTokenAddrTbl+1,y
001FDEr 2  48                   pha
001FDFr 2  B9 rr rr             lda     BasTokenAddrTbl,y
001FE2r 2  48                   pha
001FE3r 2  4C rr rr             jmp     ChrGet
001FE6r 2               @ext:
001FE6r 2                       ; Extended statement tokens DISK/BLOAD/BSAVE/FORMAT ($D1-$D4).
001FE6r 2                       ; Bodies live in the Kernal via BasExtAddrTbl (thin-BASIC strategy).
001FE6r 2  38                   sec
001FE7r 2  E9 51                sbc     #(TOK_DISK - TOK_BASE)
001FE9r 2  C9 04                cmp     #4
001FEBr 2  B0 10                bcs     @synErr
001FEDr 2  0A                   asl     a
001FEEr 2  A8                   tay
001FEFr 2  B9 rr rr             lda     BasExtAddrTbl+1,y
001FF2r 2  48                   pha
001FF3r 2  B9 rr rr             lda     BasExtAddrTbl,y
001FF6r 2  48                   pha
001FF7r 2  4C rr rr             jmp     ChrGet
001FFAr 2               @doLet:
001FFAr 2  4C rr rr             jmp     BasCmdLet
001FFDr 2               @synErr:
001FFDr 2  4C rr rr             jmp     SynErr
002000r 2               @ret:
002000r 2  60                   rts
002001r 2               
002001r 2               ; ---------------------------------------------------------------------------
002001r 2               ; BasCheckBreak -- poll input buffer for Ctrl-C / ESC.  On break, save
002001r 2               ; CONT context and bounce to REPL.  Other keys are stashed in BAS_PENDKEY
002001r 2               ; for INKEY to retrieve.
002001r 2               ; ---------------------------------------------------------------------------
002001r 2               BasCheckBreak:
002001r 2                       ; In direct mode (CURLIN hi == $FF) skip the break check entirely;
002001r 2                       ; otherwise we would drain pending REPL keystrokes and corrupt the
002001r 2                       ; next BasReadLine input.  Break is only meaningful while RUNning.
002001r 2  AD 6A 03             lda     BAS_CURLIN+1
002004r 2  C9 FF                cmp     #$FF
002006r 2  F0 13                beq     @no
002008r 2  20 rr rr             jsr     BufferSize
00200Br 2  F0 0E                beq     @no
00200Dr 2  20 rr rr             jsr     ReadBuffer
002010r 2  C9 03                cmp     #$03
002012r 2  F0 08                beq     @break
002014r 2  C9 1B                cmp     #$1B
002016r 2  F0 04                beq     @break
002018r 2  8D 0E 03             sta     BAS_PENDKEY
00201Br 2               @no:
00201Br 2  60                   rts
00201Cr 2               @break:
00201Cr 2                       ; OLDLIN/OLDTEXT already track the executing line.  Make sure the
00201Cr 2                       ; saved values reflect the current line so CONT can resume.
00201Cr 2  AD 69 03             lda     BAS_CURLIN
00201Fr 2  8D 6B 03             sta     BAS_OLDLIN
002022r 2  AD 6A 03             lda     BAS_CURLIN+1
002025r 2  8D 6C 03             sta     BAS_OLDLIN+1
002028r 2  A2 FF                ldx     #$FF
00202Ar 2  9A                   txs
00202Br 2  20 rr rr             jsr     BasPrintCRLF
00202Er 2  A9 rr                lda     #<MsgBreak
002030r 2  A0 rr                ldy     #>MsgBreak
002032r 2  20 rr rr             jsr     BasPrintStr
002035r 2  AD 6A 03             lda     BAS_CURLIN+1
002038r 2  C9 FF                cmp     #$FF
00203Ar 2  F0 14                beq     @noLine
00203Cr 2  A9 rr                lda     #<MsgInWord
00203Er 2  A0 rr                ldy     #>MsgInWord
002040r 2  20 rr rr             jsr     BasPrintStr
002043r 2  AD 69 03             lda     BAS_CURLIN
002046r 2  85 08                sta     BAS_LINNUM
002048r 2  AD 6A 03             lda     BAS_CURLIN+1
00204Br 2  85 09                sta     BAS_LINNUM+1
00204Dr 2  20 rr rr             jsr     BasPrintLineNum
002050r 2               @noLine:
002050r 2  A9 FF                lda     #$FF
002052r 2  8D 69 03             sta     BAS_CURLIN
002055r 2  8D 6A 03             sta     BAS_CURLIN+1
002058r 2  4C rr rr             jmp     BasReadyLoop
00205Br 2               
00205Br 2  42 52 45 41  MsgBreak: .byte "BREAK",0
00205Fr 2  4B 00        
002061r 2               
002061r 2               ; ---------------------------------------------------------------------------
002061r 2               ; LinGet -- parse decimal digits at TXTPTR into BAS_LINNUM (16-bit).
002061r 2               ; Caller has set carry conditions appropriate to ChrGet entry.  TXTPTR
002061r 2               ; ends pointing at the first non-digit.
002061r 2               ; ---------------------------------------------------------------------------
002061r 2               LinGet:
002061r 2  A2 00                ldx     #0
002063r 2  86 08                stx     BAS_LINNUM
002065r 2  86 09                stx     BAS_LINNUM+1
002067r 2               @loop:
002067r 2  B0 3A                bcs     @done
002069r 2  E9 2F                sbc     #$2F                    ; carry already set
00206Br 2  85 44                sta     CHARAC
00206Dr 2                       ; LINNUM *= 10
00206Dr 2  A5 08                lda     BAS_LINNUM
00206Fr 2  85 3A                sta     BAS_TMP1
002071r 2  A5 09                lda     BAS_LINNUM+1
002073r 2  85 3B                sta     BAS_TMP1+1
002075r 2  C9 19                cmp     #$19
002077r 2  B0 2B                bcs     @ovf
002079r 2  06 08                asl     BAS_LINNUM
00207Br 2  26 09                rol     BAS_LINNUM+1
00207Dr 2  06 08                asl     BAS_LINNUM
00207Fr 2  26 09                rol     BAS_LINNUM+1
002081r 2  18                   clc
002082r 2  A5 08                lda     BAS_LINNUM
002084r 2  65 3A                adc     BAS_TMP1
002086r 2  85 08                sta     BAS_LINNUM
002088r 2  A5 09                lda     BAS_LINNUM+1
00208Ar 2  65 3B                adc     BAS_TMP1+1
00208Cr 2  85 09                sta     BAS_LINNUM+1
00208Er 2  06 08                asl     BAS_LINNUM
002090r 2  26 09                rol     BAS_LINNUM+1
002092r 2  18                   clc
002093r 2  A5 08                lda     BAS_LINNUM
002095r 2  65 44                adc     CHARAC
002097r 2  85 08                sta     BAS_LINNUM
002099r 2  90 02                bcc     @nextDigit
00209Br 2  E6 09                inc     BAS_LINNUM+1
00209Dr 2               @nextDigit:
00209Dr 2  20 rr rr             jsr     ChrGet
0020A0r 2  4C rr rr             jmp     @loop
0020A3r 2               @done:
0020A3r 2  60                   rts
0020A4r 2               @ovf:
0020A4r 2  A2 00                ldx     #ERR_SYNTAX
0020A6r 2  4C rr rr             jmp     BasErrorVec
0020A9r 2               
0020A9r 2               ; ---------------------------------------------------------------------------
0020A9r 2               ; FndLin -- find program line whose number matches BAS_LINNUM.
0020A9r 2               ;   On success: carry SET, BAS_TMP1 (LOWTR alias) = address of line.
0020A9r 2               ;   On failure: carry CLEAR, BAS_TMP1 = address where line would belong.
0020A9r 2               ; ---------------------------------------------------------------------------
0020A9r 2               FndLin:
0020A9r 2  AD 5D 03             lda     BAS_TXTTAB
0020ACr 2  AE 5E 03             ldx     BAS_TXTTAB+1
0020AFr 2               @walk:
0020AFr 2  85 3A                sta     BAS_TMP1
0020B1r 2  86 3B                stx     BAS_TMP1+1
0020B3r 2  A0 01                ldy     #1
0020B5r 2  B1 3A                lda     (BAS_TMP1),y
0020B7r 2  F0 20                beq     @notFound               ; next-hi=0 -> end of program
0020B9r 2  A0 03                ldy     #3                      ; line-num-lo offset
0020BBr 2  A5 09                lda     BAS_LINNUM+1
0020BDr 2  D1 3A                cmp     (BAS_TMP1),y            ; compare hi byte at +3? need iny
0020BFr 2                       ; Actually format: +0 next-lo, +1 next-hi, +2 num-lo, +3 num-hi
0020BFr 2  90 18                bcc     @notFound               ; LINNUM-hi < line-hi -> miss
0020C1r 2  D0 09                bne     @advance                ; LINNUM-hi > line-hi -> next line
0020C3r 2  88                   dey                             ; y=2 = num-lo
0020C4r 2  A5 08                lda     BAS_LINNUM
0020C6r 2  D1 3A                cmp     (BAS_TMP1),y
0020C8r 2  90 0F                bcc     @notFound
0020CAr 2  F0 0F                beq     @found
0020CCr 2               @advance:
0020CCr 2  A0 00                ldy     #0
0020CEr 2  B1 3A                lda     (BAS_TMP1),y
0020D0r 2  48                   pha
0020D1r 2  A0 01                ldy     #1
0020D3r 2  B1 3A                lda     (BAS_TMP1),y
0020D5r 2  AA                   tax
0020D6r 2  68                   pla
0020D7r 2  B0 D6                bcs     @walk                   ; carry=1 means continue (always)
0020D9r 2               @notFound:
0020D9r 2  18                   clc
0020DAr 2  60                   rts
0020DBr 2               @found:
0020DBr 2  38                   sec
0020DCr 2  60                   rts
0020DDr 2               
0020DDr 2               ; ---------------------------------------------------------------------------
0020DDr 2               ; BasCmdGoto -- TXTPTR points at line-number digits.
0020DDr 2               ; ---------------------------------------------------------------------------
0020DDr 2               BasCmdGoto:
0020DDr 2  20 rr rr             jsr     LinGet
0020E0r 2  20 rr rr             jsr     BasRemn                 ; skip remainder of statement
0020E3r 2  20 rr rr             jsr     FndLin
0020E6r 2  90 0E                bcc     @undef
0020E8r 2                       ; LOWTR (BAS_TMP1) = target line addr.  TXTPTR = LOWTR - 1
0020E8r 2                       ; (so NEWSTT sees the previous line's $00 terminator at offset 0).
0020E8r 2  38                   sec
0020E9r 2  A5 3A                lda     BAS_TMP1
0020EBr 2  E9 01                sbc     #1
0020EDr 2  85 04                sta     TXTPTR
0020EFr 2  A5 3B                lda     BAS_TMP1+1
0020F1r 2  E9 00                sbc     #0
0020F3r 2  85 05                sta     TXTPTR+1
0020F5r 2  60                   rts
0020F6r 2               @undef:
0020F6r 2  A2 03                ldx     #ERR_UNDEFSTMT
0020F8r 2  4C rr rr             jmp     BasErrorVec
0020FBr 2               
0020FBr 2               ; ---------------------------------------------------------------------------
0020FBr 2               ; BasCmdGosub -- push 5-byte frame on stack, then GOTO target.
0020FBr 2               ; Frame layout (top-down): [tag $8C][CURLIN-lo][CURLIN-hi][TXTPTR-lo][TXTPTR-hi]
0020FBr 2               ; ---------------------------------------------------------------------------
0020FBr 2               BasCmdGosub:
0020FBr 2                       ; Refuse to nest deeper than page 1 can hold.  msbasic guards every
0020FBr 2                       ; stack-frame push with GETSTK; this is that check specialised to
0020FBr 2                       ; GOSUB's fixed frame (msbasic's `LDA #3 : JSR GETSTK`, i.e. 3*2
0020FBr 2                       ; bytes of frame plus GETSTK's $3E-byte margin for the interpreter's
0020FBr 2                       ; own JSR nesting inside the subroutine).  Without it the frames run
0020FBr 2                       ; off the bottom of the stack and corrupt page 1 instead of raising
0020FBr 2                       ; an error.
0020FBr 2  BA                   tsx
0020FCr 2  E0 44                cpx     #GOSUB_STACK_MIN
0020FEr 2  90 1A                bcc     @outOfMemory
002100r 2  A5 05                lda     TXTPTR+1
002102r 2  48                   pha
002103r 2  A5 04                lda     TXTPTR
002105r 2  48                   pha
002106r 2  AD 6A 03             lda     BAS_CURLIN+1
002109r 2  48                   pha
00210Ar 2  AD 69 03             lda     BAS_CURLIN
00210Dr 2  48                   pha
00210Er 2  A9 8C                lda     #TOK_GOSUB
002110r 2  48                   pha
002111r 2  20 rr rr             jsr     ChrGot
002114r 2  20 rr rr             jsr     BasCmdGoto
002117r 2  4C rr rr             jmp     BasNewstt
00211Ar 2               @outOfMemory:
00211Ar 2  A9 02                lda     #ERR_OUTOFMEM
00211Cr 2  4C rr rr             jmp     BasError
00211Fr 2               
00211Fr 2               ; ---------------------------------------------------------------------------
00211Fr 2               ; BasCmdReturn -- locate GOSUB frame on stack and resume at saved TXTPTR.
00211Fr 2               ; Per msbasic: scan the CPU stack from SP+5 (skipping return-routine's caller
00211Fr 2               ; return + this scan's own JSR return).  RTS at end pops the leaked
00211Fr 2               ; EXEC-return that GOSUB left behind.
00211Fr 2               ; ---------------------------------------------------------------------------
00211Fr 2               BasCmdReturn:
00211Fr 2  20 rr rr             jsr     GtForPnt
002122r 2                       ; X now points to the slot just BELOW a frame tag (or end of stack).
002122r 2  9A                   txs
002123r 2  C9 8C                cmp     #TOK_GOSUB
002125r 2  F0 05                beq     @ok
002127r 2  A2 0C                ldx     #ERR_RG
002129r 2  4C rr rr             jmp     BasErrorVec
00212Cr 2               @ok:
00212Cr 2  68                   pla                             ; tag (already in A, this discards)
00212Dr 2  68                   pla
00212Er 2  8D 69 03             sta     BAS_CURLIN
002131r 2  68                   pla
002132r 2  8D 6A 03             sta     BAS_CURLIN+1
002135r 2  68                   pla
002136r 2  85 04                sta     TXTPTR
002138r 2  68                   pla
002139r 2  85 05                sta     TXTPTR+1
00213Br 2                       ; Skip remainder of GOSUB-target statement (DATAN-style).
00213Br 2  20 rr rr             jsr     BasDatan
00213Er 2                       ; Advance TXTPTR by Y (number of bytes to terminator).
00213Er 2  98                   tya
00213Fr 2  18                   clc
002140r 2  65 04                adc     TXTPTR
002142r 2  85 04                sta     TXTPTR
002144r 2  90 02                bcc     @noinc
002146r 2  E6 05                inc     TXTPTR+1
002148r 2               @noinc:
002148r 2  60                   rts
002149r 2               
002149r 2               ; ---------------------------------------------------------------------------
002149r 2               ; GtForPnt -- scan CPU stack for FOR/GOSUB frames.
002149r 2               ;   On entry: BAS_FORPNT (FORPNT) = $FFxx for "match any tag".
002149r 2               ;   Returns: X = stack pointer where the matching frame's tag-1 lives,
002149r 2               ;            A = tag byte found (or 0 if end-of-stack).  Z=1 if found tag,
002149r 2               ;            Z=0 (A=0) if no frame found.
002149r 2               ; ---------------------------------------------------------------------------
002149r 2               GtForPnt:
002149r 2  BA                   tsx
00214Ar 2  E8                   inx
00214Br 2  E8                   inx
00214Cr 2  E8                   inx
00214Dr 2  E8                   inx
00214Er 2               @scan:
00214Er 2  BD 01 01             lda     $0101,x                 ; tag candidate
002151r 2  C9 81                cmp     #TOK_FOR
002153r 2  D0 25                bne     @notFor
002155r 2                       ; Compare frame's variable address to FORPNT.
002155r 2  A5 47                lda     BAS_FORPNT+1
002157r 2  D0 0A                bne     @skipVar                ; FORPNT+1 = $FF -> skip variable test
002159r 2  BD 02 01             lda     $0102,x
00215Cr 2  85 46                sta     BAS_FORPNT
00215Er 2  BD 03 01             lda     $0103,x
002161r 2  85 47                sta     BAS_FORPNT+1
002163r 2               @skipVar:
002163r 2  DD 03 01             cmp     $0103,x
002166r 2  D0 07                bne     @advance
002168r 2  A5 46                lda     BAS_FORPNT
00216Ar 2  DD 02 01             cmp     $0102,x
00216Dr 2  F0 13                beq     @found
00216Fr 2               @advance:
00216Fr 2  8A                   txa
002170r 2  18                   clc
002171r 2  69 12                adc     #18                     ; BYTES_PER_FRAME (FOR)
002173r 2  AA                   tax
002174r 2  D0 D8                bne     @scan
002176r 2                       ; Walked off stack
002176r 2  A9 00                lda     #0
002178r 2  18                   clc                             ; not found
002179r 2  60                   rts
00217Ar 2               @notFor:
00217Ar 2  C9 8C                cmp     #TOK_GOSUB
00217Cr 2  F0 04                beq     @found
00217Er 2  A9 00                lda     #0
002180r 2  18                   clc                             ; not found
002181r 2  60                   rts
002182r 2               @found:
002182r 2  38                   sec                             ; found; A still holds the tag or FORPNT
002183r 2  60                   rts
002184r 2               
002184r 2               ; ---------------------------------------------------------------------------
002184r 2               ; BasRemn -- scan TXTPTR forward to next ':' or end-of-line.
002184r 2               ; Sets Y to byte offset of terminator from current TXTPTR.  Honours quotes.
002184r 2               ; ---------------------------------------------------------------------------
002184r 2               BasDatan:
002184r 2  A2 3A                ldx     #':'
002186r 2  2C                   .byte   $2C                     ; BIT abs absorbs next 2-byte LDX
002187r 2               BasRemn:
002187r 2  A2 00                ldx     #0
002189r 2  86 44                stx     CHARAC
00218Br 2  A0 00                ldy     #0
00218Dr 2  84 6A                sty     ENDCHR
00218Fr 2               @swap:
00218Fr 2  A5 6A                lda     ENDCHR
002191r 2  A6 44                ldx     CHARAC
002193r 2  85 44                sta     CHARAC
002195r 2  86 6A                stx     ENDCHR
002197r 2               @scan:
002197r 2  B1 04                lda     (TXTPTR),y
002199r 2  F0 0B                beq     @done
00219Br 2  C5 6A                cmp     ENDCHR
00219Dr 2  F0 07                beq     @done
00219Fr 2  C8                   iny
0021A0r 2  C9 22                cmp     #'"'
0021A2r 2  F0 EB                beq     @swap
0021A4r 2  D0 F1                bne     @scan
0021A6r 2               @done:
0021A6r 2  60                   rts
0021A7r 2               
0021A7r 2               ; ---------------------------------------------------------------------------
0021A7r 2               ; Statement: REM -- skip to end of line.
0021A7r 2               ; Statement: DATA -- treated like REM at execution time (just skip).
0021A7r 2               ; ---------------------------------------------------------------------------
0021A7r 2               BasCmdRem:
0021A7r 2  20 rr rr             jsr     BasRemn
0021AAr 2  80 03                bra     BasAddon
0021ACr 2               BasCmdData:
0021ACr 2  20 rr rr             jsr     BasDatan
0021AFr 2               BasAddon:
0021AFr 2  98                   tya
0021B0r 2  18                   clc
0021B1r 2  65 04                adc     TXTPTR
0021B3r 2  85 04                sta     TXTPTR
0021B5r 2  90 02                bcc     @done
0021B7r 2  E6 05                inc     TXTPTR+1
0021B9r 2               @done:
0021B9r 2  60                   rts
0021BAr 2               
0021BAr 2               ; ---------------------------------------------------------------------------
0021BAr 2               ; Statement: IF expr THEN (linenum | stmt) [ELSE stmt]
0021BAr 2               ;   IF expr GOTO linenum is also accepted.
0021BAr 2               ;   If expr is false, skip rest of line (REM-style).
0021BAr 2               ;   ELSE: scan ahead for TOK_ELSE on this line.
0021BAr 2               ; ---------------------------------------------------------------------------
0021BAr 2               BasCmdIf:
0021BAr 2  20 rr rr             jsr     FrmEvl
0021BDr 2  20 rr rr             jsr     ChrGot
0021C0r 2  C9 88                cmp     #TOK_GOTO
0021C2r 2  F0 05                beq     @testTrue
0021C4r 2  A9 9F                lda     #TOK_THEN
0021C6r 2  20 rr rr             jsr     SynChr
0021C9r 2               @testTrue:
0021C9r 2  A5 0E                lda     FAC
0021CBr 2  D0 1E                bne     @true
0021CDr 2                       ; FALSE: scan to end-of-line OR a TOK_ELSE; if ELSE found, advance
0021CDr 2                       ; TXTPTR past it and resume execution there.
0021CDr 2  A0 00                ldy     #0
0021CFr 2               @searchElse:
0021CFr 2  B1 04                lda     (TXTPTR),y
0021D1r 2  F0 07                beq     @noElse
0021D3r 2  C9 A4                cmp     #TOK_ELSE
0021D5r 2  F0 09                beq     @gotElse
0021D7r 2  C8                   iny
0021D8r 2  D0 F5                bne     @searchElse
0021DAr 2               @noElse:
0021DAr 2                       ; Skip remainder of line (no ELSE).
0021DAr 2  20 rr rr             jsr     BasRemn
0021DDr 2  4C rr rr             jmp     BasAddon
0021E0r 2               @gotElse:
0021E0r 2                       ; Advance TXTPTR past ELSE token, then run the ELSE branch as a
0021E0r 2                       ; statement.  Falling through to @true's tail is deliberate: the
0021E0r 2                       ; branch after ELSE is dispatched exactly like the one after THEN,
0021E0r 2                       ; so `ELSE <linenum>` is an implicit GOTO too.  Returning here
0021E0r 2                       ; instead would leave TXTPTR mid-statement and the interpreter loop
0021E0r 2                       ; would report ?SYNTAX ERROR.
0021E0r 2  C8                   iny
0021E1r 2  98                   tya
0021E2r 2  18                   clc
0021E3r 2  65 04                adc     TXTPTR
0021E5r 2  85 04                sta     TXTPTR
0021E7r 2  90 02                bcc     @true
0021E9r 2  E6 05                inc     TXTPTR+1
0021EBr 2               @true:
0021EBr 2                       ; TRUE: if next is a digit, IF expr THEN <linenum> -> implicit GOTO.
0021EBr 2  20 rr rr             jsr     ChrGot
0021EEr 2  90 03                bcc     @goto                   ; carry CLEAR -> digit
0021F0r 2                       ; Otherwise dispatch as a statement (msbasic: jmp EXECUTE_STATEMENT).
0021F0r 2  4C rr rr             jmp     BasExecuteStatement
0021F3r 2               @goto:
0021F3r 2  4C rr rr             jmp     BasCmdGoto
0021F6r 2               
0021F6r 2               ; ---------------------------------------------------------------------------
0021F6r 2               ; Statement: ON expr GOTO/GOSUB linenum,linenum,...
0021F6r 2               ; ---------------------------------------------------------------------------
0021F6r 2               BasCmdOn:
0021F6r 2  20 rr rr             jsr     GetByt                  ; X = expr byte (1..255)
0021F9r 2  48                   pha                             ; save GOTO/GOSUB token byte
0021FAr 2  C9 8C                cmp     #TOK_GOSUB
0021FCr 2  F0 04                beq     @loop
0021FEr 2  C9 88                cmp     #TOK_GOTO
002200r 2  D0 14                bne     @synErr
002202r 2               @loop:
002202r 2  C6 12                dec     FAC+4
002204r 2  D0 04                bne     @next
002206r 2  68                   pla
002207r 2                       ; Re-dispatch through statement table so trampoline ChrGet skips the
002207r 2                       ; current separator (',' or 0) before the GOTO/GOSUB handler runs.
002207r 2  4C rr rr             jmp     BasExecuteStatement
00220Ar 2               @next:
00220Ar 2  20 rr rr             jsr     ChrGet
00220Dr 2  20 rr rr             jsr     LinGet
002210r 2  C9 2C                cmp     #','
002212r 2  F0 EE                beq     @loop
002214r 2  68                   pla
002215r 2  60                   rts
002216r 2               @synErr:
002216r 2  68                   pla
002217r 2  4C rr rr             jmp     SynErr
00221Ar 2               
00221Ar 2               ; ---------------------------------------------------------------------------
00221Ar 2               ; GetByt / GtByteCom -- evaluate expression in TXTPTR to byte 0..255 in X.
00221Ar 2               ;   GetByt: TXTPTR is at first byte of expression.
00221Ar 2               ;   GtByteCom: consume comma first.
00221Ar 2               ; ---------------------------------------------------------------------------
00221Ar 2               GtByteCom:
00221Ar 2  20 rr rr             jsr     ChrGet
00221Dr 2               GetByt:
00221Dr 2  20 rr rr             jsr     FrmNum
002220r 2  20 rr rr             jsr     MkInt
002223r 2  A6 11                ldx     FAC+3
002225r 2  D0 05                bne     @ovf
002227r 2  A6 12                ldx     FAC+4
002229r 2  4C rr rr             jmp     ChrGot
00222Cr 2               @ovf:
00222Cr 2  4C rr rr             jmp     IqErr
00222Fr 2               
00222Fr 2               ; ---------------------------------------------------------------------------
00222Fr 2               ; Statement: RUN [linenum]
00222Fr 2               ; ---------------------------------------------------------------------------
00222Fr 2               BasCmdRun:
00222Fr 2  20 rr rr             jsr     ChrGot
002232r 2  D0 1F                bne     @withLine
002234r 2  20 rr rr             jsr     BasCmdClr
002237r 2                       ; Set TXTPTR = TXTTAB - 1 ; ensure that byte = 0.
002237r 2  38                   sec
002238r 2  AD 5D 03             lda     BAS_TXTTAB
00223Br 2  E9 01                sbc     #1
00223Dr 2  85 04                sta     TXTPTR
00223Fr 2  AD 5E 03             lda     BAS_TXTTAB+1
002242r 2  E9 00                sbc     #0
002244r 2  85 05                sta     TXTPTR+1
002246r 2                       ; Force the byte at TXTTAB-1 to be zero so NEWSTT walks the chain.
002246r 2  A9 00                lda     #0
002248r 2  A0 00                ldy     #0
00224Ar 2  91 04                sta     (TXTPTR),y
00224Cr 2                       ; Leave direct-mode (CURLIN+1=$FF); @loadLine will set real value.
00224Cr 2  9C 69 03             stz     BAS_CURLIN
00224Fr 2  9C 6A 03             stz     BAS_CURLIN+1
002252r 2  60                   rts
002253r 2               @withLine:
002253r 2  20 rr rr             jsr     BasCmdClr
002256r 2  20 rr rr             jsr     ChrGot
002259r 2  20 rr rr             jsr     BasCmdGoto              ; does not return if the line is undefined
00225Cr 2                       ; Leave direct mode, exactly as the bare RUN path above does.
00225Cr 2                       ; BasCmdGoto only moves TXTPTR; while CURLIN+1 is still $FF, BasNewstt
00225Cr 2                       ; treats the branch target as an immediate-mode statement and returns
00225Cr 2                       ; to the READY loop after it -- so `RUN 20` printed nothing at all.
00225Cr 2                       ; Set after the branch, not before, so an undefined line still reports
00225Cr 2                       ; `?UNDEF'D STATEMENT ERROR` with no spurious `IN 0` line number.
00225Cr 2  9C 69 03             stz     BAS_CURLIN
00225Fr 2  9C 6A 03             stz     BAS_CURLIN+1
002262r 2  60                   rts
002263r 2               
002263r 2               ; ---------------------------------------------------------------------------
002263r 2               ; Statement: END / STOP -- save CONT context and return to REPL.
002263r 2               ; ---------------------------------------------------------------------------
002263r 2               BasCmdEnd:
002263r 2  18                   clc
002264r 2  24                   .byte   $24                     ; BIT zp -> skip next byte (sec)
002265r 2               BasCmdStop:
002265r 2  38                   sec
002266r 2                       ; Save the END/STOP flag (carry) before ChrGot clobbers it.
002266r 2  08                   php
002267r 2  20 rr rr             jsr     ChrGot
00226Ar 2  D0 57                bne     @synErrPlp
00226Cr 2  28                   plp
00226Dr 2                       ; Save CONT state.
00226Dr 2  A5 04                lda     TXTPTR
00226Fr 2  8D 6D 03             sta     BAS_OLDTEXT
002272r 2  A5 05                lda     TXTPTR+1
002274r 2  8D 6E 03             sta     BAS_OLDTEXT+1
002277r 2  AD 69 03             lda     BAS_CURLIN
00227Ar 2  8D 6B 03             sta     BAS_OLDLIN
00227Dr 2  AD 6A 03             lda     BAS_CURLIN+1
002280r 2  8D 6C 03             sta     BAS_OLDLIN+1
002283r 2  A2 FF                ldx     #$FF
002285r 2  9A                   txs
002286r 2  90 30                bcc     @end
002288r 2                       ; STOP path: print "BREAK[ IN nnnn]".
002288r 2  20 rr rr             jsr     BasPrintCRLF
00228Br 2  A9 rr                lda     #<MsgBreak
00228Dr 2  A0 rr                ldy     #>MsgBreak
00228Fr 2  20 rr rr             jsr     BasPrintStr
002292r 2  AD 6A 03             lda     BAS_CURLIN+1
002295r 2  C9 FF                cmp     #$FF
002297r 2  F0 14                beq     @endNoLine
002299r 2  A9 rr                lda     #<MsgInWord
00229Br 2  A0 rr                ldy     #>MsgInWord
00229Dr 2  20 rr rr             jsr     BasPrintStr
0022A0r 2  AD 69 03             lda     BAS_CURLIN
