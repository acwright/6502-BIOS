0023F6r 2               
0023F6r 2               ; ---------------------------------------------------------------------------
0023F6r 2               ; Statement: READ var[,var,...] -- pull next DATA item from BAS_DATAPTR
0023F6r 2               ; into the variable pointed to by PtrGet.
0023F6r 2               ; ---------------------------------------------------------------------------
0023F6r 2               ; ---------------------------------------------------------------------------
0023F6r 2               ; BasStrItem -- read one string item at TXTPTR into the variable BAS_FORPNT
0023F6r 2               ; points at.  Shared by INPUT and READ, which differ only in what ends an
0023F6r 2               ; unquoted item: INPUT stops at ',' or NUL, READ also stops at ':' because a
0023F6r 2               ; DATA statement can be followed by another statement on the same line.
0023F6r 2               ;
0023F6r 2               ; On entry : X        = the extra unquoted terminator (StrLt2's CHARAC)
0023F6r 2               ;            TXTPTR   = first character of the item
0023F6r 2               ;            FORPNT   = the variable's 3-byte descriptor slot
0023F6r 2               ; On exit  : TXTPTR advanced past the item, descriptor stored, temp popped.
0023F6r 2               ; ---------------------------------------------------------------------------
0023F6r 2               BasStrItem:
0023F6r 2                       ; A '"' here means quote-mode (terminator '"' or NUL); anything else
0023F6r 2                       ; is a bare item running to X, ',' or NUL.
0023F6r 2  A0 00                ldy     #0
0023F8r 2  B1 04                lda     (TXTPTR),y
0023FAr 2  C9 22                cmp     #'"'
0023FCr 2  F0 0C                beq     @quoted
0023FEr 2  86 44                stx     CHARAC
002400r 2  A9 2C                lda     #','
002402r 2  85 6A                sta     ENDCHR
002404r 2  A5 04                lda     TXTPTR                  ; StrLt2's source = TXTPTR
002406r 2  A4 05                ldy     TXTPTR+1
002408r 2  80 0E                bra     @call
00240Ar 2               @quoted:
00240Ar 2  85 44                sta     CHARAC                  ; A is still '"' from the compare
00240Cr 2  85 6A                sta     ENDCHR
00240Er 2  18                   clc                             ; skip it: source = TXTPTR + 1
00240Fr 2  A5 04                lda     TXTPTR
002411r 2  69 01                adc     #1
002413r 2  A4 05                ldy     TXTPTR+1
002415r 2  90 01                bcc     @call
002417r 2  C8                   iny
002418r 2               @call:
002418r 2  20 rr rr             jsr     StrLt2
00241Br 2                       ; StrLt2 leaves STRNG2 past the text it consumed -- at the terminator
00241Br 2                       ; for an unquoted item, just past the closing '"' for a quoted one.
00241Br 2                       ; TXTPTR has to follow it: for INPUT so the trailing-extra check sees
00241Br 2                       ; only what really remained on the line, and for READ so the next one
00241Br 2                       ; doesn't start again in the middle of the item this one took.
00241Br 2  A5 1E                lda     STRNG2
00241Dr 2  85 04                sta     TXTPTR
00241Fr 2  A5 1F                lda     STRNG2+1
002421r 2  85 05                sta     TXTPTR+1
002423r 2  A0 00                ldy     #0
002425r 2  A5 0E                lda     FAC
002427r 2  91 46                sta     (BAS_FORPNT),y
002429r 2  C8                   iny
00242Ar 2  A5 0F                lda     FAC+1
00242Cr 2  91 46                sta     (BAS_FORPNT),y
00242Er 2  C8                   iny
00242Fr 2  A5 10                lda     FAC+2
002431r 2  91 46                sta     (BAS_FORPNT),y
002433r 2                       ; StrLt2 pushed a temporary descriptor via PutNew.  The variable owns
002433r 2                       ; the heap copy now, so pop the temp -- do NOT use FreFac, which would
002433r 2                       ; reclaim the heap we just handed over.  Leaving temps unfreed leaks
002433r 2                       ; the 3-slot temp stack, both overflowing it (?FORMULA TOO COMPLEX)
002433r 2                       ; and corrupting later strings via stale descriptor pointers.
002433r 2  A5 11                lda     FAC+3
002435r 2  A4 12                ldy     FAC+4
002437r 2  4C rr rr             jmp     FreTms
00243Ar 2               
00243Ar 2               BasCmdRead:
00243Ar 2  AE 1A 03             ldx     BAS_DATAPTR
00243Dr 2  AC 1B 03             ldy     BAS_DATAPTR+1
002440r 2  A9 98                lda     #$98                    ; INPUTFLG = $98 means READ mode
002442r 2  2C                   .byte   $2C
002443r 2               BasInpDoit:
002443r 2  A9 00                lda     #0
002445r 2  85 69                sta     BAS_INPUTFLG
002447r 2  86 3A                stx     BAS_TMP1                ; TMP1 = data pointer
002449r 2  84 3B                sty     BAS_TMP1+1
00244Br 2               @nextVar:
00244Br 2                       ; TXTPTR currently points into program at variable name.
00244Br 2  20 rr rr             jsr     PtrGet                  ; advances TXTPTR past var name
00244Er 2  85 46                sta     BAS_FORPNT
002450r 2  84 47                sty     BAS_FORPNT+1
002452r 2                       ; Save program TXTPTR on hw stack, switch TXTPTR to data ptr.
002452r 2  A5 05                lda     TXTPTR+1
002454r 2  48                   pha
002455r 2  A5 04                lda     TXTPTR
002457r 2  48                   pha
002458r 2  A5 3A                lda     BAS_TMP1
00245Ar 2  85 04                sta     TXTPTR
00245Cr 2  A5 3B                lda     BAS_TMP1+1
00245Er 2  85 05                sta     TXTPTR+1
002460r 2  20 rr rr             jsr     ChrGot
002463r 2  D0 08                bne     @gotData
002465r 2                       ; Out of items on this line - find next DATA.
002465r 2  20 rr rr             jsr     BasFindData
002468r 2  90 03                bcc     @gotData
00246Ar 2  4C rr rr             jmp     @oodata
00246Dr 2               @gotData:
00246Dr 2                       ; Advance past separator (',' between items, ' ' after DATA token,
00246Dr 2                       ; or quote-delimiter for strings).  ChrGet also skips spaces.
00246Dr 2  20 rr rr             jsr     ChrGet
002470r 2                       ; Parse value at TXTPTR (data side).
002470r 2  24 64                bit     VALTYP
002472r 2  30 0C                bmi     @readStr
002474r 2                       ; Numeric.
002474r 2  20 rr rr             jsr     Fin
002477r 2  A6 46                ldx     BAS_FORPNT
002479r 2  A4 47                ldy     BAS_FORPNT+1
00247Br 2  20 rr rr             jsr     StoreFacAtYxRounded
00247Er 2  80 05                bra     @afterStore
002480r 2               @readStr:
002480r 2                       ; Previously this called StrLt2 without setting up its (A,Y) source
002480r 2                       ; argument at all, so every DATA string pointed into zero page: an
002480r 2                       ; unquoted item read back empty and a quoted one read back as garbage
002480r 2                       ; from $0022.  BasStrItem is INPUT's path, which had it right.
002480r 2  A2 3A                ldx     #':'                    ; a DATA item also ends at a statement break
002482r 2  20 rr rr             jsr     BasStrItem
002485r 2               @afterStore:
002485r 2                       ; Save updated data ptr.
002485r 2  A5 04                lda     TXTPTR
002487r 2  85 3A                sta     BAS_TMP1
002489r 2  A5 05                lda     TXTPTR+1
00248Br 2  85 3B                sta     BAS_TMP1+1
00248Dr 2                       ; Restore program TXTPTR.
00248Dr 2  68                   pla
00248Er 2  85 04                sta     TXTPTR
002490r 2  68                   pla
002491r 2  85 05                sta     TXTPTR+1
002493r 2                       ; If next program byte is ',', another variable follows.
002493r 2  20 rr rr             jsr     ChrGot
002496r 2  C9 2C                cmp     #','
002498r 2  D0 05                bne     @done
00249Ar 2  20 rr rr             jsr     ChrGet
00249Dr 2  80 AC                bra     @nextVar
00249Fr 2               @done:
00249Fr 2                       ; Persist data ptr.
00249Fr 2  A5 3A                lda     BAS_TMP1
0024A1r 2  8D 1A 03             sta     BAS_DATAPTR
0024A4r 2  A5 3B                lda     BAS_TMP1+1
0024A6r 2  8D 1B 03             sta     BAS_DATAPTR+1
0024A9r 2  60                   rts
0024AAr 2               @oodata:
0024AAr 2  A2 0E                ldx     #ERR_OD
0024ACr 2  4C rr rr             jmp     BasErrorVec
0024AFr 2               
0024AFr 2               ; ---------------------------------------------------------------------------
0024AFr 2               ; BasFindData -- starting from TXTPTR (positioned somewhere within a line's
0024AFr 2               ; payload), advance to the byte after the next DATA token in the program.
0024AFr 2               ; Returns carry SET on out-of-data, carry CLEAR with TXTPTR at first byte
0024AFr 2               ; AFTER the DATA token (i.e. at the first DATA item).
0024AFr 2               ; ---------------------------------------------------------------------------
0024AFr 2               BasFindData:
0024AFr 2               @scanByte:
0024AFr 2  A0 00                ldy     #0
0024B1r 2  B1 04                lda     (TXTPTR),y
0024B3r 2  F0 1F                beq     @atEnd
0024B5r 2  C9 83                cmp     #TOK_DATA
0024B7r 2  F0 2E                beq     @found
0024B9r 2  C9 22                cmp     #'"'
0024BBr 2  D0 12                bne     @advance1
0024BDr 2                       ; Skip quoted string (advance TXTPTR past closing quote or NUL).
0024BDr 2  20 rr rr             jsr     @incTxt
0024C0r 2               @inStr:
0024C0r 2  A0 00                ldy     #0
0024C2r 2  B1 04                lda     (TXTPTR),y
0024C4r 2  F0 0E                beq     @atEnd
0024C6r 2  20 rr rr             jsr     @incTxt
0024C9r 2  C9 22                cmp     #'"'
0024CBr 2  D0 F3                bne     @inStr
0024CDr 2  80 E0                bra     @scanByte
0024CFr 2               @advance1:
0024CFr 2  20 rr rr             jsr     @incTxt
0024D2r 2  80 DB                bra     @scanByte
0024D4r 2               @atEnd:
0024D4r 2                       ; (TXTPTR) is on the line's $00 terminator.  Bytes immediately after
0024D4r 2                       ; are the next line's [next-lo][next-hi][num-lo][num-hi][payload..].
0024D4r 2                       ; Check next-pointer at offset +2 (next-hi); if 0, end of program.
0024D4r 2  A0 02                ldy     #2
0024D6r 2  B1 04                lda     (TXTPTR),y
0024D8r 2  F0 0F                beq     @oodata
0024DAr 2                       ; Advance TXTPTR by 5: past terminator (1) + line header (4).
0024DAr 2  18                   clc
0024DBr 2  A5 04                lda     TXTPTR
0024DDr 2  69 05                adc     #5
0024DFr 2  85 04                sta     TXTPTR
0024E1r 2  90 CC                bcc     @scanByte
0024E3r 2  E6 05                inc     TXTPTR+1
0024E5r 2  80 C8                bra     @scanByte
0024E7r 2               @found:
0024E7r 2                       ; TXTPTR is left AT the TOK_DATA byte; caller's CHRGET advances past.
0024E7r 2  18                   clc
0024E8r 2  60                   rts
0024E9r 2               @oodata:
0024E9r 2  38                   sec
0024EAr 2  60                   rts
0024EBr 2               @incTxt:
0024EBr 2  E6 04                inc     TXTPTR
0024EDr 2  D0 02                bne     @r
0024EFr 2  E6 05                inc     TXTPTR+1
0024F1r 2               @r:
0024F1r 2  60                   rts
0024F2r 2               
0024F2r 2               ; ---------------------------------------------------------------------------
0024F2r 2               ; Statement: FOR var = expr1 TO expr2 [STEP expr3]
0024F2r 2               ; Pushes 18-byte frame on CPU stack:
0024F2r 2               ;   [tag $81][VAR-lo][VAR-hi][STEP-FP (5)][STEP-sign][CURLIN-lo][CURLIN-hi]
0024F2r 2               ;   [TXTPTR-lo][TXTPTR-hi][LIMIT-FP (5)]
0024F2r 2               ; ---------------------------------------------------------------------------
0024F2r 2               BasCmdFor:
0024F2r 2                       ; Set SUBFLG so PtrGet doesn't recurse on FN.
0024F2r 2  A9 80                lda     #$80
0024F4r 2  85 68                sta     SUBFLG
0024F6r 2  20 rr rr             jsr     BasCmdLet               ; consumes "var = expr"
0024F9r 2                       ; PtrGet (inside LET) saved VARPNT in FORPNT (hopefully). Re-fetch
0024F9r 2                       ; FORPNT from the assignment, but BasCmdLet doesn't set FORPNT in
0024F9r 2                       ; our impl.  Re-parse the variable name by rewinding TXTPTR via
0024F9r 2                       ; CURLIN scan.  Cheat: BasCmdLet leaves VARPNT current.
0024F9r 2  A5 3F                lda     VARPNT
0024FBr 2  85 46                sta     BAS_FORPNT
0024FDr 2  A5 40                lda     VARPNT+1
0024FFr 2  85 47                sta     BAS_FORPNT+1
002501r 2                       ; Discard any prior FOR frame for the same variable to avoid leak.
002501r 2  20 rr rr             jsr     GtForPnt
002504r 2  D0 00                bne     @noOld                  ; Z=0 -> not found (lda #0 sets Z=1; we invert below)
002506r 2                       ; Actually GtForPnt's "not found" path also ends with `lda #0;rts` (Z=1).
002506r 2                       ; So the BEQ/BNE distinction can't be used. Skip the prior-frame
002506r 2                       ; pop entirely; the runtime can tolerate one stray frame and msbasic
002506r 2                       ; FOR re-uses the same slot only when an explicit FOR with a matching
002506r 2                       ; variable already exists, which is rare.
002506r 2               @noOld:
002506r 2                       ; Discard our caller's (BasExecuteStatement's) return address so
002506r 2                       ; that the FOR frame sits on the stack with no other junk above it.
002506r 2                       ; We will JMP BasNewstt at the end instead of RTSing.
002506r 2  68                   pla
002507r 2  68                   pla
002508r 2                       ; Push limit (will be parsed below) -- we lay out the frame as:
002508r 2                       ;   pushed first (deepest): TXTPTR, CURLIN, LIMIT (5), STEP-sign,
002508r 2                       ;   STEP (5), VAR-addr, $81-tag.
002508r 2                       ; We don't know LIMIT/STEP yet; we push placeholders and patch.
002508r 2                       ; Easier: parse limit & step first, then push frame in one go.
002508r 2  A9 9C                lda     #TOK_TO
00250Ar 2  20 rr rr             jsr     SynChr
00250Dr 2  20 rr rr             jsr     FrmNum
002510r 2                       ; Strip sign info on limit (msbasic stores limit unsigned-magnitude
002510r 2                       ; with sign packed).  Pack FACSIGN bit 7 -> FAC+1 bit 7.
002510r 2  A5 13                lda     FACSIGN
002512r 2  09 7F                ora     #$7F
002514r 2  25 0F                and     FAC+1
002516r 2  85 0F                sta     FAC+1
002518r 2                       ; Save LIMIT temporarily in BAS_TEMP1..+4 (5 bytes).
002518r 2  A2 04                ldx     #4
00251Ar 2               @saveLimit:
00251Ar 2  B5 0E                lda     FAC,x
00251Cr 2  95 4D                sta     BAS_TEMP1,x
00251Er 2  CA                   dex
00251Fr 2  10 F9                bpl     @saveLimit
002521r 2                       ; STEP: default 1, or evaluate after TOK_STEP.
002521r 2  20 rr rr             jsr     ChrGot
002524r 2  C9 A1                cmp     #TOK_STEP
002526r 2  D0 08                bne     @defStep
002528r 2  20 rr rr             jsr     ChrGet
00252Br 2  20 rr rr             jsr     FrmNum
00252Er 2  80 07                bra     @gotStep
002530r 2               @defStep:
002530r 2  A9 rr                lda     #<ConstOne
002532r 2  A0 rr                ldy     #>ConstOne
002534r 2  20 rr rr             jsr     LoadFacFromYa
002537r 2               @gotStep:
002537r 2  20 rr rr             jsr     Sign                    ; A = step sign byte (-1/0/1)
00253Ar 2  85 52                sta     BAS_TEMP2               ; stash step sign
00253Cr 2                       ; Pack sign of FAC into FAC+1 bit7 then save STEP into BAS_TEMP2+1..+5.
00253Cr 2  A5 13                lda     FACSIGN
00253Er 2  09 7F                ora     #$7F
002540r 2  25 0F                and     FAC+1
002542r 2  85 0F                sta     FAC+1
002544r 2  A2 04                ldx     #4
002546r 2               @saveStep:
002546r 2  B5 0E                lda     FAC,x
002548r 2  95 53                sta     BAS_TEMP2+1,x
00254Ar 2  CA                   dex
00254Br 2  10 F9                bpl     @saveStep
00254Dr 2                       ; Now push the frame on stack (deepest first):
00254Dr 2                       ;   TXTPTR-hi, TXTPTR-lo, CURLIN-hi, CURLIN-lo,
00254Dr 2                       ;   LIMIT[4..0]   (deepest=LIMIT[4], so LIMIT[0] ends at $010A,x),
00254Dr 2                       ;   STEP-sign,
00254Dr 2                       ;   STEP[4..0]    (deepest=STEP[4], so STEP[0]  ends at $0104,x),
00254Dr 2                       ;   VAR-hi, VAR-lo, $81
00254Dr 2  A5 05                lda     TXTPTR+1
00254Fr 2  48                   pha
002550r 2  A5 04                lda     TXTPTR
002552r 2  48                   pha
002553r 2  AD 6A 03             lda     BAS_CURLIN+1
002556r 2  48                   pha
002557r 2  AD 69 03             lda     BAS_CURLIN
00255Ar 2  48                   pha
00255Br 2  A2 04                ldx     #4
00255Dr 2               @pushLim:
00255Dr 2  B5 4D                lda     BAS_TEMP1,x
00255Fr 2  48                   pha
002560r 2  CA                   dex
002561r 2  10 FA                bpl     @pushLim
002563r 2  A5 52                lda     BAS_TEMP2               ; step sign
002565r 2  48                   pha
002566r 2  A2 05                ldx     #5
002568r 2               @pushStep:
002568r 2  B5 52                lda     BAS_TEMP2,x
00256Ar 2  48                   pha
00256Br 2  CA                   dex
00256Cr 2  D0 FA                bne     @pushStep
00256Er 2  A5 47                lda     BAS_FORPNT+1
002570r 2  48                   pha
002571r 2  A5 46                lda     BAS_FORPNT
002573r 2  48                   pha
002574r 2  A9 81                lda     #TOK_FOR
002576r 2  48                   pha
002577r 2  4C rr rr             jmp     BasNewstt               ; resume statement loop with frame in place
00257Ar 2               
00257Ar 2               ConstOne:
00257Ar 2  81 00 00 00          .byte   $81,$00,$00,$00,$00     ; FP +1.0
00257Er 2  00           
00257Fr 2               
00257Fr 2               ; ---------------------------------------------------------------------------
00257Fr 2               ; Statement: NEXT [var]
00257Fr 2               ; Locate matching FOR frame, increment var by step, test against limit,
00257Fr 2               ; loop back if more iterations remain, else discard frame and continue.
00257Fr 2               ; ---------------------------------------------------------------------------
00257Fr 2               BasCmdNext:
00257Fr 2  20 rr rr             jsr     ChrGot
002582r 2  F0 0D                beq     @anyVar
002584r 2  C9 3A                cmp     #':'
002586r 2  F0 09                beq     @anyVar
002588r 2  20 rr rr             jsr     PtrGet
00258Br 2  85 46                sta     BAS_FORPNT
00258Dr 2  84 47                sty     BAS_FORPNT+1
00258Fr 2  80 06                bra     @find
002591r 2               @anyVar:
002591r 2                       ; "NEXT" without a variable: set FORPNT = 0 so GtForPnt copies the
002591r 2                       ; stack-frame's var address into FORPNT and then trivially matches
002591r 2                       ; (any FOR frame is acceptable).
002591r 2  A9 00                lda     #0
002593r 2  85 46                sta     BAS_FORPNT
002595r 2  85 47                sta     BAS_FORPNT+1
002597r 2               @find:
002597r 2  20 rr rr             jsr     GtForPnt
00259Ar 2  F0 05                beq     @found
00259Cr 2  A2 0D                ldx     #ERR_NF
00259Er 2  4C rr rr             jmp     BasErrorVec
0025A1r 2               @found:
0025A1r 2                       ; X = stack offset of (tag - 1).  txs makes SP = X so the frame
0025A1r 2                       ; sits at $101+X..$112+X.  All subsequent accesses use $0101+offset,x
0025A1r 2                       ; just like msbasic.
0025A1r 2  9A                   txs
0025A2r 2                       ; Frame layout (tag at $0101+X):
0025A2r 2                       ;   $0101+X = $81 tag
0025A2r 2                       ;   $0102+X = VAR-lo
0025A2r 2                       ;   $0103+X = VAR-hi
0025A2r 2                       ;   $0104+X..$0108+X = STEP (5 bytes FP, FAC[0..4] ascending)
0025A2r 2                       ;   $0109+X = STEP-sign
0025A2r 2                       ;   $010A+X..$010E+X = LIMIT (5 bytes FP, FAC[0..4] ascending)
0025A2r 2                       ;   $010F+X = CURLIN-lo
0025A2r 2                       ;   $0110+X = CURLIN-hi
0025A2r 2                       ;   $0111+X = TXTPTR-lo
0025A2r 2                       ;   $0112+X = TXTPTR-hi
0025A2r 2                       ; Load STEP into FAC.
0025A2r 2  A9 01                lda     #$01
0025A4r 2  85 3B                sta     BAS_TMP1+1
0025A6r 2  8A                   txa
0025A7r 2  18                   clc
0025A8r 2  69 04                adc     #$04
0025AAr 2  85 3A                sta     BAS_TMP1                ; TMP1 -> STEP[0] at $0104,x
0025ACr 2  A5 3A                lda     BAS_TMP1
0025AEr 2  A4 3B                ldy     BAS_TMP1+1
0025B0r 2  20 rr rr             jsr     LoadFacFromYa
0025B3r 2                       ; FACSIGN := step sign byte at $0109,x.
0025B3r 2  BD 09 01             lda     $0109,x
0025B6r 2  85 13                sta     FACSIGN
0025B8r 2                       ; FAC += variable.
0025B8r 2  BD 02 01             lda     $0102,x
0025BBr 2  BC 03 01             ldy     $0103,x
0025BEr 2  85 46                sta     BAS_FORPNT
0025C0r 2  84 47                sty     BAS_FORPNT+1
0025C2r 2  20 rr rr             jsr     FAdd
0025C5r 2  20 rr rr             jsr     SetFor
0025C8r 2                       ; Compare FAC with LIMIT (at $010A,x).
0025C8r 2  BA                   tsx                             ; reload x (FAdd may have used it)
0025C9r 2  8A                   txa
0025CAr 2  18                   clc
0025CBr 2  69 0A                adc     #$0A
0025CDr 2  85 3A                sta     BAS_TMP1
0025CFr 2  A9 01                lda     #$01
0025D1r 2  85 3B                sta     BAS_TMP1+1
0025D3r 2  A5 3A                lda     BAS_TMP1
0025D5r 2  A4 3B                ldy     BAS_TMP1+1
0025D7r 2  20 rr rr             jsr     FComp
0025DAr 2  BA                   tsx
0025DBr 2  38                   sec
0025DCr 2  FD 09 01             sbc     $0109,x                 ; A - step-sign
0025DFr 2  F0 19                beq     @loopDone
0025E1r 2                       ; Continue: restore CURLIN/TXTPTR from frame, JMP NEWSTT (don't RTS).
0025E1r 2  BD 0F 01             lda     $010F,x
0025E4r 2  8D 69 03             sta     BAS_CURLIN
0025E7r 2  BD 10 01             lda     $0110,x
0025EAr 2  8D 6A 03             sta     BAS_CURLIN+1
0025EDr 2  BD 11 01             lda     $0111,x
0025F0r 2  85 04                sta     TXTPTR
0025F2r 2  BD 12 01             lda     $0112,x
0025F5r 2  85 05                sta     TXTPTR+1
0025F7r 2  4C rr rr             jmp     BasNewstt
0025FAr 2               @loopDone:
0025FAr 2                       ; Discard frame: SP := X + 18.
0025FAr 2  8A                   txa
0025FBr 2  18                   clc
0025FCr 2  69 12                adc     #18
0025FEr 2  AA                   tax
0025FFr 2  9A                   txs
002600r 2                       ; Allow ", var" to chain into another NEXT.
002600r 2  20 rr rr             jsr     ChrGot
002603r 2  C9 2C                cmp     #','
002605r 2  D0 06                bne     @retNewstt
002607r 2  20 rr rr             jsr     ChrGet
00260Ar 2  4C rr rr             jmp     BasCmdNext
00260Dr 2               @retNewstt:
00260Dr 2  4C rr rr             jmp     BasNewstt
002610r 2               
002610r 2               ; ---------------------------------------------------------------------------
002610r 2               ; Statement: DEF FN A(X) = expr
002610r 2               ; Stored in the variable's 5 value bytes:
002610r 2               ;   [TXTPTR-of-expr-lo][TXTPTR-of-expr-hi][param-name-lo][param-name-hi][0]
002610r 2               ; ---------------------------------------------------------------------------
002610r 2               BasCmdDef:
002610r 2                       ; Expect: FN <name>(<param>) = <expr>
002610r 2  A9 9D                lda     #TOK_FN
002612r 2  20 rr rr             jsr     SynChr
002615r 2  09 80                ora     #$80
002617r 2  85 68                sta     SUBFLG                  ; tell PtrGet "this is a DEF FN var"
002619r 2  20 rr rr             jsr     PtrGet
00261Cr 2                       ; VARPNT = address of FN var slot.
00261Cr 2  85 81                sta     BAS_FNCNAM
00261Er 2  84 82                sty     BAS_FNCNAM+1
002620r 2  20 rr rr             jsr     ChkNum
002623r 2                       ; Expect '(' name ')' = expr
002623r 2                       ; Param name parsed by recursive PtrGet inside FrmEvl on call;
002623r 2                       ; here we just record (param-name) by parsing it ourselves.
002623r 2  A9 28                lda     #'('
002625r 2  20 rr rr             jsr     SynChr
002628r 2  A9 80                lda     #$80
00262Ar 2  85 68                sta     SUBFLG
00262Cr 2  20 rr rr             jsr     PtrGet
00262Fr 2                       ; VARPNT = param var addr.  Save it.
00262Fr 2  A5 3F                lda     VARPNT
002631r 2  85 3A                sta     BAS_TMP1
002633r 2  A5 40                lda     VARPNT+1
002635r 2  85 3B                sta     BAS_TMP1+1
002637r 2  20 rr rr             jsr     ChkNum
00263Ar 2  A9 29                lda     #')'
00263Cr 2  20 rr rr             jsr     SynChr
00263Fr 2  A9 3D                lda     #'='
002641r 2  20 rr rr             jsr     SynChr
002644r 2                       ; Reject in direct mode.
002644r 2  AD 6A 03             lda     BAS_CURLIN+1
002647r 2  C9 FF                cmp     #$FF
002649r 2  D0 05                bne     @ok
00264Br 2  A2 07                ldx     #ERR_ILLDIRECT
00264Dr 2  4C rr rr             jmp     BasErrorVec
002650r 2               @ok:
002650r 2                       ; Store [TXTPTR][param][0] in FN var.
002650r 2  A0 00                ldy     #0
002652r 2  A5 04                lda     TXTPTR
002654r 2  91 81                sta     (BAS_FNCNAM),y
002656r 2  C8                   iny
002657r 2  A5 05                lda     TXTPTR+1
002659r 2  91 81                sta     (BAS_FNCNAM),y
00265Br 2  C8                   iny
00265Cr 2  A5 3A                lda     BAS_TMP1
00265Er 2  91 81                sta     (BAS_FNCNAM),y
002660r 2  C8                   iny
002661r 2  A5 3B                lda     BAS_TMP1+1
002663r 2  91 81                sta     (BAS_FNCNAM),y
002665r 2  C8                   iny
002666r 2  A9 00                lda     #0
002668r 2  91 81                sta     (BAS_FNCNAM),y
00266Ar 2                       ; Skip past expression body.
00266Ar 2  20 rr rr             jsr     BasDatan
00266Dr 2  4C rr rr             jmp     BasAddon
002670r 2               
002670r 2               ; ---------------------------------------------------------------------------
002670r 2               ; FnCall -- evaluator-side handler for "FN A(expr)".
002670r 2               ; Called by FrmEvl when it sees TOK_FN.  Evaluates argument, swaps in the
002670r 2               ; param's stored value, executes the FN expression, and restores the param.
002670r 2               ; ---------------------------------------------------------------------------
002670r 2               FnCall:
002670r 2  20 rr rr             jsr     ChrGet                  ; consume FN
002673r 2  09 80                ora     #$80
002675r 2  85 68                sta     SUBFLG
002677r 2  20 rr rr             jsr     PtrGet                  ; locate FN var
00267Ar 2  8D 73 03             sta     BAS_FNPTR               ; durable copy: FNCNAM lives in ZP and
00267Dr 2  8C 74 03             sty     BAS_FNPTR+1             ; is scratch for Garbag
002680r 2  85 81                sta     BAS_FNCNAM
002682r 2  84 82                sty     BAS_FNCNAM+1
002684r 2  20 rr rr             jsr     ChkNum
002687r 2                       ; Read param ptr from FN slot.
002687r 2  A0 02                ldy     #2
002689r 2  B1 81                lda     (BAS_FNCNAM),y
00268Br 2  85 3F                sta     VARPNT
00268Dr 2  F0 57                beq     @undef
00268Fr 2  C8                   iny
002690r 2  B1 81                lda     (BAS_FNCNAM),y
002692r 2  85 40                sta     VARPNT+1
002694r 2                       ; Evaluate '(arg)'
002694r 2  A9 28                lda     #'('
002696r 2  20 rr rr             jsr     SynChr
002699r 2                       ; Save param's current FP value (5 bytes) on stack.
002699r 2  A0 04                ldy     #4
00269Br 2               @savep:
00269Br 2  B1 3F                lda     (VARPNT),y
00269Dr 2  48                   pha
00269Er 2  88                   dey
00269Fr 2  10 FA                bpl     @savep
0026A1r 2                       ; Evaluate argument -> FAC.
0026A1r 2  20 rr rr             jsr     FrmNum
0026A4r 2  A9 29                lda     #')'
0026A6r 2  20 rr rr             jsr     SynChr
0026A9r 2                       ; Any variable reference in the argument re-pointed VARPNT (and Garbag
0026A9r 2                       ; may have eaten FNCNAM) — reload both before storing the argument.
0026A9r 2  20 rr rr             jsr     @reload
0026ACr 2                       ; Store FAC into param slot.
0026ACr 2  A6 3F                ldx     VARPNT
0026AEr 2  A4 40                ldy     VARPNT+1
0026B0r 2  20 rr rr             jsr     StoreFacAtYxRounded
0026B3r 2                       ; Save current TXTPTR.
0026B3r 2  A5 05                lda     TXTPTR+1
0026B5r 2  48                   pha
0026B6r 2  A5 04                lda     TXTPTR
0026B8r 2  48                   pha
0026B9r 2                       ; Switch TXTPTR to FN expression body.
0026B9r 2  A0 00                ldy     #0
0026BBr 2  B1 81                lda     (BAS_FNCNAM),y
0026BDr 2  85 04                sta     TXTPTR
0026BFr 2  C8                   iny
0026C0r 2  B1 81                lda     (BAS_FNCNAM),y
0026C2r 2  85 05                sta     TXTPTR+1
0026C4r 2                       ; Body TXTPTR is positioned at the first byte; we need it positioned
0026C4r 2                       ; one BEFORE so FrmNum's first ChrGet loads the first byte.  Decrement.
0026C4r 2  A5 04                lda     TXTPTR
0026C6r 2  D0 02                bne     @noBor
0026C8r 2  C6 05                dec     TXTPTR+1
0026CAr 2               @noBor:
0026CAr 2  C6 04                dec     TXTPTR
0026CCr 2                       ; Evaluate the FN expression body.
0026CCr 2  20 rr rr             jsr     ChrGet
0026CFr 2  20 rr rr             jsr     FrmNum
0026D2r 2                       ; Restore TXTPTR.
0026D2r 2  68                   pla
0026D3r 2  85 04                sta     TXTPTR
0026D5r 2  68                   pla
0026D6r 2  85 05                sta     TXTPTR+1
0026D8r 2                       ; Restore param.  VARPNT may have been clobbered; reload.
0026D8r 2  20 rr rr             jsr     @reload
0026DBr 2  A0 00                ldy     #0
0026DDr 2               @restp:
0026DDr 2  68                   pla
0026DEr 2  91 3F                sta     (VARPNT),y
0026E0r 2  C8                   iny
0026E1r 2  C0 05                cpy     #5
0026E3r 2  D0 F8                bne     @restp
0026E5r 2  60                   rts
0026E6r 2               @undef:
0026E6r 2  A2 03                ldx     #ERR_UNDEFSTMT
0026E8r 2  4C rr rr             jmp     BasErrorVec
0026EBr 2               ; Re-seed FNCNAM from BAS_FNPTR and VARPNT from the FN slot's param pointer.
0026EBr 2               ; Preserves FAC (touches A and Y only).
0026EBr 2               @reload:
0026EBr 2  AD 73 03             lda     BAS_FNPTR
0026EEr 2  85 81                sta     BAS_FNCNAM
0026F0r 2  AD 74 03             lda     BAS_FNPTR+1
0026F3r 2  85 82                sta     BAS_FNCNAM+1
0026F5r 2  A0 02                ldy     #2
0026F7r 2  B1 81                lda     (BAS_FNCNAM),y
0026F9r 2  85 3F                sta     VARPNT
0026FBr 2  C8                   iny
0026FCr 2  B1 81                lda     (BAS_FNCNAM),y
0026FEr 2  85 40                sta     VARPNT+1
002700r 2  60                   rts
002701r 2               
002701r 2               ; ---------------------------------------------------------------------------
002701r 2               ; BasCmdDim -- DIM statement.  Dimension one or more arrays.
002701r 2               ;   On entry ChrGet has advanced past the DIM token, so A = first char of the
002701r 2               ;   first variable name.  For each name we call PtrGet2 with the from-DIM flag
002701r 2               ;   ($40) set in X; the '(' branch runs Array -> MakeNewArray, which allocates
002701r 2               ;   the array using the subscripts as sizes (0..N) and returns without looking
002701r 2               ;   up an element (DIMFLG nonzero).  Names are separated by commas.
002701r 2               ; ---------------------------------------------------------------------------
002701r 2               BasCmdDim:
002701r 2  A2 40                ldx     #$40                    ; from-DIM flag (bit 6)
002703r 2  20 rr rr             jsr     PtrGet2                 ; A = name char; create/dimension array
002706r 2  20 rr rr             jsr     ChrGot
002709r 2  C9 2C                cmp     #','
00270Br 2  D0 05                bne     @done
00270Dr 2  20 rr rr             jsr     ChrGet                  ; consume comma, advance to next name
002710r 2  80 EF                bra     BasCmdDim
002712r 2               @done:
002712r 2  60                   rts
002713r 2               
002713r 2               ; ===========================================================================
002713r 2               ;   H A R D W A R E - E X T E N S I O N   S T A T E M E N T S
002713r 2               ; ===========================================================================
002713r 2               
002713r 2               ; --- Helpers --------------------------------------------------------------
002713r 2               
002713r 2               ; Raise ?NO DEVICE error.
002713r 2               NoDevErr:
002713r 2  A2 0F                ldx     #ERR_NODEV
002715r 2  4C rr rr             jmp     BasErrorVec
002718r 2               
002718r 2               ; Require A bits in HW_PRESENT (else ?NO DEVICE).
002718r 2               ;   Input : A = mask
002718r 2               ;   Output: A preserved on success
002718r 2               ReqHw:
002718r 2  2D 0D 03             and     HW_PRESENT
00271Br 2  F0 F6                beq     NoDevErr
00271Dr 2  60                   rts
00271Er 2               
00271Er 2               ; Evaluate expression -> A in 0..255.
00271Er 2               ;   On entry: ChrGot positioned at first byte of expression.
00271Er 2               ;   On exit : A = byte, ChrGot returns char following expression.
00271Er 2               EvalU8:
00271Er 2  20 rr rr             jsr     GetByt                  ; X = byte, jmp ChrGot
002721r 2  8A                   txa
002722r 2  60                   rts
002723r 2               
002723r 2               ; Evaluate expression as 16-bit signed -> FAC+3 (hi), FAC+4 (lo).
002723r 2               EvalU16:
002723r 2  20 rr rr             jsr     FrmNum
002726r 2  20 rr rr             jsr     AyInt
002729r 2  4C rr rr             jmp     ChrGot
00272Cr 2               
00272Cr 2               ; Evaluate expression as 16-bit unsigned address (0..65535)
00272Cr 2               ;   -> FAC+3 (hi), FAC+4 (lo).  Used by SYS, POKE, PEEK, WAIT so the full
00272Cr 2               ;   6502 address space is reachable with positive decimal literals.
00272Cr 2               ;   Truncates fractional part.  Negative or >= 65536 raises ?ILLEGAL QUANTITY.
00272Cr 2               EvalAddrU16:
00272Cr 2  20 rr rr             jsr     FrmNum
00272Fr 2  20 rr rr             jsr     FacToU16
002732r 2  4C rr rr             jmp     ChrGot
002735r 2               
002735r 2               ; FacToU16 -- Convert FAC (must be 0..65535) to FAC+3 (hi), FAC+4 (lo).
002735r 2               ;   Negative or >= 65536 raises ?ILLEGAL QUANTITY.  Truncates fractional part.
002735r 2               FacToU16:
002735r 2  24 13                bit     FACSIGN
002737r 2  30 34                bmi     @illqty
002739r 2  A5 0E                lda     FAC                     ; exponent byte (0 = value is zero)
00273Br 2  F0 2B                beq     @zero
00273Dr 2  C9 91                cmp     #$91                    ; exp >= $91 means value >= 65536
00273Fr 2  B0 2C                bcs     @illqty
002741r 2                       ; Reconstruct top 16 bits of mantissa (with hidden 1 bit).
002741r 2  48                   pha                             ; save exponent byte
002742r 2  A5 0F                lda     FAC+1
002744r 2  09 80                ora     #$80                    ; restore hidden bit
002746r 2  85 3B                sta     BAS_TMP1+1              ; hi
002748r 2  A5 10                lda     FAC+2
00274Ar 2  85 3A                sta     BAS_TMP1                ; lo
00274Cr 2                       ; Shift count = $90 - exp_byte (0..15).
00274Cr 2  68                   pla
00274Dr 2  38                   sec
00274Er 2  E9 90                sbc     #$90
002750r 2  49 FF                eor     #$FF
002752r 2  18                   clc
002753r 2  69 01                adc     #1                      ; A = $90 - exp
002755r 2  F0 08                beq     @store                  ; zero shifts: already aligned
002757r 2  AA                   tax
002758r 2               @shloop:
002758r 2  46 3B                lsr     BAS_TMP1+1
00275Ar 2  66 3A                ror     BAS_TMP1
00275Cr 2  CA                   dex
00275Dr 2  D0 F9                bne     @shloop
00275Fr 2               @store:
00275Fr 2  A5 3B                lda     BAS_TMP1+1
002761r 2  85 11                sta     FAC+3
002763r 2  A5 3A                lda     BAS_TMP1
002765r 2  85 12                sta     FAC+4
002767r 2  60                   rts
002768r 2               @zero:
002768r 2  64 11                stz     FAC+3
00276Ar 2  64 12                stz     FAC+4
00276Cr 2  60                   rts
00276Dr 2               @illqty:
00276Dr 2  4C rr rr             jmp     IqErr
002770r 2               
002770r 2               ; Evaluate string expression -> copy up to 12 chars to BAS_FNAME,
002770r 2               ; null-terminate, set STR_PTR := BAS_FNAME, free temp string.
002770r 2               ; 12 = full 8.3 form ("NAME.EXT" = 8 name + '.' + 3 ext).
002770r 2               EvalString:
002770r 2  20 rr rr             jsr     FrmEvl
002773r 2  20 rr rr             jsr     ChkStr
002776r 2  A5 0F                lda     FAC+1
002778r 2  85 20                sta     INDEX
00277Ar 2  A5 10                lda     FAC+2
00277Cr 2  85 21                sta     INDEX+1
00277Er 2  A0 00                ldy     #0
002780r 2  A6 0E                ldx     FAC                     ; length
002782r 2               @cpy:
002782r 2  C0 0C                cpy     #12
002784r 2  F0 0D                beq     @done
002786r 2  E0 00                cpx     #0
002788r 2  F0 09                beq     @done
00278Ar 2  B1 20                lda     (INDEX),y
00278Cr 2  99 81 03             sta     BAS_FNAME,y
00278Fr 2  C8                   iny
002790r 2  CA                   dex
002791r 2  80 EF                bra     @cpy
002793r 2               @done:
002793r 2  A9 00                lda     #0
002795r 2  99 81 03             sta     BAS_FNAME,y
002798r 2  A9 81                lda     #<BAS_FNAME
00279Ar 2  85 02                sta     STR_PTR
00279Cr 2  A9 03                lda     #>BAS_FNAME
00279Er 2  85 03                sta     STR_PTR+1
0027A0r 2  4C rr rr             jmp     FreFac
0027A3r 2               
0027A3r 2               ; Print A as 2-digit decimal with leading zero (used by TIME/DATE).
0027A3r 2               BasPr2D:
0027A3r 2  A2 00                ldx     #0
0027A5r 2               @loop:
0027A5r 2  C9 0A                cmp     #10
0027A7r 2  90 05                bcc     @done
0027A9r 2  E9 0A                sbc     #10
0027ABr 2  E8                   inx
0027ACr 2  80 F7                bra     @loop
0027AEr 2               @done:
0027AEr 2  48                   pha
0027AFr 2  8A                   txa
0027B0r 2  09 30                ora     #'0'
0027B2r 2  20 rr rr             jsr     Chrout
0027B5r 2  68                   pla
0027B6r 2  09 30                ora     #'0'
0027B8r 2  4C rr rr             jmp     Chrout
0027BBr 2               
0027BBr 2               ; BasFixChain -- recompute end-of-program pointers after a program image load.
0027BBr 2               ; A program image is the raw bytes belonging at $0800 up: a tokenized line chain
0027BBr 2               ; and, for a .prg, machine code sitting past the chain's $0000 terminator.  A
0027BBr 2               ; chain walk alone only ever finds the end of the BASIC part, so the loader's
0027BBr 2               ; byte count has to be taken into account too.
0027BBr 2               ;   Input:  A = loaded image size lo, Y = size hi (0 = size unknown; chain only)
0027BBr 2               ;   Output: BAS_VARTAB = BAS_ARYTAB = BAS_STREND
0027BBr 2               ;             = max(chain-end + 2, PROGRAM_START + size)
0027BBr 2               ;   Note:   a size that would push the result past BAS_MEMSIZ is rejected and the
0027BBr 2               ;           chain-end candidate is used instead.
0027BBr 2               ; Mirroring VARTAB into ARYTAB/STREND matters on its own: Makenewvariable places
0027BBr 2               ; a new scalar at ARYTAB, so leaving it at its post-NEW $0802 makes the first
0027BBr 2               ; direct-mode assignment after a LOAD overwrite the program's first line.
0027BBr 2                       .assert (PROGRAM_START & $FF) = 0, error, "PROGRAM_START must be page-aligned"
0027BBr 2               BasFixChain:
0027BBr 2  85 3C                sta     BAS_TMP2                ; BAS_TMP2 = PROGRAM_START + size; the
0027BDr 2  98                   tya                             ; low byte passes through untouched
0027BEr 2  18                   clc                             ; because PROGRAM_START is page-aligned
0027BFr 2  69 08                adc     #>PROGRAM_START
0027C1r 2  85 3D                sta     BAS_TMP2+1
0027C3r 2  64 20                stz     INDEX
0027C5r 2  A9 08                lda     #>PROGRAM_START
0027C7r 2  85 21                sta     INDEX+1
0027C9r 2               @walk:
0027C9r 2  A0 01                ldy     #1
0027CBr 2  B1 20                lda     (INDEX),y               ; next-ptr hi
0027CDr 2  85 3A                sta     BAS_TMP1
0027CFr 2  88                   dey
0027D0r 2  11 20                ora     (INDEX),y               ; both bytes zero -> terminator
0027D2r 2  F0 15                beq     @end
0027D4r 2                       ; Lines ascend in memory.  LOAD accepts any file, so a corrupt or
0027D4r 2                       ; cyclic chain is reachable here — stop at the last good line rather
0027D4r 2                       ; than loop forever.
0027D4r 2  38                   sec
0027D5r 2  A5 20                lda     INDEX
0027D7r 2  F1 20                sbc     (INDEX),y
0027D9r 2  A5 21                lda     INDEX+1
0027DBr 2  E5 3A                sbc     BAS_TMP1
0027DDr 2  B0 0A                bcs     @end                    ; current >= next -> not a real chain
0027DFr 2  B1 20                lda     (INDEX),y               ; next-ptr lo
0027E1r 2  85 20                sta     INDEX
0027E3r 2  A5 3A                lda     BAS_TMP1
0027E5r 2  85 21                sta     INDEX+1
0027E7r 2  80 E0                bra     @walk
0027E9r 2               @end:
0027E9r 2                       ; INDEX points at terminator ($00 $00).  Candidate A = INDEX + 2.
0027E9r 2  18                   clc
0027EAr 2  A5 20                lda     INDEX
0027ECr 2  69 02                adc     #2
0027EEr 2  8D 5F 03             sta     BAS_VARTAB
0027F1r 2  A5 21                lda     INDEX+1
0027F3r 2  69 00                adc     #0
0027F5r 2  8D 60 03             sta     BAS_VARTAB+1
0027F8r 2                       ; Candidate B = BAS_TMP2.  Keep it only when A <= B <= MEMSIZ, so a
0027F8r 2                       ; short or absent size loses the max and a bogus one cannot push
0027F8r 2                       ; VARTAB out of memory.
0027F8r 2  38                   sec
0027F9r 2  A5 3C                lda     BAS_TMP2
0027FBr 2  ED 5F 03             sbc     BAS_VARTAB
0027FEr 2  A5 3D                lda     BAS_TMP2+1
002800r 2  ED 60 03             sbc     BAS_VARTAB+1
002803r 2  90 17                bcc     @mirror                 ; B < A -> keep A
002805r 2  38                   sec
002806r 2  AD 67 03             lda     BAS_MEMSIZ
002809r 2  E5 3C                sbc     BAS_TMP2
00280Br 2  AD 68 03             lda     BAS_MEMSIZ+1
00280Er 2  E5 3D                sbc     BAS_TMP2+1
002810r 2  90 0A                bcc     @mirror                 ; B > MEMSIZ -> reject, keep A
002812r 2  A5 3C                lda     BAS_TMP2
002814r 2  8D 5F 03             sta     BAS_VARTAB
002817r 2  A5 3D                lda     BAS_TMP2+1
002819r 2  8D 60 03             sta     BAS_VARTAB+1
00281Cr 2               @mirror:
00281Cr 2                       ; ARYTAB / STREND follow VARTAB on a fresh load: no variables yet.
00281Cr 2  A2 01                ldx     #1
00281Er 2               @copy:
00281Er 2  BD 5F 03             lda     BAS_VARTAB,x
