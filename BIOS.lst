001842r 2               
001842r 2               ; ---------------------------------------------------------------------------
001842r 2               ; BasCmdClr -- implement CLR (clear vars/arrays/strings without erasing program).
001842r 2               ;   VARTAB := PRGEND (already correct in our model)
001842r 2               ;   ARYTAB := STREND := VARTAB
001842r 2               ;   FRETOP := MEMSIZ
001842r 2               ;   TEMPPT := TEMPST, DATAPTR := TXTTAB-1, stacks emptied
001842r 2               ; ---------------------------------------------------------------------------
001842r 2               BasCmdClr:
001842r 2                       ; Reset the CPU stack, msbasic's STKINI: any FOR or GOSUB frame a
001842r 2                       ; suspended program left there is being abandoned along with its
001842r 2                       ; variables, and RUN starting on top of one would let a later NEXT find
001842r 2                       ; a loop from the previous run.  The return address rides across the
001842r 2                       ; reset so this is still an ordinary subroutine to its callers.
001842r 2  68                   pla                             ; return address low
001843r 2  A8                   tay
001844r 2  68                   pla                             ; return address high
001845r 2  A2 FF                ldx     #$FF
001847r 2  9A                   txs
001848r 2  8E 75 03             stx     BAS_STKBASE
00184Br 2  48                   pha
00184Cr 2  98                   tya
00184Dr 2  48                   pha
00184Er 2                       ; ARYTAB = STREND = VARTAB
00184Er 2  AD 5F 03             lda     VARTAB
001851r 2  8D 61 03             sta     ARYTAB
001854r 2  8D 63 03             sta     STREND
001857r 2  AD 60 03             lda     VARTAB+1
00185Ar 2  8D 62 03             sta     ARYTAB+1
00185Dr 2  8D 64 03             sta     STREND+1
001860r 2                       ; FRETOP = MEMSIZ
001860r 2  AD 67 03             lda     MEMSIZ
001863r 2  8D 65 03             sta     FRETOP
001866r 2  AD 68 03             lda     MEMSIZ+1
001869r 2  8D 66 03             sta     FRETOP+1
00186Cr 2                       ; Reset temp string descriptor stack.
00186Cr 2  A9 6E                lda     #BAS_TEMPST
00186Er 2  85 6B                sta     TEMPPT
001870r 2  64 6C                stz     LASTPT
001872r 2  64 6D                stz     LASTPT+1
001874r 2                       ; CONT state, DATA pointer, pending key.
001874r 2                       ; DATAPTR := TXTTAB - 1 so first READ does FindData and lands on
001874r 2                       ; the first DATA item.
001874r 2  38                   sec
001875r 2  AD 5D 03             lda     TXTTAB
001878r 2  E9 01                sbc     #1
00187Ar 2  8D 1A 03             sta     BAS_DATAPTR
00187Dr 2  AD 5E 03             lda     TXTTAB+1
001880r 2  E9 00                sbc     #0
001882r 2  8D 1B 03             sta     BAS_DATAPTR+1
001885r 2  9C 6B 03             stz     BAS_OLDLIN
001888r 2  9C 6C 03             stz     BAS_OLDLIN+1
00188Br 2  9C 6D 03             stz     BAS_OLDTEXT
00188Er 2  9C 6E 03             stz     BAS_OLDTEXT+1
001891r 2  9C 1C 03             stz     BAS_STOPLINE
001894r 2  9C 1D 03             stz     BAS_STOPLINE+1
001897r 2  9C 1E 03             stz     BAS_STOPTXT
00189Ar 2  9C 1F 03             stz     BAS_STOPTXT+1
00189Dr 2  9C 0E 03             stz     BAS_PENDKEY
0018A0r 2  64 63                stz     DIMFLG
0018A2r 2  64 68                stz     SUBFLG
0018A4r 2  64 64                stz     VALTYP
0018A6r 2  64 65                stz     VALTYP+1
0018A8r 2  64 67                stz     DATAFLG
0018AAr 2  60                   rts
0018ABr 2               
0018ABr 2               .if 0
0018ABr 2               ; (Removed in Phase 8: _VARTEST debug harness lived here.)
0018ABr 2               VT_SetTxt:
0018ABr 2                       ; Set TXTPTR = VT_TXTPTR_TMP - 1 then ChrGet to load first char.
0018ABr 2                       ; Actually simpler: caller passes (Y,A) = pointer; we set TXTPTR =
0018ABr 2                       ; (Y,A) - 1 and call ChrGet to land on (Y,A).
0018ABr 2                       sta     TXTPTR
0018ABr 2                       sty     TXTPTR+1
0018ABr 2                       lda     TXTPTR
0018ABr 2                       bne     @nb
0018ABr 2                       dec     TXTPTR+1
0018ABr 2               @nb:
0018ABr 2                       dec     TXTPTR
0018ABr 2                       jmp     ChrGet
0018ABr 2               
0018ABr 2               VT_StoreFAC:
0018ABr 2                       ; Round and store FAC at (VARPNT).
0018ABr 2                       ldx     VARPNT
0018ABr 2                       ldy     VARPNT+1
0018ABr 2                       jmp     StoreFacAtYxRounded
0018ABr 2               
0018ABr 2               VT_LoadFAC:
0018ABr 2                       ; Load FAC from (VARPNT).
0018ABr 2                       lda     VARPNT
0018ABr 2                       ldy     VARPNT+1
0018ABr 2                       jmp     LoadFacFromYa
0018ABr 2               
0018ABr 2               VT_VPSAVE       = $86           ; 2-byte ZP VARPNT save (_VARTEST debug)
0018ABr 2               
0018ABr 2               BasCmdVarTest:
0018ABr 2                       jsr     BasCmdClr
0018ABr 2               
0018ABr 2                       ; --- Test 1: A=3.14, B=A*2 ---
0018ABr 2                       lda     #<VT_NameA
0018ABr 2                       ldy     #>VT_NameA
0018ABr 2                       jsr     VT_SetTxt
0018ABr 2                       jsr     PtrGet                  ; creates A; VARPNT -> A's value
0018ABr 2                       ; FAC = 3.14
0018ABr 2                       lda     #<VT_pi
0018ABr 2                       ldy     #>VT_pi
0018ABr 2                       jsr     LoadFacFromYa
0018ABr 2                       jsr     VT_StoreFAC
0018ABr 2               
0018ABr 2                       lda     #<VT_NameB
0018ABr 2                       ldy     #>VT_NameB
0018ABr 2                       jsr     VT_SetTxt
0018ABr 2                       jsr     PtrGet                  ; creates B
0018ABr 2                       ; Save B's VARPNT.
0018ABr 2                       lda     VARPNT
0018ABr 2                       sta     VT_VPSAVE
0018ABr 2                       lda     VARPNT+1
0018ABr 2                       sta     VT_VPSAVE+1
0018ABr 2               
0018ABr 2                       ; Look up A again (already exists).
0018ABr 2                       lda     #<VT_NameA
0018ABr 2                       ldy     #>VT_NameA
0018ABr 2                       jsr     VT_SetTxt
0018ABr 2                       jsr     PtrGet
0018ABr 2                       jsr     VT_LoadFAC              ; FAC = A = 3.14
0018ABr 2                       ; Multiply by 2.
0018ABr 2                       lda     #<FpC2
0018ABr 2                       ldy     #>FpC2
0018ABr 2                       jsr     FMult                   ; FAC = 2 * FAC = 6.28
0018ABr 2                       ; Store into B.
0018ABr 2                       ldx     VT_VPSAVE
0018ABr 2                       ldy     VT_VPSAVE+1
0018ABr 2                       jsr     StoreFacAtYxRounded
0018ABr 2               
0018ABr 2                       ; Print result.
0018ABr 2                       lda     #<MsgVT_A
0018ABr 2                       ldy     #>MsgVT_A
0018ABr 2                       jsr     BasPrintStr
0018ABr 2                       ; Reload B and print.
0018ABr 2                       lda     VT_VPSAVE
0018ABr 2                       ldy     VT_VPSAVE+1
0018ABr 2                       jsr     LoadFacFromYa
0018ABr 2                       jsr     BasPrintFAC
0018ABr 2                       jsr     BasPrintCRLF
0018ABr 2               
0018ABr 2                       ; --- Test 2: A$="HELLO" ---
0018ABr 2                       lda     #<VT_NameAS
0018ABr 2                       ldy     #>VT_NameAS
0018ABr 2                       jsr     VT_SetTxt
0018ABr 2                       jsr     PtrGet                  ; creates A$
0018ABr 2                       ; Save VARPNT (A$ descriptor address).
0018ABr 2                       lda     VARPNT
0018ABr 2                       sta     VT_VPSAVE
0018ABr 2                       lda     VARPNT+1
0018ABr 2                       sta     VT_VPSAVE+1
0018ABr 2                       ; Allocate space, copy "HELLO" via StrLit.
0018ABr 2                       lda     #<VT_HelloLit
0018ABr 2                       ldy     #>VT_HelloLit
0018ABr 2                       jsr     StrLit                  ; FAC has descriptor, in temp stack
0018ABr 2                       ; Now copy descriptor (3 bytes from temp stack entry) to A$ var.
0018ABr 2                       ; FAC+3,4 points at the temp descriptor; FAC = length, FAC+1/2 = addr.
0018ABr 2                       ; The descriptor lives in TEMPST.  We just write [len][lo][hi] into
0018ABr 2                       ; (VARPNT) so the variable now references the heap copy.
0018ABr 2                       lda     FAC
0018ABr 2                       ldy     #$00
0018ABr 2                       sta     (VT_VPSAVE),y           ; length
0018ABr 2                       lda     FAC+1
0018ABr 2                       iny
0018ABr 2                       sta     (VT_VPSAVE),y           ; addr lo
0018ABr 2                       lda     FAC+2
0018ABr 2                       iny
0018ABr 2                       sta     (VT_VPSAVE),y           ; addr hi
0018ABr 2                       ; Print length.
0018ABr 2                       lda     #<MsgVT_AS
0018ABr 2                       ldy     #>MsgVT_AS
0018ABr 2                       jsr     BasPrintStr
0018ABr 2                       ldy     #$00
0018ABr 2                       lda     (VT_VPSAVE),y
0018ABr 2                       tay
0018ABr 2                       jsr     SngFlt
0018ABr 2                       jsr     BasPrintFAC
0018ABr 2                       jsr     BasPrintCRLF
0018ABr 2               
0018ABr 2                       ; --- Test 3: DIM N(10), N(5)=42 ---
0018ABr 2                       ; Build TXTPTR pointing at "N(10) " and call MakInt-equivalent path.
0018ABr 2                       ; Easier: directly construct array via PtrGet3 + Array by simulating
0018ABr 2                       ; a 1-D DIM of size 11 (indices 0..10).  We emulate the parser:
0018ABr 2                       ;   1. Set DIMFLG = $40, VARNAM = ('N','N'), call PtrGet3 with X=1?
0018ABr 2                       ;   2. Or: just do PtrGet3 entry by hand then jmp Array.
0018ABr 2                       ; Simplest: set TXTPTR at "N(10) ", DIMFLG <- $40 (from DIM
0018ABr 2                       ; statement), then PtrGet3 with VARNAM letter, jmp to '(' branch.
0018ABr 2                       lda     #<VT_DimN10
0018ABr 2                       ldy     #>VT_DimN10
0018ABr 2                       jsr     VT_SetTxt               ; A = 'N'
0018ABr 2                       ldx     #$40                    ; from-DIM flag (bit 6)
0018ABr 2                       jsr     PtrGet2                 ; will hit '(' -> Array -> create
0018ABr 2                       ; Now N(5)=42.  Re-parse "N(5)" to find element.
0018ABr 2                       lda     #<VT_DimN5
0018ABr 2                       ldy     #>VT_DimN5
0018ABr 2                       jsr     VT_SetTxt
0018ABr 2                       jsr     PtrGet                  ; element address in VARPNT
0018ABr 2                       ; Save VARPNT.
0018ABr 2                       lda     VARPNT
0018ABr 2                       sta     VT_VPSAVE
0018ABr 2                       lda     VARPNT+1
0018ABr 2                       sta     VT_VPSAVE+1
0018ABr 2                       ; FAC = 42.
0018ABr 2                       lda     #<Vt42
0018ABr 2                       ldy     #>Vt42
0018ABr 2                       jsr     LoadFacFromYa
0018ABr 2                       ldx     VT_VPSAVE
0018ABr 2                       ldy     VT_VPSAVE+1
0018ABr 2                       jsr     StoreFacAtYxRounded
0018ABr 2                       ; Read it back and print.
0018ABr 2                       lda     #<MsgVT_NewArr
0018ABr 2                       ldy     #>MsgVT_NewArr
0018ABr 2                       jsr     BasPrintStr
0018ABr 2                       lda     VT_VPSAVE
0018ABr 2                       ldy     VT_VPSAVE+1
0018ABr 2                       jsr     LoadFacFromYa
0018ABr 2                       jsr     BasPrintFAC
0018ABr 2                       jsr     BasPrintCRLF
0018ABr 2               
0018ABr 2                       ; --- Test 4: 8 string allocations + GC ---
0018ABr 2                       ldx     #8
0018ABr 2               @galloc:
0018ABr 2                       phx
0018ABr 2                       lda     #16
0018ABr 2                       jsr     StrSpa                  ; consumes 16 bytes; FAC has descriptor
0018ABr 2                       plx
0018ABr 2                       dex
0018ABr 2                       bne     @galloc
0018ABr 2                       ; Force GC (TEMPPT got bumped by StrSpa-via-StrIni? StrSpa itself
0018ABr 2                       ; doesn't call PutNew, so temp stack untouched here.)
0018ABr 2                       jsr     Garbag
0018ABr 2                       lda     #<MsgVT_GC
0018ABr 2                       ldy     #>MsgVT_GC
0018ABr 2                       jsr     BasPrintStr
0018ABr 2                       lda     FRETOP+1
0018ABr 2                       ldy     FRETOP
0018ABr 2                       jsr     GivAyf
0018ABr 2                       jsr     BasPrintFAC
0018ABr 2                       jsr     BasPrintCRLF
0018ABr 2               
0018ABr 2                       rts
0018ABr 2               .endif
0018ABr 2               
0018ABr 2               ; =============================================================================
0018ABr 2               ;   E X P R E S S I O N   E V A L U A T O R
0018ABr 2               ;
0018ABr 2               ;   Recursive-descent precedence climber.  Operates on tokenized text at
0018ABr 2               ;   TXTPTR (advanced via ChrGet/ChrGot).  Result lands in FAC (numeric)
0018ABr 2               ;   or as a 3-byte string descriptor at FAC..FAC+2 (string).  VALTYP
0018ABr 2               ;   selects: $00 = numeric, $FF = string.
0018ABr 2               ;
0018ABr 2               ;   Precedence (lowest -> highest):
0018ABr 2               ;     OR
0018ABr 2               ;     AND
0018ABr 2               ;     NOT  (right-assoc unary)
0018ABr 2               ;     comparison (= <> < > <= >=)
0018ABr 2               ;     + -
0018ABr 2               ;     * /
0018ABr 2               ;     ^    (right-assoc)
0018ABr 2               ;     unary -, unary +
0018ABr 2               ;     atom: number, variable, string-literal, "(" expr ")", function call
0018ABr 2               ; =============================================================================
0018ABr 2               
0018ABr 2               ; ---------------------------------------------------------------------------
0018ABr 2               ; ZP scratch used only during expression evaluation.
0018ABr 2               ;   BAS_LVTYP = saved VALTYP of left operand around binary ops
0018ABr 2               ; ---------------------------------------------------------------------------
0018ABr 2               BAS_LVTYP       := $86
0018ABr 2               
0018ABr 2               ; ---------------------------------------------------------------------------
0018ABr 2               ; FrmEvl -- top-level entry.  TXTPTR positioned so ChrGot returns the first
0018ABr 2               ; byte of the expression.  On exit TXTPTR is at the first byte AFTER the
0018ABr 2               ; expression.  Result in FAC + VALTYP.
0018ABr 2               ; ---------------------------------------------------------------------------
0018ABr 2               FrmEvl:
0018ABr 2  4C rr rr             jmp     EvalOr
0018AEr 2               
0018AEr 2               ; ---------------------------------------------------------------------------
0018AEr 2               ; PushFac -- push the current FAC + VALTYP onto the CPU stack (8 bytes).
0018AEr 2               ; Order pushed: VALTYP, FAC, FAC+1, FAC+2, FAC+3, FAC+4, FACSIGN, FACEXTENSION
0018AEr 2               ; (FACEXTENSION pushed last so it's pulled first by PullArg.)
0018AEr 2               ; Preserves the return address.
0018AEr 2               ; ---------------------------------------------------------------------------
0018AEr 2               PushFac:
0018AEr 2  68                   pla
0018AFr 2  A8                   tay                             ; Y = ret-addr lo
0018B0r 2  68                   pla
0018B1r 2  AA                   tax                             ; X = ret-addr hi
0018B2r 2  A5 64                lda     VALTYP
0018B4r 2  48                   pha
0018B5r 2  A5 0E                lda     FAC
0018B7r 2  48                   pha
0018B8r 2  A5 0F                lda     FAC+1
0018BAr 2  48                   pha
0018BBr 2  A5 10                lda     FAC+2
0018BDr 2  48                   pha
0018BEr 2  A5 11                lda     FAC+3
0018C0r 2  48                   pha
0018C1r 2  A5 12                lda     FAC+4
0018C3r 2  48                   pha
0018C4r 2  A5 13                lda     FACSIGN
0018C6r 2  48                   pha
0018C7r 2  A5 1D                lda     FACEXTENSION
0018C9r 2  48                   pha
0018CAr 2  8A                   txa
0018CBr 2  48                   pha
0018CCr 2  98                   tya
0018CDr 2  48                   pha
0018CEr 2  60                   rts
0018CFr 2               
0018CFr 2               ; ---------------------------------------------------------------------------
0018CFr 2               ; PullArg -- pop the previously-pushed FAC into ARG (signed FP value or
0018CFr 2               ; string descriptor in ARG..ARG+2/sign).  Sets BAS_LVTYP to the saved
0018CFr 2               ; left-operand VALTYP.  Preserves return address.
0018CFr 2               ; ---------------------------------------------------------------------------
0018CFr 2               PullArg:
0018CFr 2  68                   pla
0018D0r 2  A8                   tay                             ; Y = ret-addr lo
0018D1r 2  68                   pla
0018D2r 2  AA                   tax                             ; X = ret-addr hi
0018D3r 2  68                   pla
0018D4r 2  85 43                sta     ARGEXTENSION
0018D6r 2  68                   pla
0018D7r 2  85 1B                sta     ARGSIGN
0018D9r 2  68                   pla
0018DAr 2  85 1A                sta     ARG+4
0018DCr 2  68                   pla
0018DDr 2  85 19                sta     ARG+3
0018DFr 2  68                   pla
0018E0r 2  85 18                sta     ARG+2
0018E2r 2  68                   pla
0018E3r 2  85 17                sta     ARG+1
0018E5r 2  68                   pla
0018E6r 2  85 16                sta     ARG
0018E8r 2  68                   pla
0018E9r 2  85 86                sta     BAS_LVTYP
0018EBr 2  8A                   txa
0018ECr 2  48                   pha
0018EDr 2  98                   tya
0018EEr 2  48                   pha
0018EFr 2  60                   rts
0018F0r 2               
0018F0r 2               ; ---------------------------------------------------------------------------
0018F0r 2               ; PullFac -- pop pushed FAC back into FAC (used to discard right side and
0018F0r 2               ; restore left, e.g. unused).
0018F0r 2               ; ---------------------------------------------------------------------------
0018F0r 2               PullFac:
0018F0r 2  68                   pla
0018F1r 2  A8                   tay
0018F2r 2  68                   pla
0018F3r 2  AA                   tax
0018F4r 2  68                   pla
0018F5r 2  85 1D                sta     FACEXTENSION
0018F7r 2  68                   pla
0018F8r 2  85 13                sta     FACSIGN
0018FAr 2  68                   pla
0018FBr 2  85 12                sta     FAC+4
0018FDr 2  68                   pla
0018FEr 2  85 11                sta     FAC+3
001900r 2  68                   pla
001901r 2  85 10                sta     FAC+2
001903r 2  68                   pla
001904r 2  85 0F                sta     FAC+1
001906r 2  68                   pla
001907r 2  85 0E                sta     FAC
001909r 2  68                   pla
00190Ar 2  85 64                sta     VALTYP
00190Cr 2  8A                   txa
00190Dr 2  48                   pha
00190Er 2  98                   tya
00190Fr 2  48                   pha
001910r 2  60                   rts
001911r 2               
001911r 2               ; ---------------------------------------------------------------------------
001911r 2               ; TypeMismatch helper.
001911r 2               ; ---------------------------------------------------------------------------
001911r 2               EvalTypeErr:
001911r 2  A2 08                ldx     #ERR_TYPEMISM
001913r 2  4C rr rr             jmp     BasErrorVec
001916r 2               
001916r 2               ; ===========================================================================
001916r 2               ;   L E V E L 0  --  O R
001916r 2               ; ===========================================================================
001916r 2               EvalOr:
001916r 2  20 rr rr             jsr     EvalAnd
001919r 2               @loop:
001919r 2  20 rr rr             jsr     ChrGot
00191Cr 2  C9 A3                cmp     #TOK_OR
00191Er 2  D0 17                bne     @done
001920r 2  20 rr rr             jsr     ChkNum                  ; left must be numeric
001923r 2  20 rr rr             jsr     ChrGet                  ; consume OR
001926r 2  20 rr rr             jsr     PushFac
001929r 2  20 rr rr             jsr     EvalAnd
00192Cr 2  20 rr rr             jsr     ChkNum                  ; right must be numeric
00192Fr 2  20 rr rr             jsr     PullArg
001932r 2  20 rr rr             jsr     OrOp
001935r 2  80 E2                bra     @loop
001937r 2               @done:
001937r 2  60                   rts
001938r 2               
001938r 2               ; ===========================================================================
001938r 2               ;   L E V E L 1  --  A N D
001938r 2               ; ===========================================================================
001938r 2               EvalAnd:
001938r 2  20 rr rr             jsr     EvalNot
00193Br 2               @loop:
00193Br 2  20 rr rr             jsr     ChrGot
00193Er 2  C9 A2                cmp     #TOK_AND
001940r 2  D0 17                bne     @done
001942r 2  20 rr rr             jsr     ChkNum
001945r 2  20 rr rr             jsr     ChrGet
001948r 2  20 rr rr             jsr     PushFac
00194Br 2  20 rr rr             jsr     EvalNot
00194Er 2  20 rr rr             jsr     ChkNum
001951r 2  20 rr rr             jsr     PullArg
001954r 2  20 rr rr             jsr     AndOp
001957r 2  80 E2                bra     @loop
001959r 2               @done:
001959r 2  60                   rts
00195Ar 2               
00195Ar 2               ; ===========================================================================
00195Ar 2               ;   L E V E L 2  --  N O T   (right-assoc unary prefix)
00195Ar 2               ; ===========================================================================
00195Ar 2               EvalNot:
00195Ar 2  20 rr rr             jsr     ChrGot
00195Dr 2  C9 A0                cmp     #TOK_NOT
00195Fr 2  D0 0C                bne     EvalCmp
001961r 2  20 rr rr             jsr     ChrGet
001964r 2  20 rr rr             jsr     EvalNot
001967r 2  20 rr rr             jsr     ChkNum
00196Ar 2  4C rr rr             jmp     NotOp
00196Dr 2               
00196Dr 2               ; ===========================================================================
00196Dr 2               ;   L E V E L 3  --  C O M P A R I S O N
00196Dr 2               ;   Reads up to two of {<, =, >} forming a relop; if none, no-op.
00196Dr 2               ;   Mask:  bit 0 = '>' present, bit 1 = '=' present, bit 2 = '<' present
00196Dr 2               ; ===========================================================================
00196Dr 2               EvalCmp:
00196Dr 2  20 rr rr             jsr     EvalAdd
001970r 2  A2 00                ldx     #0                      ; relop mask
001972r 2               @scan:
001972r 2  20 rr rr             jsr     ChrGot
001975r 2  C9 3D                cmp     #'='
001977r 2  F0 0A                beq     @gotEq
001979r 2  C9 3C                cmp     #'<'
00197Br 2  F0 0A                beq     @gotLt
00197Dr 2  C9 3E                cmp     #'>'
00197Fr 2  F0 0A                beq     @gotGt
001981r 2  80 1D                bra     @done
001983r 2               @gotEq:
001983r 2  A0 02                ldy     #2
001985r 2  80 06                bra     @setbit
001987r 2               @gotLt:
001987r 2  A0 04                ldy     #4
001989r 2  80 02                bra     @setbit
00198Br 2               @gotGt:
00198Br 2  A0 01                ldy     #1
00198Dr 2               @setbit:
00198Dr 2  84 45                sty     CPRMASK                 ; reuse as scratch
00198Fr 2  8A                   txa
001990r 2  25 45                and     CPRMASK
001992r 2  D0 09                bne     @synErr                 ; same char twice (e.g. "==")
001994r 2  8A                   txa
001995r 2  05 45                ora     CPRMASK
001997r 2  AA                   tax
001998r 2  20 rr rr             jsr     ChrGet
00199Br 2  80 D5                bra     @scan
00199Dr 2               @synErr:
00199Dr 2  4C rr rr             jmp     SynErr
0019A0r 2               @done:
0019A0r 2  E0 00                cpx     #0
0019A2r 2  D0 01                bne     @doCmp
0019A4r 2  60                   rts
0019A5r 2               @doCmp:
0019A5r 2  86 45                stx     CPRMASK
0019A7r 2                       ; Save left operand, evaluate right
0019A7r 2  20 rr rr             jsr     PushFac
0019AAr 2  20 rr rr             jsr     EvalAdd
0019ADr 2  20 rr rr             jsr     PullArg                 ; ARG = left, BAS_LVTYP = left's type
0019B0r 2                       ; Type compatibility check.
0019B0r 2  A5 86                lda     BAS_LVTYP
0019B2r 2  45 64                eor     VALTYP
0019B4r 2  10 03 4C rr          jmi     EvalTypeErr             ; one numeric, one string -> mismatch
0019B8r 2  rr           
0019B9r 2  24 64                bit     VALTYP
0019BBr 2  30 03                bmi     @strCmp
0019BDr 2                       ; Numeric comparison.
0019BDr 2  4C rr rr             jmp     RelOpsNum
0019C0r 2               @strCmp:
0019C0r 2  4C rr rr             jmp     RelOpsStr
0019C3r 2               
0019C3r 2               ; ---------------------------------------------------------------------------
0019C3r 2               ; RelOpsNum -- numeric comparison.
0019C3r 2               ; Inputs: ARG = left, FAC = right, CPRMASK = relop mask (bit 0=>, 1==, 2=<).
0019C3r 2               ; Output: FAC = -1 if (ARG <op> FAC) is true, else 0.  VALTYP = numeric.
0019C3r 2               ; ---------------------------------------------------------------------------
0019C3r 2               RelOpsNum:
0019C3r 2                       ; Replicate msbasic ARG-pre-relop fixup: clear ARG+1 high bit, then
0019C3r 2                       ; set it from ARGSIGN's MSB.  This rebuilds the implicit-1 mantissa
0019C3r 2                       ; for FCOMP's signed comparison path.
0019C3r 2  A5 1B                lda     ARGSIGN
0019C5r 2  09 7F                ora     #$7F
0019C7r 2  25 17                and     ARG+1
0019C9r 2  85 17                sta     ARG+1
0019CBr 2  A9 16                lda     #<ARG
0019CDr 2  A0 00                ldy     #$00
0019CFr 2  20 rr rr             jsr     FComp                   ; A = sign(FAC - ARG)
0019D2r 2                       ; Map A to bit position:
0019D2r 2                       ;   FAC<ARG (A=$FF): ARG>FAC  -> bit 0 (mask 1)
0019D2r 2                       ;   FAC=ARG (A=$00):           -> bit 1 (mask 2)
0019D2r 2                       ;   FAC>ARG (A=$01): ARG<FAC  -> bit 2 (mask 4)
0019D2r 2  AA                   tax
0019D3r 2  30 06                bmi     @lt
0019D5r 2  F0 08                beq     @eq
0019D7r 2  A9 04                lda     #4
0019D9r 2  80 06                bra     @check
0019DBr 2               @lt:
0019DBr 2  A9 01                lda     #1
0019DDr 2  80 02                bra     @check
0019DFr 2               @eq:
0019DFr 2  A9 02                lda     #2
0019E1r 2               @check:
0019E1r 2  25 45                and     CPRMASK
0019E3r 2  F0 07                beq     @false
0019E5r 2  A9 FF                lda     #$FF
0019E7r 2  A0 FF                ldy     #$FF
0019E9r 2  4C rr rr             jmp     GivAyf
0019ECr 2               @false:
0019ECr 2  A9 00                lda     #0
0019EEr 2  A8                   tay
0019EFr 2  4C rr rr             jmp     GivAyf
0019F2r 2               
0019F2r 2               ; ---------------------------------------------------------------------------
0019F2r 2               ; RelOpsStr -- bytewise string comparison.
0019F2r 2               ; ARG = left descriptor (ARG=len, ARG+1=lo, ARG+2=hi, ARGSIGN, ARGEXT pushed).
0019F2r 2               ; FAC = right descriptor.  CPRMASK as above.
0019F2r 2               ; ---------------------------------------------------------------------------
0019F2r 2               RelOpsStr:
0019F2r 2                       ; INDEX = left ptr, BAS_TMP1 = right ptr, BAS_TMP2 lo = left len,
0019F2r 2                       ; BAS_TMP2 hi = right len.
0019F2r 2  A5 17                lda     ARG+1
0019F4r 2  85 20                sta     INDEX
0019F6r 2  A5 18                lda     ARG+2
0019F8r 2  85 21                sta     INDEX+1
0019FAr 2  A5 0F                lda     FAC+1
0019FCr 2  85 3A                sta     BAS_TMP1
0019FEr 2  A5 10                lda     FAC+2
001A00r 2  85 3B                sta     BAS_TMP1+1
001A02r 2  A5 16                lda     ARG
001A04r 2  85 3C                sta     BAS_TMP2                ; left len
001A06r 2  A5 0E                lda     FAC
001A08r 2  85 3D                sta     BAS_TMP2+1              ; right len
001A0Ar 2                       ; Compare byte-by-byte up to min length.
001A0Ar 2  A0 00                ldy     #0
001A0Cr 2               @cmp:
001A0Cr 2                       ; Has either side ended?
001A0Cr 2  C4 3C                cpy     BAS_TMP2
001A0Er 2  F0 17                beq     @leftEnd
001A10r 2  C4 3D                cpy     BAS_TMP2+1
001A12r 2  F0 1B                beq     @rightEnd               ; right ended first -> left > right
001A14r 2  B1 20                lda     (INDEX),y
001A16r 2  D1 3A                cmp     (BAS_TMP1),y
001A18r 2  F0 0A                beq     @next
001A1Ar 2  90 04                bcc     @lt                     ; left < right
001A1Cr 2                       ; left > right
001A1Cr 2  A9 01                lda     #1
001A1Er 2  80 15                bra     @decide
001A20r 2               @lt:
001A20r 2  A9 04                lda     #4
001A22r 2  80 11                bra     @decide
001A24r 2               @next:
001A24r 2  C8                   iny
001A25r 2  80 E5                bra     @cmp
001A27r 2               @leftEnd:
001A27r 2                       ; Left ran out; check right
001A27r 2  C4 3D                cpy     BAS_TMP2+1
001A29r 2  F0 08                beq     @equal
001A2Br 2                       ; left < right (left is prefix)
001A2Br 2  A9 04                lda     #4
001A2Dr 2  80 06                bra     @decide
001A2Fr 2               @rightEnd:
001A2Fr 2                       ; right ran out, left has more; left > right
001A2Fr 2  A9 01                lda     #1
001A31r 2  80 02                bra     @decide
001A33r 2               @equal:
001A33r 2  A9 02                lda     #2
001A35r 2               @decide:
001A35r 2  25 45                and     CPRMASK
001A37r 2  F0 05                beq     @false
001A39r 2  A9 FF                lda     #$FF
001A3Br 2  A8                   tay
001A3Cr 2  80 03                bra     @ret
001A3Er 2               @false:
001A3Er 2  A9 00                lda     #0
001A40r 2  A8                   tay
001A41r 2               @ret:
001A41r 2                       ; Free temp strings before returning.  Save A,Y first.
001A41r 2  48                   pha
001A42r 2  5A                   phy
001A43r 2                       ; Free FAC's temp string (right operand).
001A43r 2  24 64                bit     VALTYP
001A45r 2  10 03                bpl     @noFreeR
001A47r 2  20 rr rr             jsr     FreFac
001A4Ar 2               @noFreeR:
001A4Ar 2                       ; Free ARG's temp string (left operand): manually restore VALTYP=$FF
001A4Ar 2                       ; and FAC := ARG, then FreFac.  (We don't always know if ARG is a
001A4Ar 2                       ; temp; FreTms inside FreTmp checks.)
001A4Ar 2  A5 16                lda     ARG
001A4Cr 2  85 0E                sta     FAC
001A4Er 2  A5 17                lda     ARG+1
001A50r 2  85 0F                sta     FAC+1
001A52r 2  A5 18                lda     ARG+2
001A54r 2  85 10                sta     FAC+2
001A56r 2                       ; +3/+4 are the descriptor's own address, which is what FreFac frees
001A56r 2                       ; by -- copying only the len/lo/hi above left FreFac looking at the
001A56r 2                       ; right operand's slot, already popped, so it never matched LASTPT and
001A56r 2                       ; the left temp was never reclaimed.  PushFac/PullArg carry these two
001A56r 2                       ; bytes through for exactly this.  One leaked slot per comparison, and
001A56r 2                       ; the third string compare in a program hit ?FORMULA TOO COMPLEX.
001A56r 2  A5 19                lda     ARG+3
001A58r 2  85 11                sta     FAC+3
001A5Ar 2  A5 1A                lda     ARG+4
001A5Cr 2  85 12                sta     FAC+4
001A5Er 2  A9 FF                lda     #$FF
001A60r 2  85 64                sta     VALTYP
001A62r 2  20 rr rr             jsr     FreFac
001A65r 2  7A                   ply
001A66r 2  68                   pla
001A67r 2  4C rr rr             jmp     GivAyf
001A6Ar 2               
001A6Ar 2               ; ===========================================================================
001A6Ar 2               ;   L E V E L 4  --  + / -
001A6Ar 2               ; ===========================================================================
001A6Ar 2               EvalAdd:
001A6Ar 2  20 rr rr             jsr     EvalMul
001A6Dr 2               @loop:
001A6Dr 2  20 rr rr             jsr     ChrGot
001A70r 2  C9 2B                cmp     #'+'
001A72r 2  F0 05                beq     @plus
001A74r 2  C9 2D                cmp     #'-'
001A76r 2  F0 27                beq     @minus
001A78r 2  60                   rts
001A79r 2               @plus:
001A79r 2  20 rr rr             jsr     ChrGet
001A7Cr 2  20 rr rr             jsr     PushFac
001A7Fr 2  20 rr rr             jsr     EvalMul
001A82r 2  20 rr rr             jsr     PullArg
001A85r 2                       ; Type dispatch.
001A85r 2  A5 86                lda     BAS_LVTYP
001A87r 2  45 64                eor     VALTYP
001A89r 2  10 03 4C rr          jmi     EvalTypeErr
001A8Dr 2  rr           
001A8Er 2  24 64                bit     VALTYP
001A90r 2  30 28                bmi     @cat
001A92r 2                       ; numeric add: FAC = ARG + FAC
001A92r 2                       ; FAddT expects: ARG is the operand, A=FAC's exponent on entry.
001A92r 2                       ; Use entry "FAddT" preceded by sign work: msbasic does
001A92r 2                       ;   bne <continue>; jmp CopyArgToFac
001A92r 2                       ; But our FAddT entry already handles that.  We need to set
001A92r 2                       ; SGNCPR = ARGSIGN ^ FACSIGN before FAddT.
001A92r 2  A5 1B                lda     ARGSIGN
001A94r 2  45 13                eor     FACSIGN
001A96r 2  85 1C                sta     SGNCPR
001A98r 2  A5 0E                lda     FAC
001A9Ar 2  20 rr rr             jsr     FAddT
001A9Dr 2  80 CE                bra     @loop
001A9Fr 2               @minus:
001A9Fr 2  20 rr rr             jsr     ChrGet
001AA2r 2  20 rr rr             jsr     PushFac
001AA5r 2  20 rr rr             jsr     EvalMul
001AA8r 2  20 rr rr             jsr     ChkNum
001AABr 2                       ; left was pushed; check pushed type via TOS-byte? Easier: we already
001AABr 2                       ; verified left is numeric on first iteration.  But left might have
001AABr 2                       ; been a string from concatenation; require numeric here:
001AABr 2  20 rr rr             jsr     PullArg
001AAEr 2  A5 86                lda     BAS_LVTYP
001AB0r 2  10 03 4C rr          jmi     EvalTypeErr
001AB4r 2  rr           
001AB5r 2                       ; FAC = ARG - FAC
001AB5r 2                       ; FSubT does: FACSIGN ^= $FF; SGNCPR = FACSIGN^ARGSIGN; jmp FAddT
001AB5r 2                       ; We need to call FSubT directly.
001AB5r 2  20 rr rr             jsr     FSubT
001AB8r 2  80 B3                bra     @loop
001ABAr 2               @cat:
001ABAr 2  20 rr rr             jsr     CatStr
001ABDr 2  80 AE                bra     @loop
001ABFr 2               
001ABFr 2               ; ---------------------------------------------------------------------------
001ABFr 2               ; CatStr -- concatenate ARG (left) + FAC (right), result in FAC.
001ABFr 2               ; ---------------------------------------------------------------------------
001ABFr 2               CatStr:
001ABFr 2                       ; Stash right's length+addr before we overwrite FAC.
001ABFr 2  A5 0E                lda     FAC
001AC1r 2  85 4D                sta     BAS_TEMP1               ; right len
001AC3r 2  A5 0F                lda     FAC+1
001AC5r 2  85 4E                sta     BAS_TEMP1+1
001AC7r 2  A5 10                lda     FAC+2
001AC9r 2  85 4F                sta     BAS_TEMP1+2
001ACBr 2                       ; Total length = ARG + FAC; abort if > 255.
001ACBr 2  18                   clc
001ACCr 2  A5 16                lda     ARG
001ACEr 2  65 4D                adc     BAS_TEMP1
001AD0r 2  B0 40                bcs     @tooLong
001AD2r 2  85 50                sta     BAS_TEMP1+3             ; total length
001AD4r 2                       ; Free both source temps before allocating result -- otherwise we
001AD4r 2                       ; pile up to 3 temps and the next PutNew throws ?FRMCPX.
001AD4r 2  20 rr rr             jsr     FreeBothTemps
001AD7r 2                       ; Allocate.
001AD7r 2  A5 50                lda     BAS_TEMP1+3             ; total length
001AD9r 2  20 rr rr             jsr     GetSpa                  ; A=total, FRESPC=buf
001ADCr 2                       ; Copy left bytes (ARG -> FRESPC).
001ADCr 2  A5 17                lda     ARG+1
001ADEr 2  85 20                sta     INDEX
001AE0r 2  A5 18                lda     ARG+2
001AE2r 2  85 21                sta     INDEX+1
001AE4r 2  A5 16                lda     ARG
001AE6r 2  F0 03                beq     @right
001AE8r 2  20 rr rr             jsr     MovStr1                 ; advances FRESPC by len
001AEBr 2               @right:
001AEBr 2                       ; Copy right bytes.
001AEBr 2  A5 4E                lda     BAS_TEMP1+1
001AEDr 2  85 20                sta     INDEX
001AEFr 2  A5 4F                lda     BAS_TEMP1+2
001AF1r 2  85 21                sta     INDEX+1
001AF3r 2  A5 4D                lda     BAS_TEMP1
001AF5r 2  F0 03                beq     @desc
001AF7r 2  20 rr rr             jsr     MovStr1
001AFAr 2               @desc:
001AFAr 2                       ; Descriptor: FAC := total len, FAC+1/2 := FRESPC - total.
001AFAr 2  A5 50                lda     BAS_TEMP1+3
001AFCr 2  85 0E                sta     FAC
001AFEr 2  38                   sec
001AFFr 2  A5 84                lda     FRESPC
001B01r 2  E5 50                sbc     BAS_TEMP1+3
001B03r 2  85 0F                sta     FAC+1
001B05r 2  A5 85                lda     FRESPC+1
001B07r 2  E9 00                sbc     #0
001B09r 2  85 10                sta     FAC+2
001B0Br 2  A9 FF                lda     #$FF
001B0Dr 2  85 64                sta     VALTYP
001B0Fr 2  4C rr rr             jmp     PutNew
001B12r 2               @tooLong:
001B12r 2  A2 09                ldx     #ERR_STRLONG
001B14r 2  4C rr rr             jmp     BasErrorVec
001B17r 2               
001B17r 2               ; ===========================================================================
001B17r 2               ;   L E V E L 5  --  * / /
001B17r 2               ; ===========================================================================
001B17r 2               EvalMul:
001B17r 2  20 rr rr             jsr     EvalPow
001B1Ar 2               @loop:
001B1Ar 2  20 rr rr             jsr     ChrGot
001B1Dr 2  C9 2A                cmp     #'*'
001B1Fr 2  F0 05                beq     @mul
001B21r 2  C9 2F                cmp     #'/'
001B23r 2  F0 27                beq     @div
001B25r 2  60                   rts
001B26r 2               @mul:
001B26r 2  20 rr rr             jsr     ChkNum
001B29r 2  20 rr rr             jsr     ChrGet
001B2Cr 2  20 rr rr             jsr     PushFac
001B2Fr 2  20 rr rr             jsr     EvalPow
001B32r 2  20 rr rr             jsr     ChkNum
001B35r 2  20 rr rr             jsr     PullArg
001B38r 2  A5 86                lda     BAS_LVTYP
001B3Ar 2  10 03 4C rr          jmi     EvalTypeErr
001B3Er 2  rr           
001B3Fr 2                       ; FAC = ARG * FAC: FMultT expects ARG + sign work.  See msbasic.
001B3Fr 2  A5 1B                lda     ARGSIGN
001B41r 2  45 13                eor     FACSIGN
001B43r 2  85 1C                sta     SGNCPR
001B45r 2  A5 0E                lda     FAC
001B47r 2  20 rr rr             jsr     FMultT
001B4Ar 2  80 CE                bra     @loop
001B4Cr 2               @div:
001B4Cr 2  20 rr rr             jsr     ChkNum
001B4Fr 2  20 rr rr             jsr     ChrGet
001B52r 2  20 rr rr             jsr     PushFac
001B55r 2  20 rr rr             jsr     EvalPow
001B58r 2  20 rr rr             jsr     ChkNum
001B5Br 2  20 rr rr             jsr     PullArg
001B5Er 2  A5 86                lda     BAS_LVTYP
001B60r 2  10 03 4C rr          jmi     EvalTypeErr
001B64r 2  rr           
001B65r 2                       ; FAC = ARG / FAC: FDivT.
001B65r 2  A5 1B                lda     ARGSIGN
001B67r 2  45 13                eor     FACSIGN
001B69r 2  85 1C                sta     SGNCPR
001B6Br 2  A5 0E                lda     FAC
001B6Dr 2  20 rr rr             jsr     FDivT
001B70r 2  80 A8                bra     @loop
001B72r 2               
001B72r 2               ; ===========================================================================
001B72r 2               ;   L E V E L 6  --  ^   (right-associative)
001B72r 2               ; ===========================================================================
001B72r 2               EvalPow:
001B72r 2  20 rr rr             jsr     EvalUnary
001B75r 2               @loop:
001B75r 2  20 rr rr             jsr     ChrGot
001B78r 2  C9 5E                cmp     #'^'
001B7Ar 2  D0 20                bne     @done
001B7Cr 2  20 rr rr             jsr     ChkNum
001B7Fr 2  20 rr rr             jsr     ChrGet
001B82r 2  20 rr rr             jsr     PushFac
001B85r 2                       ; Right-associative, which means the right-hand side is evaluated at
001B85r 2                       ; this level rather than the one below: recursing into EvalPow lets
001B85r 2                       ; the RHS take the rest of the chain, so 2^3^2 is 2^(3^2) = 512.
001B85r 2                       ; Calling EvalUnary here instead made it (2^3)^2 = 64 -- left-assoc,
001B85r 2                       ; contradicting this level's own heading.  EvalUnary still runs first
001B85r 2                       ; inside the recursion, so a term is always consumed and the recursion
001B85r 2                       ; is bounded by the length of the chain.
001B85r 2  20 rr rr             jsr     EvalPow
001B88r 2  20 rr rr             jsr     ChkNum
001B8Br 2  20 rr rr             jsr     PullArg
001B8Er 2  A5 86                lda     BAS_LVTYP
001B90r 2  10 03 4C rr          jmi     EvalTypeErr
001B94r 2  rr           
001B95r 2                       ; FPwrt computes ARG ^ FAC.  Our ported FPwrt expects ARG = base,
001B95r 2                       ; FAC = exponent, and A = FAC's exponent byte (FPwrt's first
001B95r 2                       ; instruction is `beq Exp` to short-circuit FAC==0 -> 1).
001B95r 2  A5 0E                lda     FAC
001B97r 2  20 rr rr             jsr     FPwrt
001B9Ar 2  80 D9                bra     @loop
001B9Cr 2               @done:
001B9Cr 2  60                   rts
001B9Dr 2               
001B9Dr 2               ; ===========================================================================
001B9Dr 2               ;   L E V E L 7  --  U N A R Y
001B9Dr 2               ; ===========================================================================
001B9Dr 2               EvalUnary:
001B9Dr 2  20 rr rr             jsr     ChrGot
001BA0r 2  C9 2D                cmp     #'-'
001BA2r 2  F0 07                beq     @neg
001BA4r 2  C9 2B                cmp     #'+'
001BA6r 2  F0 13                beq     @pos
001BA8r 2  4C rr rr             jmp     EvalAtom
001BABr 2               @neg:
001BABr 2  20 rr rr             jsr     ChrGet
001BAEr 2                       ; Evaluate the operand at the power level, not this one: the README
001BAEr 2                       ; puts `^` above unary `-`, so -2^2 is -(2^2) = -4.  Recursing into
001BAEr 2                       ; EvalUnary here bound the minus to the atom first and gave (-2)^2 = 4.
001BAEr 2                       ; The '-' is consumed above, so a term is always taken before this
001BAEr 2                       ; recurses and the depth is bounded by the run of signs.
001BAEr 2  20 rr rr             jsr     EvalPow
001BB1r 2  20 rr rr             jsr     ChkNum
001BB4r 2                       ; Negate FAC: flip FACSIGN bit 7.
001BB4r 2  A5 13                lda     FACSIGN
001BB6r 2  49 FF                eor     #$FF
001BB8r 2  85 13                sta     FACSIGN
001BBAr 2  60                   rts
001BBBr 2               @pos:
001BBBr 2  20 rr rr             jsr     ChrGet
001BBEr 2  4C rr rr             jmp     EvalUnary
001BC1r 2               
001BC1r 2               ; ===========================================================================
001BC1r 2               ;   L E V E L 8  --  A T O M
001BC1r 2               ; ===========================================================================
001BC1r 2               EvalAtom:
001BC1r 2  64 64                stz     VALTYP                  ; default to numeric; string paths override
001BC3r 2  20 rr rr             jsr     ChrGot
001BC6r 2  90 2A                bcc     @num                    ; digit
001BC8r 2  C9 2E                cmp     #'.'
001BCAr 2  F0 26                beq     @num
001BCCr 2  C9 22                cmp     #'"'
001BCEr 2  F0 25                beq     @str
001BD0r 2  C9 28                cmp     #'('
001BD2r 2  F0 39                beq     @paren
001BD4r 2                       ; Letter? -> variable
001BD4r 2  20 rr rr             jsr     IsLetC
001BD7r 2  B0 3D                bcs     @var
001BD9r 2                       ; Function token?
001BD9r 2  C9 CD                cmp     #TOK_INKEY
001BDBr 2  F0 60                beq     FnInkey
001BDDr 2  C9 9D                cmp     #TOK_FN
001BDFr 2  F0 0E                beq     @fnCall                 ; FN A(...) — user-defined function
001BE1r 2                       ; Hex literal in PRINT context: not here (no '$' literal supported).
001BE1r 2                       ; NVRAM is dual-role (statement at $B1, function via FnTable);
001BE1r 2                       ; allow it through even though it sits below TOK_SGN.
001BE1r 2  C9 B1                cmp     #TOK_NVRAM
001BE3r 2  F0 04                beq     @fnDisp
001BE5r 2                       ; Try function dispatch.  Every token from SGN up goes to FnDispatch,
001BE5r 2                       ; whose table holds $B6-$D0 and $E0-$E3: anything else it is handed --
001BE5r 2                       ; the statements $D1-$DF in between -- is not in it, and is a SYNTAX
001BE5r 2                       ; ERROR there.
001BE5r 2  C9 B6                cmp     #TOK_SGN
001BE7r 2  90 03                bcc     @synErr
001BE9r 2               @fnDisp:
001BE9r 2  4C rr rr             jmp     FnDispatch
001BECr 2               @synErr:
001BECr 2  4C rr rr             jmp     SynErr
001BEFr 2               @fnCall:
001BEFr 2  4C rr rr             jmp     FnCall
001BF2r 2               @num:
001BF2r 2                       ; ASCII numeric: jump to Fin.  Fin uses ChrGet to consume.
001BF2r 2  4C rr rr             jmp     Fin
001BF5r 2               @str:
001BF5r 2                       ; '"' string literal.  Advance past the opening quote WITHOUT ChrGet:
001BF5r 2                       ; ChrGet skips spaces, which would strip leading spaces inside the
001BF5r 2                       ; string literal (e.g. PRINT "   X").  Bump TXTPTR by one byte instead.
001BF5r 2  E6 04                inc     TXTPTR
001BF7r 2  D0 02                bne     @strsrc
001BF9r 2  E6 05                inc     TXTPTR+1
001BFBr 2               @strsrc:
001BFBr 2                       ; StrLit expects (Y,A) = src.  Source = TXTPTR.
001BFBr 2  A5 04                lda     TXTPTR
001BFDr 2  A4 05                ldy     TXTPTR+1
001BFFr 2  20 rr rr             jsr     StrLit
001C02r 2                       ; StrLit advances internal pointer; we need to update TXTPTR.
001C02r 2                       ; StrLit reads until $00 or '"' from (STRNG1)+y; FAC has length.
001C02r 2                       ; Compute new TXTPTR = STRNG2 (which StrLit set), or TXTPTR + len + maybe-quote.
001C02r 2                       ; STRNG2 = STRNG1 + len + (1 if hit quote else 0).  Use STRNG2.
001C02r 2  A5 1E                lda     STRNG2
001C04r 2  85 04                sta     TXTPTR
001C06r 2  A5 1F                lda     STRNG2+1
001C08r 2  85 05                sta     TXTPTR+1
001C0Ar 2                       ; If we stopped at a closing quote, TXTPTR is past it (StrLit's
001C0Ar 2                       ; @endquote path: tya/adc STRNG1 with carry set since cmp set C);
001C0Ar 2                       ; if we ran into NUL, TXTPTR sits on the NUL (clc path).  Either
001C0Ar 2                       ; is correct for ChrGot.
001C0Ar 2  4C rr rr             jmp     ChrGot                  ; preload next char (for caller chains)
001C0Dr 2               @paren:
001C0Dr 2  20 rr rr             jsr     ChrGet                  ; consume '('
001C10r 2  20 rr rr             jsr     FrmEvl
001C13r 2  4C rr rr             jmp     ChkCls                  ; expects ')'; consumes via ChrGet
001C16r 2               @var:
001C16r 2                       ; Variable lookup.  PtrGet uses CHRGET internally and leaves
001C16r 2                       ; (A,Y) = VARPNT.  VALTYP is set to $00 or $FF.
001C16r 2  20 rr rr             jsr     PtrGet
001C19r 2                       ; Fetch value into FAC.
001C19r 2  24 64                bit     VALTYP
001C1Br 2  30 07                bmi     @loadStr
001C1Dr 2                       ; numeric: FAC = (VARPNT)
001C1Dr 2  A5 3F                lda     VARPNT
001C1Fr 2  A4 40                ldy     VARPNT+1
001C21r 2  4C rr rr             jmp     LoadFacFromYa
001C24r 2               @loadStr:
001C24r 2                       ; string: copy descriptor [len][lo][hi] into FAC..FAC+2.
001C24r 2  A0 00                ldy     #0
001C26r 2  B1 3F                lda     (VARPNT),y
001C28r 2  85 0E                sta     FAC
001C2Ar 2  C8                   iny
001C2Br 2  B1 3F                lda     (VARPNT),y
001C2Dr 2  85 0F                sta     FAC+1
001C2Fr 2  C8                   iny
001C30r 2  B1 3F                lda     (VARPNT),y
001C32r 2  85 10                sta     FAC+2
001C34r 2                       ; Record the descriptor's address (= VARPNT) in FAC+3/FAC+4 so the
001C34r 2                       ; temp-free logic (FreFac/FreTms) can tell this is a variable, not a
001C34r 2                       ; temp: VARPNT's high byte is nonzero (vars live at $08xx) so it can
001C34r 2                       ; never match a temp-stack slot (all in zero page) and will not be
001C34r 2                       ; freed or reclaimed.  Without this, a stale FAC+3/FAC+4 can spuriously
001C34r 2                       ; match LASTPT and free/reclaim a live string.
001C34r 2  A5 3F                lda     VARPNT
001C36r 2  85 11                sta     FAC+3
001C38r 2  A5 40                lda     VARPNT+1
001C3Ar 2  85 12                sta     FAC+4
001C3Cr 2  60                   rts
001C3Dr 2               
001C3Dr 2               ; ---------------------------------------------------------------------------
001C3Dr 2               ; FnInkey -- INKEY (no parens).  Reads BAS_PENDKEY first; else BufferSize/
001C3Dr 2               ; ReadBuffer; else 0.  Result is unsigned 8-bit FP value.
001C3Dr 2               ; ---------------------------------------------------------------------------
001C3Dr 2               FnInkey:
001C3Dr 2  20 rr rr             jsr     ChrGet                  ; consume INKEY token
001C40r 2  AD 0E 03             lda     BAS_PENDKEY
001C43r 2  F0 09                beq     @noPend
001C45r 2                       ; consume pending key.
001C45r 2  A0 00                ldy     #0
001C47r 2  8C 0E 03             sty     BAS_PENDKEY
001C4Ar 2  A8                   tay
001C4Br 2  4C rr rr             jmp     SngFlt
001C4Er 2               @noPend:
001C4Er 2  20 rr rr             jsr     BufferSize
001C51r 2  F0 07                beq     @zero
001C53r 2  20 rr rr             jsr     ReadBuffer
001C56r 2  A8                   tay
001C57r 2  4C rr rr             jmp     SngFlt
001C5Ar 2               @zero:
001C5Ar 2  A0 00                ldy     #0
001C5Cr 2  4C rr rr             jmp     SngFlt
001C5Fr 2               
001C5Fr 2               ; ---------------------------------------------------------------------------
001C5Fr 2               ; FnDispatch -- A holds a token from TOK_SGN up.  Dispatch via FnTable, which
001C5Fr 2               ; pairs (token, handler-1); a token the table does not hold is a SYNTAX ERROR.
001C5Fr 2               ; ---------------------------------------------------------------------------
001C5Fr 2               FnDispatch:
001C5Fr 2  A2 00                ldx     #0
001C61r 2               @find:
001C61r 2  BD rr rr             lda     FnTable,x
001C64r 2  F0 14                beq     @synErr                 ; reached terminator
001C66r 2  D2 04                cmp     (TXTPTR)
001C68r 2  F0 05                beq     @match
001C6Ar 2  E8                   inx
001C6Br 2  E8                   inx
001C6Cr 2  E8                   inx
001C6Dr 2  80 F2                bra     @find
001C6Fr 2               @match:
001C6Fr 2                       ; Push handler-1 onto stack so RTS jumps to it after ChrGet.
001C6Fr 2  BD rr rr             lda     FnTable+2,x
001C72r 2  48                   pha
001C73r 2  BD rr rr             lda     FnTable+1,x
001C76r 2  48                   pha
001C77r 2  4C rr rr             jmp     ChrGet                  ; consume token, return into handler
001C7Ar 2               @synErr:
001C7Ar 2  4C rr rr             jmp     SynErr
001C7Dr 2               
001C7Dr 2               ; ---------------------------------------------------------------------------
001C7Dr 2               ; FnTable -- (token, handler-1) triples, $00-terminated.
001C7Dr 2               ; "handler-1" because we push it through RTS which adds 1.
001C7Dr 2               ; ---------------------------------------------------------------------------
001C7Dr 2               FnTable:
001C7Dr 2  B6                   .byte   TOK_SGN
001C7Er 2  rr rr                .word   FnSgn-1
001C80r 2  B7                   .byte   TOK_INT
001C81r 2  rr rr                .word   FnInt-1
001C83r 2  B8                   .byte   TOK_ABS
001C84r 2  rr rr                .word   FnAbs-1
001C86r 2  B9                   .byte   TOK_FRE
001C87r 2  rr rr                .word   FnFre-1
001C89r 2  BA                   .byte   TOK_POS
001C8Ar 2  rr rr                .word   FnPos-1
001C8Cr 2  BB                   .byte   TOK_SQR
001C8Dr 2  rr rr                .word   FnSqr-1
001C8Fr 2  BC                   .byte   TOK_RND
001C90r 2  rr rr                .word   FnRnd-1
001C92r 2  BD                   .byte   TOK_LOG
001C93r 2  rr rr                .word   FnLog-1
001C95r 2  BE                   .byte   TOK_EXP
001C96r 2  rr rr                .word   FnExp-1
001C98r 2  BF                   .byte   TOK_COS
001C99r 2  rr rr                .word   FnCos-1
001C9Br 2  C0                   .byte   TOK_SIN
001C9Cr 2  rr rr                .word   FnSin-1
001C9Er 2  C1                   .byte   TOK_TAN
001C9Fr 2  rr rr                .word   FnTan-1
001CA1r 2  C2                   .byte   TOK_ATN
001CA2r 2  rr rr                .word   FnAtn-1
001CA4r 2  C3                   .byte   TOK_PEEK
001CA5r 2  rr rr                .word   FnPeek-1
001CA7r 2  C4                   .byte   TOK_LEN
001CA8r 2  rr rr                .word   FnLen-1
001CAAr 2  C5                   .byte   TOK_STRSTR
001CABr 2  rr rr                .word   FnStrStr-1
001CADr 2  C6                   .byte   TOK_VAL
001CAEr 2  rr rr                .word   FnVal-1
001CB0r 2  C7                   .byte   TOK_ASC
001CB1r 2  rr rr                .word   FnAsc-1
001CB3r 2  C8                   .byte   TOK_CHRSTR
001CB4r 2  rr rr                .word   FnChrStr-1
001CB6r 2  C9                   .byte   TOK_LEFTSTR
001CB7r 2  rr rr                .word   FnLeftStr-1
001CB9r 2  CA                   .byte   TOK_RIGHTSTR
001CBAr 2  rr rr                .word   FnRightStr-1
001CBCr 2  CB                   .byte   TOK_MIDSTR
001CBDr 2  rr rr                .word   FnMidStr-1
001CBFr 2  CC                   .byte   TOK_JOY
001CC0r 2  rr rr                .word   FnJoy-1
001CC2r 2  B1                   .byte   TOK_NVRAM
001CC3r 2  rr rr                .word   FnNvram-1
001CC5r 2  CE                   .byte   TOK_HEX
001CC6r 2  rr rr                .word   FnHex-1
001CC8r 2  CF                   .byte   TOK_MIN
001CC9r 2  rr rr                .word   FnMin-1
001CCBr 2  D0                   .byte   TOK_MAX
001CCCr 2  rr rr                .word   FnMax-1
001CCEr 2  E0                   .byte   TOK_VPEEK
001CCFr 2  rr rr                .word   FnVpeek-1
001CD1r 2  E1                   .byte   TOK_VSTAT
001CD2r 2  rr rr                .word   FnVstat-1
001CD4r 2  E2                   .byte   TOK_NVSTAT
001CD5r 2  rr rr                .word   FnNvstat-1
001CD7r 2  E3                   .byte   TOK_NVFIND
001CD8r 2  rr rr                .word   FnNvfind-1
001CDAr 2  00                   .byte   0
001CDBr 2               
001CDBr 2               ; ---------------------------------------------------------------------------
001CDBr 2               ; Numeric-arg helpers.
001CDBr 2               ; ParenNum    -- expects "(" expr ")" with numeric result.  FAC = result.
001CDBr 2               ; ParenStr    -- expects "(" expr ")" with string result.
001CDBr 2               ; ParenU8     -- expects "(" expr ")" -> A = byte (0..255), or ?ILLQTY.
001CDBr 2               ; ParenU16    -- expects "(" expr ")" -> AyInt result in FAC+3,+4.
001CDBr 2               ; ---------------------------------------------------------------------------
001CDBr 2               ParenNum:
001CDBr 2  20 rr rr             jsr     ChkOpn
001CDEr 2  20 rr rr             jsr     FrmEvl
001CE1r 2  20 rr rr             jsr     ChkNum
001CE4r 2  4C rr rr             jmp     ChkCls
001CE7r 2               ParenStr:
001CE7r 2  20 rr rr             jsr     ChkOpn
001CEAr 2  20 rr rr             jsr     FrmEvl
001CEDr 2  20 rr rr             jsr     ChkStr
001CF0r 2  4C rr rr             jmp     ChkCls
001CF3r 2               ParenU8:
001CF3r 2  20 rr rr             jsr     ParenNum
001CF6r 2  20 rr rr             jsr     AyInt
001CF9r 2  A5 11                lda     FAC+3                   ; high byte must be 0
001CFBr 2  D0 03                bne     @bad
001CFDr 2  A5 12                lda     FAC+4                   ; low byte = result
001CFFr 2  60                   rts
001D00r 2               @bad:
001D00r 2  4C rr rr             jmp     IqErr
001D03r 2               
001D03r 2               ; ---------------------------------------------------------------------------
001D03r 2               ; Unary numeric functions (single-arg "(" num ")") -- shared body.
001D03r 2               ; Each entry sets up A = handler entry to call after ChkOpn/FrmEvl/ChkNum/ChkCls.
001D03r 2               ; ---------------------------------------------------------------------------
001D03r 2               FnSgn:
001D03r 2  20 rr rr             jsr     ParenNum
001D06r 2  4C rr rr             jmp     Sgn
001D09r 2               FnInt:
001D09r 2  20 rr rr             jsr     ParenNum
001D0Cr 2  4C rr rr             jmp     Int
001D0Fr 2               FnAbs:
001D0Fr 2  20 rr rr             jsr     ParenNum
001D12r 2  4C rr rr             jmp     Abs
001D15r 2               FnSqr:
001D15r 2  20 rr rr             jsr     ParenNum
001D18r 2  4C rr rr             jmp     Sqr
001D1Br 2               FnLog:
001D1Br 2  20 rr rr             jsr     ParenNum
001D1Er 2  4C rr rr             jmp     Log
001D21r 2               FnExp:
001D21r 2  20 rr rr             jsr     ParenNum
001D24r 2  4C rr rr             jmp     Exp
001D27r 2               FnCos:
001D27r 2  20 rr rr             jsr     ParenNum
001D2Ar 2  4C rr rr             jmp     Cos
001D2Dr 2               FnSin:
001D2Dr 2  20 rr rr             jsr     ParenNum
001D30r 2  4C rr rr             jmp     Sin
001D33r 2               FnTan:
001D33r 2  20 rr rr             jsr     ParenNum
001D36r 2  4C rr rr             jmp     Tan
001D39r 2               FnAtn:
001D39r 2  20 rr rr             jsr     ParenNum
001D3Cr 2  4C rr rr             jmp     Atn
001D3Fr 2               FnRnd:
001D3Fr 2  20 rr rr             jsr     ParenNum
001D42r 2  4C rr rr             jmp     Rnd
001D45r 2               FnHex:
001D45r 2                       ; In expression context: identity.
001D45r 2  4C rr rr             jmp     ParenNum
001D48r 2               
001D48r 2               ; ---------------------------------------------------------------------------
001D48r 2               ; FnFre -- FRE(n): returns FRETOP - STREND (free string heap).
001D48r 2               ; Argument is parsed and ignored.
001D48r 2               ; ---------------------------------------------------------------------------
001D48r 2               FnFre:
001D48r 2  20 rr rr             jsr     ParenNum
001D4Br 2  38                   sec
001D4Cr 2  AD 65 03             lda     FRETOP
001D4Fr 2  ED 63 03             sbc     STREND
001D52r 2  A8                   tay
001D53r 2  AD 66 03             lda     FRETOP+1
001D56r 2  ED 64 03             sbc     STREND+1
001D59r 2  4C rr rr             jmp     GivAyf
001D5Cr 2               
001D5Cr 2               ; ---------------------------------------------------------------------------
001D5Cr 2               ; FnPos -- POS(n): current print column.  Argument is parsed and ignored.
001D5Cr 2               ; ---------------------------------------------------------------------------
001D5Cr 2               FnPos:
001D5Cr 2  20 rr rr             jsr     ParenNum
001D5Fr 2                       ; BAS_POSX is the live column PrintCh maintains and TAB and the comma
001D5Fr 2                       ; zones already read.  This returned a hardcoded 0 -- the column was
001D5Fr 2                       ; being tracked all along, POS just never looked at it.
001D5Fr 2  AC 70 03             ldy     BAS_POSX
001D62r 2  4C rr rr             jmp     SngFlt
001D65r 2               
001D65r 2               ; ---------------------------------------------------------------------------
001D65r 2               ; FnPeek -- PEEK(addr): byte at addr -> FP.
001D65r 2               ; ---------------------------------------------------------------------------
001D65r 2               FnPeek:
001D65r 2  20 rr rr             jsr     ParenNum
001D68r 2  20 rr rr             jsr     FacToU16
001D6Br 2  A5 12                lda     FAC+4                   ; lo byte
001D6Dr 2  85 20                sta     INDEX
001D6Fr 2  A5 11                lda     FAC+3                   ; hi byte
001D71r 2  85 21                sta     INDEX+1
001D73r 2  A0 00                ldy     #0
001D75r 2  B1 20                lda     (INDEX),y
001D77r 2  A8                   tay
001D78r 2  4C rr rr             jmp     SngFlt
001D7Br 2               
001D7Br 2               ; ---------------------------------------------------------------------------
001D7Br 2               ; FnJoy -- JOY(n): 1 or 2.  If GPIO absent, returns 0.
001D7Br 2               ; ---------------------------------------------------------------------------
001D7Br 2               FnJoy:
001D7Br 2  20 rr rr             jsr     ParenU8
001D7Er 2  48                   pha
001D7Fr 2  AD 0D 03             lda     HW_PRESENT
001D82r 2  29 20                and     #HW_GPIO
001D84r 2  F0 1C                beq     @absent
001D86r 2  68                   pla
001D87r 2  C9 01                cmp     #1
001D89r 2  F0 09                beq     @j1
001D8Br 2  C9 02                cmp     #2
001D8Dr 2  F0 0C                beq     @j2
001D8Fr 2  A2 0B                ldx     #ERR_ILLQUAN
001D91r 2  4C rr rr             jmp     BasErrorVec
001D94r 2               @j1:
001D94r 2  20 rr rr             jsr     ReadJoystick1
001D97r 2  A8                   tay
001D98r 2  4C rr rr             jmp     SngFlt
001D9Br 2               @j2:
001D9Br 2  20 rr rr             jsr     ReadJoystick2
001D9Er 2  A8                   tay
001D9Fr 2  4C rr rr             jmp     SngFlt
001DA2r 2               @absent:
001DA2r 2  68                   pla
001DA3r 2                       ; $FF, not 0.  The ports are active low -- pulled high through 1K, and
001DA3r 2                       ; the stick's switches ground them -- so JOY returns the port raw and 0
001DA3r 2                       ; means every direction and button is held at once.  Reporting 0 for a
001DA3r 2                       ; machine with no VIA fitted told the caller exactly that; $FF is what
001DA3r 2                       ; an untouched stick reads, and so the honest answer for one that is
001DA3r 2                       ; not there at all.
001DA3r 2  A0 FF                ldy     #$FF
001DA5r 2  4C rr rr             jmp     SngFlt
001DA8r 2               
001DA8r 2               ; ---------------------------------------------------------------------------
001DA8r 2               ; FnNvram -- NVRAM(addr): if RTC absent, return 0.
001DA8r 2               ; ---------------------------------------------------------------------------
001DA8r 2               FnNvram:
001DA8r 2  20 rr rr             jsr     ParenU8
001DABr 2  48                   pha
001DACr 2  AD 0D 03             lda     HW_PRESENT
001DAFr 2  29 04                and     #HW_RTC
001DB1r 2  F0 09                beq     @absent
001DB3r 2  68                   pla
001DB4r 2  AA                   tax
001DB5r 2  20 rr rr             jsr     RtcReadNVRAM
001DB8r 2  A8                   tay
001DB9r 2  4C rr rr             jmp     SngFlt
001DBCr 2               @absent:
001DBCr 2  68                   pla
001DBDr 2  A0 00                ldy     #0
001DBFr 2  4C rr rr             jmp     SngFlt
001DC2r 2               
001DC2r 2               ; ---------------------------------------------------------------------------
001DC2r 2               ; FnMin / FnMax -- two numeric args, smaller / larger.
001DC2r 2               ; ---------------------------------------------------------------------------
001DC2r 2               FnMin:
001DC2r 2  20 rr rr             jsr     MinMaxArgs              ; ARG = a, FAC = b, BAS_TMP3 = sign(b-a)
001DC5r 2                       ; Want smaller: if b>=a return a (ARG); else return b (FAC).
001DC5r 2  10 01                bpl     @retArg                 ; sign>=0 means b>=a
001DC7r 2  60                   rts                             ; FAC already = b
001DC8r 2               @retArg:
001DC8r 2  4C rr rr             jmp     CopyArgToFac
001DCBr 2               FnMax:
001DCBr 2  20 rr rr             jsr     MinMaxArgs
001DCEr 2                       ; Want larger: if b>=a return b (FAC); else return a (ARG).
001DCEr 2  10 03                bpl     @retFac
001DD0r 2  4C rr rr             jmp     CopyArgToFac
001DD3r 2               @retFac:
001DD3r 2  60                   rts
001DD4r 2               
001DD4r 2               ; MinMaxArgs -- consume "(" a "," b ")" with numerics; ARG=a, FAC=b.
001DD4r 2               ; Returns A = sign(b - a) (FF/00/01) and N flag set accordingly.
001DD4r 2               MinMaxArgs:
001DD4r 2  20 rr rr             jsr     ChkOpn
001DD7r 2  20 rr rr             jsr     FrmEvl
001DDAr 2  20 rr rr             jsr     ChkNum
001DDDr 2  20 rr rr             jsr     PushFac                 ; save a
001DE0r 2  20 rr rr             jsr     ChkCom
001DE3r 2  20 rr rr             jsr     FrmEvl
001DE6r 2  20 rr rr             jsr     ChkNum
001DE9r 2  20 rr rr             jsr     ChkCls
001DECr 2  20 rr rr             jsr     PullArg                 ; ARG = a, FAC = b
001DEFr 2                       ; Stash ARG so we can restore after FComp's destructive sign-pack.
001DEFr 2  A5 16                lda     ARG
001DF1r 2  85 4D                sta     BAS_TEMP1
001DF3r 2  A5 17                lda     ARG+1
001DF5r 2  85 4E                sta     BAS_TEMP1+1
001DF7r 2  A5 18                lda     ARG+2
001DF9r 2  85 4F                sta     BAS_TEMP1+2
001DFBr 2  A5 19                lda     ARG+3
001DFDr 2  85 50                sta     BAS_TEMP1+3
001DFFr 2  A5 1A                lda     ARG+4
001E01r 2  85 51                sta     BAS_TEMP1+4
001E03r 2  A5 1B                lda     ARGSIGN
001E05r 2  85 52                sta     BAS_TEMP1+5
001E07r 2                       ; Pack ARGSIGN into bit 7 of ARG+1 so FComp reads it correctly.
001E07r 2  A5 1B                lda     ARGSIGN
001E09r 2  09 7F                ora     #$7F
001E0Br 2  25 17                and     ARG+1
001E0Dr 2  85 17                sta     ARG+1
001E0Fr 2  A9 16                lda     #<ARG
001E11r 2  A0 00                ldy     #$00
001E13r 2  20 rr rr             jsr     FComp                   ; A = sign(FAC - ARG)
001E16r 2  48                   pha
001E17r 2                       ; Restore ARG.
001E17r 2  A5 4D                lda     BAS_TEMP1
001E19r 2  85 16                sta     ARG
001E1Br 2  A5 4E                lda     BAS_TEMP1+1
001E1Dr 2  85 17                sta     ARG+1
001E1Fr 2  A5 4F                lda     BAS_TEMP1+2
001E21r 2  85 18                sta     ARG+2
001E23r 2  A5 50                lda     BAS_TEMP1+3
001E25r 2  85 19                sta     ARG+3
001E27r 2  A5 51                lda     BAS_TEMP1+4
001E29r 2  85 1A                sta     ARG+4
001E2Br 2  A5 52                lda     BAS_TEMP1+5
001E2Dr 2  85 1B                sta     ARGSIGN
001E2Fr 2  68                   pla                             ; restore A, sets N/Z flags
001E30r 2  60                   rts
001E31r 2               
001E31r 2               ; ---------------------------------------------------------------------------
001E31r 2               ; FnLen -- LEN(s$): length of string.
001E31r 2               ; ---------------------------------------------------------------------------
001E31r 2               FnLen:
001E31r 2  20 rr rr             jsr     ParenStr
001E34r 2  A5 0E                lda     FAC                     ; length
001E36r 2  48                   pha                             ; FreFac returns with Y = descriptor hi
001E37r 2  20 rr rr             jsr     FreFac                  ; release temp string if any
001E3Ar 2  68                   pla
001E3Br 2  A8                   tay
001E3Cr 2  4C rr rr             jmp     SngFlt
001E3Fr 2               
001E3Fr 2               ; ---------------------------------------------------------------------------
001E3Fr 2               ; FnAsc -- ASC(s$): code of first char; ?ILLQTY if empty.
001E3Fr 2               ; ---------------------------------------------------------------------------
001E3Fr 2               FnAsc:
001E3Fr 2  20 rr rr             jsr     ParenStr
001E42r 2  A5 0E                lda     FAC
001E44r 2  F0 15                beq     @bad
001E46r 2                       ; Read first byte of string.
001E46r 2  A5 0F                lda     FAC+1
001E48r 2  85 20                sta     INDEX
001E4Ar 2  A5 10                lda     FAC+2
001E4Cr 2  85 21                sta     INDEX+1
001E4Er 2  A0 00                ldy     #0
001E50r 2  B1 20                lda     (INDEX),y
001E52r 2  48                   pha
001E53r 2  20 rr rr             jsr     FreFac
001E56r 2  68                   pla
001E57r 2  A8                   tay
001E58r 2  4C rr rr             jmp     SngFlt
001E5Br 2               @bad:
001E5Br 2  4C rr rr             jmp     IqErr
001E5Er 2               
001E5Er 2               ; ---------------------------------------------------------------------------
001E5Er 2               ; FnChrStr -- CHR$(n): 1-char string.
001E5Er 2               ; ---------------------------------------------------------------------------
001E5Er 2               FnChrStr:
001E5Er 2  20 rr rr             jsr     ParenU8
001E61r 2  48                   pha
001E62r 2  A9 01                lda     #1
001E64r 2  20 rr rr             jsr     GetSpa                  ; (Y,X) = addr; A unchanged
001E67r 2  68                   pla
001E68r 2  A0 00                ldy     #0
001E6Ar 2  91 84                sta     (FRESPC),y
001E6Cr 2                       ; Build descriptor in FAC.
001E6Cr 2  A9 01                lda     #1
001E6Er 2  85 0E                sta     FAC
001E70r 2  A5 84                lda     FRESPC
001E72r 2  85 0F                sta     FAC+1
001E74r 2  A5 85                lda     FRESPC+1
001E76r 2  85 10                sta     FAC+2
001E78r 2                       ; Advance FRESPC past the byte we just wrote.
001E78r 2  E6 84                inc     FRESPC
001E7Ar 2  D0 02                bne     @nb
001E7Cr 2  E6 85                inc     FRESPC+1
001E7Er 2               @nb:
001E7Er 2  4C rr rr             jmp     PutNew
001E81r 2               
001E81r 2               ; ---------------------------------------------------------------------------
001E81r 2               ; FnStrStr -- STR$(n): convert numeric to string.
001E81r 2               ; ---------------------------------------------------------------------------
001E81r 2               FnStrStr:
001E81r 2  20 rr rr             jsr     ParenNum
001E84r 2  20 rr rr             jsr     Fout                    ; A=lo, Y=hi -> NUL-terminated buffer
001E87r 2                       ; (A,Y) = pointer to NUL-terminated ASCII number string in STACK2.
001E87r 2  20 rr rr             jsr     StrLit                  ; allocates + copies + PutNew
001E8Ar 2  60                   rts
001E8Br 2               
001E8Br 2               ; ---------------------------------------------------------------------------
001E8Br 2               ; FnVal -- VAL(s$): parse leading numeric from string.
001E8Br 2               ; Temporarily NUL-terminates the string in place, redirects TXTPTR, calls
001E8Br 2               ; Fin, then restores.
001E8Br 2               ; ---------------------------------------------------------------------------
001E8Br 2               FnVal:
001E8Br 2  20 rr rr             jsr     ParenStr
001E8Er 2  A5 0E                lda     FAC
001E90r 2  D0 08                bne     @nz
001E92r 2                       ; empty string -> 0
001E92r 2  20 rr rr             jsr     FreFac
001E95r 2  64 64                stz     VALTYP                  ; result is numeric (ParenStr set $FF)
001E97r 2  4C rr rr             jmp     ZeroFac
001E9Ar 2               @nz:
001E9Ar 2                       ; Stash length, address into TEMP1..TEMP1+2.
001E9Ar 2  85 4D                sta     TEMP1                   ; length
001E9Cr 2  A5 0F                lda     FAC+1
001E9Er 2  85 4E                sta     TEMP1+1
001EA0r 2  A5 10                lda     FAC+2
001EA2r 2  85 4F                sta     TEMP1+2
001EA4r 2                       ; Reclaim the argument's temp now, while FAC still holds its
001EA4r 2                       ; descriptor -- msbasic's VAL frees before parsing for the same
001EA4r 2                       ; reason.  It cannot wait until after Fin: FAC+3/+4 are the two bytes
001EA4r 2                       ; FreFac frees by, and by then they are mantissa of the parsed number.
001EA4r 2                       ; Freeing only releases the heap for reuse and nothing allocates
001EA4r 2                       ; between here and Fin, so the characters stay intact to parse.
001EA4r 2                       ; Without it the temp leaked: the empty-string path above frees, the
001EA4r 2                       ; parsing path did not, and three VALs of a literal in one program
001EA4r 2                       ; exhausted the 3-slot temp stack with ?FORMULA TOO COMPLEX.
001EA4r 2  20 rr rr             jsr     FreFac
001EA7r 2                       ; Save the byte at offset = length and replace with $00.
001EA7r 2  A5 4E                lda     TEMP1+1
001EA9r 2  85 20                sta     INDEX
001EABr 2  A5 4F                lda     TEMP1+2
001EADr 2  85 21                sta     INDEX+1
001EAFr 2  A4 4D                ldy     TEMP1
001EB1r 2  B1 20                lda     (INDEX),y
001EB3r 2  85 50                sta     TEMP1+3                 ; saved byte
001EB5r 2  A9 00                lda     #0
001EB7r 2  91 20                sta     (INDEX),y
001EB9r 2                       ; Save TXTPTR.
001EB9r 2  A5 04                lda     TXTPTR
001EBBr 2  48                   pha
001EBCr 2  A5 05                lda     TXTPTR+1
001EBEr 2  48                   pha
001EBFr 2                       ; TXTPTR := INDEX - 1, then ChrGet to load first char.
001EBFr 2  A5 4E                lda     TEMP1+1
001EC1r 2  85 04                sta     TXTPTR
001EC3r 2  A5 4F                lda     TEMP1+2
001EC5r 2  85 05                sta     TXTPTR+1
001EC7r 2  A5 04                lda     TXTPTR
001EC9r 2  D0 02                bne     @nb
001ECBr 2  C6 05                dec     TXTPTR+1
001ECDr 2               @nb:
001ECDr 2  C6 04                dec     TXTPTR
001ECFr 2  20 rr rr             jsr     ChrGet                  ; first char
001ED2r 2  20 rr rr             jsr     Fin                     ; FAC := value
001ED5r 2                       ; Restore the saved byte.
001ED5r 2  A5 4E                lda     TEMP1+1
001ED7r 2  85 20                sta     INDEX
001ED9r 2  A5 4F                lda     TEMP1+2
001EDBr 2  85 21                sta     INDEX+1
001EDDr 2  A4 4D                ldy     TEMP1
001EDFr 2  A5 50                lda     TEMP1+3
001EE1r 2  91 20                sta     (INDEX),y
001EE3r 2                       ; Restore TXTPTR.
001EE3r 2  68                   pla
001EE4r 2  85 05                sta     TXTPTR+1
001EE6r 2  68                   pla
001EE7r 2  85 04                sta     TXTPTR
001EE9r 2  64 64                stz     VALTYP                  ; Fin left VALTYP = $FF from ParenStr
001EEBr 2  60                   rts
001EECr 2               
001EECr 2               ; ---------------------------------------------------------------------------
001EECr 2               ; FnLeftStr -- LEFT$(s$, n): leftmost n chars.
001EECr 2               ; ---------------------------------------------------------------------------
001EECr 2               FnLeftStr:
001EECr 2  20 rr rr             jsr     ChkOpn
001EEFr 2  20 rr rr             jsr     FrmEvl
001EF2r 2  20 rr rr             jsr     ChkStr
001EF5r 2  20 rr rr             jsr     ChkCom
001EF8r 2  20 rr rr             jsr     PushFac                 ; save string descriptor
001EFBr 2  20 rr rr             jsr     FrmEvl
001EFEr 2  20 rr rr             jsr     ChkNum
001F01r 2  20 rr rr             jsr     ChkCls
001F04r 2  20 rr rr             jsr     AyInt
001F07r 2  20 rr rr             jsr     PullArg                 ; ARG = string descriptor (BAS_TMP1 clobbered)
001F0Ar 2                       ; FAC still holds the integer n; check range and copy now.
001F0Ar 2  A5 11                lda     FAC+3
001F0Cr 2  D0 16                bne     @bad
001F0Er 2  A5 12                lda     FAC+4
001F10r 2  85 3B                sta     BAS_TMP1+1              ; n
001F12r 2                       ; Clamp n to ARG (length).
001F12r 2  A5 3B                lda     BAS_TMP1+1
001F14r 2  C5 16                cmp     ARG
001F16r 2  90 02                bcc     @ok
001F18r 2  A5 16                lda     ARG
001F1Ar 2               @ok:
001F1Ar 2  85 3B                sta     BAS_TMP1+1
001F1Cr 2                       ; Free the source temp BEFORE allocating result so the slot frees up.
001F1Cr 2  20 rr rr             jsr     FreeArgString
001F1Fr 2                       ; Offset = 0 for LEFT$.
001F1Fr 2  64 3A                stz     BAS_TMP1
001F21r 2                       ; Allocate, copy first n bytes.
001F21r 2  4C rr rr             jmp     SubstrCommon            ; tail-call (rts to caller)
001F24r 2               @bad:
001F24r 2  4C rr rr             jmp     IqErr
001F27r 2               
001F27r 2               ; ---------------------------------------------------------------------------
001F27r 2               ; FnRightStr -- RIGHT$(s$, n): rightmost n chars.
001F27r 2               ; ---------------------------------------------------------------------------
001F27r 2               FnRightStr:
001F27r 2  20 rr rr             jsr     ChkOpn
001F2Ar 2  20 rr rr             jsr     FrmEvl
001F2Dr 2  20 rr rr             jsr     ChkStr
001F30r 2  20 rr rr             jsr     ChkCom
001F33r 2  20 rr rr             jsr     PushFac
001F36r 2  20 rr rr             jsr     FrmEvl
001F39r 2  20 rr rr             jsr     ChkNum
001F3Cr 2  20 rr rr             jsr     ChkCls
001F3Fr 2  20 rr rr             jsr     AyInt
001F42r 2  20 rr rr             jsr     PullArg                 ; ARG = string descriptor (BAS_TMP1 clobbered)
001F45r 2  A5 11                lda     FAC+3
001F47r 2  D0 1B                bne     @bad
001F49r 2  A5 12                lda     FAC+4
001F4Br 2  85 3B                sta     BAS_TMP1+1              ; n
001F4Dr 2                       ; Clamp n.
001F4Dr 2  A5 3B                lda     BAS_TMP1+1
001F4Fr 2  C5 16                cmp     ARG
001F51r 2  90 02                bcc     @ok
001F53r 2  A5 16                lda     ARG
001F55r 2               @ok:
001F55r 2  85 3B                sta     BAS_TMP1+1
001F57r 2                       ; offset = ARG - n.
001F57r 2  A5 16                lda     ARG
001F59r 2  38                   sec
001F5Ar 2  E5 3B                sbc     BAS_TMP1+1
001F5Cr 2  85 3A                sta     BAS_TMP1                ; start offset
001F5Er 2  20 rr rr             jsr     FreeArgString
001F61r 2  4C rr rr             jmp     SubstrCommon
001F64r 2               @bad:
001F64r 2  4C rr rr             jmp     IqErr
001F67r 2               
001F67r 2               ; ---------------------------------------------------------------------------
001F67r 2               ; FnMidStr -- MID$(s$, m [, n]): substring starting at m (1-based).
001F67r 2               ; ---------------------------------------------------------------------------
001F67r 2               FnMidStr:
001F67r 2  20 rr rr             jsr     ChkOpn
001F6Ar 2  20 rr rr             jsr     FrmEvl
001F6Dr 2  20 rr rr             jsr     ChkStr
001F70r 2  20 rr rr             jsr     ChkCom
001F73r 2  20 rr rr             jsr     PushFac
001F76r 2                       ; Read m.
001F76r 2  20 rr rr             jsr     FrmEvl
001F79r 2  20 rr rr             jsr     ChkNum
001F7Cr 2  20 rr rr             jsr     AyInt
001F7Fr 2  A5 11                lda     FAC+3
001F81r 2  D0 4B                bne     @bad
001F83r 2  A5 12                lda     FAC+4
001F85r 2  F0 47                beq     @bad                    ; m must be >= 1
001F87r 2  38                   sec
001F88r 2  E9 01                sbc     #1
001F8Ar 2  48                   pha                             ; offset = m-1; FrmEvl below would
001F8Br 2                                                       ; clobber BAS_TMP1, so park it here
001F8Br 2                       ; Optional ", n".
001F8Br 2  20 rr rr             jsr     ChrGot
001F8Er 2  C9 2C                cmp     #','
001F90r 2  F0 04                beq     @hasN
001F92r 2                       ; No n: take rest -> n = 255 (will clamp).
001F92r 2  A9 FF                lda     #255
001F94r 2  80 12                bra     @gotN
001F96r 2               @hasN:
001F96r 2  20 rr rr             jsr     ChrGet
001F99r 2  20 rr rr             jsr     FrmEvl
001F9Cr 2  20 rr rr             jsr     ChkNum
001F9Fr 2  20 rr rr             jsr     AyInt
001FA2r 2  A5 11                lda     FAC+3
001FA4r 2  D0 28                bne     @bad
001FA6r 2  A5 12                lda     FAC+4
001FA8r 2               @gotN:
001FA8r 2  85 3B                sta     BAS_TMP1+1
001FAAr 2  68                   pla
001FABr 2  85 3A                sta     BAS_TMP1
001FADr 2  20 rr rr             jsr     ChkCls
001FB0r 2  20 rr rr             jsr     PullArg                 ; ARG = string
001FB3r 2                       ; Clamp offset to length.
001FB3r 2  A5 3A                lda     BAS_TMP1
001FB5r 2  C5 16                cmp     ARG
001FB7r 2  90 04                bcc     @offOk
001FB9r 2  A5 16                lda     ARG                     ; offset = length -> empty result
001FBBr 2  85 3A                sta     BAS_TMP1
001FBDr 2               @offOk:
001FBDr 2                       ; Clamp n to (length - offset).
001FBDr 2  38                   sec
001FBEr 2  A5 16                lda     ARG
001FC0r 2  E5 3A                sbc     BAS_TMP1
001FC2r 2  C5 3B                cmp     BAS_TMP1+1
001FC4r 2  B0 02                bcs     @nOk
001FC6r 2  85 3B                sta     BAS_TMP1+1
001FC8r 2               @nOk:
001FC8r 2  20 rr rr             jsr     FreeArgString
001FCBr 2  4C rr rr             jmp     SubstrCommon
001FCEr 2               @bad:
001FCEr 2  4C rr rr             jmp     IqErr
001FD1r 2               
001FD1r 2               ; ---------------------------------------------------------------------------
001FD1r 2               ; SubstrCommon -- copy BAS_TMP1+1 bytes from ARG-string at offset BAS_TMP1
001FD1r 2               ; into a new heap allocation; result descriptor in FAC; PutNew.
001FD1r 2               ; ---------------------------------------------------------------------------
001FD1r 2               SubstrCommon:
001FD1r 2                       ; Allocate.
001FD1r 2  A5 3B                lda     BAS_TMP1+1
001FD3r 2  20 rr rr             jsr     GetSpa                  ; FRESPC = new buffer
001FD6r 2                       ; Source pointer = ARG+1 (lo/hi) + BAS_TMP1.
001FD6r 2  18                   clc
001FD7r 2  A5 17                lda     ARG+1
001FD9r 2  65 3A                adc     BAS_TMP1
001FDBr 2  85 20                sta     INDEX
001FDDr 2  A5 18                lda     ARG+2
001FDFr 2  69 00                adc     #0
001FE1r 2  85 21                sta     INDEX+1
001FE3r 2                       ; Copy BAS_TMP1+1 bytes from (INDEX) to (FRESPC).
001FE3r 2  A4 3B                ldy     BAS_TMP1+1
001FE5r 2  F0 0B                beq     @done
001FE7r 2  A0 00                ldy     #0
001FE9r 2               @cp:
001FE9r 2  B1 20                lda     (INDEX),y
001FEBr 2  91 84                sta     (FRESPC),y
001FEDr 2  C8                   iny
001FEEr 2  C4 3B                cpy     BAS_TMP1+1
001FF0r 2  D0 F7                bne     @cp
001FF2r 2               @done:
001FF2r 2                       ; Build descriptor.
001FF2r 2  A5 3B                lda     BAS_TMP1+1
001FF4r 2  85 0E                sta     FAC
001FF6r 2  A5 84                lda     FRESPC
001FF8r 2  85 0F                sta     FAC+1
001FFAr 2  A5 85                lda     FRESPC+1
001FFCr 2  85 10                sta     FAC+2
001FFEr 2                       ; Advance FRESPC by length consumed.
001FFEr 2  18                   clc
001FFFr 2  A5 84                lda     FRESPC
002001r 2  65 3B                adc     BAS_TMP1+1
002003r 2  85 84                sta     FRESPC
002005r 2  90 02                bcc     @nb
002007r 2  E6 85                inc     FRESPC+1
002009r 2               @nb:
002009r 2  4C rr rr             jmp     PutNew
00200Cr 2               
00200Cr 2               ; FreeArgString -- if ARG holds a temp string descriptor (most-recent
00200Cr 2               ; on TEMPST), pop just the descriptor.  Heap is left intact so callers
00200Cr 2               ; that still need the source bytes can copy them safely; orphaned heap
00200Cr 2               ; will be reclaimed by Garbag.
00200Cr 2               FreeArgString:
00200Cr 2  A5 19                lda     ARG+3                   ; descriptor address lo
00200Er 2  A4 1A                ldy     ARG+4                   ; descriptor address hi (always $00)
002010r 2  4C rr rr             jmp     FreTms
002013r 2               
002013r 2               ; Cleanup that releases both ARG's and FAC's temp descriptors (called from
002013r 2               ; CatStr after content has been stashed but before new allocation).
002013r 2               FreeBothTemps:
002013r 2                       ; Free FAC's temp first (it is currently LASTPT).
002013r 2  A5 11                lda     FAC+3
002015r 2  A4 12                ldy     FAC+4
002017r 2  20 rr rr             jsr     FreTms
00201Ar 2                       ; Then ARG's (now LASTPT after FAC's removal).
00201Ar 2  A5 19                lda     ARG+3
00201Cr 2  A4 1A                ldy     ARG+4
00201Er 2  4C rr rr             jmp     FreTms
002021r 2  60                   rts
002022r 2               
002022r 2               ; ===========================================================================
002022r 2               ;   E V A L U A T O R   -   B I N A R Y   O P E R A T O R   H E L P E R S
002022r 2               ; ===========================================================================
002022r 2               
002022r 2               ; ---------------------------------------------------------------------------
002022r 2               ; AndOp -- FAC = ARG AND FAC (bitwise on 16-bit signed ints).
002022r 2               ; ---------------------------------------------------------------------------
002022r 2               AndOp:
002022r 2  20 rr rr             jsr     AyInt                   ; FAC -> int (FAC+3=hi, FAC+4=lo)
002025r 2  A5 11                lda     FAC+3
002027r 2  85 3A                sta     BAS_TMP1                ; saved hi
002029r 2  A5 12                lda     FAC+4
00202Br 2  85 3B                sta     BAS_TMP1+1              ; saved lo
00202Dr 2  20 rr rr             jsr     CopyArgToFac
002030r 2  20 rr rr             jsr     AyInt
002033r 2  A5 12                lda     FAC+4
002035r 2  25 3B                and     BAS_TMP1+1
002037r 2  A8                   tay                             ; Y = lo result
002038r 2  A5 11                lda     FAC+3
00203Ar 2  25 3A                and     BAS_TMP1                ; A = hi result
00203Cr 2  4C rr rr             jmp     GivAyf
00203Fr 2               
00203Fr 2               ; ---------------------------------------------------------------------------
00203Fr 2               ; OrOp -- FAC = ARG OR FAC.
00203Fr 2               ; ---------------------------------------------------------------------------
00203Fr 2               OrOp:
00203Fr 2  20 rr rr             jsr     AyInt
002042r 2  A5 11                lda     FAC+3
002044r 2  85 3A                sta     BAS_TMP1                ; saved hi
002046r 2  A5 12                lda     FAC+4
002048r 2  85 3B                sta     BAS_TMP1+1              ; saved lo
00204Ar 2  20 rr rr             jsr     CopyArgToFac
00204Dr 2  20 rr rr             jsr     AyInt
002050r 2  A5 12                lda     FAC+4
002052r 2  05 3B                ora     BAS_TMP1+1
002054r 2  A8                   tay                             ; Y = lo
002055r 2  A5 11                lda     FAC+3
002057r 2  05 3A                ora     BAS_TMP1                ; A = hi
002059r 2  4C rr rr             jmp     GivAyf
00205Cr 2               
00205Cr 2               ; ---------------------------------------------------------------------------
00205Cr 2               ; NotOp -- FAC = NOT FAC (bitwise complement of 16-bit signed int).
00205Cr 2               ; ---------------------------------------------------------------------------
00205Cr 2               NotOp:
00205Cr 2  20 rr rr             jsr     AyInt
00205Fr 2  A5 12                lda     FAC+4
002061r 2  49 FF                eor     #$FF
002063r 2  A8                   tay                             ; Y = lo
002064r 2  A5 11                lda     FAC+3
002066r 2  49 FF                eor     #$FF                    ; A = hi
002068r 2  4C rr rr             jmp     GivAyf
00206Br 2               
00206Br 2               ; ---------------------------------------------------------------------------
00206Br 2               ; BasCmdLet -- minimal LET (assignment).  Entered with ChrGot returning
00206Br 2               ; the first letter of the variable name.  No `LET` keyword required.
00206Br 2               ; ---------------------------------------------------------------------------
00206Br 2               BasCmdLet:
00206Br 2  20 rr rr             jsr     PtrGet                  ; VARPNT, VALTYP set; TXTPTR past name
00206Er 2                       ; Save VARPNT and the variable's VALTYP across FrmEvl.
00206Er 2  A5 3F                lda     VARPNT
002070r 2  48                   pha
002071r 2  A5 40                lda     VARPNT+1
002073r 2  48                   pha
002074r 2  A5 64                lda     VALTYP
002076r 2  48                   pha
002077r 2  20 rr rr             jsr     ChrGot
00207Ar 2  C9 3D                cmp     #'='
00207Cr 2  D0 36                bne     @synErr
00207Er 2  20 rr rr             jsr     ChrGet
002081r 2  20 rr rr             jsr     FrmEvl
002084r 2  68                   pla                             ; saved variable VALTYP
002085r 2  85 3E                sta     BAS_TMP3
002087r 2  45 64                eor     VALTYP
002089r 2  30 2F                bmi     @typeErr
00208Br 2  68                   pla
00208Cr 2  85 40                sta     VARPNT+1
00208Er 2  68                   pla
00208Fr 2  85 3F                sta     VARPNT
002091r 2  24 3E                bit     BAS_TMP3
002093r 2  30 07                bmi     @storeStr
002095r 2                       ; Numeric: store FAC into (VARPNT) (5 bytes).
002095r 2  A6 3F                ldx     VARPNT
002097r 2  A4 40                ldy     VARPNT+1
002099r 2  4C rr rr             jmp     StoreFacAtYxRounded
00209Cr 2               @storeStr:
00209Cr 2  A0 00                ldy     #0
00209Er 2  A5 0E                lda     FAC
0020A0r 2  91 3F                sta     (VARPNT),y
0020A2r 2  C8                   iny
0020A3r 2  A5 0F                lda     FAC+1
0020A5r 2  91 3F                sta     (VARPNT),y
0020A7r 2  C8                   iny
0020A8r 2  A5 10                lda     FAC+2
0020AAr 2  91 3F                sta     (VARPNT),y
0020ACr 2                       ; If the RHS was a temporary string (StrLt2/PutNew pushed it and left
0020ACr 2                       ; its descriptor address in FAC+3/FAC+4 == LASTPT), pop it now that
0020ACr 2                       ; the variable owns the heap copy.  Pop only (FreTms), never FreFac --
0020ACr 2                       ; reclaiming would free the string we just stored.  For a plain
0020ACr 2                       ; variable RHS, @loadStr set FAC+3/FAC+4 to that variable's address
0020ACr 2                       ; (nonzero high byte), which cannot match a temp slot, so FreTms is a
0020ACr 2                       ; no-op.  Without this, >3 consecutive string LETs leak the 3-slot
0020ACr 2                       ; temp stack (?FORMULA TOO COMPLEX).
0020ACr 2  A5 11                lda     FAC+3
0020AEr 2  A4 12                ldy     FAC+4
0020B0r 2  20 rr rr             jsr     FreTms
0020B3r 2  60                   rts
0020B4r 2               @synErr:
0020B4r 2  68                   pla
0020B5r 2  68                   pla
0020B6r 2  68                   pla
0020B7r 2  4C rr rr             jmp     SynErr
0020BAr 2               @typeErr:
0020BAr 2  68                   pla
0020BBr 2  68                   pla
0020BCr 2  A2 08                ldx     #ERR_TYPEMISM
0020BEr 2  4C rr rr             jmp     BasErrorVec
0020C1r 2               
0020C1r 2               ; =============================================================================
0020C1r 2               ;   C O N T R O L   F L O W   /   S T A T E M E N T   L O O P
0020C1r 2               ;
0020C1r 2               ;   BasNewstt drives execution for both direct mode (TXTPTR in BAS_TOKBUF)
0020C1r 2               ;   and run mode (TXTPTR walks program lines from BAS_TXTTAB).  Statement
0020C1r 2               ;   dispatch follows the msbasic convention: push (routine_addr - 1) and
0020C1r 2               ;   tail-jump through ChrGet, so the routine entry is reached via RTS.
0020C1r 2               ;
0020C1r 2               ;   FOR and GOSUB store frames on the CPU stack and JMP back to BasNewstt;
0020C1r 2               ;   NEXT and RETURN scan the stack for a matching tag, then TXS to discard
0020C1r 2               ;   the frame and resume.
0020C1r 2               ; =============================================================================
0020C1r 2               
0020C1r 2               NUM_STMT_TOKENS = TOK_MEM + 1 - TOK_BASE       ; $36 entries
0020C1r 2               
0020C1r 2               BasNewstt:
0020C1r 2  20 rr rr             jsr     BasCheckBreak
0020C4r 2                       ; Save TXTPTR -> OLDTEXT for CONT, except in direct mode.
0020C4r 2  AD 6A 03             lda     BAS_CURLIN+1
0020C7r 2  C9 FF                cmp     #$FF
0020C9r 2  F0 0E                beq     @noSave
0020CBr 2  A5 04                lda     TXTPTR
0020CDr 2  8D 6D 03             sta     BAS_OLDTEXT
0020D0r 2  A5 05                lda     TXTPTR+1
0020D2r 2  8D 6E 03             sta     BAS_OLDTEXT+1
0020D5r 2                       ; And the stack depth this statement starts at: FOR and GOSUB frames
0020D5r 2                       ; are below it, anything a statement pushes is above.  A break restores
0020D5r 2                       ; SP to here, so the frames survive it and the half-finished statement
0020D5r 2                       ; does not -- which is what lets CONT resume inside a loop.  Recorded
0020D5r 2                       ; only in run mode: a direct-mode line must not move the baseline it is
0020D5r 2                       ; itself being run from.
0020D5r 2  BA                   tsx
0020D6r 2  8E 75 03             stx     BAS_STKBASE
0020D9r 2               @noSave:
0020D9r 2  A0 00                ldy     #0
0020DBr 2  B1 04                lda     (TXTPTR),y
0020DDr 2  F0 10                beq     @endLine
0020DFr 2  C9 A4                cmp     #TOK_ELSE
0020E1r 2  F0 07                beq     @skipElse               ; THEN-branch ran; skip ELSE clause to EOL
0020E3r 2  C9 3A                cmp     #':'
0020E5r 2  F0 37                beq     @nextStmt
0020E7r 2  4C rr rr             jmp     SynErr
0020EAr 2               @skipElse:
0020EAr 2                       ; Advance TXTPTR until we land on a $00 terminator.
0020EAr 2               @skLoop:
0020EAr 2  20 rr rr             jsr     ChrGet
0020EDr 2  D0 FB                bne     @skLoop
0020EFr 2                       ; Fall through to @endLine with TXTPTR at $00.
0020EFr 2               @endLine:
0020EFr 2                       ; Direct mode: end of buffer -> back to REPL.
0020EFr 2  AD 6A 03             lda     BAS_CURLIN+1
0020F2r 2  C9 FF                cmp     #$FF
0020F4r 2  D0 03                bne     @walkNext
0020F6r 2  4C rr rr             jmp     BasReadyLoop            ; OK is printed by BasReadyLoop
0020F9r 2               @walkNext:
0020F9r 2                       ; Run mode: examine next-pointer at offsets +1,+2.
0020F9r 2  A0 02                ldy     #2
0020FBr 2  B1 04                lda     (TXTPTR),y
0020FDr 2  D0 09                bne     @loadLine               ; nonzero hi -> next line exists
0020FFr 2                       ; End of program -> halt and return to REPL.  The program ran off its
0020FFr 2                       ; last line rather than stopping, so its frames are finished with.
0020FFr 2  A2 FF                ldx     #$FF
002101r 2  9A                   txs
002102r 2  8E 75 03             stx     BAS_STKBASE
002105r 2  4C rr rr             jmp     BasReadyLoop
002108r 2               @loadLine:
002108r 2  C8                   iny                             ; y=3
002109r 2  B1 04                lda     (TXTPTR),y
00210Br 2  8D 69 03             sta     BAS_CURLIN
00210Er 2  C8                   iny                             ; y=4
00210Fr 2  B1 04                lda     (TXTPTR),y
002111r 2  8D 6A 03             sta     BAS_CURLIN+1
002114r 2  98                   tya                             ; A=4
002115r 2  18                   clc
002116r 2  65 04                adc     TXTPTR
002118r 2  85 04                sta     TXTPTR
00211Ar 2  90 02                bcc     @nextStmt
00211Cr 2  E6 05                inc     TXTPTR+1
00211Er 2               @nextStmt:
00211Er 2  20 rr rr             jsr     ChrGet
002121r 2  20 rr rr             jsr     BasExecuteStatement
002124r 2  4C rr rr             jmp     BasNewstt
002127r 2               
002127r 2               ; ---------------------------------------------------------------------------
002127r 2               ; BasExecuteStatement -- A = current tokenized byte (loaded by ChrGet).
002127r 2               ;   * A = 0  -> RTS (no-op; end of statement chain).
002127r 2               ;   * A < $80 (letter) -> JMP BasCmdLet.
002127r 2               ;   * A is a statement token ($80..TOK_MEM) -> dispatch via BasTokenAddrTbl.
002127r 2               ;   * Otherwise -> ?SYNTAX ERROR.
002127r 2               ; ---------------------------------------------------------------------------
002127r 2               BasExecuteStatement:
002127r 2  F0 30                beq     @ret
002129r 2  38                   sec
00212Ar 2  E9 80                sbc     #TOK_BASE
00212Cr 2  90 25                bcc     @doLet
00212Er 2  C9 36                cmp     #NUM_STMT_TOKENS
002130r 2  B0 0D                bcs     @ext
002132r 2  0A                   asl     a
002133r 2  A8                   tay
002134r 2  B9 rr rr             lda     BasTokenAddrTbl+1,y
002137r 2  48                   pha
002138r 2  B9 rr rr             lda     BasTokenAddrTbl,y
00213Br 2  48                   pha
00213Cr 2  4C rr rr             jmp     ChrGet
00213Fr 2               @ext:
00213Fr 2                       ; Extended statement tokens DISK through NVERASE ($D1-$DF),
00213Fr 2                       ; dispatched through BasExtAddrTbl.
00213Fr 2  38                   sec
002140r 2  E9 51                sbc     #(TOK_DISK - TOK_BASE)
002142r 2  C9 0F                cmp     #(TOK_NVERASE + 1 - TOK_DISK)
002144r 2  B0 10                bcs     @synErr
002146r 2  0A                   asl     a
002147r 2  A8                   tay
002148r 2  B9 rr rr             lda     BasExtAddrTbl+1,y
00214Br 2  48                   pha
00214Cr 2  B9 rr rr             lda     BasExtAddrTbl,y
00214Fr 2  48                   pha
002150r 2  4C rr rr             jmp     ChrGet
002153r 2               @doLet:
002153r 2  4C rr rr             jmp     BasCmdLet
002156r 2               @synErr:
002156r 2  4C rr rr             jmp     SynErr
002159r 2               @ret:
002159r 2  60                   rts
00215Ar 2               
00215Ar 2               ; ---------------------------------------------------------------------------
00215Ar 2               ; BasCheckBreak -- poll input buffer for Ctrl-C / ESC.  On break, save
00215Ar 2               ; CONT context and bounce to REPL.  Other keys are stashed in BAS_PENDKEY
00215Ar 2               ; for INKEY to retrieve.
00215Ar 2               ; ---------------------------------------------------------------------------
00215Ar 2               BasCheckBreak:
00215Ar 2                       ; In direct mode (CURLIN hi == $FF) skip the break check entirely;
00215Ar 2                       ; otherwise we would drain pending REPL keystrokes and corrupt the
00215Ar 2                       ; next BasReadLine input.  Break is only meaningful while RUNning.
00215Ar 2  AD 6A 03             lda     BAS_CURLIN+1
00215Dr 2  C9 FF                cmp     #$FF
00215Fr 2  F0 13                beq     @no
002161r 2  20 rr rr             jsr     BufferSize
002164r 2  F0 0E                beq     @no
002166r 2  20 rr rr             jsr     ReadBuffer
002169r 2  C9 03                cmp     #$03
00216Br 2  F0 08                beq     @break
00216Dr 2  C9 1B                cmp     #$1B
00216Fr 2  F0 04                beq     @break
002171r 2  8D 0E 03             sta     BAS_PENDKEY
002174r 2               @no:
002174r 2  60                   rts
002175r 2               @break:
002175r 2                       ; OLDLIN/OLDTEXT already track the executing line.  Make sure the
002175r 2                       ; saved values reflect the current line so CONT can resume.
002175r 2  AD 69 03             lda     BAS_CURLIN
002178r 2  8D 6B 03             sta     BAS_OLDLIN
00217Br 2  AD 6A 03             lda     BAS_CURLIN+1
00217Er 2  8D 6C 03             sta     BAS_OLDLIN+1
002181r 2  AE 75 03             ldx     BAS_STKBASE             ; Back to the statement boundary, not to
002184r 2  9A                   txs                             ;   an empty stack: the loop this broke
002185r 2                                                       ;   out of is meant to still be there
002185r 2  20 rr rr             jsr     BasTextCRLF
002188r 2  A9 rr                lda     #<MsgBreak
00218Ar 2  A0 rr                ldy     #>MsgBreak
00218Cr 2  20 rr rr             jsr     BasPrintStr
00218Fr 2  4C rr rr             jmp     BasStopAtLine
002192r 2               
002192r 2  42 52 45 41  MsgBreak: .byte "BREAK",0
002196r 2  4B 00        
002198r 2               
002198r 2               ; ---------------------------------------------------------------------------
002198r 2               ; LinGet -- parse decimal digits at TXTPTR into BAS_LINNUM (16-bit).
002198r 2               ; Caller has set carry conditions appropriate to ChrGet entry.  TXTPTR
002198r 2               ; ends pointing at the first non-digit.
002198r 2               ; ---------------------------------------------------------------------------
002198r 2               LinGet:
002198r 2  A2 00                ldx     #0
00219Ar 2  86 08                stx     BAS_LINNUM
00219Cr 2  86 09                stx     BAS_LINNUM+1
00219Er 2               @loop:
00219Er 2  B0 3A                bcs     @done
0021A0r 2  E9 2F                sbc     #$2F                    ; carry already set
0021A2r 2  85 44                sta     CHARAC
0021A4r 2                       ; LINNUM *= 10
0021A4r 2  A5 08                lda     BAS_LINNUM
0021A6r 2  85 3A                sta     BAS_TMP1
0021A8r 2  A5 09                lda     BAS_LINNUM+1
0021AAr 2  85 3B                sta     BAS_TMP1+1
0021ACr 2  C9 19                cmp     #$19
0021AEr 2  B0 2B                bcs     @ovf
0021B0r 2  06 08                asl     BAS_LINNUM
0021B2r 2  26 09                rol     BAS_LINNUM+1
0021B4r 2  06 08                asl     BAS_LINNUM
0021B6r 2  26 09                rol     BAS_LINNUM+1
0021B8r 2  18                   clc
0021B9r 2  A5 08                lda     BAS_LINNUM
0021BBr 2  65 3A                adc     BAS_TMP1
0021BDr 2  85 08                sta     BAS_LINNUM
0021BFr 2  A5 09                lda     BAS_LINNUM+1
0021C1r 2  65 3B                adc     BAS_TMP1+1
0021C3r 2  85 09                sta     BAS_LINNUM+1
0021C5r 2  06 08                asl     BAS_LINNUM
0021C7r 2  26 09                rol     BAS_LINNUM+1
0021C9r 2  18                   clc
0021CAr 2  A5 08                lda     BAS_LINNUM
0021CCr 2  65 44                adc     CHARAC
0021CEr 2  85 08                sta     BAS_LINNUM
0021D0r 2  90 02                bcc     @nextDigit
0021D2r 2  E6 09                inc     BAS_LINNUM+1
0021D4r 2               @nextDigit:
0021D4r 2  20 rr rr             jsr     ChrGet
0021D7r 2  4C rr rr             jmp     @loop
0021DAr 2               @done:
0021DAr 2  60                   rts
0021DBr 2               @ovf:
0021DBr 2  A2 00                ldx     #ERR_SYNTAX
0021DDr 2  4C rr rr             jmp     BasErrorVec
0021E0r 2               
0021E0r 2               ; ---------------------------------------------------------------------------
0021E0r 2               ; FndLin -- find program line whose number matches BAS_LINNUM.
0021E0r 2               ;   On success: carry SET, BAS_TMP1 (LOWTR alias) = address of line.
0021E0r 2               ;   On failure: carry CLEAR, BAS_TMP1 = address where line would belong.
0021E0r 2               ; ---------------------------------------------------------------------------
0021E0r 2               FndLin:
0021E0r 2  AD 5D 03             lda     BAS_TXTTAB
0021E3r 2  AE 5E 03             ldx     BAS_TXTTAB+1
0021E6r 2               @walk:
0021E6r 2  85 3A                sta     BAS_TMP1
0021E8r 2  86 3B                stx     BAS_TMP1+1
0021EAr 2  A0 01                ldy     #1
0021ECr 2  B1 3A                lda     (BAS_TMP1),y
0021EEr 2  F0 20                beq     @notFound               ; next-hi=0 -> end of program
0021F0r 2  A0 03                ldy     #3                      ; line-num-lo offset
0021F2r 2  A5 09                lda     BAS_LINNUM+1
0021F4r 2  D1 3A                cmp     (BAS_TMP1),y            ; compare hi byte at +3? need iny
0021F6r 2                       ; Actually format: +0 next-lo, +1 next-hi, +2 num-lo, +3 num-hi
0021F6r 2  90 18                bcc     @notFound               ; LINNUM-hi < line-hi -> miss
0021F8r 2  D0 09                bne     @advance                ; LINNUM-hi > line-hi -> next line
0021FAr 2  88                   dey                             ; y=2 = num-lo
0021FBr 2  A5 08                lda     BAS_LINNUM
0021FDr 2  D1 3A                cmp     (BAS_TMP1),y
0021FFr 2  90 0F                bcc     @notFound
002201r 2  F0 0F                beq     @found
002203r 2               @advance:
002203r 2  A0 00                ldy     #0
002205r 2  B1 3A                lda     (BAS_TMP1),y
002207r 2  48                   pha
002208r 2  A0 01                ldy     #1
00220Ar 2  B1 3A                lda     (BAS_TMP1),y
00220Cr 2  AA                   tax
00220Dr 2  68                   pla
00220Er 2  B0 D6                bcs     @walk                   ; carry=1 means continue (always)
002210r 2               @notFound:
002210r 2  18                   clc
002211r 2  60                   rts
002212r 2               @found:
002212r 2  38                   sec
002213r 2  60                   rts
002214r 2               
002214r 2               ; ---------------------------------------------------------------------------
002214r 2               ; BasCmdGoto -- TXTPTR points at line-number digits.
002214r 2               ; ---------------------------------------------------------------------------
002214r 2               BasCmdGoto:
002214r 2  20 rr rr             jsr     LinGet
002217r 2  20 rr rr             jsr     BasRemn                 ; skip remainder of statement
00221Ar 2  20 rr rr             jsr     FndLin
00221Dr 2  90 0E                bcc     @undef
00221Fr 2                       ; LOWTR (BAS_TMP1) = target line addr.  TXTPTR = LOWTR - 1
00221Fr 2                       ; (so NEWSTT sees the previous line's $00 terminator at offset 0).
00221Fr 2  38                   sec
002220r 2  A5 3A                lda     BAS_TMP1
002222r 2  E9 01                sbc     #1
002224r 2  85 04                sta     TXTPTR
002226r 2  A5 3B                lda     BAS_TMP1+1
002228r 2  E9 00                sbc     #0
00222Ar 2  85 05                sta     TXTPTR+1
00222Cr 2  60                   rts
00222Dr 2               @undef:
00222Dr 2  A2 03                ldx     #ERR_UNDEFSTMT
00222Fr 2  4C rr rr             jmp     BasErrorVec
002232r 2               
002232r 2               ; ---------------------------------------------------------------------------
002232r 2               ; BasCmdGosub -- push 5-byte frame on stack, then GOTO target.
002232r 2               ; Frame layout (top-down): [tag $8C][CURLIN-lo][CURLIN-hi][TXTPTR-lo][TXTPTR-hi]
002232r 2               ; ---------------------------------------------------------------------------
002232r 2               BasCmdGosub:
002232r 2                       ; Refuse to nest deeper than page 1 can hold.  msbasic guards every
002232r 2                       ; stack-frame push with GETSTK; this is that check specialised to
002232r 2                       ; GOSUB's fixed frame (msbasic's `LDA #3 : JSR GETSTK`, i.e. 3*2
002232r 2                       ; bytes of frame plus GETSTK's $3E-byte margin for the interpreter's
002232r 2                       ; own JSR nesting inside the subroutine).  Without it the frames run
002232r 2                       ; off the bottom of the stack and corrupt page 1 instead of raising
002232r 2                       ; an error.
002232r 2  BA                   tsx
002233r 2  E0 44                cpx     #GOSUB_STACK_MIN
002235r 2  90 1A                bcc     @outOfMemory
002237r 2  A5 05                lda     TXTPTR+1
002239r 2  48                   pha
00223Ar 2  A5 04                lda     TXTPTR
00223Cr 2  48                   pha
00223Dr 2  AD 6A 03             lda     BAS_CURLIN+1
002240r 2  48                   pha
002241r 2  AD 69 03             lda     BAS_CURLIN
002244r 2  48                   pha
002245r 2  A9 8C                lda     #TOK_GOSUB
002247r 2  48                   pha
002248r 2  20 rr rr             jsr     ChrGot
00224Br 2  20 rr rr             jsr     BasCmdGoto
00224Er 2  4C rr rr             jmp     BasNewstt
002251r 2               @outOfMemory:
002251r 2  A9 02                lda     #ERR_OUTOFMEM
002253r 2  4C rr rr             jmp     BasError
002256r 2               
002256r 2               ; ---------------------------------------------------------------------------
002256r 2               ; BasCmdReturn -- locate GOSUB frame on stack and resume at saved TXTPTR.
002256r 2               ; Per msbasic: scan the CPU stack from SP+5 (skipping return-routine's caller
002256r 2               ; return + this scan's own JSR return).  RTS at end pops the leaked
002256r 2               ; EXEC-return that GOSUB left behind.
002256r 2               ; ---------------------------------------------------------------------------
002256r 2               BasCmdReturn:
002256r 2  20 rr rr             jsr     GtForPnt
002259r 2                       ; X now points to the slot just BELOW a frame tag (or end of stack).
002259r 2  9A                   txs
00225Ar 2  C9 8C                cmp     #TOK_GOSUB
00225Cr 2  F0 05                beq     @ok
00225Er 2  A2 0C                ldx     #ERR_RG
002260r 2  4C rr rr             jmp     BasErrorVec
002263r 2               @ok:
002263r 2  68                   pla                             ; tag (already in A, this discards)
002264r 2  68                   pla
002265r 2  8D 69 03             sta     BAS_CURLIN
002268r 2  68                   pla
002269r 2  8D 6A 03             sta     BAS_CURLIN+1
00226Cr 2  68                   pla
00226Dr 2  85 04                sta     TXTPTR
00226Fr 2  68                   pla
002270r 2  85 05                sta     TXTPTR+1
002272r 2                       ; Skip remainder of GOSUB-target statement (DATAN-style).
002272r 2  20 rr rr             jsr     BasDatan
002275r 2                       ; Advance TXTPTR by Y (number of bytes to terminator).
002275r 2  98                   tya
002276r 2  18                   clc
002277r 2  65 04                adc     TXTPTR
002279r 2  85 04                sta     TXTPTR
00227Br 2  90 02                bcc     @noinc
00227Dr 2  E6 05                inc     TXTPTR+1
00227Fr 2               @noinc:
00227Fr 2  60                   rts
002280r 2               
002280r 2               ; ---------------------------------------------------------------------------
002280r 2               ; GtForPnt -- scan CPU stack for FOR/GOSUB frames.
002280r 2               ;   On entry: BAS_FORPNT (FORPNT) = $FFxx for "match any tag".
002280r 2               ;   Returns: X = stack pointer where the matching frame's tag-1 lives,
002280r 2               ;            A = tag byte found (or 0 if end-of-stack).  Z=1 if found tag,
002280r 2               ;            Z=0 (A=0) if no frame found.
002280r 2               ; ---------------------------------------------------------------------------
002280r 2               GtForPnt:
002280r 2  BA                   tsx
002281r 2  E8                   inx
002282r 2  E8                   inx
002283r 2  E8                   inx
002284r 2  E8                   inx
002285r 2               @scan:
002285r 2  BD 01 01             lda     $0101,x                 ; tag candidate
002288r 2  C9 81                cmp     #TOK_FOR
00228Ar 2  D0 25                bne     @notFor
00228Cr 2                       ; Compare frame's variable address to FORPNT.
00228Cr 2  A5 47                lda     BAS_FORPNT+1
00228Er 2  D0 0A                bne     @skipVar                ; FORPNT+1 = $FF -> skip variable test
002290r 2  BD 02 01             lda     $0102,x
002293r 2  85 46                sta     BAS_FORPNT
002295r 2  BD 03 01             lda     $0103,x
002298r 2  85 47                sta     BAS_FORPNT+1
00229Ar 2               @skipVar:
00229Ar 2  DD 03 01             cmp     $0103,x
00229Dr 2  D0 07                bne     @advance
00229Fr 2  A5 46                lda     BAS_FORPNT
0022A1r 2  DD 02 01             cmp     $0102,x
0022A4r 2  F0 13                beq     @found
0022A6r 2               @advance:
0022A6r 2  8A                   txa
0022A7r 2  18                   clc
0022A8r 2  69 12                adc     #18                     ; BYTES_PER_FRAME (FOR)
0022AAr 2  AA                   tax
0022ABr 2  D0 D8                bne     @scan
0022ADr 2                       ; Walked off stack
0022ADr 2  A9 00                lda     #0
0022AFr 2  18                   clc                             ; not found
0022B0r 2  60                   rts
0022B1r 2               @notFor:
0022B1r 2  C9 8C                cmp     #TOK_GOSUB
0022B3r 2  F0 04                beq     @found
0022B5r 2  A9 00                lda     #0
0022B7r 2  18                   clc                             ; not found
0022B8r 2  60                   rts
0022B9r 2               @found:
0022B9r 2  38                   sec                             ; found; A still holds the tag or FORPNT
0022BAr 2  60                   rts
0022BBr 2               
0022BBr 2               ; ---------------------------------------------------------------------------
0022BBr 2               ; BasRemn -- scan TXTPTR forward to next ':' or end-of-line.
0022BBr 2               ; Sets Y to byte offset of terminator from current TXTPTR.  Honours quotes.
0022BBr 2               ; ---------------------------------------------------------------------------
0022BBr 2               BasDatan:
0022BBr 2  A2 3A                ldx     #':'
0022BDr 2  2C                   .byte   $2C                     ; BIT abs absorbs next 2-byte LDX
0022BEr 2               BasRemn:
0022BEr 2  A2 00                ldx     #0
0022C0r 2  86 44                stx     CHARAC
0022C2r 2  A0 00                ldy     #0
0022C4r 2  84 6A                sty     ENDCHR
0022C6r 2               @swap:
0022C6r 2  A5 6A                lda     ENDCHR
0022C8r 2  A6 44                ldx     CHARAC
0022CAr 2  85 44                sta     CHARAC
0022CCr 2  86 6A                stx     ENDCHR
0022CEr 2               @scan:
0022CEr 2  B1 04                lda     (TXTPTR),y
0022D0r 2  F0 0B                beq     @done
0022D2r 2  C5 6A                cmp     ENDCHR
0022D4r 2  F0 07                beq     @done
0022D6r 2  C8                   iny
0022D7r 2  C9 22                cmp     #'"'
0022D9r 2  F0 EB                beq     @swap
0022DBr 2  D0 F1                bne     @scan
0022DDr 2               @done:
0022DDr 2  60                   rts
0022DEr 2               
0022DEr 2               ; ---------------------------------------------------------------------------
0022DEr 2               ; Statement: REM -- skip to end of line.
0022DEr 2               ; Statement: DATA -- treated like REM at execution time (just skip).
0022DEr 2               ; ---------------------------------------------------------------------------
0022DEr 2               BasCmdRem:
0022DEr 2  20 rr rr             jsr     BasRemn
0022E1r 2  80 03                bra     BasAddon
0022E3r 2               BasCmdData:
0022E3r 2  20 rr rr             jsr     BasDatan
0022E6r 2               BasAddon:
0022E6r 2  98                   tya
0022E7r 2  18                   clc
0022E8r 2  65 04                adc     TXTPTR
0022EAr 2  85 04                sta     TXTPTR
0022ECr 2  90 02                bcc     @done
0022EEr 2  E6 05                inc     TXTPTR+1
0022F0r 2               @done:
0022F0r 2  60                   rts
0022F1r 2               
0022F1r 2               ; ---------------------------------------------------------------------------
0022F1r 2               ; Statement: IF expr THEN (linenum | stmt) [ELSE stmt]
0022F1r 2               ;   IF expr GOTO linenum is also accepted.
0022F1r 2               ;   If expr is false, skip rest of line (REM-style).
0022F1r 2               ;   ELSE: scan ahead for TOK_ELSE on this line.
0022F1r 2               ; ---------------------------------------------------------------------------
0022F1r 2               BasCmdIf:
0022F1r 2  20 rr rr             jsr     FrmEvl
0022F4r 2  20 rr rr             jsr     ChrGot
0022F7r 2  C9 88                cmp     #TOK_GOTO
0022F9r 2  F0 05                beq     @testTrue
0022FBr 2  A9 9F                lda     #TOK_THEN
0022FDr 2  20 rr rr             jsr     SynChr
002300r 2               @testTrue:
002300r 2  A5 0E                lda     FAC
002302r 2  D0 1E                bne     @true
002304r 2                       ; FALSE: scan to end-of-line OR a TOK_ELSE; if ELSE found, advance
002304r 2                       ; TXTPTR past it and resume execution there.
002304r 2  A0 00                ldy     #0
002306r 2               @searchElse:
002306r 2  B1 04                lda     (TXTPTR),y
002308r 2  F0 07                beq     @noElse
00230Ar 2  C9 A4                cmp     #TOK_ELSE
00230Cr 2  F0 09                beq     @gotElse
00230Er 2  C8                   iny
00230Fr 2  D0 F5                bne     @searchElse
002311r 2               @noElse:
002311r 2                       ; Skip remainder of line (no ELSE).
002311r 2  20 rr rr             jsr     BasRemn
002314r 2  4C rr rr             jmp     BasAddon
002317r 2               @gotElse:
002317r 2                       ; Advance TXTPTR past ELSE token, then run the ELSE branch as a
002317r 2                       ; statement.  Falling through to @true's tail is deliberate: the
002317r 2                       ; branch after ELSE is dispatched exactly like the one after THEN,
002317r 2                       ; so `ELSE <linenum>` is an implicit GOTO too.  Returning here
002317r 2                       ; instead would leave TXTPTR mid-statement and the interpreter loop
002317r 2                       ; would report ?SYNTAX ERROR.
002317r 2  C8                   iny
002318r 2  98                   tya
002319r 2  18                   clc
00231Ar 2  65 04                adc     TXTPTR
00231Cr 2  85 04                sta     TXTPTR
00231Er 2  90 02                bcc     @true
002320r 2  E6 05                inc     TXTPTR+1
002322r 2               @true:
002322r 2                       ; TRUE: if next is a digit, IF expr THEN <linenum> -> implicit GOTO.
002322r 2  20 rr rr             jsr     ChrGot
002325r 2  90 03                bcc     @goto                   ; carry CLEAR -> digit
002327r 2                       ; Otherwise dispatch as a statement (msbasic: jmp EXECUTE_STATEMENT).
002327r 2  4C rr rr             jmp     BasExecuteStatement
00232Ar 2               @goto:
00232Ar 2  4C rr rr             jmp     BasCmdGoto
00232Dr 2               
00232Dr 2               ; ---------------------------------------------------------------------------
00232Dr 2               ; Statement: ON expr GOTO/GOSUB linenum,linenum,...
00232Dr 2               ; ---------------------------------------------------------------------------
00232Dr 2               BasCmdOn:
00232Dr 2  20 rr rr             jsr     GetByt                  ; X = expr byte (1..255)
002330r 2  48                   pha                             ; save GOTO/GOSUB token byte
002331r 2  C9 8C                cmp     #TOK_GOSUB
002333r 2  F0 04                beq     @loop
002335r 2  C9 88                cmp     #TOK_GOTO
002337r 2  D0 14                bne     @synErr
002339r 2               @loop:
002339r 2  C6 12                dec     FAC+4
00233Br 2  D0 04                bne     @next
00233Dr 2  68                   pla
00233Er 2                       ; Re-dispatch through statement table so trampoline ChrGet skips the
00233Er 2                       ; current separator (',' or 0) before the GOTO/GOSUB handler runs.
00233Er 2  4C rr rr             jmp     BasExecuteStatement
002341r 2               @next:
002341r 2  20 rr rr             jsr     ChrGet
002344r 2  20 rr rr             jsr     LinGet
002347r 2  C9 2C                cmp     #','
002349r 2  F0 EE                beq     @loop
00234Br 2  68                   pla
00234Cr 2  60                   rts
00234Dr 2               @synErr:
00234Dr 2  68                   pla
00234Er 2  4C rr rr             jmp     SynErr
002351r 2               
002351r 2               ; ---------------------------------------------------------------------------
002351r 2               ; GetByt / GtByteCom -- evaluate expression in TXTPTR to byte 0..255 in X.
002351r 2               ;   GetByt: TXTPTR is at first byte of expression.
002351r 2               ;   GtByteCom: consume comma first.
002351r 2               ; ---------------------------------------------------------------------------
002351r 2               GtByteCom:
002351r 2  20 rr rr             jsr     ChrGet
002354r 2               GetByt:
002354r 2  20 rr rr             jsr     FrmNum
002357r 2  20 rr rr             jsr     MkInt
00235Ar 2  A6 11                ldx     FAC+3
00235Cr 2  D0 05                bne     @ovf
00235Er 2  A6 12                ldx     FAC+4
002360r 2  4C rr rr             jmp     ChrGot
002363r 2               @ovf:
002363r 2  4C rr rr             jmp     IqErr
002366r 2               
002366r 2               ; ---------------------------------------------------------------------------
002366r 2               ; Statement: RUN [linenum]
002366r 2               ; ---------------------------------------------------------------------------
002366r 2               BasCmdRun:
002366r 2  20 rr rr             jsr     ChrGot
002369r 2  D0 21                bne     @withLine
00236Br 2  20 rr rr             jsr     BasCmdClr
00236Er 2                       ; Set TXTPTR = TXTTAB - 1 ; ensure that byte = 0.
00236Er 2  38                   sec
00236Fr 2  AD 5D 03             lda     BAS_TXTTAB
002372r 2  E9 01                sbc     #1
002374r 2  85 04                sta     TXTPTR
002376r 2  AD 5E 03             lda     BAS_TXTTAB+1
002379r 2  E9 00                sbc     #0
00237Br 2  85 05                sta     TXTPTR+1
00237Dr 2                       ; Force the byte at TXTTAB-1 to be zero so NEWSTT walks the chain.
00237Dr 2  A9 00                lda     #0
00237Fr 2  A0 00                ldy     #0
002381r 2  91 04                sta     (TXTPTR),y
002383r 2                       ; Leave direct-mode (CURLIN+1=$FF); @loadLine will set real value.
002383r 2  9C 69 03             stz     BAS_CURLIN
002386r 2  9C 6A 03             stz     BAS_CURLIN+1
002389r 2                       ; Straight back into the statement loop rather than RTS, as msbasic's
002389r 2                       ; RUN does: CLR above has just reset the stack, so the return address
002389r 2                       ; this was dispatched with is no longer on it -- which is the point.  A
002389r 2                       ; program that starts on top of a suspended one's FOR frames is a
002389r 2                       ; program whose first NEXT can find the wrong loop.
002389r 2  4C rr rr             jmp     BasNewstt
00238Cr 2               @withLine:
00238Cr 2  20 rr rr             jsr     BasCmdClr
00238Fr 2  20 rr rr             jsr     ChrGot
002392r 2  20 rr rr             jsr     BasCmdGoto              ; does not return if the line is undefined
002395r 2                       ; Leave direct mode, exactly as the bare RUN path above does.
002395r 2                       ; BasCmdGoto only moves TXTPTR; while CURLIN+1 is still $FF, BasNewstt
002395r 2                       ; treats the branch target as an immediate-mode statement and returns
002395r 2                       ; to the READY loop after it -- so `RUN 20` printed nothing at all.
002395r 2                       ; Set after the branch, not before, so an undefined line still reports
002395r 2                       ; `?UNDEF'D STATEMENT ERROR` with no spurious `IN 0` line number.
002395r 2  9C 69 03             stz     BAS_CURLIN
002398r 2  9C 6A 03             stz     BAS_CURLIN+1
00239Br 2  4C rr rr             jmp     BasNewstt               ; as the bare path above: CLR reset the
00239Er 2                                                       ;   stack this was dispatched from
00239Er 2               
00239Er 2               ; ---------------------------------------------------------------------------
00239Er 2               ; Statement: END / STOP -- save CONT context and return to REPL.
00239Er 2               ; ---------------------------------------------------------------------------
00239Er 2               BasCmdEnd:
00239Er 2  18                   clc
00239Fr 2  24                   .byte   $24                     ; BIT zp -> skip next byte (sec)
0023A0r 2               BasCmdStop:
0023A0r 2  38                   sec
0023A1r 2                       ; Save the END/STOP flag (carry) before ChrGot clobbers it.
0023A1r 2  08                   php
0023A2r 2  20 rr rr             jsr     ChrGot
0023A5r 2  D0 2D                bne     @synErrPlp
0023A7r 2  28                   plp
0023A8r 2                       ; Save CONT state.
0023A8r 2  A5 04                lda     TXTPTR
0023AAr 2  8D 6D 03             sta     BAS_OLDTEXT
0023ADr 2  A5 05                lda     TXTPTR+1
0023AFr 2  8D 6E 03             sta     BAS_OLDTEXT+1
0023B2r 2  AD 69 03             lda     BAS_CURLIN
0023B5r 2  8D 6B 03             sta     BAS_OLDLIN
0023B8r 2  AD 6A 03             lda     BAS_CURLIN+1
0023BBr 2  8D 6C 03             sta     BAS_OLDLIN+1
0023BEr 2  AE 75 03             ldx     BAS_STKBASE             ; As with a Ctrl+C break: keep the FOR
0023C1r 2  9A                   txs                             ;   and GOSUB frames for CONT
0023C2r 2  90 0D                bcc     @end
0023C4r 2                       ; STOP path: print "BREAK[ IN nnnn]".
0023C4r 2  20 rr rr             jsr     BasTextCRLF
0023C7r 2  A9 rr                lda     #<MsgBreak
0023C9r 2  A0 rr                ldy     #>MsgBreak
0023CBr 2  20 rr rr             jsr     BasPrintStr
0023CEr 2  4C rr rr             jmp     BasStopAtLine
0023D1r 2               @end:
0023D1r 2  4C rr rr             jmp     BasStopDirect
0023D4r 2               @synErrPlp:
0023D4r 2  28                   plp
0023D5r 2               @synErr:
0023D5r 2  4C rr rr             jmp     SynErr
0023D8r 2               
0023D8r 2               ; ---------------------------------------------------------------------------
0023D8r 2               ; Statement: CONT -- resume execution from saved OLDTEXT/OLDLIN.
0023D8r 2               ; ---------------------------------------------------------------------------
0023D8r 2               BasCmdCont:
0023D8r 2  20 rr rr             jsr     ChrGot
0023DBr 2  D0 21                bne     @synErr
0023DDr 2  AD 6E 03             lda     BAS_OLDTEXT+1
