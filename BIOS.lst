0009D0r 2               
0009D0r 2               DisOpIzy:
0009D0r 2  A9 28          lda #'('
0009D2r 2  20 rr rr       jsr Chrout
0009D5r 2  20 rr rr       jsr DisOpZp
0009D8r 2  A9 29          lda #')'
0009DAr 2  20 rr rr       jsr Chrout
0009DDr 2  A9 2C          lda #','
0009DFr 2  20 rr rr       jsr Chrout
0009E2r 2  A9 59          lda #'Y'
0009E4r 2  4C rr rr       jmp Chrout
0009E7r 2               
0009E7r 2               DisOpZpi:
