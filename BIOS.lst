00316Er 2               ; =============================================================================
00316Er 2               
00316Er 2               ErrorMessages:
00316Er 2  53 59 4E 54          .byte   "SYNTAX",0              ; ERR_SYNTAX
003172r 2  41 58 00     
003175r 2  4F 56 45 52          .byte   "OVERFLOW",0            ; ERR_OVERFLOW
003179r 2  46 4C 4F 57  
00317Dr 2  00           
00317Er 2  4F 55 54 20          .byte   "OUT OF MEMORY",0       ; ERR_OUTOFMEM
003182r 2  4F 46 20 4D  
003186r 2  45 4D 4F 52  
00318Cr 2  55 4E 44 45          .byte   "UNDEF'D STATEMENT",0   ; ERR_UNDEFSTMT
003190r 2  46 27 44 20  
003194r 2  53 54 41 54  
00319Er 2  42 41 44 20          .byte   "BAD SUBSCRIPT",0       ; ERR_BADSUBSCR
0031A2r 2  53 55 42 53  
0031A6r 2  43 52 49 50  
0031ACr 2  52 45 44 49          .byte   "REDIM'D ARRAY",0       ; ERR_REDIM
0031B0r 2  4D 27 44 20  
0031B4r 2  41 52 52 41  
0031BAr 2  44 49 56 49          .byte   "DIVISION BY ZERO",0    ; ERR_DIVZERO
0031BEr 2  53 49 4F 4E  
0031C2r 2  20 42 59 20  
0031CBr 2  49 4C 4C 45          .byte   "ILLEGAL DIRECT",0      ; ERR_ILLDIRECT
0031CFr 2  47 41 4C 20  
0031D3r 2  44 49 52 45  
0031DAr 2  54 59 50 45          .byte   "TYPE MISMATCH",0       ; ERR_TYPEMISM
0031DEr 2  20 4D 49 53  
0031E2r 2  4D 41 54 43  
0031E8r 2  53 54 52 49          .byte   "STRING TOO LONG",0     ; ERR_LONGSTR
0031ECr 2  4E 47 20 54  
0031F0r 2  4F 4F 20 4C  
