000000r 2               ;   Linker cfg  :  BIOS.cfg
000000r 2               ;
000000r 2               ;   Coding style :  Match the rest of the BIOS project.
000000r 2               ;                   * Routine / data labels : PascalCase  (e.g. BasEntry,
000000r 2               ;                     FAdd, NormalizeFac1, Lbl367F).
000000r 2               ;                   * Constants / equates    : UPPER_SNAKE_CASE
000000r 2               ;                     (e.g. BAS_TXTPTR, TOK_PRINT, ERR_SYNTAX).
000000r 2               ;                   * Local labels           : @camelCase or @PascalCase.
000000r 2               ;                   * Opcodes are lowercase.
000000r 2               ;
000000r 2               ;   Reference source tree:  msbasic-master/  (read-only; NOT linked).
000000r 2               ; =============================================================================
000000r 2               
000000r 2                       .segment "BASIC"
000000r 2               
000000r 2                       .macpack longbranch     ; jeq/jne/etc. used by ported MSBASIC FP code
000000r 3               .macro  jeq     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                       bne     *+5
000000r 3                       jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               beq     Target
000000r 3                       .else
000000r 3                               bne     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jne     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               beq     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bne     Target
000000r 3                       .else
000000r 3                               beq     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jmi     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bpl     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bmi     Target
000000r 3                       .else
000000r 3                               bpl     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jpl     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bmi     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bpl     Target
000000r 3                       .else
000000r 3                               bmi     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jcs     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bcc     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bcs     Target
000000r 3                       .else
000000r 3                               bcc     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jcc     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bcs     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bcc     Target
000000r 3                       .else
000000r 3                               bcs     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jvs     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bvc     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bvs     Target
000000r 3                       .else
000000r 3                               bvc     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jvc     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bvs     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bvc     Target
000000r 3                       .else
000000r 3                               bvs     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   Z E R O - P A G E   E Q U A T E S
000000r 2               ;
000000r 2               ;   $00-$03   Kernal reserved
000000r 2               ;   $04-$23   BASIC primary workspace
000000r 2               ;   $24-$39   Kernal reserved
000000r 2               ;   $3A-$FF   BASIC spill (FP scratch in later phases)
000000r 2               ; =============================================================================
000000r 2               
000000r 2               BAS_TXTPTR      := $04          ; $04-$05  ChrGet / parse pointer
000000r 2               BAS_CURLINE     := $06          ; $06-$07  Pointer to current executing line
000000r 2               BAS_LINNUM      := $08          ; $08-$09  Parsed line number / scratch (= LINNUM)
000000r 2               
000000r 2               ; ----- Floating-point primary block ($0A-$1B, contiguous) -------------------
000000r 2               ; The MSBASIC float code accesses these via ZP,X with one label as the
000000r 2               ; immediate base (e.g. EXPSGN,X / SHIFTSIGNEXT,X / TMPEXP,X), so this entire
000000r 2               ; block MUST stay contiguous in this exact order.  See msbasic-master/
000000r 2               ; zeropage.s for the reference layout.
000000r 2               BAS_TMPEXP      := $0A          ; $0A      TMPEXP / INDX (alias)
000000r 2               BAS_INDX        := $0A          ; $0A      (alias of TMPEXP per msbasic SMALL)
000000r 2               BAS_EXPON       := $0B          ; $0B      EXPON
000000r 2               BAS_LOWTR       := $0C          ; $0C      LOWTR
000000r 2               BAS_EXPSGN      := $0D          ; $0D      EXPSGN  (== FAC-1 scratch byte)
000000r 2               BAS_FAC         := $0E          ; $0E-$12  FAC  (5 bytes)
000000r 2               BAS_FACSIGN     := $13          ; $13      FACSIGN  (== FAC+5)
000000r 2               BAS_SERLEN      := $14          ; $14      SERLEN
000000r 2               BAS_SHIFTSGN    := $15          ; $15      SHIFTSIGNEXT (== ARG-1 scratch)
000000r 2               BAS_ARG         := $16          ; $16-$1A  ARG  (5 bytes)
000000r 2               BAS_ARGSIGN     := $1B          ; $1B      ARGSIGN  (== ARG+5)
000000r 2               ; ----------------------------------------------------------------------------
000000r 2               
000000r 2               BAS_STRNG1      := $1C          ; $1C-$1D  STRNG1 (= SGNCPR; +1 = FACEXTENSION)
000000r 2               BAS_STRNG2      := $1E          ; $1E-$1F  STRNG2
000000r 2               
000000r 2               BAS_INDEX       := $20          ; $20-$21  General index pointer (line walk + msbasic INDEX)
000000r 2               BAS_DEST        := $22          ; $22-$23  Destination pointer (msbasic DEST)
000000r 2               
000000r 2               ; ----- Spill area: $3A-$67 --------------------------------------------------
000000r 2               BAS_TMP1        := $3A          ; $3A-$3B  General-purpose 16-bit pointer
000000r 2               BAS_TMP2        := $3C          ; $3C-$3D  General-purpose 16-bit pointer
000000r 2               BAS_TMP3        := $3E          ; $3E      Spill scratch byte
000000r 2               BAS_VARPNT      := $3F          ; $3F-$40  Current variable address
000000r 2               BAS_QUOTEFLG    := $41          ; $41      Tokenizer quote-state
000000r 2               BAS_DETOKY      := $42          ; $42      Saved Y across detokenize calls
000000r 2               
000000r 2               ; FP-only scratch registers (single bytes unless noted)
000000r 2               BAS_ARGEXT      := $43          ; ARGEXTENSION
000000r 2               BAS_CHARAC      := $44          ; CHARAC (string-quote/end char tracker)
000000r 2               BAS_CPRMASK     := $45          ; CPRMASK (FComp result mask)
000000r 2               BAS_FORPNT      := $46          ; $46-$47  FORPNT
000000r 2               BAS_RESULT      := $48          ; $48-$4C  RESULT  (5-byte FMult accumulator)
000000r 2               BAS_TEMP1       := $4D          ; $4D-$51  TEMP1  (5-byte FP scratch)
000000r 2               BAS_TEMP2       := $52          ; $52-$56  TEMP2  (5-byte FP scratch)
000000r 2               BAS_TEMP3       := $57          ; $57-$5B  TEMP3  (5-byte FP scratch)
000000r 2               BAS_RNDSEED     := $5C          ; $5C-$60  RNDSEED (5-byte FP value)
000000r 2               BAS_KWPTR       := $61          ; $61-$62  Keyword-table walker pointer
000000r 2               
000000r 2               ; ----- Variable / array / string-heap workspace ($63-$85) -----------------
000000r 2               BAS_DIMFLG      := $63          ; DIM-mode flag (nonzero = called from DIM)
000000r 2               BAS_VALTYP      := $64          ; $64-$65  Value type ($00=numeric, $FF=string)
000000r 2               BAS_EOLPNTR     := $66          ; Array scratch: dim count / pointer
000000r 2               BAS_DATAFLG     := $67          ; GetSpa: GC retry flag
000000r 2               BAS_SUBFLG      := $68          ; PtrGet: $40 from GETARYPT, $80 from DEF FN
000000r 2               BAS_INPUTFLG    := $69          ; INPUT/READ flag
000000r 2               BAS_ENDCHR      := $6A          ; StrLt2 secondary terminator
000000r 2               BAS_TEMPPT      := $6B          ; Top-of-temp-string-stack pointer
000000r 2               BAS_LASTPT      := $6C          ; $6C-$6D  Last temp descriptor allocated
000000r 2               BAS_TEMPST      := $6E          ; $6E-$76  Temp descriptor stack (3 * 3 bytes)
000000r 2               BAS_HIGHDS      := $77          ; $77-$78  Bltu dest end+1
000000r 2               BAS_HIGHTR      := $79          ; $79-$7A  Bltu source end+1
000000r 2               BAS_VARNAM      := $7B          ; $7B-$7C  Variable name pair (with type bits)
000000r 2               BAS_DSCPTR      := $7D          ; $7D-$7E  String descriptor pointer
000000r 2               BAS_DSCLEN      := $7F          ; $7F-$80  String descriptor length / GC scratch
000000r 2               BAS_FNCNAM      := $81          ; $81-$82  GC: highest-string descriptor ptr
000000r 2               BAS_Z52         := $83          ; GC scratch byte
000000r 2               BAS_FRESPC      := $84          ; $84-$85  Free-string-space pointer
000000r 2               ; ----------------------------------------------------------------------------
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; Symbol aliases used by the inlined MSBASIC FP code.  These let the ported
000000r 2               ; routines keep their original names without a global rename pass.
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               FAC             := BAS_FAC
000000r 2               FAC_LAST        := BAS_FAC + 4
000000r 2               FACSIGN         := BAS_FACSIGN
000000r 2               ARG             := BAS_ARG
000000r 2               ARG_LAST        := BAS_ARG + 4
000000r 2               ARGSIGN         := BAS_ARGSIGN
000000r 2               INDEX           := BAS_INDEX
000000r 2               DEST            := BAS_DEST
000000r 2               STRNG1          := BAS_STRNG1
000000r 2               STRNG2          := BAS_STRNG2
000000r 2               SGNCPR          := BAS_STRNG1            ; aliased as in msbasic zeropage.s
000000r 2               FACEXTENSION    := BAS_STRNG1 + 1        ; aliased as in msbasic zeropage.s
000000r 2               TXTPTR          := BAS_TXTPTR
000000r 2               LINNUM          := BAS_LINNUM
000000r 2               CURLIN          := BAS_CURLIN            ; non-ZP ($0369) — only used by InPrt
000000r 2               VARPNT          := BAS_VARPNT
000000r 2               ARGEXTENSION    := BAS_ARGEXT
000000r 2               EXPON           := BAS_EXPON
000000r 2               EXPSGN          := BAS_EXPSGN
000000r 2               LOWTR           := BAS_LOWTR
000000r 2               INDX            := BAS_INDX
000000r 2               TMPEXP          := BAS_TMPEXP
000000r 2               SERLEN          := BAS_SERLEN
000000r 2               SHIFTSIGNEXT    := BAS_SHIFTSGN
000000r 2               CHARAC          := BAS_CHARAC
000000r 2               CPRMASK         := BAS_CPRMASK
000000r 2               FORPNT          := BAS_FORPNT
000000r 2               RESULT          := BAS_RESULT
000000r 2               RESULT_LAST     := BAS_RESULT + 4
000000r 2               TEMP1           := BAS_TEMP1
000000r 2               TEMP2           := BAS_TEMP2
000000r 2               TEMP3           := BAS_TEMP3
000000r 2               RNDSEED         := BAS_RNDSEED
000000r 2               
000000r 2               ; ----- Aliases used by ported msbasic var/array/string code ----------------
000000r 2               DIMFLG          := BAS_DIMFLG
000000r 2               VALTYP          := BAS_VALTYP
000000r 2               EOLPNTR         := BAS_EOLPNTR
000000r 2               DATAFLG         := BAS_DATAFLG
000000r 2               SUBFLG          := BAS_SUBFLG
000000r 2               INPUTFLG        := BAS_INPUTFLG
000000r 2               ENDCHR          := BAS_ENDCHR
000000r 2               TEMPPT          := BAS_TEMPPT
000000r 2               LASTPT          := BAS_LASTPT
000000r 2               TEMPST          := BAS_TEMPST
000000r 2               HIGHDS          := BAS_HIGHDS
000000r 2               HIGHTR          := BAS_HIGHTR
000000r 2               VARNAM          := BAS_VARNAM
000000r 2               DSCPTR          := BAS_DSCPTR
000000r 2               DSCLEN          := BAS_DSCLEN
000000r 2               FNCNAM          := BAS_FNCNAM
000000r 2               Z52             := BAS_Z52
000000r 2               FRESPC          := BAS_FRESPC
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; Constants required by the ported FP code.
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               BYTES_FP        = 5
000000r 2               MANTISSA_BYTES  = 4
000000r 2               MAX_EXPON       = 10
000000r 2               STACK2          = $0100             ; Fout output buffer base (bottom of stack page)
000000r 2               
000000r 2               ; Variable / array layout constants (CONFIG_2 / CBM2-class equivalents).
000000r 2               BYTES_PER_VARIABLE = 7              ; 2 name + 5 value (numeric or descriptor)
000000r 2               BYTES_PER_ELEMENT  = 5              ; numeric array element size
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; Aliases for the runtime pointers that live in $035D+ (defined in BIOS.inc).
000000r 2               ; The msbasic var/array/string code references them by these short names.
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               TXTTAB          := BAS_TXTTAB
000000r 2               VARTAB          := BAS_VARTAB
000000r 2               ARYTAB          := BAS_ARYTAB
000000r 2               STREND          := BAS_STREND
000000r 2               FRETOP          := BAS_FRETOP
000000r 2               MEMSIZ          := BAS_MEMSIZ
000000r 2               
000000r 2               ; ERR_OVERFLOW / ERR_DIVZERO already defined below; alias zerodiv:
000000r 2               ERR_ZERODIV     = 6                 ; matches ERR_DIVZERO
000000r 2               
000000r 2               ; Fin parses these as numeric-prefix tokens.  Final token assignments are
000000r 2               ; wired up when the expression evaluator goes live; until then $00 is fine
000000r 2               ; (will not appear in tokenised input).
000000r 2               TOKEN_PLUS      = $00
000000r 2               TOKEN_MINUS     = $00
000000r 2               
000000r 2               ; Rnd(0) source: 6 stable but variable bytes from kernel vars (IRQ_PTR/BRK_PTR
000000r 2               ; etc.).  Just needs to exist — used only when Rnd is called with arg 0.
000000r 2               ENTROPY         = $0300
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   R A M   L A Y O U T   ( B A S I C   W O R K S P A C E )
000000r 2               ;
000000r 2               ;   $0400-$04FF   Input line buffer (256 bytes)
000000r 2               ;   $0500-$05FF   Tokenized line scratch (256 bytes)
000000r 2               ;
000000r 2               ;   GOSUB / FOR stacks live elsewhere; $0500-$05FF doubles as the
000000r 2               ;   tokenization scratch buffer.  $0600-$07FF overlaps FS_SECTOR_BUF and
000000r 2               ;   is left untouched here.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               BAS_LINBUF      := $0400        ; Raw input line  (NUL-terminated)
000000r 2               BAS_TOKBUF      := $0500        ; Tokenized scratch buffer (NUL-terminated)
000000r 2               
000000r 2               BAS_LINBUF_MAX  = 200           ; Max accepted input length (bytes)
000000r 2               BAS_TOKBUF_MAX  = 250           ; Max tokenized payload bytes
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   P R O G R A M   S T O R A G E
000000r 2               ;
000000r 2               ;   Lines at $0800+ : [next-lo][next-hi][num-lo][num-hi][tokens...][$00]
000000r 2               ;   End-of-program  : a "next-pointer" of $0000.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               BAS_PRG_START   = $0800
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   T O K E N   E Q U A T E S
000000r 2               ;
000000r 2               ;   Tokens are assigned sequentially starting at $80.  KEEP THE TABLE BELOW
000000r 2               ;   IN SYNC WITH THESE EQUATES.  If you reorder or insert keywords, renumber.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               TOK_BASE        = $80
000000r 2               
000000r 2               TOK_END         = $80
000000r 2               TOK_FOR         = $81
000000r 2               TOK_NEXT        = $82
000000r 2               TOK_DATA        = $83
000000r 2               TOK_INPUT       = $84
000000r 2               TOK_DIM         = $85
000000r 2               TOK_READ        = $86
000000r 2               TOK_LET         = $87
000000r 2               TOK_GOTO        = $88
000000r 2               TOK_RUN         = $89
000000r 2               TOK_IF          = $8A
000000r 2               TOK_RESTORE     = $8B
000000r 2               TOK_GOSUB       = $8C
000000r 2               TOK_RETURN      = $8D
000000r 2               TOK_REM         = $8E
000000r 2               TOK_STOP        = $8F
000000r 2               TOK_ON          = $90
000000r 2               TOK_WAIT        = $91
000000r 2               TOK_LOAD        = $92
000000r 2               TOK_SAVE        = $93
000000r 2               TOK_DEF         = $94
000000r 2               TOK_POKE        = $95
000000r 2               TOK_PRINT       = $96
000000r 2               TOK_CONT        = $97
000000r 2               TOK_LIST        = $98
000000r 2               TOK_CLR         = $99
000000r 2               TOK_NEW         = $9A
000000r 2               TOK_TAB         = $9B
000000r 2               TOK_TO          = $9C
000000r 2               TOK_FN          = $9D
000000r 2               TOK_SPC         = $9E
000000r 2               TOK_THEN        = $9F
000000r 2               TOK_NOT         = $A0
000000r 2               TOK_STEP        = $A1
000000r 2               TOK_AND         = $A2
000000r 2               TOK_OR          = $A3
000000r 2               TOK_ELSE        = $A4
000000r 2               TOK_SYS         = $A5
000000r 2               TOK_DIR         = $A6
000000r 2               TOK_DEL         = $A7
000000r 2               TOK_CLS         = $A8
000000r 2               TOK_LOCATE      = $A9
000000r 2               TOK_COLOR       = $AA
000000r 2               TOK_SOUND       = $AB
000000r 2               TOK_VOL         = $AC
000000r 2               TOK_TIME        = $AD
000000r 2               TOK_DATE        = $AE
000000r 2               TOK_SETTIME     = $AF
000000r 2               TOK_SETDATE     = $B0
000000r 2               TOK_NVRAM       = $B1
000000r 2               TOK_PAUSE       = $B2
000000r 2               TOK_BANK        = $B3
000000r 2               TOK_BRK         = $B4
000000r 2               TOK_MEM         = $B5
000000r 2               TOK_SGN         = $B6
000000r 2               TOK_INT         = $B7
000000r 2               TOK_ABS         = $B8
000000r 2               TOK_FRE         = $B9
000000r 2               TOK_POS         = $BA
000000r 2               TOK_SQR         = $BB
000000r 2               TOK_RND         = $BC
000000r 2               TOK_LOG         = $BD
000000r 2               TOK_EXP         = $BE
000000r 2               TOK_COS         = $BF
000000r 2               TOK_SIN         = $C0
000000r 2               TOK_TAN         = $C1
000000r 2               TOK_ATN         = $C2
000000r 2               TOK_PEEK        = $C3
000000r 2               TOK_LEN         = $C4
000000r 2               TOK_STRSTR      = $C5           ; STR$
000000r 2               TOK_VAL         = $C6
000000r 2               TOK_ASC         = $C7
000000r 2               TOK_CHRSTR      = $C8           ; CHR$
000000r 2               TOK_LEFTSTR     = $C9           ; LEFT$
000000r 2               TOK_RIGHTSTR    = $CA           ; RIGHT$
000000r 2               TOK_MIDSTR      = $CB           ; MID$
000000r 2               TOK_JOY         = $CC
000000r 2               TOK_INKEY       = $CD
000000r 2               TOK_HEX         = $CE
000000r 2               TOK_MIN         = $CF
000000r 2               TOK_MAX         = $D0
000000r 2               TOK_DISK        = $D1           ; select current CF disk bank
000000r 2               TOK_BLOAD       = $D2           ; binary load to address
000000r 2               TOK_BSAVE       = $D3           ; binary save from address
000000r 2               TOK_FORMAT      = $D4           ; erase current disk directory
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   E R R O R   C O D E S
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ERR_SYNTAX      = 0
000000r 2               ERR_OVERFLOW    = 1
000000r 2               ERR_OUTOFMEM    = 2
000000r 2               ERR_UNDEFSTMT   = 3
000000r 2               ERR_BADSUBSCR   = 4
000000r 2               ERR_REDIM       = 5
000000r 2               ERR_DIVZERO     = 6
000000r 2               ERR_ILLDIRECT   = 7
000000r 2               ERR_TYPEMISM    = 8
000000r 2               ERR_LONGSTR     = 9
000000r 2               ERR_FORMULA     = 10
000000r 2               ERR_ILLQUAN     = 11
000000r 2               ERR_RG          = 12            ; RETURN without GOSUB
000000r 2               ERR_NF          = 13            ; NEXT without FOR
000000r 2               ERR_OD          = 14            ; OUT OF DATA
000000r 2               ERR_NODEV       = 15
000000r 2               ERR_CANTCONT    = 16
000000r 2               
000000r 2               ; Aliases used by ported msbasic code.
000000r 2               ERR_BADSUBS     = ERR_BADSUBSCR
000000r 2               ERR_REDIMD      = ERR_REDIM
000000r 2               ERR_FRMCPX      = ERR_FORMULA
000000r 2               ERR_MEMFULL     = ERR_OUTOFMEM
000000r 2               ERR_STRLONG     = ERR_LONGSTR
000000r 2               ERR_ILLQTY      = ERR_ILLQUAN
000000r 2               
000000r 2               ; Lowest stack pointer GOSUB may descend to before raising OUT OF MEMORY.
000000r 2               ; Matches msbasic's GETSTK arithmetic for a GOSUB frame: 3*2 bytes of frame
000000r 2               ; plus a $3E-byte margin left for the interpreter's own JSR nesting (FrmEvl
000000r 2               ; recursion in particular) once the subroutine is running.  Frames cost about
000000r 2               ; 8 bytes apiece with those returns interleaved, so this permits roughly 23
000000r 2               ; levels -- the same working depth as Commodore BASIC.
000000r 2               GOSUB_STACK_MIN = $44
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   B A S E N T R Y   -   $C000
000000r 2               ;
000000r 2               ;   First byte of segment.  Reached from:
000000r 2               ;     * Kernal cold-boot path
000000r 2               ;     * Monitor 'X' command (warm re-entry)
000000r 2               ;
000000r 2               ;   Cold-vs-warm detection: BAS_WARM holds $A5 once cold init has run.
000000r 2               ;   Re-entry skips banner and goes straight to the OK prompt.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               BasEntry:
000000r 2  A2 FF                ldx     #$FF                    ; reset stack on (re)entry
000002r 2  9A                   txs
000003r 2  D8                   cld
000004r 2               
000004r 2  AD 6F 03             lda     BAS_WARM
000007r 2  C9 A5                cmp     #$A5
000009r 2  F0 08                beq     @Warm
00000Br 2               
00000Br 2  20 rr rr             jsr     BasColdInit
00000Er 2  20 rr rr             jsr     BasBanner
000011r 2  80 1F                bra     BasReadyLoop
000013r 2               
000013r 2               @Warm:
000013r 2                       ; Warm restart - skip banner; the OK printer will lead with CRLF.
000013r 2                       ; A loader outside BASIC may have dropped a new image at $0800 since we
000013r 2                       ; were last here (drop to the Monitor, 'L' a program, 'X' back).  Adopt
000013r 2                       ; it: the old variables describe a program that no longer exists, so
000013r 2                       ; ARYTAB/STREND follow VARTAB exactly as they would on a fresh LOAD.
000013r 2  AD 8E 03             lda     PRG_IMAGE_END
000016r 2  0D 8F 03             ora     PRG_IMAGE_END+1
000019r 2  F0 17                beq     BasReadyLoop
00001Br 2  20 rr rr             jsr     ProgramEnd
00001Er 2  8D 5F 03             sta     BAS_VARTAB
000021r 2  8C 60 03             sty     BAS_VARTAB+1
000024r 2  A2 01                ldx     #1
000026r 2               @adopt:
000026r 2  BD 5F 03             lda     BAS_VARTAB,x
000029r 2  9D 61 03             sta     BAS_ARYTAB,x
00002Cr 2  9D 63 03             sta     BAS_STREND,x
00002Fr 2  CA                   dex
000030r 2  10 F4                bpl     @adopt
000032r 2               
000032r 2               ; -----------------------------------------------------------------------------
000032r 2               ; BasReadyLoop - REPL: print OK, read a line, dispatch.
000032r 2               ; -----------------------------------------------------------------------------
000032r 2               BasReadyLoop:
000032r 2  20 rr rr             jsr     BasPrintOK
000035r 2               @nextline:
000035r 2  20 rr rr             jsr     BasReadLine             ; fills BAS_LINBUF, NUL-terminated
000038r 2  20 rr rr             jsr     BasProcessLine
00003Br 2  80 F8                bra     @nextline
00003Dr 2               
00003Dr 2               ; =============================================================================
00003Dr 2               ;   B a s C o l d I n i t
00003Dr 2               ; =============================================================================
00003Dr 2               ; Initialise BASIC runtime variables.  Called once on first entry.
00003Dr 2               ; =============================================================================
00003Dr 2               BasColdInit:
00003Dr 2                       ; ---------------------------------------------------------------------
00003Dr 2                       ; Zero the BASIC-owned zero-page workspace first.  On a cold boot RAM
00003Dr 2                       ; holds random power-up values, and the inlined MSBASIC math/parse code
00003Dr 2                       ; treats several scratch cells as invariant-zero (e.g. SHIFTSIGNEXT,
00003Dr 2                       ; FACEXTENSION, ARGEXTENSION) — they are only written on certain code
00003Dr 2                       ; paths and assumed already 0 otherwise.  A random value in any of them
00003Dr 2                       ; corrupts results; this is what produced the bogus "84405.0911 BYTES
00003Dr 2                       ; FREE" banner on real hardware.  Clearing the whole region up front
00003Dr 2                       ; eliminates this entire class of uninitialised-read bugs.  The two
00003Dr 2                       ; ranges are the BASIC primary workspace ($04-$23) and the FP / var /
00003Dr 2                       ; array / string spill ($3A-$85); $24-$39 is Kernal-reserved and left
00003Dr 2                       ; untouched.  Specific non-zero values (CURLIN, TEMPPT, RND seed, etc.)
00003Dr 2                       ; are written further down, after this clear.
00003Dr 2  A9 00                lda     #0
00003Fr 2  A2 04                ldx     #BAS_TXTPTR             ; $04..$23
000041r 2               @ClrZpLo:
000041r 2  95 00                sta     ZP,x
000043r 2  E8                   inx
000044r 2  E0 24                cpx     #BAS_DEST+2
000046r 2  D0 F9                bne     @ClrZpLo
000048r 2  A2 3A                ldx     #BAS_TMP1               ; $3A..$85
00004Ar 2               @ClrZpHi:
00004Ar 2  95 00                sta     ZP,x
00004Cr 2  E8                   inx
00004Dr 2  E0 86                cpx     #BAS_FRESPC+2
00004Fr 2  D0 F9                bne     @ClrZpHi
000051r 2               
000051r 2                       ; TXTTAB / MEMSIZ are constants for our memory map.
000051r 2  A9 00                lda     #<BAS_PRG_START
000053r 2  8D 5D 03             sta     BAS_TXTTAB
000056r 2  A9 08                lda     #>BAS_PRG_START
000058r 2  8D 5E 03             sta     BAS_TXTTAB+1
00005Br 2               
00005Br 2  A9 00                lda     #<$8000
00005Dr 2  8D 67 03             sta     BAS_MEMSIZ
000060r 2  A9 80                lda     #>$8000
000062r 2  8D 68 03             sta     BAS_MEMSIZ+1
000065r 2               
000065r 2                       ; Where does the program already sitting at $0800 end?  The Kernal owns
000065r 2                       ; this: it prefers a byte count recorded by a loader outside BASIC (so a
000065r 2                       ; Monitor-loaded .prg keeps its machine code), falls back to a chain
000065r 2                       ; walk, and installs an empty program if there is nothing usable.
000065r 2  20 rr rr             jsr     ProgramEnd
000068r 2  8D 5F 03             sta     BAS_VARTAB
00006Br 2  8C 60 03             sty     BAS_VARTAB+1
00006Er 2               
00006Er 2                       ; ARYTAB = STREND = VARTAB; FRETOP = MEMSIZ.
00006Er 2  AD 5F 03             lda     BAS_VARTAB
000071r 2  8D 61 03             sta     BAS_ARYTAB
000074r 2  8D 63 03             sta     BAS_STREND
000077r 2  AD 60 03             lda     BAS_VARTAB+1
00007Ar 2  8D 62 03             sta     BAS_ARYTAB+1
00007Dr 2  8D 64 03             sta     BAS_STREND+1
000080r 2  AD 67 03             lda     BAS_MEMSIZ
000083r 2  8D 65 03             sta     BAS_FRETOP
000086r 2  AD 68 03             lda     BAS_MEMSIZ+1
000089r 2  8D 66 03             sta     BAS_FRETOP+1
00008Cr 2               
00008Cr 2                       ; CURLIN = $FFFF (direct mode marker).
00008Cr 2  A9 FF                lda     #$FF
00008Er 2  8D 69 03             sta     BAS_CURLIN
000091r 2  8D 6A 03             sta     BAS_CURLIN+1
000094r 2               
000094r 2                       ; Clear CONT state and pending-key.
000094r 2  9C 6B 03             stz     BAS_OLDLIN
000097r 2  9C 6C 03             stz     BAS_OLDLIN+1
00009Ar 2  9C 6D 03             stz     BAS_OLDTEXT
00009Dr 2  9C 6E 03             stz     BAS_OLDTEXT+1
0000A0r 2  9C 1A 03             stz     BAS_DATAPTR
0000A3r 2  9C 1B 03             stz     BAS_DATAPTR+1
0000A6r 2  9C 1C 03             stz     BAS_STOPLINE
0000A9r 2  9C 1D 03             stz     BAS_STOPLINE+1
0000ACr 2  9C 1E 03             stz     BAS_STOPTXT
0000AFr 2  9C 1F 03             stz     BAS_STOPTXT+1
0000B2r 2  9C 0E 03             stz     BAS_PENDKEY
0000B5r 2  9C 70 03             stz     BAS_POSX                ; PRINT column counter (non-ZP)
0000B8r 2               
0000B8r 2                       ; ZP runtime flags (QUOTEFLG, DIMFLG, VALTYP, DATAFLG, SUBFLG,
0000B8r 2                       ; INPUTFLG, SHIFTSIGNEXT, ...) are already zeroed by the cold-init
0000B8r 2                       ; clear loop above; only non-zero / non-ZP state is set here.
0000B8r 2               
0000B8r 2                       ; Temp-string descriptor stack: TEMPPT = TEMPST.
0000B8r 2  A9 6E                lda     #BAS_TEMPST
0000BAr 2  85 6B                sta     BAS_TEMPPT
0000BCr 2               
0000BCr 2                       ; Initialise Rnd seed from the embedded constant.
0000BCr 2  A2 04                ldx     #4
0000BEr 2               @SeedCopy:
0000BEr 2  BD rr rr             lda     RndSeedInit,x
0000C1r 2  95 5C                sta     RNDSEED,x
0000C3r 2  CA                   dex
0000C4r 2  10 F8                bpl     @SeedCopy
0000C6r 2               
0000C6r 2                       ; Mark warm-start magic.
0000C6r 2  A9 A5                lda     #$A5
0000C8r 2  8D 6F 03             sta     BAS_WARM
0000CBr 2  60                   rts
0000CCr 2               
0000CCr 2               ; =============================================================================
0000CCr 2               ;   B a s B a n n e r
0000CCr 2               ; =============================================================================
0000CCr 2               BasBanner:
0000CCr 2  A9 rr                lda     #<MsgBanner
0000CEr 2  A0 rr                ldy     #>MsgBanner
0000D0r 2  20 rr rr             jsr     BasPrintStr
0000D3r 2                       ; Print "<n> BYTES FREE" line.
0000D3r 2  38                   sec
0000D4r 2  AD 67 03             lda     BAS_MEMSIZ
0000D7r 2  ED 5F 03             sbc     BAS_VARTAB
0000DAr 2  A8                   tay
0000DBr 2  AD 68 03             lda     BAS_MEMSIZ+1
0000DEr 2  ED 60 03             sbc     BAS_VARTAB+1
0000E1r 2  20 rr rr             jsr     GivAyf
0000E4r 2                       ; Print the byte count left-aligned: Fout always emits a leading
0000E4r 2                       ; sign character (' ' for positive, '-' for negative).  For the
0000E4r 2                       ; banner we skip that leading space so the number lines up with
0000E4r 2                       ; the left edge of the title above it.
0000E4r 2  20 rr rr             jsr     Fout                    ; (Y,A) -> NUL-terminated buffer
0000E7r 2  85 20                sta     INDEX
0000E9r 2  84 21                sty     INDEX+1
0000EBr 2  A0 00                ldy     #0
0000EDr 2  B1 20                lda     (INDEX),y
0000EFr 2  C9 20                cmp     #' '
0000F1r 2  D0 01                bne     @bnLoop
0000F3r 2  C8                   iny                             ; skip the positive-sign space
0000F4r 2               @bnLoop:
0000F4r 2  B1 20                lda     (INDEX),y
0000F6r 2  F0 06                beq     @bnDone
0000F8r 2  20 rr rr             jsr     PrintCh
0000FBr 2  C8                   iny
0000FCr 2  D0 F6                bne     @bnLoop
0000FEr 2               @bnDone:
0000FEr 2  A9 rr                lda     #<MsgBytesFreeNL
000100r 2  A0 rr                ldy     #>MsgBytesFreeNL
000102r 2  4C rr rr             jmp     BasPrintStr
000105r 2               
000105r 2               ; =============================================================================
000105r 2               ;   B a s P r i n t O K
000105r 2               ; =============================================================================
000105r 2               BasPrintOK:
000105r 2  20 rr rr             jsr     BasPrintCRLF
000108r 2  A9 rr                lda     #<MsgOK
00010Ar 2  A0 rr                ldy     #>MsgOK
00010Cr 2  4C rr rr             jmp     BasPrintStr
00010Fr 2               
00010Fr 2               ; =============================================================================
00010Fr 2               ;   B a s P r i n t S t r  /  B a s P r i n t C R L F
00010Fr 2               ; =============================================================================
00010Fr 2               ; These were promoted to the KERNAL jump table as PrintStr ($A090) and
00010Fr 2               ; PrintCRLF ($A093) so cartridges can reuse them and the KERNAL no longer
00010Fr 2               ; depends on BASIC-segment code.  Keep the old BASIC names as aliases so the
00010Fr 2               ; existing call sites (and A=lo/Y=hi convention) are unchanged.
00010Fr 2               BasPrintStr     := PrintStr
00010Fr 2               BasPrintCRLF    := PrintCRLF
00010Fr 2               
00010Fr 2               ; =============================================================================
00010Fr 2               ;   B a s R e a d L i n e
00010Fr 2               ; =============================================================================
00010Fr 2               ; Read a line of input into BAS_LINBUF, NUL-terminated.  Echoes characters
00010Fr 2               ; manually (does not use Chrin's auto-echo).  Supports CR, BS ($08), ESC
00010Fr 2               ; ($1B = cancel and restart line).  Caps stored length at BAS_LINBUF_MAX
00010Fr 2               ; (extra characters are silently dropped from the buffer but still echoed
00010Fr 2               ; -- acceptable truncation behavior).
00010Fr 2               ;
00010Fr 2               ; Output : BAS_LINBUF holds the raw line, terminated with $00.
00010Fr 2               ; =============================================================================
00010Fr 2               BasReadLine:
00010Fr 2  A0 00                ldy     #0
000111r 2               @Loop:
000111r 2  20 rr rr             jsr     BasReadKey              ; A = next key, blocking
000114r 2  C9 0D                cmp     #$0D
000116r 2  F0 30                beq     @Done
000118r 2  C9 08                cmp     #$08
00011Ar 2  F0 19                beq     @Backspace
00011Cr 2  C9 1B                cmp     #$1B
00011Er 2  F0 21                beq     @Cancel
000120r 2  C9 20                cmp     #$20                    ; reject control codes below space
000122r 2  90 ED                bcc     @Loop
000124r 2  C9 7F                cmp     #$7F                    ; reject DEL and 8-bit
000126r 2  B0 E9                bcs     @Loop
000128r 2                       ; Printable - store and echo.
000128r 2  C0 C8                cpy     #BAS_LINBUF_MAX
00012Ar 2  B0 E5                bcs     @Loop                   ; full - drop quietly
00012Cr 2  99 00 04             sta     BAS_LINBUF,y
00012Fr 2  C8                   iny
000130r 2  20 rr rr             jsr     Chrout
000133r 2  80 DC                bra     @Loop
000135r 2               
000135r 2               @Backspace:
000135r 2  C0 00                cpy     #0
000137r 2  F0 D8                beq     @Loop                   ; nothing to erase
000139r 2  88                   dey
00013Ar 2  A9 08                lda     #$08                    ; video / serial driver erases on BS
00013Cr 2  20 rr rr             jsr     Chrout
00013Fr 2  80 D0                bra     @Loop
000141r 2               
000141r 2               @Cancel:
000141r 2  20 rr rr             jsr     BasPrintCRLF
000144r 2  A0 00                ldy     #0
000146r 2  80 C9                bra     @Loop
000148r 2               
000148r 2               @Done:
000148r 2  A9 00                lda     #0
00014Ar 2  99 00 04             sta     BAS_LINBUF,y
00014Dr 2  20 rr rr             jsr     BasPrintCRLF
000150r 2  60                   rts
000151r 2               
000151r 2               ; =============================================================================
000151r 2               ;   B a s R e a d K e y
000151r 2               ; =============================================================================
000151r 2               ; Spin until a key is available in the input buffer; return it in A
000151r 2               ; (no echo).
000151r 2               ; =============================================================================
000151r 2               BasReadKey:
000151r 2               @Wait:
000151r 2  20 rr rr             jsr     BufferSize
000154r 2  F0 FB                beq     @Wait
000156r 2  4C rr rr             jmp     ReadBuffer              ; tail-call: returns A=byte
000159r 2               
000159r 2               ; =============================================================================
000159r 2               ;   B a s P r o c e s s L i n e
000159r 2               ; =============================================================================
000159r 2               ; Triage BAS_LINBUF after reading: empty, numbered (insert/replace/delete),
000159r 2               ; or immediate command.
000159r 2               ; =============================================================================
000159r 2               BasProcessLine:
000159r 2  A2 00                ldx     #0
00015Br 2               @SkipSpaces:
00015Br 2  BD 00 04             lda     BAS_LINBUF,x
00015Er 2  F0 07                beq     @Empty
000160r 2  C9 20                cmp     #' '
000162r 2  D0 04                bne     @HasContent
000164r 2  E8                   inx
000165r 2  80 F4                bra     @SkipSpaces
000167r 2               @Empty:
000167r 2  60                   rts                             ; nothing to do; caller will reprompt
000168r 2               
000168r 2               @HasContent:
000168r 2  C9 30                cmp     #'0'
00016Ar 2  90 1A                bcc     @Immediate
00016Cr 2  C9 3A                cmp     #'9'+1
00016Er 2  B0 16                bcs     @Immediate
000170r 2               
000170r 2               ; --- Numbered line -----------------------------------------------------------
000170r 2  20 rr rr             jsr     BasParseLineNum         ; consumes digits at BAS_LINBUF+X
000173r 2                       ; X now points to first non-digit; allow exactly one optional space.
000173r 2  BD 00 04             lda     BAS_LINBUF,x
000176r 2  C9 20                cmp     #' '
000178r 2  D0 01                bne     @TokenizeRest
00017Ar 2  E8                   inx
00017Br 2               @TokenizeRest:
00017Br 2  20 rr rr             jsr     BasCrunch               ; tokenize from BAS_LINBUF+X to BAS_TOKBUF
00017Er 2  B0 03                bcs     @StoreLine              ; carry set = success
000180r 2  4C rr rr             jmp     BasErrSyntax
000183r 2               
000183r 2               @StoreLine:
000183r 2  4C rr rr             jmp     BasStoreLine            ; insert/replace/delete by line number
000186r 2               
000186r 2               @Immediate:
000186r 2                       ; Immediate (no line number) - tokenize whole line and dispatch.
000186r 2  A2 00                ldx     #0
000188r 2  20 rr rr             jsr     BasCrunch
00018Br 2  B0 03                bcs     @ImmDispatch
00018Dr 2  4C rr rr             jmp     BasErrSyntax
000190r 2               @ImmDispatch:
000190r 2  20 rr rr             jsr     BasDispatchImmediate
000193r 2  4C rr rr             jmp     BasPrintOK              ; MS BASIC: OK only after immediate
000196r 2               
000196r 2               ; =============================================================================
000196r 2               ;   B a s P a r s e L i n e N u m
000196r 2               ; =============================================================================
000196r 2               ; Parse decimal digits at BAS_LINBUF,X into BAS_LINNUM (16-bit).
000196r 2               ; X advances past the digits.  Saturates at $FFFF on overflow.
000196r 2               ; =============================================================================
000196r 2               BasParseLineNum:
000196r 2  64 08                stz     BAS_LINNUM
000198r 2  64 09                stz     BAS_LINNUM+1
00019Ar 2               @Loop:
00019Ar 2  BD 00 04             lda     BAS_LINBUF,x
00019Dr 2  C9 30                cmp     #'0'
00019Fr 2  90 35                bcc     @Done
0001A1r 2  C9 3A                cmp     #'9'+1
0001A3r 2  B0 31                bcs     @Done
0001A5r 2                       ; Multiply LINNUM by 10.
0001A5r 2  48                   pha
0001A6r 2  06 08                asl     BAS_LINNUM              ; *2
0001A8r 2  26 09                rol     BAS_LINNUM+1
0001AAr 2  A5 08                lda     BAS_LINNUM
0001ACr 2  85 3A                sta     BAS_TMP1
0001AEr 2  A5 09                lda     BAS_LINNUM+1
0001B0r 2  85 3B                sta     BAS_TMP1+1
0001B2r 2  06 08                asl     BAS_LINNUM              ; *4
0001B4r 2  26 09                rol     BAS_LINNUM+1
0001B6r 2  06 08                asl     BAS_LINNUM              ; *8
0001B8r 2  26 09                rol     BAS_LINNUM+1
0001BAr 2  18                   clc                             ; *8 + *2 = *10
0001BBr 2  A5 08                lda     BAS_LINNUM
0001BDr 2  65 3A                adc     BAS_TMP1
0001BFr 2  85 08                sta     BAS_LINNUM
0001C1r 2  A5 09                lda     BAS_LINNUM+1
0001C3r 2  65 3B                adc     BAS_TMP1+1
0001C5r 2  85 09                sta     BAS_LINNUM+1
0001C7r 2                       ; Add digit value.
0001C7r 2  68                   pla
0001C8r 2  29 0F                and     #$0F
0001CAr 2  18                   clc
0001CBr 2  65 08                adc     BAS_LINNUM
0001CDr 2  85 08                sta     BAS_LINNUM
0001CFr 2  90 02                bcc     @NoCarry
0001D1r 2  E6 09                inc     BAS_LINNUM+1
0001D3r 2               @NoCarry:
0001D3r 2  E8                   inx
0001D4r 2  80 C4                bra     @Loop
0001D6r 2               @Done:
0001D6r 2  60                   rts
0001D7r 2               
0001D7r 2               ; =============================================================================
0001D7r 2               ;   B a s C r u n c h
0001D7r 2               ; =============================================================================
0001D7r 2               ; Tokenize BAS_LINBUF starting at offset X into BAS_TOKBUF.
0001D7r 2               ;
0001D7r 2               ; Tokenization rules:
0001D7r 2               ;   - Outside quoted strings, lowercase a-z are folded to uppercase.
0001D7r 2               ;   - Outside quoted strings, alphabetic runs are matched against the
0001D7r 2               ;     keyword table; on a match the token byte is emitted in place of the
0001D7r 2               ;     keyword characters.
0001D7r 2               ;   - Inside double quotes, characters are copied verbatim until the
0001D7r 2               ;     closing quote (or end of line).
0001D7r 2               ;   - After a REM token, the rest of the line is copied verbatim.
0001D7r 2               ;   - Disallowed punctuation (@, &, [, ], {, }, |, \, `, ~) raises
0001D7r 2               ;     ?SYNTAX ERROR via carry-clear return.
0001D7r 2               ;
0001D7r 2               ; Output : BAS_TOKBUF holds the tokenized line, NUL-terminated.
0001D7r 2               ; Returns: carry SET on success, carry CLEAR on syntax error.
0001D7r 2               ; Clobbers: A, X, Y, BAS_TMP1/TMP2/TMP3.
0001D7r 2               ; =============================================================================
0001D7r 2               BasCrunch:
0001D7r 2                       ; X = src index, Y = dst index
0001D7r 2  A0 00                ldy     #0
0001D9r 2  64 41                stz     BAS_QUOTEFLG
0001DBr 2               @Scan:
0001DBr 2  C0 FA                cpy     #BAS_TOKBUF_MAX
0001DDr 2  B0 0A                bcs     @Overflow
0001DFr 2  BD 00 04             lda     BAS_LINBUF,x
0001E2r 2  D0 07                bne     @NotEnd
0001E4r 2                       ; End of input.
0001E4r 2  99 00 05             sta     BAS_TOKBUF,y            ; A=0
0001E7r 2  38                   sec
0001E8r 2  60                   rts
0001E9r 2               @Overflow:
0001E9r 2                       ; Tokenized line too long; treat as syntax error.
0001E9r 2  18                   clc
0001EAr 2  60                   rts
0001EBr 2               
0001EBr 2               @NotEnd:
0001EBr 2  C9 22                cmp     #'"'
0001EDr 2  F0 56                beq     @Quote
0001EFr 2                       ; Lowercase to uppercase outside quotes.
0001EFr 2  C9 61                cmp     #'a'
0001F1r 2  90 06                bcc     @CheckAlpha
0001F3r 2  C9 7B                cmp     #'z'+1
0001F5r 2  B0 02                bcs     @CheckAlpha
0001F7r 2  29 DF                and     #$DF
0001F9r 2               @CheckAlpha:
0001F9r 2                       ; Alphabetic? Try keyword match.
0001F9r 2  C9 41                cmp     #'A'
0001FBr 2  90 3A                bcc     @NotAlpha
0001FDr 2  C9 5B                cmp     #'Z'+1
0001FFr 2  B0 36                bcs     @NotAlpha
000201r 2                       ; Alpha - try matching a keyword starting at BAS_LINBUF,x.
000201r 2  20 rr rr             jsr     BasMatchKeyword         ; returns C set (A=token, X advanced) or C clear
000204r 2  90 1D                bcc     @CopyAlpha
000206r 2                       ; Match: emit token byte.
000206r 2  99 00 05             sta     BAS_TOKBUF,y
000209r 2  C8                   iny
00020Ar 2  C9 8E                cmp     #TOK_REM
00020Cr 2  D0 CD                bne     @Scan
00020Er 2                       ; After REM: copy the remainder verbatim.
00020Er 2               @RemCopy:
00020Er 2  C0 FA                cpy     #BAS_TOKBUF_MAX
000210r 2  B0 D7                bcs     @Overflow
000212r 2  BD 00 04             lda     BAS_LINBUF,x
000215r 2  F0 07                beq     @TermAndExit
000217r 2  99 00 05             sta     BAS_TOKBUF,y
00021Ar 2  C8                   iny
00021Br 2  E8                   inx
00021Cr 2  80 F0                bra     @RemCopy
00021Er 2               @TermAndExit:
00021Er 2  99 00 05             sta     BAS_TOKBUF,y            ; A=0
000221r 2  38                   sec
000222r 2  60                   rts
000223r 2               
000223r 2               @CopyAlpha:
000223r 2                       ; No keyword match - copy a single alpha char (re-uppercase here, since
000223r 2                       ; BasMatchKeyword returns the original LINBUF byte).
000223r 2  BD 00 04             lda     BAS_LINBUF,x
000226r 2  C9 61                cmp     #'a'
000228r 2  90 06                bcc     @CASto
00022Ar 2  C9 7B                cmp     #'z'+1
00022Cr 2  B0 02                bcs     @CASto
00022Er 2  29 DF                and     #$DF
000230r 2               @CASto:
000230r 2  99 00 05             sta     BAS_TOKBUF,y
000233r 2  C8                   iny
000234r 2  E8                   inx
000235r 2  80 A4                bra     @Scan
000237r 2               
000237r 2               @NotAlpha:
000237r 2                       ; Punctuation / digit / space.  Validate against the disallowed set.
000237r 2  20 rr rr             jsr     BasValidPunct
00023Ar 2  90 07                bcc     @SyntaxFail
00023Cr 2  99 00 05             sta     BAS_TOKBUF,y
00023Fr 2  C8                   iny
000240r 2  E8                   inx
000241r 2  80 98                bra     @Scan
000243r 2               @SyntaxFail:
000243r 2  18                   clc
000244r 2  60                   rts
000245r 2               
000245r 2               @Quote:
000245r 2                       ; Copy opening quote, then everything up to closing quote (or end).
000245r 2  99 00 05             sta     BAS_TOKBUF,y
000248r 2  C8                   iny
000249r 2  E8                   inx
00024Ar 2               @QuoteLoop:
00024Ar 2  C0 FA                cpy     #BAS_TOKBUF_MAX
00024Cr 2  B0 9B                bcs     @Overflow
00024Er 2  BD 00 04             lda     BAS_LINBUF,x
000251r 2  F0 CB                beq     @TermAndExit
000253r 2  99 00 05             sta     BAS_TOKBUF,y
000256r 2  C8                   iny
000257r 2  E8                   inx
000258r 2  C9 22                cmp     #'"'
00025Ar 2  D0 EE                bne     @QuoteLoop
00025Cr 2  4C rr rr             jmp     @Scan
00025Fr 2               
00025Fr 2               ; =============================================================================
00025Fr 2               ;   B a s V a l i d P u n c t
00025Fr 2               ; =============================================================================
00025Fr 2               ; Verify A is an acceptable non-keyword character.
00025Fr 2               ; Carry SET = OK, carry CLEAR = illegal.
00025Fr 2               ; Allowed: anything in $20-$7E EXCEPT @, &, [, ], {, }, |, \, `, ~.
00025Fr 2               ; =============================================================================
00025Fr 2               BasValidPunct:
00025Fr 2  C9 40                cmp     #'@'
000261r 2  F0 26                beq     @Bad
000263r 2  C9 26                cmp     #'&'
000265r 2  F0 22                beq     @Bad
000267r 2  C9 5B                cmp     #'['
000269r 2  F0 1E                beq     @Bad
00026Br 2  C9 5D                cmp     #']'
00026Dr 2  F0 1A                beq     @Bad
00026Fr 2  C9 7B                cmp     #'{'
000271r 2  F0 16                beq     @Bad
000273r 2  C9 7D                cmp     #'}'
000275r 2  F0 12                beq     @Bad
000277r 2  C9 7C                cmp     #'|'
000279r 2  F0 0E                beq     @Bad
00027Br 2  C9 5C                cmp     #'\'
00027Dr 2  F0 0A                beq     @Bad
00027Fr 2  C9 60                cmp     #'`'
000281r 2  F0 06                beq     @Bad
000283r 2  C9 7E                cmp     #'~'
000285r 2  F0 02                beq     @Bad
000287r 2  38                   sec
000288r 2  60                   rts
000289r 2               @Bad:
000289r 2  18                   clc
00028Ar 2  60                   rts
00028Br 2               
00028Br 2               ; =============================================================================
00028Br 2               ;   B a s M a t c h K e y w o r d
00028Br 2               ; =============================================================================
00028Br 2               ; Try to match a keyword from KeywordTbl starting at BAS_LINBUF,X.
00028Br 2               ;
00028Br 2               ; On match  : carry SET, A = token byte, X advanced past the matched
00028Br 2               ;             keyword characters in BAS_LINBUF.
00028Br 2               ; On miss   : carry CLEAR, X unchanged, A = original character at LINBUF,X.
00028Br 2               ;
00028Br 2               ; Match algorithm:
00028Br 2               ;   - Walk KeywordTbl, comparing characters (folding LINBUF lowercase to
00028Br 2               ;     uppercase) to each keyword in turn.  A keyword's last byte has bit 7
00028Br 2               ;     set; the byte after the table's final keyword is $00.
00028Br 2               ;   - Token value = TOK_BASE + (index of keyword in table).
00028Br 2               ; =============================================================================
00028Br 2               BasMatchKeyword:
00028Br 2                       ; Save initial X for rollback on miss; preserve caller's Y (BasCrunch
00028Br 2                       ; uses Y as the TOKBUF destination index).
00028Br 2  86 3E                stx     BAS_TMP3
00028Dr 2  5A                   phy
00028Er 2                       ; Walk the keyword table via a 16-bit ZP pointer (BAS_KWPTR), since
00028Er 2                       ; the table is larger than 256 bytes.  Y is held at 0 throughout and
00028Er 2                       ; we advance BAS_KWPTR byte-by-byte instead of relying on Y.
00028Er 2  A9 rr                lda     #<KeywordTbl
000290r 2  85 61                sta     BAS_KWPTR
000292r 2  A9 rr                lda     #>KeywordTbl
000294r 2  85 62                sta     BAS_KWPTR+1
000296r 2  A9 80                lda     #TOK_BASE
000298r 2  85 3A                sta     BAS_TMP1                ; current candidate token
00029Ar 2  A0 00                ldy     #0
00029Cr 2               @KeywordLoop:
00029Cr 2                       ; Restore X to start of input keyword.
00029Cr 2  A6 3E                ldx     BAS_TMP3
00029Er 2               @CharLoop:
00029Er 2  B1 61                lda     (BAS_KWPTR),y           ; Y == 0
0002A0r 2  F0 3B                beq     @NoMatch                ; reached table terminator
0002A2r 2  48                   pha
0002A3r 2  29 7F                and     #$7F
0002A5r 2  85 3C                sta     BAS_TMP2                ; expected char (uppercase)
0002A7r 2                       ; Read input char and uppercase it.
0002A7r 2  BD 00 04             lda     BAS_LINBUF,x
0002AAr 2  C9 61                cmp     #'a'
0002ACr 2  90 06                bcc     @InpCmp
0002AEr 2  C9 7B                cmp     #'z'+1
0002B0r 2  B0 02                bcs     @InpCmp
0002B2r 2  29 DF                and     #$DF
0002B4r 2               @InpCmp:
0002B4r 2  C5 3C                cmp     BAS_TMP2
0002B6r 2  D0 0C                bne     @CharMismatch
0002B8r 2  68                   pla                             ; restore raw table byte
0002B9r 2                       ; Match - is this the last char of the keyword?
0002B9r 2  30 1C                bmi     @WholeMatch             ; bit 7 set -> full keyword matched
0002BBr 2                       ; Advance both pointers and continue.
0002BBr 2  E6 61                inc     BAS_KWPTR
0002BDr 2  D0 02                bne     @CharNoCarry
0002BFr 2  E6 62                inc     BAS_KWPTR+1
0002C1r 2               @CharNoCarry:
0002C1r 2  E8                   inx
0002C2r 2  80 DA                bra     @CharLoop
0002C4r 2               
0002C4r 2               @CharMismatch:
0002C4r 2  68                   pla
0002C5r 2                       ; Skip ahead to start of next keyword in table.  Walk byte-by-byte
0002C5r 2                       ; until we consume a byte with bit 7 set (last char of this keyword)
0002C5r 2                       ; or hit the $00 terminator.
0002C5r 2               @SkipKeyword:
0002C5r 2  B1 61                lda     (BAS_KWPTR),y           ; Y == 0
0002C7r 2  F0 14                beq     @NoMatch                ; hit table terminator
0002C9r 2  E6 61                inc     BAS_KWPTR
0002CBr 2  D0 02                bne     @SkipNoCarry
0002CDr 2  E6 62                inc     BAS_KWPTR+1
0002CFr 2               @SkipNoCarry:
0002CFr 2  C9 80                cmp     #$80                    ; carry set iff loaded byte >= $80
0002D1r 2  90 F2                bcc     @SkipKeyword
0002D3r 2                       ; Fall through: byte had bit 7 set => end of keyword.
0002D3r 2               @AdvanceTok:
0002D3r 2  E6 3A                inc     BAS_TMP1
0002D5r 2  80 C5                bra     @KeywordLoop
0002D7r 2               
0002D7r 2               @WholeMatch:
0002D7r 2                       ; X points at the LAST matched char in input; advance past it.
0002D7r 2  E8                   inx
0002D8r 2  A5 3A                lda     BAS_TMP1
0002DAr 2  7A                   ply                             ; restore caller's Y
0002DBr 2  38                   sec
0002DCr 2  60                   rts
0002DDr 2               
0002DDr 2               @NoMatch:
0002DDr 2  A6 3E                ldx     BAS_TMP3                ; restore caller's X
0002DFr 2  7A                   ply                             ; restore caller's Y
0002E0r 2  BD 00 04             lda     BAS_LINBUF,x
0002E3r 2  18                   clc
0002E4r 2  60                   rts
0002E5r 2               
0002E5r 2               ; =============================================================================
0002E5r 2               ;   B a s S t o r e L i n e
0002E5r 2               ; =============================================================================
0002E5r 2               ; Insert or replace BAS_LINNUM in the program with the tokenized payload in
0002E5r 2               ; BAS_TOKBUF.  If BAS_TOKBUF is empty, delete the existing line.
0002E5r 2               ;
0002E5r 2               ; Algorithm:
0002E5r 2               ;   1. Find existing line number (or insertion point).
0002E5r 2               ;   2. If exact match, delete that line (close the gap, decrement VARTAB).
0002E5r 2               ;   3. If payload non-empty, splice in [next][num][payload][$00].
0002E5r 2               ;   4. Relink all next-pointers.
0002E5r 2               ; =============================================================================
0002E5r 2               BasStoreLine:
0002E5r 2                       ; Locate insertion point.  BAS_INDEX <- pointer; carry set = exact match.
0002E5r 2  20 rr rr             jsr     BasFindLine
0002E8r 2               
0002E8r 2  90 03                bcc     @NoExisting
0002EAr 2                       ; Line exists - delete it first.
0002EAr 2  20 rr rr             jsr     BasDeleteAtIndex
0002EDr 2               @NoExisting:
0002EDr 2                       ; If tokbuf is empty, we're done (delete-only operation).
0002EDr 2  AD 00 05             lda     BAS_TOKBUF
0002F0r 2  D0 04                bne     @InsertNew
0002F2r 2  20 rr rr             jsr     BasRelink
0002F5r 2  60                   rts
0002F6r 2               
0002F6r 2               @InsertNew:
0002F6r 2  20 rr rr             jsr     BasInsertAtIndex
0002F9r 2  90 04                bcc     @NoMem
0002FBr 2  20 rr rr             jsr     BasRelink
0002FEr 2  60                   rts
0002FFr 2               @NoMem:
0002FFr 2  A9 02                lda     #ERR_OUTOFMEM
000301r 2  4C rr rr             jmp     BasError
000304r 2               
000304r 2               ; =============================================================================
000304r 2               ;   B a s F i n d L i n e
000304r 2               ; =============================================================================
000304r 2               ; Locate BAS_LINNUM in the program list.
000304r 2               ;
000304r 2               ; On entry : BAS_LINNUM = target line number.
000304r 2               ; On exit  : BAS_INDEX = pointer to start of either the matching line or the
000304r 2               ;            first line whose number > target (or end-marker).
000304r 2               ;            Carry SET if exact match, CLEAR otherwise.
000304r 2               ; =============================================================================
000304r 2               BasFindLine:
000304r 2  AD 5D 03             lda     BAS_TXTTAB
000307r 2  85 20                sta     BAS_INDEX
000309r 2  AD 5E 03             lda     BAS_TXTTAB+1
00030Cr 2  85 21                sta     BAS_INDEX+1
00030Er 2               @Loop:
00030Er 2  A0 01                ldy     #1
000310r 2  B1 20                lda     (BAS_INDEX),y
000312r 2  F0 25                beq     @NotFound               ; end-marker (next-hi = 0)
000314r 2               
000314r 2                       ; Compare line numbers: (INDEX+2/+3) vs LINNUM.
000314r 2  A0 03                ldy     #3
000316r 2  B1 20                lda     (BAS_INDEX),y
000318r 2  C5 09                cmp     BAS_LINNUM+1
00031Ar 2  90 0D                bcc     @Advance                ; line < target
00031Cr 2  D0 1B                bne     @TooHigh                ; line > target -> insertion point
00031Er 2  88                   dey
00031Fr 2  B1 20                lda     (BAS_INDEX),y
000321r 2  C5 08                cmp     BAS_LINNUM
000323r 2  90 04                bcc     @Advance
000325r 2  D0 12                bne     @TooHigh
000327r 2                       ; Exact match.
000327r 2  38                   sec
000328r 2  60                   rts
000329r 2               
000329r 2               @Advance:
000329r 2                       ; Follow next-pointer.
000329r 2  A0 00                ldy     #0
00032Br 2  B1 20                lda     (BAS_INDEX),y
00032Dr 2  48                   pha
00032Er 2  A0 01                ldy     #1
000330r 2  B1 20                lda     (BAS_INDEX),y
000332r 2  85 21                sta     BAS_INDEX+1
000334r 2  68                   pla
000335r 2  85 20                sta     BAS_INDEX
000337r 2  80 D5                bra     @Loop
000339r 2               
000339r 2               @NotFound:
000339r 2               @TooHigh:
000339r 2  18                   clc
00033Ar 2  60                   rts
00033Br 2               
00033Br 2               ; =============================================================================
00033Br 2               ;   B a s D e l e t e A t I n d e x
00033Br 2               ; =============================================================================
00033Br 2               ; Delete the line whose start is at BAS_INDEX.
00033Br 2               ; Closes the gap by copying [next-line .. VARTAB-1] down to (BAS_INDEX...)
00033Br 2               ; and decrements VARTAB by the deleted size.
00033Br 2               ; =============================================================================
00033Br 2               BasDeleteAtIndex:
00033Br 2                       ; BAS_TMP1 = next-line address (read from current line's next ptr).
00033Br 2  A0 00                ldy     #0
00033Dr 2  B1 20                lda     (BAS_INDEX),y
00033Fr 2  85 3A                sta     BAS_TMP1
000341r 2  C8                   iny
000342r 2  B1 20                lda     (BAS_INDEX),y
000344r 2  85 3B                sta     BAS_TMP1+1
000346r 2               
000346r 2                       ; gap-size = TMP1 - INDEX  (positive)
000346r 2                       ; Copy from TMP1 to INDEX, byte by byte, until TMP1 reaches VARTAB.
000346r 2                       ; BAS_DEST = INDEX (write cursor); BAS_TMP2 = src cursor (= TMP1).
000346r 2  A5 20                lda     BAS_INDEX
000348r 2  85 22                sta     BAS_DEST
00034Ar 2  A5 21                lda     BAS_INDEX+1
00034Cr 2  85 23                sta     BAS_DEST+1
00034Er 2               
00034Er 2               @CopyLoop:
00034Er 2                       ; Done when TMP1 == VARTAB.
00034Er 2  A5 3A                lda     BAS_TMP1
000350r 2  CD 5F 03             cmp     BAS_VARTAB
000353r 2  A5 3B                lda     BAS_TMP1+1
000355r 2  ED 60 03             sbc     BAS_VARTAB+1
000358r 2  B0 14                bcs     @CopyDone
00035Ar 2               
00035Ar 2  A0 00                ldy     #0
00035Cr 2  B1 3A                lda     (BAS_TMP1),y
00035Er 2  91 22                sta     (BAS_DEST),y
000360r 2               
000360r 2  E6 3A                inc     BAS_TMP1
000362r 2  D0 02                bne     @IncDest
000364r 2  E6 3B                inc     BAS_TMP1+1
000366r 2               @IncDest:
000366r 2  E6 22                inc     BAS_DEST
000368r 2  D0 E4                bne     @CopyLoop
00036Ar 2  E6 23                inc     BAS_DEST+1
00036Cr 2  80 E0                bra     @CopyLoop
00036Er 2               
00036Er 2               @CopyDone:
00036Er 2                       ; VARTAB = DEST.
00036Er 2  A5 22                lda     BAS_DEST
000370r 2  8D 5F 03             sta     BAS_VARTAB
000373r 2  A5 23                lda     BAS_DEST+1
000375r 2  8D 60 03             sta     BAS_VARTAB+1
000378r 2                       ; Mirror to ARYTAB/STREND (vars/arrays empty after edit; keep them
000378r 2                       ; tracking VARTAB).
000378r 2  8D 62 03             sta     BAS_ARYTAB+1
00037Br 2  8D 64 03             sta     BAS_STREND+1
00037Er 2  AD 5F 03             lda     BAS_VARTAB
000381r 2  8D 61 03             sta     BAS_ARYTAB
000384r 2  8D 63 03             sta     BAS_STREND
000387r 2  60                   rts
000388r 2               
000388r 2               ; =============================================================================
000388r 2               ;   B a s I n s e r t A t I n d e x
000388r 2               ; =============================================================================
000388r 2               ; Splice a new line ([next-placeholder][num-lo][num-hi][payload][$00]) in
000388r 2               ; at BAS_INDEX, shifting following bytes upward.
000388r 2               ;
000388r 2               ; On entry : BAS_INDEX = insertion address, BAS_LINNUM = line number,
000388r 2               ;            BAS_TOKBUF = NUL-terminated payload (non-empty).
000388r 2               ; On exit  : Carry SET on success, CLEAR if not enough memory.
000388r 2               ;            VARTAB / ARYTAB / STREND advanced to new end-of-program.
000388r 2               ;
000388r 2               ; This is why a .prg's BASIC stub cannot be edited: the shift moves everything
000388r 2               ; up to VARTAB, and the new pointers come from the chain alone, so attached
000388r 2               ; machine code is both relocated and dropped from VARTAB's view.  Its addresses
000388r 2               ; are absolute, so it would break either way — the C64 has the same constraint.
000388r 2               ; =============================================================================
000388r 2               BasInsertAtIndex:
000388r 2                       ; Compute payload length L (excluding NUL): scan TOKBUF.
000388r 2  A0 00                ldy     #0
00038Ar 2               @LenScan:
00038Ar 2  B9 00 05             lda     BAS_TOKBUF,y
00038Dr 2  F0 03                beq     @LenDone
00038Fr 2  C8                   iny
000390r 2  D0 F8                bne     @LenScan
000392r 2               @LenDone:
000392r 2                       ; Total line size = 4 (header) + L + 1 (terminator) = L + 5.
000392r 2                       ; Store size in BAS_TMP3 (assumes <= 250+5 = 255, fits in one byte).
000392r 2  98                   tya
000393r 2  18                   clc
000394r 2  69 05                adc     #5
000396r 2  85 3E                sta     BAS_TMP3                ; line size in bytes (<=255)
000398r 2               
000398r 2                       ; Memory check: VARTAB + size <= MEMSIZ.
000398r 2  18                   clc
000399r 2  AD 5F 03             lda     BAS_VARTAB
00039Cr 2  65 3E                adc     BAS_TMP3
00039Er 2  85 3A                sta     BAS_TMP1
0003A0r 2  AD 60 03             lda     BAS_VARTAB+1
0003A3r 2  69 00                adc     #0
0003A5r 2  85 3B                sta     BAS_TMP1+1
0003A7r 2  A5 3A                lda     BAS_TMP1
0003A9r 2  CD 67 03             cmp     BAS_MEMSIZ
0003ACr 2  A5 3B                lda     BAS_TMP1+1
0003AEr 2  ED 68 03             sbc     BAS_MEMSIZ+1
0003B1r 2  90 02                bcc     @SizeOK
0003B3r 2  18                   clc                             ; out of memory
0003B4r 2  60                   rts
0003B5r 2               @SizeOK:
0003B5r 2                       ; Shift bytes [INDEX .. VARTAB-1] up by TMP3.
0003B5r 2                       ; Copy from high-to-low to avoid overlap clobber.
0003B5r 2                       ; src  = VARTAB-1
0003B5r 2                       ; dst  = VARTAB-1 + TMP3
0003B5r 2  AD 5F 03             lda     BAS_VARTAB
0003B8r 2  38                   sec
0003B9r 2  E9 01                sbc     #1
0003BBr 2  85 3A                sta     BAS_TMP1                ; src
0003BDr 2  AD 60 03             lda     BAS_VARTAB+1
0003C0r 2  E9 00                sbc     #0
0003C2r 2  85 3B                sta     BAS_TMP1+1
0003C4r 2  18                   clc
0003C5r 2  A5 3A                lda     BAS_TMP1
0003C7r 2  65 3E                adc     BAS_TMP3
0003C9r 2  85 22                sta     BAS_DEST                ; dst
0003CBr 2  A5 3B                lda     BAS_TMP1+1
0003CDr 2  69 00                adc     #0
0003CFr 2  85 23                sta     BAS_DEST+1
0003D1r 2               @Shift:
0003D1r 2                       ; Stop when TMP1 < INDEX (i.e. INDEX-1 reached -> done).
0003D1r 2  A5 3A                lda     BAS_TMP1
0003D3r 2  C5 20                cmp     BAS_INDEX
0003D5r 2  A5 3B                lda     BAS_TMP1+1
0003D7r 2  E5 21                sbc     BAS_INDEX+1
0003D9r 2  90 18                bcc     @ShiftDone
0003DBr 2               
0003DBr 2  A0 00                ldy     #0
0003DDr 2  B1 3A                lda     (BAS_TMP1),y
0003DFr 2  91 22                sta     (BAS_DEST),y
0003E1r 2               
0003E1r 2                       ; dec TMP1
0003E1r 2  A5 3A                lda     BAS_TMP1
0003E3r 2  D0 02                bne     @T1NoBorrow
0003E5r 2  C6 3B                dec     BAS_TMP1+1
0003E7r 2               @T1NoBorrow:
0003E7r 2  C6 3A                dec     BAS_TMP1
0003E9r 2                       ; dec DEST
0003E9r 2  A5 22                lda     BAS_DEST
0003EBr 2  D0 02                bne     @DNoBorrow
0003EDr 2  C6 23                dec     BAS_DEST+1
0003EFr 2               @DNoBorrow:
0003EFr 2  C6 22                dec     BAS_DEST
0003F1r 2  80 DE                bra     @Shift
0003F3r 2               
0003F3r 2               @ShiftDone:
0003F3r 2                       ; Write new line header at BAS_INDEX.
0003F3r 2  A0 00                ldy     #0
0003F5r 2  A9 FF                lda     #$FF                    ; placeholder next-ptr (Relink fixes)
0003F7r 2  91 20                sta     (BAS_INDEX),y
0003F9r 2  C8                   iny
0003FAr 2  91 20                sta     (BAS_INDEX),y
0003FCr 2  C8                   iny
0003FDr 2  A5 08                lda     BAS_LINNUM
0003FFr 2  91 20                sta     (BAS_INDEX),y
000401r 2  C8                   iny
000402r 2  A5 09                lda     BAS_LINNUM+1
000404r 2  91 20                sta     (BAS_INDEX),y
000406r 2  C8                   iny
000407r 2               
000407r 2                       ; Copy payload from BAS_TOKBUF (NUL terminator included).
000407r 2  A2 00                ldx     #0
000409r 2               @PayloadCopy:
000409r 2  BD 00 05             lda     BAS_TOKBUF,x
00040Cr 2  91 20                sta     (BAS_INDEX),y
00040Er 2  F0 04                beq     @PayloadDone
000410r 2  E8                   inx
000411r 2  C8                   iny
000412r 2  80 F5                bra     @PayloadCopy
000414r 2               @PayloadDone:
000414r 2                       ; Update VARTAB.
000414r 2  18                   clc
000415r 2  AD 5F 03             lda     BAS_VARTAB
000418r 2  65 3E                adc     BAS_TMP3
00041Ar 2  8D 5F 03             sta     BAS_VARTAB
00041Dr 2  AD 60 03             lda     BAS_VARTAB+1
000420r 2  69 00                adc     #0
000422r 2  8D 60 03             sta     BAS_VARTAB+1
000425r 2                       ; Mirror to ARYTAB/STREND.
000425r 2  AD 5F 03             lda     BAS_VARTAB
000428r 2  8D 61 03             sta     BAS_ARYTAB
00042Br 2  8D 63 03             sta     BAS_STREND
00042Er 2  AD 60 03             lda     BAS_VARTAB+1
000431r 2  8D 62 03             sta     BAS_ARYTAB+1
000434r 2  8D 64 03             sta     BAS_STREND+1
000437r 2               
000437r 2  38                   sec
000438r 2  60                   rts
000439r 2               
000439r 2               ; =============================================================================
000439r 2               ;   B a s R e l i n k
000439r 2               ; =============================================================================
000439r 2               ; Walk the program list and rewrite every next-pointer to the address of
000439r 2               ; the following line (computed by scanning forward to the line's NUL
000439r 2               ; terminator).  Stops when a next-pointer's high byte is already 0
000439r 2               ; (the [00][00] end-marker, which is left untouched).
000439r 2               ; =============================================================================
000439r 2               BasRelink:
000439r 2  AD 5D 03             lda     BAS_TXTTAB
00043Cr 2  85 20                sta     BAS_INDEX
00043Er 2  AD 5E 03             lda     BAS_TXTTAB+1
000441r 2  85 21                sta     BAS_INDEX+1
000443r 2               @Loop:
000443r 2  A0 01                ldy     #1
000445r 2  B1 20                lda     (BAS_INDEX),y
000447r 2  F0 2B                beq     @Done                   ; end-marker reached
000449r 2               
000449r 2                       ; Find the NUL terminator at INDEX + Y for some Y >= 4.
000449r 2  A0 04                ldy     #4
00044Br 2               @Scan:
00044Br 2  B1 20                lda     (BAS_INDEX),y
00044Dr 2  F0 03                beq     @Found
00044Fr 2  C8                   iny
000450r 2  D0 F9                bne     @Scan
000452r 2               @Found:
000452r 2  C8                   iny                             ; one past NUL = next line address
000453r 2                       ; next = INDEX + Y
000453r 2  98                   tya
000454r 2  18                   clc
000455r 2  65 20                adc     BAS_INDEX
000457r 2  85 3A                sta     BAS_TMP1
000459r 2  A5 21                lda     BAS_INDEX+1
00045Br 2  69 00                adc     #0
00045Dr 2  85 3B                sta     BAS_TMP1+1
00045Fr 2               
00045Fr 2                       ; Write new next-pointer at (INDEX),0/1.
00045Fr 2  A0 00                ldy     #0
000461r 2  A5 3A                lda     BAS_TMP1
000463r 2  91 20                sta     (BAS_INDEX),y
000465r 2  C8                   iny
000466r 2  A5 3B                lda     BAS_TMP1+1
000468r 2  91 20                sta     (BAS_INDEX),y
00046Ar 2               
00046Ar 2                       ; Advance INDEX = TMP1.
00046Ar 2  A5 3A                lda     BAS_TMP1
00046Cr 2  85 20                sta     BAS_INDEX
00046Er 2  A5 3B                lda     BAS_TMP1+1
000470r 2  85 21                sta     BAS_INDEX+1
000472r 2  80 CF                bra     @Loop
000474r 2               @Done:
000474r 2  60                   rts
000475r 2               
000475r 2               ; =============================================================================
000475r 2               ;   B a s D i s p a t c h I m m e d i a t e
000475r 2               ; =============================================================================
000475r 2               ; Execute a tokenized line (BAS_TOKBUF) in immediate mode by entering the
000475r 2               ; statement loop (BasNewstt) with TXTPTR pointing one byte before the first
000475r 2               ; tokenized byte.  Re-anchors the CPU stack so that FOR / GOSUB frames
000475r 2               ; stored on the stack can be located by the scanners.
000475r 2               ; =============================================================================
000475r 2               BasDispatchImmediate:
000475r 2                       ; Write a ':' sentinel just before BAS_TOKBUF so NEWSTT's initial
000475r 2                       ; (TXTPTR),y read takes the @nextStmt path and CHRGETs the first token.
000475r 2  A9 3A                lda     #':'
000477r 2  8D FF 04             sta     BAS_TOKBUF-1
00047Ar 2  A9 FF                lda     #<(BAS_TOKBUF-1)
00047Cr 2  85 04                sta     TXTPTR
00047Er 2  A9 04                lda     #>(BAS_TOKBUF-1)
000480r 2  85 05                sta     TXTPTR+1
000482r 2  9C 70 03             stz     BAS_POSX
000485r 2                       ; Direct mode: CURLIN = $FFFF (msbasic convention).
000485r 2  A9 FF                lda     #$FF
000487r 2  8D 69 03             sta     BAS_CURLIN
00048Ar 2  8D 6A 03             sta     BAS_CURLIN+1
00048Dr 2                       ; Reset CPU stack so FOR / GOSUB frame scanners have a clean baseline.
00048Dr 2  A2 FF                ldx     #$FF
00048Fr 2  9A                   txs
000490r 2  4C rr rr             jmp     BasNewstt
000493r 2               
000493r 2               ; =============================================================================
000493r 2               ;   B a s C m d N e w
000493r 2               ; =============================================================================
000493r 2               ; Reset program storage to empty: write [00][00] at $0800 and reset the
000493r 2               ; runtime pointers.
000493r 2               ; =============================================================================
000493r 2               BasCmdNew:
000493r 2  9C 00 08             stz     BAS_PRG_START
000496r 2  9C 01 08             stz     BAS_PRG_START+1
000499r 2  A9 02                lda     #<(BAS_PRG_START+2)
00049Br 2  8D 5F 03             sta     BAS_VARTAB
00049Er 2  8D 61 03             sta     BAS_ARYTAB
0004A1r 2  8D 63 03             sta     BAS_STREND
0004A4r 2  A9 08                lda     #>(BAS_PRG_START+2)
0004A6r 2  8D 60 03             sta     BAS_VARTAB+1
0004A9r 2  8D 62 03             sta     BAS_ARYTAB+1
0004ACr 2  8D 64 03             sta     BAS_STREND+1
0004AFr 2  AD 67 03             lda     BAS_MEMSIZ
0004B2r 2  8D 65 03             sta     BAS_FRETOP
0004B5r 2  AD 68 03             lda     BAS_MEMSIZ+1
0004B8r 2  8D 66 03             sta     BAS_FRETOP+1
0004BBr 2  60                   rts
0004BCr 2               
0004BCr 2               ; =============================================================================
0004BCr 2               ;   B a s C m d L i s t
0004BCr 2               ; =============================================================================
0004BCr 2               ; Print every stored line in order.  Each line: decimal line number, single
0004BCr 2               ; space, detokenized payload, CRLF.
0004BCr 2               ; =============================================================================
0004BCr 2               BasCmdList:
0004BCr 2  AD 5D 03             lda     BAS_TXTTAB
0004BFr 2  85 20                sta     BAS_INDEX
0004C1r 2  AD 5E 03             lda     BAS_TXTTAB+1
0004C4r 2  85 21                sta     BAS_INDEX+1
0004C6r 2               @LineLoop:
0004C6r 2  A0 01                ldy     #1
0004C8r 2  B1 20                lda     (BAS_INDEX),y
0004CAr 2  F0 3D                beq     @Done                   ; end-marker
0004CCr 2                       ; Print line number.
0004CCr 2  A0 02                ldy     #2
0004CEr 2  B1 20                lda     (BAS_INDEX),y
0004D0r 2  85 08                sta     BAS_LINNUM
0004D2r 2  C8                   iny
0004D3r 2  B1 20                lda     (BAS_INDEX),y
0004D5r 2  85 09                sta     BAS_LINNUM+1
0004D7r 2  20 rr rr             jsr     BasPrintLineNum
0004DAr 2  A9 20                lda     #' '
0004DCr 2  20 rr rr             jsr     Chrout
0004DFr 2               
0004DFr 2                       ; Detokenize from offset 4 to the NUL terminator.
0004DFr 2  A0 04                ldy     #4
0004E1r 2               @DetokLoop:
0004E1r 2  B1 20                lda     (BAS_INDEX),y
0004E3r 2  F0 12                beq     @LineEnd
0004E5r 2  30 06                bmi     @Token
0004E7r 2  20 rr rr             jsr     Chrout
0004EAr 2  C8                   iny
0004EBr 2  80 F4                bra     @DetokLoop
0004EDr 2               @Token:
0004EDr 2  84 42                sty     BAS_DETOKY
0004EFr 2  20 rr rr             jsr     BasPrintKeyword         ; preserves nothing useful
0004F2r 2  A4 42                ldy     BAS_DETOKY
0004F4r 2  C8                   iny
0004F5r 2  80 EA                bra     @DetokLoop
0004F7r 2               @LineEnd:
0004F7r 2  20 rr rr             jsr     BasPrintCRLF
0004FAr 2                       ; Advance INDEX via next-pointer.
0004FAr 2  A0 00                ldy     #0
0004FCr 2  B1 20                lda     (BAS_INDEX),y
0004FEr 2  48                   pha
0004FFr 2  C8                   iny
000500r 2  B1 20                lda     (BAS_INDEX),y
000502r 2  85 21                sta     BAS_INDEX+1
000504r 2  68                   pla
000505r 2  85 20                sta     BAS_INDEX
000507r 2  80 BD                bra     @LineLoop
000509r 2               @Done:
000509r 2  60                   rts
00050Ar 2               
00050Ar 2               ; =============================================================================
00050Ar 2               ;   B a s P r i n t L i n e N u m
00050Ar 2               ; =============================================================================
00050Ar 2               ; Print BAS_LINNUM (16-bit unsigned) as decimal (no leading zeros, no sign).
00050Ar 2               ; Thin shim over the KERNAL PrintDecU16 ($A096); the decimal-print core now
00050Ar 2               ; lives once in the KERNAL (shared with FsPrintSize).
00050Ar 2               ; Clobbers : A, X, Y, FS_FILE_SIZE, FS_DIR_IDX.
00050Ar 2               ; =============================================================================
00050Ar 2               BasPrintLineNum:
00050Ar 2  A5 08                lda     BAS_LINNUM
00050Cr 2  A6 09                ldx     BAS_LINNUM+1
00050Er 2  4C rr rr             jmp     PrintDecU16
000511r 2               
000511r 2               ; =============================================================================
000511r 2               ;   B a s C m d P r i n t
000511r 2               ; =============================================================================
000511r 2               ; Immediate-mode PRINT.  X on entry = offset into BAS_TOKBUF where the
000511r 2               ; PRINT token sits.  Items separated by ';' (no separator) or ',' (advance
000511r 2               ; to next 14-column print zone).  Trailing ';' or ',' suppresses CRLF.
000511r 2               ;
000511r 2               ; Special-cased token: HEX(n) -> emit "$XXXX" hex form (does not call
000511r 2               ; FrmEvl; consumes the token + parens here).
000511r 2               ; =============================================================================
000511r 2               BasCmdPrint:
000511r 2                       ; TXTPTR is positioned with ChrGot returning TOK_PRINT.  Advance
000511r 2                       ; past the token; col counter is reset by the dispatcher's outer loop.
000511r 2  20 rr rr             jsr     ChrGet                  ; consume PRINT token
000514r 2               
000514r 2               BasPrLoop:
000514r 2  20 rr rr             jsr     ChrGot
000517r 2  D0 03 4C rr          jeq     BasPrEndNl
00051Br 2  rr           
00051Cr 2  C9 3A                cmp     #':'
00051Er 2  D0 03 4C rr          jeq     BasPrEndNl
000522r 2  rr           
000523r 2  C9 A4                cmp     #TOK_ELSE
000525r 2  D0 03 4C rr          jeq     BasPrEndNl
000529r 2  rr           
00052Ar 2  C9 3B                cmp     #';'
00052Cr 2  D0 03 4C rr          jeq     BasPrSep
000530r 2  rr           
000531r 2  C9 2C                cmp     #','
000533r 2  D0 03 4C rr          jeq     BasPrComma
000537r 2  rr           
000538r 2  C9 CE                cmp     #TOK_HEX
00053Ar 2  D0 17                bne     @chkTab
00053Cr 2                       ; HEX(n) in PRINT context: emit "$XXXX".
00053Cr 2  20 rr rr             jsr     ChrGet                  ; consume HEX
00053Fr 2  20 rr rr             jsr     ChkOpn
000542r 2  20 rr rr             jsr     FrmEvl
000545r 2  20 rr rr             jsr     ChkNum
000548r 2  20 rr rr             jsr     ChkCls
00054Br 2                       ; Unsigned: AyInt is the signed conversion and rejects anything at or
00054Br 2                       ; above 32768, so PRINT HEX() of any address in the top half of the
00054Br 2                       ; map -- $8000, the RAM bank window the README documents -- raised
00054Br 2                       ; ILLEGAL QUANTITY. A four-digit $xxxx covers 0..65535, and FacToU16
00054Br 2                       ; leaves its result in the same FAC+3/FAC+4 PrintHex16 reads.
00054Br 2  20 rr rr             jsr     FacToU16
00054Er 2  20 rr rr             jsr     PrintHex16
000551r 2  80 6A                bra     BasPrAfter
000553r 2               @chkTab:
000553r 2  C9 9B                cmp     #TOK_TAB
000555r 2  D0 2D                bne     @chkSpc
000557r 2  20 rr rr             jsr     ChrGet                  ; consume TAB
00055Ar 2  20 rr rr             jsr     ChkOpn
00055Dr 2  20 rr rr             jsr     FrmNum
000560r 2  20 rr rr             jsr     ChkCls
000563r 2  20 rr rr             jsr     AyInt
000566r 2  A5 11                lda     FAC+3                   ; column count must fit in a byte
000568r 2  D0 53                bne     BasPrAfter
00056Ar 2  A5 12                lda     FAC+4
00056Cr 2  CD 70 03             cmp     BAS_POSX
00056Fr 2  90 4C                bcc     BasPrAfter              ; already at/past target column
000571r 2  38                   sec
000572r 2  ED 70 03             sbc     BAS_POSX
000575r 2  A8                   tay
000576r 2  F0 45                beq     BasPrAfter
000578r 2               @tabLoop:
000578r 2  5A                   phy
000579r 2  A9 20                lda     #' '
00057Br 2  20 rr rr             jsr     PrintCh
00057Er 2  7A                   ply
00057Fr 2  88                   dey
000580r 2  D0 F6                bne     @tabLoop
000582r 2  80 39                bra     BasPrAfter
000584r 2               @chkSpc:
000584r 2  C9 9E                cmp     #TOK_SPC
000586r 2  D0 23                bne     @expr
000588r 2  20 rr rr             jsr     ChrGet                  ; consume SPC
00058Br 2  20 rr rr             jsr     ChkOpn
00058Er 2  20 rr rr             jsr     FrmNum
000591r 2  20 rr rr             jsr     ChkCls
000594r 2  20 rr rr             jsr     AyInt
000597r 2  A5 11                lda     FAC+3
000599r 2  D0 22                bne     BasPrAfter
00059Br 2  A4 12                ldy     FAC+4
00059Dr 2  F0 1E                beq     BasPrAfter
00059Fr 2               @spcLoop:
00059Fr 2  5A                   phy
0005A0r 2  A9 20                lda     #' '
0005A2r 2  20 rr rr             jsr     PrintCh
0005A5r 2  7A                   ply
0005A6r 2  88                   dey
0005A7r 2  D0 F6                bne     @spcLoop
0005A9r 2  80 12                bra     BasPrAfter
0005ABr 2               @expr:
0005ABr 2  20 rr rr             jsr     FrmEvl
0005AEr 2  24 64                bit     VALTYP
0005B0r 2  30 05                bmi     @prStr
0005B2r 2  20 rr rr             jsr     PrintNum
0005B5r 2  80 06                bra     BasPrAfter
0005B7r 2               @prStr:
0005B7r 2  20 rr rr             jsr     PrintStrFAC
0005BAr 2  20 rr rr             jsr     FreFac
0005BDr 2               BasPrAfter:
0005BDr 2  20 rr rr             jsr     ChrGot
0005C0r 2  D0 03 4C rr          jeq     BasPrEndNl
0005C4r 2  rr           
0005C5r 2  C9 3A                cmp     #':'
0005C7r 2  D0 03 4C rr          jeq     BasPrEndNl
0005CBr 2  rr           
0005CCr 2  C9 A4                cmp     #TOK_ELSE
0005CEr 2  D0 03 4C rr          jeq     BasPrEndNl
0005D2r 2  rr           
0005D3r 2  C9 3B                cmp     #';'
0005D5r 2  D0 03 4C rr          jeq     BasPrSep
0005D9r 2  rr           
0005DAr 2  C9 2C                cmp     #','
0005DCr 2  D0 03 4C rr          jeq     BasPrComma
0005E0r 2  rr           
0005E1r 2  4C rr rr             jmp     SynErr
0005E4r 2               BasPrSep:
0005E4r 2  20 rr rr             jsr     ChrGet                  ; consume ;
0005E7r 2  20 rr rr             jsr     ChrGot
0005EAr 2  F0 40                beq     BasPrEndNoNl            ; trailing ; -> no CRLF
0005ECr 2  C9 3A                cmp     #':'
0005EEr 2  F0 3C                beq     BasPrEndNoNl
0005F0r 2  4C rr rr             jmp     BasPrLoop
0005F3r 2               BasPrComma:
0005F3r 2  20 rr rr             jsr     ChrGet
0005F6r 2                       ; Pad to next multiple of 14 (MS-BASIC 14-column zone).
0005F6r 2                       ; col_mod = BAS_POSX mod 14; if 0 already at zone, else emit (14-col_mod) spaces.
0005F6r 2  AD 70 03             lda     BAS_POSX
0005F9r 2  85 3A                sta     BAS_TMP1
0005FBr 2               @modA:
0005FBr 2  A5 3A                lda     BAS_TMP1
0005FDr 2  C9 0E                cmp     #14
0005FFr 2  90 07                bcc     @modB
000601r 2  38                   sec
000602r 2  E9 0E                sbc     #14
000604r 2  85 3A                sta     BAS_TMP1
000606r 2  80 F3                bra     @modA
000608r 2               @modB:
000608r 2  C9 00                cmp     #0
00060Ar 2  F0 0D                beq     @padDone
00060Cr 2               @padSp:
00060Cr 2  A9 20                lda     #' '
00060Er 2  20 rr rr             jsr     PrintCh
000611r 2  E6 3A                inc     BAS_TMP1
000613r 2  A5 3A                lda     BAS_TMP1
000615r 2  C9 0E                cmp     #14
000617r 2  D0 F3                bne     @padSp
000619r 2               @padDone:
000619r 2  20 rr rr             jsr     ChrGot
00061Cr 2  F0 0E                beq     BasPrEndNoNl
00061Er 2  C9 3A                cmp     #':'
000620r 2  F0 0A                beq     BasPrEndNoNl
000622r 2  4C rr rr             jmp     BasPrLoop
000625r 2               BasPrEndNl:
000625r 2  20 rr rr             jsr     BasPrintCRLF
000628r 2  9C 70 03             stz     BAS_POSX
00062Br 2  60                   rts
00062Cr 2               BasPrEndNoNl:
00062Cr 2  60                   rts
00062Dr 2               
00062Dr 2               ; ---------------------------------------------------------------------------
00062Dr 2               ; PrintCh -- emit A through Chrout, maintaining BAS_POSX (CR resets it).
00062Dr 2               ; ---------------------------------------------------------------------------
00062Dr 2               PrintCh:
00062Dr 2  C9 0D                cmp     #$0D
00062Fr 2  F0 0C                beq     @cr
000631r 2  C9 0A                cmp     #$0A
000633r 2  F0 08                beq     @cr
000635r 2  48                   pha
000636r 2  EE 70 03             inc     BAS_POSX
000639r 2  68                   pla
00063Ar 2  4C rr rr             jmp     Chrout
00063Dr 2               @cr:
00063Dr 2  9C 70 03             stz     BAS_POSX
000640r 2  4C rr rr             jmp     Chrout
000643r 2               
000643r 2               ; ---------------------------------------------------------------------------
000643r 2               ; PrintNum -- emit FAC as ASCII via Fout, tracking column.
000643r 2               ; ---------------------------------------------------------------------------
000643r 2               PrintNum:
000643r 2  20 rr rr             jsr     Fout                    ; (Y,A) = NUL-terminated buffer
000646r 2  85 20                sta     INDEX
000648r 2  84 21                sty     INDEX+1
00064Ar 2  A0 00                ldy     #0
00064Cr 2               @loop:
00064Cr 2  B1 20                lda     (INDEX),y
00064Er 2  F0 06                beq     @done
000650r 2  20 rr rr             jsr     PrintCh
000653r 2  C8                   iny
000654r 2  D0 F6                bne     @loop
000656r 2               @done:
000656r 2  60                   rts
000657r 2               
000657r 2               ; ---------------------------------------------------------------------------
000657r 2               ; PrintStrFAC -- emit string-descriptor at FAC..FAC+2.
000657r 2               ; ---------------------------------------------------------------------------
000657r 2               PrintStrFAC:
000657r 2  A5 0F                lda     FAC+1
000659r 2  85 20                sta     INDEX
00065Br 2  A5 10                lda     FAC+2
00065Dr 2  85 21                sta     INDEX+1
00065Fr 2  A0 00                ldy     #0
000661r 2               @loop:
000661r 2  C4 0E                cpy     FAC
000663r 2  F0 08                beq     @done
000665r 2  B1 20                lda     (INDEX),y
000667r 2  20 rr rr             jsr     PrintCh
00066Ar 2  C8                   iny
00066Br 2  80 F4                bra     @loop
00066Dr 2               @done:
00066Dr 2  60                   rts
00066Er 2               
00066Er 2               ; ---------------------------------------------------------------------------
00066Er 2               ; PrintHex16 -- emit FAC+3,FAC+4 (lo,hi) as "$XXXX".
00066Er 2               ; ---------------------------------------------------------------------------
00066Er 2               PrintHex16:
00066Er 2  A9 24                lda     #'$'
000670r 2  20 rr rr             jsr     PrintCh
000673r 2  A5 11                lda     FAC+3
000675r 2  20 rr rr             jsr     PrintHexByte
000678r 2  A5 12                lda     FAC+4
00067Ar 2                       ; fall through
00067Ar 2               PrintHexByte:
00067Ar 2  48                   pha
00067Br 2  4A                   lsr     a
00067Cr 2  4A                   lsr     a
00067Dr 2  4A                   lsr     a
00067Er 2  4A                   lsr     a
00067Fr 2  20 rr rr             jsr     @nib
000682r 2  68                   pla
000683r 2  29 0F                and     #$0F
000685r 2               @nib:
000685r 2  C9 0A                cmp     #10
000687r 2  90 02                bcc     @dig
000689r 2  69 06                adc     #'A'-'9'-2              ; +'A'-10-1 (carry already set)
00068Br 2               @dig:
00068Br 2  69 30                adc     #'0'
00068Dr 2  4C rr rr             jmp     PrintCh
000690r 2               
000690r 2               ; =============================================================================
000690r 2               ;   B a s P r i n t K e y w o r d
000690r 2               ; =============================================================================
000690r 2               ; Print the keyword whose token byte is in A (bit 7 set).
000690r 2               ; Walks the keyword table to find entry (A - TOK_BASE) and prints its chars.
000690r 2               ; =============================================================================
000690r 2               BasPrintKeyword:
000690r 2  38                   sec
000691r 2  E9 80                sbc     #TOK_BASE               ; A = index
000693r 2  AA                   tax
000694r 2                       ; Walk via 16-bit BAS_KWPTR since the table is > 256 bytes.
000694r 2  A9 rr                lda     #<KeywordTbl
000696r 2  85 61                sta     BAS_KWPTR
000698r 2  A9 rr                lda     #>KeywordTbl
00069Ar 2  85 62                sta     BAS_KWPTR+1
00069Cr 2  A0 00                ldy     #0
00069Er 2               @FindLoop:
00069Er 2  E0 00                cpx     #0
0006A0r 2  F0 0F                beq     @PrintIt
0006A2r 2                       ; Skip current keyword: walk byte-by-byte until we consume a byte
0006A2r 2                       ; whose bit 7 is set (last char of the keyword).
0006A2r 2               @Skip:
0006A2r 2  B1 61                lda     (BAS_KWPTR),y           ; Y == 0
0006A4r 2  E6 61                inc     BAS_KWPTR
0006A6r 2  D0 02                bne     @SkipNoCarry
0006A8r 2  E6 62                inc     BAS_KWPTR+1
0006AAr 2               @SkipNoCarry:
0006AAr 2  C9 80                cmp     #$80                    ; C set iff loaded byte >= $80
0006ACr 2  90 F4                bcc     @Skip
0006AEr 2               @SkipEnd:
0006AEr 2  CA                   dex
0006AFr 2  80 ED                bra     @FindLoop
0006B1r 2               @PrintIt:
0006B1r 2               @PrintLoop:
0006B1r 2  B1 61                lda     (BAS_KWPTR),y           ; Y == 0
0006B3r 2  E6 61                inc     BAS_KWPTR
0006B5r 2  D0 02                bne     @PrintNoCarry
0006B7r 2  E6 62                inc     BAS_KWPTR+1
0006B9r 2               @PrintNoCarry:
0006B9r 2  48                   pha
0006BAr 2  29 7F                and     #$7F
0006BCr 2  20 rr rr             jsr     Chrout
0006BFr 2  68                   pla
0006C0r 2  10 EF                bpl     @PrintLoop
0006C2r 2  60                   rts
0006C3r 2               
0006C3r 2               ; =============================================================================
0006C3r 2               ;   E R R O R   H A N D L I N G
0006C3r 2               ; =============================================================================
0006C3r 2               
0006C3r 2               BasErrSyntax:
0006C3r 2  A9 00                lda     #ERR_SYNTAX
0006C5r 2                       ; fall through
0006C5r 2               
0006C5r 2               ; BasError - print "?<msg> ERROR[ IN nnnn]" and return to the REPL.
0006C5r 2               ;   Input: A = error code (index into ErrorMessages).
0006C5r 2               ;   Resets the stack, prints, and jumps to BasReadyLoop.
0006C5r 2               BasError:
0006C5r 2  85 3E                sta     BAS_TMP3                ; stash code (stack reset wipes A on stack)
0006C7r 2  A2 FF                ldx     #$FF
0006C9r 2  9A                   txs
0006CAr 2  20 rr rr             jsr     BasPrintCRLF
0006CDr 2  A9 3F                lda     #'?'
0006CFr 2  20 rr rr             jsr     Chrout
0006D2r 2  A5 3E                lda     BAS_TMP3
0006D4r 2                       ; A = error code; print the matching message.
0006D4r 2  20 rr rr             jsr     BasPrintErrorMsg
0006D7r 2                       ; Append " ERROR" and (if not direct mode) line number.
0006D7r 2  A9 rr                lda     #<MsgErrorWord
0006D9r 2  A0 rr                ldy     #>MsgErrorWord
0006DBr 2  20 rr rr             jsr     BasPrintStr
0006DEr 2  AD 6A 03             lda     BAS_CURLIN+1
0006E1r 2  C9 FF                cmp     #$FF
0006E3r 2  F0 14                beq     @NoLine
0006E5r 2  A9 rr                lda     #<MsgInWord
0006E7r 2  A0 rr                ldy     #>MsgInWord
0006E9r 2  20 rr rr             jsr     BasPrintStr
0006ECr 2  AD 69 03             lda     BAS_CURLIN
0006EFr 2  85 08                sta     BAS_LINNUM
0006F1r 2  AD 6A 03             lda     BAS_CURLIN+1
0006F4r 2  85 09                sta     BAS_LINNUM+1
0006F6r 2  20 rr rr             jsr     BasPrintLineNum
0006F9r 2               @NoLine:
0006F9r 2                       ; Mark direct mode and bounce back to REPL.
0006F9r 2  A9 FF                lda     #$FF
0006FBr 2  8D 69 03             sta     BAS_CURLIN
0006FEr 2  8D 6A 03             sta     BAS_CURLIN+1
000701r 2  4C rr rr             jmp     BasReadyLoop
000704r 2               
000704r 2               ; BasPrintErrorMsg - print message #A from the error-message table.
000704r 2               ;   Each message is NUL-terminated; the table is a sequence of those.
000704r 2               BasPrintErrorMsg:
000704r 2  AA                   tax
000705r 2  A9 rr                lda     #<ErrorMessages
000707r 2  85 3A                sta     BAS_TMP1
000709r 2  A9 rr                lda     #>ErrorMessages
00070Br 2  85 3B                sta     BAS_TMP1+1
00070Dr 2               @Skip:
00070Dr 2  E0 00                cpx     #0
00070Fr 2  F0 17                beq     @Print
000711r 2                       ; Walk past one message (advance until NUL, then one more).
000711r 2               @SkipLoop:
000711r 2  A0 00                ldy     #0
000713r 2  B1 3A                lda     (BAS_TMP1),y
000715r 2  F0 08                beq     @SkipDone
000717r 2  E6 3A                inc     BAS_TMP1
000719r 2  D0 F6                bne     @SkipLoop
00071Br 2  E6 3B                inc     BAS_TMP1+1
00071Dr 2  80 F2                bra     @SkipLoop
00071Fr 2               @SkipDone:
00071Fr 2  E6 3A                inc     BAS_TMP1
000721r 2  D0 02                bne     @SkippedHi
000723r 2  E6 3B                inc     BAS_TMP1+1
000725r 2               @SkippedHi:
000725r 2  CA                   dex
000726r 2  80 E5                bra     @Skip
000728r 2               @Print:
000728r 2  A5 3A                lda     BAS_TMP1
00072Ar 2  A4 3B                ldy     BAS_TMP1+1
00072Cr 2  4C rr rr             jmp     BasPrintStr
00072Fr 2               
00072Fr 2               
00072Fr 2               ; =============================================================================
00072Fr 2               ;   F L O A T I N G - P O I N T   R U N T I M E
00072Fr 2               ;
00072Fr 2               ;   Externals required by the inlined MSBASIC FP code:
00072Fr 2               ;     ChrGet   - advance TXTPTR and load next non-space tokenized char
00072Fr 2               ;                (used by Fin; never exercised by the FP tests).
00072Fr 2               ;     BasErrorVec    - error vector; X = error code
00072Fr 2               ;     IqErr    - "?ILLEGAL QUANTITY" entry
00072Fr 2               ;     STROUT   - print NUL-terminated string at (A=lo, Y=hi)
00072Fr 2               ;     QtIn    - the literal " IN " string (used only by InPrt)
00072Fr 2               ; =============================================================================
00072Fr 2               
00072Fr 2               ; --- ChrGet / ChrGot --------------------------------------------------------
00072Fr 2               ; Real implementation (ROM, not ZP self-modifying).  Increments TXTPTR and
00072Fr 2               ; returns the next non-space byte at (TXTPTR) in A, with carry CLEAR if the
00072Fr 2               ; byte is a digit '0'-'9'.  ChrGot re-reads the current byte without
00072Fr 2               ; advancing first.  Both clobber only A and flags.
00072Fr 2               ;
00072Fr 2               ; Side effects on flags after the routine returns:
00072Fr 2               ;   Z=1  if A == $00 or A is a tokenized/keyword byte that wraps to zero
00072Fr 2               ;        (used by callers checking end-of-statement).
00072Fr 2               ;   C=0  if A is a digit ('0'-'9'); else C=1.
00072Fr 2               ;
00072Fr 2               ; Implementation matches msbasic-master/chrget.s.
00072Fr 2               ChrGet:
00072Fr 2  E6 04                inc     TXTPTR
000731r 2  D0 02                bne     ChrGot
000733r 2  E6 05                inc     TXTPTR+1
000735r 2               ChrGot:
000735r 2  B2 04                lda     (TXTPTR)
000737r 2  C9 3A                cmp     #':'
000739r 2  B0 0A                bcs     @out
00073Br 2  C9 20                cmp     #' '
