0009FEr 2               
0009FEr 2               ; ----------------------------------------------------------------------------
0009FEr 2               ; SHIFT 1,X THRU 5,X RIGHT
0009FEr 2               ; (A) = NEGATIVE OF SHIFT COUNT
0009FEr 2               ; (X) = POINTER TO BYTES TO BE SHIFTED
0009FEr 2               ;
0009FEr 2               ; RETURN WITH (Y)=0, CARRY=0, EXTENSION BITS IN A-REG
0009FEr 2               ; ----------------------------------------------------------------------------
0009FEr 2               ShiftRight1:
0009FEr 2  A2 47                ldx     #RESULT-1
000A00r 2               ShiftRight2:
