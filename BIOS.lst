0008ECr 2  86 43                stx     ARGEXTENSION
0008EEr 2  A2 16                ldx     #ARG
0008F0r 2  A5 16                lda     ARG
0008F2r 2               FAdd2:
0008F2r 2  A8                   tay
0008F3r 2  F0 CE                beq     Rts3
0008F5r 2  38                   sec
0008F6r 2  E5 0E                sbc     FAC
0008F8r 2  F0 24                beq     FAdd3
0008FAr 2  90 12                bcc     Lbl367F
0008FCr 2  84 0E                sty     FAC
0008FEr 2  A4 1B                ldy     ARGSIGN
000900r 2  84 13                sty     FACSIGN
000902r 2  49 FF                eor     #$FF
000904r 2  69 00                adc     #$00
000906r 2  A0 00                ldy     #$00
000908r 2  84 43                sty     ARGEXTENSION
00090Ar 2  A2 0E                ldx     #FAC
00090Cr 2  D0 04                bne     Lbl3683
00090Er 2               Lbl367F:
00090Er 2  A0 00                ldy     #$00
000910r 2  84 1D                sty     FACEXTENSION
000912r 2               Lbl3683:
000912r 2  C9 F9                cmp     #$F9
000914r 2  30 C7                bmi     FAdd1
000916r 2  A8                   tay
000917r 2  A5 1D                lda     FACEXTENSION
000919r 2  56 01                lsr     1,x
00091Br 2  20 rr rr             jsr     ShiftRight4
00091Er 2               FAdd3:
00091Er 2  24 1C                bit     SGNCPR
000920r 2  10 57                bpl     FAdd4
000922r 2  A0 0E                ldy     #FAC
000924r 2  E0 16                cpx     #ARG
000926r 2  F0 02                beq     Lbl369B
000928r 2  A0 16                ldy     #ARG
