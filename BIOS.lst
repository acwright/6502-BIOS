001134r 2               ; ---------------------------------------------------------------------------
001134r 2               ; SynErr / MemErr / IqErr / SubErr / Gme -- error trampolines.
001134r 2               ; The msbasic convention is "ldx #code; jmp ERROR".  Our BasError takes the
001134r 2               ; code in A, so translate; BasErrorVec (defined earlier) does that translation.
001134r 2               ; ---------------------------------------------------------------------------
001134r 2               SynErr:
001134r 2  A2 00                ldx     #ERR_SYNTAX
001136r 2  4C rr rr             jmp     BasErrorVec
001139r 2               
001139r 2               MemErr:
001139r 2  A2 02                ldx     #ERR_MEMFULL
00113Br 2  4C rr rr             jmp     BasErrorVec
00113Er 2               
00113Er 2               SubErr:
00113Er 2  A2 04                ldx     #ERR_BADSUBS
001140r 2  4C rr rr             jmp     BasErrorVec
001143r 2               
001143r 2               Gse:
001143r 2  4C rr rr             jmp     SubErr
001146r 2               
001146r 2               Gme:
001146r 2  4C rr rr             jmp     MemErr
001149r 2               
