0029D4r 2  68                   pla
0029D5r 2  85 21                sta     INDEX+1
0029D7r 2  8A                   txa
0029D8r 2  A0 00                ldy     #0
0029DAr 2  91 20                sta     (INDEX),y
0029DCr 2  60                   rts
