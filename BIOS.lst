0029BFr 2               ; WAIT addr, mask
0029BFr 2               ; As with POKE, the address must survive evaluation of the second argument,
0029BFr 2               ; which is free to trample BAS_TMP1 (FacToU16, MID$/LEFT$/RIGHT$, ...).
0029BFr 2               BasCmdWait:
0029BFr 2  20 rr rr             jsr     EvalAddrU16
0029C2r 2  A5 11                lda     FAC+3                   ; hi
0029C4r 2  48                   pha
0029C5r 2  A5 12                lda     FAC+4                   ; lo
0029C7r 2  48                   pha
0029C8r 2  20 rr rr             jsr     ChkCom
0029CBr 2  20 rr rr             jsr     GetByt                  ; X = mask
0029CEr 2  86 3C                stx     BAS_TMP2
0029D0r 2  68                   pla
