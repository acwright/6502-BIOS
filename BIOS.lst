0029C2r 2               ; POKE addr, val
0029C2r 2               ; The value expression is evaluated BEFORE the address is parked in INDEX:
0029C2r 2               ; FrmEvl clobbers every zero-page scratch pair (INDEX via LoadFacFromYa,
0029C2r 2               ; BAS_TMP1 via FacToU16 / the string functions), so the address has to ride
0029C2r 2               ; the hardware stack across the evaluation.
0029C2r 2               BasCmdPoke:
0029C2r 2  20 rr rr             jsr     EvalAddrU16
0029C5r 2  A5 11                lda     FAC+3                   ; hi
0029C7r 2  48                   pha
0029C8r 2  A5 12                lda     FAC+4                   ; lo
0029CAr 2  48                   pha
