000F2Fr 2               ; ODD Polynomial SUBROUTINE
000F2Fr 2               ;
000F2Fr 2               ; F(X) = X * P(X^2)
000F2Fr 2               ;
000F2Fr 2               ; WHERE:  X IS VALUE IN FAC
000F2Fr 2               ;	Y,A POINTS AT COEFFICIENT TABLE
000F2Fr 2               ;	FIRST BYTE OF COEFF. TABLE IS N
000F2Fr 2               ;	COEFFICIENTS FOLLOW, HIGHEST POWER FIRST
000F2Fr 2               ;
000F2Fr 2               ; P(X^2) COMPUTED USING NORMAL Polynomial SUBROUTINE
000F2Fr 2               ; ----------------------------------------------------------------------------
000F2Fr 2               PolynomialOdd:
