0011ACr 2               ;   V A R I A B L E S ,   A R R A Y S ,   S T R I N G   H E A P
0011ACr 2               ;
0011ACr 2               ;   Inline-ported from msbasic-master/{var,array,string,memory}.s and
0011ACr 2               ;   misc2.s (GivAyf/SngFlt).  All MSBASIC externals are resolved here:
0011ACr 2               ;
0011ACr 2               ;     SynErr / MemErr / IqErr / SubErr / Gme        - error trampolines
0011ACr 2               ;     ChkCom / ChkCls / ChkNum / ChkStr             - parser predicates
0011ACr 2               ;     MakInt / FrmNum / FrmEvl                      - minimal stubs (only
0011ACr 2               ;                                                     handle literal unsigned
0011ACr 2               ;                                                     decimals via Fin; full
0011ACr 2               ;                                                     evaluator wired in a
0011ACr 2               ;                                                     later phase)
0011ACr 2               ;     IsLetC                                        - ASCII letter test
0011ACr 2               ;     PtrGet / Array / GetAry                       - variable lookup
0011ACr 2               ;     StrIni / StrSpa / GetSpa / PutNew / MovStr    - string allocation
0011ACr 2               ;     Garbag (and helpers)                          - string GC
0011ACr 2               ;     Bltu / Reason                                 - block-up-move helpers
0011ACr 2               ;     AyInt / GivAyf / SngFlt                       - FP <-> 16-bit int
0011ACr 2               ;     BasCmdClr                                     - implements CLR / NEW core
0011ACr 2               ; =============================================================================
0011ACr 2               
0011ACr 2               ; ---------------------------------------------------------------------------
0011ACr 2               ; SynErr / MemErr / IqErr / SubErr / Gme -- error trampolines.
0011ACr 2               ; The msbasic convention is "ldx #code; jmp ERROR".  Our BasError takes the
0011ACr 2               ; code in A, so translate; BasErrorVec (defined earlier) does that translation.
0011ACr 2               ; ---------------------------------------------------------------------------
0011ACr 2               SynErr:
0011ACr 2  A2 00                ldx     #ERR_SYNTAX
0011AEr 2  4C rr rr             jmp     BasErrorVec
0011B1r 2               
0011B1r 2               MemErr:
0011B1r 2  A2 02                ldx     #ERR_MEMFULL
0011B3r 2  4C rr rr             jmp     BasErrorVec
0011B6r 2               
0011B6r 2               SubErr:
0011B6r 2  A2 04                ldx     #ERR_BADSUBS
0011B8r 2  4C rr rr             jmp     BasErrorVec
0011BBr 2               
0011BBr 2               Gme:
0011BBr 2  4C rr rr             jmp     MemErr
0011BEr 2               
0011BEr 2               ; ---------------------------------------------------------------------------
