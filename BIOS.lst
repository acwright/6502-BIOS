0005C4r 2               ; ============================================================================
0005C4r 2               ; MonCmdSave — Save to CF (with quoted filename) or XModem (without)
0005C4r 2               ; Syntax: S ["FILE"] ADDR1 ADDR2
0005C4r 2               ; CF path:     S "FILENAME" ADDR1 ADDR2 — save [addr1,addr2) to file
0005C4r 2               ; Serial path: S ADDR1 ADDR2            — send [addr1,addr2) via XModem
0005C4r 2               ; ============================================================================
0005C4r 2               
0005C4r 2               MonCmdSave:
0005C4r 2  20 rr rr       jsr MonSkipSpaces
0005C7r 2  A4 35          ldy MON_IDX
0005C9r 2  B9 00 04       lda MON_LINBUF,y
0005CCr 2  C9 22          cmp #'"'
0005CEr 2  D0 03          bne @SaveSerial
0005D0r 2  4C rr rr       jmp @SaveCF
0005D3r 2               
0005D3r 2                 ; --- Serial path ---
0005D3r 2                 ; --- Serial path (XModem) ---
0005D3r 2               @SaveSerial:
0005D3r 2  20 rr rr       jsr MonParseHex4              ; Parse start address
0005D6r 2  B0 03          bcs @SaveSerGotStart
0005D8r 2  4C rr rr       jmp @SaveError
0005DBr 2               @SaveSerGotStart:
0005DBr 2  A5 2E          lda MON_ADDR
0005DDr 2  85 2A          sta XFER_PTR
0005DFr 2  A5 2F          lda MON_ADDR+1
0005E1r 2  85 2B          sta XFER_PTR+1
0005E3r 2  20 rr rr       jsr MonSkipSpaces
0005E6r 2  20 rr rr       jsr MonParseHex4              ; Parse end address
0005E9r 2  B0 03          bcs @SaveSerGotEnd
0005EBr 2  4C rr rr       jmp @SaveError
0005EEr 2               @SaveSerGotEnd:
0005EEr 2                 ; Calculate size = end - start
0005EEr 2  38             sec
0005EFr 2  A5 2E          lda MON_ADDR
0005F1r 2  E5 2A          sbc XFER_PTR
0005F3r 2  8D 17 03       sta XFER_REMAIN
0005F6r 2  A5 2F          lda MON_ADDR+1
0005F8r 2  E5 2B          sbc XFER_PTR+1
0005FAr 2  8D 18 03       sta XFER_REMAIN+1
0005FDr 2                 ; Save size for message
0005FDr 2  AD 17 03       lda XFER_REMAIN
000600r 2  85 30          sta MON_END
000602r 2  AD 18 03       lda XFER_REMAIN+1
000605r 2  85 31          sta MON_END+1
000607r 2                 ; Send via XModem
000607r 2  20 rr rr       jsr XModemSave
00060Ar 2  B0 0C          bcs @SaveSerErr
00060Cr 2                 ; Print "SAVED nnnn BYTES"
00060Cr 2  A5 30          lda MON_END
00060Er 2  85 2E          sta MON_ADDR
000610r 2  A5 31          lda MON_END+1
000612r 2  85 2F          sta MON_ADDR+1
000614r 2  20 rr rr       jsr MonPrintSaved
000617r 2  60             rts
000618r 2               @SaveSerErr:
000618r 2  20 rr rr       jsr MonPrintIOErr
00061Br 2  60             rts
00061Cr 2               
00061Cr 2                 ; --- CF path ---
00061Cr 2               @SaveCF:
00061Cr 2  E6 35          inc MON_IDX                   ; Skip opening quote
00061Er 2                 ; Point STR_PTR into line buffer at the filename
00061Er 2  A4 35          ldy MON_IDX
000620r 2  98             tya
000621r 2  18             clc
000622r 2  69 00          adc #<MON_LINBUF
000624r 2  85 02          sta STR_PTR
000626r 2  A9 04          lda #>MON_LINBUF
000628r 2  69 00          adc #0
00062Ar 2  85 03          sta STR_PTR+1
00062Cr 2                 ; Find closing quote and null-terminate
00062Cr 2               @SaveCFFindQ:
00062Cr 2  B9 00 04       lda MON_LINBUF,y
00062Fr 2  F0 0D          beq @SaveCFQDone
000631r 2  C9 22          cmp #'"'
000633r 2  F0 03          beq @SaveCFGotQ
000635r 2  C8             iny
000636r 2  80 F4          bra @SaveCFFindQ
000638r 2               @SaveCFGotQ:
000638r 2  A9 00          lda #0
00063Ar 2  99 00 04       sta MON_LINBUF,y              ; Null-terminate at closing quote
00063Dr 2  C8             iny
00063Er 2               @SaveCFQDone:
00063Er 2  84 35          sty MON_IDX
000640r 2                 ; Parse filename
000640r 2  20 rr rr       jsr FsParseName
000643r 2                 ; Parse start address
000643r 2  20 rr rr       jsr MonSkipSpaces
000646r 2  20 rr rr       jsr MonParseHex4
000649r 2  B0 03          bcs @SaveCFGotStart
00064Br 2  4C rr rr       jmp @SaveError
00064Er 2               @SaveCFGotStart:
00064Er 2  A5 2E          lda MON_ADDR
000650r 2  85 32          sta MON_TMP                   ; MON_TMP = start address
000652r 2  A5 2F          lda MON_ADDR+1
000654r 2  85 33          sta MON_TMP+1
000656r 2                 ; Parse end address
000656r 2  20 rr rr       jsr MonSkipSpaces
000659r 2  20 rr rr       jsr MonParseHex4
00065Cr 2  B0 03          bcs @SaveCFGotEnd
00065Er 2  4C rr rr       jmp @SaveError
000661r 2               @SaveCFGotEnd:
000661r 2                 ; Calculate size = end - start
000661r 2  38             sec
000662r 2  A5 2E          lda MON_ADDR
000664r 2  E5 32          sbc MON_TMP
000666r 2  8D 4A 03       sta FS_FILE_SIZE
000669r 2  A5 2F          lda MON_ADDR+1
00066Br 2  E5 33          sbc MON_TMP+1
00066Dr 2  8D 4B 03       sta FS_FILE_SIZE+1
000670r 2                 ; Read directory
000670r 2  20 rr rr       jsr FsReadDir
000673r 2  90 03          bcc @SaveCFReadOk
000675r 2  4C rr rr       jmp @SaveCFIOErr
000678r 2               @SaveCFReadOk:
000678r 2                 ; Try to find existing file with same name
000678r 2  20 rr rr       jsr FsFindFile
00067Br 2  90 08          bcc @SaveCFOverwrite
00067Dr 2                 ; Not found — find a free slot
00067Dr 2  20 rr rr       jsr FsFindFree
000680r 2  90 11          bcc @SaveCFAlloc
000682r 2  4C rr rr       jmp @SaveCFDirFull
000685r 2               @SaveCFOverwrite:
000685r 2                 ; Clear old entry's flags
000685r 2  A0 0B          ldy #FS_ENTRY_FLAGS
000687r 2  A9 00          lda #$00
000689r 2  91 24          sta (CF_BUF_PTR),y
00068Br 2                 ; Find a free slot (could be the one we just freed)
00068Br 2  20 rr rr       jsr FsFindFree
00068Er 2  90 03          bcc @SaveCFAllocOk
000690r 2  4C rr rr       jmp @SaveCFDirFull
000693r 2               @SaveCFAllocOk:
000693r 2               @SaveCFAlloc:
000693r 2                 ; Save CF_BUF_PTR (points to free entry)
000693r 2  A5 24          lda CF_BUF_PTR
000695r 2  48             pha
000696r 2  A5 25          lda CF_BUF_PTR+1
000698r 2  48             pha
000699r 2                 ; Calculate next free sector
000699r 2  20 rr rr       jsr FsCalcNextSec
00069Cr 2                 ; Restore CF_BUF_PTR
00069Cr 2  68             pla
00069Dr 2  85 25          sta CF_BUF_PTR+1
00069Fr 2  68             pla
0006A0r 2  85 24          sta CF_BUF_PTR
0006A2r 2                 ; Calculate sectors needed
0006A2r 2  AD 4B 03       lda FS_FILE_SIZE+1
0006A5r 2  4A             lsr a
0006A6r 2  8D 4C 03       sta FS_SEC_COUNT
0006A9r 2  AD 4B 03       lda FS_FILE_SIZE+1
0006ACr 2  29 01          and #$01
0006AEr 2  D0 05          bne @SaveCFRound
0006B0r 2  AD 4A 03       lda FS_FILE_SIZE
0006B3r 2  F0 03          beq @SaveCFNoRound
0006B5r 2               @SaveCFRound:
0006B5r 2  EE 4C 03       inc FS_SEC_COUNT
0006B8r 2               @SaveCFNoRound:
0006B8r 2                 ; Fill in directory entry
0006B8r 2                 ; Copy filename (11 bytes)
0006B8r 2  A0 00          ldy #0
0006BAr 2               @SaveCFCopyName:
0006BAr 2  B9 50 03       lda FS_FNAME_BUF,y
0006BDr 2  91 24          sta (CF_BUF_PTR),y
0006BFr 2  C8             iny
0006C0r 2  C0 0B          cpy #11
0006C2r 2  D0 F6          bne @SaveCFCopyName
0006C4r 2                 ; Set flags = in use
0006C4r 2  A9 01          lda #FS_FLAG_USED
0006C6r 2  91 24          sta (CF_BUF_PTR),y            ; Y = 11 = FS_ENTRY_FLAGS
0006C8r 2                 ; Set start sector
0006C8r 2  A0 0C          ldy #FS_ENTRY_START
0006CAr 2  AD 4E 03       lda FS_NEXT_SEC
0006CDr 2  91 24          sta (CF_BUF_PTR),y
0006CFr 2  8D 48 03       sta FS_START_SEC
0006D2r 2  C8             iny
0006D3r 2  AD 4F 03       lda FS_NEXT_SEC+1
0006D6r 2  91 24          sta (CF_BUF_PTR),y
0006D8r 2  8D 49 03       sta FS_START_SEC+1
0006DBr 2                 ; Set file size
0006DBr 2  A0 0E          ldy #FS_ENTRY_FSIZE
0006DDr 2  AD 4A 03       lda FS_FILE_SIZE
0006E0r 2  91 24          sta (CF_BUF_PTR),y
0006E2r 2  C8             iny
0006E3r 2  AD 4B 03       lda FS_FILE_SIZE+1
0006E6r 2  91 24          sta (CF_BUF_PTR),y
0006E8r 2                 ; Clear reserved bytes
0006E8r 2  A0 10          ldy #$10
0006EAr 2  A9 00          lda #$00
0006ECr 2               @SaveCFClrRsv:
0006ECr 2  91 24          sta (CF_BUF_PTR),y
0006EEr 2  C8             iny
0006EFr 2  C0 20          cpy #FS_ENTRY_SIZE
0006F1r 2  D0 F9          bne @SaveCFClrRsv
0006F3r 2                 ; Write updated directory
0006F3r 2  20 rr rr       jsr FsWriteDir
0006F6r 2  B0 3A          bcs @SaveCFIOErr
0006F8r 2                 ; Write data sectors from user-specified start address (MON_TMP)
0006F8r 2  AD 48 03       lda FS_START_SEC
0006FBr 2  85 26          sta CF_LBA
0006FDr 2  AD 49 03       lda FS_START_SEC+1
000700r 2  85 27          sta CF_LBA+1
000702r 2  64 28          stz CF_LBA+2
000704r 2  64 29          stz CF_LBA+3
000706r 2                 ; Source = MON_TMP (start address)
000706r 2  A5 32          lda MON_TMP
000708r 2  85 24          sta CF_BUF_PTR
00070Ar 2  A5 33          lda MON_TMP+1
00070Cr 2  85 25          sta CF_BUF_PTR+1
00070Er 2  AE 4C 03       ldx FS_SEC_COUNT
000711r 2  F0 10          beq @SaveCFOk
000713r 2               @SaveCFSec:
000713r 2  DA             phx
000714r 2  20 rr rr       jsr StWriteSector             ; Writes 512 bytes, advances CF_BUF_PTR
000717r 2  B0 18          bcs @SaveCFSecErr
000719r 2  E6 26          inc CF_LBA
00071Br 2  D0 02          bne @SaveCFSecNext
00071Dr 2  E6 27          inc CF_LBA+1
00071Fr 2               @SaveCFSecNext:
00071Fr 2  FA             plx
000720r 2  CA             dex
000721r 2  D0 F0          bne @SaveCFSec
000723r 2               @SaveCFOk:
000723r 2  AD 4A 03       lda FS_FILE_SIZE
000726r 2  85 2E          sta MON_ADDR
000728r 2  AD 4B 03       lda FS_FILE_SIZE+1
00072Br 2  85 2F          sta MON_ADDR+1
00072Dr 2  20 rr rr       jsr MonPrintSaved             ; Print "SAVED nnnn BYTES"
000730r 2  60             rts
000731r 2               @SaveCFSecErr:
000731r 2  FA             plx                           ; Balance stack
000732r 2               @SaveCFIOErr:
000732r 2  20 rr rr       jsr MonPrintIOErr
000735r 2  60             rts
000736r 2               @SaveCFDirFull:
000736r 2  A2 00          ldx #0
000738r 2               @SaveCFDFLoop:
000738r 2  BD rr rr       lda MonStrDirFull,x
00073Br 2  F0 06          beq @SaveCFDFDone
00073Dr 2  20 rr rr       jsr Chrout
000740r 2  E8             inx
000741r 2  80 F5          bra @SaveCFDFLoop
000743r 2               @SaveCFDFDone:
000743r 2  20 rr rr       jsr MonPrintCRLF
000746r 2  60             rts
000747r 2               @SaveError:
000747r 2  4C rr rr       jmp MonPrintError
00074Ar 2               
00074Ar 2               ; ============================================================================
00074Ar 2               ; MonCmdM — Memory dump (hex + ASCII, 8 bytes/row)
00074Ar 2               ; Syntax: M [addr] [addr]
00074Ar 2               ; Default: 8 lines (64 bytes). Remembers position for continuation.
00074Ar 2               ; ============================================================================
00074Ar 2               
00074Ar 2               MonCmdM:
00074Ar 2  20 rr rr       jsr MonSkipSpaces
00074Dr 2  20 rr rr       jsr MonParseHex4
000750r 2  90 2A          bcc @UseDefault               ; No address given — use current MON_ADDR
000752r 2                 ; Got first address in MON_ADDR — save it
000752r 2  A5 2E          lda MON_ADDR
000754r 2  85 32          sta MON_TMP
000756r 2  A5 2F          lda MON_ADDR+1
000758r 2  85 33          sta MON_TMP+1
00075Ar 2  20 rr rr       jsr MonSkipSpaces
00075Dr 2  20 rr rr       jsr MonParseHex4
000760r 2  90 12          bcc @StartOnly
000762r 2                 ; Got second address (end) in MON_ADDR
000762r 2  A5 2E          lda MON_ADDR
000764r 2  85 30          sta MON_END
000766r 2  A5 2F          lda MON_ADDR+1
000768r 2  85 31          sta MON_END+1
00076Ar 2                 ; Restore start address
00076Ar 2  A5 32          lda MON_TMP
00076Cr 2  85 2E          sta MON_ADDR
00076Er 2  A5 33          lda MON_TMP+1
000770r 2  85 2F          sta MON_ADDR+1
000772r 2  80 15          bra @DumpRange
000774r 2               @StartOnly:
000774r 2                 ; Only start address — restore from MON_TMP
000774r 2  A5 32          lda MON_TMP
000776r 2  85 2E          sta MON_ADDR
000778r 2  A5 33          lda MON_TMP+1
00077Ar 2  85 2F          sta MON_ADDR+1
00077Cr 2               @UseDefault:
00077Cr 2                 ; Set end = start + 63 (8 lines x 8 bytes)
00077Cr 2  18             clc
00077Dr 2  A5 2E          lda MON_ADDR
00077Fr 2  69 3F          adc #63
000781r 2  85 30          sta MON_END
000783r 2  A5 2F          lda MON_ADDR+1
000785r 2  69 00          adc #0
000787r 2  85 31          sta MON_END+1
000789r 2               @DumpRange:
000789r 2  20 rr rr       jsr MonDumpLine
00078Cr 2  B0 0E          bcs @DumpDone                 ; Carry set = address wrapped past $FFFF
00078Er 2                 ; Check if MON_ADDR > MON_END
00078Er 2  A5 31          lda MON_END+1
000790r 2  C5 2F          cmp MON_ADDR+1
000792r 2  90 08          bcc @DumpDone
000794r 2  D0 F3          bne @DumpRange
000796r 2  A5 30          lda MON_END
000798r 2  C5 2E          cmp MON_ADDR
00079Ar 2  B0 ED          bcs @DumpRange
00079Cr 2               @DumpDone:
00079Cr 2  60             rts
00079Dr 2               
00079Dr 2               ; MonDumpLine — Dump 8 bytes at MON_ADDR as hex + ASCII, advance by 8
00079Dr 2               
00079Dr 2               MonDumpLine:
00079Dr 2                 ; Print ".:ADDR " (39 chars/line avoids 40-col auto-wrap + CRLF double-newline)
00079Dr 2  A9 2E          lda #'.'
00079Fr 2  20 rr rr       jsr Chrout
0007A2r 2  A9 3A          lda #':'
0007A4r 2  20 rr rr       jsr Chrout
0007A7r 2  20 rr rr       jsr MonPrintHex4
0007AAr 2  20 rr rr       jsr MonPrintSpace
0007ADr 2                 ; Print 8 hex bytes
0007ADr 2  A0 00          ldy #0
0007AFr 2               @HexLoop:
0007AFr 2  B1 2E          lda (MON_ADDR),y
0007B1r 2  5A             phy
0007B2r 2  20 rr rr       jsr MonPrintHex2
0007B5r 2  20 rr rr       jsr MonPrintSpace
0007B8r 2  7A             ply
0007B9r 2  C8             iny
0007BAr 2  C0 08          cpy #8
0007BCr 2  90 F1          bcc @HexLoop
0007BEr 2                 ; Print 8 ASCII characters (no extra space — fits 40 cols)
0007BEr 2  A0 00          ldy #0
0007C0r 2               @AsciiLoop:
0007C0r 2  B1 2E          lda (MON_ADDR),y
0007C2r 2  C9 20          cmp #$20
0007C4r 2  90 04          bcc @NotPrint
0007C6r 2  C9 7F          cmp #$7F
0007C8r 2  90 02          bcc @DoPrint
0007CAr 2               @NotPrint:
0007CAr 2  A9 2E          lda #'.'
0007CCr 2               @DoPrint:
0007CCr 2  5A             phy
0007CDr 2  20 rr rr       jsr Chrout
0007D0r 2  7A             ply
0007D1r 2  C8             iny
0007D2r 2  C0 08          cpy #8
0007D4r 2  90 EA          bcc @AsciiLoop
0007D6r 2                 ; Advance MON_ADDR by 8
0007D6r 2  18             clc
0007D7r 2  A5 2E          lda MON_ADDR
0007D9r 2  69 08          adc #8
0007DBr 2  85 2E          sta MON_ADDR
0007DDr 2  90 04          bcc @NoCarry
0007DFr 2  E6 2F          inc MON_ADDR+1
0007E1r 2  F0 05          beq @Wrapped                  ; High byte became $00 = wrapped past $FFFF
0007E3r 2               @NoCarry:
0007E3r 2  20 rr rr       jsr MonPrintCRLF
0007E6r 2  18             clc                           ; Signal no overflow
0007E7r 2  60             rts
0007E8r 2               @Wrapped:
0007E8r 2  20 rr rr       jsr MonPrintCRLF
0007EBr 2  38             sec                           ; Signal overflow
0007ECr 2  60             rts
0007EDr 2               
0007EDr 2               ; ============================================================================
0007EDr 2               ; MonCmdD — Disassemble 65C02 instructions
0007EDr 2               ; Syntax: D [addr] [addr]
0007EDr 2               ; Default: 20 lines. Remembers position for continuation.
0007EDr 2               ; ============================================================================
0007EDr 2               
0007EDr 2               MonCmdD:
0007EDr 2  20 rr rr       jsr MonSkipSpaces
0007F0r 2  20 rr rr       jsr MonParseHex4
0007F3r 2  90 2A          bcc @UseDefault
0007F5r 2                 ; Got first address
0007F5r 2  A5 2E          lda MON_ADDR
0007F7r 2  85 32          sta MON_TMP
0007F9r 2  A5 2F          lda MON_ADDR+1
0007FBr 2  85 33          sta MON_TMP+1
0007FDr 2  20 rr rr       jsr MonSkipSpaces
000800r 2  20 rr rr       jsr MonParseHex4
000803r 2  90 12          bcc @StartOnly
000805r 2                 ; Got end address
000805r 2  A5 2E          lda MON_ADDR
000807r 2  85 30          sta MON_END
000809r 2  A5 2F          lda MON_ADDR+1
00080Br 2  85 31          sta MON_END+1
00080Dr 2  A5 32          lda MON_TMP
00080Fr 2  85 2E          sta MON_ADDR
000811r 2  A5 33          lda MON_TMP+1
000813r 2  85 2F          sta MON_ADDR+1
000815r 2  80 15          bra @DisRange
000817r 2               @StartOnly:
000817r 2  A5 32          lda MON_TMP
000819r 2  85 2E          sta MON_ADDR
00081Br 2  A5 33          lda MON_TMP+1
00081Dr 2  85 2F          sta MON_ADDR+1
00081Fr 2               @UseDefault:
00081Fr 2                 ; Disassemble 20 lines
00081Fr 2  A2 14          ldx #20
000821r 2               @DisCountLoop:
000821r 2  DA             phx
000822r 2  20 rr rr       jsr DisOneLine
000825r 2  FA             plx
000826r 2  B0 17          bcs @DisDone                  ; Carry set = address wrapped past $FFFF
000828r 2  CA             dex
000829r 2  D0 F6          bne @DisCountLoop
00082Br 2  60             rts
00082Cr 2               @DisRange:
00082Cr 2  20 rr rr       jsr DisOneLine
00082Fr 2  B0 0E          bcs @DisDone                  ; Carry set = address wrapped past $FFFF
000831r 2                 ; Check if MON_ADDR > MON_END
000831r 2  A5 31          lda MON_END+1
000833r 2  C5 2F          cmp MON_ADDR+1
000835r 2  90 08          bcc @DisDone
000837r 2  D0 F3          bne @DisRange
000839r 2  A5 30          lda MON_END
00083Br 2  C5 2E          cmp MON_ADDR
