000A90r 2               ; ============================================================================
000A90r 2               ; MonShowRegs — Print saved register state
000A90r 2               ; Format: PC=xxxx A=xx X=xx Y=xx SP=xx NV-BDIZC
000A90r 2               ; ============================================================================
000A90r 2               
000A90r 2               MonShowRegs:
000A90r 2                 ; "PC="
000A90r 2  A9 50          lda #'P'
000A92r 2  20 rr rr       jsr Chrout
000A95r 2  A9 43          lda #'C'
000A97r 2  20 rr rr       jsr Chrout
000A9Ar 2  A9 3D          lda #'='
000A9Cr 2  20 rr rr       jsr Chrout
000A9Fr 2                 ; Print PC (adjusted: BRK_PC - 2)
000A9Fr 2  38             sec
000AA0r 2  AD 11 03       lda BRK_PCL
000AA3r 2  E9 02          sbc #2
000AA5r 2  85 2E          sta MON_ADDR
000AA7r 2  AD 12 03       lda BRK_PCH
000AAAr 2  E9 00          sbc #0
000AACr 2  85 2F          sta MON_ADDR + 1
000AAEr 2  20 rr rr       jsr MonPrintHex4
000AB1r 2  A9 20          lda #' '
000AB3r 2  20 rr rr       jsr Chrout
000AB6r 2               
000AB6r 2                 ; "A="
000AB6r 2  A9 41          lda #'A'
000AB8r 2  20 rr rr       jsr Chrout
000ABBr 2  A9 3D          lda #'='
000ABDr 2  20 rr rr       jsr Chrout
000AC0r 2  AD 13 03       lda BRK_A
000AC3r 2  20 rr rr       jsr MonPrintHex2
000AC6r 2  A9 20          lda #' '
000AC8r 2  20 rr rr       jsr Chrout
000ACBr 2               
000ACBr 2                 ; "X="
000ACBr 2  A9 58          lda #'X'
000ACDr 2  20 rr rr       jsr Chrout
000AD0r 2  A9 3D          lda #'='
000AD2r 2  20 rr rr       jsr Chrout
000AD5r 2  AD 14 03       lda BRK_X
000AD8r 2  20 rr rr       jsr MonPrintHex2
000ADBr 2  A9 20          lda #' '
000ADDr 2  20 rr rr       jsr Chrout
000AE0r 2               
000AE0r 2                 ; "Y="
000AE0r 2  A9 59          lda #'Y'
000AE2r 2  20 rr rr       jsr Chrout
000AE5r 2  A9 3D          lda #'='
000AE7r 2  20 rr rr       jsr Chrout
000AEAr 2  AD 15 03       lda BRK_Y
000AEDr 2  20 rr rr       jsr MonPrintHex2
000AF0r 2  A9 20          lda #' '
000AF2r 2  20 rr rr       jsr Chrout
000AF5r 2               
000AF5r 2                 ; "SP="
000AF5r 2  A9 53          lda #'S'
000AF7r 2  20 rr rr       jsr Chrout
000AFAr 2  A9 50          lda #'P'
000AFCr 2  20 rr rr       jsr Chrout
000AFFr 2  A9 3D          lda #'='
000B01r 2  20 rr rr       jsr Chrout
000B04r 2  AD 16 03       lda BRK_SP
000B07r 2  20 rr rr       jsr MonPrintHex2
000B0Ar 2  A9 20          lda #' '
000B0Cr 2  20 rr rr       jsr Chrout
000B0Fr 2               
000B0Fr 2                 ; Flags: NV-BDIZC
000B0Fr 2  AD 10 03       lda BRK_P
000B12r 2  85 34          sta MON_BYTE                  ; Save flags for bit testing
000B14r 2  A2 00          ldx #0
000B16r 2               @FlagLoop:
000B16r 2  BD rr rr       lda MonFlagChars,x
000B19r 2  F0 11          beq @FlagsDone
000B1Br 2  06 34          asl MON_BYTE                  ; Shift next flag bit into carry
000B1Dr 2  B0 04          bcs @FlagSet
000B1Fr 2  A9 2D          lda #'-'                      ; Flag clear — print dash
000B21r 2  80 03          bra @FlagPrint
000B23r 2               @FlagSet:
000B23r 2                 ; A already has the flag character
000B23r 2  BD rr rr       lda MonFlagChars,x
000B26r 2               @FlagPrint:
000B26r 2  20 rr rr       jsr Chrout
000B29r 2  E8             inx
000B2Ar 2  80 EA          bra @FlagLoop
000B2Cr 2               @FlagsDone:
000B2Cr 2  20 rr rr       jsr MonPrintCRLF
000B2Fr 2  60             rts
000B30r 2               
000B30r 2               MonFlagChars:
000B30r 2  4E 56 2D 42    .byte "NV-BDIZC", 0
000B34r 2  44 49 5A 43  
000B38r 2  00           
000B39r 2               
000B39r 2               ; ============================================================================
000B39r 2               ; Hex Parsing Utilities
000B39r 2               ; ============================================================================
000B39r 2               
000B39r 2               ; MonParseHex4 — Parse up to 4 hex digits from MON_LINBUF into MON_ADDR
000B39r 2               ; Input:  MON_IDX points to current position in MON_LINBUF
000B39r 2               ; Output: MON_ADDR/MON_ADDR+1 = parsed 16-bit value, carry set if valid
000B39r 2               ;         MON_IDX advanced past parsed digits
000B39r 2               
000B39r 2               MonParseHex4:
000B39r 2  64 2E          stz MON_ADDR
000B3Br 2  64 2F          stz MON_ADDR + 1
000B3Dr 2  A2 00          ldx #0                        ; Digit count
000B3Fr 2               @ParseLoop:
000B3Fr 2  A4 35          ldy MON_IDX
000B41r 2  B9 00 04       lda MON_LINBUF,y
000B44r 2  20 rr rr       jsr MonCharToNibble           ; Convert ASCII to 0-15, carry clear if valid
000B47r 2  B0 1B          bcs @ParseDone                ; Not a hex digit — stop
000B49r 2                 ; Shift result left 4 bits and OR in new nibble
000B49r 2  06 2E          asl MON_ADDR
000B4Br 2  26 2F          rol MON_ADDR + 1
000B4Dr 2  06 2E          asl MON_ADDR
000B4Fr 2  26 2F          rol MON_ADDR + 1
000B51r 2  06 2E          asl MON_ADDR
000B53r 2  26 2F          rol MON_ADDR + 1
000B55r 2  06 2E          asl MON_ADDR
000B57r 2  26 2F          rol MON_ADDR + 1
000B59r 2  05 2E          ora MON_ADDR
000B5Br 2  85 2E          sta MON_ADDR
000B5Dr 2  E6 35          inc MON_IDX
000B5Fr 2  E8             inx
000B60r 2  E0 04          cpx #4                        ; Max 4 digits
000B62r 2  90 DB          bcc @ParseLoop
000B64r 2               @ParseDone:
000B64r 2  E0 00          cpx #0                        ; Did we parse at least one digit?
000B66r 2  F0 02          beq @ParseFail
000B68r 2  38             sec                           ; Success
000B69r 2  60             rts
000B6Ar 2               @ParseFail:
000B6Ar 2  18             clc                           ; Failure — no digits parsed
000B6Br 2  60             rts
000B6Cr 2               
000B6Cr 2               ; MonParseHex2 — Parse up to 2 hex digits from MON_LINBUF into A
000B6Cr 2               ; Input:  MON_IDX points to current position in MON_LINBUF
000B6Cr 2               ; Output: A = parsed 8-bit value, carry set if valid
000B6Cr 2               ;         MON_IDX advanced past parsed digits
000B6Cr 2               
000B6Cr 2               MonParseHex2:
000B6Cr 2  64 34          stz MON_BYTE
000B6Er 2  A2 00          ldx #0                        ; Digit count
000B70r 2               @ParseLoop:
000B70r 2  A4 35          ldy MON_IDX
000B72r 2  B9 00 04       lda MON_LINBUF,y
000B75r 2  20 rr rr       jsr MonCharToNibble
000B78r 2  B0 13          bcs @ParseDone
000B7Ar 2  06 34          asl MON_BYTE
000B7Cr 2  06 34          asl MON_BYTE
000B7Er 2  06 34          asl MON_BYTE
000B80r 2  06 34          asl MON_BYTE
000B82r 2  05 34          ora MON_BYTE
000B84r 2  85 34          sta MON_BYTE
000B86r 2  E6 35          inc MON_IDX
000B88r 2  E8             inx
000B89r 2  E0 02          cpx #2
000B8Br 2  90 E3          bcc @ParseLoop
000B8Dr 2               @ParseDone:
000B8Dr 2  E0 00          cpx #0
000B8Fr 2  F0 04          beq @ParseFail
000B91r 2  A5 34          lda MON_BYTE
000B93r 2  38             sec
000B94r 2  60             rts
000B95r 2               @ParseFail:
000B95r 2  18             clc
000B96r 2  60             rts
000B97r 2               
000B97r 2               ; MonCharToNibble — Convert ASCII hex char in A to nibble value 0-15
000B97r 2               ; Input:  A = ASCII character
000B97r 2               ; Output: A = 0-15 if valid hex digit, carry clear
000B97r 2               ;         carry set if not a valid hex digit (A preserved)
000B97r 2               
000B97r 2               MonCharToNibble:
000B97r 2  C9 30          cmp #'0'
000B99r 2  90 23          bcc @NotHex
000B9Br 2  C9 3A          cmp #'9'+1
000B9Dr 2  90 15          bcc @IsDigit
000B9Fr 2  C9 41          cmp #'A'
000BA1r 2  90 04          bcc @CheckLower
000BA3r 2  C9 47          cmp #'F'+1
000BA5r 2  90 12          bcc @IsUpper
000BA7r 2               @CheckLower:
000BA7r 2  C9 61          cmp #'a'
000BA9r 2  90 13          bcc @NotHex
000BABr 2  C9 67          cmp #'f'+1
000BADr 2  B0 0F          bcs @NotHex
000BAFr 2                 ; Lowercase a-f
000BAFr 2  38             sec
000BB0r 2  E9 57          sbc #('a' - 10)
000BB2r 2  18             clc
000BB3r 2  60             rts
000BB4r 2               @IsDigit:
000BB4r 2  38             sec
000BB5r 2  E9 30          sbc #'0'
000BB7r 2  18             clc
000BB8r 2  60             rts
000BB9r 2               @IsUpper:
000BB9r 2  38             sec
000BBAr 2  E9 37          sbc #('A' - 10)
000BBCr 2  18             clc
000BBDr 2  60             rts
000BBEr 2               @NotHex:
000BBEr 2  38             sec
000BBFr 2  60             rts
000BC0r 2               
000BC0r 2               ; MonSkipSpaces — Advance MON_IDX past whitespace in MON_LINBUF
000BC0r 2               
000BC0r 2               MonSkipSpaces:
000BC0r 2  A4 35          ldy MON_IDX
000BC2r 2  B9 00 04       lda MON_LINBUF,y
000BC5r 2  C9 20          cmp #' '
000BC7r 2  D0 04          bne @Done
000BC9r 2  E6 35          inc MON_IDX
000BCBr 2  80 F3          bra MonSkipSpaces
000BCDr 2               @Done:
000BCDr 2  60             rts
000BCEr 2               
000BCEr 2               ; ============================================================================
000BCEr 2               ; Decimal & Binary Parsing Utilities
000BCEr 2               ; ============================================================================
000BCEr 2               
000BCEr 2               ; MonParseDec16 — Parse decimal digits from MON_LINBUF into MON_ADDR
000BCEr 2               ; Input:  MON_IDX points to current position in MON_LINBUF
000BCEr 2               ; Output: MON_ADDR = parsed 16-bit value, carry set if valid
000BCEr 2               ;         MON_IDX advanced past parsed digits
000BCEr 2               ; Modifies: A, X, Y, MON_ADDR, MON_TMP
000BCEr 2               
000BCEr 2               MonParseDec16:
000BCEr 2  64 2E          stz MON_ADDR
000BD0r 2  64 2F          stz MON_ADDR+1
000BD2r 2  A2 00          ldx #0                        ; Digit count
000BD4r 2               @DecLoop:
000BD4r 2  A4 35          ldy MON_IDX
000BD6r 2  B9 00 04       lda MON_LINBUF,y
000BD9r 2  C9 30          cmp #'0'
000BDBr 2  90 3A          bcc @DecDone
000BDDr 2  C9 3A          cmp #'9'+1
000BDFr 2  B0 36          bcs @DecDone
000BE1r 2  38             sec
000BE2r 2  E9 30          sbc #'0'                      ; A = digit 0-9
000BE4r 2  48             pha                           ; Save digit
000BE5r 2                 ; MON_ADDR = MON_ADDR * 10 + digit
000BE5r 2                 ; *10 = (*2 + *8): save *2, then *8, add
000BE5r 2  06 2E          asl MON_ADDR
000BE7r 2  26 2F          rol MON_ADDR+1
000BE9r 2  A5 2E          lda MON_ADDR
000BEBr 2  85 32          sta MON_TMP
000BEDr 2  A5 2F          lda MON_ADDR+1
000BEFr 2  85 33          sta MON_TMP+1                 ; MON_TMP = *2
000BF1r 2  06 2E          asl MON_ADDR
000BF3r 2  26 2F          rol MON_ADDR+1                ; *4
000BF5r 2  06 2E          asl MON_ADDR
000BF7r 2  26 2F          rol MON_ADDR+1                ; *8
000BF9r 2  18             clc
000BFAr 2  A5 2E          lda MON_ADDR
000BFCr 2  65 32          adc MON_TMP
000BFEr 2  85 2E          sta MON_ADDR
000C00r 2  A5 2F          lda MON_ADDR+1
000C02r 2  65 33          adc MON_TMP+1
000C04r 2  85 2F          sta MON_ADDR+1                ; *10
000C06r 2                 ; + digit
000C06r 2  68             pla
000C07r 2  18             clc
000C08r 2  65 2E          adc MON_ADDR
000C0Ar 2  85 2E          sta MON_ADDR
000C0Cr 2  90 02          bcc @DecNoCarry
000C0Er 2  E6 2F          inc MON_ADDR+1
000C10r 2               @DecNoCarry:
000C10r 2  E6 35          inc MON_IDX
000C12r 2  E8             inx
000C13r 2  E0 05          cpx #5                        ; Max 5 digits (65535)
000C15r 2  90 BD          bcc @DecLoop
000C17r 2               @DecDone:
000C17r 2  E0 00          cpx #0
000C19r 2  F0 02          beq @DecFail
000C1Br 2  38             sec                           ; Success
000C1Cr 2  60             rts
000C1Dr 2               @DecFail:
000C1Dr 2  18             clc                           ; Failure
000C1Er 2  60             rts
000C1Fr 2               
000C1Fr 2               ; MonParseBin16 — Parse binary digits from MON_LINBUF into MON_ADDR
000C1Fr 2               ; Input:  MON_IDX points to current position in MON_LINBUF
000C1Fr 2               ; Output: MON_ADDR = parsed 16-bit value, carry set if valid
000C1Fr 2               ;         MON_IDX advanced past parsed digits
000C1Fr 2               ; Modifies: A, X, Y, MON_ADDR
000C1Fr 2               
000C1Fr 2               MonParseBin16:
000C1Fr 2  64 2E          stz MON_ADDR
000C21r 2  64 2F          stz MON_ADDR+1
000C23r 2  A2 00          ldx #0                        ; Digit count
000C25r 2               @BinLoop:
000C25r 2  A4 35          ldy MON_IDX
000C27r 2  B9 00 04       lda MON_LINBUF,y
000C2Ar 2  C9 30          cmp #'0'
000C2Cr 2  F0 06          beq @BinGot
000C2Er 2  C9 31          cmp #'1'
000C30r 2  F0 02          beq @BinGot
000C32r 2  80 0F          bra @BinDone
000C34r 2               @BinGot:
000C34r 2  38             sec
000C35r 2  E9 30          sbc #'0'                      ; A = 0 or 1
000C37r 2  4A             lsr a                         ; Bit into carry
000C38r 2  26 2E          rol MON_ADDR
000C3Ar 2  26 2F          rol MON_ADDR+1
000C3Cr 2  E6 35          inc MON_IDX
000C3Er 2  E8             inx
000C3Fr 2  E0 10          cpx #16                       ; Max 16 bits
000C41r 2  90 E2          bcc @BinLoop
000C43r 2               @BinDone:
000C43r 2  E0 00          cpx #0
000C45r 2  F0 02          beq @BinFail
000C47r 2  38             sec                           ; Success
000C48r 2  60             rts
000C49r 2               @BinFail:
000C49r 2  18             clc                           ; Failure
000C4Ar 2  60             rts
000C4Br 2               
000C4Br 2               ; ============================================================================
000C4Br 2               ; Decimal & Binary Output Utilities
000C4Br 2               ; ============================================================================
000C4Br 2               
000C4Br 2               ; MonPrintDec16 — Print MON_ADDR as up to 5 decimal digits
000C4Br 2               ; Uses successive subtraction of powers of 10
000C4Br 2               ; Modifies: A, X, Y, MON_TMP, MON_BYTE
000C4Br 2               
000C4Br 2               MonPrintDec16:
000C4Br 2                 ; Copy value to MON_TMP so we don't destroy MON_ADDR
000C4Br 2  A5 2E          lda MON_ADDR
000C4Dr 2  85 32          sta MON_TMP
000C4Fr 2  A5 2F          lda MON_ADDR+1
000C51r 2  85 33          sta MON_TMP+1
000C53r 2  A2 00          ldx #0                        ; Leading zero suppression flag
000C55r 2  A0 00          ldy #0                        ; Power-of-10 index
000C57r 2               @Dec16Loop:
000C57r 2  A9 2F          lda #'0'-1
000C59r 2  85 34          sta MON_BYTE                  ; Digit scratch
000C5Br 2               @Dec16Sub:
000C5Br 2  E6 34          inc MON_BYTE
000C5Dr 2  A5 32          lda MON_TMP
000C5Fr 2  38             sec
000C60r 2  F9 rr rr       sbc @Dec16Pow10Lo,y
000C63r 2  48             pha
000C64r 2  A5 33          lda MON_TMP+1
000C66r 2  F9 rr rr       sbc @Dec16Pow10Hi,y
000C69r 2  90 07          bcc @Dec16Digit               ; Underflow — digit done
000C6Br 2  85 33          sta MON_TMP+1
000C6Dr 2  68             pla
000C6Er 2  85 32          sta MON_TMP
000C70r 2  80 E9          bra @Dec16Sub
000C72r 2               @Dec16Digit:
000C72r 2  68             pla                           ; Discard underflowed low byte
000C73r 2  A5 34          lda MON_BYTE
000C75r 2  C9 30          cmp #'0'
000C77r 2  D0 04          bne @Dec16Print               ; Non-zero → print
000C79r 2  E0 00          cpx #0
000C7Br 2  F0 08          beq @Dec16Skip                ; Leading zero → skip
000C7Dr 2               @Dec16Print:
000C7Dr 2  DA             phx
000C7Er 2  5A             phy
000C7Fr 2  20 rr rr       jsr Chrout
000C82r 2  7A             ply
000C83r 2  FA             plx
000C84r 2  E8             inx                           ; Mark we've printed a digit
000C85r 2               @Dec16Skip:
000C85r 2  C8             iny
000C86r 2  C0 04          cpy #4                        ; 4 powers: 10000, 1000, 100, 10
000C88r 2  D0 CD          bne @Dec16Loop
000C8Ar 2                 ; Always print ones digit
000C8Ar 2  A5 32          lda MON_TMP
000C8Cr 2  09 30          ora #'0'
000C8Er 2  20 rr rr       jsr Chrout
000C91r 2  60             rts
000C92r 2  10 E8 64 0A  @Dec16Pow10Lo: .byte <10000, <1000, <100, <10
000C96r 2  27 03 00 00  @Dec16Pow10Hi: .byte >10000, >1000, >100, >10
000C9Ar 2               
000C9Ar 2               ; MonPrintBin16 — Print MON_ADDR as 16 binary digits (MSB first)
000C9Ar 2               ; Modifies: A, X
000C9Ar 2               
000C9Ar 2               MonPrintBin16:
000C9Ar 2  A5 2F          lda MON_ADDR+1                ; High byte first
000C9Cr 2  20 rr rr       jsr @PrintBin8
000C9Fr 2  A5 2E          lda MON_ADDR                  ; Then low byte
000CA1r 2               @PrintBin8:
000CA1r 2  A2 08          ldx #8
000CA3r 2               @BinBitLoop:
000CA3r 2  0A             asl a                         ; Shift MSB into carry
000CA4r 2  48             pha
000CA5r 2  A9 30          lda #'0'
000CA7r 2  69 00          adc #0                        ; +1 if carry → '1'
000CA9r 2  20 rr rr       jsr Chrout
000CACr 2  68             pla
000CADr 2  CA             dex
000CAEr 2  D0 F3          bne @BinBitLoop
000CB0r 2  60             rts
000CB1r 2               
000CB1r 2               ; ============================================================================
000CB1r 2               ; Message Print Helpers (Phase 5)
000CB1r 2               ; ============================================================================
000CB1r 2               
000CB1r 2               ; MonPrintLoaded — Print "LOADED nnnn BYTES AT $xxxx"
000CB1r 2               ; Input: MON_ADDR = byte count, MON_END = load address
000CB1r 2               ; Modifies: A, X, Y, MON_TMP, MON_BYTE
000CB1r 2               
000CB1r 2               MonPrintLoaded:
000CB1r 2  A2 00          ldx #0
000CB3r 2               @PLoop1:
000CB3r 2  BD rr rr       lda MonStrLoadPfx,x
000CB6r 2  F0 06          beq @PDone1
000CB8r 2  20 rr rr       jsr Chrout
000CBBr 2  E8             inx
000CBCr 2  80 F5          bra @PLoop1
000CBEr 2               @PDone1:
000CBEr 2  20 rr rr       jsr MonPrintDec16             ; Print byte count from MON_ADDR
000CC1r 2  A2 00          ldx #0
000CC3r 2               @PLoop2:
000CC3r 2  BD rr rr       lda MonStrBytesAt,x
000CC6r 2  F0 06          beq @PDone2
000CC8r 2  20 rr rr       jsr Chrout
000CCBr 2  E8             inx
000CCCr 2  80 F5          bra @PLoop2
000CCEr 2               @PDone2:
000CCEr 2                 ; Print address from MON_END
000CCEr 2  A5 30          lda MON_END
000CD0r 2  85 2E          sta MON_ADDR
000CD2r 2  A5 31          lda MON_END+1
000CD4r 2  85 2F          sta MON_ADDR+1
000CD6r 2  20 rr rr       jsr MonPrintHex4
000CD9r 2  4C rr rr       jmp MonPrintCRLF
000CDCr 2               
000CDCr 2               ; MonPrintSaved — Print "SAVED nnnn BYTES"
000CDCr 2               ; Input: MON_ADDR = byte count
000CDCr 2               ; Modifies: A, X, Y, MON_TMP, MON_BYTE
000CDCr 2               
000CDCr 2               MonPrintSaved:
000CDCr 2  A2 00          ldx #0
000CDEr 2               @SLoop1:
000CDEr 2  BD rr rr       lda MonStrSavePfx,x
000CE1r 2  F0 06          beq @SDone1
000CE3r 2  20 rr rr       jsr Chrout
000CE6r 2  E8             inx
000CE7r 2  80 F5          bra @SLoop1
000CE9r 2               @SDone1:
000CE9r 2  20 rr rr       jsr MonPrintDec16             ; Print byte count from MON_ADDR
000CECr 2  A2 00          ldx #0
000CEEr 2               @SLoop2:
000CEEr 2  BD rr rr       lda MonStrBytes,x
000CF1r 2  F0 06          beq @SDone2
000CF3r 2  20 rr rr       jsr Chrout
000CF6r 2  E8             inx
000CF7r 2  80 F5          bra @SLoop2
000CF9r 2               @SDone2:
000CF9r 2  4C rr rr       jmp MonPrintCRLF
000CFCr 2               
000CFCr 2               ; MonPrintIOErr — Print "I/O ERROR"
000CFCr 2               ; Modifies: A, X
000CFCr 2               
000CFCr 2               MonPrintIOErr:
000CFCr 2  A2 00          ldx #0
000CFEr 2               @ELoop:
000CFEr 2  BD rr rr       lda MonStrIOErr,x
000D01r 2  F0 06          beq @EDone
000D03r 2  20 rr rr       jsr Chrout
000D06r 2  E8             inx
000D07r 2  80 F5          bra @ELoop
000D09r 2               @EDone:
000D09r 2  4C rr rr       jmp MonPrintCRLF
000D0Cr 2               
000D0Cr 2               ; ============================================================================
000D0Cr 2               ; Hex Output Utilities
000D0Cr 2               ; ============================================================================
000D0Cr 2               
000D0Cr 2               ; MonPrintHex2 — Print A as two hex digits
000D0Cr 2               ; Input:  A = byte to print
000D0Cr 2               ; Modifies: A, flags
000D0Cr 2               
000D0Cr 2               MonPrintHex2:
000D0Cr 2  48             pha                           ; Save original byte
000D0Dr 2  4A             lsr                           ; Shift high nibble down
000D0Er 2  4A             lsr
000D0Fr 2  4A             lsr
000D10r 2  4A             lsr
000D11r 2  20 rr rr       jsr @PrintNibble              ; Print high nibble
000D14r 2  68             pla                           ; Restore original byte
000D15r 2  29 0F          and #$0F                      ; Isolate low nibble
000D17r 2               @PrintNibble:
000D17r 2  C9 0A          cmp #10
000D19r 2  90 06          bcc @IsDigit
000D1Br 2  18             clc
000D1Cr 2  69 37          adc #('A' - 10)
000D1Er 2  4C rr rr       jmp Chrout
000D21r 2               @IsDigit:
000D21r 2  18             clc
000D22r 2  69 30          adc #'0'
000D24r 2  4C rr rr       jmp Chrout
000D27r 2               
000D27r 2               ; MonPrintHex4 — Print MON_ADDR as four hex digits
000D27r 2               ; Input:  MON_ADDR, MON_ADDR+1 = 16-bit value
000D27r 2               ; Modifies: A, flags
000D27r 2               
000D27r 2               MonPrintHex4:
000D27r 2  A5 2F          lda MON_ADDR + 1              ; High byte first
000D29r 2  20 rr rr       jsr MonPrintHex2
000D2Cr 2  A5 2E          lda MON_ADDR                  ; Then low byte
000D2Er 2  4C rr rr       jmp MonPrintHex2
000D31r 2               
000D31r 2               ; MonPrintSpace — Print a space character
000D31r 2               
000D31r 2               MonPrintSpace:
000D31r 2  A9 20          lda #' '
000D33r 2  4C rr rr       jmp Chrout
000D36r 2               
000D36r 2               ; MonPrintCRLF — Print carriage return + line feed
000D36r 2               
000D36r 2               MonPrintCRLF:
000D36r 2  A9 0D          lda #$0D
000D38r 2  20 rr rr       jsr Chrout
000D3Br 2  A9 0A          lda #$0A
000D3Dr 2  4C rr rr       jmp Chrout
000D40r 2               
000D40r 2               ; MonPrintError — Print "?" for unrecognized command
000D40r 2               
000D40r 2               MonPrintError:
000D40r 2  A9 3F          lda #'?'
000D42r 2  20 rr rr       jsr Chrout
000D45r 2  4C rr rr       jmp MonPrintCRLF
000D48r 2               
000D48r 2               ; MonPrintBanner — Print the monitor banner string
000D48r 2               
000D48r 2               MonPrintBanner:
000D48r 2  A2 00          ldx #0
000D4Ar 2               @Loop:
000D4Ar 2  BD rr rr       lda MonStrBanner,x
000D4Dr 2  F0 06          beq @Done
000D4Fr 2  20 rr rr       jsr Chrout
000D52r 2  E8             inx
000D53r 2  80 F5          bra @Loop
000D55r 2               @Done:
000D55r 2  60             rts
000D56r 2               
000D56r 2               ; ============================================================================
000D56r 2               ; String Data
000D56r 2               ; ============================================================================
000D56r 2               
000D56r 2               MonStrBanner:
000D56r 2  36 35 30 32    .byte "6502 MONITOR v1.1", $0D, $0A, 0
000D5Ar 2  20 4D 4F 4E  
000D5Er 2  49 54 4F 52  
000D6Ar 2               MonStrBrk:
000D6Ar 2  42 52 4B 20    .byte "BRK AT $", 0
000D6Er 2  41 54 20 24  
000D72r 2  00           
000D73r 2               MonStrNotFound:
000D73r 2  46 49 4C 45    .byte "FILE NOT FOUND", 0
000D77r 2  20 4E 4F 54  
000D7Br 2  20 46 4F 55  
000D82r 2               MonStrDirFull:
000D82r 2  44 49 52 45    .byte "DIRECTORY FULL", 0
000D86r 2  43 54 4F 52  
000D8Ar 2  59 20 46 55  
000D91r 2               MonStrLoadPfx:
000D91r 2  4C 4F 41 44    .byte "LOADED ", 0
000D95r 2  45 44 20 00  
000D99r 2               MonStrSavePfx:
000D99r 2  53 41 56 45    .byte "SAVED ", 0
000D9Dr 2  44 20 00     
000DA0r 2               MonStrBytesAt:
000DA0r 2  20 42 59 54    .byte " BYTES AT $", 0
000DA4r 2  45 53 20 41  
000DA8r 2  54 20 24 00  
000DACr 2               MonStrBytes:
000DACr 2  20 42 59 54    .byte " BYTES", 0
000DB0r 2  45 53 00     
000DB3r 2               MonStrIOErr:
000DB3r 2  49 2F 4F 20    .byte "I/O ERROR", 0
000DB7r 2  45 52 52 4F  
000DBBr 2  52 00        
