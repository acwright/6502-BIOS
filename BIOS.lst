002F43r 2               ;   K E Y W O R D   T A B L E
002F43r 2               ;
002F43r 2               ;   Each keyword is its ASCII characters; the LAST byte has bit 7 set.
002F43r 2               ;   Order MUST match TOK_xxx equates above (token = TOK_BASE + index).
002F43r 2               ;   A trailing $00 terminates the table.
002F43r 2               ; =============================================================================
