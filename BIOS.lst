001100r 2               ; ---------------------------------------------------------------------------
001100r 2               ; SynErr / MemErr / IqErr / SubErr / Gme -- error trampolines.
001100r 2               ; The msbasic convention is "ldx #code; jmp ERROR".  Our BasError takes the
001100r 2               ; code in A, so translate; BasErrorVec (defined earlier) does that translation.
001100r 2               ; ---------------------------------------------------------------------------
001100r 2               SynErr:
001100r 2  A2 00                ldx     #ERR_SYNTAX
001102r 2  4C rr rr             jmp     BasErrorVec
001105r 2               
001105r 2               MemErr:
001105r 2  A2 02                ldx     #ERR_MEMFULL
001107r 2  4C rr rr             jmp     BasErrorVec
00110Ar 2               
00110Ar 2               SubErr:
00110Ar 2  A2 04                ldx     #ERR_BADSUBS
00110Cr 2  4C rr rr             jmp     BasErrorVec
00110Fr 2               
00110Fr 2               Gse:
00110Fr 2  4C rr rr             jmp     SubErr
001112r 2               
001112r 2               Gme:
001112r 2  4C rr rr             jmp     MemErr
001115r 2               
