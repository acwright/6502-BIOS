002A1Br 2               @bare:
002A1Br 2  A9 10                lda     #HW_SC
002A1Dr 2  20 rr rr             jsr     ReqHw
002A20r 2  A9 00                lda     #<PROGRAM_START
002A22r 2  85 2A                sta     XFER_PTR
002A24r 2  A9 08                lda     #>PROGRAM_START
002A26r 2  85 2B                sta     XFER_PTR+1
002A28r 2  38                   sec
002A29r 2  AD 5F 03             lda     BAS_VARTAB
002A2Cr 2  E9 00                sbc     #<PROGRAM_START
002A2Er 2  8D 17 03             sta     XFER_REMAIN
002A31r 2  AD 60 03             lda     BAS_VARTAB+1
002A34r 2  E9 08                sbc     #>PROGRAM_START
002A36r 2  8D 18 03             sta     XFER_REMAIN+1
002A39r 2  4C rr rr             jmp     XModemSave
002A3Cr 2               @cf:
002A3Cr 2  A9 08                lda     #HW_CF
002A3Er 2  20 rr rr             jsr     ReqHw
002A41r 2  20 rr rr             jsr     EvalString
002A44r 2  38                   sec
002A45r 2  AD 5F 03             lda     BAS_VARTAB
002A48r 2  E9 00                sbc     #<PROGRAM_START
002A4Ar 2  8D 4A 03             sta     FS_FILE_SIZE
002A4Dr 2  AD 60 03             lda     BAS_VARTAB+1
002A50r 2  E9 08                sbc     #>PROGRAM_START
002A52r 2  8D 4B 03             sta     FS_FILE_SIZE+1
002A55r 2  20 rr rr             jsr     FsSaveFile
002A58r 2  B0 01                bcs     @err
002A5Ar 2  60                   rts
002A5Br 2               @err:
002A5Br 2  A9 rr                lda     #<MsgSaveErr
