00296Fr 2               
00296Fr 2               ; WAIT addr, mask
00296Fr 2               BasCmdWait:
00296Fr 2  20 rr rr             jsr     EvalAddrU16
002972r 2  A5 12                lda     FAC+4
002974r 2  85 3A                sta     BAS_TMP1
002976r 2  A5 11                lda     FAC+3
002978r 2  85 3B                sta     BAS_TMP1+1
