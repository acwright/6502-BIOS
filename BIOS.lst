000800r 2               
000800r 1               .segment "BASIC"
000000r 1               .include "BASIC.asm"
000000r 2               ; =============================================================================
000000r 2               ; BASIC v2.0  —  5-Byte Floating-Point MSBASIC-Compatible Interpreter
000000r 2               ;                for AC6502 Homebrew Computer
000000r 2               ;
000000r 2               ;   ROM Region  :  $C000-$EDFF  (11,776 bytes / $2E00)
000000r 2               ;   Segment     :  BASIC
000000r 2               ;   Entry point :  BasEntry  (first byte of segment = $C000)
000000r 2               ;   Assembler   :  ca65  (cc65 toolchain)
000000r 2               ;   Linker cfg  :  BIOS.cfg
000000r 2               ;
000000r 2               ;   Coding style :  Match the rest of the BIOS project.
000000r 2               ;                   * Routine / data labels : PascalCase  (e.g. BasEntry,
000000r 2               ;                     FAdd, NormalizeFac1, Lbl367F).
000000r 2               ;                   * Constants / equates    : UPPER_SNAKE_CASE
000000r 2               ;                     (e.g. BAS_TXTPTR, TOK_PRINT, ERR_SYNTAX).
000000r 2               ;                   * Local labels           : @camelCase or @PascalCase.
000000r 2               ;                   * Opcodes are lowercase.
000000r 2               ;
000000r 2               ;   Reference source tree:  msbasic-master/  (read-only; NOT linked).
000000r 2               ; =============================================================================
000000r 2               
000000r 2                       .segment "BASIC"
000000r 2               
000000r 2                       .macpack longbranch     ; jeq/jne/etc. used by ported MSBASIC FP code
000000r 3               .macro  jeq     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                       bne     *+5
000000r 3                       jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               beq     Target
000000r 3                       .else
000000r 3                               bne     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jne     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               beq     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bne     Target
000000r 3                       .else
000000r 3                               beq     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jmi     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bpl     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bmi     Target
000000r 3                       .else
000000r 3                               bpl     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jpl     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bmi     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bpl     Target
000000r 3                       .else
000000r 3                               bmi     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jcs     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bcc     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bcs     Target
000000r 3                       .else
000000r 3                               bcc     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jcc     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bcs     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bcc     Target
000000r 3                       .else
000000r 3                               bcs     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jvs     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bvc     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bvs     Target
000000r 3                       .else
000000r 3                               bvc     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jvc     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bvs     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bvc     Target
000000r 3                       .else
000000r 3                               bvs     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   Z E R O - P A G E   E Q U A T E S
000000r 2               ;
000000r 2               ;   $00-$03   Kernal reserved
000000r 2               ;   $04-$23   BASIC primary workspace
000000r 2               ;   $24-$39   Kernal reserved
000000r 2               ;   $3A-$FF   BASIC spill (FP scratch in later phases)
000000r 2               ; =============================================================================
000000r 2               
000000r 2               BAS_TXTPTR      := $04          ; $04-$05  ChrGet / parse pointer
000000r 2               BAS_CURLINE     := $06          ; $06-$07  Pointer to current executing line
000000r 2               BAS_LINNUM      := $08          ; $08-$09  Parsed line number / scratch (= LINNUM)
000000r 2               
000000r 2               ; ----- Floating-point primary block ($0A-$1B, contiguous) -------------------
000000r 2               ; The MSBASIC float code accesses these via ZP,X with one label as the
000000r 2               ; immediate base (e.g. EXPSGN,X / SHIFTSIGNEXT,X / TMPEXP,X), so this entire
000000r 2               ; block MUST stay contiguous in this exact order.  See msbasic-master/
000000r 2               ; zeropage.s for the reference layout.
000000r 2               BAS_TMPEXP      := $0A          ; $0A      TMPEXP / INDX (alias)
000000r 2               BAS_INDX        := $0A          ; $0A      (alias of TMPEXP per msbasic SMALL)
000000r 2               BAS_EXPON       := $0B          ; $0B      EXPON
000000r 2               BAS_LOWTR       := $0C          ; $0C      LOWTR
000000r 2               BAS_EXPSGN      := $0D          ; $0D      EXPSGN  (== FAC-1 scratch byte)
000000r 2               BAS_FAC         := $0E          ; $0E-$12  FAC  (5 bytes)
000000r 2               BAS_FACSIGN     := $13          ; $13      FACSIGN  (== FAC+5)
000000r 2               BAS_SERLEN      := $14          ; $14      SERLEN
000000r 2               BAS_SHIFTSGN    := $15          ; $15      SHIFTSIGNEXT (== ARG-1 scratch)
000000r 2               BAS_ARG         := $16          ; $16-$1A  ARG  (5 bytes)
000000r 2               BAS_ARGSIGN     := $1B          ; $1B      ARGSIGN  (== ARG+5)
000000r 2               ; ----------------------------------------------------------------------------
000000r 2               
000000r 2               BAS_STRNG1      := $1C          ; $1C-$1D  STRNG1 (= SGNCPR; +1 = FACEXTENSION)
000000r 2               BAS_STRNG2      := $1E          ; $1E-$1F  STRNG2
000000r 2               
000000r 2               BAS_INDEX       := $20          ; $20-$21  General index pointer (line walk + msbasic INDEX)
000000r 2               BAS_DEST        := $22          ; $22-$23  Destination pointer (msbasic DEST)
000000r 2               
000000r 2               ; ----- Spill area: $3A-$67 --------------------------------------------------
000000r 2               BAS_TMP1        := $3A          ; $3A-$3B  General-purpose 16-bit pointer
000000r 2               BAS_TMP2        := $3C          ; $3C-$3D  General-purpose 16-bit pointer
000000r 2               BAS_TMP3        := $3E          ; $3E      Spill scratch byte
000000r 2               BAS_VARPNT      := $3F          ; $3F-$40  Current variable address
000000r 2               BAS_QUOTEFLG    := $41          ; $41      Tokenizer quote-state
000000r 2               BAS_DETOKY      := $42          ; $42      Saved Y across detokenize calls
000000r 2               
000000r 2               ; FP-only scratch registers (single bytes unless noted)
000000r 2               BAS_ARGEXT      := $43          ; ARGEXTENSION
000000r 2               BAS_CHARAC      := $44          ; CHARAC (string-quote/end char tracker)
000000r 2               BAS_CPRMASK     := $45          ; CPRMASK (FComp result mask)
000000r 2               BAS_FORPNT      := $46          ; $46-$47  FORPNT
000000r 2               BAS_RESULT      := $48          ; $48-$4C  RESULT  (5-byte FMult accumulator)
000000r 2               BAS_TEMP1       := $4D          ; $4D-$51  TEMP1  (5-byte FP scratch)
000000r 2               BAS_TEMP2       := $52          ; $52-$56  TEMP2  (5-byte FP scratch)
000000r 2               BAS_TEMP3       := $57          ; $57-$5B  TEMP3  (5-byte FP scratch)
000000r 2               BAS_RNDSEED     := $5C          ; $5C-$60  RNDSEED (5-byte FP value)
000000r 2               BAS_KWPTR       := $61          ; $61-$62  Keyword-table walker pointer
000000r 2               
000000r 2               ; ----- Variable / array / string-heap workspace ($63-$85) -----------------
000000r 2               BAS_DIMFLG      := $63          ; DIM-mode flag (nonzero = called from DIM)
000000r 2               BAS_VALTYP      := $64          ; $64-$65  Value type ($00=numeric, $FF=string)
000000r 2               BAS_EOLPNTR     := $66          ; Array scratch: dim count / pointer
000000r 2               BAS_DATAFLG     := $67          ; GetSpa: GC retry flag
000000r 2               BAS_SUBFLG      := $68          ; PtrGet: $40 from GETARYPT, $80 from DEF FN
000000r 2               BAS_INPUTFLG    := $69          ; INPUT/READ flag
000000r 2               BAS_ENDCHR      := $6A          ; StrLt2 secondary terminator
000000r 2               BAS_TEMPPT      := $6B          ; Top-of-temp-string-stack pointer
000000r 2               BAS_LASTPT      := $6C          ; $6C-$6D  Last temp descriptor allocated
000000r 2               BAS_TEMPST      := $6E          ; $6E-$76  Temp descriptor stack (3 * 3 bytes)
000000r 2               BAS_HIGHDS      := $77          ; $77-$78  Bltu dest end+1
000000r 2               BAS_HIGHTR      := $79          ; $79-$7A  Bltu source end+1
000000r 2               BAS_VARNAM      := $7B          ; $7B-$7C  Variable name pair (with type bits)
000000r 2               BAS_DSCPTR      := $7D          ; $7D-$7E  String descriptor pointer
000000r 2               BAS_DSCLEN      := $7F          ; $7F-$80  String descriptor length / GC scratch
000000r 2               BAS_FNCNAM      := $81          ; $81-$82  GC: highest-string descriptor ptr
000000r 2               BAS_Z52         := $83          ; GC scratch byte
000000r 2               BAS_FRESPC      := $84          ; $84-$85  Free-string-space pointer
000000r 2               ; ----------------------------------------------------------------------------
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; Symbol aliases used by the inlined MSBASIC FP code.  These let the ported
000000r 2               ; routines keep their original names without a global rename pass.
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               FAC             := BAS_FAC
000000r 2               FAC_LAST        := BAS_FAC + 4
000000r 2               FACSIGN         := BAS_FACSIGN
000000r 2               ARG             := BAS_ARG
000000r 2               ARG_LAST        := BAS_ARG + 4
000000r 2               ARGSIGN         := BAS_ARGSIGN
000000r 2               INDEX           := BAS_INDEX
000000r 2               DEST            := BAS_DEST
000000r 2               STRNG1          := BAS_STRNG1
000000r 2               STRNG2          := BAS_STRNG2
000000r 2               SGNCPR          := BAS_STRNG1            ; aliased as in msbasic zeropage.s
000000r 2               FACEXTENSION    := BAS_STRNG1 + 1        ; aliased as in msbasic zeropage.s
000000r 2               TXTPTR          := BAS_TXTPTR
000000r 2               LINNUM          := BAS_LINNUM
000000r 2               CURLIN          := BAS_CURLIN            ; non-ZP ($0369) — only used by InPrt
000000r 2               VARPNT          := BAS_VARPNT
000000r 2               ARGEXTENSION    := BAS_ARGEXT
000000r 2               EXPON           := BAS_EXPON
000000r 2               EXPSGN          := BAS_EXPSGN
000000r 2               LOWTR           := BAS_LOWTR
000000r 2               INDX            := BAS_INDX
000000r 2               TMPEXP          := BAS_TMPEXP
000000r 2               SERLEN          := BAS_SERLEN
000000r 2               SHIFTSIGNEXT    := BAS_SHIFTSGN
000000r 2               CHARAC          := BAS_CHARAC
000000r 2               CPRMASK         := BAS_CPRMASK
000000r 2               FORPNT          := BAS_FORPNT
000000r 2               RESULT          := BAS_RESULT
000000r 2               RESULT_LAST     := BAS_RESULT + 4
000000r 2               TEMP1           := BAS_TEMP1
000000r 2               TEMP2           := BAS_TEMP2
000000r 2               TEMP3           := BAS_TEMP3
000000r 2               RNDSEED         := BAS_RNDSEED
000000r 2               
000000r 2               ; ----- Aliases used by ported msbasic var/array/string code ----------------
000000r 2               DIMFLG          := BAS_DIMFLG
000000r 2               VALTYP          := BAS_VALTYP
000000r 2               EOLPNTR         := BAS_EOLPNTR
000000r 2               DATAFLG         := BAS_DATAFLG
000000r 2               SUBFLG          := BAS_SUBFLG
000000r 2               INPUTFLG        := BAS_INPUTFLG
000000r 2               ENDCHR          := BAS_ENDCHR
000000r 2               TEMPPT          := BAS_TEMPPT
000000r 2               LASTPT          := BAS_LASTPT
000000r 2               TEMPST          := BAS_TEMPST
000000r 2               HIGHDS          := BAS_HIGHDS
000000r 2               HIGHTR          := BAS_HIGHTR
000000r 2               VARNAM          := BAS_VARNAM
000000r 2               DSCPTR          := BAS_DSCPTR
000000r 2               DSCLEN          := BAS_DSCLEN
000000r 2               FNCNAM          := BAS_FNCNAM
000000r 2               Z52             := BAS_Z52
000000r 2               FRESPC          := BAS_FRESPC
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; Constants required by the ported FP code.
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               BYTES_FP        = 5
000000r 2               MANTISSA_BYTES  = 4
000000r 2               MAX_EXPON       = 10
000000r 2               STACK2          = $0100             ; Fout output buffer base (bottom of stack page)
000000r 2               
000000r 2               ; Variable / array layout constants (CONFIG_2 / CBM2-class equivalents).
000000r 2               BYTES_PER_VARIABLE = 7              ; 2 name + 5 value (numeric or descriptor)
000000r 2               BYTES_PER_ELEMENT  = 5              ; numeric array element size
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; Aliases for the runtime pointers that live in $035D+ (defined in BIOS.inc).
000000r 2               ; The msbasic var/array/string code references them by these short names.
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               TXTTAB          := BAS_TXTTAB
000000r 2               VARTAB          := BAS_VARTAB
000000r 2               ARYTAB          := BAS_ARYTAB
000000r 2               STREND          := BAS_STREND
000000r 2               FRETOP          := BAS_FRETOP
000000r 2               MEMSIZ          := BAS_MEMSIZ
000000r 2               
000000r 2               ; ERR_OVERFLOW / ERR_DIVZERO already defined below; alias zerodiv:
000000r 2               ERR_ZERODIV     = 6                 ; matches ERR_DIVZERO
000000r 2               
000000r 2               ; Fin parses these as numeric-prefix tokens.  Final token assignments are
000000r 2               ; wired up when the expression evaluator goes live; until then $00 is fine
000000r 2               ; (will not appear in tokenised input).
000000r 2               TOKEN_PLUS      = $00
000000r 2               TOKEN_MINUS     = $00
000000r 2               
000000r 2               ; Rnd(0) source: 6 stable but variable bytes from kernel vars (IRQ_PTR/BRK_PTR
000000r 2               ; etc.).  Just needs to exist — used only when Rnd is called with arg 0.
000000r 2               ENTROPY         = $0300
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   R A M   L A Y O U T   ( B A S I C   W O R K S P A C E )
000000r 2               ;
000000r 2               ;   $0400-$04FF   Input line buffer (256 bytes)
000000r 2               ;   $0500-$05FF   Tokenized line scratch (256 bytes)
000000r 2               ;
000000r 2               ;   GOSUB / FOR stacks live elsewhere; $0500-$05FF doubles as the
000000r 2               ;   tokenization scratch buffer.  $0600-$07FF overlaps FS_SECTOR_BUF and
000000r 2               ;   is left untouched here.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               BAS_LINBUF      := $0400        ; Raw input line  (NUL-terminated)
000000r 2               BAS_TOKBUF      := $0500        ; Tokenized scratch buffer (NUL-terminated)
000000r 2               
000000r 2               BAS_LINBUF_MAX  = 200           ; Max accepted input length (bytes)
000000r 2               BAS_TOKBUF_MAX  = 250           ; Max tokenized payload bytes
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   P R O G R A M   S T O R A G E
000000r 2               ;
000000r 2               ;   Lines at $0800+ : [next-lo][next-hi][num-lo][num-hi][tokens...][$00]
000000r 2               ;   End-of-program  : a "next-pointer" of $0000.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               BAS_PRG_START   = $0800
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   T O K E N   E Q U A T E S
000000r 2               ;
000000r 2               ;   Tokens are assigned sequentially starting at $80.  KEEP THE TABLE BELOW
000000r 2               ;   IN SYNC WITH THESE EQUATES.  If you reorder or insert keywords, renumber.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               TOK_BASE        = $80
000000r 2               
000000r 2               TOK_END         = $80
000000r 2               TOK_FOR         = $81
000000r 2               TOK_NEXT        = $82
000000r 2               TOK_DATA        = $83
000000r 2               TOK_INPUT       = $84
000000r 2               TOK_DIM         = $85
000000r 2               TOK_READ        = $86
000000r 2               TOK_LET         = $87
000000r 2               TOK_GOTO        = $88
000000r 2               TOK_RUN         = $89
000000r 2               TOK_IF          = $8A
000000r 2               TOK_RESTORE     = $8B
000000r 2               TOK_GOSUB       = $8C
000000r 2               TOK_RETURN      = $8D
000000r 2               TOK_REM         = $8E
000000r 2               TOK_STOP        = $8F
000000r 2               TOK_ON          = $90
000000r 2               TOK_WAIT        = $91
000000r 2               TOK_LOAD        = $92
000000r 2               TOK_SAVE        = $93
000000r 2               TOK_DEF         = $94
000000r 2               TOK_POKE        = $95
000000r 2               TOK_PRINT       = $96
000000r 2               TOK_CONT        = $97
000000r 2               TOK_LIST        = $98
000000r 2               TOK_CLR         = $99
000000r 2               TOK_NEW         = $9A
000000r 2               TOK_TAB         = $9B
000000r 2               TOK_TO          = $9C
000000r 2               TOK_FN          = $9D
000000r 2               TOK_SPC         = $9E
000000r 2               TOK_THEN        = $9F
000000r 2               TOK_NOT         = $A0
000000r 2               TOK_STEP        = $A1
000000r 2               TOK_AND         = $A2
000000r 2               TOK_OR          = $A3
000000r 2               TOK_ELSE        = $A4
000000r 2               TOK_SYS         = $A5
000000r 2               TOK_DIR         = $A6
000000r 2               TOK_DEL         = $A7
000000r 2               TOK_CLS         = $A8
000000r 2               TOK_LOCATE      = $A9
000000r 2               TOK_COLOR       = $AA
000000r 2               TOK_SOUND       = $AB
000000r 2               TOK_VOL         = $AC
000000r 2               TOK_TIME        = $AD
000000r 2               TOK_DATE        = $AE
000000r 2               TOK_SETTIME     = $AF
000000r 2               TOK_SETDATE     = $B0
000000r 2               TOK_NVRAM       = $B1
000000r 2               TOK_PAUSE       = $B2
000000r 2               TOK_BANK        = $B3
000000r 2               TOK_SCREEN      = $B4           ; BRK in 1.x
000000r 2               TOK_MEM         = $B5
000000r 2               TOK_SGN         = $B6
000000r 2               TOK_INT         = $B7
000000r 2               TOK_ABS         = $B8
000000r 2               TOK_FRE         = $B9
000000r 2               TOK_POS         = $BA
000000r 2               TOK_SQR         = $BB
000000r 2               TOK_RND         = $BC
000000r 2               TOK_LOG         = $BD
000000r 2               TOK_EXP         = $BE
000000r 2               TOK_COS         = $BF
000000r 2               TOK_SIN         = $C0
000000r 2               TOK_TAN         = $C1
000000r 2               TOK_ATN         = $C2
000000r 2               TOK_PEEK        = $C3
000000r 2               TOK_LEN         = $C4
000000r 2               TOK_STRSTR      = $C5           ; STR$
000000r 2               TOK_VAL         = $C6
000000r 2               TOK_ASC         = $C7
000000r 2               TOK_CHRSTR      = $C8           ; CHR$
000000r 2               TOK_LEFTSTR     = $C9           ; LEFT$
000000r 2               TOK_RIGHTSTR    = $CA           ; RIGHT$
000000r 2               TOK_MIDSTR      = $CB           ; MID$
000000r 2               TOK_JOY         = $CC
000000r 2               TOK_INKEY       = $CD
000000r 2               TOK_HEX         = $CE
000000r 2               TOK_MIN         = $CF
000000r 2               TOK_MAX         = $D0
000000r 2               TOK_DISK        = $D1           ; select current CF disk bank
000000r 2               TOK_BLOAD       = $D2           ; binary load to address
000000r 2               TOK_BSAVE       = $D3           ; binary save from address
000000r 2               TOK_FORMAT      = $D4           ; erase current disk directory
000000r 2               ; 2.0: the PICOVDP and the save slots.  Statements run on from FORMAT, so one
000000r 2               ; BasExtAddrTbl covers $D1-$DF; the functions follow them.
000000r 2               TOK_VPOKE       = $D5
000000r 2               TOK_VREG        = $D6
000000r 2               TOK_PALETTE     = $D7
000000r 2               TOK_VSYNC       = $D8
000000r 2               TOK_VLOAD       = $D9
000000r 2               TOK_SPRITE      = $DA
000000r 2               TOK_SCROLL      = $DB
000000r 2               TOK_LAYER       = $DC
000000r 2               TOK_NVSAVE      = $DD
000000r 2               TOK_NVLOAD      = $DE
000000r 2               TOK_NVERASE     = $DF
000000r 2               TOK_VPEEK       = $E0
000000r 2               TOK_VSTAT       = $E1
000000r 2               TOK_NVSTAT      = $E2
000000r 2               TOK_NVFIND      = $E3
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   E R R O R   C O D E S
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ERR_SYNTAX      = 0
000000r 2               ERR_OVERFLOW    = 1
000000r 2               ERR_OUTOFMEM    = 2
000000r 2               ERR_UNDEFSTMT   = 3
000000r 2               ERR_BADSUBSCR   = 4
000000r 2               ERR_REDIM       = 5
000000r 2               ERR_DIVZERO     = 6
000000r 2               ERR_ILLDIRECT   = 7
000000r 2               ERR_TYPEMISM    = 8
000000r 2               ERR_LONGSTR     = 9
000000r 2               ERR_FORMULA     = 10
000000r 2               ERR_ILLQUAN     = 11
000000r 2               ERR_RG          = 12            ; RETURN without GOSUB
000000r 2               ERR_NF          = 13            ; NEXT without FOR
000000r 2               ERR_OD          = 14            ; OUT OF DATA
000000r 2               ERR_NODEV       = 15
000000r 2               ERR_CANTCONT    = 16
000000r 2               
000000r 2               ; Aliases used by ported msbasic code.
000000r 2               ERR_BADSUBS     = ERR_BADSUBSCR
000000r 2               ERR_REDIMD      = ERR_REDIM
000000r 2               ERR_FRMCPX      = ERR_FORMULA
000000r 2               ERR_MEMFULL     = ERR_OUTOFMEM
000000r 2               ERR_STRLONG     = ERR_LONGSTR
000000r 2               ERR_ILLQTY      = ERR_ILLQUAN
000000r 2               
000000r 2               ; Lowest stack pointer GOSUB may descend to before raising OUT OF MEMORY.
000000r 2               ; Matches msbasic's GETSTK arithmetic for a GOSUB frame: 3*2 bytes of frame
000000r 2               ; plus a $3E-byte margin left for the interpreter's own JSR nesting (FrmEvl
000000r 2               ; recursion in particular) once the subroutine is running.  Frames cost about
000000r 2               ; 8 bytes apiece with those returns interleaved, so this permits roughly 23
000000r 2               ; levels -- the same working depth as Commodore BASIC.
000000r 2               GOSUB_STACK_MIN = $44
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   B A S E N T R Y   -   $C000
000000r 2               ;
000000r 2               ;   First byte of segment.  Reached from:
000000r 2               ;     * Kernal Reset, which clears BAS_WARM, so every reset is a cold start
000000r 2               ;     * Kernal Break, after a BRK instruction (warm re-entry)
000000r 2               ;     * Wozmon's C000R (warm re-entry)
000000r 2               ;
000000r 2               ;   Cold-vs-warm detection: BAS_WARM holds $A5 once cold init has run.
000000r 2               ;   Re-entry skips the header and goes straight to the OK prompt.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               BasEntry:
000000r 2  A2 FF                ldx     #$FF                    ; reset stack on (re)entry
000002r 2  9A                   txs
000003r 2  8E 75 03             stx     BAS_STKBASE             ; nothing suspended: the READY loop's
000006r 2                                                       ;   baseline is the empty stack
000006r 2  D8                   cld
000007r 2               
000007r 2  AD 6F 03             lda     BAS_WARM
00000Ar 2  C9 A5                cmp     #$A5
00000Cr 2  F0 08                beq     @Warm
00000Er 2               
00000Er 2  20 rr rr             jsr     BasColdInit
000011r 2  20 rr rr             jsr     BasBanner
000014r 2  80 2A                bra     BasReadyLoop
000016r 2               
000016r 2               @Warm:
000016r 2                       ; Warm restart - skip the header; the OK printer will lead with CRLF.
000016r 2                       ; Whatever was running is abandoned, as after an error: back to direct
000016r 2                       ; mode, with nothing for CONT to resume (it tests OLDTEXT's high byte).
000016r 2  A9 FF                lda     #$FF
000018r 2  8D 69 03             sta     BAS_CURLIN
00001Br 2  8D 6A 03             sta     BAS_CURLIN+1
00001Er 2  9C 6E 03             stz     BAS_OLDTEXT+1
000021r 2                       ; A loader outside BASIC may have dropped a new image at $0800 since we
000021r 2                       ; were last here, and said how long it is in PRG_IMAGE_END (see
000021r 2                       ; ProgramEnd).  Adopt it: the old variables describe a program that no
000021r 2                       ; longer exists, so ARYTAB/STREND follow VARTAB exactly as they would on
000021r 2                       ; a fresh LOAD.
000021r 2  AD 8E 03             lda     PRG_IMAGE_END
000024r 2  0D 8F 03             ora     PRG_IMAGE_END+1
000027r 2  F0 17                beq     BasReadyLoop
000029r 2  20 rr rr             jsr     ProgramEnd
00002Cr 2  8D 5F 03             sta     BAS_VARTAB
00002Fr 2  8C 60 03             sty     BAS_VARTAB+1
000032r 2  A2 01                ldx     #1
000034r 2               @adopt:
000034r 2  BD 5F 03             lda     BAS_VARTAB,x
000037r 2  9D 61 03             sta     BAS_ARYTAB,x
00003Ar 2  9D 63 03             sta     BAS_STREND,x
00003Dr 2  CA                   dex
00003Er 2  10 F4                bpl     @adopt
000040r 2               
000040r 2               ; -----------------------------------------------------------------------------
000040r 2               ; BasReadyLoop - REPL: print OK, read a line, dispatch.
000040r 2               ; -----------------------------------------------------------------------------
000040r 2               BasReadyLoop:
000040r 2  20 rr rr             jsr     BasPrintOK
000043r 2               @nextline:
000043r 2  20 rr rr             jsr     BasReadLine             ; fills BAS_LINBUF, NUL-terminated
000046r 2  20 rr rr             jsr     BasProcessLine
000049r 2  80 F8                bra     @nextline
00004Br 2               
00004Br 2               ; =============================================================================
00004Br 2               ;   B a s C o l d I n i t
00004Br 2               ; =============================================================================
00004Br 2               ; Initialise BASIC runtime variables.  Called once on first entry.
00004Br 2               ; =============================================================================
00004Br 2               BasColdInit:
00004Br 2                       ; ---------------------------------------------------------------------
00004Br 2                       ; Zero the BASIC-owned zero-page workspace first.  On a cold boot RAM
00004Br 2                       ; holds random power-up values, and the inlined MSBASIC math/parse code
00004Br 2                       ; treats several scratch cells as invariant-zero (e.g. SHIFTSIGNEXT,
00004Br 2                       ; FACEXTENSION, ARGEXTENSION) — they are only written on certain code
00004Br 2                       ; paths and assumed already 0 otherwise.  A random value in any of them
00004Br 2                       ; corrupts results; this is what produced the bogus "84405.0911 BYTES
00004Br 2                       ; FREE" banner on real hardware.  Clearing the whole region up front
00004Br 2                       ; eliminates this entire class of uninitialised-read bugs.  The two
00004Br 2                       ; ranges are the BASIC primary workspace ($04-$23) and the FP / var /
00004Br 2                       ; array / string spill ($3A-$85); $24-$39 is Kernal-reserved and left
00004Br 2                       ; untouched.  Specific non-zero values (CURLIN, TEMPPT, RND seed, etc.)
00004Br 2                       ; are written further down, after this clear.
00004Br 2  A9 00                lda     #0
00004Dr 2  A2 04                ldx     #BAS_TXTPTR             ; $04..$23
00004Fr 2               @ClrZpLo:
00004Fr 2  95 00                sta     ZP,x
000051r 2  E8                   inx
000052r 2  E0 24                cpx     #BAS_DEST+2
000054r 2  D0 F9                bne     @ClrZpLo
000056r 2  A2 3A                ldx     #BAS_TMP1               ; $3A..$85
000058r 2               @ClrZpHi:
000058r 2  95 00                sta     ZP,x
00005Ar 2  E8                   inx
00005Br 2  E0 86                cpx     #BAS_FRESPC+2
00005Dr 2  D0 F9                bne     @ClrZpHi
00005Fr 2               
00005Fr 2                       ; TXTTAB / MEMSIZ are constants for our memory map.
00005Fr 2  A9 00                lda     #<BAS_PRG_START
000061r 2  8D 5D 03             sta     BAS_TXTTAB
000064r 2  A9 08                lda     #>BAS_PRG_START
000066r 2  8D 5E 03             sta     BAS_TXTTAB+1
000069r 2               
000069r 2  A9 00                lda     #<$8000
00006Br 2  8D 67 03             sta     BAS_MEMSIZ
00006Er 2  A9 80                lda     #>$8000
000070r 2  8D 68 03             sta     BAS_MEMSIZ+1
000073r 2               
000073r 2                       ; Where does the program already sitting at $0800 end?  The Kernal owns
000073r 2                       ; this: it prefers a byte count recorded by a loader outside BASIC (so a
000073r 2                       ; .prg it placed keeps its machine code), falls back to a chain
000073r 2                       ; walk, and installs an empty program if there is nothing usable.
000073r 2  20 rr rr             jsr     ProgramEnd
000076r 2  8D 5F 03             sta     BAS_VARTAB
000079r 2  8C 60 03             sty     BAS_VARTAB+1
00007Cr 2               
00007Cr 2                       ; ARYTAB = STREND = VARTAB; FRETOP = MEMSIZ.
00007Cr 2  AD 5F 03             lda     BAS_VARTAB
00007Fr 2  8D 61 03             sta     BAS_ARYTAB
000082r 2  8D 63 03             sta     BAS_STREND
000085r 2  AD 60 03             lda     BAS_VARTAB+1
000088r 2  8D 62 03             sta     BAS_ARYTAB+1
00008Br 2  8D 64 03             sta     BAS_STREND+1
00008Er 2  AD 67 03             lda     BAS_MEMSIZ
000091r 2  8D 65 03             sta     BAS_FRETOP
000094r 2  AD 68 03             lda     BAS_MEMSIZ+1
000097r 2  8D 66 03             sta     BAS_FRETOP+1
00009Ar 2               
00009Ar 2                       ; CURLIN = $FFFF (direct mode marker).
00009Ar 2  A9 FF                lda     #$FF
00009Cr 2  8D 69 03             sta     BAS_CURLIN
00009Fr 2  8D 6A 03             sta     BAS_CURLIN+1
0000A2r 2               
0000A2r 2                       ; Clear CONT state and pending-key.
0000A2r 2  9C 6B 03             stz     BAS_OLDLIN
0000A5r 2  9C 6C 03             stz     BAS_OLDLIN+1
0000A8r 2  9C 6D 03             stz     BAS_OLDTEXT
0000ABr 2  9C 6E 03             stz     BAS_OLDTEXT+1
0000AEr 2  9C 1A 03             stz     BAS_DATAPTR
0000B1r 2  9C 1B 03             stz     BAS_DATAPTR+1
0000B4r 2  9C 1C 03             stz     BAS_STOPLINE
0000B7r 2  9C 1D 03             stz     BAS_STOPLINE+1
0000BAr 2  9C 1E 03             stz     BAS_STOPTXT
0000BDr 2  9C 1F 03             stz     BAS_STOPTXT+1
0000C0r 2  9C 0E 03             stz     BAS_PENDKEY
0000C3r 2  9C 70 03             stz     BAS_POSX                ; PRINT column counter (non-ZP)
0000C6r 2               
0000C6r 2                       ; ZP runtime flags (QUOTEFLG, DIMFLG, VALTYP, DATAFLG, SUBFLG,
0000C6r 2                       ; INPUTFLG, SHIFTSIGNEXT, ...) are already zeroed by the cold-init
0000C6r 2                       ; clear loop above; only non-zero / non-ZP state is set here.
0000C6r 2               
0000C6r 2                       ; Temp-string descriptor stack: TEMPPT = TEMPST.
0000C6r 2  A9 6E                lda     #BAS_TEMPST
0000C8r 2  85 6B                sta     BAS_TEMPPT
0000CAr 2               
0000CAr 2                       ; Initialise Rnd seed from the embedded constant.
0000CAr 2  A2 04                ldx     #4
0000CCr 2               @SeedCopy:
0000CCr 2  BD rr rr             lda     RndSeedInit,x
0000CFr 2  95 5C                sta     RNDSEED,x
0000D1r 2  CA                   dex
0000D2r 2  10 F8                bpl     @SeedCopy
0000D4r 2               
0000D4r 2                       ; Mark warm-start magic.
0000D4r 2  A9 A5                lda     #$A5
0000D6r 2  8D 6F 03             sta     BAS_WARM
0000D9r 2  60                   rts
0000DAr 2               
0000DAr 2               ; =============================================================================
0000DAr 2               ;   B a s B a n n e r
0000DAr 2               ; =============================================================================
0000DAr 2               BasBanner:
0000DAr 2  20 rr rr             jsr     VideoClear              ; a fresh screen (does nothing without video)
0000DDr 2  20 rr rr             jsr     BasPrintCRLF
0000E0r 2  A9 rr                lda     #<MsgHeader
0000E2r 2  A0 rr                ldy     #>MsgHeader
0000E4r 2  20 rr rr             jsr     BasPrintStr
0000E7r 2  20 rr rr             jsr     BasPrintCRLF
0000EAr 2                       ; Print "<n> BYTES FREE" line.
0000EAr 2  38                   sec
0000EBr 2  AD 67 03             lda     BAS_MEMSIZ
0000EEr 2  ED 5F 03             sbc     BAS_VARTAB
0000F1r 2  A8                   tay
0000F2r 2  AD 68 03             lda     BAS_MEMSIZ+1
0000F5r 2  ED 60 03             sbc     BAS_VARTAB+1
0000F8r 2  20 rr rr             jsr     GivAyf
0000FBr 2                       ; Print the byte count left-aligned: Fout always emits a leading
0000FBr 2                       ; sign character (' ' for positive, '-' for negative).  For the
0000FBr 2                       ; header we skip that leading space so the number lines up with
0000FBr 2                       ; the left edge of the title above it.
0000FBr 2  20 rr rr             jsr     Fout                    ; (Y,A) -> NUL-terminated buffer
0000FEr 2  85 20                sta     INDEX
000100r 2  84 21                sty     INDEX+1
000102r 2  A0 00                ldy     #0
000104r 2  B1 20                lda     (INDEX),y
000106r 2  C9 20                cmp     #' '
000108r 2  D0 01                bne     @bnLoop
00010Ar 2  C8                   iny                             ; skip the positive-sign space
00010Br 2               @bnLoop:
00010Br 2  B1 20                lda     (INDEX),y
00010Dr 2  F0 06                beq     @bnDone
00010Fr 2  20 rr rr             jsr     PrintCh
000112r 2  C8                   iny
000113r 2  D0 F6                bne     @bnLoop
000115r 2               @bnDone:
000115r 2  A9 rr                lda     #<MsgBytesFreeNL
000117r 2  A0 rr                ldy     #>MsgBytesFreeNL
000119r 2  20 rr rr             jsr     BasPrintStr
00011Cr 2                       ; The fitted cards, in HW_PRESENT's bit order, one space between names.
00011Cr 2                       ; Either RAM card prints RAM, so RAM_L is folded into RAM_H's bit and
00011Cr 2                       ; the seven that remain are shifted out in step with HwNames.
00011Cr 2  AD 0D 03             lda     HW_PRESENT
00011Fr 2  4A                   lsr     a                       ; C = RAM_L; bit 0 is now RAM_H
000120r 2  90 02                bcc     @hwStart
000122r 2  09 01                ora     #$01
000124r 2               @hwStart:
000124r 2  A2 00                ldx     #0                      ; X = index into HwNames
000126r 2  A0 00                ldy     #0                      ; Y = 0 until a name has been printed
000128r 2               @hwBit:
000128r 2  4A                   lsr     a                       ; C = this card
000129r 2  48                   pha
00012Ar 2  90 15                bcc     @hwSkip
00012Cr 2  98                   tya
00012Dr 2  F0 05                beq     @hwName
00012Fr 2  A9 20                lda     #' '
000131r 2  20 rr rr             jsr     Chrout                  ; Chrout keeps X and Y
000134r 2               @hwName:
000134r 2  A0 01                ldy     #1
000136r 2               @hwChar:
000136r 2  E8                   inx
000137r 2  BD rr rr             lda     HwNames-1,x
00013Ar 2  F0 0B                beq     @hwNext
00013Cr 2  20 rr rr             jsr     Chrout
00013Fr 2  80 F5                bra     @hwChar
000141r 2               @hwSkip:
000141r 2  E8                   inx
000142r 2  BD rr rr             lda     HwNames-1,x
000145r 2  D0 FA                bne     @hwSkip
000147r 2               @hwNext:
000147r 2  68                   pla                             ; the cards not yet shifted out
000148r 2  D0 DE                bne     @hwBit
00014Ar 2  4C rr rr             jmp     BasPrintCRLF
00014Dr 2               
00014Dr 2               HwNames:
00014Dr 2  52 41 4D 00          .byte   "RAM",0,"RTC",0,"CF",0,"SER",0,"VIA",0,"SID",0,"VDP",0
000151r 2  52 54 43 00  
000155r 2  43 46 00 53  
000168r 2               
000168r 2               ; =============================================================================
000168r 2               ;   B a s P r i n t O K
000168r 2               ; =============================================================================
000168r 2               BasPrintOK:
000168r 2  20 rr rr             jsr     BasPrintCRLF
00016Br 2  A9 rr                lda     #<MsgOK
00016Dr 2  A0 rr                ldy     #>MsgOK
00016Fr 2  4C rr rr             jmp     BasPrintStr
000172r 2               
000172r 2               ; =============================================================================
000172r 2               ;   B a s P r i n t S t r  /  B a s P r i n t C R L F
000172r 2               ; =============================================================================
000172r 2               ; These were promoted to the KERNAL jump table as PrintStr ($A090) and
000172r 2               ; PrintCRLF ($A093) so cartridges can reuse them and the KERNAL no longer
000172r 2               ; depends on BASIC-segment code.  Keep the old BASIC names as aliases so the
000172r 2               ; existing call sites (and A=lo/Y=hi convention) are unchanged.
000172r 2               BasPrintStr     := PrintStr
000172r 2               BasPrintCRLF    := PrintCRLF
000172r 2               
000172r 2               ; =============================================================================
000172r 2               ;   B a s R e a d L i n e
000172r 2               ; =============================================================================
000172r 2               ; Read a line of input into BAS_LINBUF, NUL-terminated.  Echoes characters
000172r 2               ; manually (does not use Chrin's auto-echo).  Supports CR, BS ($08), ESC
000172r 2               ; ($1B = cancel and restart line).  Caps stored length at BAS_LINBUF_MAX
000172r 2               ; (extra characters are silently dropped from the buffer but still echoed
000172r 2               ; -- acceptable truncation behavior).
000172r 2               ;
000172r 2               ; Output : BAS_LINBUF holds the raw line, terminated with $00.
000172r 2               ; =============================================================================
000172r 2               BasReadLine:
000172r 2  A0 00                ldy     #0
000174r 2               @Loop:
000174r 2  20 rr rr             jsr     BasReadKey              ; A = next key, blocking
000177r 2  C9 0D                cmp     #$0D
000179r 2  F0 30                beq     @Done
00017Br 2  C9 08                cmp     #$08
00017Dr 2  F0 19                beq     @Backspace
00017Fr 2  C9 1B                cmp     #$1B
000181r 2  F0 21                beq     @Cancel
000183r 2  C9 20                cmp     #$20                    ; reject control codes below space
000185r 2  90 ED                bcc     @Loop
000187r 2  C9 7F                cmp     #$7F                    ; reject DEL and 8-bit
000189r 2  B0 E9                bcs     @Loop
00018Br 2                       ; Printable - store and echo.
00018Br 2  C0 C8                cpy     #BAS_LINBUF_MAX
00018Dr 2  B0 E5                bcs     @Loop                   ; full - drop quietly
00018Fr 2  99 00 04             sta     BAS_LINBUF,y
000192r 2  C8                   iny
000193r 2  20 rr rr             jsr     Chrout
000196r 2  80 DC                bra     @Loop
000198r 2               
000198r 2               @Backspace:
000198r 2  C0 00                cpy     #0
00019Ar 2  F0 D8                beq     @Loop                   ; nothing to erase
00019Cr 2  88                   dey
00019Dr 2  A9 08                lda     #$08                    ; video / serial driver erases on BS
00019Fr 2  20 rr rr             jsr     Chrout
0001A2r 2  80 D0                bra     @Loop
0001A4r 2               
0001A4r 2               @Cancel:
0001A4r 2  20 rr rr             jsr     BasPrintCRLF
0001A7r 2  A0 00                ldy     #0
0001A9r 2  80 C9                bra     @Loop
0001ABr 2               
0001ABr 2               @Done:
0001ABr 2  A9 00                lda     #0
0001ADr 2  99 00 04             sta     BAS_LINBUF,y
0001B0r 2  20 rr rr             jsr     BasPrintCRLF
0001B3r 2  60                   rts
0001B4r 2               
0001B4r 2               ; =============================================================================
0001B4r 2               ;   B a s R e a d K e y
0001B4r 2               ; =============================================================================
0001B4r 2               ; Spin until a key is available in the input buffer; return it in A
0001B4r 2               ; (no echo).
0001B4r 2               ; =============================================================================
0001B4r 2               BasReadKey:
0001B4r 2               @Wait:
0001B4r 2  20 rr rr             jsr     BufferSize
0001B7r 2  F0 FB                beq     @Wait
0001B9r 2  4C rr rr             jmp     ReadBuffer              ; tail-call: returns A=byte
0001BCr 2               
0001BCr 2               ; =============================================================================
0001BCr 2               ;   B a s P r o c e s s L i n e
0001BCr 2               ; =============================================================================
0001BCr 2               ; Triage BAS_LINBUF after reading: empty, numbered (insert/replace/delete),
0001BCr 2               ; or immediate command.
0001BCr 2               ; =============================================================================
0001BCr 2               BasProcessLine:
0001BCr 2  A2 00                ldx     #0
0001BEr 2               @SkipSpaces:
0001BEr 2  BD 00 04             lda     BAS_LINBUF,x
0001C1r 2  F0 07                beq     @Empty
0001C3r 2  C9 20                cmp     #' '
0001C5r 2  D0 04                bne     @HasContent
0001C7r 2  E8                   inx
0001C8r 2  80 F4                bra     @SkipSpaces
0001CAr 2               @Empty:
0001CAr 2  60                   rts                             ; nothing to do; caller will reprompt
0001CBr 2               
0001CBr 2               @HasContent:
0001CBr 2  C9 30                cmp     #'0'
0001CDr 2  90 1A                bcc     @Immediate
0001CFr 2  C9 3A                cmp     #'9'+1
0001D1r 2  B0 16                bcs     @Immediate
0001D3r 2               
0001D3r 2               ; --- Numbered line -----------------------------------------------------------
0001D3r 2  20 rr rr             jsr     BasParseLineNum         ; consumes digits at BAS_LINBUF+X
0001D6r 2                       ; X now points to first non-digit; allow exactly one optional space.
0001D6r 2  BD 00 04             lda     BAS_LINBUF,x
0001D9r 2  C9 20                cmp     #' '
0001DBr 2  D0 01                bne     @TokenizeRest
0001DDr 2  E8                   inx
0001DEr 2               @TokenizeRest:
0001DEr 2  20 rr rr             jsr     BasCrunch               ; tokenize from BAS_LINBUF+X to BAS_TOKBUF
0001E1r 2  B0 03                bcs     @StoreLine              ; carry set = success
0001E3r 2  4C rr rr             jmp     BasErrSyntax
0001E6r 2               
0001E6r 2               @StoreLine:
0001E6r 2  4C rr rr             jmp     BasStoreLine            ; insert/replace/delete by line number
0001E9r 2               
0001E9r 2               @Immediate:
0001E9r 2                       ; Immediate (no line number) - tokenize whole line and dispatch.
0001E9r 2  A2 00                ldx     #0
0001EBr 2  20 rr rr             jsr     BasCrunch
0001EEr 2  B0 03                bcs     @ImmDispatch
0001F0r 2  4C rr rr             jmp     BasErrSyntax
0001F3r 2               @ImmDispatch:
0001F3r 2  20 rr rr             jsr     BasDispatchImmediate
0001F6r 2  4C rr rr             jmp     BasPrintOK              ; MS BASIC: OK only after immediate
0001F9r 2               
0001F9r 2               ; =============================================================================
0001F9r 2               ;   B a s P a r s e L i n e N u m
0001F9r 2               ; =============================================================================
0001F9r 2               ; Parse decimal digits at BAS_LINBUF,X into BAS_LINNUM (16-bit).
0001F9r 2               ; X advances past the digits.  Saturates at $FFFF on overflow.
0001F9r 2               ; =============================================================================
0001F9r 2               BasParseLineNum:
0001F9r 2  64 08                stz     BAS_LINNUM
0001FBr 2  64 09                stz     BAS_LINNUM+1
0001FDr 2               @Loop:
0001FDr 2  BD 00 04             lda     BAS_LINBUF,x
000200r 2  C9 30                cmp     #'0'
000202r 2  90 35                bcc     @Done
000204r 2  C9 3A                cmp     #'9'+1
000206r 2  B0 31                bcs     @Done
000208r 2                       ; Multiply LINNUM by 10.
000208r 2  48                   pha
000209r 2  06 08                asl     BAS_LINNUM              ; *2
00020Br 2  26 09                rol     BAS_LINNUM+1
00020Dr 2  A5 08                lda     BAS_LINNUM
00020Fr 2  85 3A                sta     BAS_TMP1
000211r 2  A5 09                lda     BAS_LINNUM+1
000213r 2  85 3B                sta     BAS_TMP1+1
000215r 2  06 08                asl     BAS_LINNUM              ; *4
000217r 2  26 09                rol     BAS_LINNUM+1
000219r 2  06 08                asl     BAS_LINNUM              ; *8
00021Br 2  26 09                rol     BAS_LINNUM+1
00021Dr 2  18                   clc                             ; *8 + *2 = *10
00021Er 2  A5 08                lda     BAS_LINNUM
000220r 2  65 3A                adc     BAS_TMP1
000222r 2  85 08                sta     BAS_LINNUM
000224r 2  A5 09                lda     BAS_LINNUM+1
000226r 2  65 3B                adc     BAS_TMP1+1
000228r 2  85 09                sta     BAS_LINNUM+1
00022Ar 2                       ; Add digit value.
00022Ar 2  68                   pla
00022Br 2  29 0F                and     #$0F
00022Dr 2  18                   clc
00022Er 2  65 08                adc     BAS_LINNUM
000230r 2  85 08                sta     BAS_LINNUM
000232r 2  90 02                bcc     @NoCarry
000234r 2  E6 09                inc     BAS_LINNUM+1
000236r 2               @NoCarry:
000236r 2  E8                   inx
000237r 2  80 C4                bra     @Loop
000239r 2               @Done:
000239r 2  60                   rts
00023Ar 2               
00023Ar 2               ; =============================================================================
00023Ar 2               ;   B a s C r u n c h
00023Ar 2               ; =============================================================================
00023Ar 2               ; Tokenize BAS_LINBUF starting at offset X into BAS_TOKBUF.
00023Ar 2               ;
00023Ar 2               ; Tokenization rules:
00023Ar 2               ;   - Outside quoted strings, lowercase a-z are folded to uppercase.
00023Ar 2               ;   - Outside quoted strings, alphabetic runs are matched against the
00023Ar 2               ;     keyword table; on a match the token byte is emitted in place of the
00023Ar 2               ;     keyword characters.
00023Ar 2               ;   - Inside double quotes, characters are copied verbatim until the
00023Ar 2               ;     closing quote (or end of line).
00023Ar 2               ;   - After a REM token, the rest of the line is copied verbatim.
00023Ar 2               ;   - Disallowed punctuation (@, &, [, ], {, }, |, \, `, ~) raises
00023Ar 2               ;     ?SYNTAX ERROR via carry-clear return.
00023Ar 2               ;
00023Ar 2               ; Output : BAS_TOKBUF holds the tokenized line, NUL-terminated.
00023Ar 2               ; Returns: carry SET on success, carry CLEAR on syntax error.
00023Ar 2               ; Clobbers: A, X, Y, BAS_TMP1/TMP2/TMP3.
00023Ar 2               ; =============================================================================
00023Ar 2               BasCrunch:
00023Ar 2                       ; X = src index, Y = dst index
00023Ar 2  A0 00                ldy     #0
00023Cr 2  64 41                stz     BAS_QUOTEFLG
00023Er 2               @Scan:
00023Er 2  C0 FA                cpy     #BAS_TOKBUF_MAX
000240r 2  B0 0A                bcs     @Overflow
000242r 2  BD 00 04             lda     BAS_LINBUF,x
000245r 2  D0 07                bne     @NotEnd
000247r 2                       ; End of input.
000247r 2  99 00 05             sta     BAS_TOKBUF,y            ; A=0
00024Ar 2  38                   sec
00024Br 2  60                   rts
00024Cr 2               @Overflow:
00024Cr 2                       ; Tokenized line too long; treat as syntax error.
00024Cr 2  18                   clc
00024Dr 2  60                   rts
00024Er 2               
00024Er 2               @NotEnd:
00024Er 2  C9 22                cmp     #'"'
000250r 2  F0 56                beq     @Quote
000252r 2                       ; Lowercase to uppercase outside quotes.
000252r 2  C9 61                cmp     #'a'
000254r 2  90 06                bcc     @CheckAlpha
000256r 2  C9 7B                cmp     #'z'+1
000258r 2  B0 02                bcs     @CheckAlpha
00025Ar 2  29 DF                and     #$DF
00025Cr 2               @CheckAlpha:
00025Cr 2                       ; Alphabetic? Try keyword match.
00025Cr 2  C9 41                cmp     #'A'
00025Er 2  90 3A                bcc     @NotAlpha
000260r 2  C9 5B                cmp     #'Z'+1
000262r 2  B0 36                bcs     @NotAlpha
000264r 2                       ; Alpha - try matching a keyword starting at BAS_LINBUF,x.
000264r 2  20 rr rr             jsr     BasMatchKeyword         ; returns C set (A=token, X advanced) or C clear
000267r 2  90 1D                bcc     @CopyAlpha
000269r 2                       ; Match: emit token byte.
000269r 2  99 00 05             sta     BAS_TOKBUF,y
00026Cr 2  C8                   iny
00026Dr 2  C9 8E                cmp     #TOK_REM
00026Fr 2  D0 CD                bne     @Scan
000271r 2                       ; After REM: copy the remainder verbatim.
000271r 2               @RemCopy:
000271r 2  C0 FA                cpy     #BAS_TOKBUF_MAX
000273r 2  B0 D7                bcs     @Overflow
000275r 2  BD 00 04             lda     BAS_LINBUF,x
000278r 2  F0 07                beq     @TermAndExit
00027Ar 2  99 00 05             sta     BAS_TOKBUF,y
00027Dr 2  C8                   iny
00027Er 2  E8                   inx
00027Fr 2  80 F0                bra     @RemCopy
000281r 2               @TermAndExit:
000281r 2  99 00 05             sta     BAS_TOKBUF,y            ; A=0
000284r 2  38                   sec
000285r 2  60                   rts
000286r 2               
000286r 2               @CopyAlpha:
000286r 2                       ; No keyword match - copy a single alpha char (re-uppercase here, since
000286r 2                       ; BasMatchKeyword returns the original LINBUF byte).
000286r 2  BD 00 04             lda     BAS_LINBUF,x
000289r 2  C9 61                cmp     #'a'
00028Br 2  90 06                bcc     @CASto
00028Dr 2  C9 7B                cmp     #'z'+1
00028Fr 2  B0 02                bcs     @CASto
000291r 2  29 DF                and     #$DF
000293r 2               @CASto:
000293r 2  99 00 05             sta     BAS_TOKBUF,y
000296r 2  C8                   iny
000297r 2  E8                   inx
000298r 2  80 A4                bra     @Scan
00029Ar 2               
00029Ar 2               @NotAlpha:
00029Ar 2                       ; Punctuation / digit / space.  Validate against the disallowed set.
00029Ar 2  20 rr rr             jsr     BasValidPunct
00029Dr 2  90 07                bcc     @SyntaxFail
00029Fr 2  99 00 05             sta     BAS_TOKBUF,y
0002A2r 2  C8                   iny
0002A3r 2  E8                   inx
0002A4r 2  80 98                bra     @Scan
0002A6r 2               @SyntaxFail:
0002A6r 2  18                   clc
0002A7r 2  60                   rts
0002A8r 2               
0002A8r 2               @Quote:
0002A8r 2                       ; Copy opening quote, then everything up to closing quote (or end).
0002A8r 2  99 00 05             sta     BAS_TOKBUF,y
0002ABr 2  C8                   iny
0002ACr 2  E8                   inx
0002ADr 2               @QuoteLoop:
0002ADr 2  C0 FA                cpy     #BAS_TOKBUF_MAX
0002AFr 2  B0 9B                bcs     @Overflow
0002B1r 2  BD 00 04             lda     BAS_LINBUF,x
0002B4r 2  F0 CB                beq     @TermAndExit
0002B6r 2  99 00 05             sta     BAS_TOKBUF,y
0002B9r 2  C8                   iny
0002BAr 2  E8                   inx
0002BBr 2  C9 22                cmp     #'"'
0002BDr 2  D0 EE                bne     @QuoteLoop
0002BFr 2  4C rr rr             jmp     @Scan
0002C2r 2               
0002C2r 2               ; =============================================================================
0002C2r 2               ;   B a s V a l i d P u n c t
0002C2r 2               ; =============================================================================
0002C2r 2               ; Verify A is an acceptable non-keyword character.
0002C2r 2               ; Carry SET = OK, carry CLEAR = illegal.
0002C2r 2               ; Allowed: anything in $20-$7E EXCEPT @, &, [, ], {, }, |, \, `, ~.
0002C2r 2               ; =============================================================================
0002C2r 2               BasValidPunct:
0002C2r 2  C9 40                cmp     #'@'
0002C4r 2  F0 26                beq     @Bad
0002C6r 2  C9 26                cmp     #'&'
0002C8r 2  F0 22                beq     @Bad
0002CAr 2  C9 5B                cmp     #'['
0002CCr 2  F0 1E                beq     @Bad
0002CEr 2  C9 5D                cmp     #']'
0002D0r 2  F0 1A                beq     @Bad
0002D2r 2  C9 7B                cmp     #'{'
0002D4r 2  F0 16                beq     @Bad
0002D6r 2  C9 7D                cmp     #'}'
0002D8r 2  F0 12                beq     @Bad
0002DAr 2  C9 7C                cmp     #'|'
0002DCr 2  F0 0E                beq     @Bad
0002DEr 2  C9 5C                cmp     #'\'
0002E0r 2  F0 0A                beq     @Bad
0002E2r 2  C9 60                cmp     #'`'
0002E4r 2  F0 06                beq     @Bad
0002E6r 2  C9 7E                cmp     #'~'
0002E8r 2  F0 02                beq     @Bad
0002EAr 2  38                   sec
0002EBr 2  60                   rts
0002ECr 2               @Bad:
0002ECr 2  18                   clc
0002EDr 2  60                   rts
0002EEr 2               
0002EEr 2               ; =============================================================================
0002EEr 2               ;   B a s M a t c h K e y w o r d
0002EEr 2               ; =============================================================================
0002EEr 2               ; Try to match a keyword from KeywordTbl starting at BAS_LINBUF,X.
0002EEr 2               ;
0002EEr 2               ; On match  : carry SET, A = token byte, X advanced past the matched
0002EEr 2               ;             keyword characters in BAS_LINBUF.
0002EEr 2               ; On miss   : carry CLEAR, X unchanged, A = original character at LINBUF,X.
0002EEr 2               ;
0002EEr 2               ; Match algorithm:
0002EEr 2               ;   - Walk KeywordTbl, comparing characters (folding LINBUF lowercase to
0002EEr 2               ;     uppercase) to each keyword in turn.  A keyword's last byte has bit 7
0002EEr 2               ;     set; the byte after the table's final keyword is $00.
0002EEr 2               ;   - Token value = TOK_BASE + (index of keyword in table).
0002EEr 2               ;   - The LONGEST match wins, not the first one found.  Taking the first would
0002EEr 2               ;     make a keyword unreachable whenever an earlier one is a prefix of it:
0002EEr 2               ;     FOR ($81) comes before FORMAT ($D4), so FORMAT crunched to FOR + "MAT"
0002EEr 2               ;     and the statement could not be typed at all.  Scanning to the end of the
0002EEr 2               ;     table costs a little time on each keyword, and buys a tokenizer whose
0002EEr 2               ;     result does not depend on the table's order.
0002EEr 2               ; =============================================================================
0002EEr 2               BasMatchKeyword:
0002EEr 2                       ; Save initial X for rollback on miss; preserve caller's Y (BasCrunch
0002EEr 2                       ; uses Y as the TOKBUF destination index).
0002EEr 2  86 3E                stx     BAS_TMP3
0002F0r 2  5A                   phy
0002F1r 2                       ; Walk the keyword table via a 16-bit ZP pointer (BAS_KWPTR), since
0002F1r 2                       ; the table is larger than 256 bytes.  Y is held at 0 throughout and
0002F1r 2                       ; we advance BAS_KWPTR byte-by-byte instead of relying on Y.
0002F1r 2  A9 rr                lda     #<KeywordTbl
0002F3r 2  85 61                sta     BAS_KWPTR
0002F5r 2  A9 rr                lda     #>KeywordTbl
0002F7r 2  85 62                sta     BAS_KWPTR+1
0002F9r 2  A9 80                lda     #TOK_BASE
0002FBr 2  85 3A                sta     BAS_TMP1                ; current candidate token
0002FDr 2                       ; Best match so far, both zero until one is found: BAS_TMP1+1 is its
0002FDr 2                       ; token (no token is $00) and BAS_TMP2+1 the input index just past it.
0002FDr 2                       ; Both are the spare halves of pointers this routine only uses a byte
0002FDr 2                       ; of, and neither outlives the call.
0002FDr 2  64 3B                stz     BAS_TMP1+1
0002FFr 2  64 3D                stz     BAS_TMP2+1
000301r 2  A0 00                ldy     #0
000303r 2               @KeywordLoop:
000303r 2                       ; Restore X to start of input keyword.
000303r 2  A6 3E                ldx     BAS_TMP3
000305r 2               @CharLoop:
000305r 2  B1 61                lda     (BAS_KWPTR),y           ; Y == 0
000307r 2  F0 5D                beq     @NoMatch                ; reached table terminator
000309r 2  48                   pha
00030Ar 2  29 7F                and     #$7F
00030Cr 2  85 3C                sta     BAS_TMP2                ; expected char (uppercase)
00030Er 2                       ; Read input char and uppercase it.
00030Er 2  BD 00 04             lda     BAS_LINBUF,x
000311r 2  C9 61                cmp     #'a'
000313r 2  90 06                bcc     @InpCmp
000315r 2  C9 7B                cmp     #'z'+1
000317r 2  B0 02                bcs     @InpCmp
000319r 2  29 DF                and     #$DF
00031Br 2               @InpCmp:
00031Br 2  C5 3C                cmp     BAS_TMP2
00031Dr 2  D0 0C                bne     @CharMismatch
00031Fr 2  68                   pla                             ; restore raw table byte
000320r 2                       ; Match - is this the last char of the keyword?
000320r 2  30 1C                bmi     @WholeMatch             ; bit 7 set -> full keyword matched
000322r 2                       ; Advance both pointers and continue.
000322r 2  E6 61                inc     BAS_KWPTR
000324r 2  D0 02                bne     @CharNoCarry
000326r 2  E6 62                inc     BAS_KWPTR+1
000328r 2               @CharNoCarry:
000328r 2  E8                   inx
000329r 2  80 DA                bra     @CharLoop
00032Br 2               
00032Br 2               @CharMismatch:
00032Br 2  68                   pla
00032Cr 2                       ; Skip ahead to start of next keyword in table.  Walk byte-by-byte
00032Cr 2                       ; until we consume a byte with bit 7 set (last char of this keyword)
00032Cr 2                       ; or hit the $00 terminator.
00032Cr 2               @SkipKeyword:
00032Cr 2  B1 61                lda     (BAS_KWPTR),y           ; Y == 0
00032Er 2  F0 36                beq     @NoMatch                ; hit table terminator
000330r 2  E6 61                inc     BAS_KWPTR
000332r 2  D0 02                bne     @SkipNoCarry
000334r 2  E6 62                inc     BAS_KWPTR+1
000336r 2               @SkipNoCarry:
000336r 2  C9 80                cmp     #$80                    ; carry set iff loaded byte >= $80
000338r 2  90 F2                bcc     @SkipKeyword
00033Ar 2                       ; Fall through: byte had bit 7 set => end of keyword.
00033Ar 2               @AdvanceTok:
00033Ar 2  E6 3A                inc     BAS_TMP1
00033Cr 2  80 C5                bra     @KeywordLoop
00033Er 2               
00033Er 2               @WholeMatch:
00033Er 2                       ; X points at the LAST matched char in input; advance past it.
00033Er 2  E8                   inx
00033Fr 2                       ; A candidate, not an answer: a keyword further down the table may match
00033Fr 2                       ; more of the input.  Keep it only if it does, and carry on scanning.
00033Fr 2  E4 3D                cpx     BAS_TMP2+1
000341r 2  90 06                bcc     @Extendable             ; a longer match is already held
000343r 2  86 3D                stx     BAS_TMP2+1
000345r 2  A5 3A                lda     BAS_TMP1
000347r 2  85 3B                sta     BAS_TMP1+1
000349r 2               @Extendable:
000349r 2                       ; Only a letter or '$' appears in a keyword, so unless the input
000349r 2                       ; continues with one, nothing longer can match and the rest of the
000349r 2                       ; table is not worth walking.  This is what keeps ordinary typing at
000349r 2                       ; the speed it had when the first match won outright: at 19200 baud the
000349r 2                       ; crunch of one line runs while the next is arriving, and a slower one
000349r 2                       ; drops characters out of the input buffer.
000349r 2  A6 3D                ldx     BAS_TMP2+1
00034Br 2  BD 00 04             lda     BAS_LINBUF,x
00034Er 2  C9 24                cmp     #'$'
000350r 2  F0 DA                beq     @SkipKeyword
000352r 2  C9 61                cmp     #'a'
000354r 2  90 06                bcc     @ExtAlpha
000356r 2  C9 7B                cmp     #'z'+1
000358r 2  B0 02                bcs     @ExtAlpha
00035Ar 2  29 DF                and     #$DF
00035Cr 2               @ExtAlpha:
00035Cr 2  C9 41                cmp     #'A'
00035Er 2  90 0A                bcc     @TakeBest
000360r 2  C9 5B                cmp     #'Z'+1
000362r 2  B0 06                bcs     @TakeBest
000364r 2  80 C6                bra     @SkipKeyword
000366r 2               
000366r 2               @NoMatch:
000366r 2                       ; End of the table.  Anything found along the way is the longest there
000366r 2                       ; is, since nothing after it matched at all.
000366r 2  A5 3B                lda     BAS_TMP1+1
000368r 2  F0 07                beq     @NoneAtAll
00036Ar 2               @TakeBest:
00036Ar 2  A6 3D                ldx     BAS_TMP2+1              ; input index past the longest match
00036Cr 2  A5 3B                lda     BAS_TMP1+1
00036Er 2  7A                   ply                             ; restore caller's Y
00036Fr 2  38                   sec
000370r 2  60                   rts
000371r 2               @NoneAtAll:
000371r 2  A6 3E                ldx     BAS_TMP3                ; restore caller's X
000373r 2  7A                   ply                             ; restore caller's Y
000374r 2  BD 00 04             lda     BAS_LINBUF,x
000377r 2  18                   clc
000378r 2  60                   rts
000379r 2               
000379r 2               ; =============================================================================
000379r 2               ;   B a s S t o r e L i n e
000379r 2               ; =============================================================================
000379r 2               ; Insert or replace BAS_LINNUM in the program with the tokenized payload in
000379r 2               ; BAS_TOKBUF.  If BAS_TOKBUF is empty, delete the existing line.
000379r 2               ;
000379r 2               ; Algorithm:
000379r 2               ;   1. Find existing line number (or insertion point).
000379r 2               ;   2. If exact match, delete that line (close the gap, decrement VARTAB).
000379r 2               ;   3. If payload non-empty, splice in [next][num][payload][$00].
000379r 2               ;   4. Relink all next-pointers.
000379r 2               ; =============================================================================
000379r 2               BasStoreLine:
000379r 2                       ; Locate insertion point.  BAS_INDEX <- pointer; carry set = exact match.
000379r 2  20 rr rr             jsr     BasFindLine
00037Cr 2               
00037Cr 2  90 03                bcc     @NoExisting
00037Er 2                       ; Line exists - delete it first.
00037Er 2  20 rr rr             jsr     BasDeleteAtIndex
000381r 2               @NoExisting:
000381r 2                       ; If tokbuf is empty, we're done (delete-only operation).
000381r 2  AD 00 05             lda     BAS_TOKBUF
000384r 2  D0 04                bne     @InsertNew
000386r 2  20 rr rr             jsr     BasRelink
000389r 2  60                   rts
00038Ar 2               
00038Ar 2               @InsertNew:
00038Ar 2  20 rr rr             jsr     BasInsertAtIndex
00038Dr 2  90 04                bcc     @NoMem
00038Fr 2  20 rr rr             jsr     BasRelink
000392r 2  60                   rts
000393r 2               @NoMem:
000393r 2  A9 02                lda     #ERR_OUTOFMEM
000395r 2  4C rr rr             jmp     BasError
000398r 2               
000398r 2               ; =============================================================================
000398r 2               ;   B a s F i n d L i n e
000398r 2               ; =============================================================================
000398r 2               ; Locate BAS_LINNUM in the program list.
000398r 2               ;
000398r 2               ; On entry : BAS_LINNUM = target line number.
000398r 2               ; On exit  : BAS_INDEX = pointer to start of either the matching line or the
000398r 2               ;            first line whose number > target (or end-marker).
000398r 2               ;            Carry SET if exact match, CLEAR otherwise.
000398r 2               ; =============================================================================
000398r 2               BasFindLine:
000398r 2  AD 5D 03             lda     BAS_TXTTAB
00039Br 2  85 20                sta     BAS_INDEX
00039Dr 2  AD 5E 03             lda     BAS_TXTTAB+1
0003A0r 2  85 21                sta     BAS_INDEX+1
0003A2r 2               @Loop:
0003A2r 2  A0 01                ldy     #1
0003A4r 2  B1 20                lda     (BAS_INDEX),y
0003A6r 2  F0 25                beq     @NotFound               ; end-marker (next-hi = 0)
0003A8r 2               
0003A8r 2                       ; Compare line numbers: (INDEX+2/+3) vs LINNUM.
0003A8r 2  A0 03                ldy     #3
0003AAr 2  B1 20                lda     (BAS_INDEX),y
0003ACr 2  C5 09                cmp     BAS_LINNUM+1
0003AEr 2  90 0D                bcc     @Advance                ; line < target
0003B0r 2  D0 1B                bne     @TooHigh                ; line > target -> insertion point
0003B2r 2  88                   dey
0003B3r 2  B1 20                lda     (BAS_INDEX),y
0003B5r 2  C5 08                cmp     BAS_LINNUM
0003B7r 2  90 04                bcc     @Advance
0003B9r 2  D0 12                bne     @TooHigh
0003BBr 2                       ; Exact match.
0003BBr 2  38                   sec
0003BCr 2  60                   rts
0003BDr 2               
0003BDr 2               @Advance:
0003BDr 2                       ; Follow next-pointer.
0003BDr 2  A0 00                ldy     #0
0003BFr 2  B1 20                lda     (BAS_INDEX),y
0003C1r 2  48                   pha
0003C2r 2  A0 01                ldy     #1
0003C4r 2  B1 20                lda     (BAS_INDEX),y
0003C6r 2  85 21                sta     BAS_INDEX+1
0003C8r 2  68                   pla
0003C9r 2  85 20                sta     BAS_INDEX
0003CBr 2  80 D5                bra     @Loop
0003CDr 2               
0003CDr 2               @NotFound:
0003CDr 2               @TooHigh:
0003CDr 2  18                   clc
0003CEr 2  60                   rts
0003CFr 2               
0003CFr 2               ; =============================================================================
0003CFr 2               ;   B a s D e l e t e A t I n d e x
0003CFr 2               ; =============================================================================
0003CFr 2               ; Delete the line whose start is at BAS_INDEX.
0003CFr 2               ; Closes the gap by copying [next-line .. VARTAB-1] down to (BAS_INDEX...)
0003CFr 2               ; and decrements VARTAB by the deleted size.
0003CFr 2               ; =============================================================================
0003CFr 2               BasDeleteAtIndex:
0003CFr 2                       ; BAS_TMP1 = next-line address (read from current line's next ptr).
0003CFr 2  A0 00                ldy     #0
0003D1r 2  B1 20                lda     (BAS_INDEX),y
0003D3r 2  85 3A                sta     BAS_TMP1
0003D5r 2  C8                   iny
0003D6r 2  B1 20                lda     (BAS_INDEX),y
0003D8r 2  85 3B                sta     BAS_TMP1+1
0003DAr 2               
0003DAr 2                       ; gap-size = TMP1 - INDEX  (positive)
0003DAr 2                       ; Copy from TMP1 to INDEX, byte by byte, until TMP1 reaches VARTAB.
0003DAr 2                       ; BAS_DEST = INDEX (write cursor); BAS_TMP2 = src cursor (= TMP1).
0003DAr 2  A5 20                lda     BAS_INDEX
0003DCr 2  85 22                sta     BAS_DEST
0003DEr 2  A5 21                lda     BAS_INDEX+1
0003E0r 2  85 23                sta     BAS_DEST+1
0003E2r 2               
0003E2r 2               @CopyLoop:
0003E2r 2                       ; Done when TMP1 == VARTAB.
0003E2r 2  A5 3A                lda     BAS_TMP1
0003E4r 2  CD 5F 03             cmp     BAS_VARTAB
0003E7r 2  A5 3B                lda     BAS_TMP1+1
0003E9r 2  ED 60 03             sbc     BAS_VARTAB+1
0003ECr 2  B0 14                bcs     @CopyDone
0003EEr 2               
0003EEr 2  A0 00                ldy     #0
0003F0r 2  B1 3A                lda     (BAS_TMP1),y
0003F2r 2  91 22                sta     (BAS_DEST),y
0003F4r 2               
0003F4r 2  E6 3A                inc     BAS_TMP1
0003F6r 2  D0 02                bne     @IncDest
0003F8r 2  E6 3B                inc     BAS_TMP1+1
0003FAr 2               @IncDest:
0003FAr 2  E6 22                inc     BAS_DEST
0003FCr 2  D0 E4                bne     @CopyLoop
0003FEr 2  E6 23                inc     BAS_DEST+1
000400r 2  80 E0                bra     @CopyLoop
000402r 2               
000402r 2               @CopyDone:
000402r 2                       ; VARTAB = DEST.
000402r 2  A5 22                lda     BAS_DEST
000404r 2  8D 5F 03             sta     BAS_VARTAB
000407r 2  A5 23                lda     BAS_DEST+1
000409r 2  8D 60 03             sta     BAS_VARTAB+1
00040Cr 2                       ; Mirror to ARYTAB/STREND (vars/arrays empty after edit; keep them
00040Cr 2                       ; tracking VARTAB).
00040Cr 2  8D 62 03             sta     BAS_ARYTAB+1
00040Fr 2  8D 64 03             sta     BAS_STREND+1
000412r 2  AD 5F 03             lda     BAS_VARTAB
000415r 2  8D 61 03             sta     BAS_ARYTAB
000418r 2  8D 63 03             sta     BAS_STREND
00041Br 2  60                   rts
00041Cr 2               
00041Cr 2               ; =============================================================================
00041Cr 2               ;   B a s I n s e r t A t I n d e x
00041Cr 2               ; =============================================================================
00041Cr 2               ; Splice a new line ([next-placeholder][num-lo][num-hi][payload][$00]) in
00041Cr 2               ; at BAS_INDEX, shifting following bytes upward.
00041Cr 2               ;
00041Cr 2               ; On entry : BAS_INDEX = insertion address, BAS_LINNUM = line number,
00041Cr 2               ;            BAS_TOKBUF = NUL-terminated payload (non-empty).
00041Cr 2               ; On exit  : Carry SET on success, CLEAR if not enough memory.
00041Cr 2               ;            VARTAB / ARYTAB / STREND advanced to new end-of-program.
00041Cr 2               ;
00041Cr 2               ; This is why a .prg's BASIC stub cannot be edited: the shift moves everything
00041Cr 2               ; up to VARTAB, and the new pointers come from the chain alone, so attached
00041Cr 2               ; machine code is both relocated and dropped from VARTAB's view.  Its addresses
00041Cr 2               ; are absolute, so it would break either way — the C64 has the same constraint.
00041Cr 2               ; =============================================================================
00041Cr 2               BasInsertAtIndex:
00041Cr 2                       ; Compute payload length L (excluding NUL): scan TOKBUF.
00041Cr 2  A0 00                ldy     #0
00041Er 2               @LenScan:
00041Er 2  B9 00 05             lda     BAS_TOKBUF,y
000421r 2  F0 03                beq     @LenDone
000423r 2  C8                   iny
000424r 2  D0 F8                bne     @LenScan
000426r 2               @LenDone:
000426r 2                       ; Total line size = 4 (header) + L + 1 (terminator) = L + 5.
000426r 2                       ; Store size in BAS_TMP3 (assumes <= 250+5 = 255, fits in one byte).
000426r 2  98                   tya
000427r 2  18                   clc
000428r 2  69 05                adc     #5
00042Ar 2  85 3E                sta     BAS_TMP3                ; line size in bytes (<=255)
00042Cr 2               
00042Cr 2                       ; Memory check: VARTAB + size <= MEMSIZ.
00042Cr 2  18                   clc
00042Dr 2  AD 5F 03             lda     BAS_VARTAB
000430r 2  65 3E                adc     BAS_TMP3
000432r 2  85 3A                sta     BAS_TMP1
000434r 2  AD 60 03             lda     BAS_VARTAB+1
000437r 2  69 00                adc     #0
000439r 2  85 3B                sta     BAS_TMP1+1
00043Br 2  A5 3A                lda     BAS_TMP1
00043Dr 2  CD 67 03             cmp     BAS_MEMSIZ
000440r 2  A5 3B                lda     BAS_TMP1+1
000442r 2  ED 68 03             sbc     BAS_MEMSIZ+1
000445r 2  90 02                bcc     @SizeOK
000447r 2  18                   clc                             ; out of memory
000448r 2  60                   rts
000449r 2               @SizeOK:
000449r 2                       ; Shift bytes [INDEX .. VARTAB-1] up by TMP3.
000449r 2                       ; Copy from high-to-low to avoid overlap clobber.
000449r 2                       ; src  = VARTAB-1
000449r 2                       ; dst  = VARTAB-1 + TMP3
000449r 2  AD 5F 03             lda     BAS_VARTAB
00044Cr 2  38                   sec
00044Dr 2  E9 01                sbc     #1
00044Fr 2  85 3A                sta     BAS_TMP1                ; src
000451r 2  AD 60 03             lda     BAS_VARTAB+1
000454r 2  E9 00                sbc     #0
000456r 2  85 3B                sta     BAS_TMP1+1
000458r 2  18                   clc
000459r 2  A5 3A                lda     BAS_TMP1
00045Br 2  65 3E                adc     BAS_TMP3
00045Dr 2  85 22                sta     BAS_DEST                ; dst
00045Fr 2  A5 3B                lda     BAS_TMP1+1
000461r 2  69 00                adc     #0
000463r 2  85 23                sta     BAS_DEST+1
000465r 2               @Shift:
000465r 2                       ; Stop when TMP1 < INDEX (i.e. INDEX-1 reached -> done).
000465r 2  A5 3A                lda     BAS_TMP1
000467r 2  C5 20                cmp     BAS_INDEX
000469r 2  A5 3B                lda     BAS_TMP1+1
00046Br 2  E5 21                sbc     BAS_INDEX+1
00046Dr 2  90 18                bcc     @ShiftDone
00046Fr 2               
00046Fr 2  A0 00                ldy     #0
000471r 2  B1 3A                lda     (BAS_TMP1),y
000473r 2  91 22                sta     (BAS_DEST),y
000475r 2               
000475r 2                       ; dec TMP1
000475r 2  A5 3A                lda     BAS_TMP1
000477r 2  D0 02                bne     @T1NoBorrow
000479r 2  C6 3B                dec     BAS_TMP1+1
00047Br 2               @T1NoBorrow:
00047Br 2  C6 3A                dec     BAS_TMP1
00047Dr 2                       ; dec DEST
00047Dr 2  A5 22                lda     BAS_DEST
00047Fr 2  D0 02                bne     @DNoBorrow
000481r 2  C6 23                dec     BAS_DEST+1
000483r 2               @DNoBorrow:
000483r 2  C6 22                dec     BAS_DEST
000485r 2  80 DE                bra     @Shift
000487r 2               
000487r 2               @ShiftDone:
000487r 2                       ; Write new line header at BAS_INDEX.
000487r 2  A0 00                ldy     #0
000489r 2  A9 FF                lda     #$FF                    ; placeholder next-ptr (Relink fixes)
00048Br 2  91 20                sta     (BAS_INDEX),y
00048Dr 2  C8                   iny
00048Er 2  91 20                sta     (BAS_INDEX),y
000490r 2  C8                   iny
000491r 2  A5 08                lda     BAS_LINNUM
000493r 2  91 20                sta     (BAS_INDEX),y
000495r 2  C8                   iny
000496r 2  A5 09                lda     BAS_LINNUM+1
000498r 2  91 20                sta     (BAS_INDEX),y
00049Ar 2  C8                   iny
00049Br 2               
00049Br 2                       ; Copy payload from BAS_TOKBUF (NUL terminator included).
00049Br 2  A2 00                ldx     #0
00049Dr 2               @PayloadCopy:
00049Dr 2  BD 00 05             lda     BAS_TOKBUF,x
0004A0r 2  91 20                sta     (BAS_INDEX),y
0004A2r 2  F0 04                beq     @PayloadDone
0004A4r 2  E8                   inx
0004A5r 2  C8                   iny
0004A6r 2  80 F5                bra     @PayloadCopy
0004A8r 2               @PayloadDone:
0004A8r 2                       ; Update VARTAB.
0004A8r 2  18                   clc
0004A9r 2  AD 5F 03             lda     BAS_VARTAB
0004ACr 2  65 3E                adc     BAS_TMP3
0004AEr 2  8D 5F 03             sta     BAS_VARTAB
0004B1r 2  AD 60 03             lda     BAS_VARTAB+1
0004B4r 2  69 00                adc     #0
0004B6r 2  8D 60 03             sta     BAS_VARTAB+1
0004B9r 2                       ; Mirror to ARYTAB/STREND.
0004B9r 2  AD 5F 03             lda     BAS_VARTAB
0004BCr 2  8D 61 03             sta     BAS_ARYTAB
0004BFr 2  8D 63 03             sta     BAS_STREND
0004C2r 2  AD 60 03             lda     BAS_VARTAB+1
0004C5r 2  8D 62 03             sta     BAS_ARYTAB+1
0004C8r 2  8D 64 03             sta     BAS_STREND+1
0004CBr 2               
0004CBr 2  38                   sec
0004CCr 2  60                   rts
0004CDr 2               
0004CDr 2               ; =============================================================================
0004CDr 2               ;   B a s R e l i n k
0004CDr 2               ; =============================================================================
0004CDr 2               ; Walk the program list and rewrite every next-pointer to the address of
0004CDr 2               ; the following line (computed by scanning forward to the line's NUL
0004CDr 2               ; terminator).  Stops when a next-pointer's high byte is already 0
0004CDr 2               ; (the [00][00] end-marker, which is left untouched).
0004CDr 2               ; =============================================================================
0004CDr 2               BasRelink:
0004CDr 2  AD 5D 03             lda     BAS_TXTTAB
0004D0r 2  85 20                sta     BAS_INDEX
0004D2r 2  AD 5E 03             lda     BAS_TXTTAB+1
0004D5r 2  85 21                sta     BAS_INDEX+1
0004D7r 2               @Loop:
0004D7r 2  A0 01                ldy     #1
0004D9r 2  B1 20                lda     (BAS_INDEX),y
0004DBr 2  F0 2B                beq     @Done                   ; end-marker reached
0004DDr 2               
0004DDr 2                       ; Find the NUL terminator at INDEX + Y for some Y >= 4.
0004DDr 2  A0 04                ldy     #4
0004DFr 2               @Scan:
0004DFr 2  B1 20                lda     (BAS_INDEX),y
0004E1r 2  F0 03                beq     @Found
0004E3r 2  C8                   iny
0004E4r 2  D0 F9                bne     @Scan
0004E6r 2               @Found:
0004E6r 2  C8                   iny                             ; one past NUL = next line address
0004E7r 2                       ; next = INDEX + Y
0004E7r 2  98                   tya
0004E8r 2  18                   clc
0004E9r 2  65 20                adc     BAS_INDEX
0004EBr 2  85 3A                sta     BAS_TMP1
0004EDr 2  A5 21                lda     BAS_INDEX+1
0004EFr 2  69 00                adc     #0
0004F1r 2  85 3B                sta     BAS_TMP1+1
0004F3r 2               
0004F3r 2                       ; Write new next-pointer at (INDEX),0/1.
0004F3r 2  A0 00                ldy     #0
0004F5r 2  A5 3A                lda     BAS_TMP1
0004F7r 2  91 20                sta     (BAS_INDEX),y
0004F9r 2  C8                   iny
0004FAr 2  A5 3B                lda     BAS_TMP1+1
0004FCr 2  91 20                sta     (BAS_INDEX),y
0004FEr 2               
0004FEr 2                       ; Advance INDEX = TMP1.
0004FEr 2  A5 3A                lda     BAS_TMP1
000500r 2  85 20                sta     BAS_INDEX
000502r 2  A5 3B                lda     BAS_TMP1+1
000504r 2  85 21                sta     BAS_INDEX+1
000506r 2  80 CF                bra     @Loop
000508r 2               @Done:
000508r 2  60                   rts
000509r 2               
000509r 2               ; =============================================================================
000509r 2               ;   B a s D i s p a t c h I m m e d i a t e
000509r 2               ; =============================================================================
000509r 2               ; Execute a tokenized line (BAS_TOKBUF) in immediate mode by entering the
000509r 2               ; statement loop (BasNewstt) with TXTPTR pointing one byte before the first
000509r 2               ; tokenized byte.  Re-anchors the CPU stack so that FOR / GOSUB frames
000509r 2               ; stored on the stack can be located by the scanners.
000509r 2               ; =============================================================================
000509r 2               BasDispatchImmediate:
000509r 2                       ; Write a ':' sentinel just before BAS_TOKBUF so NEWSTT's initial
000509r 2                       ; (TXTPTR),y read takes the @nextStmt path and CHRGETs the first token.
000509r 2  A9 3A                lda     #':'
00050Br 2  8D FF 04             sta     BAS_TOKBUF-1
00050Er 2  A9 FF                lda     #<(BAS_TOKBUF-1)
000510r 2  85 04                sta     TXTPTR
000512r 2  A9 04                lda     #>(BAS_TOKBUF-1)
000514r 2  85 05                sta     TXTPTR+1
000516r 2  9C 70 03             stz     BAS_POSX
000519r 2                       ; Direct mode: CURLIN = $FFFF (msbasic convention).
000519r 2  A9 FF                lda     #$FF
00051Br 2  8D 69 03             sta     BAS_CURLIN
00051Er 2  8D 6A 03             sta     BAS_CURLIN+1
000521r 2                       ; Re-anchor the CPU stack to the baseline, so the FOR / GOSUB frame
000521r 2                       ; scanners start from a known depth and nothing a previous direct line
000521r 2                       ; abandoned is still lying there.  The baseline is $FF with no program
000521r 2                       ; suspended, and the broken program's statement boundary after a
000521r 2                       ; STOP/END/Ctrl+C -- so its frames sit above this line's stack and are
000521r 2                       ; still there when CONT hands the program back.
000521r 2  AE 75 03             ldx     BAS_STKBASE
000524r 2  9A                   txs
000525r 2  4C rr rr             jmp     BasNewstt
000528r 2               
000528r 2               ; =============================================================================
000528r 2               ;   B a s C m d N e w
000528r 2               ; =============================================================================
000528r 2               ; Reset program storage to empty: write [00][00] at $0800 and reset the
000528r 2               ; runtime pointers.
000528r 2               ; =============================================================================
000528r 2               BasCmdNew:
000528r 2  9C 00 08             stz     BAS_PRG_START
00052Br 2  9C 01 08             stz     BAS_PRG_START+1
00052Er 2  A9 02                lda     #<(BAS_PRG_START+2)
000530r 2  8D 5F 03             sta     BAS_VARTAB
000533r 2  8D 61 03             sta     BAS_ARYTAB
000536r 2  8D 63 03             sta     BAS_STREND
000539r 2  A9 08                lda     #>(BAS_PRG_START+2)
00053Br 2  8D 60 03             sta     BAS_VARTAB+1
00053Er 2  8D 62 03             sta     BAS_ARYTAB+1
000541r 2  8D 64 03             sta     BAS_STREND+1
000544r 2  AD 67 03             lda     BAS_MEMSIZ
000547r 2  8D 65 03             sta     BAS_FRETOP
00054Ar 2  AD 68 03             lda     BAS_MEMSIZ+1
00054Dr 2  8D 66 03             sta     BAS_FRETOP+1
000550r 2                       ; And fall into CLR, as msbasic's SCRTCH does: the program that CONT
000550r 2                       ; would have resumed into has just been erased, so the saved position
000550r 2                       ; and the frames behind it have to go with it.
000550r 2  4C rr rr             jmp     BasCmdClr
000553r 2               
000553r 2               ; =============================================================================
000553r 2               ;   B a s C m d L i s t
000553r 2               ; =============================================================================
000553r 2               ; Print every stored line in order.  Each line: decimal line number, single
000553r 2               ; space, detokenized payload, CRLF.
000553r 2               ; =============================================================================
000553r 2               BasCmdList:
000553r 2  AD 5D 03             lda     BAS_TXTTAB
000556r 2  85 20                sta     BAS_INDEX
000558r 2  AD 5E 03             lda     BAS_TXTTAB+1
00055Br 2  85 21                sta     BAS_INDEX+1
00055Dr 2               @LineLoop:
00055Dr 2  A0 01                ldy     #1
00055Fr 2  B1 20                lda     (BAS_INDEX),y
000561r 2  F0 3D                beq     @Done                   ; end-marker
000563r 2                       ; Print line number.
000563r 2  A0 02                ldy     #2
000565r 2  B1 20                lda     (BAS_INDEX),y
000567r 2  85 08                sta     BAS_LINNUM
000569r 2  C8                   iny
00056Ar 2  B1 20                lda     (BAS_INDEX),y
00056Cr 2  85 09                sta     BAS_LINNUM+1
00056Er 2  20 rr rr             jsr     BasPrintLineNum
000571r 2  A9 20                lda     #' '
000573r 2  20 rr rr             jsr     Chrout
000576r 2               
000576r 2                       ; Detokenize from offset 4 to the NUL terminator.
000576r 2  A0 04                ldy     #4
000578r 2               @DetokLoop:
000578r 2  B1 20                lda     (BAS_INDEX),y
00057Ar 2  F0 12                beq     @LineEnd
00057Cr 2  30 06                bmi     @Token
00057Er 2  20 rr rr             jsr     Chrout
000581r 2  C8                   iny
000582r 2  80 F4                bra     @DetokLoop
000584r 2               @Token:
000584r 2  84 42                sty     BAS_DETOKY
000586r 2  20 rr rr             jsr     BasPrintKeyword         ; preserves nothing useful
000589r 2  A4 42                ldy     BAS_DETOKY
00058Br 2  C8                   iny
00058Cr 2  80 EA                bra     @DetokLoop
00058Er 2               @LineEnd:
00058Er 2  20 rr rr             jsr     BasPrintCRLF
000591r 2                       ; Advance INDEX via next-pointer.
000591r 2  A0 00                ldy     #0
000593r 2  B1 20                lda     (BAS_INDEX),y
000595r 2  48                   pha
000596r 2  C8                   iny
000597r 2  B1 20                lda     (BAS_INDEX),y
000599r 2  85 21                sta     BAS_INDEX+1
00059Br 2  68                   pla
00059Cr 2  85 20                sta     BAS_INDEX
00059Er 2  80 BD                bra     @LineLoop
0005A0r 2               @Done:
0005A0r 2  60                   rts
0005A1r 2               
0005A1r 2               ; =============================================================================
0005A1r 2               ;   B a s P r i n t L i n e N u m
0005A1r 2               ; =============================================================================
0005A1r 2               ; Print BAS_LINNUM (16-bit unsigned) as decimal (no leading zeros, no sign).
0005A1r 2               ; Thin shim over the KERNAL PrintDecU16 ($A096); the decimal-print core now
0005A1r 2               ; lives once in the KERNAL (shared with FsPrintSize).
0005A1r 2               ; Clobbers : A, X, Y, FS_FILE_SIZE, FS_DIR_IDX.
0005A1r 2               ; =============================================================================
0005A1r 2               BasPrintLineNum:
0005A1r 2  A5 08                lda     BAS_LINNUM
0005A3r 2  A6 09                ldx     BAS_LINNUM+1
0005A5r 2  4C rr rr             jmp     PrintDecU16
0005A8r 2               
0005A8r 2               ; =============================================================================
0005A8r 2               ;   B a s C m d P r i n t
0005A8r 2               ; =============================================================================
0005A8r 2               ; Immediate-mode PRINT.  X on entry = offset into BAS_TOKBUF where the
0005A8r 2               ; PRINT token sits.  Items separated by ';' (no separator) or ',' (advance
0005A8r 2               ; to next 14-column print zone).  Trailing ';' or ',' suppresses CRLF.
0005A8r 2               ;
0005A8r 2               ; Special-cased token: HEX(n) -> emit "$XXXX" hex form (does not call
0005A8r 2               ; FrmEvl; consumes the token + parens here).
0005A8r 2               ; =============================================================================
0005A8r 2               BasCmdPrint:
0005A8r 2                       ; TXTPTR is positioned with ChrGot returning TOK_PRINT.  Advance
0005A8r 2                       ; past the token; col counter is reset by the dispatcher's outer loop.
0005A8r 2  20 rr rr             jsr     ChrGet                  ; consume PRINT token
0005ABr 2               
0005ABr 2               BasPrLoop:
0005ABr 2  20 rr rr             jsr     ChrGot
0005AEr 2  D0 03 4C rr          jeq     BasPrEndNl
0005B2r 2  rr           
0005B3r 2  C9 3A                cmp     #':'
0005B5r 2  D0 03 4C rr          jeq     BasPrEndNl
0005B9r 2  rr           
0005BAr 2  C9 A4                cmp     #TOK_ELSE
0005BCr 2  D0 03 4C rr          jeq     BasPrEndNl
0005C0r 2  rr           
0005C1r 2  C9 3B                cmp     #';'
0005C3r 2  D0 03 4C rr          jeq     BasPrSep
0005C7r 2  rr           
0005C8r 2  C9 2C                cmp     #','
0005CAr 2  D0 03 4C rr          jeq     BasPrComma
0005CEr 2  rr           
0005CFr 2  C9 CE                cmp     #TOK_HEX
0005D1r 2  D0 17                bne     @chkTab
0005D3r 2                       ; HEX(n) in PRINT context: emit "$XXXX".
0005D3r 2  20 rr rr             jsr     ChrGet                  ; consume HEX
0005D6r 2  20 rr rr             jsr     ChkOpn
0005D9r 2  20 rr rr             jsr     FrmEvl
0005DCr 2  20 rr rr             jsr     ChkNum
0005DFr 2  20 rr rr             jsr     ChkCls
0005E2r 2                       ; Unsigned: AyInt is the signed conversion and rejects anything at or
0005E2r 2                       ; above 32768, so PRINT HEX() of any address in the top half of the
0005E2r 2                       ; map -- $8000, the RAM bank window the README documents -- raised
0005E2r 2                       ; ILLEGAL QUANTITY. A four-digit $xxxx covers 0..65535, and FacToU16
0005E2r 2                       ; leaves its result in the same FAC+3/FAC+4 PrintHex16 reads.
0005E2r 2  20 rr rr             jsr     FacToU16
0005E5r 2  20 rr rr             jsr     PrintHex16
0005E8r 2  80 6A                bra     BasPrAfter
0005EAr 2               @chkTab:
0005EAr 2  C9 9B                cmp     #TOK_TAB
0005ECr 2  D0 2D                bne     @chkSpc
0005EEr 2  20 rr rr             jsr     ChrGet                  ; consume TAB
0005F1r 2  20 rr rr             jsr     ChkOpn
0005F4r 2  20 rr rr             jsr     FrmNum
0005F7r 2  20 rr rr             jsr     ChkCls
0005FAr 2  20 rr rr             jsr     AyInt
0005FDr 2  A5 11                lda     FAC+3                   ; column count must fit in a byte
0005FFr 2  D0 53                bne     BasPrAfter
000601r 2  A5 12                lda     FAC+4
000603r 2  CD 70 03             cmp     BAS_POSX
000606r 2  90 4C                bcc     BasPrAfter              ; already at/past target column
000608r 2  38                   sec
000609r 2  ED 70 03             sbc     BAS_POSX
00060Cr 2  A8                   tay
00060Dr 2  F0 45                beq     BasPrAfter
00060Fr 2               @tabLoop:
00060Fr 2  5A                   phy
000610r 2  A9 20                lda     #' '
000612r 2  20 rr rr             jsr     PrintCh
000615r 2  7A                   ply
000616r 2  88                   dey
000617r 2  D0 F6                bne     @tabLoop
000619r 2  80 39                bra     BasPrAfter
00061Br 2               @chkSpc:
00061Br 2  C9 9E                cmp     #TOK_SPC
00061Dr 2  D0 23                bne     @expr
00061Fr 2  20 rr rr             jsr     ChrGet                  ; consume SPC
000622r 2  20 rr rr             jsr     ChkOpn
000625r 2  20 rr rr             jsr     FrmNum
000628r 2  20 rr rr             jsr     ChkCls
00062Br 2  20 rr rr             jsr     AyInt
00062Er 2  A5 11                lda     FAC+3
000630r 2  D0 22                bne     BasPrAfter
000632r 2  A4 12                ldy     FAC+4
000634r 2  F0 1E                beq     BasPrAfter
000636r 2               @spcLoop:
000636r 2  5A                   phy
000637r 2  A9 20                lda     #' '
000639r 2  20 rr rr             jsr     PrintCh
00063Cr 2  7A                   ply
00063Dr 2  88                   dey
00063Er 2  D0 F6                bne     @spcLoop
000640r 2  80 12                bra     BasPrAfter
000642r 2               @expr:
000642r 2  20 rr rr             jsr     FrmEvl
000645r 2  24 64                bit     VALTYP
000647r 2  30 05                bmi     @prStr
000649r 2  20 rr rr             jsr     PrintNum
00064Cr 2  80 06                bra     BasPrAfter
00064Er 2               @prStr:
00064Er 2  20 rr rr             jsr     PrintStrFAC
000651r 2  20 rr rr             jsr     FreFac
000654r 2               BasPrAfter:
000654r 2  20 rr rr             jsr     ChrGot
000657r 2  D0 03 4C rr          jeq     BasPrEndNl
00065Br 2  rr           
00065Cr 2  C9 3A                cmp     #':'
00065Er 2  D0 03 4C rr          jeq     BasPrEndNl
000662r 2  rr           
000663r 2  C9 A4                cmp     #TOK_ELSE
000665r 2  D0 03 4C rr          jeq     BasPrEndNl
000669r 2  rr           
00066Ar 2  C9 3B                cmp     #';'
00066Cr 2  D0 03 4C rr          jeq     BasPrSep
000670r 2  rr           
000671r 2  C9 2C                cmp     #','
000673r 2  D0 03 4C rr          jeq     BasPrComma
000677r 2  rr           
000678r 2  4C rr rr             jmp     SynErr
00067Br 2               BasPrSep:
00067Br 2  20 rr rr             jsr     ChrGet                  ; consume ;
00067Er 2  20 rr rr             jsr     ChrGot
000681r 2  F0 40                beq     BasPrEndNoNl            ; trailing ; -> no CRLF
000683r 2  C9 3A                cmp     #':'
000685r 2  F0 3C                beq     BasPrEndNoNl
000687r 2  4C rr rr             jmp     BasPrLoop
00068Ar 2               BasPrComma:
00068Ar 2  20 rr rr             jsr     ChrGet
00068Dr 2                       ; Pad to next multiple of 14 (MS-BASIC 14-column zone).
00068Dr 2                       ; col_mod = BAS_POSX mod 14; if 0 already at zone, else emit (14-col_mod) spaces.
00068Dr 2  AD 70 03             lda     BAS_POSX
000690r 2  85 3A                sta     BAS_TMP1
000692r 2               @modA:
000692r 2  A5 3A                lda     BAS_TMP1
000694r 2  C9 0E                cmp     #14
000696r 2  90 07                bcc     @modB
000698r 2  38                   sec
000699r 2  E9 0E                sbc     #14
00069Br 2  85 3A                sta     BAS_TMP1
00069Dr 2  80 F3                bra     @modA
00069Fr 2               @modB:
00069Fr 2  C9 00                cmp     #0
0006A1r 2  F0 0D                beq     @padDone
0006A3r 2               @padSp:
0006A3r 2  A9 20                lda     #' '
0006A5r 2  20 rr rr             jsr     PrintCh
0006A8r 2  E6 3A                inc     BAS_TMP1
0006AAr 2  A5 3A                lda     BAS_TMP1
0006ACr 2  C9 0E                cmp     #14
0006AEr 2  D0 F3                bne     @padSp
0006B0r 2               @padDone:
0006B0r 2  20 rr rr             jsr     ChrGot
0006B3r 2  F0 0E                beq     BasPrEndNoNl
0006B5r 2  C9 3A                cmp     #':'
0006B7r 2  F0 0A                beq     BasPrEndNoNl
0006B9r 2  4C rr rr             jmp     BasPrLoop
0006BCr 2               BasPrEndNl:
0006BCr 2  20 rr rr             jsr     BasPrintCRLF
0006BFr 2  9C 70 03             stz     BAS_POSX
0006C2r 2  60                   rts
0006C3r 2               BasPrEndNoNl:
0006C3r 2  60                   rts
0006C4r 2               
0006C4r 2               ; ---------------------------------------------------------------------------
0006C4r 2               ; PrintCh -- emit A through Chrout, maintaining BAS_POSX (CR resets it).
0006C4r 2               ; ---------------------------------------------------------------------------
0006C4r 2               PrintCh:
0006C4r 2  C9 0D                cmp     #$0D
0006C6r 2  F0 0C                beq     @cr
0006C8r 2  C9 0A                cmp     #$0A
0006CAr 2  F0 08                beq     @cr
0006CCr 2  48                   pha
0006CDr 2  EE 70 03             inc     BAS_POSX
0006D0r 2  68                   pla
0006D1r 2  4C rr rr             jmp     Chrout
0006D4r 2               @cr:
0006D4r 2  9C 70 03             stz     BAS_POSX
0006D7r 2  4C rr rr             jmp     Chrout
0006DAr 2               
0006DAr 2               ; ---------------------------------------------------------------------------
0006DAr 2               ; PrintNum -- emit FAC as ASCII via Fout, tracking column.
0006DAr 2               ; ---------------------------------------------------------------------------
0006DAr 2               PrintNum:
0006DAr 2  20 rr rr             jsr     Fout                    ; (Y,A) = NUL-terminated buffer
0006DDr 2  85 20                sta     INDEX
0006DFr 2  84 21                sty     INDEX+1
0006E1r 2  A0 00                ldy     #0
0006E3r 2               @loop:
0006E3r 2  B1 20                lda     (INDEX),y
0006E5r 2  F0 06                beq     @done
0006E7r 2  20 rr rr             jsr     PrintCh
0006EAr 2  C8                   iny
0006EBr 2  D0 F6                bne     @loop
0006EDr 2               @done:
0006EDr 2  60                   rts
0006EEr 2               
0006EEr 2               ; ---------------------------------------------------------------------------
0006EEr 2               ; PrintStrFAC -- emit string-descriptor at FAC..FAC+2.
0006EEr 2               ; ---------------------------------------------------------------------------
0006EEr 2               PrintStrFAC:
0006EEr 2  A5 0F                lda     FAC+1
0006F0r 2  85 20                sta     INDEX
0006F2r 2  A5 10                lda     FAC+2
0006F4r 2  85 21                sta     INDEX+1
0006F6r 2  A0 00                ldy     #0
0006F8r 2               @loop:
0006F8r 2  C4 0E                cpy     FAC
0006FAr 2  F0 08                beq     @done
0006FCr 2  B1 20                lda     (INDEX),y
0006FEr 2  20 rr rr             jsr     PrintCh
000701r 2  C8                   iny
000702r 2  80 F4                bra     @loop
000704r 2               @done:
000704r 2  60                   rts
000705r 2               
000705r 2               ; ---------------------------------------------------------------------------
000705r 2               ; PrintHex16 -- emit FAC+3,FAC+4 (lo,hi) as "$XXXX".
000705r 2               ; ---------------------------------------------------------------------------
000705r 2               PrintHex16:
000705r 2  A9 24                lda     #'$'
000707r 2  20 rr rr             jsr     PrintCh
00070Ar 2  A5 11                lda     FAC+3
00070Cr 2  20 rr rr             jsr     PrintHexByte
00070Fr 2  A5 12                lda     FAC+4
000711r 2                       ; fall through
000711r 2               PrintHexByte:
000711r 2  48                   pha
000712r 2  4A                   lsr     a
000713r 2  4A                   lsr     a
000714r 2  4A                   lsr     a
000715r 2  4A                   lsr     a
000716r 2  20 rr rr             jsr     @nib
000719r 2  68                   pla
00071Ar 2  29 0F                and     #$0F
00071Cr 2               @nib:
00071Cr 2  C9 0A                cmp     #10
00071Er 2  90 02                bcc     @dig
000720r 2  69 06                adc     #'A'-'9'-2              ; +'A'-10-1 (carry already set)
000722r 2               @dig:
000722r 2  69 30                adc     #'0'
000724r 2  4C rr rr             jmp     PrintCh
000727r 2               
000727r 2               ; =============================================================================
000727r 2               ;   B a s P r i n t K e y w o r d
000727r 2               ; =============================================================================
000727r 2               ; Print the keyword whose token byte is in A (bit 7 set).
000727r 2               ; Walks the keyword table to find entry (A - TOK_BASE) and prints its chars.
000727r 2               ; =============================================================================
000727r 2               BasPrintKeyword:
000727r 2  38                   sec
000728r 2  E9 80                sbc     #TOK_BASE               ; A = index
00072Ar 2  AA                   tax
00072Br 2                       ; Walk via 16-bit BAS_KWPTR since the table is > 256 bytes.
00072Br 2  A9 rr                lda     #<KeywordTbl
00072Dr 2  85 61                sta     BAS_KWPTR
00072Fr 2  A9 rr                lda     #>KeywordTbl
000731r 2  85 62                sta     BAS_KWPTR+1
000733r 2  A0 00                ldy     #0
000735r 2               @FindLoop:
000735r 2  E0 00                cpx     #0
000737r 2  F0 0F                beq     @PrintIt
000739r 2                       ; Skip current keyword: walk byte-by-byte until we consume a byte
000739r 2                       ; whose bit 7 is set (last char of the keyword).
000739r 2               @Skip:
000739r 2  B1 61                lda     (BAS_KWPTR),y           ; Y == 0
00073Br 2  E6 61                inc     BAS_KWPTR
00073Dr 2  D0 02                bne     @SkipNoCarry
00073Fr 2  E6 62                inc     BAS_KWPTR+1
000741r 2               @SkipNoCarry:
000741r 2  C9 80                cmp     #$80                    ; C set iff loaded byte >= $80
000743r 2  90 F4                bcc     @Skip
000745r 2               @SkipEnd:
000745r 2  CA                   dex
000746r 2  80 ED                bra     @FindLoop
000748r 2               @PrintIt:
000748r 2               @PrintLoop:
000748r 2  B1 61                lda     (BAS_KWPTR),y           ; Y == 0
00074Ar 2  E6 61                inc     BAS_KWPTR
00074Cr 2  D0 02                bne     @PrintNoCarry
00074Er 2  E6 62                inc     BAS_KWPTR+1
000750r 2               @PrintNoCarry:
000750r 2  48                   pha
000751r 2  29 7F                and     #$7F
000753r 2  20 rr rr             jsr     Chrout
000756r 2  68                   pla
000757r 2  10 EF                bpl     @PrintLoop
000759r 2  60                   rts
00075Ar 2               
00075Ar 2               ; =============================================================================
00075Ar 2               ;   E R R O R   H A N D L I N G
00075Ar 2               ; =============================================================================
00075Ar 2               
00075Ar 2               BasErrSyntax:
00075Ar 2  A9 00                lda     #ERR_SYNTAX
00075Cr 2                       ; fall through
00075Cr 2               
00075Cr 2               ; BasError - print "?<msg> ERROR[ IN nnnn]" and return to the REPL.
00075Cr 2               ;   Input: A = error code (index into ErrorMessages).
00075Cr 2               ;   Resets the stack, prints, and jumps to BasReadyLoop.
00075Cr 2               BasError:
00075Cr 2  85 3E                sta     BAS_TMP3                ; stash code (stack reset wipes A on stack)
00075Er 2  A2 FF                ldx     #$FF
000760r 2  9A                   txs
000761r 2  8E 75 03             stx     BAS_STKBASE
000764r 2                       ; An error can strike anywhere -- part-way through an expression, deep
000764r 2                       ; in a string function -- so unlike a STOP there is no boundary to
000764r 2                       ; unwind to and the FOR/GOSUB frames go with it.  Saying CAN'T CONTINUE
000764r 2                       ; is then the honest answer: resuming onto a frame that is no longer
000764r 2                       ; there is how ?NEXT WITHOUT FOR turns up two statements later.
000764r 2  9C 6E 03             stz     BAS_OLDTEXT+1
000767r 2  20 rr rr             jsr     BasPrintCRLF
00076Ar 2  A9 3F                lda     #'?'
00076Cr 2  20 rr rr             jsr     Chrout
00076Fr 2  A5 3E                lda     BAS_TMP3
000771r 2                       ; A = error code; print the matching message.
000771r 2  20 rr rr             jsr     BasPrintErrorMsg
000774r 2                       ; Append " ERROR" and (if not direct mode) line number.
000774r 2  A9 rr                lda     #<MsgErrorWord
000776r 2  A0 rr                ldy     #>MsgErrorWord
000778r 2  20 rr rr             jsr     BasPrintStr
00077Br 2  4C rr rr             jmp     BasStopAtLine
00077Er 2               
00077Er 2               ; BasStopAtLine / BasStopDirect - the tail every "stop and go back to the
00077Er 2               ;   prompt" path shares: an error, a STOP, a Ctrl+C break.
00077Er 2               ;
00077Er 2               ;   BasStopAtLine appends " IN nnnn" when a program is running and says nothing
00077Er 2               ;   in direct mode; BasStopDirect skips straight past that, for the caller that
00077Er 2               ;   has already decided there is no line to name.  Both then mark direct mode
00077Er 2               ;   and bounce to the REPL.
00077Er 2               ;
00077Er 2               ;   Entered with a jmp, never a jsr - it does not come back, and every caller
00077Er 2               ;   has already put the stack pointer where it belongs: an error resets it to
00077Er 2               ;   $FF, a STOP or a break winds it back to BAS_STKBASE so the program's FOR
00077Er 2               ;   and GOSUB frames are still there for CONT.
00077Er 2               BasStopAtLine:
00077Er 2  AD 6A 03             lda     BAS_CURLIN+1
000781r 2  C9 FF                cmp     #$FF
000783r 2  F0 14                beq     BasStopDirect
000785r 2  A9 rr                lda     #<MsgInWord
000787r 2  A0 rr                ldy     #>MsgInWord
000789r 2  20 rr rr             jsr     BasPrintStr
00078Cr 2  AD 69 03             lda     BAS_CURLIN
00078Fr 2  85 08                sta     BAS_LINNUM
000791r 2  AD 6A 03             lda     BAS_CURLIN+1
000794r 2  85 09                sta     BAS_LINNUM+1
000796r 2  20 rr rr             jsr     BasPrintLineNum
000799r 2               BasStopDirect:
000799r 2                       ; Mark direct mode and bounce back to REPL.
000799r 2  A9 FF                lda     #$FF
00079Br 2  8D 69 03             sta     BAS_CURLIN
00079Er 2  8D 6A 03             sta     BAS_CURLIN+1
0007A1r 2  4C rr rr             jmp     BasReadyLoop
0007A4r 2               
0007A4r 2               ; BasPrintErrorMsg - print message #A from the error-message table.
0007A4r 2               ;   Each message is NUL-terminated; the table is a sequence of those.
0007A4r 2               BasPrintErrorMsg:
0007A4r 2  AA                   tax
0007A5r 2  A9 rr                lda     #<ErrorMessages
0007A7r 2  85 3A                sta     BAS_TMP1
0007A9r 2  A9 rr                lda     #>ErrorMessages
0007ABr 2  85 3B                sta     BAS_TMP1+1
0007ADr 2               @Skip:
0007ADr 2  E0 00                cpx     #0
0007AFr 2  F0 17                beq     @Print
0007B1r 2                       ; Walk past one message (advance until NUL, then one more).
0007B1r 2               @SkipLoop:
0007B1r 2  A0 00                ldy     #0
0007B3r 2  B1 3A                lda     (BAS_TMP1),y
0007B5r 2  F0 08                beq     @SkipDone
0007B7r 2  E6 3A                inc     BAS_TMP1
0007B9r 2  D0 F6                bne     @SkipLoop
0007BBr 2  E6 3B                inc     BAS_TMP1+1
0007BDr 2  80 F2                bra     @SkipLoop
0007BFr 2               @SkipDone:
0007BFr 2  E6 3A                inc     BAS_TMP1
0007C1r 2  D0 02                bne     @SkippedHi
0007C3r 2  E6 3B                inc     BAS_TMP1+1
0007C5r 2               @SkippedHi:
0007C5r 2  CA                   dex
0007C6r 2  80 E5                bra     @Skip
0007C8r 2               @Print:
0007C8r 2  A5 3A                lda     BAS_TMP1
0007CAr 2  A4 3B                ldy     BAS_TMP1+1
0007CCr 2  4C rr rr             jmp     BasPrintStr
0007CFr 2               
0007CFr 2               
0007CFr 2               ; =============================================================================
0007CFr 2               ;   F L O A T I N G - P O I N T   R U N T I M E
0007CFr 2               ;
0007CFr 2               ;   Externals required by the inlined MSBASIC FP code:
0007CFr 2               ;     ChrGet   - advance TXTPTR and load next non-space tokenized char
0007CFr 2               ;                (used by Fin; never exercised by the FP tests).
0007CFr 2               ;     BasErrorVec    - error vector; X = error code
0007CFr 2               ;     IqErr    - "?ILLEGAL QUANTITY" entry
0007CFr 2               ;     STROUT   - print NUL-terminated string at (A=lo, Y=hi)
0007CFr 2               ;     QtIn    - the literal " IN " string (used only by InPrt)
0007CFr 2               ; =============================================================================
0007CFr 2               
0007CFr 2               ; --- ChrGet / ChrGot --------------------------------------------------------
0007CFr 2               ; Real implementation (ROM, not ZP self-modifying).  Increments TXTPTR and
0007CFr 2               ; returns the next non-space byte at (TXTPTR) in A, with carry CLEAR if the
0007CFr 2               ; byte is a digit '0'-'9'.  ChrGot re-reads the current byte without
0007CFr 2               ; advancing first.  Both clobber only A and flags.
0007CFr 2               ;
0007CFr 2               ; Side effects on flags after the routine returns:
0007CFr 2               ;   Z=1  if A == $00 or A is a tokenized/keyword byte that wraps to zero
0007CFr 2               ;        (used by callers checking end-of-statement).
0007CFr 2               ;   C=0  if A is a digit ('0'-'9'); else C=1.
0007CFr 2               ;
0007CFr 2               ; Implementation matches msbasic-master/chrget.s.
0007CFr 2               ChrGet:
0007CFr 2  E6 04                inc     TXTPTR
0007D1r 2  D0 02                bne     ChrGot
0007D3r 2  E6 05                inc     TXTPTR+1
0007D5r 2               ChrGot:
0007D5r 2  B2 04                lda     (TXTPTR)
0007D7r 2  C9 3A                cmp     #':'
0007D9r 2  B0 0A                bcs     @out
0007DBr 2  C9 20                cmp     #' '
0007DDr 2  F0 F0                beq     ChrGet
0007DFr 2  38                   sec
0007E0r 2  E9 30                sbc     #'0'
0007E2r 2  38                   sec
0007E3r 2  E9 D0                sbc     #$D0                    ; restore A; sets C=0 iff digit
0007E5r 2               @out:
0007E5r 2  60                   rts
0007E6r 2               
0007E6r 2               ; --- Error trampolines ------------------------------------------------------
0007E6r 2               ; The MSBASIC convention is "ldx #code / jmp ERROR".  Our BasError takes
0007E6r 2               ; the code in A, so translate.
0007E6r 2               BasErrorVec:
0007E6r 2  8A                   txa
0007E7r 2  4C rr rr             jmp     BasError
0007EAr 2               
0007EAr 2               IqErr:
0007EAr 2  A2 0B                ldx     #ERR_ILLQUAN
0007ECr 2  4C rr rr             jmp     BasErrorVec
0007EFr 2               
0007EFr 2               ; --- String output ----------------------------------------------------------
0007EFr 2               ; FP code calls STROUT with (A=lo, Y=hi).  BasPrintStr matches that ABI.
0007EFr 2               STROUT          := BasPrintStr
