0028A7r 2               
0028A7r 2               ; VOL n
0028A7r 2               BasCmdVol:
0028A7r 2  A9 40                lda     #HW_SID
0028A9r 2  20 rr rr             jsr     ReqHw
0028ACr 2  20 rr rr             jsr     GetByt                  ; X = vol
0028AFr 2  E0 10                cpx     #16                     ; Documented range is 0-15.  SidSetVolume
0028B1r 2  B0 04                bcs     BasSidRange             ;   masks to 4 bits, so an unchecked 16
0028B3r 2  8A                   txa                             ;   would set volume 0 — silence, for
0028B4r 2  4C rr rr             jmp     SidSetVolume            ;   "louder than maximum"
0028B7r 2               
0028B7r 2               ; Shared by VOL and SOUND below: both reject out of range, and one trampoline
0028B7r 2               ; is 3 bytes cheaper than two in a segment that has none to spare.
0028B7r 2               BasSidRange:
0028B7r 2  4C rr rr             jmp     IqErr
0028BAr 2               
0028BAr 2               ; SOUND voice, freq, dur (freq=Hz, dur=centisec)
0028BAr 2               ;   Hz -> SID register: reg = Hz * 16.75 ≈ Hz<<4 + Hz - Hz/4
0028BAr 2               BasCmdSound:
0028BAr 2  A9 40                lda     #HW_SID
0028BCr 2  20 rr rr             jsr     ReqHw
0028BFr 2  20 rr rr             jsr     GetByt                  ; X = voice (1..3)
0028C2r 2  CA                   dex                             ; 0-indexed for SidPlayNote
0028C3r 2  E0 03                cpx     #3                      ; Voice 0 underflows to $FF, so one
0028C5r 2  B0 F0                bcs     BasSidRange             ;   unsigned test catches both ends
0028C7r 2  DA                   phx                             ; voice (0-indexed) on stack
0028C8r 2  20 rr rr             jsr     ChkCom
0028CBr 2  20 rr rr             jsr     EvalU16                 ; freq Hz: hi=FAC+3, lo=FAC+4
0028CEr 2                       ; Compute reg = Hz<<4 + Hz - Hz/4
0028CEr 2  A5 12                lda     FAC+4
0028D0r 2  85 3A                sta     BAS_TMP1
0028D2r 2  A5 11                lda     FAC+3
0028D4r 2  85 3B                sta     BAS_TMP1+1
0028D6r 2  A5 3A                lda     BAS_TMP1
0028D8r 2  85 3C                sta     BAS_TMP2
0028DAr 2  A5 3B                lda     BAS_TMP1+1
0028DCr 2  85 3D                sta     BAS_TMP2+1
0028DEr 2  A2 04                ldx     #4
0028E0r 2               @shl:
0028E0r 2  06 3A                asl     BAS_TMP1
0028E2r 2  26 3B                rol     BAS_TMP1+1
0028E4r 2  CA                   dex
0028E5r 2  D0 F9                bne     @shl
0028E7r 2  18                   clc
0028E8r 2  A5 3A                lda     BAS_TMP1
0028EAr 2  65 3C                adc     BAS_TMP2
0028ECr 2  85 3A                sta     BAS_TMP1
0028EEr 2  A5 3B                lda     BAS_TMP1+1
0028F0r 2  65 3D                adc     BAS_TMP2+1
0028F2r 2  85 3B                sta     BAS_TMP1+1
0028F4r 2  46 3D                lsr     BAS_TMP2+1
0028F6r 2  66 3C                ror     BAS_TMP2
0028F8r 2  46 3D                lsr     BAS_TMP2+1
0028FAr 2  66 3C                ror     BAS_TMP2
0028FCr 2  38                   sec
0028FDr 2  A5 3A                lda     BAS_TMP1
0028FFr 2  E5 3C                sbc     BAS_TMP2
002901r 2  48                   pha                             ; freqLo
002902r 2  A5 3B                lda     BAS_TMP1+1
002904r 2  E5 3D                sbc     BAS_TMP2+1
002906r 2  48                   pha                             ; freqHi
002907r 2  20 rr rr             jsr     ChkCom
00290Ar 2  20 rr rr             jsr     EvalU16                 ; dur in FAC+3/+4
00290Dr 2                       ; Stack (top-down): freqHi, freqLo, voice
00290Dr 2  7A                   ply                             ; Y = freqHi
00290Er 2  FA                   plx                             ; X = freqLo
00290Fr 2  68                   pla                             ; A = voice
002910r 2  20 rr rr             jsr     SidPlayNote
002913r 2  A5 12                lda     FAC+4
002915r 2  A6 11                ldx     FAC+3
002917r 2  20 rr rr             jsr     SysDelay
