00197Er 2               @cat:
00197Er 2  20 rr rr             jsr     CatStr
001981r 2  80 AE                bra     @loop
001983r 2               
001983r 2               ; ---------------------------------------------------------------------------
001983r 2               ; CatStr -- concatenate ARG (left) + FAC (right), result in FAC.
001983r 2               ; ---------------------------------------------------------------------------
001983r 2               CatStr:
001983r 2                       ; Stash right's length+addr before we overwrite FAC.
001983r 2  A5 0E                lda     FAC
001985r 2  85 4D                sta     BAS_TEMP1               ; right len
001987r 2  A5 0F                lda     FAC+1
001989r 2  85 4E                sta     BAS_TEMP1+1
00198Br 2  A5 10                lda     FAC+2
00198Dr 2  85 4F                sta     BAS_TEMP1+2
00198Fr 2                       ; Total length = ARG + FAC; abort if > 255.
00198Fr 2  18                   clc
001990r 2  A5 16                lda     ARG
001992r 2  65 4D                adc     BAS_TEMP1
001994r 2  B0 40                bcs     @tooLong
001996r 2  85 50                sta     BAS_TEMP1+3             ; total length
001998r 2                       ; Free both source temps before allocating result -- otherwise we
001998r 2                       ; pile up to 3 temps and the next PutNew throws ?FRMCPX.
001998r 2  20 rr rr             jsr     FreeBothTemps
00199Br 2                       ; Allocate.
00199Br 2  A5 50                lda     BAS_TEMP1+3             ; total length
00199Dr 2  20 rr rr             jsr     GetSpa                  ; A=total, FRESPC=buf
0019A0r 2                       ; Copy left bytes (ARG -> FRESPC).
0019A0r 2  A5 17                lda     ARG+1
0019A2r 2  85 20                sta     INDEX
0019A4r 2  A5 18                lda     ARG+2
0019A6r 2  85 21                sta     INDEX+1
0019A8r 2  A5 16                lda     ARG
0019AAr 2  F0 03                beq     @right
0019ACr 2  20 rr rr             jsr     MovStr1                 ; advances FRESPC by len
0019AFr 2               @right:
0019AFr 2                       ; Copy right bytes.
0019AFr 2  A5 4E                lda     BAS_TEMP1+1
0019B1r 2  85 20                sta     INDEX
0019B3r 2  A5 4F                lda     BAS_TEMP1+2
0019B5r 2  85 21                sta     INDEX+1
0019B7r 2  A5 4D                lda     BAS_TEMP1
0019B9r 2  F0 03                beq     @desc
0019BBr 2  20 rr rr             jsr     MovStr1
0019BEr 2               @desc:
0019BEr 2                       ; Descriptor: FAC := total len, FAC+1/2 := FRESPC - total.
0019BEr 2  A5 50                lda     BAS_TEMP1+3
0019C0r 2  85 0E                sta     FAC
0019C2r 2  38                   sec
0019C3r 2  A5 84                lda     FRESPC
0019C5r 2  E5 50                sbc     BAS_TEMP1+3
0019C7r 2  85 0F                sta     FAC+1
0019C9r 2  A5 85                lda     FRESPC+1
0019CBr 2  E9 00                sbc     #0
0019CDr 2  85 10                sta     FAC+2
0019CFr 2  A9 FF                lda     #$FF
0019D1r 2  85 64                sta     VALTYP
0019D3r 2  4C rr rr             jmp     PutNew
0019D6r 2               @tooLong:
0019D6r 2  A2 09                ldx     #ERR_STRLONG
0019D8r 2  4C rr rr             jmp     BasErrorVec
0019DBr 2               
0019DBr 2               ; ===========================================================================
0019DBr 2               ;   L E V E L 5  --  * / /
0019DBr 2               ; ===========================================================================
0019DBr 2               EvalMul:
0019DBr 2  20 rr rr             jsr     EvalPow
0019DEr 2               @loop:
0019DEr 2  20 rr rr             jsr     ChrGot
0019E1r 2  C9 2A                cmp     #'*'
0019E3r 2  F0 05                beq     @mul
0019E5r 2  C9 2F                cmp     #'/'
0019E7r 2  F0 27                beq     @div
0019E9r 2  60                   rts
0019EAr 2               @mul:
0019EAr 2  20 rr rr             jsr     ChkNum
0019EDr 2  20 rr rr             jsr     ChrGet
0019F0r 2  20 rr rr             jsr     PushFac
0019F3r 2  20 rr rr             jsr     EvalPow
0019F6r 2  20 rr rr             jsr     ChkNum
0019F9r 2  20 rr rr             jsr     PullArg
0019FCr 2  A5 86                lda     BAS_LVTYP
0019FEr 2  10 03 4C rr          jmi     EvalTypeErr
001A02r 2  rr           
001A03r 2                       ; FAC = ARG * FAC: FMultT expects ARG + sign work.  See msbasic.
001A03r 2  A5 1B                lda     ARGSIGN
001A05r 2  45 13                eor     FACSIGN
001A07r 2  85 1C                sta     SGNCPR
001A09r 2  A5 0E                lda     FAC
001A0Br 2  20 rr rr             jsr     FMultT
001A0Er 2  80 CE                bra     @loop
001A10r 2               @div:
001A10r 2  20 rr rr             jsr     ChkNum
001A13r 2  20 rr rr             jsr     ChrGet
001A16r 2  20 rr rr             jsr     PushFac
001A19r 2  20 rr rr             jsr     EvalPow
001A1Cr 2  20 rr rr             jsr     ChkNum
001A1Fr 2  20 rr rr             jsr     PullArg
001A22r 2  A5 86                lda     BAS_LVTYP
001A24r 2  10 03 4C rr          jmi     EvalTypeErr
001A28r 2  rr           
001A29r 2                       ; FAC = ARG / FAC: FDivT.
001A29r 2  A5 1B                lda     ARGSIGN
001A2Br 2  45 13                eor     FACSIGN
001A2Dr 2  85 1C                sta     SGNCPR
001A2Fr 2  A5 0E                lda     FAC
001A31r 2  20 rr rr             jsr     FDivT
001A34r 2  80 A8                bra     @loop
001A36r 2               
001A36r 2               ; ===========================================================================
001A36r 2               ;   L E V E L 6  --  ^   (right-associative)
001A36r 2               ; ===========================================================================
001A36r 2               EvalPow:
001A36r 2  20 rr rr             jsr     EvalUnary
001A39r 2               @loop:
001A39r 2  20 rr rr             jsr     ChrGot
001A3Cr 2  C9 5E                cmp     #'^'
001A3Er 2  D0 20                bne     @done
001A40r 2  20 rr rr             jsr     ChkNum
001A43r 2  20 rr rr             jsr     ChrGet
001A46r 2  20 rr rr             jsr     PushFac
001A49r 2  20 rr rr             jsr     EvalUnary               ; right-assoc: recurse below
001A4Cr 2                       ; Actually right-assoc means: evaluate the RHS at this level too.
001A4Cr 2                       ; But EvalUnary doesn't loop ^; it stops.  Re-check ^ here?  No --
001A4Cr 2                       ; for right-assoc we should recurse at the same level for the RHS.
001A4Cr 2                       ; Simpler: after EvalUnary, look for another ^ and recurse.
001A4Cr 2                       ; Implemented by jumping back to @loop (so chained ^ becomes
001A4Cr 2                       ; left-assoc in this version).  Acceptable simplification.
001A4Cr 2  20 rr rr             jsr     ChkNum
001A4Fr 2  20 rr rr             jsr     PullArg
001A52r 2  A5 86                lda     BAS_LVTYP
001A54r 2  10 03 4C rr          jmi     EvalTypeErr
001A58r 2  rr           
001A59r 2                       ; FPwrt computes ARG ^ FAC.  Our ported FPwrt expects ARG = base,
001A59r 2                       ; FAC = exponent, and A = FAC's exponent byte (FPwrt's first
001A59r 2                       ; instruction is `beq Exp` to short-circuit FAC==0 -> 1).
001A59r 2  A5 0E                lda     FAC
001A5Br 2  20 rr rr             jsr     FPwrt
001A5Er 2  80 D9                bra     @loop
001A60r 2               @done:
001A60r 2  60                   rts
001A61r 2               
001A61r 2               ; ===========================================================================
001A61r 2               ;   L E V E L 7  --  U N A R Y
001A61r 2               ; ===========================================================================
001A61r 2               EvalUnary:
001A61r 2  20 rr rr             jsr     ChrGot
001A64r 2  C9 2D                cmp     #'-'
001A66r 2  F0 07                beq     @neg
001A68r 2  C9 2B                cmp     #'+'
001A6Ar 2  F0 13                beq     @pos
001A6Cr 2  4C rr rr             jmp     EvalAtom
001A6Fr 2               @neg:
001A6Fr 2  20 rr rr             jsr     ChrGet
001A72r 2  20 rr rr             jsr     EvalUnary
001A75r 2  20 rr rr             jsr     ChkNum
001A78r 2                       ; Negate FAC: flip FACSIGN bit 7.
001A78r 2  A5 13                lda     FACSIGN
001A7Ar 2  49 FF                eor     #$FF
001A7Cr 2  85 13                sta     FACSIGN
001A7Er 2  60                   rts
001A7Fr 2               @pos:
001A7Fr 2  20 rr rr             jsr     ChrGet
001A82r 2  4C rr rr             jmp     EvalUnary
001A85r 2               
001A85r 2               ; ===========================================================================
001A85r 2               ;   L E V E L 8  --  A T O M
001A85r 2               ; ===========================================================================
001A85r 2               EvalAtom:
001A85r 2  64 64                stz     VALTYP                  ; default to numeric; string paths override
001A87r 2  20 rr rr             jsr     ChrGot
001A8Ar 2  90 2E                bcc     @num                    ; digit
001A8Cr 2  C9 2E                cmp     #'.'
001A8Er 2  F0 2A                beq     @num
001A90r 2  C9 22                cmp     #'"'
001A92r 2  F0 29                beq     @str
001A94r 2  C9 28                cmp     #'('
001A96r 2  F0 3D                beq     @paren
001A98r 2                       ; Letter? -> variable
001A98r 2  20 rr rr             jsr     IsLetC
001A9Br 2  B0 41                bcs     @var
001A9Dr 2                       ; Function token?
001A9Dr 2  C9 CD                cmp     #TOK_INKEY
001A9Fr 2  F0 64                beq     FnInkey
001AA1r 2  C9 9D                cmp     #TOK_FN
001AA3r 2  F0 12                beq     @fnCall                 ; FN A(...) — user-defined function
001AA5r 2                       ; Hex literal in PRINT context: not here (no '$' literal supported).
001AA5r 2                       ; NVRAM is dual-role (statement at $B1, function via FnTable);
001AA5r 2                       ; allow it through even though it sits below TOK_SGN.
001AA5r 2  C9 B1                cmp     #TOK_NVRAM
001AA7r 2  F0 08                beq     @fnDisp
001AA9r 2                       ; Try function dispatch.
001AA9r 2  C9 B6                cmp     #TOK_SGN
001AABr 2  90 07                bcc     @synErr
001AADr 2  C9 D1                cmp     #TOK_MAX+1
001AAFr 2  B0 03                bcs     @synErr
001AB1r 2               @fnDisp:
001AB1r 2  4C rr rr             jmp     FnDispatch
001AB4r 2               @synErr:
001AB4r 2  4C rr rr             jmp     SynErr
001AB7r 2               @fnCall:
001AB7r 2  4C rr rr             jmp     FnCall
001ABAr 2               @num:
001ABAr 2                       ; ASCII numeric: jump to Fin.  Fin uses ChrGet to consume.
001ABAr 2  4C rr rr             jmp     Fin
001ABDr 2               @str:
001ABDr 2                       ; '"' string literal.  Advance past the opening quote WITHOUT ChrGet:
001ABDr 2                       ; ChrGet skips spaces, which would strip leading spaces inside the
001ABDr 2                       ; string literal (e.g. PRINT "   X").  Bump TXTPTR by one byte instead.
001ABDr 2  E6 04                inc     TXTPTR
001ABFr 2  D0 02                bne     @strsrc
001AC1r 2  E6 05                inc     TXTPTR+1
001AC3r 2               @strsrc:
001AC3r 2                       ; StrLit expects (Y,A) = src.  Source = TXTPTR.
001AC3r 2  A5 04                lda     TXTPTR
001AC5r 2  A4 05                ldy     TXTPTR+1
001AC7r 2  20 rr rr             jsr     StrLit
001ACAr 2                       ; StrLit advances internal pointer; we need to update TXTPTR.
001ACAr 2                       ; StrLit reads until $00 or '"' from (STRNG1)+y; FAC has length.
001ACAr 2                       ; Compute new TXTPTR = STRNG2 (which StrLit set), or TXTPTR + len + maybe-quote.
001ACAr 2                       ; STRNG2 = STRNG1 + len + (1 if hit quote else 0).  Use STRNG2.
001ACAr 2  A5 1E                lda     STRNG2
001ACCr 2  85 04                sta     TXTPTR
001ACEr 2  A5 1F                lda     STRNG2+1
001AD0r 2  85 05                sta     TXTPTR+1
001AD2r 2                       ; If we stopped at a closing quote, TXTPTR is past it (StrLit's
001AD2r 2                       ; @endquote path: tya/adc STRNG1 with carry set since cmp set C);
001AD2r 2                       ; if we ran into NUL, TXTPTR sits on the NUL (clc path).  Either
001AD2r 2                       ; is correct for ChrGot.
001AD2r 2  4C rr rr             jmp     ChrGot                  ; preload next char (for caller chains)
001AD5r 2               @paren:
001AD5r 2  20 rr rr             jsr     ChrGet                  ; consume '('
001AD8r 2  20 rr rr             jsr     FrmEvl
001ADBr 2  4C rr rr             jmp     ChkCls                  ; expects ')'; consumes via ChrGet
001ADEr 2               @var:
001ADEr 2                       ; Variable lookup.  PtrGet uses CHRGET internally and leaves
001ADEr 2                       ; (A,Y) = VARPNT.  VALTYP is set to $00 or $FF.
001ADEr 2  20 rr rr             jsr     PtrGet
001AE1r 2                       ; Fetch value into FAC.
001AE1r 2  24 64                bit     VALTYP
001AE3r 2  30 07                bmi     @loadStr
001AE5r 2                       ; numeric: FAC = (VARPNT)
001AE5r 2  A5 3F                lda     VARPNT
001AE7r 2  A4 40                ldy     VARPNT+1
001AE9r 2  4C rr rr             jmp     LoadFacFromYa
001AECr 2               @loadStr:
001AECr 2                       ; string: copy descriptor [len][lo][hi] into FAC..FAC+2.
001AECr 2  A0 00                ldy     #0
001AEEr 2  B1 3F                lda     (VARPNT),y
001AF0r 2  85 0E                sta     FAC
001AF2r 2  C8                   iny
001AF3r 2  B1 3F                lda     (VARPNT),y
001AF5r 2  85 0F                sta     FAC+1
001AF7r 2  C8                   iny
001AF8r 2  B1 3F                lda     (VARPNT),y
001AFAr 2  85 10                sta     FAC+2
001AFCr 2                       ; Record the descriptor's address (= VARPNT) in FAC+3/FAC+4 so the
001AFCr 2                       ; temp-free logic (FreFac/FreTms) can tell this is a variable, not a
001AFCr 2                       ; temp: VARPNT's high byte is nonzero (vars live at $08xx) so it can
001AFCr 2                       ; never match a temp-stack slot (all in zero page) and will not be
001AFCr 2                       ; freed or reclaimed.  Without this, a stale FAC+3/FAC+4 can spuriously
001AFCr 2                       ; match LASTPT and free/reclaim a live string.
001AFCr 2  A5 3F                lda     VARPNT
001AFEr 2  85 11                sta     FAC+3
001B00r 2  A5 40                lda     VARPNT+1
001B02r 2  85 12                sta     FAC+4
001B04r 2  60                   rts
001B05r 2               
001B05r 2               ; ---------------------------------------------------------------------------
001B05r 2               ; FnInkey -- INKEY (no parens).  Reads BAS_PENDKEY first; else BufferSize/
001B05r 2               ; ReadBuffer; else 0.  Result is unsigned 8-bit FP value.
001B05r 2               ; ---------------------------------------------------------------------------
001B05r 2               FnInkey:
001B05r 2  20 rr rr             jsr     ChrGet                  ; consume INKEY token
001B08r 2  AD 0E 03             lda     BAS_PENDKEY
001B0Br 2  F0 09                beq     @noPend
001B0Dr 2                       ; consume pending key.
001B0Dr 2  A0 00                ldy     #0
001B0Fr 2  8C 0E 03             sty     BAS_PENDKEY
001B12r 2  A8                   tay
001B13r 2  4C rr rr             jmp     SngFlt
001B16r 2               @noPend:
001B16r 2  20 rr rr             jsr     BufferSize
001B19r 2  F0 07                beq     @zero
001B1Br 2  20 rr rr             jsr     ReadBuffer
001B1Er 2  A8                   tay
001B1Fr 2  4C rr rr             jmp     SngFlt
001B22r 2               @zero:
001B22r 2  A0 00                ldy     #0
001B24r 2  4C rr rr             jmp     SngFlt
001B27r 2               
001B27r 2               ; ---------------------------------------------------------------------------
001B27r 2               ; FnDispatch -- A holds a function token in [TOK_SGN..TOK_MAX].  Dispatch
001B27r 2               ; via FnTable, which pairs (token, handler-1).
001B27r 2               ; ---------------------------------------------------------------------------
001B27r 2               FnDispatch:
001B27r 2  A2 00                ldx     #0
001B29r 2               @find:
001B29r 2  BD rr rr             lda     FnTable,x
001B2Cr 2  F0 14                beq     @synErr                 ; reached terminator
001B2Er 2  D2 04                cmp     (TXTPTR)
001B30r 2  F0 05                beq     @match
001B32r 2  E8                   inx
001B33r 2  E8                   inx
001B34r 2  E8                   inx
001B35r 2  80 F2                bra     @find
001B37r 2               @match:
001B37r 2                       ; Push handler-1 onto stack so RTS jumps to it after ChrGet.
001B37r 2  BD rr rr             lda     FnTable+2,x
001B3Ar 2  48                   pha
001B3Br 2  BD rr rr             lda     FnTable+1,x
001B3Er 2  48                   pha
001B3Fr 2  4C rr rr             jmp     ChrGet                  ; consume token, return into handler
001B42r 2               @synErr:
001B42r 2  4C rr rr             jmp     SynErr
001B45r 2               
001B45r 2               ; ---------------------------------------------------------------------------
001B45r 2               ; FnTable -- (token, handler-1) triples, $00-terminated.
001B45r 2               ; "handler-1" because we push it through RTS which adds 1.
001B45r 2               ; ---------------------------------------------------------------------------
001B45r 2               FnTable:
001B45r 2  B6                   .byte   TOK_SGN
001B46r 2  rr rr                .word   FnSgn-1
001B48r 2  B7                   .byte   TOK_INT
001B49r 2  rr rr                .word   FnInt-1
001B4Br 2  B8                   .byte   TOK_ABS
001B4Cr 2  rr rr                .word   FnAbs-1
001B4Er 2  B9                   .byte   TOK_FRE
001B4Fr 2  rr rr                .word   FnFre-1
001B51r 2  BA                   .byte   TOK_POS
001B52r 2  rr rr                .word   FnPos-1
001B54r 2  BB                   .byte   TOK_SQR
001B55r 2  rr rr                .word   FnSqr-1
001B57r 2  BC                   .byte   TOK_RND
001B58r 2  rr rr                .word   FnRnd-1
001B5Ar 2  BD                   .byte   TOK_LOG
001B5Br 2  rr rr                .word   FnLog-1
001B5Dr 2  BE                   .byte   TOK_EXP
001B5Er 2  rr rr                .word   FnExp-1
001B60r 2  BF                   .byte   TOK_COS
001B61r 2  rr rr                .word   FnCos-1
001B63r 2  C0                   .byte   TOK_SIN
001B64r 2  rr rr                .word   FnSin-1
001B66r 2  C1                   .byte   TOK_TAN
001B67r 2  rr rr                .word   FnTan-1
001B69r 2  C2                   .byte   TOK_ATN
001B6Ar 2  rr rr                .word   FnAtn-1
001B6Cr 2  C3                   .byte   TOK_PEEK
001B6Dr 2  rr rr                .word   FnPeek-1
001B6Fr 2  C4                   .byte   TOK_LEN
001B70r 2  rr rr                .word   FnLen-1
001B72r 2  C5                   .byte   TOK_STRSTR
001B73r 2  rr rr                .word   FnStrStr-1
001B75r 2  C6                   .byte   TOK_VAL
001B76r 2  rr rr                .word   FnVal-1
001B78r 2  C7                   .byte   TOK_ASC
001B79r 2  rr rr                .word   FnAsc-1
001B7Br 2  C8                   .byte   TOK_CHRSTR
001B7Cr 2  rr rr                .word   FnChrStr-1
001B7Er 2  C9                   .byte   TOK_LEFTSTR
001B7Fr 2  rr rr                .word   FnLeftStr-1
001B81r 2  CA                   .byte   TOK_RIGHTSTR
001B82r 2  rr rr                .word   FnRightStr-1
001B84r 2  CB                   .byte   TOK_MIDSTR
001B85r 2  rr rr                .word   FnMidStr-1
001B87r 2  CC                   .byte   TOK_JOY
001B88r 2  rr rr                .word   FnJoy-1
001B8Ar 2  B1                   .byte   TOK_NVRAM
001B8Br 2  rr rr                .word   FnNvram-1
001B8Dr 2  CE                   .byte   TOK_HEX
001B8Er 2  rr rr                .word   FnHex-1
001B90r 2  CF                   .byte   TOK_MIN
001B91r 2  rr rr                .word   FnMin-1
001B93r 2  D0                   .byte   TOK_MAX
001B94r 2  rr rr                .word   FnMax-1
001B96r 2  00                   .byte   0
001B97r 2               
001B97r 2               ; ---------------------------------------------------------------------------
001B97r 2               ; Numeric-arg helpers.
001B97r 2               ; ParenNum    -- expects "(" expr ")" with numeric result.  FAC = result.
001B97r 2               ; ParenStr    -- expects "(" expr ")" with string result.
001B97r 2               ; ParenU8     -- expects "(" expr ")" -> A = byte (0..255), or ?ILLQTY.
001B97r 2               ; ParenU16    -- expects "(" expr ")" -> AyInt result in FAC+3,+4.
001B97r 2               ; ---------------------------------------------------------------------------
001B97r 2               ParenNum:
001B97r 2  20 rr rr             jsr     ChkOpn
001B9Ar 2  20 rr rr             jsr     FrmEvl
001B9Dr 2  20 rr rr             jsr     ChkNum
001BA0r 2  4C rr rr             jmp     ChkCls
001BA3r 2               ParenStr:
001BA3r 2  20 rr rr             jsr     ChkOpn
001BA6r 2  20 rr rr             jsr     FrmEvl
001BA9r 2  20 rr rr             jsr     ChkStr
001BACr 2  4C rr rr             jmp     ChkCls
001BAFr 2               ParenU8:
001BAFr 2  20 rr rr             jsr     ParenNum
001BB2r 2  20 rr rr             jsr     AyInt
001BB5r 2  A5 11                lda     FAC+3                   ; high byte must be 0
001BB7r 2  D0 03                bne     @bad
001BB9r 2  A5 12                lda     FAC+4                   ; low byte = result
001BBBr 2  60                   rts
001BBCr 2               @bad:
001BBCr 2  4C rr rr             jmp     IqErr
001BBFr 2               
001BBFr 2               ; ---------------------------------------------------------------------------
001BBFr 2               ; Unary numeric functions (single-arg "(" num ")") -- shared body.
001BBFr 2               ; Each entry sets up A = handler entry to call after ChkOpn/FrmEvl/ChkNum/ChkCls.
001BBFr 2               ; ---------------------------------------------------------------------------
001BBFr 2               FnSgn:
001BBFr 2  20 rr rr             jsr     ParenNum
001BC2r 2  4C rr rr             jmp     Sgn
001BC5r 2               FnInt:
001BC5r 2  20 rr rr             jsr     ParenNum
001BC8r 2  4C rr rr             jmp     Int
001BCBr 2               FnAbs:
001BCBr 2  20 rr rr             jsr     ParenNum
001BCEr 2  4C rr rr             jmp     Abs
001BD1r 2               FnSqr:
001BD1r 2  20 rr rr             jsr     ParenNum
001BD4r 2  4C rr rr             jmp     Sqr
001BD7r 2               FnLog:
001BD7r 2  20 rr rr             jsr     ParenNum
001BDAr 2  4C rr rr             jmp     Log
001BDDr 2               FnExp:
001BDDr 2  20 rr rr             jsr     ParenNum
001BE0r 2  4C rr rr             jmp     Exp
001BE3r 2               FnCos:
001BE3r 2  20 rr rr             jsr     ParenNum
001BE6r 2  4C rr rr             jmp     Cos
001BE9r 2               FnSin:
001BE9r 2  20 rr rr             jsr     ParenNum
001BECr 2  4C rr rr             jmp     Sin
001BEFr 2               FnTan:
001BEFr 2  20 rr rr             jsr     ParenNum
001BF2r 2  4C rr rr             jmp     Tan
001BF5r 2               FnAtn:
001BF5r 2  20 rr rr             jsr     ParenNum
001BF8r 2  4C rr rr             jmp     Atn
001BFBr 2               FnRnd:
001BFBr 2  20 rr rr             jsr     ParenNum
001BFEr 2  4C rr rr             jmp     Rnd
001C01r 2               FnHex:
001C01r 2                       ; In expression context: identity.
001C01r 2  4C rr rr             jmp     ParenNum
001C04r 2               
001C04r 2               ; ---------------------------------------------------------------------------
001C04r 2               ; FnFre -- FRE(n): returns FRETOP - STREND (free string heap).
001C04r 2               ; Argument is parsed and ignored.
001C04r 2               ; ---------------------------------------------------------------------------
001C04r 2               FnFre:
001C04r 2  20 rr rr             jsr     ParenNum
001C07r 2  38                   sec
001C08r 2  AD 65 03             lda     FRETOP
001C0Br 2  ED 63 03             sbc     STREND
001C0Er 2  A8                   tay
001C0Fr 2  AD 66 03             lda     FRETOP+1
001C12r 2  ED 64 03             sbc     STREND+1
001C15r 2  4C rr rr             jmp     GivAyf
001C18r 2               
001C18r 2               ; ---------------------------------------------------------------------------
001C18r 2               ; FnPos -- POS(n): not yet maintained; returns 0.
001C18r 2               ; ---------------------------------------------------------------------------
001C18r 2               FnPos:
001C18r 2  20 rr rr             jsr     ParenNum
001C1Br 2  A0 00                ldy     #0
001C1Dr 2  4C rr rr             jmp     SngFlt
001C20r 2               
001C20r 2               ; ---------------------------------------------------------------------------
001C20r 2               ; FnPeek -- PEEK(addr): byte at addr -> FP.
001C20r 2               ; ---------------------------------------------------------------------------
001C20r 2               FnPeek:
001C20r 2  20 rr rr             jsr     ParenNum
001C23r 2  20 rr rr             jsr     FacToU16
001C26r 2  A5 12                lda     FAC+4                   ; lo byte
001C28r 2  85 20                sta     INDEX
001C2Ar 2  A5 11                lda     FAC+3                   ; hi byte
001C2Cr 2  85 21                sta     INDEX+1
001C2Er 2  A0 00                ldy     #0
001C30r 2  B1 20                lda     (INDEX),y
001C32r 2  A8                   tay
001C33r 2  4C rr rr             jmp     SngFlt
001C36r 2               
001C36r 2               ; ---------------------------------------------------------------------------
001C36r 2               ; FnJoy -- JOY(n): 1 or 2.  If GPIO absent, returns 0.
001C36r 2               ; ---------------------------------------------------------------------------
001C36r 2               FnJoy:
001C36r 2  20 rr rr             jsr     ParenU8
001C39r 2  48                   pha
001C3Ar 2  AD 0D 03             lda     HW_PRESENT
001C3Dr 2  29 20                and     #HW_GPIO
001C3Fr 2  F0 1C                beq     @absent
001C41r 2  68                   pla
001C42r 2  C9 01                cmp     #1
001C44r 2  F0 09                beq     @j1
001C46r 2  C9 02                cmp     #2
001C48r 2  F0 0C                beq     @j2
001C4Ar 2  A2 0B                ldx     #ERR_ILLQUAN
001C4Cr 2  4C rr rr             jmp     BasErrorVec
001C4Fr 2               @j1:
001C4Fr 2  20 rr rr             jsr     ReadJoystick1
001C52r 2  A8                   tay
001C53r 2  4C rr rr             jmp     SngFlt
001C56r 2               @j2:
001C56r 2  20 rr rr             jsr     ReadJoystick2
001C59r 2  A8                   tay
001C5Ar 2  4C rr rr             jmp     SngFlt
001C5Dr 2               @absent:
001C5Dr 2  68                   pla
001C5Er 2  A0 00                ldy     #0
001C60r 2  4C rr rr             jmp     SngFlt
001C63r 2               
001C63r 2               ; ---------------------------------------------------------------------------
001C63r 2               ; FnNvram -- NVRAM(addr): if RTC absent, return 0.
001C63r 2               ; ---------------------------------------------------------------------------
001C63r 2               FnNvram:
001C63r 2  20 rr rr             jsr     ParenU8
001C66r 2  48                   pha
001C67r 2  AD 0D 03             lda     HW_PRESENT
001C6Ar 2  29 04                and     #HW_RTC
001C6Cr 2  F0 09                beq     @absent
001C6Er 2  68                   pla
001C6Fr 2  AA                   tax
001C70r 2  20 rr rr             jsr     RtcReadNVRAM
001C73r 2  A8                   tay
001C74r 2  4C rr rr             jmp     SngFlt
001C77r 2               @absent:
001C77r 2  68                   pla
001C78r 2  A0 00                ldy     #0
001C7Ar 2  4C rr rr             jmp     SngFlt
001C7Dr 2               
001C7Dr 2               ; ---------------------------------------------------------------------------
001C7Dr 2               ; FnMin / FnMax -- two numeric args, smaller / larger.
001C7Dr 2               ; ---------------------------------------------------------------------------
001C7Dr 2               FnMin:
001C7Dr 2  20 rr rr             jsr     MinMaxArgs              ; ARG = a, FAC = b, BAS_TMP3 = sign(b-a)
001C80r 2                       ; Want smaller: if b>=a return a (ARG); else return b (FAC).
001C80r 2  10 01                bpl     @retArg                 ; sign>=0 means b>=a
001C82r 2  60                   rts                             ; FAC already = b
001C83r 2               @retArg:
001C83r 2  4C rr rr             jmp     CopyArgToFac
001C86r 2               FnMax:
001C86r 2  20 rr rr             jsr     MinMaxArgs
001C89r 2                       ; Want larger: if b>=a return b (FAC); else return a (ARG).
001C89r 2  10 03                bpl     @retFac
001C8Br 2  4C rr rr             jmp     CopyArgToFac
001C8Er 2               @retFac:
001C8Er 2  60                   rts
001C8Fr 2               
001C8Fr 2               ; MinMaxArgs -- consume "(" a "," b ")" with numerics; ARG=a, FAC=b.
001C8Fr 2               ; Returns A = sign(b - a) (FF/00/01) and N flag set accordingly.
001C8Fr 2               MinMaxArgs:
001C8Fr 2  20 rr rr             jsr     ChkOpn
001C92r 2  20 rr rr             jsr     FrmEvl
001C95r 2  20 rr rr             jsr     ChkNum
001C98r 2  20 rr rr             jsr     PushFac                 ; save a
001C9Br 2  20 rr rr             jsr     ChkCom
001C9Er 2  20 rr rr             jsr     FrmEvl
001CA1r 2  20 rr rr             jsr     ChkNum
001CA4r 2  20 rr rr             jsr     ChkCls
001CA7r 2  20 rr rr             jsr     PullArg                 ; ARG = a, FAC = b
001CAAr 2                       ; Stash ARG so we can restore after FComp's destructive sign-pack.
001CAAr 2  A5 16                lda     ARG
001CACr 2  85 4D                sta     BAS_TEMP1
001CAEr 2  A5 17                lda     ARG+1
001CB0r 2  85 4E                sta     BAS_TEMP1+1
001CB2r 2  A5 18                lda     ARG+2
001CB4r 2  85 4F                sta     BAS_TEMP1+2
001CB6r 2  A5 19                lda     ARG+3
001CB8r 2  85 50                sta     BAS_TEMP1+3
001CBAr 2  A5 1A                lda     ARG+4
001CBCr 2  85 51                sta     BAS_TEMP1+4
001CBEr 2  A5 1B                lda     ARGSIGN
001CC0r 2  85 52                sta     BAS_TEMP1+5
001CC2r 2                       ; Pack ARGSIGN into bit 7 of ARG+1 so FComp reads it correctly.
001CC2r 2  A5 1B                lda     ARGSIGN
001CC4r 2  09 7F                ora     #$7F
001CC6r 2  25 17                and     ARG+1
001CC8r 2  85 17                sta     ARG+1
001CCAr 2  A9 16                lda     #<ARG
001CCCr 2  A0 00                ldy     #$00
001CCEr 2  20 rr rr             jsr     FComp                   ; A = sign(FAC - ARG)
001CD1r 2  48                   pha
001CD2r 2                       ; Restore ARG.
001CD2r 2  A5 4D                lda     BAS_TEMP1
001CD4r 2  85 16                sta     ARG
001CD6r 2  A5 4E                lda     BAS_TEMP1+1
001CD8r 2  85 17                sta     ARG+1
001CDAr 2  A5 4F                lda     BAS_TEMP1+2
001CDCr 2  85 18                sta     ARG+2
001CDEr 2  A5 50                lda     BAS_TEMP1+3
001CE0r 2  85 19                sta     ARG+3
001CE2r 2  A5 51                lda     BAS_TEMP1+4
001CE4r 2  85 1A                sta     ARG+4
001CE6r 2  A5 52                lda     BAS_TEMP1+5
001CE8r 2  85 1B                sta     ARGSIGN
001CEAr 2  68                   pla                             ; restore A, sets N/Z flags
001CEBr 2  60                   rts
001CECr 2               
001CECr 2               ; ---------------------------------------------------------------------------
001CECr 2               ; FnLen -- LEN(s$): length of string.
001CECr 2               ; ---------------------------------------------------------------------------
001CECr 2               FnLen:
001CECr 2  20 rr rr             jsr     ParenStr
001CEFr 2  A4 0E                ldy     FAC                     ; length
001CF1r 2  20 rr rr             jsr     FreFac                  ; release temp string if any
001CF4r 2  4C rr rr             jmp     SngFlt
001CF7r 2               
001CF7r 2               ; ---------------------------------------------------------------------------
001CF7r 2               ; FnAsc -- ASC(s$): code of first char; ?ILLQTY if empty.
001CF7r 2               ; ---------------------------------------------------------------------------
001CF7r 2               FnAsc:
001CF7r 2  20 rr rr             jsr     ParenStr
001CFAr 2  A5 0E                lda     FAC
001CFCr 2  F0 15                beq     @bad
001CFEr 2                       ; Read first byte of string.
001CFEr 2  A5 0F                lda     FAC+1
001D00r 2  85 20                sta     INDEX
001D02r 2  A5 10                lda     FAC+2
001D04r 2  85 21                sta     INDEX+1
001D06r 2  A0 00                ldy     #0
001D08r 2  B1 20                lda     (INDEX),y
001D0Ar 2  48                   pha
001D0Br 2  20 rr rr             jsr     FreFac
001D0Er 2  68                   pla
001D0Fr 2  A8                   tay
001D10r 2  4C rr rr             jmp     SngFlt
001D13r 2               @bad:
001D13r 2  4C rr rr             jmp     IqErr
001D16r 2               
001D16r 2               ; ---------------------------------------------------------------------------
001D16r 2               ; FnChrStr -- CHR$(n): 1-char string.
001D16r 2               ; ---------------------------------------------------------------------------
001D16r 2               FnChrStr:
001D16r 2  20 rr rr             jsr     ParenU8
001D19r 2  48                   pha
001D1Ar 2  A9 01                lda     #1
001D1Cr 2  20 rr rr             jsr     GetSpa                  ; (Y,X) = addr; A unchanged
001D1Fr 2  68                   pla
001D20r 2  A0 00                ldy     #0
001D22r 2  91 84                sta     (FRESPC),y
001D24r 2                       ; Build descriptor in FAC.
001D24r 2  A9 01                lda     #1
001D26r 2  85 0E                sta     FAC
001D28r 2  A5 84                lda     FRESPC
001D2Ar 2  85 0F                sta     FAC+1
001D2Cr 2  A5 85                lda     FRESPC+1
001D2Er 2  85 10                sta     FAC+2
001D30r 2                       ; Advance FRESPC past the byte we just wrote.
001D30r 2  E6 84                inc     FRESPC
001D32r 2  D0 02                bne     @nb
001D34r 2  E6 85                inc     FRESPC+1
001D36r 2               @nb:
001D36r 2  4C rr rr             jmp     PutNew
001D39r 2               
001D39r 2               ; ---------------------------------------------------------------------------
001D39r 2               ; FnStrStr -- STR$(n): convert numeric to string.
001D39r 2               ; ---------------------------------------------------------------------------
001D39r 2               FnStrStr:
001D39r 2  20 rr rr             jsr     ParenNum
001D3Cr 2  20 rr rr             jsr     Fout                    ; A=lo, Y=hi -> NUL-terminated buffer
001D3Fr 2                       ; (A,Y) = pointer to NUL-terminated ASCII number string in STACK2.
001D3Fr 2  20 rr rr             jsr     StrLit                  ; allocates + copies + PutNew
001D42r 2  60                   rts
001D43r 2               
001D43r 2               ; ---------------------------------------------------------------------------
001D43r 2               ; FnVal -- VAL(s$): parse leading numeric from string.
001D43r 2               ; Temporarily NUL-terminates the string in place, redirects TXTPTR, calls
001D43r 2               ; Fin, then restores.
001D43r 2               ; ---------------------------------------------------------------------------
001D43r 2               FnVal:
001D43r 2  20 rr rr             jsr     ParenStr
001D46r 2  A5 0E                lda     FAC
001D48r 2  D0 06                bne     @nz
001D4Ar 2                       ; empty string -> 0
001D4Ar 2  20 rr rr             jsr     FreFac
001D4Dr 2  4C rr rr             jmp     ZeroFac
001D50r 2               @nz:
001D50r 2                       ; Stash length, address into TEMP1..TEMP1+2.
001D50r 2  85 4D                sta     TEMP1                   ; length
001D52r 2  A5 0F                lda     FAC+1
001D54r 2  85 4E                sta     TEMP1+1
001D56r 2  A5 10                lda     FAC+2
001D58r 2  85 4F                sta     TEMP1+2
001D5Ar 2                       ; Save the byte at offset = length and replace with $00.
001D5Ar 2  A5 4E                lda     TEMP1+1
001D5Cr 2  85 20                sta     INDEX
001D5Er 2  A5 4F                lda     TEMP1+2
001D60r 2  85 21                sta     INDEX+1
001D62r 2  A4 4D                ldy     TEMP1
001D64r 2  B1 20                lda     (INDEX),y
001D66r 2  85 50                sta     TEMP1+3                 ; saved byte
001D68r 2  A9 00                lda     #0
001D6Ar 2  91 20                sta     (INDEX),y
001D6Cr 2                       ; Save TXTPTR.
001D6Cr 2  A5 04                lda     TXTPTR
001D6Er 2  48                   pha
001D6Fr 2  A5 05                lda     TXTPTR+1
001D71r 2  48                   pha
001D72r 2                       ; TXTPTR := INDEX - 1, then ChrGet to load first char.
001D72r 2  A5 4E                lda     TEMP1+1
001D74r 2  85 04                sta     TXTPTR
001D76r 2  A5 4F                lda     TEMP1+2
001D78r 2  85 05                sta     TXTPTR+1
001D7Ar 2  A5 04                lda     TXTPTR
001D7Cr 2  D0 02                bne     @nb
001D7Er 2  C6 05                dec     TXTPTR+1
001D80r 2               @nb:
001D80r 2  C6 04                dec     TXTPTR
001D82r 2  20 rr rr             jsr     ChrGet                  ; first char
001D85r 2  20 rr rr             jsr     Fin                     ; FAC := value
001D88r 2                       ; Restore the saved byte.
001D88r 2  A5 4E                lda     TEMP1+1
001D8Ar 2  85 20                sta     INDEX
001D8Cr 2  A5 4F                lda     TEMP1+2
001D8Er 2  85 21                sta     INDEX+1
001D90r 2  A4 4D                ldy     TEMP1
001D92r 2  A5 50                lda     TEMP1+3
001D94r 2  91 20                sta     (INDEX),y
001D96r 2                       ; Restore TXTPTR.
001D96r 2  68                   pla
001D97r 2  85 05                sta     TXTPTR+1
001D99r 2  68                   pla
001D9Ar 2  85 04                sta     TXTPTR
001D9Cr 2  60                   rts
001D9Dr 2               
001D9Dr 2               ; ---------------------------------------------------------------------------
001D9Dr 2               ; FnLeftStr -- LEFT$(s$, n): leftmost n chars.
001D9Dr 2               ; ---------------------------------------------------------------------------
001D9Dr 2               FnLeftStr:
001D9Dr 2  20 rr rr             jsr     ChkOpn
001DA0r 2  20 rr rr             jsr     FrmEvl
001DA3r 2  20 rr rr             jsr     ChkStr
001DA6r 2  20 rr rr             jsr     ChkCom
001DA9r 2  20 rr rr             jsr     PushFac                 ; save string descriptor
001DACr 2  20 rr rr             jsr     FrmEvl
001DAFr 2  20 rr rr             jsr     ChkNum
001DB2r 2  20 rr rr             jsr     ChkCls
001DB5r 2  20 rr rr             jsr     AyInt
001DB8r 2  20 rr rr             jsr     PullArg                 ; ARG = string descriptor (BAS_TMP1 clobbered)
001DBBr 2                       ; FAC still holds the integer n; check range and copy now.
001DBBr 2  A5 11                lda     FAC+3
001DBDr 2  D0 16                bne     @bad
001DBFr 2  A5 12                lda     FAC+4
001DC1r 2  85 3B                sta     BAS_TMP1+1              ; n
001DC3r 2                       ; Clamp n to ARG (length).
001DC3r 2  A5 3B                lda     BAS_TMP1+1
001DC5r 2  C5 16                cmp     ARG
001DC7r 2  90 02                bcc     @ok
001DC9r 2  A5 16                lda     ARG
001DCBr 2               @ok:
001DCBr 2  85 3B                sta     BAS_TMP1+1
001DCDr 2                       ; Free the source temp BEFORE allocating result so the slot frees up.
001DCDr 2  20 rr rr             jsr     FreeArgString
001DD0r 2                       ; Offset = 0 for LEFT$.
001DD0r 2  64 3A                stz     BAS_TMP1
001DD2r 2                       ; Allocate, copy first n bytes.
001DD2r 2  4C rr rr             jmp     SubstrCommon            ; tail-call (rts to caller)
001DD5r 2               @bad:
001DD5r 2  4C rr rr             jmp     IqErr
001DD8r 2               
001DD8r 2               ; ---------------------------------------------------------------------------
001DD8r 2               ; FnRightStr -- RIGHT$(s$, n): rightmost n chars.
001DD8r 2               ; ---------------------------------------------------------------------------
001DD8r 2               FnRightStr:
001DD8r 2  20 rr rr             jsr     ChkOpn
001DDBr 2  20 rr rr             jsr     FrmEvl
001DDEr 2  20 rr rr             jsr     ChkStr
001DE1r 2  20 rr rr             jsr     ChkCom
001DE4r 2  20 rr rr             jsr     PushFac
001DE7r 2  20 rr rr             jsr     FrmEvl
001DEAr 2  20 rr rr             jsr     ChkNum
001DEDr 2  20 rr rr             jsr     ChkCls
001DF0r 2  20 rr rr             jsr     AyInt
001DF3r 2  20 rr rr             jsr     PullArg                 ; ARG = string descriptor (BAS_TMP1 clobbered)
001DF6r 2  A5 11                lda     FAC+3
001DF8r 2  D0 1B                bne     @bad
001DFAr 2  A5 12                lda     FAC+4
001DFCr 2  85 3B                sta     BAS_TMP1+1              ; n
001DFEr 2                       ; Clamp n.
001DFEr 2  A5 3B                lda     BAS_TMP1+1
001E00r 2  C5 16                cmp     ARG
001E02r 2  90 02                bcc     @ok
001E04r 2  A5 16                lda     ARG
001E06r 2               @ok:
001E06r 2  85 3B                sta     BAS_TMP1+1
001E08r 2                       ; offset = ARG - n.
001E08r 2  A5 16                lda     ARG
001E0Ar 2  38                   sec
001E0Br 2  E5 3B                sbc     BAS_TMP1+1
001E0Dr 2  85 3A                sta     BAS_TMP1                ; start offset
001E0Fr 2  20 rr rr             jsr     FreeArgString
001E12r 2  4C rr rr             jmp     SubstrCommon
001E15r 2               @bad:
001E15r 2  4C rr rr             jmp     IqErr
001E18r 2               
001E18r 2               ; ---------------------------------------------------------------------------
001E18r 2               ; FnMidStr -- MID$(s$, m [, n]): substring starting at m (1-based).
001E18r 2               ; ---------------------------------------------------------------------------
001E18r 2               FnMidStr:
001E18r 2  20 rr rr             jsr     ChkOpn
001E1Br 2  20 rr rr             jsr     FrmEvl
001E1Er 2  20 rr rr             jsr     ChkStr
001E21r 2  20 rr rr             jsr     ChkCom
001E24r 2  20 rr rr             jsr     PushFac
001E27r 2                       ; Read m.
001E27r 2  20 rr rr             jsr     FrmEvl
001E2Ar 2  20 rr rr             jsr     ChkNum
001E2Dr 2  20 rr rr             jsr     AyInt
001E30r 2  A5 11                lda     FAC+3
001E32r 2  D0 4B                bne     @bad
001E34r 2  A5 12                lda     FAC+4
001E36r 2  F0 47                beq     @bad                    ; m must be >= 1
001E38r 2  38                   sec
001E39r 2  E9 01                sbc     #1
001E3Br 2  85 3A                sta     BAS_TMP1                ; offset = m-1
001E3Dr 2                       ; Optional ", n".
001E3Dr 2  20 rr rr             jsr     ChrGot
001E40r 2  C9 2C                cmp     #','
001E42r 2  F0 06                beq     @hasN
001E44r 2                       ; No n: take rest -> n = 255 (will clamp).
001E44r 2  A9 FF                lda     #255
001E46r 2  85 3B                sta     BAS_TMP1+1
001E48r 2  80 14                bra     @cls
001E4Ar 2               @hasN:
001E4Ar 2  20 rr rr             jsr     ChrGet
001E4Dr 2  20 rr rr             jsr     FrmEvl
001E50r 2  20 rr rr             jsr     ChkNum
001E53r 2  20 rr rr             jsr     AyInt
001E56r 2  A5 11                lda     FAC+3
001E58r 2  D0 25                bne     @bad
001E5Ar 2  A5 12                lda     FAC+4
001E5Cr 2  85 3B                sta     BAS_TMP1+1
001E5Er 2               @cls:
001E5Er 2  20 rr rr             jsr     ChkCls
001E61r 2  20 rr rr             jsr     PullArg                 ; ARG = string
001E64r 2                       ; Clamp offset to length.
001E64r 2  A5 3A                lda     BAS_TMP1
001E66r 2  C5 16                cmp     ARG
001E68r 2  90 04                bcc     @offOk
001E6Ar 2  A5 16                lda     ARG                     ; offset = length -> empty result
001E6Cr 2  85 3A                sta     BAS_TMP1
001E6Er 2               @offOk:
001E6Er 2                       ; Clamp n to (length - offset).
001E6Er 2  38                   sec
001E6Fr 2  A5 16                lda     ARG
001E71r 2  E5 3A                sbc     BAS_TMP1
001E73r 2  C5 3B                cmp     BAS_TMP1+1
001E75r 2  B0 02                bcs     @nOk
001E77r 2  85 3B                sta     BAS_TMP1+1
001E79r 2               @nOk:
001E79r 2  20 rr rr             jsr     FreeArgString
001E7Cr 2  4C rr rr             jmp     SubstrCommon
001E7Fr 2               @bad:
001E7Fr 2  4C rr rr             jmp     IqErr
001E82r 2               
001E82r 2               ; ---------------------------------------------------------------------------
001E82r 2               ; SubstrCommon -- copy BAS_TMP1+1 bytes from ARG-string at offset BAS_TMP1
001E82r 2               ; into a new heap allocation; result descriptor in FAC; PutNew.
001E82r 2               ; ---------------------------------------------------------------------------
001E82r 2               SubstrCommon:
001E82r 2                       ; Allocate.
001E82r 2  A5 3B                lda     BAS_TMP1+1
001E84r 2  20 rr rr             jsr     GetSpa                  ; FRESPC = new buffer
001E87r 2                       ; Source pointer = ARG+1 (lo/hi) + BAS_TMP1.
001E87r 2  18                   clc
001E88r 2  A5 17                lda     ARG+1
001E8Ar 2  65 3A                adc     BAS_TMP1
001E8Cr 2  85 20                sta     INDEX
001E8Er 2  A5 18                lda     ARG+2
001E90r 2  69 00                adc     #0
001E92r 2  85 21                sta     INDEX+1
001E94r 2                       ; Copy BAS_TMP1+1 bytes from (INDEX) to (FRESPC).
001E94r 2  A4 3B                ldy     BAS_TMP1+1
001E96r 2  F0 0B                beq     @done
001E98r 2  A0 00                ldy     #0
001E9Ar 2               @cp:
001E9Ar 2  B1 20                lda     (INDEX),y
001E9Cr 2  91 84                sta     (FRESPC),y
001E9Er 2  C8                   iny
001E9Fr 2  C4 3B                cpy     BAS_TMP1+1
001EA1r 2  D0 F7                bne     @cp
001EA3r 2               @done:
001EA3r 2                       ; Build descriptor.
001EA3r 2  A5 3B                lda     BAS_TMP1+1
001EA5r 2  85 0E                sta     FAC
001EA7r 2  A5 84                lda     FRESPC
001EA9r 2  85 0F                sta     FAC+1
001EABr 2  A5 85                lda     FRESPC+1
001EADr 2  85 10                sta     FAC+2
001EAFr 2                       ; Advance FRESPC by length consumed.
001EAFr 2  18                   clc
001EB0r 2  A5 84                lda     FRESPC
001EB2r 2  65 3B                adc     BAS_TMP1+1
001EB4r 2  85 84                sta     FRESPC
001EB6r 2  90 02                bcc     @nb
001EB8r 2  E6 85                inc     FRESPC+1
001EBAr 2               @nb:
001EBAr 2  4C rr rr             jmp     PutNew
001EBDr 2               
001EBDr 2               ; FreeArgString -- if ARG holds a temp string descriptor (most-recent
001EBDr 2               ; on TEMPST), pop just the descriptor.  Heap is left intact so callers
001EBDr 2               ; that still need the source bytes can copy them safely; orphaned heap
001EBDr 2               ; will be reclaimed by Garbag.
001EBDr 2               FreeArgString:
001EBDr 2  A5 19                lda     ARG+3                   ; descriptor address lo
001EBFr 2  A4 1A                ldy     ARG+4                   ; descriptor address hi (always $00)
001EC1r 2  4C rr rr             jmp     FreTms
001EC4r 2               
001EC4r 2               ; Cleanup that releases both ARG's and FAC's temp descriptors (called from
001EC4r 2               ; CatStr after content has been stashed but before new allocation).
001EC4r 2               FreeBothTemps:
001EC4r 2                       ; Free FAC's temp first (it is currently LASTPT).
001EC4r 2  A5 11                lda     FAC+3
001EC6r 2  A4 12                ldy     FAC+4
001EC8r 2  20 rr rr             jsr     FreTms
001ECBr 2                       ; Then ARG's (now LASTPT after FAC's removal).
001ECBr 2  A5 19                lda     ARG+3
001ECDr 2  A4 1A                ldy     ARG+4
001ECFr 2  4C rr rr             jmp     FreTms
001ED2r 2  60                   rts
001ED3r 2               
001ED3r 2               ; ===========================================================================
001ED3r 2               ;   E V A L U A T O R   -   B I N A R Y   O P E R A T O R   H E L P E R S
001ED3r 2               ; ===========================================================================
001ED3r 2               
001ED3r 2               ; ---------------------------------------------------------------------------
001ED3r 2               ; AndOp -- FAC = ARG AND FAC (bitwise on 16-bit signed ints).
001ED3r 2               ; ---------------------------------------------------------------------------
001ED3r 2               AndOp:
001ED3r 2  20 rr rr             jsr     AyInt                   ; FAC -> int (FAC+3=hi, FAC+4=lo)
001ED6r 2  A5 11                lda     FAC+3
001ED8r 2  85 3A                sta     BAS_TMP1                ; saved hi
001EDAr 2  A5 12                lda     FAC+4
001EDCr 2  85 3B                sta     BAS_TMP1+1              ; saved lo
001EDEr 2  20 rr rr             jsr     CopyArgToFac
001EE1r 2  20 rr rr             jsr     AyInt
001EE4r 2  A5 12                lda     FAC+4
001EE6r 2  25 3B                and     BAS_TMP1+1
001EE8r 2  A8                   tay                             ; Y = lo result
001EE9r 2  A5 11                lda     FAC+3
001EEBr 2  25 3A                and     BAS_TMP1                ; A = hi result
001EEDr 2  4C rr rr             jmp     GivAyf
001EF0r 2               
001EF0r 2               ; ---------------------------------------------------------------------------
001EF0r 2               ; OrOp -- FAC = ARG OR FAC.
001EF0r 2               ; ---------------------------------------------------------------------------
001EF0r 2               OrOp:
001EF0r 2  20 rr rr             jsr     AyInt
001EF3r 2  A5 11                lda     FAC+3
001EF5r 2  85 3A                sta     BAS_TMP1                ; saved hi
001EF7r 2  A5 12                lda     FAC+4
001EF9r 2  85 3B                sta     BAS_TMP1+1              ; saved lo
001EFBr 2  20 rr rr             jsr     CopyArgToFac
001EFEr 2  20 rr rr             jsr     AyInt
001F01r 2  A5 12                lda     FAC+4
001F03r 2  05 3B                ora     BAS_TMP1+1
001F05r 2  A8                   tay                             ; Y = lo
001F06r 2  A5 11                lda     FAC+3
001F08r 2  05 3A                ora     BAS_TMP1                ; A = hi
001F0Ar 2  4C rr rr             jmp     GivAyf
001F0Dr 2               
001F0Dr 2               ; ---------------------------------------------------------------------------
001F0Dr 2               ; NotOp -- FAC = NOT FAC (bitwise complement of 16-bit signed int).
001F0Dr 2               ; ---------------------------------------------------------------------------
001F0Dr 2               NotOp:
001F0Dr 2  20 rr rr             jsr     AyInt
001F10r 2  A5 12                lda     FAC+4
001F12r 2  49 FF                eor     #$FF
001F14r 2  A8                   tay                             ; Y = lo
001F15r 2  A5 11                lda     FAC+3
001F17r 2  49 FF                eor     #$FF                    ; A = hi
001F19r 2  4C rr rr             jmp     GivAyf
001F1Cr 2               
001F1Cr 2               ; ---------------------------------------------------------------------------
001F1Cr 2               ; BasCmdLet -- minimal LET (assignment).  Entered with ChrGot returning
001F1Cr 2               ; the first letter of the variable name.  No `LET` keyword required.
001F1Cr 2               ; ---------------------------------------------------------------------------
001F1Cr 2               BasCmdLet:
001F1Cr 2  20 rr rr             jsr     PtrGet                  ; VARPNT, VALTYP set; TXTPTR past name
001F1Fr 2                       ; Save VARPNT and the variable's VALTYP across FrmEvl.
001F1Fr 2  A5 3F                lda     VARPNT
001F21r 2  48                   pha
001F22r 2  A5 40                lda     VARPNT+1
001F24r 2  48                   pha
001F25r 2  A5 64                lda     VALTYP
001F27r 2  48                   pha
001F28r 2  20 rr rr             jsr     ChrGot
001F2Br 2  C9 3D                cmp     #'='
001F2Dr 2  D0 36                bne     @synErr
001F2Fr 2  20 rr rr             jsr     ChrGet
001F32r 2  20 rr rr             jsr     FrmEvl
001F35r 2  68                   pla                             ; saved variable VALTYP
001F36r 2  85 3E                sta     BAS_TMP3
001F38r 2  45 64                eor     VALTYP
001F3Ar 2  30 2F                bmi     @typeErr
001F3Cr 2  68                   pla
001F3Dr 2  85 40                sta     VARPNT+1
001F3Fr 2  68                   pla
001F40r 2  85 3F                sta     VARPNT
001F42r 2  24 3E                bit     BAS_TMP3
001F44r 2  30 07                bmi     @storeStr
001F46r 2                       ; Numeric: store FAC into (VARPNT) (5 bytes).
001F46r 2  A6 3F                ldx     VARPNT
001F48r 2  A4 40                ldy     VARPNT+1
001F4Ar 2  4C rr rr             jmp     StoreFacAtYxRounded
001F4Dr 2               @storeStr:
001F4Dr 2  A0 00                ldy     #0
001F4Fr 2  A5 0E                lda     FAC
001F51r 2  91 3F                sta     (VARPNT),y
001F53r 2  C8                   iny
001F54r 2  A5 0F                lda     FAC+1
001F56r 2  91 3F                sta     (VARPNT),y
001F58r 2  C8                   iny
001F59r 2  A5 10                lda     FAC+2
001F5Br 2  91 3F                sta     (VARPNT),y
001F5Dr 2                       ; If the RHS was a temporary string (StrLt2/PutNew pushed it and left
001F5Dr 2                       ; its descriptor address in FAC+3/FAC+4 == LASTPT), pop it now that
001F5Dr 2                       ; the variable owns the heap copy.  Pop only (FreTms), never FreFac --
001F5Dr 2                       ; reclaiming would free the string we just stored.  For a plain
001F5Dr 2                       ; variable RHS, @loadStr set FAC+3/FAC+4 to that variable's address
001F5Dr 2                       ; (nonzero high byte), which cannot match a temp slot, so FreTms is a
001F5Dr 2                       ; no-op.  Without this, >3 consecutive string LETs leak the 3-slot
001F5Dr 2                       ; temp stack (?FORMULA TOO COMPLEX).
001F5Dr 2  A5 11                lda     FAC+3
001F5Fr 2  A4 12                ldy     FAC+4
001F61r 2  20 rr rr             jsr     FreTms
001F64r 2  60                   rts
001F65r 2               @synErr:
001F65r 2  68                   pla
001F66r 2  68                   pla
001F67r 2  68                   pla
001F68r 2  4C rr rr             jmp     SynErr
001F6Br 2               @typeErr:
001F6Br 2  68                   pla
001F6Cr 2  68                   pla
001F6Dr 2  A2 08                ldx     #ERR_TYPEMISM
001F6Fr 2  4C rr rr             jmp     BasErrorVec
001F72r 2               
001F72r 2               ; =============================================================================
001F72r 2               ;   C O N T R O L   F L O W   /   S T A T E M E N T   L O O P
001F72r 2               ;
001F72r 2               ;   BasNewstt drives execution for both direct mode (TXTPTR in BAS_TOKBUF)
001F72r 2               ;   and run mode (TXTPTR walks program lines from BAS_TXTTAB).  Statement
001F72r 2               ;   dispatch follows the msbasic convention: push (routine_addr - 1) and
001F72r 2               ;   tail-jump through ChrGet, so the routine entry is reached via RTS.
001F72r 2               ;
001F72r 2               ;   FOR and GOSUB store frames on the CPU stack and JMP back to BasNewstt;
001F72r 2               ;   NEXT and RETURN scan the stack for a matching tag, then TXS to discard
001F72r 2               ;   the frame and resume.
001F72r 2               ; =============================================================================
001F72r 2               
001F72r 2               NUM_STMT_TOKENS = TOK_MEM + 1 - TOK_BASE       ; $36 entries
001F72r 2               
001F72r 2               BasNewstt:
001F72r 2  20 rr rr             jsr     BasCheckBreak
001F75r 2                       ; Save TXTPTR -> OLDTEXT for CONT, except in direct mode.
001F75r 2  AD 6A 03             lda     BAS_CURLIN+1
001F78r 2  C9 FF                cmp     #$FF
001F7Ar 2  F0 0A                beq     @noSave
001F7Cr 2  A5 04                lda     TXTPTR
001F7Er 2  8D 6D 03             sta     BAS_OLDTEXT
001F81r 2  A5 05                lda     TXTPTR+1
001F83r 2  8D 6E 03             sta     BAS_OLDTEXT+1
001F86r 2               @noSave:
001F86r 2  A0 00                ldy     #0
001F88r 2  B1 04                lda     (TXTPTR),y
001F8Ar 2  F0 10                beq     @endLine
001F8Cr 2  C9 A4                cmp     #TOK_ELSE
001F8Er 2  F0 07                beq     @skipElse               ; THEN-branch ran; skip ELSE clause to EOL
001F90r 2  C9 3A                cmp     #':'
001F92r 2  F0 34                beq     @nextStmt
001F94r 2  4C rr rr             jmp     SynErr
001F97r 2               @skipElse:
001F97r 2                       ; Advance TXTPTR until we land on a $00 terminator.
001F97r 2               @skLoop:
001F97r 2  20 rr rr             jsr     ChrGet
001F9Ar 2  D0 FB                bne     @skLoop
001F9Cr 2                       ; Fall through to @endLine with TXTPTR at $00.
001F9Cr 2               @endLine:
001F9Cr 2                       ; Direct mode: end of buffer -> back to REPL.
001F9Cr 2  AD 6A 03             lda     BAS_CURLIN+1
001F9Fr 2  C9 FF                cmp     #$FF
001FA1r 2  D0 03                bne     @walkNext
001FA3r 2  4C rr rr             jmp     BasReadyLoop            ; OK is printed by BasReadyLoop
001FA6r 2               @walkNext:
001FA6r 2                       ; Run mode: examine next-pointer at offsets +1,+2.
001FA6r 2  A0 02                ldy     #2
001FA8r 2  B1 04                lda     (TXTPTR),y
001FAAr 2  D0 06                bne     @loadLine               ; nonzero hi -> next line exists
001FACr 2                       ; End of program -> halt and return to REPL.
001FACr 2  A2 FF                ldx     #$FF
001FAEr 2  9A                   txs
001FAFr 2  4C rr rr             jmp     BasReadyLoop
001FB2r 2               @loadLine:
001FB2r 2  C8                   iny                             ; y=3
001FB3r 2  B1 04                lda     (TXTPTR),y
001FB5r 2  8D 69 03             sta     BAS_CURLIN
001FB8r 2  C8                   iny                             ; y=4
001FB9r 2  B1 04                lda     (TXTPTR),y
001FBBr 2  8D 6A 03             sta     BAS_CURLIN+1
001FBEr 2  98                   tya                             ; A=4
001FBFr 2  18                   clc
001FC0r 2  65 04                adc     TXTPTR
001FC2r 2  85 04                sta     TXTPTR
001FC4r 2  90 02                bcc     @nextStmt
001FC6r 2  E6 05                inc     TXTPTR+1
001FC8r 2               @nextStmt:
001FC8r 2  20 rr rr             jsr     ChrGet
001FCBr 2  20 rr rr             jsr     BasExecuteStatement
001FCEr 2  4C rr rr             jmp     BasNewstt
001FD1r 2               
001FD1r 2               ; ---------------------------------------------------------------------------
001FD1r 2               ; BasExecuteStatement -- A = current tokenized byte (loaded by ChrGet).
001FD1r 2               ;   * A = 0  -> RTS (no-op; end of statement chain).
001FD1r 2               ;   * A < $80 (letter) -> JMP BasCmdLet.
001FD1r 2               ;   * A is a statement token ($80..TOK_MEM) -> dispatch via BasTokenAddrTbl.
001FD1r 2               ;   * Otherwise -> ?SYNTAX ERROR.
001FD1r 2               ; ---------------------------------------------------------------------------
001FD1r 2               BasExecuteStatement:
001FD1r 2  F0 30                beq     @ret
001FD3r 2  38                   sec
001FD4r 2  E9 80                sbc     #TOK_BASE
001FD6r 2  90 25                bcc     @doLet
001FD8r 2  C9 36                cmp     #NUM_STMT_TOKENS
001FDAr 2  B0 0D                bcs     @ext
001FDCr 2  0A                   asl     a
001FDDr 2  A8                   tay
001FDEr 2  B9 rr rr             lda     BasTokenAddrTbl+1,y
001FE1r 2  48                   pha
001FE2r 2  B9 rr rr             lda     BasTokenAddrTbl,y
001FE5r 2  48                   pha
001FE6r 2  4C rr rr             jmp     ChrGet
001FE9r 2               @ext:
001FE9r 2                       ; Extended statement tokens DISK/BLOAD/BSAVE/FORMAT ($D1-$D4).
001FE9r 2                       ; Bodies live in the Kernal via BasExtAddrTbl (thin-BASIC strategy).
001FE9r 2  38                   sec
001FEAr 2  E9 51                sbc     #(TOK_DISK - TOK_BASE)
001FECr 2  C9 04                cmp     #4
001FEEr 2  B0 10                bcs     @synErr
001FF0r 2  0A                   asl     a
001FF1r 2  A8                   tay
001FF2r 2  B9 rr rr             lda     BasExtAddrTbl+1,y
001FF5r 2  48                   pha
001FF6r 2  B9 rr rr             lda     BasExtAddrTbl,y
001FF9r 2  48                   pha
001FFAr 2  4C rr rr             jmp     ChrGet
001FFDr 2               @doLet:
001FFDr 2  4C rr rr             jmp     BasCmdLet
002000r 2               @synErr:
002000r 2  4C rr rr             jmp     SynErr
002003r 2               @ret:
002003r 2  60                   rts
002004r 2               
002004r 2               ; ---------------------------------------------------------------------------
002004r 2               ; BasCheckBreak -- poll input buffer for Ctrl-C / ESC.  On break, save
002004r 2               ; CONT context and bounce to REPL.  Other keys are stashed in BAS_PENDKEY
002004r 2               ; for INKEY to retrieve.
002004r 2               ; ---------------------------------------------------------------------------
002004r 2               BasCheckBreak:
002004r 2                       ; In direct mode (CURLIN hi == $FF) skip the break check entirely;
002004r 2                       ; otherwise we would drain pending REPL keystrokes and corrupt the
002004r 2                       ; next BasReadLine input.  Break is only meaningful while RUNning.
002004r 2  AD 6A 03             lda     BAS_CURLIN+1
002007r 2  C9 FF                cmp     #$FF
002009r 2  F0 13                beq     @no
00200Br 2  20 rr rr             jsr     BufferSize
00200Er 2  F0 0E                beq     @no
002010r 2  20 rr rr             jsr     ReadBuffer
002013r 2  C9 03                cmp     #$03
002015r 2  F0 08                beq     @break
002017r 2  C9 1B                cmp     #$1B
002019r 2  F0 04                beq     @break
00201Br 2  8D 0E 03             sta     BAS_PENDKEY
00201Er 2               @no:
00201Er 2  60                   rts
00201Fr 2               @break:
00201Fr 2                       ; OLDLIN/OLDTEXT already track the executing line.  Make sure the
00201Fr 2                       ; saved values reflect the current line so CONT can resume.
00201Fr 2  AD 69 03             lda     BAS_CURLIN
002022r 2  8D 6B 03             sta     BAS_OLDLIN
002025r 2  AD 6A 03             lda     BAS_CURLIN+1
002028r 2  8D 6C 03             sta     BAS_OLDLIN+1
00202Br 2  A2 FF                ldx     #$FF
00202Dr 2  9A                   txs
00202Er 2  20 rr rr             jsr     BasPrintCRLF
002031r 2  A9 rr                lda     #<MsgBreak
002033r 2  A0 rr                ldy     #>MsgBreak
002035r 2  20 rr rr             jsr     BasPrintStr
002038r 2  AD 6A 03             lda     BAS_CURLIN+1
00203Br 2  C9 FF                cmp     #$FF
00203Dr 2  F0 14                beq     @noLine
00203Fr 2  A9 rr                lda     #<MsgInWord
002041r 2  A0 rr                ldy     #>MsgInWord
002043r 2  20 rr rr             jsr     BasPrintStr
002046r 2  AD 69 03             lda     BAS_CURLIN
002049r 2  85 08                sta     BAS_LINNUM
00204Br 2  AD 6A 03             lda     BAS_CURLIN+1
00204Er 2  85 09                sta     BAS_LINNUM+1
002050r 2  20 rr rr             jsr     BasPrintLineNum
002053r 2               @noLine:
002053r 2  A9 FF                lda     #$FF
002055r 2  8D 69 03             sta     BAS_CURLIN
002058r 2  8D 6A 03             sta     BAS_CURLIN+1
00205Br 2  4C rr rr             jmp     BasReadyLoop
00205Er 2               
00205Er 2  42 52 45 41  MsgBreak: .byte "BREAK",0
002062r 2  4B 00        
002064r 2               
002064r 2               ; ---------------------------------------------------------------------------
002064r 2               ; LinGet -- parse decimal digits at TXTPTR into BAS_LINNUM (16-bit).
002064r 2               ; Caller has set carry conditions appropriate to ChrGet entry.  TXTPTR
002064r 2               ; ends pointing at the first non-digit.
002064r 2               ; ---------------------------------------------------------------------------
002064r 2               LinGet:
002064r 2  A2 00                ldx     #0
002066r 2  86 08                stx     BAS_LINNUM
002068r 2  86 09                stx     BAS_LINNUM+1
00206Ar 2               @loop:
00206Ar 2  B0 3A                bcs     @done
00206Cr 2  E9 2F                sbc     #$2F                    ; carry already set
00206Er 2  85 44                sta     CHARAC
002070r 2                       ; LINNUM *= 10
002070r 2  A5 08                lda     BAS_LINNUM
002072r 2  85 3A                sta     BAS_TMP1
002074r 2  A5 09                lda     BAS_LINNUM+1
002076r 2  85 3B                sta     BAS_TMP1+1
002078r 2  C9 19                cmp     #$19
00207Ar 2  B0 2B                bcs     @ovf
00207Cr 2  06 08                asl     BAS_LINNUM
00207Er 2  26 09                rol     BAS_LINNUM+1
002080r 2  06 08                asl     BAS_LINNUM
002082r 2  26 09                rol     BAS_LINNUM+1
002084r 2  18                   clc
002085r 2  A5 08                lda     BAS_LINNUM
002087r 2  65 3A                adc     BAS_TMP1
002089r 2  85 08                sta     BAS_LINNUM
00208Br 2  A5 09                lda     BAS_LINNUM+1
00208Dr 2  65 3B                adc     BAS_TMP1+1
00208Fr 2  85 09                sta     BAS_LINNUM+1
002091r 2  06 08                asl     BAS_LINNUM
002093r 2  26 09                rol     BAS_LINNUM+1
002095r 2  18                   clc
002096r 2  A5 08                lda     BAS_LINNUM
002098r 2  65 44                adc     CHARAC
00209Ar 2  85 08                sta     BAS_LINNUM
00209Cr 2  90 02                bcc     @nextDigit
00209Er 2  E6 09                inc     BAS_LINNUM+1
0020A0r 2               @nextDigit:
0020A0r 2  20 rr rr             jsr     ChrGet
0020A3r 2  4C rr rr             jmp     @loop
0020A6r 2               @done:
0020A6r 2  60                   rts
0020A7r 2               @ovf:
0020A7r 2  A2 00                ldx     #ERR_SYNTAX
0020A9r 2  4C rr rr             jmp     BasErrorVec
0020ACr 2               
0020ACr 2               ; ---------------------------------------------------------------------------
0020ACr 2               ; FndLin -- find program line whose number matches BAS_LINNUM.
0020ACr 2               ;   On success: carry SET, BAS_TMP1 (LOWTR alias) = address of line.
0020ACr 2               ;   On failure: carry CLEAR, BAS_TMP1 = address where line would belong.
0020ACr 2               ; ---------------------------------------------------------------------------
0020ACr 2               FndLin:
0020ACr 2  AD 5D 03             lda     BAS_TXTTAB
0020AFr 2  AE 5E 03             ldx     BAS_TXTTAB+1
0020B2r 2               @walk:
0020B2r 2  85 3A                sta     BAS_TMP1
0020B4r 2  86 3B                stx     BAS_TMP1+1
0020B6r 2  A0 01                ldy     #1
0020B8r 2  B1 3A                lda     (BAS_TMP1),y
0020BAr 2  F0 20                beq     @notFound               ; next-hi=0 -> end of program
0020BCr 2  A0 03                ldy     #3                      ; line-num-lo offset
0020BEr 2  A5 09                lda     BAS_LINNUM+1
0020C0r 2  D1 3A                cmp     (BAS_TMP1),y            ; compare hi byte at +3? need iny
0020C2r 2                       ; Actually format: +0 next-lo, +1 next-hi, +2 num-lo, +3 num-hi
0020C2r 2  90 18                bcc     @notFound               ; LINNUM-hi < line-hi -> miss
0020C4r 2  D0 09                bne     @advance                ; LINNUM-hi > line-hi -> next line
0020C6r 2  88                   dey                             ; y=2 = num-lo
0020C7r 2  A5 08                lda     BAS_LINNUM
0020C9r 2  D1 3A                cmp     (BAS_TMP1),y
0020CBr 2  90 0F                bcc     @notFound
0020CDr 2  F0 0F                beq     @found
0020CFr 2               @advance:
0020CFr 2  A0 00                ldy     #0
0020D1r 2  B1 3A                lda     (BAS_TMP1),y
0020D3r 2  48                   pha
0020D4r 2  A0 01                ldy     #1
0020D6r 2  B1 3A                lda     (BAS_TMP1),y
0020D8r 2  AA                   tax
0020D9r 2  68                   pla
0020DAr 2  B0 D6                bcs     @walk                   ; carry=1 means continue (always)
0020DCr 2               @notFound:
0020DCr 2  18                   clc
0020DDr 2  60                   rts
0020DEr 2               @found:
0020DEr 2  38                   sec
0020DFr 2  60                   rts
0020E0r 2               
0020E0r 2               ; ---------------------------------------------------------------------------
0020E0r 2               ; BasCmdGoto -- TXTPTR points at line-number digits.
0020E0r 2               ; ---------------------------------------------------------------------------
0020E0r 2               BasCmdGoto:
0020E0r 2  20 rr rr             jsr     LinGet
0020E3r 2  20 rr rr             jsr     BasRemn                 ; skip remainder of statement
0020E6r 2  20 rr rr             jsr     FndLin
0020E9r 2  90 0E                bcc     @undef
0020EBr 2                       ; LOWTR (BAS_TMP1) = target line addr.  TXTPTR = LOWTR - 1
0020EBr 2                       ; (so NEWSTT sees the previous line's $00 terminator at offset 0).
0020EBr 2  38                   sec
0020ECr 2  A5 3A                lda     BAS_TMP1
0020EEr 2  E9 01                sbc     #1
0020F0r 2  85 04                sta     TXTPTR
0020F2r 2  A5 3B                lda     BAS_TMP1+1
0020F4r 2  E9 00                sbc     #0
0020F6r 2  85 05                sta     TXTPTR+1
0020F8r 2  60                   rts
0020F9r 2               @undef:
0020F9r 2  A2 03                ldx     #ERR_UNDEFSTMT
0020FBr 2  4C rr rr             jmp     BasErrorVec
0020FEr 2               
0020FEr 2               ; ---------------------------------------------------------------------------
0020FEr 2               ; BasCmdGosub -- push 5-byte frame on stack, then GOTO target.
0020FEr 2               ; Frame layout (top-down): [tag $8C][CURLIN-lo][CURLIN-hi][TXTPTR-lo][TXTPTR-hi]
0020FEr 2               ; ---------------------------------------------------------------------------
0020FEr 2               BasCmdGosub:
0020FEr 2  A5 05                lda     TXTPTR+1
002100r 2  48                   pha
002101r 2  A5 04                lda     TXTPTR
002103r 2  48                   pha
002104r 2  AD 6A 03             lda     BAS_CURLIN+1
002107r 2  48                   pha
002108r 2  AD 69 03             lda     BAS_CURLIN
00210Br 2  48                   pha
00210Cr 2  A9 8C                lda     #TOK_GOSUB
00210Er 2  48                   pha
00210Fr 2  20 rr rr             jsr     ChrGot
002112r 2  20 rr rr             jsr     BasCmdGoto
002115r 2  4C rr rr             jmp     BasNewstt
002118r 2               
002118r 2               ; ---------------------------------------------------------------------------
002118r 2               ; BasCmdReturn -- locate GOSUB frame on stack and resume at saved TXTPTR.
002118r 2               ; Per msbasic: scan the CPU stack from SP+5 (skipping return-routine's caller
002118r 2               ; return + this scan's own JSR return).  RTS at end pops the leaked
002118r 2               ; EXEC-return that GOSUB left behind.
002118r 2               ; ---------------------------------------------------------------------------
002118r 2               BasCmdReturn:
002118r 2  20 rr rr             jsr     GtForPnt
00211Br 2                       ; X now points to the slot just BELOW a frame tag (or end of stack).
00211Br 2  9A                   txs
00211Cr 2  C9 8C                cmp     #TOK_GOSUB
00211Er 2  F0 05                beq     @ok
002120r 2  A2 0C                ldx     #ERR_RG
002122r 2  4C rr rr             jmp     BasErrorVec
002125r 2               @ok:
002125r 2  68                   pla                             ; tag (already in A, this discards)
002126r 2  68                   pla
002127r 2  8D 69 03             sta     BAS_CURLIN
00212Ar 2  68                   pla
00212Br 2  8D 6A 03             sta     BAS_CURLIN+1
00212Er 2  68                   pla
00212Fr 2  85 04                sta     TXTPTR
002131r 2  68                   pla
002132r 2  85 05                sta     TXTPTR+1
002134r 2                       ; Skip remainder of GOSUB-target statement (DATAN-style).
002134r 2  20 rr rr             jsr     BasDatan
002137r 2                       ; Advance TXTPTR by Y (number of bytes to terminator).
002137r 2  98                   tya
002138r 2  18                   clc
002139r 2  65 04                adc     TXTPTR
00213Br 2  85 04                sta     TXTPTR
00213Dr 2  90 02                bcc     @noinc
00213Fr 2  E6 05                inc     TXTPTR+1
002141r 2               @noinc:
002141r 2  60                   rts
002142r 2               
002142r 2               ; ---------------------------------------------------------------------------
002142r 2               ; GtForPnt -- scan CPU stack for FOR/GOSUB frames.
002142r 2               ;   On entry: BAS_FORPNT (FORPNT) = $FFxx for "match any tag".
002142r 2               ;   Returns: X = stack pointer where the matching frame's tag-1 lives,
002142r 2               ;            A = tag byte found (or 0 if end-of-stack).  Z=1 if found tag,
002142r 2               ;            Z=0 (A=0) if no frame found.
002142r 2               ; ---------------------------------------------------------------------------
002142r 2               GtForPnt:
002142r 2  BA                   tsx
002143r 2  E8                   inx
002144r 2  E8                   inx
002145r 2  E8                   inx
002146r 2  E8                   inx
002147r 2               @scan:
002147r 2  BD 01 01             lda     $0101,x                 ; tag candidate
00214Ar 2  C9 81                cmp     #TOK_FOR
00214Cr 2  D0 24                bne     @notFor
00214Er 2                       ; Compare frame's variable address to FORPNT.
00214Er 2  A5 47                lda     BAS_FORPNT+1
002150r 2  D0 0A                bne     @skipVar                ; FORPNT+1 = $FF -> skip variable test
002152r 2  BD 02 01             lda     $0102,x
002155r 2  85 46                sta     BAS_FORPNT
002157r 2  BD 03 01             lda     $0103,x
00215Ar 2  85 47                sta     BAS_FORPNT+1
00215Cr 2               @skipVar:
00215Cr 2  DD 03 01             cmp     $0103,x
00215Fr 2  D0 07                bne     @advance
002161r 2  A5 46                lda     BAS_FORPNT
002163r 2  DD 02 01             cmp     $0102,x
002166r 2  F0 11                beq     @found
002168r 2               @advance:
002168r 2  8A                   txa
002169r 2  18                   clc
00216Ar 2  69 12                adc     #18                     ; BYTES_PER_FRAME (FOR)
00216Cr 2  AA                   tax
00216Dr 2  D0 D8                bne     @scan
00216Fr 2                       ; Walked off stack
00216Fr 2  A9 00                lda     #0
002171r 2  60                   rts
002172r 2               @notFor:
002172r 2  C9 8C                cmp     #TOK_GOSUB
002174r 2  F0 03                beq     @found
002176r 2  A9 00                lda     #0
002178r 2  60                   rts
002179r 2               @found:
002179r 2  60                   rts
00217Ar 2               
00217Ar 2               ; ---------------------------------------------------------------------------
00217Ar 2               ; BasRemn -- scan TXTPTR forward to next ':' or end-of-line.
00217Ar 2               ; Sets Y to byte offset of terminator from current TXTPTR.  Honours quotes.
00217Ar 2               ; ---------------------------------------------------------------------------
00217Ar 2               BasDatan:
00217Ar 2  A2 3A                ldx     #':'
00217Cr 2  2C                   .byte   $2C                     ; BIT abs absorbs next 2-byte LDX
00217Dr 2               BasRemn:
00217Dr 2  A2 00                ldx     #0
00217Fr 2  86 44                stx     CHARAC
002181r 2  A0 00                ldy     #0
002183r 2  84 6A                sty     ENDCHR
002185r 2               @swap:
002185r 2  A5 6A                lda     ENDCHR
002187r 2  A6 44                ldx     CHARAC
002189r 2  85 44                sta     CHARAC
00218Br 2  86 6A                stx     ENDCHR
00218Dr 2               @scan:
00218Dr 2  B1 04                lda     (TXTPTR),y
00218Fr 2  F0 0B                beq     @done
002191r 2  C5 6A                cmp     ENDCHR
002193r 2  F0 07                beq     @done
002195r 2  C8                   iny
002196r 2  C9 22                cmp     #'"'
002198r 2  F0 EB                beq     @swap
00219Ar 2  D0 F1                bne     @scan
00219Cr 2               @done:
00219Cr 2  60                   rts
00219Dr 2               
00219Dr 2               ; ---------------------------------------------------------------------------
00219Dr 2               ; Statement: REM -- skip to end of line.
00219Dr 2               ; Statement: DATA -- treated like REM at execution time (just skip).
00219Dr 2               ; ---------------------------------------------------------------------------
00219Dr 2               BasCmdRem:
00219Dr 2  20 rr rr             jsr     BasRemn
0021A0r 2  80 03                bra     BasAddon
