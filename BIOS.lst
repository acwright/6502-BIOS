000000r 2               SC_DATA             := $9000             ; R/W
000000r 2               SC_RESET            := $9001             ; Write
000000r 2               SC_STATUS           := $9001             ; Read
000000r 2               SC_CMD              := $9002             ; R/W
000000r 2               SC_CTRL             := $9003             ; R/W
000000r 2               SC_STATUS_IRQ       := %10000000         ; Interrupt
000000r 2               SC_STATUS_DSR       := %01000000         ; Data Set Ready
000000r 2               SC_STATUS_DCD       := %00100000         ; Data Carrier Detect
000000r 2               SC_STATUS_TDRE      := %00010000         ; TX Data Register Empty
000000r 2               SC_STATUS_RDRF      := %00001000         ; RX Data Register Full
000000r 2               SC_STATUS_OVR       := %00000100         ; Overrun
000000r 2               SC_STATUS_FRME      := %00000010         ; Framing Error
