002A7Fr 2               ; MEM -- print "nnnnn BYTES FREE  HW=$xx"
002A7Fr 2               BasCmdMem:
002A7Fr 2                       ; Free bytes = MEMSIZ - VARTAB
002A7Fr 2  38                   sec
002A80r 2  AD 67 03             lda     BAS_MEMSIZ
002A83r 2  ED 5F 03             sbc     BAS_VARTAB
002A86r 2  A8                   tay
002A87r 2  AD 68 03             lda     BAS_MEMSIZ+1
002A8Ar 2  ED 60 03             sbc     BAS_VARTAB+1
002A8Dr 2  20 rr rr             jsr     GivAyf                  ; FAC = unsigned int from (Y,A)
002A90r 2                       ; Wait: GivAyf is signed.  For this simple display, OK if < 32768.
002A90r 2  20 rr rr             jsr     PrintNum
002A93r 2  A9 rr                lda     #<MsgFree
002A95r 2  A0 rr                ldy     #>MsgFree
002A97r 2  20 rr rr             jsr     BasPrintStr
002A9Ar 2  A9 24                lda     #'$'
002A9Cr 2  20 rr rr             jsr     Chrout
002A9Fr 2  AD 0D 03             lda     HW_PRESENT
002AA2r 2  20 rr rr             jsr     PrintHexByte
002AA5r 2  20 rr rr             jsr     BasPrintCRLF
002AA8r 2  4C rr rr             jmp     FsPrintDisk             ; print "DISK n" line
002AABr 2               
002AABr 2  20 42 59 54  MsgFree:        .byte   " BYTES FREE  HW=",0
002AAFr 2  45 53 20 46  
002AB3r 2  52 45 45 20  
002ABCr 2  3F 4C 4F 41  MsgLoadErr:     .byte   "?LOAD ERROR",$0D,$0A,0
002AC0r 2  44 20 45 52  
002AC4r 2  52 4F 52 0D  
002ACAr 2  3F 53 41 56  MsgSaveErr:     .byte   "?SAVE ERROR",$0D,$0A,0
002ACEr 2  45 20 45 52  
002AD2r 2  52 4F 52 0D  
002AD8r 2  3F 44 45 4C  MsgDelErr:      .byte   "?DEL ERROR",$0D,$0A,0
002ADCr 2  20 45 52 52  
002AE0r 2  4F 52 0D 0A  
002AE5r 2               
002AE5r 2               ; Wrappers so the dispatch table can call existing routines that expect
002AE5r 2               ; TXTPTR positioned already.
002AE5r 2               BasCmdPrintW:
002AE5r 2                       ; We were entered via the dispatch trampoline, so TXTPTR is already
002AE5r 2                       ; past the PRINT token (ChrGet was tail-called).  But BasCmdPrint
002AE5r 2                       ; expects to consume the token itself with its first ChrGet; rewind.
002AE5r 2                       ; Easier: BasCmdPrint reads via ChrGet; here ChrGet was called before
002AE5r 2                       ; routine entry, so TXTPTR currently points at first arg.  Just call
002AE5r 2                       ; an internal entry that skips the leading ChrGet.
002AE5r 2  4C rr rr             jmp     BasPrLoop
002AE8r 2               
002AE8r 2               ; ---------------------------------------------------------------------------
002AE8r 2               ; Token-address dispatch table.  Indexed by (token - $80).  Each entry is
002AE8r 2               ; (routine_address - 1) since the dispatcher PHA-pushes it and uses the
002AE8r 2               ; "JMP ChrGet -> RTS" trick to enter.
002AE8r 2               ; ---------------------------------------------------------------------------
002AE8r 2               BasTokenAddrTbl:
002AE8r 2  rr rr                .word   BasCmdEnd-1             ; $80 END
002AEAr 2  rr rr                .word   BasCmdFor-1             ; $81 FOR
002AECr 2  rr rr                .word   BasCmdNext-1            ; $82 NEXT
002AEEr 2  rr rr                .word   BasCmdData-1            ; $83 DATA
002AF0r 2  rr rr                .word   BasCmdInput-1           ; $84 INPUT
002AF2r 2  rr rr                .word   BasCmdDim-1             ; $85 DIM
002AF4r 2  rr rr                .word   BasCmdRead-1            ; $86 READ
002AF6r 2  rr rr                .word   BasCmdLet-1             ; $87 LET
002AF8r 2  rr rr                .word   BasCmdGoto-1            ; $88 GOTO
002AFAr 2  rr rr                .word   BasCmdRun-1             ; $89 RUN
002AFCr 2  rr rr                .word   BasCmdIf-1              ; $8A IF
002AFEr 2  rr rr                .word   BasCmdRestore-1         ; $8B RESTORE
002B00r 2  rr rr                .word   BasCmdGosub-1           ; $8C GOSUB
002B02r 2  rr rr                .word   BasCmdReturn-1          ; $8D RETURN
002B04r 2  rr rr                .word   BasCmdRem-1             ; $8E REM
002B06r 2  rr rr                .word   BasCmdStop-1            ; $8F STOP
002B08r 2  rr rr                .word   BasCmdOn-1              ; $90 ON
002B0Ar 2  rr rr                .word   BasCmdWait-1            ; $91 WAIT
002B0Cr 2  rr rr                .word   BasCmdLoad-1            ; $92 LOAD
002B0Er 2  rr rr                .word   BasCmdSave-1            ; $93 SAVE
002B10r 2  rr rr                .word   BasCmdDef-1             ; $94 DEF
002B12r 2  rr rr                .word   BasCmdPoke-1            ; $95 POKE
002B14r 2  rr rr                .word   BasCmdPrintW-1          ; $96 PRINT
002B16r 2  rr rr                .word   BasCmdCont-1            ; $97 CONT
002B18r 2  rr rr                .word   BasCmdList-1            ; $98 LIST
002B1Ar 2  rr rr                .word   BasCmdClr-1             ; $99 CLR
002B1Cr 2  rr rr                .word   BasCmdNew-1             ; $9A NEW
002B1Er 2  rr rr                .word   SynErr-1                ; $9B TAB  (function only)
002B20r 2  rr rr                .word   SynErr-1                ; $9C TO
002B22r 2  rr rr                .word   SynErr-1                ; $9D FN
002B24r 2  rr rr                .word   SynErr-1                ; $9E SPC
002B26r 2  rr rr                .word   SynErr-1                ; $9F THEN
002B28r 2  rr rr                .word   SynErr-1                ; $A0 NOT
002B2Ar 2  rr rr                .word   SynErr-1                ; $A1 STEP
