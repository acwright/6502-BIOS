000732r 2  4C rr rr             jmp     BasReadyLoop
000735r 2               
000735r 2               ; BasPrintErrorMsg - print message #A from the error-message table.
000735r 2               ;   Each message is NUL-terminated; the table is a sequence of those.
000735r 2               BasPrintErrorMsg:
000735r 2  AA                   tax
000736r 2  A9 rr                lda     #<ErrorMessages
000738r 2  85 3A                sta     BAS_TMP1
00073Ar 2  A9 rr                lda     #>ErrorMessages
00073Cr 2  85 3B                sta     BAS_TMP1+1
00073Er 2               @Skip:
00073Er 2  E0 00                cpx     #0
000740r 2  F0 17                beq     @Print
000742r 2                       ; Walk past one message (advance until NUL, then one more).
000742r 2               @SkipLoop:
000742r 2  A0 00                ldy     #0
000744r 2  B1 3A                lda     (BAS_TMP1),y
000746r 2  F0 08                beq     @SkipDone
000748r 2  E6 3A                inc     BAS_TMP1
00074Ar 2  D0 F6                bne     @SkipLoop
00074Cr 2  E6 3B                inc     BAS_TMP1+1
00074Er 2  80 F2                bra     @SkipLoop
000750r 2               @SkipDone:
000750r 2  E6 3A                inc     BAS_TMP1
000752r 2  D0 02                bne     @SkippedHi
000754r 2  E6 3B                inc     BAS_TMP1+1
000756r 2               @SkippedHi:
000756r 2  CA                   dex
000757r 2  80 E5                bra     @Skip
000759r 2               @Print:
000759r 2  A5 3A                lda     BAS_TMP1
00075Br 2  A4 3B                ldy     BAS_TMP1+1
00075Dr 2  4C rr rr             jmp     BasPrintStr
000760r 2               
000760r 2               
000760r 2               ; =============================================================================
000760r 2               ;   F L O A T I N G - P O I N T   R U N T I M E
000760r 2               ;
000760r 2               ;   Externals required by the inlined MSBASIC FP code:
000760r 2               ;     ChrGet   - advance TXTPTR and load next non-space tokenized char
000760r 2               ;                (used by Fin; never exercised by the FP tests).
000760r 2               ;     BasErrorVec    - error vector; X = error code
000760r 2               ;     IqErr    - "?ILLEGAL QUANTITY" entry
000760r 2               ;     STROUT   - print NUL-terminated string at (A=lo, Y=hi)
000760r 2               ;     QtIn    - the literal " IN " string (used only by InPrt)
000760r 2               ; =============================================================================
000760r 2               
000760r 2               ; --- ChrGet / ChrGot --------------------------------------------------------
000760r 2               ; Real implementation (ROM, not ZP self-modifying).  Increments TXTPTR and
000760r 2               ; returns the next non-space byte at (TXTPTR) in A, with carry CLEAR if the
000760r 2               ; byte is a digit '0'-'9'.  ChrGot re-reads the current byte without
000760r 2               ; advancing first.  Both clobber only A and flags.
000760r 2               ;
000760r 2               ; Side effects on flags after the routine returns:
000760r 2               ;   Z=1  if A == $00 or A is a tokenized/keyword byte that wraps to zero
000760r 2               ;        (used by callers checking end-of-statement).
000760r 2               ;   C=0  if A is a digit ('0'-'9'); else C=1.
000760r 2               ;
000760r 2               ; Implementation matches msbasic-master/chrget.s.
000760r 2               ChrGet:
000760r 2  E6 04                inc     TXTPTR
000762r 2  D0 02                bne     ChrGot
000764r 2  E6 05                inc     TXTPTR+1
000766r 2               ChrGot:
000766r 2  B2 04                lda     (TXTPTR)
000768r 2  C9 3A                cmp     #':'
00076Ar 2  B0 0A                bcs     @out
00076Cr 2  C9 20                cmp     #' '
00076Er 2  F0 F0                beq     ChrGet
000770r 2  38                   sec
000771r 2  E9 30                sbc     #'0'
000773r 2  38                   sec
000774r 2  E9 D0                sbc     #$D0                    ; restore A; sets C=0 iff digit
000776r 2               @out:
000776r 2  60                   rts
000777r 2               
000777r 2               ; --- Error trampolines ------------------------------------------------------
000777r 2               ; The MSBASIC convention is "ldx #code / jmp ERROR".  Our BasError takes
000777r 2               ; the code in A, so translate.
000777r 2               BasErrorVec:
000777r 2  8A                   txa
000778r 2  4C rr rr             jmp     BasError
00077Br 2               
00077Br 2               IqErr:
00077Br 2  A2 0B                ldx     #ERR_ILLQUAN
00077Dr 2  4C rr rr             jmp     BasErrorVec
000780r 2               
000780r 2               ; --- String output ----------------------------------------------------------
000780r 2               ; FP code calls STROUT with (A=lo, Y=hi).  BasPrintStr matches that ABI.
000780r 2               STROUT          := BasPrintStr
000780r 2               
000780r 2               ; --- "IN " literal (referenced by InPrt) ----------------------------------
000780r 2               QtIn:
000780r 2  20 49 4E 20          .byte   " IN ",0
000784r 2  00           
000785r 2               
000785r 2               ; --- Shared RTS targets used by branches in the FP code --------------------
000785r 2               ; The original MSBASIC defines Rts3 in poke.s (which we don't include).
000785r 2               ; Provide a single shared RTS landing pad here.
000785r 2               Rts3:
000785r 2  60                   rts
