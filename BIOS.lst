000000r 1               
000000r 1               .segment "KERNAL"
000000r 1               .include "Kernal.asm"
000000r 2               ; ***             ***
000000r 2               ; ***   KERNAL    ***
000000r 2               ; ***             ***
000000r 2               
000000r 2               ; === Kernal Jump Table ($A000-$A0FF) ===
000000r 2               ; 85 slots of 3-byte JMP instructions plus 1 padding byte
000000r 2               ; Provides stable entry points for external code and cartridges
000000r 2               
000000r 2               ; --- Character I/O ---
000000r 2  4C rr rr     Chrout:         jmp ChroutDispatch      ; $A000 - Output char (dispatched by IO_MODE)
000003r 2  4C rr rr     Chrin:          jmp ChrinImpl           ; $A003 - Input char from buffer
000006r 2  4C rr rr     WriteBuffer:    jmp WriteBufferImpl     ; $A006 - Write byte to input buffer
000009r 2  4C rr rr     ReadBuffer:     jmp ReadBufferImpl      ; $A009 - Read byte from input buffer
00000Cr 2  4C rr rr     BufferSize:     jmp BufferSizeImpl      ; $A00C - Get buffer count
00000Fr 2               ; --- IO Mode ---
00000Fr 2  4C rr rr     SetIOMode:      jmp SetIOModeImpl       ; $A00F - Set IO_MODE
000012r 2  4C rr rr     GetIOMode:      jmp GetIOModeImpl       ; $A012 - Get IO_MODE
000015r 2               ; --- Video (TMS9918) ---
000015r 2  4C rr rr     InitVideo:      jmp InitVideoImpl       ; $A015 - Initialize TMS9918
000018r 2  4C rr rr     VideoClear:     jmp VideoClearImpl      ; $A018 - Clear video screen
00001Br 2  4C rr rr     VideoPutChar:   jmp VideoPutCharImpl    ; $A01B - Write char at cursor
00001Er 2  4C rr rr     VideoSetCursor: jmp VideoSetCursorImpl  ; $A01E - Set cursor (X=col, Y=row)
000021r 2  4C rr rr     VideoGetCursor: jmp VideoGetCursorImpl  ; $A021 - Get cursor position
000024r 2  4C rr rr     VideoScroll:    jmp VideoScrollImpl     ; $A024 - Scroll screen up one line
000027r 2  4C rr rr     VideoSetColor:  jmp VideoSetColorImpl   ; $A027 - Set TMS9918 text color (A=reg7 byte: hi=fg, lo=bg)
00002Ar 2  4C rr rr     VideoChroutRaw: jmp VideoChroutRawImpl  ; $A02A - Output char to video (raw, no control-code handling)
00002Dr 2               ; --- Sound (SID) ---
00002Dr 2  4C rr rr     InitSID:        jmp InitSIDImpl         ; $A02D - Initialize SID
000030r 2  4C rr rr     Beep:           jmp BeepImpl            ; $A030 - Play beep tone
000033r 2  4C rr rr     SidPlayNote:    jmp SidPlayNoteImpl     ; $A033 - Play note (A=voice, X=freqLo, Y=freqHi)
000036r 2  4C rr rr     SidSilence:     jmp SidSilenceImpl      ; $A036 - Silence all voices
000039r 2  4C rr rr     SidSetVolume:   jmp SidSetVolumeImpl    ; $A039 - Set SID master volume (A=0-15)
00003Cr 2               ; --- Filesystem ---
00003Cr 2  4C rr rr     FsLoadFile:     jmp FsLoadFileImpl      ; $A03C - Load file from CF
00003Fr 2  4C rr rr     FsSaveFile:     jmp FsSaveFileImpl      ; $A03F - Save file to CF
000042r 2  4C rr rr     FsDeleteFile:   jmp FsDeleteFileImpl    ; $A042 - Delete file from CF
000045r 2               ; --- Keyboard / GPIO ---
000045r 2  4C rr rr     InitKB:         jmp InitKBImpl          ; $A045 - Initialize GPIO/VIA keyboard
000048r 2  4C rr rr     ReadJoystick1:  jmp ReadJoystick1Impl   ; $A048 - Read joystick 1
00004Br 2  4C rr rr     ReadJoystick2:  jmp ReadJoystick2Impl   ; $A04B - Read joystick 2
00004Er 2               ; --- Serial (6551) ---
00004Er 2  4C rr rr     InitSC:         jmp InitSCImpl          ; $A04E - Initialize serial 6551
000051r 2  4C rr rr     SerialChrout:   jmp SerialChroutImpl    ; $A051 - Direct serial output (bypass IO_MODE)
000054r 2  4C rr rr     XModemLoad:     jmp XModemLoadImpl      ; $A054 - Receive binary via XModem
000057r 2  4C rr rr     XModemSave:     jmp XModemSaveImpl      ; $A057 - Send binary via XModem
00005Ar 2               ; --- RTC (DS1511Y) ---
00005Ar 2  4C rr rr     RtcReadTime:    jmp RtcReadTimeImpl     ; $A05A - Read RTC time
00005Dr 2  4C rr rr     RtcReadDate:    jmp RtcReadDateImpl     ; $A05D - Read RTC date
000060r 2  4C rr rr     RtcWriteTime:   jmp RtcWriteTimeImpl    ; $A060 - Set RTC time
000063r 2  4C rr rr     RtcWriteDate:   jmp RtcWriteDateImpl    ; $A063 - Set RTC date
000066r 2  4C rr rr     RtcReadNVRAM:   jmp RtcReadNVRAMImpl    ; $A066 - Read NVRAM byte
000069r 2  4C rr rr     RtcWriteNVRAM:  jmp RtcWriteNVRAMImpl   ; $A069 - Write NVRAM byte
00006Cr 2               ; --- CompactFlash Storage ---
00006Cr 2  4C rr rr     StReadSector:   jmp StReadSectorImpl    ; $A06C - Read CF sector
00006Fr 2  4C rr rr     StWriteSector:  jmp StWriteSectorImpl   ; $A06F - Write CF sector
000072r 2  4C rr rr     StWaitReady:    jmp StWaitReadyImpl     ; $A072 - Wait CF ready
000075r 2               ; --- System ---
000075r 2  4C rr rr     SysDelay:       jmp SysDelayImpl        ; $A075 - Delay A=cnt_lo, X=cnt_hi centiseconds
000078r 2  4C rr rr     KernalInit:     jmp KernalInitImpl      ; $A078 - Initialize all hardware (caller must reset SP; no cli, no splash); rts when done
00007Br 2  4C rr rr     KernalVersion:  jmp KernalVersionImpl   ; $A07B - Get BIOS version (A=major, X=minor)
00007Er 2               ; --- Disk banking / addressed storage ---
00007Er 2  4C rr rr     FsLoadFileAddr: jmp FsLoadFileAddrImpl  ; $A07E - Load named file to FS_IO_ADDR
000081r 2  4C rr rr     FsSaveFileAddr: jmp FsSaveFileAddrImpl  ; $A081 - Save FS_FILE_SIZE bytes from FS_IO_ADDR to named file
000084r 2  4C rr rr     FsFormatDisk:   jmp FsFormatDiskImpl    ; $A084 - Zero the current disk's directory sector
000087r 2  4C rr rr     FsSetDisk:      jmp FsSetDiskImpl       ; $A087 - Select current CF disk (A=0-255)
00008Ar 2  4C rr rr     FsGetDisk:      jmp FsGetDiskImpl       ; $A08A - Get current CF disk (A=disk)
00008Dr 2  4C rr rr     FsPrintDisk:    jmp FsPrintDiskImpl     ; $A08D - Print "DISK n" + CRLF via Chrout
000090r 2               ; --- General output utilities (console = IO_MODE-routed via Chrout) ---
000090r 2  4C rr rr     PrintStr:       jmp PrintStrImpl        ; $A090 - Print NUL-terminated string (A=lo, Y=hi); clobbers A,Y,STR_PTR
000093r 2  4C rr rr     PrintCRLF:      jmp PrintCRLFImpl       ; $A093 - Print CR+LF
000096r 2  4C rr rr     PrintDecU16:    jmp PrintDecU16Impl     ; $A096 - Print unsigned 16-bit decimal (A=lo, X=hi), no leading zeros
000099r 2               
000099r 2               ; Reserved entries ($A099-$A0FE)
000099r 2  4C rr rr 4C  .repeat 34
00009Dr 2  rr rr 4C rr  
0000A1r 2  rr 4C rr rr  
0000FFr 2                               jmp UnimplementedStub
0000FFr 2               .endrepeat
0000FFr 2  00           .byte $00                             ; Pad to 256 bytes ($A0FF)
000100r 2               
000100r 2               ; === Kernal Implementation ===
000100r 2               
000100r 2               ; Stub for unimplemented jump table entries
000100r 2               UnimplementedStub:
000100r 2  60             rts
000101r 2               
000101r 2               ; Chrout dispatcher — routes output based on IO_MODE
000101r 2               ; Input: A = character to output
000101r 2               ; Modifies: Flags
000101r 2               ChroutDispatch:
000101r 2  48             pha
000102r 2  AD 06 03       lda IO_MODE
000105r 2  29 01          and #$01                      ; Bit 0: 0=video, 1=serial
000107r 2  D0 04          bne @Serial
000109r 2  68             pla
00010Ar 2  4C rr rr       jmp VideoChroutImpl
00010Dr 2               @Serial:
00010Dr 2  68             pla
00010Er 2  4C rr rr       jmp SerialChroutImpl
000111r 2               
000111r 2               ; Set IO_MODE
000111r 2               ; Input: A = mode (bit 0: 0=video, 1=serial)
000111r 2               SetIOModeImpl:
000111r 2  8D 06 03       sta IO_MODE
000114r 2  60             rts
000115r 2               
000115r 2               ; Get IO_MODE
000115r 2               ; Output: A = current IO_MODE
000115r 2               GetIOModeImpl:
000115r 2  AD 06 03       lda IO_MODE
000118r 2  60             rts
000119r 2               
000119r 2               ; === TMS9918 Video Driver ===
000119r 2               
000119r 2               ; VideoClear — Fill name table (960 bytes at VRAM $0000) with spaces, reset cursor to (0,0)
000119r 2               ; Modifies: Flags, A, X, Y
000119r 2               VideoClearImpl:
000119r 2                 ; Set VRAM write address to $0000 (name table base)
000119r 2  A9 00          lda #$00
00011Br 2  8D 01 9C       sta VC_REG
00011Er 2  A9 40          lda #$40                      ; High byte $00 OR $40 for write mode
000120r 2  8D 01 9C       sta VC_REG
000123r 2                 ; Fill 960 bytes with space ($20) — 3 full pages + 192 bytes
000123r 2  A9 20          lda #$20
000125r 2  A0 00          ldy #$00
000127r 2  A2 03          ldx #$03                      ; 3 full pages (768 bytes)
000129r 2               @VideoClearPage:
000129r 2  8D 00 9C       sta VC_DATA
00012Cr 2  C8             iny
00012Dr 2  D0 FA          bne @VideoClearPage
00012Fr 2  CA             dex
000130r 2  D0 F7          bne @VideoClearPage
000132r 2                 ; Remaining 192 bytes (960 - 768)
000132r 2  A0 C0          ldy #192
000134r 2               @VideoClearRem:
000134r 2  8D 00 9C       sta VC_DATA
000137r 2  88             dey
000138r 2  D0 FA          bne @VideoClearRem
00013Ar 2                 ; Reset cursor to (0,0)
00013Ar 2  9C 07 03       stz VID_CURSOR_X
00013Dr 2  9C 08 03       stz VID_CURSOR_Y
000140r 2  9C 09 03       stz VID_CURSOR_ADDR
000143r 2  9C 0A 03       stz VID_CURSOR_ADDR + 1
000146r 2  60             rts
000147r 2               
000147r 2               ; VideoSetCursor — Set cursor position
000147r 2               ; Input: X = column (0-39), Y = row (0-23)
000147r 2               ; Calculates VRAM address = Y * 40 + X and stores in VID_CURSOR_ADDR
000147r 2               ; Modifies: Flags, A
000147r 2               VideoSetCursorImpl:
000147r 2  8E 07 03       stx VID_CURSOR_X
00014Ar 2  8C 08 03       sty VID_CURSOR_Y
00014Dr 2                 ; Calculate VRAM address = Y * 40 + X
00014Dr 2                 ; Y * 40 = Y * 32 + Y * 8
00014Dr 2  A9 00          lda #$00
00014Fr 2  8D 0A 03       sta VID_CURSOR_ADDR + 1       ; Clear high byte
000152r 2  98             tya                           ; A = row
000153r 2                 ; Multiply by 8: shift left 3
000153r 2  0A             asl a
000154r 2  2E 0A 03       rol VID_CURSOR_ADDR + 1
000157r 2  0A             asl a
000158r 2  2E 0A 03       rol VID_CURSOR_ADDR + 1
00015Br 2  0A             asl a
00015Cr 2  2E 0A 03       rol VID_CURSOR_ADDR + 1
00015Fr 2  8D 09 03       sta VID_CURSOR_ADDR           ; Store Y*8 low byte
000162r 2                 ; Save Y*8 for later addition
000162r 2  48             pha
000163r 2  AD 0A 03       lda VID_CURSOR_ADDR + 1
000166r 2  48             pha
000167r 2                 ; Multiply original row by 32: shift left 5 total (Y*8 << 2)
000167r 2  AD 09 03       lda VID_CURSOR_ADDR
00016Ar 2  0A             asl a
00016Br 2  2E 0A 03       rol VID_CURSOR_ADDR + 1
00016Er 2  0A             asl a
00016Fr 2  2E 0A 03       rol VID_CURSOR_ADDR + 1
000172r 2  8D 09 03       sta VID_CURSOR_ADDR           ; Now holds Y*32 low byte
000175r 2                 ; Add Y*8 + Y*32
000175r 2  68             pla                           ; Restore Y*8 high byte
000176r 2  6D 0A 03       adc VID_CURSOR_ADDR + 1       ; Carry still valid from last rol
000179r 2  8D 0A 03       sta VID_CURSOR_ADDR + 1
00017Cr 2  68             pla                           ; Restore Y*8 low byte
00017Dr 2  18             clc
00017Er 2  6D 09 03       adc VID_CURSOR_ADDR
000181r 2  8D 09 03       sta VID_CURSOR_ADDR
000184r 2  90 03          bcc @NoCarry
000186r 2  EE 0A 03       inc VID_CURSOR_ADDR + 1
000189r 2               @NoCarry:
000189r 2                 ; Add X (column)
000189r 2  8A             txa
00018Ar 2  18             clc
00018Br 2  6D 09 03       adc VID_CURSOR_ADDR
00018Er 2  8D 09 03       sta VID_CURSOR_ADDR
000191r 2  90 03          bcc @SetCursorDone
000193r 2  EE 0A 03       inc VID_CURSOR_ADDR + 1
000196r 2               @SetCursorDone:
000196r 2  60             rts
000197r 2               
000197r 2               ; VideoGetCursor — Get cursor position
000197r 2               ; Output: X = column (0-39), Y = row (0-23)
000197r 2               ; Modifies: Flags
000197r 2               VideoGetCursorImpl:
000197r 2  AE 07 03       ldx VID_CURSOR_X
00019Ar 2  AC 08 03       ldy VID_CURSOR_Y
00019Dr 2  60             rts
00019Er 2               
00019Er 2               ; VideoPutChar — Write a single character to VRAM at VID_CURSOR_ADDR
00019Er 2               ; Input: A = character to write
00019Er 2               ; Modifies: Flags
00019Er 2               VideoPutCharImpl:
00019Er 2  48             pha
00019Fr 2                 ; Set VRAM write address from VID_CURSOR_ADDR
00019Fr 2  AD 09 03       lda VID_CURSOR_ADDR
0001A2r 2  8D 01 9C       sta VC_REG                    ; Low byte of address
0001A5r 2  AD 0A 03       lda VID_CURSOR_ADDR + 1
0001A8r 2  09 40          ora #$40                      ; Set bit 6 for write mode
0001AAr 2  8D 01 9C       sta VC_REG                    ; High byte with write flag
0001ADr 2  68             pla
0001AEr 2  8D 00 9C       sta VC_DATA                   ; Write character to VRAM
0001B1r 2  60             rts
0001B2r 2               
0001B2r 2               ; VideoScroll — Scroll screen up one line
0001B2r 2               ; Copies VRAM rows 1-23 to rows 0-22 (920 bytes), clears row 23 with spaces
0001B2r 2               ; Uses SCROLL_BUF ($0320, 40 bytes) as temporary storage
0001B2r 2               ; Modifies: Flags, A, X, Y
0001B2r 2               VideoScrollImpl:
0001B2r 2                 ; Save STR_PTR (may be in use by caller, e.g. VideoPrintStr)
0001B2r 2  A5 02          lda STR_PTR
0001B4r 2  48             pha
0001B5r 2  A5 03          lda STR_PTR + 1
0001B7r 2  48             pha
0001B8r 2                 ; Source starts at row 1 (VRAM offset 40=$28), dest at row 0 (offset 0)
0001B8r 2                 ; We process 23 rows, copying each row up by one
0001B8r 2  A9 28          lda #<40                      ; Source address low = 40 (row 1)
0001BAr 2  85 02          sta STR_PTR
0001BCr 2  A9 00          lda #>40
0001BEr 2  85 03          sta STR_PTR + 1
0001C0r 2               
0001C0r 2  A2 17          ldx #23                       ; 23 rows to copy
0001C2r 2               @ScrollRowLoop:
0001C2r 2  DA             phx                           ; Save row counter
0001C3r 2               
0001C3r 2                 ; Set VRAM read address (source row)
0001C3r 2  A5 02          lda STR_PTR
0001C5r 2  8D 01 9C       sta VC_REG
0001C8r 2  A5 03          lda STR_PTR + 1
0001CAr 2  8D 01 9C       sta VC_REG                    ; Bit 6 clear = read mode
0001CDr 2                 ; Read 40 bytes into SCROLL_BUF
0001CDr 2  A0 00          ldy #$00
0001CFr 2               @ScrollRead:
0001CFr 2  AD 00 9C       lda VC_DATA
0001D2r 2  99 20 03       sta SCROLL_BUF,y
0001D5r 2  C8             iny
0001D6r 2  C0 28          cpy #40
0001D8r 2  D0 F5          bne @ScrollRead
0001DAr 2               
0001DAr 2                 ; Set VRAM write address (dest = source - 40)
0001DAr 2  A5 02          lda STR_PTR
0001DCr 2  38             sec
0001DDr 2  E9 28          sbc #40
0001DFr 2  8D 01 9C       sta VC_REG                    ; Dest address low
0001E2r 2  A5 03          lda STR_PTR + 1
0001E4r 2  E9 00          sbc #$00
0001E6r 2  09 40          ora #$40                      ; Set bit 6 for write mode
0001E8r 2  8D 01 9C       sta VC_REG                    ; Dest address high
0001EBr 2               
0001EBr 2                 ; Write 40 bytes from SCROLL_BUF
0001EBr 2  A0 00          ldy #$00
0001EDr 2               @ScrollWrite:
0001EDr 2  B9 20 03       lda SCROLL_BUF,y
0001F0r 2  8D 00 9C       sta VC_DATA
0001F3r 2  C8             iny
0001F4r 2  C0 28          cpy #40
0001F6r 2  D0 F5          bne @ScrollWrite
0001F8r 2               
0001F8r 2                 ; Advance source pointer by 40 for next row
0001F8r 2  A5 02          lda STR_PTR
0001FAr 2  18             clc
0001FBr 2  69 28          adc #40
0001FDr 2  85 02          sta STR_PTR
0001FFr 2  90 02          bcc @ScrollNoCarry
000201r 2  E6 03          inc STR_PTR + 1
000203r 2               @ScrollNoCarry:
000203r 2  FA             plx                           ; Restore row counter
000204r 2  CA             dex
000205r 2  D0 BB          bne @ScrollRowLoop
000207r 2               
000207r 2                 ; Clear bottom row (row 23) with spaces
000207r 2                 ; Row 23 address = 23 * 40 = 920 = $0398
000207r 2  A9 98          lda #$98                      ; Low byte of $0398
000209r 2  8D 01 9C       sta VC_REG
00020Cr 2  A9 03          lda #$03
00020Er 2  09 40          ora #$40                      ; Write mode
000210r 2  8D 01 9C       sta VC_REG
000213r 2  A9 20          lda #$20                      ; Space character
000215r 2  A0 28          ldy #40
000217r 2               @ScrollClearBottom:
000217r 2  8D 00 9C       sta VC_DATA
00021Ar 2  88             dey
00021Br 2  D0 FA          bne @ScrollClearBottom
00021Dr 2                 ; Restore STR_PTR
00021Dr 2  68             pla
00021Er 2  85 03          sta STR_PTR + 1
000220r 2  68             pla
000221r 2  85 02          sta STR_PTR
000223r 2  60             rts
000224r 2               
000224r 2               ; VideoChrout — Output character to video display
000224r 2               ; Handles control characters: CR ($0D), LF ($0A), BS ($08), BEL ($07)
000224r 2               ; Printable ASCII ($20-$7E) written to VRAM; all other codes silently discarded
000224r 2               ; Auto-wraps at column 40, auto-scrolls at row 24
000224r 2               ; Input: A = character to output
000224r 2               ; Preserves: A, X, Y (callers like ChrinImpl, BasPrintStr and Wozmon depend on this)
000224r 2               ; Modifies: Flags
000224r 2               VideoChroutImpl:
000224r 2  48             pha
000225r 2  DA             phx
000226r 2  5A             phy
000227r 2                 ; Fast path: printable ASCII ($20-$7E) — most common case
000227r 2  C9 20          cmp #$20
000229r 2  90 06          bcc @Control                  ; < $20 → check control codes
00022Br 2  C9 7F          cmp #$7F
00022Dr 2  90 14          bcc @PrintChar                ; $20-$7E → printable character
00022Fr 2                 ; >= $7F (DEL and above) — discard
00022Fr 2                 ; User programs wanting raw glyph output should use VideoChroutRaw.
00022Fr 2  80 45          bra @VideoChroutDone
000231r 2               @Control:
000231r 2  C9 0D          cmp #$0D                      ; Carriage Return?
000233r 2  F0 45          beq @VideoCR
000235r 2  C9 0A          cmp #$0A                      ; Line Feed?
000237r 2  F0 4E          beq @VideoLF
000239r 2  C9 08          cmp #$08                      ; Backspace?
00023Br 2  F0 67          beq @VideoBS
00023Dr 2  C9 07          cmp #$07                      ; Bell?
00023Fr 2  F0 7B          beq @VideoBEL
000241r 2                 ; Unrecognized control code — discard
000241r 2  80 33          bra @VideoChroutDone
000243r 2               @PrintChar:
000243r 2                 ; Regular printable character — write at cursor and advance
000243r 2  20 rr rr       jsr VideoPutChar              ; Write char to VRAM at cursor
000246r 2                 ; Advance cursor
000246r 2  EE 07 03       inc VID_CURSOR_X
000249r 2                 ; Increment VRAM address
000249r 2  EE 09 03       inc VID_CURSOR_ADDR
00024Cr 2  D0 03          bne @CheckWrap
00024Er 2  EE 0A 03       inc VID_CURSOR_ADDR + 1
000251r 2               @CheckWrap:
000251r 2  AD 07 03       lda VID_CURSOR_X
000254r 2  C9 28          cmp #40                       ; Past last column?
000256r 2  90 1E          bcc @VideoChroutDone          ; No, done
000258r 2                 ; Auto-wrap: CR + LF
000258r 2  9C 07 03       stz VID_CURSOR_X
00025Br 2  EE 08 03       inc VID_CURSOR_Y
00025Er 2  AD 08 03       lda VID_CURSOR_Y
000261r 2  C9 18          cmp #24                       ; Past last row?
000263r 2  90 08          bcc @WrapRecalc
000265r 2                 ; Need to scroll
000265r 2  20 rr rr       jsr VideoScroll
000268r 2  A9 17          lda #23
00026Ar 2  8D 08 03       sta VID_CURSOR_Y
00026Dr 2               @WrapRecalc:
00026Dr 2  AE 07 03       ldx VID_CURSOR_X
000270r 2  AC 08 03       ldy VID_CURSOR_Y
000273r 2  20 rr rr       jsr VideoSetCursor            ; Recalculate VRAM address
000276r 2               @VideoChroutDone:
000276r 2  7A             ply
000277r 2  FA             plx
000278r 2  68             pla
000279r 2  60             rts
00027Ar 2               
00027Ar 2               @VideoCR:
00027Ar 2  9C 07 03       stz VID_CURSOR_X              ; Column = 0
00027Dr 2  A2 00          ldx #$00
00027Fr 2  AC 08 03       ldy VID_CURSOR_Y
000282r 2  20 rr rr       jsr VideoSetCursor            ; Recalculate VRAM address
000285r 2  80 EF          bra @VideoChroutDone
000287r 2               
000287r 2               @VideoLF:
000287r 2  EE 08 03       inc VID_CURSOR_Y
00028Ar 2  AD 08 03       lda VID_CURSOR_Y
00028Dr 2  C9 18          cmp #24                       ; Past last row?
00028Fr 2  90 08          bcc @LFRecalc
000291r 2  20 rr rr       jsr VideoScroll
000294r 2  A9 17          lda #23
000296r 2  8D 08 03       sta VID_CURSOR_Y
000299r 2               @LFRecalc:
000299r 2  AE 07 03       ldx VID_CURSOR_X
00029Cr 2  AC 08 03       ldy VID_CURSOR_Y
00029Fr 2  20 rr rr       jsr VideoSetCursor
0002A2r 2  80 D2          bra @VideoChroutDone
0002A4r 2               
0002A4r 2               @VideoBS:
0002A4r 2  AD 07 03       lda VID_CURSOR_X
0002A7r 2  F0 CD          beq @VideoChroutDone          ; Already at column 0, ignore
0002A9r 2  CE 07 03       dec VID_CURSOR_X
0002ACr 2  AE 07 03       ldx VID_CURSOR_X
0002AFr 2  AC 08 03       ldy VID_CURSOR_Y
0002B2r 2  20 rr rr       jsr VideoSetCursor            ; Recalculate VRAM address
0002B5r 2  A9 20          lda #$20                      ; Write space to erase character
0002B7r 2  20 rr rr       jsr VideoPutChar
0002BAr 2  80 BA          bra @VideoChroutDone
0002BCr 2               
0002BCr 2               @VideoBEL:
0002BCr 2  20 rr rr       jsr Beep
0002BFr 2  80 B5          bra @VideoChroutDone
0002C1r 2               
0002C1r 2               ; VideoChroutRaw — Output character to video (raw, no control-code handling)
0002C1r 2               ; Always writes the character glyph at the cursor position and advances.
0002C1r 2               ; Input: A = character code (0-255)
0002C1r 2               ; Preserves: A, X, Y
0002C1r 2               ; Modifies: Flags
0002C1r 2               VideoChroutRawImpl:
0002C1r 2  48             pha
0002C2r 2  DA             phx
0002C3r 2  5A             phy
0002C4r 2  20 rr rr       jsr VideoPutChar              ; Write char to VRAM at cursor
0002C7r 2  EE 07 03       inc VID_CURSOR_X
0002CAr 2  EE 09 03       inc VID_CURSOR_ADDR
0002CDr 2  D0 03          bne @RawCheckWrap
0002CFr 2  EE 0A 03       inc VID_CURSOR_ADDR + 1
0002D2r 2               @RawCheckWrap:
0002D2r 2  AD 07 03       lda VID_CURSOR_X
0002D5r 2  C9 28          cmp #40                       ; Past last column?
0002D7r 2  90 1E          bcc @RawDone
0002D9r 2  9C 07 03       stz VID_CURSOR_X
0002DCr 2  EE 08 03       inc VID_CURSOR_Y
0002DFr 2  AD 08 03       lda VID_CURSOR_Y
0002E2r 2  C9 18          cmp #24                       ; Past last row?
0002E4r 2  90 08          bcc @RawRecalc
0002E6r 2  20 rr rr       jsr VideoScroll
0002E9r 2  A9 17          lda #23
0002EBr 2  8D 08 03       sta VID_CURSOR_Y
0002EEr 2               @RawRecalc:
0002EEr 2  AE 07 03       ldx VID_CURSOR_X
0002F1r 2  AC 08 03       ldy VID_CURSOR_Y
0002F4r 2  20 rr rr       jsr VideoSetCursor
0002F7r 2               @RawDone:
0002F7r 2  7A             ply
0002F8r 2  FA             plx
0002F9r 2  68             pla
0002FAr 2  60             rts
0002FBr 2               
0002FBr 2               ; VideoPrintStr — Print null-terminated string to video
0002FBr 2               ; Input: STR_PTR ($02-$03) points to string
0002FBr 2               ; Modifies: Flags, A, X, Y
0002FBr 2               VideoPrintStrImpl:
0002FBr 2  A0 00          ldy #$00
0002FDr 2               @VideoPrintStrLoop:
0002FDr 2  B1 02          lda (STR_PTR),y
0002FFr 2  F0 08          beq @VideoPrintStrDone        ; Exit on null terminator
000301r 2  5A             phy
000302r 2  20 rr rr       jsr VideoChroutImpl           ; Output character via video
000305r 2  7A             ply
000306r 2  C8             iny
000307r 2  D0 F4          bne @VideoPrintStrLoop        ; Max 256 chars per string
000309r 2               @VideoPrintStrDone:
000309r 2  60             rts
00030Ar 2               
00030Ar 2               ; PrintStr — Print a NUL-terminated string to the console (routed by IO_MODE
00030Ar 2               ; through Chrout, so it works for video OR serial).  General-purpose; used by
00030Ar 2               ; BASIC (via the BasPrintStr alias) and available to cartridges.
00030Ar 2               ; Input : A = string address low, Y = string address high
00030Ar 2               ; Output: A, Y clobbered; X preserved; clobbers STR_PTR (Chrout preserves it)
00030Ar 2               PrintStrImpl:
00030Ar 2  85 02          sta STR_PTR
00030Cr 2  84 03          sty STR_PTR + 1
00030Er 2  A0 00          ldy #$00
000310r 2               @PrintStrLoop:
000310r 2  B1 02          lda (STR_PTR),y
000312r 2  F0 06          beq @PrintStrDone             ; NUL terminator
000314r 2  20 rr rr       jsr Chrout
000317r 2  C8             iny
000318r 2  D0 F6          bne @PrintStrLoop             ; Max 256 chars per call
00031Ar 2               @PrintStrDone:
00031Ar 2  60             rts
00031Br 2               
00031Br 2               ; PrintCRLF — Emit CR ($0D) then LF ($0A) via Chrout.
00031Br 2               PrintCRLFImpl:
00031Br 2  A9 0D          lda #$0D
00031Dr 2  20 rr rr       jsr Chrout
000320r 2  A9 0A          lda #$0A
000322r 2  4C rr rr       jmp Chrout
000325r 2               
000325r 2               ; KernalInit — Initialize RAM variables, probe & init all hardware
000325r 2               ; Sets HW_PRESENT, IO_MODE, IRQ/BRK/NMI pointers, BOOT_VECTOR=0
000325r 2               ; Does NOT enable interrupts (caller must cli)
000325r 2               ; Does NOT reset the stack pointer (caller should do this before JSR)
000325r 2               ; Does NOT display splash or enter boot menu
000325r 2               ; Modifies: All registers, flags
000325r 2               KernalInitImpl:
000325r 2  D8             cld                           ; Clear decimal mode
000326r 2  78             sei                           ; Disable interrupts
000327r 2               
000327r 2  A9 rr          lda #<Irq                     ; Initialize the IRQ pointer
000329r 2  8D 00 03       sta IRQ_PTR
00032Cr 2  A9 rr          lda #>Irq
00032Er 2  8D 01 03       sta IRQ_PTR + 1
000331r 2               
000331r 2  A9 rr          lda #<Break                   ; Initialize the BRK pointer
000333r 2  8D 02 03       sta BRK_PTR
000336r 2  A9 rr          lda #>Break
000338r 2  8D 03 03       sta BRK_PTR + 1
00033Br 2               
00033Br 2  A9 rr          lda #<Nmi                     ; Initialize the NMI pointer
00033Dr 2  8D 04 03       sta NMI_PTR
000340r 2  A9 rr          lda #>Nmi
000342r 2  8D 05 03       sta NMI_PTR + 1
000345r 2               
000345r 2  9C 0D 03       stz HW_PRESENT                ; Clear all hardware flags
000348r 2  9C 5B 03       stz BOOT_VECTOR               ; Clear boot redirect vector
00034Br 2  9C 5C 03       stz BOOT_VECTOR + 1
00034Er 2  9C 0F 03       stz CF_DISK                   ; Reset current CF disk bank to 0
000351r 2               
000351r 2  20 rr rr       jsr InitBuffer                ; Initialize the input buffer (RAM-only, no hardware)
000354r 2               
000354r 2  20 rr rr       jsr ProbeRAM                  ; Sets HW_RAM_L / HW_RAM_H if present (no init needed)
000357r 2               
000357r 2  20 rr rr       jsr ProbeRTC                  ; Sets HW_RTC if present (no init needed)
00035Ar 2               
00035Ar 2  20 rr rr       jsr StInit                    ; CF: timeout will handle absent card in Phase 3, sets HW_CF on success
00035Dr 2               
00035Dr 2  20 rr rr       jsr ProbeSerial               ; Sets HW_SC if present
000360r 2  AD 0D 03       lda HW_PRESENT
000363r 2  29 10          and #HW_SC
000365r 2  F0 03          beq @SkipSerial
000367r 2  20 rr rr       jsr InitSCImpl
00036Ar 2               @SkipSerial:
00036Ar 2               
00036Ar 2  20 rr rr       jsr ProbeGPIO                 ; Sets HW_GPIO if present
00036Dr 2  AD 0D 03       lda HW_PRESENT
000370r 2  29 20          and #HW_GPIO
000372r 2  F0 03          beq @SkipGPIO
000374r 2  20 rr rr       jsr InitKBImpl
000377r 2               @SkipGPIO:
000377r 2               
000377r 2  20 rr rr       jsr ProbeSID                  ; Sets HW_SID if present
00037Ar 2  AD 0D 03       lda HW_PRESENT
00037Dr 2  29 40          and #HW_SID
00037Fr 2  F0 03          beq @SkipSID
000381r 2  20 rr rr       jsr InitSIDImpl
000384r 2               @SkipSID:
000384r 2               
000384r 2  20 rr rr       jsr ProbeVideo                ; Sets HW_VID if present
000387r 2  AD 0D 03       lda HW_PRESENT
00038Ar 2  29 80          and #HW_VID
00038Cr 2  F0 06          beq @SkipVideo
00038Er 2  20 rr rr       jsr InitVideoImpl
000391r 2  20 rr rr       jsr InitCharacters
000394r 2               @SkipVideo:
000394r 2               
000394r 2                 ; Console auto-detection — determine IO_MODE from available hardware
000394r 2  AD 0D 03       lda HW_PRESENT
000397r 2  29 80          and #HW_VID
000399r 2  D0 09          bne @ConsoleVideo             ; Video present — use it
00039Br 2  AD 0D 03       lda HW_PRESENT
00039Er 2  29 10          and #HW_SC
0003A0r 2  D0 15          bne @ConsoleSerial            ; Serial present — use it
0003A2r 2                 ; Neither video nor serial — IO_MODE left as-is (no console)
0003A2r 2  80 18          bra @ConsoleDone
0003A4r 2               
0003A4r 2               @ConsoleVideo:
0003A4r 2  A9 00          lda #$00                      ; IO_MODE = video
0003A6r 2  8D 06 03       sta IO_MODE
0003A9r 2  9C 07 03       stz VID_CURSOR_X
0003ACr 2  9C 08 03       stz VID_CURSOR_Y
0003AFr 2  9C 09 03       stz VID_CURSOR_ADDR
0003B2r 2  9C 0A 03       stz VID_CURSOR_ADDR + 1
0003B5r 2  80 05          bra @ConsoleDone
0003B7r 2               
0003B7r 2               @ConsoleSerial:
0003B7r 2  A9 01          lda #$01                      ; IO_MODE = serial
0003B9r 2  8D 06 03       sta IO_MODE
0003BCr 2               
0003BCr 2               @ConsoleDone:
0003BCr 2  60             rts
0003BDr 2               
0003BDr 2               ; KernalVersion — Return BIOS version in registers
0003BDr 2               ; Output: A = major version, X = minor version
0003BDr 2               ; Modifies: A, X
0003BDr 2               KernalVersionImpl:
0003BDr 2  A9 01          lda #BIOS_VERSION_MAJOR
0003BFr 2  A2 02          ldx #BIOS_VERSION_MINOR
0003C1r 2  60             rts
0003C2r 2               
0003C2r 2               ; Reset — Full system startup: init hardware, beep, check boot vector, splash, boot menu
0003C2r 2               Reset:
0003C2r 2  A2 FF          ldx #$ff
0003C4r 2  9A             txs                           ; Reset the stack pointer
0003C5r 2  20 rr rr       jsr KernalInitImpl            ; Initialize all hardware (leaves interrupts disabled)
0003C8r 2               
0003C8r 2  20 rr rr       jsr Beep                      ; Play the startup beep (guarded — skips if no SID)
0003CBr 2               
0003CBr 2                 ; Check boot redirect vector — cartridges set this before jumping to Reset
0003CBr 2  AD 5B 03       lda BOOT_VECTOR
0003CEr 2  0D 5C 03       ora BOOT_VECTOR + 1
0003D1r 2  F0 03          beq @NormalBoot               ; Zero — continue normal boot
0003D3r 2  6C 5B 03       jmp (BOOT_VECTOR)             ; Non-zero — jump to cartridge/external program
0003D6r 2               
0003D6r 2               @NormalBoot:
0003D6r 2                 ; Verify console is available for interactive boot
0003D6r 2  AD 0D 03       lda HW_PRESENT
0003D9r 2  29 90          and #(HW_VID | HW_SC)
0003DBr 2  D0 02          bne @HasConsole
0003DDr 2                 ; Neither video nor serial — halt (no console for interactive boot)
0003DDr 2               @Halt:
0003DDr 2  80 FE          bra @Halt
0003DFr 2               
0003DFr 2               @HasConsole:
0003DFr 2  20 rr rr       jsr Splash                    ; Draw the splash screen (guarded — skips if no video)
0003E2r 2               
0003E2r 2  58             cli                           ; Enable interrupts
0003E3r 2               
0003E3r 2                 ; Boot menu — wait for keypress with ~5-second timeout
0003E3r 2                 ; Each iteration delays 100ms then checks for a key. 50 iterations = 5 seconds.
0003E3r 2  A2 32          ldx #50                       ; Timeout counter: 50 × 100ms = 5 seconds
0003E5r 2               @BootWait:
0003E5r 2  DA             phx                           ; Save timeout counter
0003E6r 2  A9 0A          lda #10                       ; 10 centiseconds (100ms)
0003E8r 2  A2 00          ldx #$00                      ; High byte = 0
0003EAr 2  20 rr rr       jsr SysDelay
0003EDr 2  20 rr rr       jsr BufferSize                ; A = bytes in buffer
0003F0r 2  FA             plx                           ; Restore timeout counter (clobbers Z flag)
0003F1r 2  C9 00          cmp #$00                      ; Re-test buffer size — plx overwrote Z
0003F3r 2  D0 05          bne @BootGotKey               ; Key available — process it
0003F5r 2  CA             dex
0003F6r 2  D0 ED          bne @BootWait                 ; No key yet — keep waiting
0003F8r 2  80 10          bra @BootBASIC                ; Timeout — auto-boot BASIC
0003FAr 2               
0003FAr 2               @BootGotKey:
0003FAr 2  20 rr rr       jsr ReadBuffer                ; Read the keypress
0003FDr 2  C9 0D          cmp #$0D                      ; ENTER?
0003FFr 2  F0 09          beq @BootBASIC
000401r 2  C9 1B          cmp #$1B                      ; ESC?
000403r 2  F0 0B          beq @BootMonitor
000405r 2  CA             dex                           ; Consumed a non-menu key — decrement counter
000406r 2  D0 DD          bne @BootWait                 ; Keep waiting if time remains
000408r 2  80 00          bra @BootBASIC                ; Timeout — auto-boot BASIC
00040Ar 2               
00040Ar 2               @BootBASIC:
00040Ar 2  20 rr rr       jsr VideoClear                ; Clear screen (harmless if no video)
00040Dr 2  4C rr rr       jmp BasEntry
000410r 2               @BootMonitor:
000410r 2  00             brk                           ; Enter monitor through BRK vector (saves/displays registers)
000411r 2               
000411r 2               ; Initialize the Keyboard via VIA (IO 6)
000411r 2               ; Configures Port B (matrix) and Port A (PS/2) as inputs
000411r 2               ; CB2 low (enable matrix encoder), CA2 low (enable PS/2 encoder)
000411r 2               ; CB1 and CA1 falling-edge IRQs enabled
000411r 2               ; Modifies: Flags, A
000411r 2               InitKBImpl:
000411r 2  A9 00          lda #$00                      ; Port B all inputs (matrix keyboard data bus)
000413r 2  8D 02 94       sta GPIO_DDRB
000416r 2  A9 00          lda #$00                      ; Port A all inputs (PS/2 keyboard data bus)
000418r 2  8D 03 94       sta GPIO_DDRA
00041Br 2                 ; PCR: CB2 low + CB1 neg + CA2 low + CA1 neg
00041Br 2  A9 CC          lda #(GPIO_PCR_CB2_LO | GPIO_PCR_CB1_NEG | GPIO_PCR_CA2_LO | GPIO_PCR_CA1_NEG)
00041Dr 2  8D 0C 94       sta GPIO_PCR
000420r 2                 ; Enable both CB1 and CA1 interrupts
000420r 2  A9 92          lda #(GPIO_IER_SET | GPIO_INT_CB1 | GPIO_INT_CA1)
000422r 2  8D 0E 94       sta GPIO_IER
000425r 2  60             rts
000426r 2               
000426r 2               ; Initialize the Serial Card (6551)
000426r 2               ; Modifies: Flags, A
000426r 2               InitSCImpl:
000426r 2  A9 1F          lda     #$1F                  ; 8-N-1, 19200 baud
000428r 2  8D 03 90       sta     SC_CTRL
00042Br 2  A9 09          lda     #$09                  ; No parity, no echo, RTSB low, TX interrupts disabled, RX interrupts enabled
00042Dr 2  8D 02 90       sta     SC_CMD
000430r 2  60             rts
000431r 2               
000431r 2               ; Initialze the Sound Card (6581)
000431r 2               ; Modifies: Flags, A, X
000431r 2               InitSIDImpl:
000431r 2  A9 00          lda #$00
000433r 2  A2 1D          ldx #$1D                      ; Clear all 29 SID registers
000435r 2               @InitSIDLoop:
000435r 2  9D 00 98       sta SID_V1_FREQ_LO,x          ; Clear register
000438r 2  CA             dex
000439r 2  10 FA          bpl @InitSIDLoop              ; Loop until all registers cleared
00043Br 2  A9 0F          lda #$0F                      ; Set volume to maximum
00043Dr 2  8D 18 98       sta SID_MODE_VOL
000440r 2  60             rts
000441r 2               
000441r 2               ; Initialize the Video Card (TMS9918)
000441r 2               ; Modifies: Flags, A, X
000441r 2               InitVideoImpl:
000441r 2  A2 00          ldx #$00                      ; Start with register 0
000443r 2               @InitVideoLoop:
000443r 2  BD rr rr       lda @InitVideoRegData,x       ; Load register value
000446r 2  8D 01 9C       sta VC_REG                    ; Write data byte
000449r 2  8A             txa
00044Ar 2  09 80          ora #$80                      ; Set bit 7 to indicate register write
00044Cr 2  8D 01 9C       sta VC_REG                    ; Write register number
00044Fr 2  E8             inx
000450r 2  E0 08          cpx #$08                      ; Check if all 8 registers written
000452r 2  D0 EF          bne @InitVideoLoop            ; Continue until done
000454r 2  60             rts
000455r 2               @InitVideoRegData:
000455r 2  00             .byte $00                     ; R0: Mode control (no external video)
000456r 2  D0             .byte $D0                     ; R1: 16K, display on, interrupt off, text mode M1
000457r 2  00             .byte $00                     ; R2: Name table at $0000 (0x00 * 0x400)
000458r 2  00             .byte $00                     ; R3: Color table (not used in text mode)
000459r 2  01             .byte $01                     ; R4: Pattern table at $0800 (0x01 * 0x800)
00045Ar 2  00             .byte $00                     ; R5: Sprite attribute table (not used in text mode)
00045Br 2  00             .byte $00                     ; R6: Sprite pattern table (not used in text mode)
00045Cr 2  1F             .byte $1F                     ; R7: Black text on white background
00045Dr 2               
00045Dr 2               ; Initialize the character set
00045Dr 2               ; Modifies: Flags, A, X, Y
00045Dr 2               InitCharacters:
00045Dr 2                 ; Set VRAM write address to $0800 (pattern table base)
00045Dr 2  A9 00          lda #$00                      ; Low byte of address
00045Fr 2  8D 01 9C       sta VC_REG
000462r 2  A9 48          lda #$48                      ; High byte ($08) OR $40 for write mode
000464r 2  8D 01 9C       sta VC_REG
000467r 2                 ; Set up source pointer
000467r 2  A9 rr          lda #<CharacterSet
000469r 2  85 02          sta STR_PTR                   ; Use STR_PTR ($02-$03) for character set pointer
00046Br 2  A9 rr          lda #>CharacterSet
00046Dr 2  85 03          sta STR_PTR + 1
00046Fr 2                 ; Copy 2048 bytes (8 pages of 256 bytes each)
00046Fr 2  A2 08          ldx #$08                      ; 8 pages to copy
000471r 2  A0 00          ldy #$00                      ; Byte counter within page
000473r 2               @InitCharPageLoop:
000473r 2  B1 02          lda (STR_PTR),y               ; Load from character set
000475r 2  8D 00 9C       sta VC_DATA                   ; Write to VRAM
000478r 2  C8             iny
000479r 2  D0 F8          bne @InitCharPageLoop         ; Loop until page complete (256 bytes)
00047Br 2  E6 03          inc STR_PTR + 1               ; Move to next page
00047Dr 2  CA             dex
00047Er 2  D0 F3          bne @InitCharPageLoop         ; Loop for all 8 pages
000480r 2  60             rts
000481r 2               
000481r 2               ; Initialize the INPUT_BUFFER
000481r 2               ; Modifies: Flags, A
000481r 2               InitBuffer:
000481r 2  A9 00          lda #$00
000483r 2  85 00          sta READ_PTR                  ; Init read and write pointers
000485r 2  85 01          sta WRITE_PTR
000487r 2  60             rts
000488r 2               
000488r 2               ; Write a character from the A register to the INPUT_BUFFER
000488r 2               ; Modifies: Flags, X
000488r 2               WriteBufferImpl:
000488r 2  A6 01          ldx WRITE_PTR
00048Ar 2  9D 00 02       sta INPUT_BUFFER,x
00048Dr 2  E6 01          inc WRITE_PTR
00048Fr 2  60             rts
000490r 2               
000490r 2               ; Read a character from the INPUT_BUFFER and store it in A register
000490r 2               ; Modifies: Flags, X, A
000490r 2               ReadBufferImpl:
000490r 2  A6 00          ldx READ_PTR
000492r 2  BD 00 02       lda INPUT_BUFFER,x
000495r 2  E6 00          inc READ_PTR
000497r 2  60             rts
000498r 2               
000498r 2               ; Return in A register the number of unread bytes in the INPUT_BUFFER
000498r 2               ; Modifies: Flags, A
000498r 2               BufferSizeImpl:
000498r 2  A5 01          lda WRITE_PTR
00049Ar 2  38             sec
00049Br 2  E5 00          sbc READ_PTR
00049Dr 2  60             rts
00049Er 2               
00049Er 2               ; Get a character from the INPUT_BUFFER if available
00049Er 2               ; On return, carry flag indicates whether a character was available
00049Er 2               ; If character available the character will be in the A register
00049Er 2               ; Modifies: Flags, A
00049Er 2               ChrinImpl:
00049Er 2  DA             phx
00049Fr 2  20 rr rr       jsr BufferSize                ; Check for character available
0004A2r 2  F0 2C          beq @ChrinNoChar              ; Branch if no character available
0004A4r 2  20 rr rr       jsr ReadBuffer                ; Read the character from the buffer
0004A7r 2  20 rr rr       jsr Chrout                    ; Echo
0004AAr 2  48             pha
0004ABr 2  20 rr rr       jsr BufferSize
0004AEr 2  C9 B0          cmp #$B0                      ; Check if buffer is mostly full
0004B0r 2  90 0E          bcc @ChrinNotFull             ; Branch if buffer size < $B0
0004B2r 2                 ; Only touch SC_CMD if serial is present
0004B2r 2  AD 0D 03       lda HW_PRESENT
0004B5r 2  29 10          and #HW_SC
0004B7r 2  F0 13          beq @ChrinExit
0004B9r 2  A9 01          lda #$01                      ; No parity, no echo, RTSB high, TX interrupts disabled, RX interrupts enabled
0004BBr 2  8D 02 90       sta SC_CMD
0004BEr 2  80 0C          bra @ChrinExit
0004C0r 2               @ChrinNotFull:
0004C0r 2  AD 0D 03       lda HW_PRESENT
0004C3r 2  29 10          and #HW_SC
0004C5r 2  F0 05          beq @ChrinExit
0004C7r 2  A9 09          lda #$09                      ; No parity, no echo, RTSB low, TX interrupts disabled, RX interrupts enabled
0004C9r 2  8D 02 90       sta SC_CMD
0004CCr 2               @ChrinExit:
0004CCr 2  68             pla
0004CDr 2  FA             plx
0004CEr 2  38             sec
0004CFr 2  60             rts
0004D0r 2               @ChrinNoChar:
0004D0r 2  FA             plx
0004D1r 2  18             clc
0004D2r 2  60             rts
0004D3r 2               
0004D3r 2               ; Output a character from the A register to the Serial Card
0004D3r 2               ; Modifies: Flags
0004D3r 2               SerialChroutImpl:
0004D3r 2  8D 00 90       sta SC_DATA
0004D6r 2  48             pha
0004D7r 2               @ChroutWait:
0004D7r 2  AD 01 90       lda SC_STATUS
0004DAr 2  29 10          and #SC_STATUS_TDRE           ; Check if TX buffer not empty
0004DCr 2  F0 F9          beq @ChroutWait               ; Loop if TX buffer not empty
0004DEr 2  68             pla
0004DFr 2  60             rts
0004E0r 2               
0004E0r 2               ; SidPlayNote — Play a note on a SID voice
0004E0r 2               ; Input: A = voice (0-2), X = frequency low byte, Y = frequency high byte
0004E0r 2               ; Uses triangle waveform with standard ADSR (Attack=0, Decay=9, Sustain=A, Release=2)
0004E0r 2               ; Modifies: Flags, A
0004E0r 2               SidPlayNoteImpl:
0004E0r 2  C9 01          cmp #$01
0004E2r 2  F0 1A          beq @Voice2
0004E4r 2  C9 02          cmp #$02
0004E6r 2  F0 2C          beq @Voice3
0004E8r 2                 ; Voice 0
0004E8r 2  8E 00 98       stx SID_V1_FREQ_LO
0004EBr 2  8C 01 98       sty SID_V1_FREQ_HI
0004EEr 2  A9 09          lda #$09                      ; Attack = 0, Decay = 9
0004F0r 2  8D 05 98       sta SID_V1_AD
0004F3r 2  A9 A2          lda #$A2                      ; Sustain = A, Release = 2
0004F5r 2  8D 06 98       sta SID_V1_SR
0004F8r 2  A9 11          lda #$11                      ; Triangle wave + Gate on
0004FAr 2  8D 04 98       sta SID_V1_CTRL
0004FDr 2  60             rts
0004FEr 2               @Voice2:
0004FEr 2  8E 07 98       stx SID_V2_FREQ_LO
000501r 2  8C 08 98       sty SID_V2_FREQ_HI
000504r 2  A9 09          lda #$09
000506r 2  8D 0C 98       sta SID_V2_AD
000509r 2  A9 A2          lda #$A2
00050Br 2  8D 0D 98       sta SID_V2_SR
00050Er 2  A9 11          lda #$11
000510r 2  8D 0B 98       sta SID_V2_CTRL
000513r 2  60             rts
000514r 2               @Voice3:
000514r 2  8E 0E 98       stx SID_V3_FREQ_LO
000517r 2  8C 0F 98       sty SID_V3_FREQ_HI
00051Ar 2  A9 09          lda #$09
00051Cr 2  8D 13 98       sta SID_V3_AD
00051Fr 2  A9 A2          lda #$A2
000521r 2  8D 14 98       sta SID_V3_SR
000524r 2  A9 11          lda #$11
000526r 2  8D 12 98       sta SID_V3_CTRL
000529r 2  60             rts
00052Ar 2               
00052Ar 2               ; SidSilence — Silence all 3 SID voices
00052Ar 2               ; Gates off all voices and zeros their frequencies
00052Ar 2               ; Modifies: Flags, A
00052Ar 2               SidSilenceImpl:
00052Ar 2  A9 10          lda #$10                      ; Triangle wave, Gate off
00052Cr 2  8D 04 98       sta SID_V1_CTRL
00052Fr 2  8D 0B 98       sta SID_V2_CTRL
000532r 2  8D 12 98       sta SID_V3_CTRL
000535r 2  A9 00          lda #$00
000537r 2  8D 00 98       sta SID_V1_FREQ_LO
00053Ar 2  8D 01 98       sta SID_V1_FREQ_HI
00053Dr 2  8D 07 98       sta SID_V2_FREQ_LO
000540r 2  8D 08 98       sta SID_V2_FREQ_HI
000543r 2  8D 0E 98       sta SID_V3_FREQ_LO
000546r 2  8D 0F 98       sta SID_V3_FREQ_HI
000549r 2  60             rts
00054Ar 2               
00054Ar 2               ; Play a short beep sound
00054Ar 2               ; Uses SidPlayNote on voice 0 with ~475 Hz tone, then silences
00054Ar 2               ; Skips silently if SID is absent
00054Ar 2               ; Modifies: Flags, A, X, Y
00054Ar 2               BeepImpl:
00054Ar 2  AD 0D 03       lda HW_PRESENT
00054Dr 2  29 40          and #HW_SID
00054Fr 2  D0 01          bne @BeepStart
000551r 2  60             rts                           ; No SID — skip silently
000552r 2               @BeepStart:
000552r 2  A9 00          lda #$00                      ; Voice 0
000554r 2  A2 20          ldx #$20                      ; Frequency low byte (~475 Hz)
000556r 2  A0 1F          ldy #$1F                      ; Frequency high byte
000558r 2  20 rr rr       jsr SidPlayNote
00055Br 2                 ; Override ADSR for beep: fast decay, no sustain
00055Br 2  A9 09          lda #$09                      ; Attack = 0, Decay = 9
00055Dr 2  8D 05 98       sta SID_V1_AD
000560r 2  A9 00          lda #$00                      ; Sustain = 0, Release = 0
000562r 2  8D 06 98       sta SID_V1_SR
000565r 2                 ; Delay for beep duration
000565r 2  A2 F0          ldx #$F0                      ; Outer loop counter
000567r 2               @BeepDelay1:
000567r 2  A0 FF          ldy #$FF                      ; Inner loop counter
000569r 2               @BeepDelay2:
000569r 2  88             dey
00056Ar 2  D0 FD          bne @BeepDelay2
00056Cr 2  CA             dex
00056Dr 2  D0 F8          bne @BeepDelay1
00056Fr 2  20 rr rr       jsr SidSilence                ; Gate off all voices
000572r 2  60             rts
000573r 2               
000573r 2               ; SysDelay — Delay for a specified number of centiseconds
000573r 2               ; Input: A = count low byte, X = count high byte
000573r 2               ; Uses VIA T1 in one-shot mode. 9999 cycles @ 1MHz = ~10ms per tick.
000573r 2               ; Modifies: Flags, A, X, Y (X/Y clobbered only in software-fallback path)
000573r 2               SysDelayImpl:
000573r 2  85 2C          sta DELAY_CNT
000575r 2  86 2D          stx DELAY_CNT + 1
000577r 2                 ; Return immediately if count is zero
000577r 2  05 2D          ora DELAY_CNT + 1
000579r 2  F0 4F          beq @DelayDone
00057Br 2                 ; Check if VIA is present for hardware timer
00057Br 2  AD 0D 03       lda HW_PRESENT
00057Er 2  29 20          and #HW_GPIO
000580r 2  D0 19          bne @DelayHardware
000582r 2                 ; Software fallback — calibrated busy loop (~10ms per centisecond at 1MHz)
000582r 2                 ; Inner loop: 5 cycles × 256 iterations × 8 = ~10240 cycles ≈ 10ms
000582r 2               @DelaySoftLoop:
000582r 2  A0 00          ldy #$00                      ; 256 outer iterations
000584r 2  A2 08          ldx #8
000586r 2               @DelaySoftInner:
000586r 2  88             dey
000587r 2  D0 FD          bne @DelaySoftInner
000589r 2  CA             dex
00058Ar 2  D0 FA          bne @DelaySoftInner
00058Cr 2                 ; 16-bit decrement of DELAY_CNT
00058Cr 2  A5 2C          lda DELAY_CNT
00058Er 2  D0 02          bne @SoftDecLo
000590r 2  C6 2D          dec DELAY_CNT + 1
000592r 2               @SoftDecLo:
000592r 2  C6 2C          dec DELAY_CNT
000594r 2  A5 2C          lda DELAY_CNT
000596r 2  05 2D          ora DELAY_CNT + 1
000598r 2  D0 E8          bne @DelaySoftLoop
00059Ar 2  60             rts
00059Br 2               @DelayHardware:
00059Br 2                 ; Configure T1 one-shot mode: clear ACR bit 6
00059Br 2  AD 0B 94       lda GPIO_ACR
00059Er 2  29 BF          and #%10111111
0005A0r 2  8D 0B 94       sta GPIO_ACR
0005A3r 2               @DelayLoop:
0005A3r 2                 ; Load T1 latch: 9999 = $270F
0005A3r 2  A9 0F          lda #$0F
0005A5r 2  8D 06 94       sta GPIO_T1LL
0005A8r 2  A9 27          lda #$27
0005AAr 2  8D 07 94       sta GPIO_T1LH
0005ADr 2                 ; Write T1CH to start countdown (also clears IFR T1 flag)
0005ADr 2  A9 27          lda #$27
0005AFr 2  8D 05 94       sta GPIO_T1CH
0005B2r 2               @DelayPoll:
0005B2r 2  AD 0D 94       lda GPIO_IFR
0005B5r 2  29 40          and #%01000000                ; T1 timeout flag
0005B7r 2  F0 F9          beq @DelayPoll
0005B9r 2                 ; Clear flag by reading T1CL
0005B9r 2  AD 04 94       lda GPIO_T1CL
0005BCr 2                 ; 16-bit decrement
0005BCr 2  A5 2C          lda DELAY_CNT
0005BEr 2  D0 02          bne @DelayDecLo
0005C0r 2  C6 2D          dec DELAY_CNT + 1
0005C2r 2               @DelayDecLo:
0005C2r 2  C6 2C          dec DELAY_CNT
0005C4r 2                 ; Loop until both bytes zero
0005C4r 2  A5 2C          lda DELAY_CNT
0005C6r 2  05 2D          ora DELAY_CNT + 1
0005C8r 2  D0 D9          bne @DelayLoop
0005CAr 2               @DelayDone:
0005CAr 2  60             rts
0005CBr 2               
0005CBr 2               ; SidSetVolume — Set SID master volume
0005CBr 2               ; Input: A = volume (0-15); upper nibble of SID_MODE_VOL is cleared (no filter)
0005CBr 2               ; Modifies: Flags, A
0005CBr 2               SidSetVolumeImpl:
0005CBr 2  29 0F          and #$0F
0005CDr 2  8D 18 98       sta SID_MODE_VOL
0005D0r 2  60             rts
0005D1r 2               
0005D1r 2               ; VideoSetColor — Set TMS9918 text color register
0005D1r 2               ; Input: A = color byte (high nibble = fg color, low nibble = bg color)
0005D1r 2               ; Modifies: Flags, A
0005D1r 2               VideoSetColorImpl:
0005D1r 2  8D 01 9C       sta VC_REG                    ; Data byte
0005D4r 2  A9 87          lda #$87                      ; Register 7 | $80 (write mode flag)
0005D6r 2  8D 01 9C       sta VC_REG
0005D9r 2  60             rts
0005DAr 2               
0005DAr 2               ; KBDisable — Disable both keyboard encoders for raw port access
0005DAr 2               ; Sets CB2 high (disable matrix encoder) and CA2 high (disable PS/2 encoder)
0005DAr 2               ; Modifies: Flags, A
0005DAr 2               KBDisable:
0005DAr 2  A9 EE          lda #(GPIO_PCR_CB2_HI | GPIO_PCR_CB1_NEG | GPIO_PCR_CA2_HI | GPIO_PCR_CA1_NEG)
0005DCr 2  8D 0C 94       sta GPIO_PCR
0005DFr 2  60             rts
0005E0r 2               
0005E0r 2               ; KBEnable — Re-enable both keyboard encoders
0005E0r 2               ; Sets CB2 low (enable matrix encoder) and CA2 low (enable PS/2 encoder)
0005E0r 2               ; Modifies: Flags, A
0005E0r 2               KBEnable:
0005E0r 2  A9 CC          lda #(GPIO_PCR_CB2_LO | GPIO_PCR_CB1_NEG | GPIO_PCR_CA2_LO | GPIO_PCR_CA1_NEG)
0005E2r 2  8D 0C 94       sta GPIO_PCR
0005E5r 2  60             rts
0005E6r 2               
0005E6r 2               ; ReadJoystick1 — Read joystick 1 on Port B
0005E6r 2               ; Temporarily disables matrix keyboard encoder (CB2 high) to read raw port data
0005E6r 2               ; Output: A = joystick bitmask (bits: R-L-D-U-Y-X-B-A)
0005E6r 2               ; Modifies: Flags, A, X
0005E6r 2               ReadJoystick1Impl:
0005E6r 2  78             sei                           ; Disable interrupts during raw port read
0005E7r 2  AD 0C 94       lda GPIO_PCR
0005EAr 2  48             pha                           ; Save current PCR state
0005EBr 2                 ; Set CB2 high to disable matrix encoder, preserve CA2 state
0005EBr 2  A9 EC          lda #(GPIO_PCR_CB2_HI | GPIO_PCR_CB1_NEG | GPIO_PCR_CA2_LO | GPIO_PCR_CA1_NEG)
0005EDr 2  8D 0C 94       sta GPIO_PCR
0005F0r 2  AD 00 94       lda GPIO_PORTB                ; Read raw joystick data from Port B
0005F3r 2  AA             tax                           ; Save result in X
0005F4r 2  68             pla                           ; Restore original PCR state
0005F5r 2  8D 0C 94       sta GPIO_PCR
0005F8r 2  8A             txa                           ; Return result in A
0005F9r 2  58             cli                           ; Re-enable interrupts
0005FAr 2  60             rts
0005FBr 2               
0005FBr 2               ; ReadJoystick2 — Read joystick 2 on Port A
0005FBr 2               ; Temporarily disables PS/2 keyboard encoder (CA2 high) to read raw port data
0005FBr 2               ; Output: A = joystick bitmask (bits: R-L-D-U-Y-X-B-A)
0005FBr 2               ; Modifies: Flags, A, X
0005FBr 2               ReadJoystick2Impl:
0005FBr 2  78             sei                           ; Disable interrupts during raw port read
0005FCr 2  AD 0C 94       lda GPIO_PCR
0005FFr 2  48             pha                           ; Save current PCR state
000600r 2                 ; Set CA2 high to disable PS/2 encoder, preserve CB2 state
000600r 2  A9 CE          lda #(GPIO_PCR_CB2_LO | GPIO_PCR_CB1_NEG | GPIO_PCR_CA2_HI | GPIO_PCR_CA1_NEG)
000602r 2  8D 0C 94       sta GPIO_PCR
000605r 2  AD 01 94       lda GPIO_PORTA                ; Read raw joystick data from Port A
000608r 2  AA             tax                           ; Save result in X
000609r 2  68             pla                           ; Restore original PCR state
00060Ar 2  8D 0C 94       sta GPIO_PCR
00060Dr 2  8A             txa                           ; Return result in A
00060Er 2  58             cli                           ; Re-enable interrupts
00060Fr 2  60             rts
000610r 2               
000610r 2               ; === BCD Conversion Helpers ===
000610r 2               
000610r 2               ; BcdToBin — Convert BCD byte to binary
000610r 2               ; Input: A = BCD value (e.g. $35 represents 35)
000610r 2               ; Output: A = binary value (e.g. 35 = $23)
000610r 2               ; Modifies: Flags
000610r 2               BcdToBin:
000610r 2  48             pha
000611r 2  4A             lsr a                         ; Shift tens digit to low nibble
000612r 2  4A             lsr a
000613r 2  4A             lsr a
000614r 2  4A             lsr a                         ; A = tens digit (0-9)
000615r 2  0A             asl a                         ; A = tens * 2
000616r 2  8D 0C 03       sta RTC_TMP
000619r 2  0A             asl a                         ; A = tens * 4
00061Ar 2  0A             asl a                         ; A = tens * 8
00061Br 2  18             clc
00061Cr 2  6D 0C 03       adc RTC_TMP                   ; A = tens * 10 (8 + 2)
00061Fr 2  8D 0C 03       sta RTC_TMP
000622r 2  68             pla
000623r 2  29 0F          and #$0F                      ; A = ones digit
000625r 2  18             clc
000626r 2  6D 0C 03       adc RTC_TMP                   ; A = tens * 10 + ones = binary
000629r 2  60             rts
00062Ar 2               
00062Ar 2               ; BinToBcd — Convert binary byte to BCD
00062Ar 2               ; Input: A = binary value (0-99)
00062Ar 2               ; Output: A = BCD value
00062Ar 2               ; Modifies: Flags, X
00062Ar 2               BinToBcd:
00062Ar 2  A2 FF          ldx #$FF                      ; Tens counter (starts at -1)
00062Cr 2               @BinToBcdLoop:
00062Cr 2  E8             inx
00062Dr 2  38             sec
00062Er 2  E9 0A          sbc #10
000630r 2  B0 FA          bcs @BinToBcdLoop             ; Count tens
000632r 2  69 0A          adc #10                       ; Restore ones (carry clear, so adds 10 + 0)
000634r 2  8D 0C 03       sta RTC_TMP                   ; Save ones digit
000637r 2  8A             txa                           ; A = tens digit
000638r 2  0A             asl a
000639r 2  0A             asl a
00063Ar 2  0A             asl a
00063Br 2  0A             asl a                         ; Shift tens to high nibble
00063Cr 2  0D 0C 03       ora RTC_TMP                   ; Combine with ones
00063Fr 2  60             rts
000640r 2               
000640r 2               ; === DS1511Y RTC Routines ===
000640r 2               
000640r 2               ; RtcReadTime — Read current time from DS1511Y
000640r 2               ; Output: A = hours (binary), X = minutes (binary), Y = seconds (binary)
000640r 2               ; Modifies: Flags
000640r 2               RtcReadTimeImpl:
000640r 2  AD 02 88       lda RTC_HR
000643r 2  20 rr rr       jsr BcdToBin
000646r 2  48             pha                           ; Save hours
000647r 2  AD 01 88       lda RTC_MIN
00064Ar 2  20 rr rr       jsr BcdToBin
00064Dr 2  AA             tax                           ; X = minutes
00064Er 2  AD 00 88       lda RTC_SEC
000651r 2  20 rr rr       jsr BcdToBin
000654r 2  A8             tay                           ; Y = seconds
000655r 2  68             pla                           ; A = hours
000656r 2  60             rts
000657r 2               
000657r 2               ; RtcReadDate — Read current date from DS1511Y
000657r 2               ; Output: A = day of month (binary), X = month (binary), Y = year (binary)
000657r 2               ;         RTC_BUF_CENT = century (binary)
000657r 2               ; Modifies: Flags
000657r 2               RtcReadDateImpl:
000657r 2  AD 07 88       lda RTC_CENT
00065Ar 2  20 rr rr       jsr BcdToBin
00065Dr 2  8D 0B 03       sta RTC_BUF_CENT              ; Store century in buffer
000660r 2  AD 05 88       lda RTC_MON
000663r 2  29 1F          and #RTC_MON_MASK             ; Strip control bits (EOSC/E32K/BB32) before BCD decode
000665r 2  20 rr rr       jsr BcdToBin
000668r 2  AA             tax                           ; X = month
000669r 2  AD 06 88       lda RTC_YR
00066Cr 2  20 rr rr       jsr BcdToBin
00066Fr 2  A8             tay                           ; Y = year
000670r 2  AD 04 88       lda RTC_DATE
000673r 2  20 rr rr       jsr BcdToBin                  ; A = day of month
000676r 2  60             rts
000677r 2               
000677r 2               ; RtcWriteTime — Set DS1511Y time
000677r 2               ; Input: A = hours (binary), X = minutes (binary), Y = seconds (binary)
000677r 2               ; Modifies: Flags, A, X
000677r 2               RtcWriteTimeImpl:
000677r 2  48             pha                           ; Save hours
000678r 2  DA             phx                           ; Save minutes
000679r 2  5A             phy                           ; Save seconds
00067Ar 2                 ; Set TE bit to inhibit update transfers
00067Ar 2  AD 0F 88       lda RTC_CTRL_B
00067Dr 2  09 80          ora #RTC_CTRL_B_TE
00067Fr 2  8D 0F 88       sta RTC_CTRL_B
000682r 2                 ; Write seconds
000682r 2  68             pla                           ; A = seconds
000683r 2  20 rr rr       jsr BinToBcd
000686r 2  8D 00 88       sta RTC_SEC
000689r 2                 ; Write minutes
000689r 2  68             pla                           ; A = minutes
00068Ar 2  20 rr rr       jsr BinToBcd
00068Dr 2  8D 01 88       sta RTC_MIN
000690r 2                 ; Write hours
000690r 2  68             pla                           ; A = hours
000691r 2  20 rr rr       jsr BinToBcd
000694r 2  8D 02 88       sta RTC_HR
000697r 2                 ; Clear TE bit to resume updates
000697r 2  AD 0F 88       lda RTC_CTRL_B
00069Ar 2  29 7F          and #<~RTC_CTRL_B_TE
00069Cr 2  8D 0F 88       sta RTC_CTRL_B
00069Fr 2  60             rts
0006A0r 2               
0006A0r 2               ; RtcWriteDate — Set DS1511Y date
0006A0r 2               ; Input: A = day of month (binary), X = month (binary), Y = year (binary)
0006A0r 2               ;        RTC_BUF_CENT = century (binary)
0006A0r 2               ; Modifies: Flags, A, X
0006A0r 2               RtcWriteDateImpl:
0006A0r 2  48             pha                           ; Save day
0006A1r 2  DA             phx                           ; Save month
0006A2r 2  5A             phy                           ; Save year
0006A3r 2                 ; Set TE bit to inhibit update transfers
0006A3r 2  AD 0F 88       lda RTC_CTRL_B
0006A6r 2  09 80          ora #RTC_CTRL_B_TE
0006A8r 2  8D 0F 88       sta RTC_CTRL_B
0006ABr 2                 ; Write century
0006ABr 2  AD 0B 03       lda RTC_BUF_CENT
0006AEr 2  20 rr rr       jsr BinToBcd
0006B1r 2  8D 07 88       sta RTC_CENT
0006B4r 2                 ; Write year
0006B4r 2  68             pla                           ; A = year
0006B5r 2  20 rr rr       jsr BinToBcd
0006B8r 2  8D 06 88       sta RTC_YR
0006BBr 2                 ; Write month
0006BBr 2  68             pla                           ; A = month
0006BCr 2  20 rr rr       jsr BinToBcd
0006BFr 2  29 1F          and #RTC_MON_MASK             ; Keep only the month value bits
0006C1r 2  8D 0C 03       sta RTC_TMP
0006C4r 2  AD 05 88       lda RTC_MON
0006C7r 2  29 E0          and #<~RTC_MON_MASK           ; Preserve control bits (EOSC/E32K/BB32)
0006C9r 2  0D 0C 03       ora RTC_TMP
0006CCr 2  8D 05 88       sta RTC_MON
0006CFr 2                 ; Write day
0006CFr 2  68             pla                           ; A = day
0006D0r 2  20 rr rr       jsr BinToBcd
0006D3r 2  8D 04 88       sta RTC_DATE
0006D6r 2                 ; Clear TE bit to resume updates
0006D6r 2  AD 0F 88       lda RTC_CTRL_B
0006D9r 2  29 7F          and #<~RTC_CTRL_B_TE
0006DBr 2  8D 0F 88       sta RTC_CTRL_B
0006DEr 2  60             rts
0006DFr 2               
0006DFr 2               ; RtcReadNVRAM — Read a byte from DS1511Y NVRAM
0006DFr 2               ; Input: X = NVRAM address ($00-$FF)
0006DFr 2               ; Output: A = data byte
0006DFr 2               ; Modifies: Flags
0006DFr 2               RtcReadNVRAMImpl:
0006DFr 2  8E 10 88       stx RTC_RAM_ADDR
0006E2r 2  AD 13 88       lda RTC_RAM_DATA
0006E5r 2  60             rts
0006E6r 2               
0006E6r 2               ; RtcWriteNVRAM — Write a byte to DS1511Y NVRAM
0006E6r 2               ; Input: X = NVRAM address ($00-$FF), A = data byte
0006E6r 2               ; Modifies: Flags
0006E6r 2               RtcWriteNVRAMImpl:
0006E6r 2  8E 10 88       stx RTC_RAM_ADDR
0006E9r 2  8D 13 88       sta RTC_RAM_DATA
0006ECr 2  60             rts
0006EDr 2               
0006EDr 2               ; === Hardware Probes ===
0006EDr 2               
0006EDr 2               ; ProbeRAM — Test for banked SRAM on IO 1 and IO 2
0006EDr 2               ; Two-pattern read-back test ($A5 then $5A) on bank 0 data byte
0006EDr 2               ; Sets HW_RAM_L / HW_RAM_H in HW_PRESENT on success
0006EDr 2               ; Modifies: Flags, A
0006EDr 2               ProbeRAM:
0006EDr 2                 ; A naive "write byte, immediately read it back" test is unreliable: with no
0006EDr 2                 ; SRAM responding, bus/parasitic capacitance holds the just-written value for
0006EDr 2                 ; a cycle or two, so the read-back matches and the probe falsely passes.
0006EDr 2                 ; Instead we write complementary patterns into TWO different banks, then read
0006EDr 2                 ; them back AFTER intervening bus cycles (opcode fetches from ROM + a second
0006EDr 2                 ; bank's data) have flushed the bus. This forces the chip to actually store
0006EDr 2                 ; distinct values and also exercises the bank-select latch. Open bus cannot
0006EDr 2                 ; fake both reads. Bank-0/bank-1 byte 0 are saved and restored.
0006EDr 2               
0006EDr 2                 ; --- Probe RAM Low (IO 1) ---
0006EDr 2  9C FF 83       stz RAM_BANK_L                ; Bank 0
0006F0r 2  AD 00 80       lda RAM_DATA_L                ; Save bank-0 byte 0
0006F3r 2  48             pha
0006F4r 2  A9 01          lda #$01
0006F6r 2  8D FF 83       sta RAM_BANK_L                ; Bank 1
0006F9r 2  AD 00 80       lda RAM_DATA_L                ; Save bank-1 byte 0
0006FCr 2  48             pha
0006FDr 2  9C FF 83       stz RAM_BANK_L               ; Bank 0
000700r 2  A9 A5          lda #$A5
000702r 2  8D 00 80       sta RAM_DATA_L                ; bank0[0] = $A5
000705r 2  A9 01          lda #$01
000707r 2  8D FF 83       sta RAM_BANK_L                ; Bank 1
00070Ar 2  A9 5A          lda #$5A
00070Cr 2  8D 00 80       sta RAM_DATA_L                ; bank1[0] = $5A (flips data + address lines)
00070Fr 2  9C FF 83       stz RAM_BANK_L               ; Back to bank 0
000712r 2  AD 00 80       lda RAM_DATA_L               ; Read bank0[0] (bus no longer holds $A5)
000715r 2  C9 A5          cmp #$A5
000717r 2  D0 14          bne @RAMLRestore             ; Bank 0 did not retain its value
000719r 2  A9 01          lda #$01
00071Br 2  8D FF 83       sta RAM_BANK_L                ; Bank 1
00071Er 2  AD 00 80       lda RAM_DATA_L               ; Read bank1[0]
000721r 2  C9 5A          cmp #$5A
000723r 2  D0 08          bne @RAMLRestore             ; Bank 1 did not retain (or latch failed)
000725r 2  AD 0D 03       lda HW_PRESENT
000728r 2  09 01          ora #HW_RAM_L
00072Ar 2  8D 0D 03       sta HW_PRESENT
00072Dr 2               @RAMLRestore:
00072Dr 2  A9 01          lda #$01
00072Fr 2  8D FF 83       sta RAM_BANK_L                ; Bank 1
000732r 2  68             pla
000733r 2  8D 00 80       sta RAM_DATA_L                ; Restore bank-1 byte 0
000736r 2  9C FF 83       stz RAM_BANK_L               ; Bank 0
000739r 2  68             pla
00073Ar 2  8D 00 80       sta RAM_DATA_L                ; Restore bank-0 byte 0
00073Dr 2               
00073Dr 2                 ; --- Probe RAM High (IO 2) ---
00073Dr 2  9C FF 87       stz RAM_BANK_H                ; Bank 0
000740r 2  AD 00 84       lda RAM_DATA_H                ; Save bank-0 byte 0
000743r 2  48             pha
000744r 2  A9 01          lda #$01
000746r 2  8D FF 87       sta RAM_BANK_H                ; Bank 1
000749r 2  AD 00 84       lda RAM_DATA_H                ; Save bank-1 byte 0
00074Cr 2  48             pha
00074Dr 2  9C FF 87       stz RAM_BANK_H               ; Bank 0
000750r 2  A9 A5          lda #$A5
000752r 2  8D 00 84       sta RAM_DATA_H                ; bank0[0] = $A5
000755r 2  A9 01          lda #$01
000757r 2  8D FF 87       sta RAM_BANK_H                ; Bank 1
00075Ar 2  A9 5A          lda #$5A
00075Cr 2  8D 00 84       sta RAM_DATA_H                ; bank1[0] = $5A (flips data + address lines)
00075Fr 2  9C FF 87       stz RAM_BANK_H               ; Back to bank 0
000762r 2  AD 00 84       lda RAM_DATA_H               ; Read bank0[0] (bus no longer holds $A5)
000765r 2  C9 A5          cmp #$A5
000767r 2  D0 14          bne @RAMHRestore             ; Bank 0 did not retain its value
000769r 2  A9 01          lda #$01
00076Br 2  8D FF 87       sta RAM_BANK_H                ; Bank 1
00076Er 2  AD 00 84       lda RAM_DATA_H               ; Read bank1[0]
000771r 2  C9 5A          cmp #$5A
000773r 2  D0 08          bne @RAMHRestore             ; Bank 1 did not retain (or latch failed)
000775r 2  AD 0D 03       lda HW_PRESENT
000778r 2  09 02          ora #HW_RAM_H
00077Ar 2  8D 0D 03       sta HW_PRESENT
00077Dr 2               @RAMHRestore:
00077Dr 2  A9 01          lda #$01
00077Fr 2  8D FF 87       sta RAM_BANK_H                ; Bank 1
000782r 2  68             pla
000783r 2  8D 00 84       sta RAM_DATA_H                ; Restore bank-1 byte 0
000786r 2  9C FF 87       stz RAM_BANK_H               ; Bank 0
000789r 2  68             pla
00078Ar 2  8D 00 84       sta RAM_DATA_H                ; Restore bank-0 byte 0
00078Dr 2  60             rts
00078Er 2               
00078Er 2               ; ProbeVideo — TMS9918 VRAM read-back test
00078Er 2               ; Writes $A5 to VRAM address $0000, reads it back
00078Er 2               ; Sets HW_VID in HW_PRESENT on success
00078Er 2               ; Modifies: Flags, A
00078Er 2               ProbeVideo:
00078Er 2                 ; Write $A5 to VRAM $0000
00078Er 2  A9 00          lda #$00
000790r 2  8D 01 9C       sta VC_REG                    ; Low byte of address
000793r 2  A9 40          lda #$40                      ; High byte $00 OR $40 for write mode
000795r 2  8D 01 9C       sta VC_REG
000798r 2  A9 A5          lda #$A5
00079Ar 2  8D 00 9C       sta VC_DATA                   ; Write data byte
00079Dr 2                 ; Read back from VRAM $0000
00079Dr 2  A9 00          lda #$00
00079Fr 2  8D 01 9C       sta VC_REG                    ; Low byte of address
0007A2r 2  A9 00          lda #$00                      ; High byte $00, bit 6 clear for read mode
0007A4r 2  8D 01 9C       sta VC_REG
0007A7r 2  AD 00 9C       lda VC_DATA                   ; Read data byte
0007AAr 2  C9 A5          cmp #$A5
0007ACr 2  D0 17          bne @ProbeVideoDone
0007AEr 2  AD 0D 03       lda HW_PRESENT
0007B1r 2  09 80          ora #HW_VID
0007B3r 2  8D 0D 03       sta HW_PRESENT
0007B6r 2                 ; Clean up probe byte — write $00 back to VRAM $0000
0007B6r 2  A9 00          lda #$00
0007B8r 2  8D 01 9C       sta VC_REG                    ; Low byte of address
0007BBr 2  A9 40          lda #$40                      ; High byte $00 OR $40 for write mode
0007BDr 2  8D 01 9C       sta VC_REG
0007C0r 2  A9 00          lda #$00
0007C2r 2  8D 00 9C       sta VC_DATA
0007C5r 2               @ProbeVideoDone:
0007C5r 2  60             rts
0007C6r 2               
0007C6r 2               ; ProbeGPIO — VIA DDR register read-back test
0007C6r 2               ; Writes $AA to GPIO_DDRB, reads it back
0007C6r 2               ; Sets HW_GPIO in HW_PRESENT on success
0007C6r 2               ; Restores GPIO_DDRB to $00 afterward
0007C6r 2               ; Modifies: Flags, A
0007C6r 2               ProbeGPIO:
0007C6r 2  A9 AA          lda #$AA
0007C8r 2  8D 02 94       sta GPIO_DDRB
0007CBr 2  CD 02 94       cmp GPIO_DDRB
0007CEr 2  D0 08          bne @ProbeGPIODone
0007D0r 2  AD 0D 03       lda HW_PRESENT
0007D3r 2  09 20          ora #HW_GPIO
0007D5r 2  8D 0D 03       sta HW_PRESENT
0007D8r 2               @ProbeGPIODone:
0007D8r 2  9C 02 94       stz GPIO_DDRB                 ; Restore to inputs (InitKBImpl will configure properly)
0007DBr 2  60             rts
0007DCr 2               
0007DCr 2               ; ProbeSerial — R65C51 CMD register write/read-back test
0007DCr 2               ; Issues programmatic reset, writes test value to CMD, reads back
0007DCr 2               ; Open bus will not match — prevents false detection
0007DCr 2               ; Sets HW_SC in HW_PRESENT on success
0007DCr 2               ; Modifies: Flags, A
0007DCr 2               ProbeSerial:
0007DCr 2  9C 01 90       stz SC_RESET                  ; Programmatic reset (write any value)
0007DFr 2  A9 0A          lda #$0A                      ; Test value (bits within CMD writable range)
0007E1r 2  8D 02 90       sta SC_CMD                    ; Write to Command Register
0007E4r 2  CD 02 90       cmp SC_CMD                    ; Read back — should match if real hardware
0007E7r 2  D0 08          bne @ProbeSerialDone          ; Mismatch = open bus, no card present
0007E9r 2  AD 0D 03       lda HW_PRESENT
0007ECr 2  09 10          ora #HW_SC
0007EEr 2  8D 0D 03       sta HW_PRESENT
0007F1r 2               @ProbeSerialDone:
0007F1r 2  60             rts
0007F2r 2               
0007F2r 2               ; ProbeSID — Active oscillator test using voice 3
0007F2r 2               ; Configures voice 3 noise waveform, brief delay, reads SID_OSC3
0007F2r 2               ; Non-zero and non-$FF result indicates SID present
0007F2r 2               ; Sets HW_SID in HW_PRESENT on success
0007F2r 2               ; Modifies: Flags, A, X, Y
0007F2r 2               ProbeSID:
0007F2r 2                 ; Set voice 3 frequency to a fast value
0007F2r 2  A9 FF          lda #$FF
0007F4r 2  8D 0E 98       sta SID_V3_FREQ_LO
0007F7r 2  8D 0F 98       sta SID_V3_FREQ_HI
0007FAr 2                 ; Gate on + noise waveform
0007FAr 2  A9 81          lda #(SID_CTRL_GATE | SID_CTRL_NOISE)
0007FCr 2  8D 12 98       sta SID_V3_CTRL
0007FFr 2                 ; Brief software delay for oscillator to run
0007FFr 2  A0 00          ldy #$00
000801r 2               @ProbeSIDDelay:
000801r 2  88             dey
000802r 2  D0 FD          bne @ProbeSIDDelay            ; ~1280 cycles
000804r 2                 ; Read oscillator 3 output
000804r 2  AD 1B 98       lda SID_OSC3
000807r 2  F0 0E          beq @ProbeSIDCleanup          ; Zero → no SID
000809r 2  C9 FF          cmp #$FF
00080Br 2  F0 0A          beq @ProbeSIDCleanup          ; $FF → likely floating bus
00080Dr 2                 ; SID detected
00080Dr 2  48             pha
00080Er 2  AD 0D 03       lda HW_PRESENT
000811r 2  09 40          ora #HW_SID
000813r 2  8D 0D 03       sta HW_PRESENT
000816r 2  68             pla
000817r 2               @ProbeSIDCleanup:
000817r 2                 ; Silence voice 3
000817r 2  9C 12 98       stz SID_V3_CTRL
00081Ar 2  9C 0E 98       stz SID_V3_FREQ_LO
00081Dr 2  9C 0F 98       stz SID_V3_FREQ_HI
000820r 2  60             rts
000821r 2               
000821r 2               ; ProbeRTC — DS1511Y NVRAM read-back test
000821r 2               ; Writes test pattern to NVRAM address 0, reads it back
000821r 2               ; Sets HW_RTC in HW_PRESENT on success
000821r 2               ; Restores original NVRAM value afterward
000821r 2               ; Modifies: Flags, A
000821r 2               ProbeRTC:
000821r 2  9C 10 88       stz RTC_RAM_ADDR              ; Select NVRAM address 0
000824r 2  AD 13 88       lda RTC_RAM_DATA              ; Save existing value
000827r 2  48             pha
000828r 2  A9 A5          lda #$A5
00082Ar 2  8D 13 88       sta RTC_RAM_DATA              ; Write test pattern
00082Dr 2  CD 13 88       cmp RTC_RAM_DATA              ; Read back
000830r 2  D0 12          bne @ProbeRTCDone
000832r 2  AD 0D 03       lda HW_PRESENT
000835r 2  09 04          ora #HW_RTC
000837r 2  8D 0D 03       sta HW_PRESENT
00083Ar 2                 ; The DS1511Y SQW pin feeds the AB Controller, which turns every SQW edge into
00083Ar 2                 ; a 6502 NMI. Its control bits power up undefined and are battery-backed, so
00083Ar 2                 ; explicitly disable the square-wave output here. E32K/BB32/EOSC live in the
00083Ar 2                 ; upper 3 bits of the month register (05H); keep the month value and leave the
00083Ar 2                 ; oscillator running.
00083Ar 2  AD 05 88       lda RTC_MON
00083Dr 2  29 1F          and #RTC_MON_MASK             ; Keep month value (low 5 bits)
00083Fr 2  09 40          ora #RTC_MON_E32K             ; E32K=1 → SQW disabled; BB32=0, EOSC=0
000841r 2  8D 05 88       sta RTC_MON
000844r 2               @ProbeRTCDone:
000844r 2  68             pla
000845r 2  8D 13 88       sta RTC_RAM_DATA              ; Restore original value
000848r 2  60             rts
000849r 2               
000849r 2               ; === CompactFlash Storage Driver (True 8-bit IDE Mode) ===
000849r 2               
000849r 2               ; StWaitReady — Wait for CompactFlash to become ready
000849r 2               ; Polls ST_STATUS until BSY=0 and RDY=1, with X/Y timeout (~65536 iterations)
000849r 2               ; Output: Carry clear = ready, Carry set = error or timeout
000849r 2               ; Modifies: Flags, A, X, Y
000849r 2               StWaitReadyImpl:
000849r 2  A2 00          ldx #$00                      ; Outer timeout counter (256 × 256 = 65536 iterations)
00084Br 2  A0 00          ldy #$00
00084Dr 2               @StWaitBsy:
00084Dr 2  AD 07 8C       lda ST_STATUS
000850r 2  29 80          and #ST_STATUS_BSY            ; Check BSY bit
000852r 2  F0 08          beq @StCheckRdy               ; BSY clear — check RDY
000854r 2  88             dey
000855r 2  D0 F6          bne @StWaitBsy
000857r 2  CA             dex
000858r 2  D0 F3          bne @StWaitBsy
00085Ar 2  38             sec                           ; Timed out — no device
00085Br 2  60             rts
00085Cr 2               @StCheckRdy:
00085Cr 2  AD 07 8C       lda ST_STATUS
00085Fr 2  29 40          and #ST_STATUS_RDY            ; Check RDY bit
000861r 2  D0 08          bne @StCheckErr               ; RDY set — check for errors
000863r 2  88             dey
000864r 2  D0 E7          bne @StWaitBsy
000866r 2  CA             dex
000867r 2  D0 E4          bne @StWaitBsy
000869r 2  38             sec                           ; Timed out
00086Ar 2  60             rts
00086Br 2               @StCheckErr:
00086Br 2  AD 07 8C       lda ST_STATUS
00086Er 2  29 01          and #ST_STATUS_ERR            ; Check ERR bit
000870r 2  D0 02          bne @StWaitErr
000872r 2  18             clc                           ; Ready, no error
000873r 2  60             rts
000874r 2               @StWaitErr:
000874r 2  38             sec                           ; Error condition
000875r 2  60             rts
000876r 2               
000876r 2               ; StWaitDrq — Wait for CompactFlash data request
000876r 2               ; Polls ST_STATUS until BSY=0 and DRQ=1, with X/Y timeout (~65536 iterations)
000876r 2               ; Output: Carry clear = DRQ active, Carry set = error or timeout
000876r 2               ; Modifies: Flags, A, X, Y
000876r 2               StWaitDrq:
000876r 2  A2 00          ldx #$00                      ; Outer timeout counter (256 × 256 = 65536 iterations)
000878r 2  A0 00          ldy #$00
00087Ar 2               @StDrqBsy:
00087Ar 2  AD 07 8C       lda ST_STATUS
00087Dr 2  29 80          and #ST_STATUS_BSY
00087Fr 2  F0 08          beq @StDrqCheckDrq            ; BSY clear — check DRQ
000881r 2  88             dey
000882r 2  D0 F6          bne @StDrqBsy
000884r 2  CA             dex
000885r 2  D0 F3          bne @StDrqBsy
000887r 2  38             sec                           ; Timed out — no device
000888r 2  60             rts
000889r 2               @StDrqCheckDrq:
000889r 2  AD 07 8C       lda ST_STATUS
00088Cr 2  29 01          and #ST_STATUS_ERR
00088Er 2  D0 11          bne @StDrqErr
000890r 2  AD 07 8C       lda ST_STATUS
000893r 2  29 08          and #ST_STATUS_DRQ
000895r 2  D0 08          bne @StDrqOk                  ; DRQ set — ready for data
000897r 2  88             dey
000898r 2  D0 E0          bne @StDrqBsy
00089Ar 2  CA             dex
00089Br 2  D0 DD          bne @StDrqBsy
00089Dr 2  38             sec                           ; Timed out
00089Er 2  60             rts
00089Fr 2               @StDrqOk:
00089Fr 2  18             clc
0008A0r 2  60             rts
0008A1r 2               @StDrqErr:
0008A1r 2  38             sec
0008A2r 2  60             rts
0008A3r 2               
0008A3r 2               ; StInit — Initialize CompactFlash for 8-bit data transfers
0008A3r 2               ; Issues Set Features command with subcommand $01 (enable 8-bit I/O)
0008A3r 2               ; Output: Carry clear = success, Carry set = error
0008A3r 2               ; Modifies: Flags, A
0008A3r 2               StInit:
0008A3r 2  20 rr rr       jsr StWaitReady
0008A6r 2  B0 15          bcs @StInitDone               ; Timeout or error — CF not present
0008A8r 2                 ; CF responded — set presence flag
0008A8r 2  AD 0D 03       lda HW_PRESENT
0008ABr 2  09 08          ora #HW_CF
0008ADr 2  8D 0D 03       sta HW_PRESENT
0008B0r 2  A9 01          lda #ST_FEAT_8BIT             ; Feature: enable 8-bit data I/O
0008B2r 2  8D 01 8C       sta ST_FEATURE
0008B5r 2  A9 EF          lda #ST_CMD_SET_FEAT          ; Set Features command
0008B7r 2  8D 07 8C       sta ST_CMD
0008BAr 2  20 rr rr       jsr StWaitReady               ; Wait for command completion
0008BDr 2               @StInitDone:
0008BDr 2  60             rts
0008BEr 2               
0008BEr 2               ; StSetupLba — Set up LBA registers from CF_LBA zero page variables
0008BEr 2               ; Also sets sector count to 1 and selects master drive in LBA mode
0008BEr 2               ; Modifies: Flags, A
0008BEr 2               StSetupLba:
0008BEr 2  A9 01          lda #$01
0008C0r 2  8D 02 8C       sta ST_SECT_CNT               ; Always 1 sector
0008C3r 2                 ; Effective LBA = CF_LBA + CF_DISK * FS_DISK_SECTORS (disk banking base offset).
0008C3r 2                 ; base = CF_DISK << 11: byte0=0, byte1=(CF_DISK<<3)&$FF, byte2=CF_DISK>>5, byte3=0.
0008C3r 2                 ; Precompute base bits 16-23 (CF_DISK >> 5) into X before any add clobbers carry.
0008C3r 2  AD 0F 03       lda CF_DISK
0008C6r 2  4A             lsr a
0008C7r 2  4A             lsr a
0008C8r 2  4A             lsr a
0008C9r 2  4A             lsr a
0008CAr 2  4A             lsr a
0008CBr 2  AA             tax                           ; X = CF_DISK >> 5 (disk base, LBA bits 16-23)
0008CCr 2  A5 26          lda CF_LBA
0008CEr 2  8D 03 8C       sta ST_LBA_0                  ; LBA bits 0-7 (base low byte is 0)
0008D1r 2                 ; LBA bits 8-15: CF_LBA+1 + (CF_DISK << 3)
0008D1r 2  AD 0F 03       lda CF_DISK
0008D4r 2  0A             asl a
0008D5r 2  0A             asl a
0008D6r 2  0A             asl a                         ; A = (CF_DISK << 3) & $FF
0008D7r 2  18             clc
0008D8r 2  65 27          adc CF_LBA + 1
0008DAr 2  8D 04 8C       sta ST_LBA_1
0008DDr 2                 ; LBA bits 16-23: CF_LBA+2 + (CF_DISK >> 5) + carry
0008DDr 2  8A             txa
0008DEr 2  65 28          adc CF_LBA + 2
0008E0r 2  8D 05 8C       sta ST_LBA_2
0008E3r 2                 ; LBA bits 24-27: CF_LBA+3 + carry
0008E3r 2  A5 29          lda CF_LBA + 3
0008E5r 2  69 00          adc #$00
0008E7r 2  29 0F          and #$0F                      ; Mask to 4 bits (LBA 24-27)
0008E9r 2  09 E0          ora #ST_LBA3_MASTER           ; LBA mode, master drive
0008EBr 2  8D 06 8C       sta ST_LBA_3
0008EEr 2  60             rts
0008EFr 2               
0008EFr 2               ; StReadSector — Read one 512-byte sector from CompactFlash
0008EFr 2               ; Input: CF_LBA ($26-$29) = LBA address, CF_BUF_PTR ($24-$25) = destination pointer
0008EFr 2               ; Output: Carry clear = success, Carry set = error
0008EFr 2               ;         CF_BUF_PTR advanced by 512 bytes on success
0008EFr 2               ; Modifies: Flags, A, X, Y
0008EFr 2               StReadSectorImpl:
0008EFr 2  20 rr rr       jsr StWaitReady
0008F2r 2  B0 1F          bcs @StReadDone
0008F4r 2  20 rr rr       jsr StSetupLba
0008F7r 2  A9 20          lda #ST_CMD_READ              ; Issue read command
0008F9r 2  8D 07 8C       sta ST_CMD
0008FCr 2  20 rr rr       jsr StWaitDrq                 ; Wait for data ready
0008FFr 2  B0 12          bcs @StReadDone
000901r 2                 ; Read 512 bytes: 2 pages of 256 bytes
000901r 2  A0 00          ldy #$00
000903r 2  A2 02          ldx #$02                      ; 2 pages
000905r 2               @StReadPage:
000905r 2  AD 00 8C       lda ST_DATA                   ; Read byte from CF
000908r 2  91 24          sta (CF_BUF_PTR),y            ; Store to destination
00090Ar 2  C8             iny
00090Br 2  D0 F8          bne @StReadPage               ; Loop for 256 bytes
00090Dr 2  E6 25          inc CF_BUF_PTR + 1            ; Next page
00090Fr 2  CA             dex
000910r 2  D0 F3          bne @StReadPage
000912r 2  18             clc                           ; Success
000913r 2               @StReadDone:
000913r 2  60             rts
000914r 2               
000914r 2               ; StWriteSector — Write one 512-byte sector to CompactFlash
000914r 2               ; Input: CF_LBA ($26-$29) = LBA address, CF_BUF_PTR ($24-$25) = source pointer
000914r 2               ; Output: Carry clear = success, Carry set = error
000914r 2               ;         CF_BUF_PTR advanced by 512 bytes on success
000914r 2               ; Modifies: Flags, A, X, Y
000914r 2               StWriteSectorImpl:
000914r 2  20 rr rr       jsr StWaitReady
000917r 2  B0 21          bcs @StWriteDone
000919r 2  20 rr rr       jsr StSetupLba
00091Cr 2  A9 30          lda #ST_CMD_WRITE             ; Issue write command
00091Er 2  8D 07 8C       sta ST_CMD
000921r 2  20 rr rr       jsr StWaitDrq                 ; Wait for data request
000924r 2  B0 14          bcs @StWriteDone
000926r 2                 ; Write 512 bytes: 2 pages of 256 bytes
000926r 2  A0 00          ldy #$00
000928r 2  A2 02          ldx #$02                      ; 2 pages
00092Ar 2               @StWritePage:
00092Ar 2  B1 24          lda (CF_BUF_PTR),y            ; Load from source
00092Cr 2  8D 00 8C       sta ST_DATA                   ; Write byte to CF
00092Fr 2  C8             iny
000930r 2  D0 F8          bne @StWritePage              ; Loop for 256 bytes
000932r 2  E6 25          inc CF_BUF_PTR + 1            ; Next page
000934r 2  CA             dex
000935r 2  D0 F3          bne @StWritePage
000937r 2  20 rr rr       jsr StWaitReady               ; Wait for write to complete
00093Ar 2               @StWriteDone:
00093Ar 2  60             rts
00093Br 2               
00093Br 2               ; === Simple Custom Filesystem ===
00093Br 2               ; Directory at LBA 0: 16 entries x 32 bytes = 512 bytes
00093Br 2               ; Entry format:
00093Br 2               ;   $00-$07: 8-byte filename (space-padded)
00093Br 2               ;   $08-$0A: 3-byte extension (space-padded)
00093Br 2               ;   $0B:     flags (bit 0 = in use)
00093Br 2               ;   $0C-$0D: start sector (little-endian)
00093Br 2               ;   $0E-$0F: file size in bytes (little-endian)
00093Br 2               ;   $10-$1F: reserved (16 bytes)
00093Br 2               
00093Br 2               ; FsParseName — Parse null-terminated filename at STR_PTR into FS_FNAME_BUF
00093Br 2               ; Converts "NAME.EXT" into 8+3 space-padded format
00093Br 2               ; Input: STR_PTR ($02-$03) points to null-terminated filename
00093Br 2               ; Output: FS_FNAME_BUF filled with padded 8+3 name
00093Br 2               ; Modifies: Flags, A, X, Y
00093Br 2               FsParseName:
00093Br 2                 ; Fill FS_FNAME_BUF with spaces
00093Br 2  A9 20          lda #$20
00093Dr 2  A2 0A          ldx #10
00093Fr 2               @FsParseClr:
00093Fr 2  9D 50 03       sta FS_FNAME_BUF,x
000942r 2  CA             dex
000943r 2  10 FA          bpl @FsParseClr
000945r 2                 ; Copy name part (up to 8 chars, stop at '.' or null)
000945r 2  A0 00          ldy #$00                      ; Source index
000947r 2  A2 00          ldx #$00                      ; Dest index (name portion)
000949r 2               @FsParseName:
000949r 2  B1 02          lda (STR_PTR),y
00094Br 2  F0 35          beq @FsParseDone              ; Null terminator — no extension
00094Dr 2  C9 2E          cmp #'.'
00094Fr 2  F0 15          beq @FsParseExt               ; Found dot — start extension
000951r 2  E0 08          cpx #$08
000953r 2  B0 0E          bcs @FsParseSkipName          ; Already 8 chars, skip extras
000955r 2                 ; Convert lowercase to uppercase
000955r 2  C9 61          cmp #'a'
000957r 2  90 06          bcc @FsStoreNameChar
000959r 2  C9 7B          cmp #'z' + 1
00095Br 2  B0 02          bcs @FsStoreNameChar
00095Dr 2  29 DF          and #$DF                      ; Clear bit 5 to uppercase
00095Fr 2               @FsStoreNameChar:
00095Fr 2  9D 50 03       sta FS_FNAME_BUF,x
000962r 2  E8             inx
000963r 2               @FsParseSkipName:
000963r 2  C8             iny
000964r 2  80 E3          bra @FsParseName
000966r 2               @FsParseExt:
000966r 2  C8             iny                           ; Skip the dot
000967r 2  A2 08          ldx #$08                      ; Extension starts at offset 8
000969r 2               @FsParseExtLoop:
000969r 2  B1 02          lda (STR_PTR),y
00096Br 2  F0 15          beq @FsParseDone              ; Null terminator
00096Dr 2  E0 0B          cpx #$0B
00096Fr 2  B0 11          bcs @FsParseDone              ; Max 3 ext chars
000971r 2                 ; Convert lowercase to uppercase
000971r 2  C9 61          cmp #'a'
000973r 2  90 06          bcc @FsStoreExtChar
000975r 2  C9 7B          cmp #'z' + 1
000977r 2  B0 02          bcs @FsStoreExtChar
000979r 2  29 DF          and #$DF
00097Br 2               @FsStoreExtChar:
00097Br 2  9D 50 03       sta FS_FNAME_BUF,x
00097Er 2  E8             inx
00097Fr 2  C8             iny
000980r 2  80 E7          bra @FsParseExtLoop
000982r 2               @FsParseDone:
000982r 2  60             rts
000983r 2               
000983r 2               ; FsReadDir — Read directory sector (LBA 0) into FS_SECTOR_BUF
000983r 2               ; Output: Carry clear = success, Carry set = error
000983r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
000983r 2               FsReadDir:
000983r 2  64 26          stz CF_LBA                    ; LBA = 0 (directory sector)
000985r 2  64 27          stz CF_LBA + 1
000987r 2  64 28          stz CF_LBA + 2
000989r 2  64 29          stz CF_LBA + 3
00098Br 2  A9 00          lda #<FS_SECTOR_BUF
00098Dr 2  85 24          sta CF_BUF_PTR
00098Fr 2  A9 06          lda #>FS_SECTOR_BUF
000991r 2  85 25          sta CF_BUF_PTR + 1
000993r 2  4C rr rr       jmp StReadSector
000996r 2               
000996r 2               ; FsWriteDir — Write directory sector from FS_SECTOR_BUF to LBA 0
000996r 2               ; Output: Carry clear = success, Carry set = error
000996r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
000996r 2               FsWriteDir:
000996r 2  64 26          stz CF_LBA
000998r 2  64 27          stz CF_LBA + 1
00099Ar 2  64 28          stz CF_LBA + 2
00099Cr 2  64 29          stz CF_LBA + 3
00099Er 2  A9 00          lda #<FS_SECTOR_BUF
0009A0r 2  85 24          sta CF_BUF_PTR
0009A2r 2  A9 06          lda #>FS_SECTOR_BUF
0009A4r 2  85 25          sta CF_BUF_PTR + 1
0009A6r 2  4C rr rr       jmp StWriteSector
0009A9r 2               
0009A9r 2               ; FsFindFile — Search directory for filename in FS_FNAME_BUF
0009A9r 2               ; Must call FsReadDir first to load directory into FS_SECTOR_BUF
0009A9r 2               ; Output: Carry clear = found, X = entry index (0-15), CF_BUF_PTR points to entry
0009A9r 2               ;         Carry set = not found
0009A9r 2               ; Modifies: Flags, A, X, Y, CF_BUF_PTR
0009A9r 2               FsFindFile:
0009A9r 2  A9 00          lda #<FS_SECTOR_BUF
0009ABr 2  85 24          sta CF_BUF_PTR
0009ADr 2  A9 06          lda #>FS_SECTOR_BUF
0009AFr 2  85 25          sta CF_BUF_PTR + 1
0009B1r 2  A2 00          ldx #$00                      ; Entry index
0009B3r 2               @FsFindLoop:
0009B3r 2                 ; Check if entry is in use
0009B3r 2  A0 0B          ldy #FS_ENTRY_FLAGS
0009B5r 2  B1 24          lda (CF_BUF_PTR),y
0009B7r 2  29 01          and #FS_FLAG_USED
0009B9r 2  F0 13          beq @FsFindNext               ; Skip unused entries
0009BBr 2                 ; Compare 11-byte filename
0009BBr 2  A0 00          ldy #$00
0009BDr 2               @FsFindCmp:
0009BDr 2  B1 24          lda (CF_BUF_PTR),y
0009BFr 2  D9 50 03       cmp FS_FNAME_BUF,y
0009C2r 2  D0 0A          bne @FsFindNext               ; Mismatch
0009C4r 2  C8             iny
0009C5r 2  C0 0B          cpy #11
0009C7r 2  D0 F4          bne @FsFindCmp
0009C9r 2                 ; Match found
0009C9r 2  8E 4D 03       stx FS_DIR_IDX
0009CCr 2  18             clc
0009CDr 2  60             rts
0009CEr 2               @FsFindNext:
0009CEr 2                 ; Advance CF_BUF_PTR by 32 (FS_ENTRY_SIZE)
0009CEr 2  A5 24          lda CF_BUF_PTR
0009D0r 2  18             clc
0009D1r 2  69 20          adc #FS_ENTRY_SIZE
0009D3r 2  85 24          sta CF_BUF_PTR
0009D5r 2  90 02          bcc @FsFindNoCarry
0009D7r 2  E6 25          inc CF_BUF_PTR + 1
0009D9r 2               @FsFindNoCarry:
0009D9r 2  E8             inx
0009DAr 2  E0 10          cpx #FS_MAX_FILES
0009DCr 2  D0 D5          bne @FsFindLoop
0009DEr 2  38             sec                           ; Not found
0009DFr 2  60             rts
0009E0r 2               
0009E0r 2               ; FsFindFree — Find first free directory entry
0009E0r 2               ; Must call FsReadDir first
0009E0r 2               ; Output: Carry clear = found, X = entry index, CF_BUF_PTR points to entry
0009E0r 2               ;         Carry set = directory full
0009E0r 2               ; Modifies: Flags, A, X, Y, CF_BUF_PTR
0009E0r 2               FsFindFree:
0009E0r 2  A9 00          lda #<FS_SECTOR_BUF
0009E2r 2  85 24          sta CF_BUF_PTR
0009E4r 2  A9 06          lda #>FS_SECTOR_BUF
0009E6r 2  85 25          sta CF_BUF_PTR + 1
0009E8r 2  A2 00          ldx #$00
0009EAr 2               @FsFreeLoop:
0009EAr 2  A0 0B          ldy #FS_ENTRY_FLAGS
0009ECr 2  B1 24          lda (CF_BUF_PTR),y
0009EEr 2  29 01          and #FS_FLAG_USED
0009F0r 2  F0 12          beq @FsFreeFound              ; Found unused entry
0009F2r 2                 ; Advance by 32
0009F2r 2  A5 24          lda CF_BUF_PTR
0009F4r 2  18             clc
0009F5r 2  69 20          adc #FS_ENTRY_SIZE
0009F7r 2  85 24          sta CF_BUF_PTR
0009F9r 2  90 02          bcc @FsFreeNoCarry
0009FBr 2  E6 25          inc CF_BUF_PTR + 1
0009FDr 2               @FsFreeNoCarry:
0009FDr 2  E8             inx
0009FEr 2  E0 10          cpx #FS_MAX_FILES
000A00r 2  D0 E8          bne @FsFreeLoop
000A02r 2  38             sec                           ; Directory full
000A03r 2  60             rts
000A04r 2               @FsFreeFound:
000A04r 2  8E 4D 03       stx FS_DIR_IDX
000A07r 2  18             clc
000A08r 2  60             rts
000A09r 2               
000A09r 2               ; FsCalcNextSec — Calculate next free sector by scanning all directory entries
000A09r 2               ; Must call FsReadDir first
000A09r 2               ; Output: FS_NEXT_SEC = first free sector after all used files
000A09r 2               ; Modifies: Flags, A, X, Y
000A09r 2               FsCalcNextSec:
000A09r 2  A9 01          lda #<FS_DATA_START           ; Start with first data sector
000A0Br 2  8D 4E 03       sta FS_NEXT_SEC
000A0Er 2  A9 00          lda #>FS_DATA_START
000A10r 2  8D 4F 03       sta FS_NEXT_SEC + 1
000A13r 2                 ; Scan all entries to find highest used sector + file sector count
000A13r 2  A9 00          lda #<FS_SECTOR_BUF
000A15r 2  85 24          sta CF_BUF_PTR
000A17r 2  A9 06          lda #>FS_SECTOR_BUF
000A19r 2  85 25          sta CF_BUF_PTR + 1
000A1Br 2  A2 00          ldx #$00
000A1Dr 2               @FsCalcLoop:
000A1Dr 2  A0 0B          ldy #FS_ENTRY_FLAGS
000A1Fr 2  B1 24          lda (CF_BUF_PTR),y
000A21r 2  29 01          and #FS_FLAG_USED
000A23r 2  F0 5D          beq @FsCalcNext               ; Skip unused
000A25r 2                 ; Get start sector + ceil(size/512)
000A25r 2  A0 0C          ldy #FS_ENTRY_START
000A27r 2  B1 24          lda (CF_BUF_PTR),y
000A29r 2  8D 48 03       sta FS_START_SEC
000A2Cr 2  C8             iny
000A2Dr 2  B1 24          lda (CF_BUF_PTR),y
000A2Fr 2  8D 49 03       sta FS_START_SEC + 1
000A32r 2                 ; Get file size
000A32r 2  A0 0E          ldy #FS_ENTRY_FSIZE
000A34r 2  B1 24          lda (CF_BUF_PTR),y
000A36r 2  8D 4A 03       sta FS_FILE_SIZE
000A39r 2  C8             iny
000A3Ar 2  B1 24          lda (CF_BUF_PTR),y
000A3Cr 2  8D 4B 03       sta FS_FILE_SIZE + 1
000A3Fr 2                 ; Calculate sectors used = (size + 511) / 512 = (size + 511) >> 9
000A3Fr 2                 ; = (size_hi + 1) if size_lo > 0, else size_hi / 2... simplify:
000A3Fr 2                 ; sectors = (size >> 9) rounded up = high_byte >> 1, plus 1 if any remainder
000A3Fr 2  AD 4B 03       lda FS_FILE_SIZE + 1          ; High byte of size
000A42r 2  4A             lsr a                         ; Divide by 2 (each sector = 512 = 2 pages)
000A43r 2  8D 4C 03       sta FS_SEC_COUNT
000A46r 2                 ; Check if there's a remainder (low byte != 0 or high byte bit 0 was set)
000A46r 2  AD 4B 03       lda FS_FILE_SIZE + 1
000A49r 2  29 01          and #$01                      ; Was high byte odd?
000A4Br 2  D0 05          bne @FsCalcRound
000A4Dr 2  AD 4A 03       lda FS_FILE_SIZE              ; Low byte non-zero?
000A50r 2  F0 03          beq @FsCalcNoRound
000A52r 2               @FsCalcRound:
000A52r 2  EE 4C 03       inc FS_SEC_COUNT              ; Round up
000A55r 2               @FsCalcNoRound:
000A55r 2                 ; End sector = start + sector count.
000A55r 2                 ; NOTE: X holds the directory-entry loop counter, so the end sector must
000A55r 2                 ; NOT be kept in X (doing so ran the scan off the end of the directory
000A55r 2                 ; buffer into program memory, corrupting FS_NEXT_SEC and causing spurious
000A55r 2                 ; ?SAVE ERROR after a few files).  Stash it in memory scratch instead:
000A55r 2                 ; FS_SEC_COUNT (end low) and FS_DIR_IDX (end high) are both free here.
000A55r 2  AD 48 03       lda FS_START_SEC
000A58r 2  18             clc
000A59r 2  6D 4C 03       adc FS_SEC_COUNT
000A5Cr 2  8D 4C 03       sta FS_SEC_COUNT              ; end sector low (reuse as scratch)
000A5Fr 2  AD 49 03       lda FS_START_SEC + 1
000A62r 2  69 00          adc #$00
000A64r 2  8D 4D 03       sta FS_DIR_IDX               ; end sector high (reuse as scratch)
000A67r 2                 ; Compare with FS_NEXT_SEC — keep the larger value
000A67r 2  CD 4F 03       cmp FS_NEXT_SEC + 1
000A6Ar 2  90 16          bcc @FsCalcNext               ; End high < FS_NEXT_SEC high, skip
000A6Cr 2  D0 08          bne @FsCalcUpdate             ; End high > FS_NEXT_SEC high, update
000A6Er 2  AD 4C 03       lda FS_SEC_COUNT
000A71r 2  CD 4E 03       cmp FS_NEXT_SEC
000A74r 2  90 0C          bcc @FsCalcNext               ; End low < FS_NEXT_SEC low, skip
000A76r 2               @FsCalcUpdate:
000A76r 2  AD 4C 03       lda FS_SEC_COUNT
000A79r 2  8D 4E 03       sta FS_NEXT_SEC
000A7Cr 2  AD 4D 03       lda FS_DIR_IDX
000A7Fr 2  8D 4F 03       sta FS_NEXT_SEC + 1
000A82r 2               @FsCalcNext:
000A82r 2                 ; Advance CF_BUF_PTR by 32
000A82r 2  A5 24          lda CF_BUF_PTR
000A84r 2  18             clc
000A85r 2  69 20          adc #FS_ENTRY_SIZE
000A87r 2  85 24          sta CF_BUF_PTR
000A89r 2  90 02          bcc @FsCalcNoCarry
000A8Br 2  E6 25          inc CF_BUF_PTR + 1
000A8Dr 2               @FsCalcNoCarry:
000A8Dr 2  E8             inx
000A8Er 2  E0 10          cpx #FS_MAX_FILES
000A90r 2  D0 8B          bne @FsCalcLoop
000A92r 2  60             rts
000A93r 2               
000A93r 2               ; FsDirectory — Print directory listing of all used entries
000A93r 2               ; Output via Chrout (respects current IO_MODE)
000A93r 2               ; Modifies: Flags, A, X, Y
000A93r 2               FsDirectory:
000A93r 2  20 rr rr       jsr FsReadDir                 ; Load directory sector
000A96r 2  90 01          bcc @FsDirStart
000A98r 2  60             rts                           ; Error reading directory
000A99r 2               @FsDirStart:
000A99r 2  20 rr rr       jsr FsPrintDiskImpl           ; Print "DISK n" header
000A9Cr 2  A9 00          lda #<FS_SECTOR_BUF
000A9Er 2  85 24          sta CF_BUF_PTR
000AA0r 2  A9 06          lda #>FS_SECTOR_BUF
000AA2r 2  85 25          sta CF_BUF_PTR + 1
000AA4r 2  A2 00          ldx #$00                      ; Entry counter
000AA6r 2               @FsDirLoop:
000AA6r 2  DA             phx
000AA7r 2  A0 0B          ldy #FS_ENTRY_FLAGS
000AA9r 2  B1 24          lda (CF_BUF_PTR),y
000AABr 2  29 01          and #FS_FLAG_USED
000AADr 2  F0 3A          beq @FsDirNext                ; Skip unused entries
000AAFr 2                 ; Print filename (8 chars)
000AAFr 2  A0 00          ldy #$00
000AB1r 2               @FsDirName:
000AB1r 2  B1 24          lda (CF_BUF_PTR),y
000AB3r 2  20 rr rr       jsr Chrout
000AB6r 2  C8             iny
000AB7r 2  C0 08          cpy #$08
000AB9r 2  D0 F6          bne @FsDirName
000ABBr 2                 ; Print dot separator
000ABBr 2  A9 2E          lda #'.'
000ABDr 2  20 rr rr       jsr Chrout
000AC0r 2                 ; Print extension (3 chars)
000AC0r 2               @FsDirExt:
000AC0r 2  B1 24          lda (CF_BUF_PTR),y
000AC2r 2  20 rr rr       jsr Chrout
000AC5r 2  C8             iny
000AC6r 2  C0 0B          cpy #$0B
000AC8r 2  D0 F6          bne @FsDirExt
000ACAr 2                 ; Print space
000ACAr 2  A9 20          lda #' '
000ACCr 2  20 rr rr       jsr Chrout
000ACFr 2                 ; Print file size in decimal
000ACFr 2  A0 0E          ldy #FS_ENTRY_FSIZE
000AD1r 2  B1 24          lda (CF_BUF_PTR),y
000AD3r 2  8D 4A 03       sta FS_FILE_SIZE
000AD6r 2  C8             iny
000AD7r 2  B1 24          lda (CF_BUF_PTR),y
000AD9r 2  8D 4B 03       sta FS_FILE_SIZE + 1
000ADCr 2  20 rr rr       jsr FsPrintSize
000ADFr 2                 ; Print newline
000ADFr 2  A9 0D          lda #$0D
000AE1r 2  20 rr rr       jsr Chrout
000AE4r 2  A9 0A          lda #$0A
000AE6r 2  20 rr rr       jsr Chrout
000AE9r 2               @FsDirNext:
000AE9r 2                 ; Advance CF_BUF_PTR by 32
000AE9r 2  A5 24          lda CF_BUF_PTR
000AEBr 2  18             clc
000AECr 2  69 20          adc #FS_ENTRY_SIZE
000AEEr 2  85 24          sta CF_BUF_PTR
000AF0r 2  90 02          bcc @FsDirNoCarry
000AF2r 2  E6 25          inc CF_BUF_PTR + 1
000AF4r 2               @FsDirNoCarry:
000AF4r 2  FA             plx
000AF5r 2  E8             inx
000AF6r 2  E0 10          cpx #FS_MAX_FILES
000AF8r 2  D0 AC          bne @FsDirLoop
000AFAr 2  60             rts
000AFBr 2               
000AFBr 2               ; PrintDecU16 — Print an unsigned 16-bit value as decimal (no leading zeros).
000AFBr 2               ; General-purpose console output; used by BASIC (line numbers) and available
000AFBr 2               ; to cartridges.  Shares the FsPrintSize core below.
000AFBr 2               ; Input : A = value low, X = value high
000AFBr 2               ; Modifies: Flags, A, X, Y, FS_FILE_SIZE (consumed), FS_DIR_IDX
000AFBr 2               PrintDecU16Impl:
000AFBr 2  8D 4A 03       sta FS_FILE_SIZE
000AFEr 2  8E 4B 03       stx FS_FILE_SIZE + 1
000B01r 2                 ; fall through to the shared decimal-print core
000B01r 2               ; FsPrintSize — Print 16-bit value in FS_FILE_SIZE as decimal
000B01r 2               ; Modifies: Flags, A, X, Y
000B01r 2               FsPrintSize:
000B01r 2                 ; Convert 16-bit value to decimal digits (up to 5 digits for 0-65535)
000B01r 2                 ; Use successive subtraction of powers of 10
000B01r 2  A2 00          ldx #$00                      ; Digit index / leading zero suppression
000B03r 2  A0 00          ldy #$00                      ; Power-of-10 table index
000B05r 2               @FsPrintSizeLoop:
000B05r 2  A9 2F          lda #'0' - 1                  ; Start character below '0'
000B07r 2  8D 4D 03       sta FS_DIR_IDX                ; Reuse as digit scratch
000B0Ar 2               @FsPrintSub:
000B0Ar 2  EE 4D 03       inc FS_DIR_IDX
000B0Dr 2  AD 4A 03       lda FS_FILE_SIZE
000B10r 2  38             sec
000B11r 2  F9 rr rr       sbc @FsPow10Lo,y
000B14r 2  48             pha
000B15r 2  AD 4B 03       lda FS_FILE_SIZE + 1
000B18r 2  F9 rr rr       sbc @FsPow10Hi,y
000B1Br 2  90 09          bcc @FsPrintSizeDig           ; Underflow — done subtracting
000B1Dr 2  8D 4B 03       sta FS_FILE_SIZE + 1
000B20r 2  68             pla
000B21r 2  8D 4A 03       sta FS_FILE_SIZE
000B24r 2  80 E4          bra @FsPrintSub
000B26r 2               @FsPrintSizeDig:
000B26r 2  68             pla                           ; Discard underflowed low byte
000B27r 2  AD 4D 03       lda FS_DIR_IDX
000B2Ar 2  C9 30          cmp #'0'
000B2Cr 2  D0 04          bne @FsPrintSizeOut           ; Non-zero digit
000B2Er 2  E0 00          cpx #$00
000B30r 2  F0 04          beq @FsPrintSizeSkip          ; Suppress leading zeros
000B32r 2               @FsPrintSizeOut:
000B32r 2  20 rr rr       jsr Chrout
000B35r 2  E8             inx                           ; Mark that we've printed a digit
000B36r 2               @FsPrintSizeSkip:
000B36r 2  C8             iny
000B37r 2  C0 04          cpy #$04                      ; 4 powers of 10 (10000, 1000, 100, 10)
000B39r 2  D0 CA          bne @FsPrintSizeLoop
000B3Br 2                 ; Always print ones digit
000B3Br 2  AD 4A 03       lda FS_FILE_SIZE
000B3Er 2  09 30          ora #'0'                      ; Low byte is 0-9 at this point
000B40r 2  20 rr rr       jsr Chrout
000B43r 2  60             rts
000B44r 2  10 E8 64 0A  @FsPow10Lo: .byte <10000, <1000, <100, <10
000B48r 2  27 03 00 00  @FsPow10Hi: .byte >10000, >1000, >100, >10
000B4Cr 2               
000B4Cr 2               ; FsSetDiskImpl — Select the current CF disk bank
000B4Cr 2               ; Input: A = disk number (0-255)
000B4Cr 2               ; Modifies: Flags
000B4Cr 2               FsSetDiskImpl:
000B4Cr 2  8D 0F 03       sta CF_DISK
000B4Fr 2  60             rts
000B50r 2               
000B50r 2               ; FsGetDiskImpl — Get the current CF disk bank
000B50r 2               ; Output: A = current disk number
000B50r 2               ; Modifies: Flags, A
000B50r 2               FsGetDiskImpl:
000B50r 2  AD 0F 03       lda CF_DISK
000B53r 2  60             rts
000B54r 2               
000B54r 2               ; FsFormatDiskImpl — Zero the current disk's directory sector (erases its file list)
000B54r 2               ; Output: Carry clear = success, Carry set = write error
000B54r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
000B54r 2               FsFormatDiskImpl:
000B54r 2  A9 00          lda #<FS_SECTOR_BUF
000B56r 2  85 24          sta CF_BUF_PTR
000B58r 2  A9 06          lda #>FS_SECTOR_BUF
000B5Ar 2  85 25          sta CF_BUF_PTR + 1
000B5Cr 2  A0 00          ldy #$00
000B5Er 2  A2 02          ldx #$02                      ; 2 pages = 512 bytes
000B60r 2  A9 00          lda #$00
000B62r 2               @FsFormatClr:
000B62r 2  91 24          sta (CF_BUF_PTR),y
000B64r 2  C8             iny
000B65r 2  D0 FB          bne @FsFormatClr
000B67r 2  E6 25          inc CF_BUF_PTR + 1
000B69r 2  CA             dex
000B6Ar 2  D0 F6          bne @FsFormatClr
000B6Cr 2  4C rr rr       jmp FsWriteDir                ; Write zeroed directory sector (returns carry status)
000B6Fr 2               
000B6Fr 2               ; FsPrintDiskImpl — Print "DISK n" (decimal) + CRLF via Chrout
000B6Fr 2               ; Modifies: Flags, A, X, Y, FS_FILE_SIZE, FS_DIR_IDX
000B6Fr 2               FsPrintDiskImpl:
000B6Fr 2  A0 00          ldy #$00
000B71r 2               @FsPDLbl:
000B71r 2  B9 rr rr       lda FsDiskLbl,y
000B74r 2  F0 06          beq @FsPDNum
000B76r 2  20 rr rr       jsr Chrout
000B79r 2  C8             iny
000B7Ar 2  80 F5          bra @FsPDLbl
000B7Cr 2               @FsPDNum:
000B7Cr 2  AD 0F 03       lda CF_DISK
000B7Fr 2  8D 4A 03       sta FS_FILE_SIZE
000B82r 2  9C 4B 03       stz FS_FILE_SIZE + 1
000B85r 2  20 rr rr       jsr FsPrintSize               ; Print CF_DISK as decimal (0-255, no leading zeros)
000B88r 2  A9 0D          lda #$0D
000B8Ar 2  20 rr rr       jsr Chrout
000B8Dr 2  A9 0A          lda #$0A
000B8Fr 2  4C rr rr       jmp Chrout
000B92r 2  44 49 53 4B  FsDiskLbl: .byte "DISK ", 0
000B96r 2  20 00        
000B98r 2               
000B98r 2               ; === BASIC command glue (thin handlers dispatched from BASIC) ===
000B98r 2               ; These implement the BASIC statements DISK/BLOAD/BSAVE/FORMAT.  The bodies
000B98r 2               ; live here (Kernal has room) while BASIC keeps only the keyword strings and a
000B98r 2               ; tiny dispatch stub.  Each is entered via the BASIC statement trampoline with
000B98r 2               ; TXTPTR at the first argument char (ChrGot state); argument parsing uses the
000B98r 2               ; BASIC evaluator routines (all sources assemble as one unit, so the labels
000B98r 2               ; resolve directly).
000B98r 2               
000B98r 2               ; BasExtAddrTbl — dispatch targets for extended statement tokens $D1-$D4.
000B98r 2               ; Entries are (handler-1) for the BASIC "push + JMP ChrGet -> RTS" trampoline.
000B98r 2               BasExtAddrTbl:
000B98r 2  rr rr          .word KBasCmdDisk - 1          ; $D1 DISK
000B9Ar 2  rr rr          .word KBasCmdBload - 1         ; $D2 BLOAD
000B9Cr 2  rr rr          .word KBasCmdBsave - 1         ; $D3 BSAVE
000B9Er 2  rr rr          .word KBasCmdFormat - 1        ; $D4 FORMAT
000BA0r 2               
000BA0r 2               ; DISK n — select the current CF disk bank (0-255)
000BA0r 2               KBasCmdDisk:
000BA0r 2  20 rr rr       jsr GetByt                     ; X = value 0-255
000BA3r 2  8E 0F 03       stx CF_DISK
000BA6r 2  60             rts
000BA7r 2               
000BA7r 2               ; BLOAD addr, "name" — load a file's raw bytes to addr
000BA7r 2               KBasCmdBload:
000BA7r 2  A9 08          lda #HW_CF
000BA9r 2  20 rr rr       jsr ReqHw
000BACr 2  20 rr rr       jsr EvalAddrU16                ; FAC+3 = hi, FAC+4 = lo
000BAFr 2  A5 12          lda z:FAC + 4
000BB1r 2  8D 7F 03       sta FS_IO_ADDR
000BB4r 2  A5 11          lda z:FAC + 3
000BB6r 2  8D 80 03       sta FS_IO_ADDR + 1
000BB9r 2  20 rr rr       jsr ChkCom
000BBCr 2  20 rr rr       jsr EvalString                 ; filename -> BAS_FNAME, STR_PTR
000BBFr 2  20 rr rr       jsr FsLoadFileAddr
000BC2r 2  B0 01          bcs @KBloadErr
000BC4r 2  60             rts
000BC5r 2               @KBloadErr:
000BC5r 2  A9 rr          lda #<MsgLoadErr
000BC7r 2  A0 rr          ldy #>MsgLoadErr
000BC9r 2  4C rr rr       jmp BasPrintStr
000BCCr 2               
000BCCr 2               ; BSAVE addr, len, "name" — save len bytes from addr to a file
000BCCr 2               KBasCmdBsave:
000BCCr 2  A9 08          lda #HW_CF
000BCEr 2  20 rr rr       jsr ReqHw
000BD1r 2  20 rr rr       jsr EvalAddrU16                ; addr
000BD4r 2  A5 12          lda z:FAC + 4
000BD6r 2  8D 7F 03       sta FS_IO_ADDR
000BD9r 2  A5 11          lda z:FAC + 3
000BDBr 2  8D 80 03       sta FS_IO_ADDR + 1
000BDEr 2  20 rr rr       jsr ChkCom
000BE1r 2  20 rr rr       jsr EvalAddrU16                ; length in bytes
000BE4r 2  A5 12          lda z:FAC + 4
000BE6r 2  8D 4A 03       sta FS_FILE_SIZE
000BE9r 2  A5 11          lda z:FAC + 3
000BEBr 2  8D 4B 03       sta FS_FILE_SIZE + 1
000BEEr 2  20 rr rr       jsr ChkCom
000BF1r 2  20 rr rr       jsr EvalString                 ; filename
000BF4r 2  20 rr rr       jsr FsSaveFileAddr
000BF7r 2  B0 01          bcs @KBsaveErr
000BF9r 2  60             rts
000BFAr 2               @KBsaveErr:
000BFAr 2  A9 rr          lda #<MsgSaveErr
000BFCr 2  A0 rr          ldy #>MsgSaveErr
000BFEr 2  4C rr rr       jmp BasPrintStr
000C01r 2               
000C01r 2               ; FORMAT — erase (zero) the current disk's directory, with confirmation
000C01r 2               KBasCmdFormat:
000C01r 2  A9 08          lda #HW_CF
000C03r 2  20 rr rr       jsr ReqHw
000C06r 2  A9 rr          lda #<KMsgEraseDisk
000C08r 2  A0 rr          ldy #>KMsgEraseDisk
000C0Ar 2  20 rr rr       jsr BasPrintStr
000C0Dr 2  AD 0F 03       lda CF_DISK
000C10r 2  8D 4A 03       sta FS_FILE_SIZE
000C13r 2  9C 4B 03       stz FS_FILE_SIZE + 1
000C16r 2  20 rr rr       jsr FsPrintSize                ; print disk number (decimal)
000C19r 2  A9 rr          lda #<KMsgConfirm
000C1Br 2  A0 rr          ldy #>KMsgConfirm
000C1Dr 2  20 rr rr       jsr BasPrintStr
000C20r 2               @KFmtWait:
000C20r 2  20 rr rr       jsr Chrin                      ; wait for a key (echoes)
000C23r 2  90 FB          bcc @KFmtWait
000C25r 2  29 DF          and #$DF                       ; fold to uppercase
000C27r 2  48             pha
000C28r 2  20 rr rr       jsr BasPrintCRLF
000C2Br 2  68             pla
000C2Cr 2  C9 59          cmp #'Y'
000C2Er 2  D0 03          bne @KFmtAbort
000C30r 2  4C rr rr       jmp FsFormatDisk               ; zero the directory (returns carry status)
000C33r 2               @KFmtAbort:
000C33r 2  60             rts
000C34r 2  45 52 41 53  KMsgEraseDisk: .byte "ERASE DISK ", 0
000C38r 2  45 20 44 49  
000C3Cr 2  53 4B 20 00  
000C40r 2  3F 20 28 59  KMsgConfirm:   .byte "? (Y/N) ", 0
000C44r 2  2F 4E 29 20  
000C48r 2  00           
000C49r 2               
000C49r 2               ; FsLoadFileImpl — Load file from CF into PROGRAM_START ($0800)
000C49r 2               ; Input: STR_PTR ($02-$03) points to null-terminated filename
000C49r 2               ; Output: Carry clear = success, FS_FILE_SIZE = bytes loaded
000C49r 2               ;         Carry set = file not found or read error
000C49r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
000C49r 2               FsLoadFileImpl:
000C49r 2  A9 00          lda #<PROGRAM_START           ; Default target = PROGRAM_START
000C4Br 2  8D 7F 03       sta FS_IO_ADDR
000C4Er 2  A9 08          lda #>PROGRAM_START
000C50r 2  8D 80 03       sta FS_IO_ADDR + 1
000C53r 2               ; FsLoadFileAddrImpl — Load named file to FS_IO_ADDR (caller preset)
000C53r 2               ; Input: STR_PTR = filename, FS_IO_ADDR = destination address
000C53r 2               FsLoadFileAddrImpl:
000C53r 2  20 rr rr       jsr FsParseName               ; Parse filename into FS_FNAME_BUF
000C56r 2  20 rr rr       jsr FsReadDir                 ; Read directory sector
000C59r 2  B0 65          bcs @FsLoadErr
000C5Br 2  20 rr rr       jsr FsFindFile                ; Search for filename
000C5Er 2  B0 60          bcs @FsLoadErr                ; Not found
000C60r 2                 ; Read file metadata from entry
000C60r 2  A0 0C          ldy #FS_ENTRY_START
000C62r 2  B1 24          lda (CF_BUF_PTR),y
000C64r 2  8D 48 03       sta FS_START_SEC
000C67r 2  C8             iny
000C68r 2  B1 24          lda (CF_BUF_PTR),y
000C6Ar 2  8D 49 03       sta FS_START_SEC + 1
000C6Dr 2  A0 0E          ldy #FS_ENTRY_FSIZE
000C6Fr 2  B1 24          lda (CF_BUF_PTR),y
000C71r 2  8D 4A 03       sta FS_FILE_SIZE
000C74r 2  C8             iny
000C75r 2  B1 24          lda (CF_BUF_PTR),y
000C77r 2  8D 4B 03       sta FS_FILE_SIZE + 1
000C7Ar 2                 ; Calculate number of sectors to read
000C7Ar 2  AD 4B 03       lda FS_FILE_SIZE + 1
000C7Dr 2  4A             lsr a
000C7Er 2  8D 4C 03       sta FS_SEC_COUNT
000C81r 2  AD 4B 03       lda FS_FILE_SIZE + 1
000C84r 2  29 01          and #$01
000C86r 2  D0 05          bne @FsLoadRound
000C88r 2  AD 4A 03       lda FS_FILE_SIZE
000C8Br 2  F0 03          beq @FsLoadNoRound
000C8Dr 2               @FsLoadRound:
000C8Dr 2  EE 4C 03       inc FS_SEC_COUNT
000C90r 2               @FsLoadNoRound:
000C90r 2                 ; Set up LBA starting at file's start sector
000C90r 2  AD 48 03       lda FS_START_SEC
000C93r 2  85 26          sta CF_LBA
000C95r 2  AD 49 03       lda FS_START_SEC + 1
000C98r 2  85 27          sta CF_LBA + 1
000C9Ar 2  64 28          stz CF_LBA + 2
000C9Cr 2  64 29          stz CF_LBA + 3
000C9Er 2                 ; Set destination pointer from FS_IO_ADDR
000C9Er 2  AD 7F 03       lda FS_IO_ADDR
000CA1r 2  85 24          sta CF_BUF_PTR
000CA3r 2  AD 80 03       lda FS_IO_ADDR + 1
000CA6r 2  85 25          sta CF_BUF_PTR + 1
000CA8r 2                 ; Read sectors
000CA8r 2  AE 4C 03       ldx FS_SEC_COUNT
000CABr 2  F0 10          beq @FsLoadOk                 ; Zero-size file
000CADr 2               @FsLoadSec:
000CADr 2  DA             phx
000CAEr 2  20 rr rr       jsr StReadSector              ; Read sector (advances CF_BUF_PTR by 512)
000CB1r 2  B0 0C          bcs @FsLoadSecErr
000CB3r 2                 ; Increment LBA
000CB3r 2  E6 26          inc CF_LBA
000CB5r 2  D0 02          bne @FsLoadSecNext
000CB7r 2  E6 27          inc CF_LBA + 1
000CB9r 2               @FsLoadSecNext:
000CB9r 2  FA             plx
000CBAr 2  CA             dex
000CBBr 2  D0 F0          bne @FsLoadSec
000CBDr 2               @FsLoadOk:
000CBDr 2  18             clc
000CBEr 2  60             rts
000CBFr 2               @FsLoadSecErr:
000CBFr 2  FA             plx                           ; Balance stack
000CC0r 2               @FsLoadErr:
000CC0r 2  38             sec
000CC1r 2  60             rts
000CC2r 2               
000CC2r 2               ; FsSaveFileImpl — Save data from PROGRAM_START to CF
000CC2r 2               ; Input: STR_PTR ($02-$03) points to null-terminated filename
000CC2r 2               ;        FS_FILE_SIZE ($034A-$034B) = number of bytes to save
000CC2r 2               ; Output: Carry clear = success, Carry set = error (directory full or write error)
000CC2r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
000CC2r 2               FsSaveFileImpl:
000CC2r 2  A9 00          lda #<PROGRAM_START           ; Default source = PROGRAM_START
000CC4r 2  8D 7F 03       sta FS_IO_ADDR
000CC7r 2  A9 08          lda #>PROGRAM_START
000CC9r 2  8D 80 03       sta FS_IO_ADDR + 1
000CCCr 2               ; FsSaveFileAddrImpl — Save FS_FILE_SIZE bytes from FS_IO_ADDR to named file
000CCCr 2               ; Input: STR_PTR = filename, FS_IO_ADDR = source address, FS_FILE_SIZE = byte count
000CCCr 2               FsSaveFileAddrImpl:
000CCCr 2  20 rr rr       jsr FsParseName               ; Parse filename into FS_FNAME_BUF
000CCFr 2  20 rr rr       jsr FsReadDir                 ; Read directory sector
000CD2r 2  90 03          bcc @FsSaveReadOk
000CD4r 2  4C rr rr       jmp @FsSaveErr
000CD7r 2               @FsSaveReadOk:
000CD7r 2                 ; Try to find existing file with same name
000CD7r 2  20 rr rr       jsr FsFindFile
000CDAr 2  90 08          bcc @FsSaveOverwrite
000CDCr 2                 ; Not found — find a free slot
000CDCr 2  20 rr rr       jsr FsFindFree
000CDFr 2  90 11          bcc @FsSaveAlloc
000CE1r 2  4C rr rr       jmp @FsSaveErr                ; Directory full
000CE4r 2               @FsSaveOverwrite:
000CE4r 2                 ; CF_BUF_PTR already points to the existing entry — clear old flags
000CE4r 2  A0 0B          ldy #FS_ENTRY_FLAGS
000CE6r 2  A9 00          lda #$00
000CE8r 2  91 24          sta (CF_BUF_PTR),y            ; Mark old entry as free
000CEAr 2                 ; Find a free slot (could be the one we just freed or another)
000CEAr 2  20 rr rr       jsr FsFindFree
000CEDr 2  90 03          bcc @FsSaveAlloc
000CEFr 2  4C rr rr       jmp @FsSaveErr
000CF2r 2               @FsSaveAlloc:
000CF2r 2                 ; Save CF_BUF_PTR (points to free entry from FsFindFree)
000CF2r 2  A5 24          lda CF_BUF_PTR
000CF4r 2  48             pha
000CF5r 2  A5 25          lda CF_BUF_PTR + 1
000CF7r 2  48             pha
000CF8r 2                 ; Save FS_FILE_SIZE (FsCalcNextSec clobbers it while scanning entries)
000CF8r 2  AD 4A 03       lda FS_FILE_SIZE
000CFBr 2  48             pha
000CFCr 2  AD 4B 03       lda FS_FILE_SIZE + 1
000CFFr 2  48             pha
000D00r 2                 ; Calculate next free sector (clobbers CF_BUF_PTR and FS_FILE_SIZE)
000D00r 2  20 rr rr       jsr FsCalcNextSec
000D03r 2                 ; Restore FS_FILE_SIZE
000D03r 2  68             pla
000D04r 2  8D 4B 03       sta FS_FILE_SIZE + 1
000D07r 2  68             pla
000D08r 2  8D 4A 03       sta FS_FILE_SIZE
000D0Br 2                 ; Restore CF_BUF_PTR to the free directory entry
000D0Br 2  68             pla
000D0Cr 2  85 25          sta CF_BUF_PTR + 1
000D0Er 2  68             pla
000D0Fr 2  85 24          sta CF_BUF_PTR
000D11r 2                 ; Calculate sectors needed
000D11r 2  AD 4B 03       lda FS_FILE_SIZE + 1
000D14r 2  4A             lsr a
000D15r 2  8D 4C 03       sta FS_SEC_COUNT
000D18r 2  AD 4B 03       lda FS_FILE_SIZE + 1
000D1Br 2  29 01          and #$01
000D1Dr 2  D0 05          bne @FsSaveRound
000D1Fr 2  AD 4A 03       lda FS_FILE_SIZE
000D22r 2  F0 03          beq @FsSaveNoRound
000D24r 2               @FsSaveRound:
000D24r 2  EE 4C 03       inc FS_SEC_COUNT
000D27r 2               @FsSaveNoRound:
000D27r 2                 ; Disk-full guard: reject if the file would spill past this disk's region.
000D27r 2                 ; end sector = FS_NEXT_SEC + FS_SEC_COUNT must be <= FS_DISK_SECTORS.
000D27r 2  AD 4E 03       lda FS_NEXT_SEC
000D2Ar 2  18             clc
000D2Br 2  6D 4C 03       adc FS_SEC_COUNT
000D2Er 2  A8             tay                           ; Y = end sector low
000D2Fr 2  AD 4F 03       lda FS_NEXT_SEC + 1
000D32r 2  69 00          adc #$00                      ; A = end sector high
000D34r 2  C9 08          cmp #>FS_DISK_SECTORS
000D36r 2  90 08          bcc @FsSaveSpaceOk            ; end high < high(FS_DISK_SECTORS) -> fits
000D38r 2  D0 03          bne @FsSaveDiskFull           ; end high > high(FS_DISK_SECTORS) -> full
000D3Ar 2  98             tya                           ; end high equal: OK only if end low == 0
000D3Br 2  F0 03          beq @FsSaveSpaceOk
000D3Dr 2               @FsSaveDiskFull:
000D3Dr 2  4C rr rr       jmp @FsSaveErr                ; Disk full
000D40r 2               @FsSaveSpaceOk:
000D40r 2                 ; Fill in directory entry at CF_BUF_PTR
000D40r 2                 ; Copy filename (11 bytes)
000D40r 2  A0 00          ldy #$00
000D42r 2               @FsSaveCopyName:
000D42r 2  B9 50 03       lda FS_FNAME_BUF,y
000D45r 2  91 24          sta (CF_BUF_PTR),y
000D47r 2  C8             iny
000D48r 2  C0 0B          cpy #11
000D4Ar 2  D0 F6          bne @FsSaveCopyName
000D4Cr 2                 ; Set flags = in use
000D4Cr 2  A9 01          lda #FS_FLAG_USED
000D4Er 2  91 24          sta (CF_BUF_PTR),y            ; Y = 11 = FS_ENTRY_FLAGS
000D50r 2                 ; Set start sector
000D50r 2  A0 0C          ldy #FS_ENTRY_START
000D52r 2  AD 4E 03       lda FS_NEXT_SEC
000D55r 2  91 24          sta (CF_BUF_PTR),y
000D57r 2  8D 48 03       sta FS_START_SEC
000D5Ar 2  C8             iny
000D5Br 2  AD 4F 03       lda FS_NEXT_SEC + 1
000D5Er 2  91 24          sta (CF_BUF_PTR),y
000D60r 2  8D 49 03       sta FS_START_SEC + 1
000D63r 2                 ; Set file size
000D63r 2  A0 0E          ldy #FS_ENTRY_FSIZE
000D65r 2  AD 4A 03       lda FS_FILE_SIZE
000D68r 2  91 24          sta (CF_BUF_PTR),y
000D6Ar 2  C8             iny
000D6Br 2  AD 4B 03       lda FS_FILE_SIZE + 1
000D6Er 2  91 24          sta (CF_BUF_PTR),y
000D70r 2                 ; Clear reserved bytes
000D70r 2  A0 10          ldy #$10
000D72r 2  A9 00          lda #$00
000D74r 2               @FsSaveClearRsv:
000D74r 2  91 24          sta (CF_BUF_PTR),y
000D76r 2  C8             iny
000D77r 2  C0 20          cpy #FS_ENTRY_SIZE
000D79r 2  D0 F9          bne @FsSaveClearRsv
000D7Br 2                 ; Write updated directory back to CF
000D7Br 2  20 rr rr       jsr FsWriteDir
000D7Er 2  B0 30          bcs @FsSaveErr
000D80r 2                 ; Now write file data sectors
000D80r 2  AD 48 03       lda FS_START_SEC
000D83r 2  85 26          sta CF_LBA
000D85r 2  AD 49 03       lda FS_START_SEC + 1
000D88r 2  85 27          sta CF_LBA + 1
000D8Ar 2  64 28          stz CF_LBA + 2
000D8Cr 2  64 29          stz CF_LBA + 3
000D8Er 2                 ; Source = FS_IO_ADDR
000D8Er 2  AD 7F 03       lda FS_IO_ADDR
000D91r 2  85 24          sta CF_BUF_PTR
000D93r 2  AD 80 03       lda FS_IO_ADDR + 1
000D96r 2  85 25          sta CF_BUF_PTR + 1
000D98r 2  AE 4C 03       ldx FS_SEC_COUNT
000D9Br 2  F0 10          beq @FsSaveOk                 ; Zero-size file
000D9Dr 2               @FsSaveSec:
000D9Dr 2  DA             phx
000D9Er 2  20 rr rr       jsr StWriteSector             ; Write sector (advances CF_BUF_PTR by 512)
000DA1r 2  B0 0C          bcs @FsSaveSecErr
000DA3r 2                 ; Increment LBA
000DA3r 2  E6 26          inc CF_LBA
000DA5r 2  D0 02          bne @FsSaveSecNext
000DA7r 2  E6 27          inc CF_LBA + 1
000DA9r 2               @FsSaveSecNext:
000DA9r 2  FA             plx
000DAAr 2  CA             dex
000DABr 2  D0 F0          bne @FsSaveSec
000DADr 2               @FsSaveOk:
000DADr 2  18             clc
000DAEr 2  60             rts
000DAFr 2               @FsSaveSecErr:
000DAFr 2  FA             plx                           ; Balance stack
000DB0r 2               @FsSaveErr:
000DB0r 2  38             sec
000DB1r 2  60             rts
000DB2r 2               
000DB2r 2               ; FsDeleteFile — Delete a file from the CompactFlash filesystem
000DB2r 2               ; Input: STR_PTR ($02-$03) points to null-terminated filename
000DB2r 2               ; Output: Carry clear = success, Carry set = file not found or error
000DB2r 2               ; Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR
000DB2r 2               FsDeleteFileImpl:
000DB2r 2  20 rr rr       jsr FsParseName               ; Parse filename into FS_FNAME_BUF
000DB5r 2  20 rr rr       jsr FsReadDir                 ; Read directory sector
000DB8r 2  B0 0F          bcs @FsDelErr
000DBAr 2  20 rr rr       jsr FsFindFile                ; Search for filename
000DBDr 2  B0 0A          bcs @FsDelErr                 ; Not found
000DBFr 2                 ; Clear the flags byte to mark entry as unused
000DBFr 2  A0 0B          ldy #FS_ENTRY_FLAGS
000DC1r 2  A9 00          lda #$00
000DC3r 2  91 24          sta (CF_BUF_PTR),y
000DC5r 2                 ; Write updated directory back to CF
000DC5r 2  20 rr rr       jsr FsWriteDir
000DC8r 2                 ; Carry already set/clear from FsWriteDir
000DC8r 2  60             rts
000DC9r 2               @FsDelErr:
000DC9r 2  38             sec
000DCAr 2  60             rts
000DCBr 2               
000DCBr 2               ; === XModem Serial LOAD/SAVE ===
000DCBr 2               ; Standard XModem protocol over serial (128-byte blocks, checksum)
000DCBr 2               ; Load: receives blocks into memory at caller-supplied XFER_PTR
000DCBr 2               ; Save: sends blocks from memory at caller-supplied XFER_PTR / XFER_REMAIN
000DCBr 2               
000DCBr 2               ; --- Shared XModem Utilities ---
000DCBr 2               
000DCBr 2               ; XModemGetByte — Read one byte from serial with timeout
000DCBr 2               ; Polls SC_STATUS for RDRF directly (bypasses IRQ-driven buffer).
000DCBr 2               ; Caller must disable serial RX IRQ before calling.
000DCBr 2               ; Output: A = byte received, Carry clear = got byte
000DCBr 2               ;         Carry set = timeout
000DCBr 2               ; Preserves: X, Y
000DCBr 2               XModemGetByte:
000DCBr 2  DA             phx
000DCCr 2  5A             phy
000DCDr 2  A2 00          ldx #$00                      ; Outer loop: 256 passes
000DCFr 2               @Outer:
000DCFr 2  A0 00          ldy #$00                      ; Inner loop: 256 polls
000DD1r 2               @Inner:
000DD1r 2  AD 01 90       lda SC_STATUS
000DD4r 2  29 08          and #SC_STATUS_RDRF           ; Received byte waiting?
000DD6r 2  D0 0A          bne @Got
000DD8r 2  88             dey
000DD9r 2  D0 F6          bne @Inner
000DDBr 2  CA             dex
000DDCr 2  D0 F1          bne @Outer
000DDEr 2                 ; Timeout
000DDEr 2  7A             ply
000DDFr 2  FA             plx
000DE0r 2  38             sec
000DE1r 2  60             rts
000DE2r 2               @Got:
000DE2r 2  AD 00 90       lda SC_DATA                   ; Read received byte (clears RDRF)
000DE5r 2  7A             ply
000DE6r 2  FA             plx
000DE7r 2  18             clc
000DE8r 2  60             rts
000DE9r 2               
000DE9r 2               ; XModemPurge — Drain all pending bytes from input buffer and hardware
000DE9r 2               ; Modifies: A, X
000DE9r 2               XModemPurge:
000DE9r 2                 ; Drain software input buffer (bytes captured before IRQ was disabled)
000DE9r 2               @DrainBuf:
000DE9r 2  20 rr rr       jsr BufferSize
000DECr 2  F0 05          beq @DrainHw
000DEEr 2  20 rr rr       jsr ReadBuffer
000DF1r 2  80 F6          bra @DrainBuf
000DF3r 2               @DrainHw:
000DF3r 2                 ; Drain hardware RDRF
000DF3r 2  AD 01 90       lda SC_STATUS
000DF6r 2  29 08          and #SC_STATUS_RDRF
000DF8r 2  F0 05          beq @Done
000DFAr 2  AD 00 90       lda SC_DATA                   ; Read and discard
000DFDr 2  80 F4          bra @DrainHw
000DFFr 2               @Done:
000DFFr 2  60             rts
000E00r 2               
000E00r 2               ; --- XModem Load (Receive) ---
000E00r 2               
000E00r 2               ; XModemLoadImpl — Receive data via standard XModem protocol
000E00r 2               ; Input: XFER_PTR = destination address (set by caller)
000E00r 2               ; Output: Carry clear = success, XFER_PTR past last byte written
000E00r 2               ;         XFER_REMAIN = total bytes received
000E00r 2               ;         Carry set = transfer failed
000E00r 2               ; Modifies: Flags, A, X, Y
000E00r 2               XModemLoadImpl:
000E00r 2                 ; Save and switch IO_MODE to serial
000E00r 2  AD 06 03       lda IO_MODE
000E03r 2  8D 19 03       sta XFER_IO_SAVE
000E06r 2  A9 01          lda #$01
000E08r 2  8D 06 03       sta IO_MODE
000E0Br 2                 ; Disable serial RX IRQ — XModem polls SC_STATUS directly
000E0Br 2  A9 0B          lda #$0B                      ; Bit 1 set = RX IRQ disabled, RTSB low, DTR
000E0Dr 2  8D 02 90       sta SC_CMD
000E10r 2                 ; Initialize
000E10r 2  A9 01          lda #$01
000E12r 2  85 36          sta XMODEM_BLK                ; First expected block number
000E14r 2  9C 17 03       stz XFER_REMAIN
000E17r 2  9C 18 03       stz XFER_REMAIN + 1
000E1Ar 2  A9 3C          lda #XMODEM_STARTRETRY
000E1Cr 2  85 38          sta XMODEM_RETRY
000E1Er 2                 ; Print status message so user can start the terminal send
000E1Er 2  A2 00          ldx #0
000E20r 2               @PrintMsg:
000E20r 2  BD rr rr       lda XModemStrReceive,x
000E23r 2  F0 06          beq @PrintDone
000E25r 2  20 rr rr       jsr Chrout
000E28r 2  E8             inx
000E29r 2  80 F5          bra @PrintMsg
000E2Br 2               @PrintDone:
000E2Br 2  20 rr rr       jsr XModemPurge               ; Drain stale bytes
000E2Er 2                 ; Send initial NAK to start transfer
000E2Er 2  A9 15          lda #XMODEM_NAK
000E30r 2  20 rr rr       jsr SerialChrout
000E33r 2               @RecvWait:
000E33r 2  20 rr rr       jsr XModemGetByte
000E36r 2  B0 0E          bcs @RecvTimeout
000E38r 2  C9 01          cmp #XMODEM_SOH
000E3Ar 2  F0 3E          beq @RecvBlock
000E3Cr 2  C9 04          cmp #XMODEM_EOT
000E3Er 2  F0 11          beq @RecvEOT
000E40r 2  C9 18          cmp #XMODEM_CAN
000E42r 2  F0 1F          beq @RecvFail
000E44r 2  80 ED          bra @RecvWait                 ; Ignore unknown bytes
000E46r 2               
000E46r 2               @RecvTimeout:
000E46r 2  C6 38          dec XMODEM_RETRY
000E48r 2  F0 19          beq @RecvFail
000E4Ar 2  A9 15          lda #XMODEM_NAK
000E4Cr 2  20 rr rr       jsr SerialChrout
000E4Fr 2  80 E2          bra @RecvWait
000E51r 2               
000E51r 2               @RecvEOT:
000E51r 2  A9 06          lda #XMODEM_ACK
000E53r 2  20 rr rr       jsr SerialChrout
000E56r 2                 ; Re-enable serial RX IRQ
000E56r 2  A9 09          lda #$09
000E58r 2  8D 02 90       sta SC_CMD
000E5Br 2  AD 19 03       lda XFER_IO_SAVE
000E5Er 2  8D 06 03       sta IO_MODE
000E61r 2  18             clc                           ; Success
000E62r 2  60             rts
000E63r 2               
000E63r 2               @RecvFail:
000E63r 2  A9 18          lda #XMODEM_CAN
000E65r 2  20 rr rr       jsr SerialChrout
000E68r 2  A9 18          lda #XMODEM_CAN
000E6Ar 2  20 rr rr       jsr SerialChrout
000E6Dr 2                 ; Re-enable serial RX IRQ
000E6Dr 2  A9 09          lda #$09
000E6Fr 2  8D 02 90       sta SC_CMD
000E72r 2  AD 19 03       lda XFER_IO_SAVE
000E75r 2  8D 06 03       sta IO_MODE
000E78r 2  38             sec                           ; Failure
000E79r 2  60             rts
000E7Ar 2               
000E7Ar 2               @RecvBlock:
000E7Ar 2                 ; Reset retry counter on SOH received
000E7Ar 2  A9 0A          lda #XMODEM_MAXRETRY
000E7Cr 2  85 38          sta XMODEM_RETRY
000E7Er 2                 ; Read block number
000E7Er 2  20 rr rr       jsr XModemGetByte
000E81r 2  B0 6B          bcs @RecvNAK
000E83r 2  85 39          sta XMODEM_RCVBLK
000E85r 2                 ; Read complement
000E85r 2  20 rr rr       jsr XModemGetByte
000E88r 2  B0 64          bcs @RecvNAK
000E8Ar 2                 ; Verify block# + complement = $FF
000E8Ar 2  18             clc
000E8Br 2  65 39          adc XMODEM_RCVBLK
000E8Dr 2  C9 FF          cmp #$FF
000E8Fr 2  D0 5D          bne @RecvNAK
000E91r 2                 ; Receive 128 data bytes into (XFER_PTR), accumulate checksum
000E91r 2  64 37          stz XMODEM_CHK
000E93r 2  A0 00          ldy #$00
000E95r 2               @RecvData:
000E95r 2  20 rr rr       jsr XModemGetByte             ; A = byte (X/Y preserved)
000E98r 2  B0 54          bcs @RecvNAK
000E9Ar 2  91 2A          sta (XFER_PTR),y              ; Write to destination at offset Y
000E9Cr 2  18             clc
000E9Dr 2  65 37          adc XMODEM_CHK
000E9Fr 2  85 37          sta XMODEM_CHK
000EA1r 2  C8             iny
000EA2r 2  C0 80          cpy #XMODEM_BLKSZ
000EA4r 2  D0 EF          bne @RecvData
000EA6r 2                 ; Read and verify checksum
000EA6r 2  20 rr rr       jsr XModemGetByte
000EA9r 2  B0 43          bcs @RecvNAK
000EABr 2  C5 37          cmp XMODEM_CHK
000EADr 2  D0 3F          bne @RecvNAK
000EAFr 2                 ; Verify block number matches expected
000EAFr 2  A5 39          lda XMODEM_RCVBLK
000EB1r 2  C5 36          cmp XMODEM_BLK
000EB3r 2  D0 28          bne @RecvDupChk
000EB5r 2                 ; Good block — advance pointer by 128
000EB5r 2  18             clc
000EB6r 2  A5 2A          lda XFER_PTR
000EB8r 2  69 80          adc #XMODEM_BLKSZ
000EBAr 2  85 2A          sta XFER_PTR
000EBCr 2  A5 2B          lda XFER_PTR + 1
000EBEr 2  69 00          adc #$00
000EC0r 2  85 2B          sta XFER_PTR + 1
000EC2r 2                 ; Update total bytes received
000EC2r 2  18             clc
000EC3r 2  AD 17 03       lda XFER_REMAIN
000EC6r 2  69 80          adc #XMODEM_BLKSZ
000EC8r 2  8D 17 03       sta XFER_REMAIN
000ECBr 2  AD 18 03       lda XFER_REMAIN + 1
000ECEr 2  69 00          adc #$00
000ED0r 2  8D 18 03       sta XFER_REMAIN + 1
000ED3r 2                 ; Increment expected block number (wraps 255→0)
000ED3r 2  E6 36          inc XMODEM_BLK
000ED5r 2                 ; ACK the block
000ED5r 2  A9 06          lda #XMODEM_ACK
000ED7r 2  20 rr rr       jsr SerialChrout
000EDAr 2  4C rr rr       jmp @RecvWait
000EDDr 2               
000EDDr 2               @RecvDupChk:
000EDDr 2                 ; Check if this is a retransmit of the previous block (lost ACK)
000EDDr 2  A5 36          lda XMODEM_BLK
000EDFr 2  38             sec
000EE0r 2  E9 01          sbc #$01
000EE2r 2  C5 39          cmp XMODEM_RCVBLK
000EE4r 2  D0 08          bne @RecvNAK                  ; Not a dup — NAK
000EE6r 2                 ; Duplicate — re-ACK without advancing
000EE6r 2  A9 06          lda #XMODEM_ACK
000EE8r 2  20 rr rr       jsr SerialChrout
000EEBr 2  4C rr rr       jmp @RecvWait
000EEEr 2               
000EEEr 2               @RecvNAK:
000EEEr 2  20 rr rr       jsr XModemPurge               ; Drain any remaining bytes
000EF1r 2  A9 15          lda #XMODEM_NAK
000EF3r 2  20 rr rr       jsr SerialChrout
000EF6r 2  4C rr rr       jmp @RecvWait
000EF9r 2               
000EF9r 2               ; --- XModem Save (Send) ---
000EF9r 2               
000EF9r 2               ; XModemSaveImpl — Send data via standard XModem protocol
000EF9r 2               ; Input: XFER_PTR = source address, XFER_REMAIN = byte count (set by caller)
000EF9r 2               ; Output: Carry clear = success, Carry set = transfer failed
000EF9r 2               ; Modifies: Flags, A, X, Y
000EF9r 2               XModemSaveImpl:
000EF9r 2                 ; Save and switch IO_MODE to serial
000EF9r 2  AD 06 03       lda IO_MODE
000EFCr 2  8D 19 03       sta XFER_IO_SAVE
000EFFr 2  A9 01          lda #$01
000F01r 2  8D 06 03       sta IO_MODE
000F04r 2                 ; Disable serial RX IRQ — XModem polls SC_STATUS directly
000F04r 2  A9 0B          lda #$0B                      ; Bit 1 set = RX IRQ disabled, RTSB low, DTR
000F06r 2  8D 02 90       sta SC_CMD
000F09r 2                 ; Initialize
000F09r 2  A9 01          lda #$01
000F0Br 2  85 36          sta XMODEM_BLK                ; First block number
000F0Dr 2  A9 3C          lda #XMODEM_STARTRETRY
000F0Fr 2  85 38          sta XMODEM_RETRY
000F11r 2                 ; Print status message so user can start the terminal receive
000F11r 2  A2 00          ldx #0
000F13r 2               @PrintMsg:
000F13r 2  BD rr rr       lda XModemStrSend,x
000F16r 2  F0 06          beq @PrintDone
000F18r 2  20 rr rr       jsr Chrout
000F1Br 2  E8             inx
000F1Cr 2  80 F5          bra @PrintMsg
000F1Er 2               @PrintDone:
000F1Er 2  20 rr rr       jsr XModemPurge               ; Drain stale bytes
000F21r 2                 ; Wait for initial NAK (or 'C' for CRC mode) from receiver
000F21r 2               @SendWaitNAK:
000F21r 2  20 rr rr       jsr XModemGetByte
000F24r 2  B0 11          bcs @SendInitTO
000F26r 2  C9 15          cmp #XMODEM_NAK
000F28r 2  F0 16          beq @SendLoop
000F2Ar 2  C9 43          cmp #'C'                      ; CRC mode request — treat as NAK (send checksum packets)
000F2Cr 2  F0 12          beq @SendLoop
000F2Er 2  C9 18          cmp #XMODEM_CAN
000F30r 2  D0 03          bne :+
000F32r 2  4C rr rr       jmp @SendFail
000F35r 2  80 EA        : bra @SendWaitNAK
000F37r 2               
000F37r 2               @SendInitTO:
000F37r 2  C6 38          dec XMODEM_RETRY
000F39r 2  D0 03          bne :+
000F3Br 2  4C rr rr       jmp @SendFail
000F3Er 2  80 E1        : bra @SendWaitNAK
000F40r 2               
000F40r 2               @SendLoop:
000F40r 2                 ; Check if any data remains to send
000F40r 2  AD 17 03       lda XFER_REMAIN
000F43r 2  0D 18 03       ora XFER_REMAIN + 1
000F46r 2  D0 03          bne :+
000F48r 2  4C rr rr       jmp @SendEOT                  ; All data sent
000F4Br 2               :
000F4Br 2                 ; Reset retry counter for this block
000F4Br 2  A9 0A          lda #XMODEM_MAXRETRY
000F4Dr 2  85 38          sta XMODEM_RETRY
000F4Fr 2               @SendBlock:
000F4Fr 2                 ; Save XFER_PTR and XFER_REMAIN on stack for retry
000F4Fr 2  A5 2B          lda XFER_PTR + 1
000F51r 2  48             pha
000F52r 2  A5 2A          lda XFER_PTR
000F54r 2  48             pha
000F55r 2  AD 18 03       lda XFER_REMAIN + 1
000F58r 2  48             pha
000F59r 2  AD 17 03       lda XFER_REMAIN
000F5Cr 2  48             pha
000F5Dr 2                 ; Send header: SOH, block#, ~block#
000F5Dr 2  A9 01          lda #XMODEM_SOH
000F5Fr 2  20 rr rr       jsr SerialChrout
000F62r 2  A5 36          lda XMODEM_BLK
000F64r 2  20 rr rr       jsr SerialChrout
000F67r 2  49 FF          eor #$FF
000F69r 2  20 rr rr       jsr SerialChrout
000F6Cr 2                 ; Send 128 data bytes, computing checksum
000F6Cr 2  64 37          stz XMODEM_CHK
000F6Er 2  A0 00          ldy #$00                      ; Y=0 for (XFER_PTR),y indirect addressing
000F70r 2  A2 80          ldx #XMODEM_BLKSZ             ; X = byte counter (128 down to 0)
000F72r 2               @SendData:
000F72r 2  AD 17 03       lda XFER_REMAIN
000F75r 2  0D 18 03       ora XFER_REMAIN + 1
000F78r 2  F0 20          beq @SendPad                  ; No more real data — pad remainder
000F7Ar 2  B1 2A          lda (XFER_PTR),y              ; Read source byte
000F7Cr 2  20 rr rr       jsr SerialChrout              ; Send it (A preserved by SerialChrout)
000F7Fr 2  18             clc
000F80r 2  65 37          adc XMODEM_CHK
000F82r 2  85 37          sta XMODEM_CHK
000F84r 2                 ; Advance source pointer
000F84r 2  E6 2A          inc XFER_PTR
000F86r 2  D0 02          bne @SendNoPg
000F88r 2  E6 2B          inc XFER_PTR + 1
000F8Ar 2               @SendNoPg:
000F8Ar 2                 ; Decrement remaining byte count
000F8Ar 2  AD 17 03       lda XFER_REMAIN
000F8Dr 2  D0 03          bne @SendDecLo
000F8Fr 2  CE 18 03       dec XFER_REMAIN + 1
000F92r 2               @SendDecLo:
000F92r 2  CE 17 03       dec XFER_REMAIN
000F95r 2  CA             dex
000F96r 2  D0 DA          bne @SendData
000F98r 2  80 0D          bra @SendChk
000F9Ar 2               @SendPad:
000F9Ar 2                 ; Pad remaining block bytes with SUB ($1A)
000F9Ar 2  A9 1A          lda #XMODEM_SUB
000F9Cr 2  20 rr rr       jsr SerialChrout
000F9Fr 2  18             clc
000FA0r 2  65 37          adc XMODEM_CHK
000FA2r 2  85 37          sta XMODEM_CHK
000FA4r 2  CA             dex
000FA5r 2  D0 F3          bne @SendPad
000FA7r 2               @SendChk:
000FA7r 2                 ; Send checksum byte
000FA7r 2  A5 37          lda XMODEM_CHK
000FA9r 2  20 rr rr       jsr SerialChrout
000FACr 2                 ; Wait for ACK/NAK response
000FACr 2  20 rr rr       jsr XModemGetByte
000FAFr 2  B0 08          bcs @SendRetry                ; Timeout — retry
000FB1r 2  C9 06          cmp #XMODEM_ACK
000FB3r 2  F0 19          beq @SendBlockOK
000FB5r 2  C9 18          cmp #XMODEM_CAN
000FB7r 2  F0 1E          beq @SendCancel
000FB9r 2                 ; NAK or unknown — retry
000FB9r 2               @SendRetry:
000FB9r 2                 ; Restore XFER_PTR and XFER_REMAIN from stack
000FB9r 2  68             pla
000FBAr 2  8D 17 03       sta XFER_REMAIN
000FBDr 2  68             pla
000FBEr 2  8D 18 03       sta XFER_REMAIN + 1
000FC1r 2  68             pla
000FC2r 2  85 2A          sta XFER_PTR
000FC4r 2  68             pla
000FC5r 2  85 2B          sta XFER_PTR + 1
000FC7r 2  C6 38          dec XMODEM_RETRY
000FC9r 2  F0 10          beq @SendFail
000FCBr 2  4C rr rr       jmp @SendBlock
000FCEr 2               
000FCEr 2               @SendBlockOK:
000FCEr 2                 ; Discard saved state from stack (4 bytes)
000FCEr 2  68             pla
000FCFr 2  68             pla
000FD0r 2  68             pla
000FD1r 2  68             pla
000FD2r 2                 ; Advance to next block
000FD2r 2  E6 36          inc XMODEM_BLK
000FD4r 2  4C rr rr       jmp @SendLoop
000FD7r 2               
000FD7r 2               @SendCancel:
000FD7r 2                 ; Discard saved state from stack
000FD7r 2  68             pla
000FD8r 2  68             pla
000FD9r 2  68             pla
000FDAr 2  68             pla
000FDBr 2               @SendFail:
000FDBr 2                 ; Re-enable serial RX IRQ
000FDBr 2  A9 09          lda #$09
000FDDr 2  8D 02 90       sta SC_CMD
000FE0r 2  AD 19 03       lda XFER_IO_SAVE
000FE3r 2  8D 06 03       sta IO_MODE
000FE6r 2  38             sec                           ; Failure
000FE7r 2  60             rts
000FE8r 2               
000FE8r 2               @SendEOT:
000FE8r 2                 ; All data sent — send EOT
000FE8r 2  A9 04          lda #XMODEM_EOT
000FEAr 2  20 rr rr       jsr SerialChrout
000FEDr 2                 ; Wait for ACK (best-effort; don't fail if timeout)
000FEDr 2  20 rr rr       jsr XModemGetByte
000FF0r 2                 ; Re-enable serial RX IRQ
000FF0r 2  A9 09          lda #$09
000FF2r 2  8D 02 90       sta SC_CMD
000FF5r 2  AD 19 03       lda XFER_IO_SAVE
000FF8r 2  8D 06 03       sta IO_MODE
000FFBr 2  18             clc                           ; Success
000FFCr 2  60             rts
000FFDr 2               
000FFDr 2               ; XModem status strings
000FFDr 2               XModemStrReceive:
000FFDr 2  58 4D 4F 44    .byte "XMODEM RX READY", $0D, $0A, 0
001001r 2  45 4D 20 52  
001005r 2  58 20 52 45  
00100Fr 2               XModemStrSend:
00100Fr 2  58 4D 4F 44    .byte "XMODEM TX READY", $0D, $0A, 0
001013r 2  45 4D 20 54  
001017r 2  58 20 52 45  
001021r 2               
001021r 2               ; Draw the splash screen
001021r 2               ; Uses video output to display centered title and boot menu
001021r 2               ; Skips if video card is absent
001021r 2               ; Modifies: Flags, A, X, Y
001021r 2               Splash:
001021r 2  AD 0D 03       lda HW_PRESENT
001024r 2  29 80          and #HW_VID
001026r 2  D0 01          bne @SplashStart
001028r 2  60             rts                           ; No video — skip
001029r 2               @SplashStart:
001029r 2  20 rr rr       jsr VideoClear                ; Clear the video screen
00102Cr 2                 ; Position cursor at row 10, col 10 for title
00102Cr 2  A2 0A          ldx #10
00102Er 2  A0 0A          ldy #10
001030r 2  20 rr rr       jsr VideoSetCursor
001033r 2  A9 rr          lda #<@SplashTitle
001035r 2  85 02          sta STR_PTR
001037r 2  A9 rr          lda #>@SplashTitle
001039r 2  85 03          sta STR_PTR + 1
00103Br 2  20 rr rr       jsr VideoPrintStrImpl
00103Er 2                 ; Position cursor at row 12, col 8 for boot menu (centered: (40-24)/2 = 8)
00103Er 2  A2 08          ldx #8
001040r 2  A0 0C          ldy #12
001042r 2  20 rr rr       jsr VideoSetCursor
001045r 2  A9 rr          lda #<@SplashMenu
001047r 2  85 02          sta STR_PTR
001049r 2  A9 rr          lda #>@SplashMenu
00104Br 2  85 03          sta STR_PTR + 1
00104Dr 2  20 rr rr       jsr VideoPrintStrImpl
001050r 2  60             rts
001051r 2  2D 2D 20 36  @SplashTitle: .asciiz "-- 6502 BIOS v1.2 --"
001055r 2  35 30 32 20  
001059r 2  42 49 4F 53  
001066r 2  45 4E 54 45  @SplashMenu:  .asciiz "ENTER=BASIC  ESC=MONITOR"
00106Ar 2  52 3D 42 41  
00106Er 2  53 49 43 20  
00107Fr 2               
00107Fr 2               ; NMI Handler
00107Fr 2               Nmi:
00107Fr 2  40             rti
001080r 2               
001080r 2               ; BRK Handler — saves full CPU state and enters monitor
001080r 2               ; On entry from @IrqBrk: A/X/Y are the user's original values (restored by IRQ handler).
001080r 2               ; The CPU's hardware push left P/PCL/PCH on the stack.
001080r 2               Break:
001080r 2  8D 13 03       sta BRK_A                     ; Save user's A register
001083r 2  8E 14 03       stx BRK_X                     ; Save user's X register
001086r 2  8C 15 03       sty BRK_Y                     ; Save user's Y register
001089r 2  BA             tsx                           ; Get current SP
00108Ar 2  8E 16 03       stx BRK_SP                   ; Save SP (points below P/PCL/PCH on stack)
00108Dr 2  68             pla                           ; Pull saved P
00108Er 2  8D 10 03       sta BRK_P
001091r 2  68             pla                           ; Pull saved PCL (PC+2)
001092r 2  8D 11 03       sta BRK_PCL
001095r 2  68             pla                           ; Pull saved PCH
001096r 2  8D 12 03       sta BRK_PCH
001099r 2  4C rr rr       jmp MonitorBrkEntry
00109Cr 2               
00109Cr 2               ; IRQ Handler
00109Cr 2               Irq:
00109Cr 2  48             pha
00109Dr 2  5A             phy
00109Er 2  DA             phx
00109Fr 2  BA             tsx                           ; Get stack pointer to check saved status register
0010A0r 2  BD 04 01       lda $104,x                    ; Load saved P (SP+4: past X, Y, A we pushed)
0010A3r 2  29 10          and #$10                      ; Test B flag — set by BRK, clear by hardware IRQ
0010A5r 2  D0 47          bne @IrqBrk                   ; Branch if this was a BRK instruction
0010A7r 2               @IrqSc:
0010A7r 2  AD 0D 03       lda HW_PRESENT
0010AAr 2  29 10          and #HW_SC
0010ACr 2  F0 19          beq @IrqCheckKB               ; Serial not present — skip
0010AEr 2  AD 01 90       lda SC_STATUS
0010B1r 2  29 80          and #SC_STATUS_IRQ            ; Check if serial data caused the interrupt
0010B3r 2  F0 12          beq @IrqCheckKB               ; If not, check keyboard
0010B5r 2  AD 00 90       lda SC_DATA                   ; Read the data from serial register
0010B8r 2  20 rr rr       jsr WriteBuffer               ; Store to the input buffer
0010BBr 2  20 rr rr       jsr BufferSize
0010BEr 2  C9 F0          cmp #$F0                      ; Is the buffer almost full?
0010C0r 2  90 05          bcc @IrqCheckKB               ; If not, also check keyboard
0010C2r 2  A9 01          lda #$01                      ; No parity, no echo, RTSB high, TX interrupts disabled, RX interrupts enabled
0010C4r 2  8D 02 90       sta SC_CMD                    ; Otherwise, signal not ready for receiving (RTSB high)
0010C7r 2                                               ; Fall through to check keyboard — always clear VIA flags
0010C7r 2               @IrqCheckKB:
0010C7r 2  AD 0D 03       lda HW_PRESENT
0010CAr 2  29 20          and #HW_GPIO
0010CCr 2  F0 1C          beq @IrqExit                  ; GPIO not present — skip
0010CEr 2  AD 0D 94       lda GPIO_IFR
0010D1r 2  29 10          and #GPIO_INT_CB1             ; Check if CB1 (matrix keyboard data ready) caused the interrupt
0010D3r 2  F0 08          beq @IrqCheckPS2              ; If not, check PS/2 keyboard
0010D5r 2  AD 00 94       lda GPIO_PORTB                ; Read ASCII byte from matrix keyboard (also clears CB1 IFR flag)
0010D8r 2  20 rr rr       jsr WriteBuffer               ; Store to the input buffer
0010DBr 2  80 0D          bra @IrqExit
0010DDr 2               @IrqCheckPS2:
0010DDr 2  AD 0D 94       lda GPIO_IFR
0010E0r 2  29 02          and #GPIO_INT_CA1             ; Check if CA1 (PS/2 keyboard data ready) caused the interrupt
0010E2r 2  F0 06          beq @IrqExit                  ; If not, exit
0010E4r 2  AD 01 94       lda GPIO_PORTA                ; Read ASCII byte from PS/2 keyboard (also clears CA1 IFR flag)
0010E7r 2  20 rr rr       jsr WriteBuffer               ; Store to the input buffer
0010EAr 2               @IrqExit:
0010EAr 2  FA             plx
0010EBr 2  7A             ply
0010ECr 2  68             pla
0010EDr 2  40             rti
0010EEr 2               @IrqBrk:
0010EEr 2  FA             plx                           ; Restore saved registers
0010EFr 2  7A             ply
0010F0r 2  68             pla
0010F1r 2  58             cli                           ; Re-enable interrupts — abandoning interrupt context
0010F2r 2  6C 02 03       jmp (BRK_PTR)                 ; BRK — dispatch with P/PCL/PCH still on stack
0010F5r 2               
0010F5r 2               ; NMI Vector
0010F5r 2               NmiVec:
0010F5r 2  6C 04 03       jmp (NMI_PTR)                 ; Indirect jump through NMI pointer to the NMI handler
0010F8r 2               
0010F8r 2               ; Reset Vector
0010F8r 2               ResetVec:
0010F8r 2  4C rr rr       jmp Reset                     ; Initialize the system
0010FBr 2               
0010FBr 2               ; IRQ Vector
0010FBr 2               IrqVec:
0010FBr 2  6C 00 03       jmp (IRQ_PTR)                 ; Indirect jump through IRQ pointer to the IRQ handler
0010FEr 2               
0010FEr 1               .segment "CHARS"
000000r 1               .include "Chars.asm"
000000r 2               ; IBM Code Page 437 Character Set
000000r 2               ; 5x8 pixel font in 8x8 area, 8 bytes per character (256 characters total)
000000r 2               ; Each byte represents one horizontal row of pixels (5 pixels left-aligned in 8-bit space)
000000r 2               
000000r 2               CharacterSet:
000000r 2                   ; Character $00 - NULL (blank)
000000r 2  00 00 00 00      .byte $00, $00, $00, $00, $00, $00, $00, $00
000004r 2  00 00 00 00  
000008r 2                   ; Character $01 - ☺ (white smiling face)
000008r 2  70 88 D8 88      .byte $70, $88, $D8, $88, $A8, $88, $70, $00
00000Cr 2  A8 88 70 00  
000010r 2                   ; Character $02 - ☻ (black smiling face)
000010r 2  70 F8 A8 F8      .byte $70, $F8, $A8, $F8, $88, $F8, $70, $00
000014r 2  88 F8 70 00  
000018r 2                   ; Character $03 - ♥ (heart)
000018r 2  00 50 F8 F8      .byte $00, $50, $F8, $F8, $F8, $70, $20, $00
00001Cr 2  F8 70 20 00  
000020r 2                   ; Character $04 - ♦ (diamond)
000020r 2  00 20 70 F8      .byte $00, $20, $70, $F8, $F8, $70, $20, $00
000024r 2  F8 70 20 00  
000028r 2                   ; Character $05 - ♣ (club)
000028r 2  20 70 70 20      .byte $20, $70, $70, $20, $F8, $F8, $20, $00
00002Cr 2  F8 F8 20 00  
000030r 2                   ; Character $06 - ♠ (spade)
000030r 2  00 20 70 F8      .byte $00, $20, $70, $F8, $F8, $20, $70, $00
000034r 2  F8 20 70 00  
000038r 2                   ; Character $07 - • (bullet)
000038r 2  00 00 00 30      .byte $00, $00, $00, $30, $30, $00, $00, $00
00003Cr 2  30 00 00 00  
000040r 2                   ; Character $08 - ◘ (inverse bullet)
000040r 2  FC FC FC CC      .byte $FC, $FC, $FC, $CC, $CC, $FC, $FC, $FC
000044r 2  CC FC FC FC  
000048r 2                   ; Character $09 - ○ (white circle)
000048r 2  00 00 78 48      .byte $00, $00, $78, $48, $48, $78, $00, $00
00004Cr 2  48 78 00 00  
000050r 2                   ; Character $0A - ◙ (inverse white circle)
000050r 2  FC FC 84 B4      .byte $FC, $FC, $84, $B4, $B4, $84, $FC, $FC
000054r 2  B4 84 FC FC  
000058r 2                   ; Character $0B - ♂ (male symbol)
000058r 2  00 38 18 68      .byte $00, $38, $18, $68, $90, $90, $60, $00
00005Cr 2  90 90 60 00  
000060r 2                   ; Character $0C - ♀ (female symbol)
000060r 2  70 88 88 70      .byte $70, $88, $88, $70, $20, $70, $20, $00
000064r 2  20 70 20 00  
000068r 2                   ; Character $0D - ♪ (eighth note)
000068r 2  20 30 28 20      .byte $20, $30, $28, $20, $60, $E0, $C0, $00
00006Cr 2  60 E0 C0 00  
000070r 2                   ; Character $0E - ♫ (beamed eighth notes)
000070r 2  18 68 58 68      .byte $18, $68, $58, $68, $58, $D8, $C0, $00
000074r 2  58 D8 C0 00  
000078r 2                   ; Character $0F - ☼ (sun)
000078r 2  00 A8 70 D8      .byte $00, $A8, $70, $D8, $70, $A8, $00, $00
00007Cr 2  70 A8 00 00  
000080r 2                   ; Character $10 - ► (right-pointing triangle)
000080r 2  40 60 70 78      .byte $40, $60, $70, $78, $70, $60, $40, $00
000084r 2  70 60 40 00  
000088r 2                   ; Character $11 - ◄ (left-pointing triangle)
000088r 2  10 30 70 F0      .byte $10, $30, $70, $F0, $70, $30, $10, $00
00008Cr 2  70 30 10 00  
000090r 2                   ; Character $12 - ↕ (up/down arrow)
000090r 2  20 70 F8 20      .byte $20, $70, $F8, $20, $F8, $70, $20, $00
000094r 2  F8 70 20 00  
000098r 2                   ; Character $13 - ‼ (double exclamation mark)
000098r 2  50 50 50 50      .byte $50, $50, $50, $50, $50, $00, $50, $00
00009Cr 2  50 00 50 00  
0000A0r 2                   ; Character $14 - ¶ (pilcrow)
0000A0r 2  78 A8 A8 68      .byte $78, $A8, $A8, $68, $28, $28, $28, $00
0000A4r 2  28 28 28 00  
0000A8r 2                   ; Character $15 - § (section sign)
0000A8r 2  70 88 60 50      .byte $70, $88, $60, $50, $30, $88, $70, $00
0000ACr 2  30 88 70 00  
0000B0r 2                   ; Character $16 - ▬ (black rectangle)
0000B0r 2  00 00 00 00      .byte $00, $00, $00, $00, $00, $F0, $F0, $00
0000B4r 2  00 F0 F0 00  
0000B8r 2                   ; Character $17 - ↨ (up/down arrow with base)
0000B8r 2  20 70 F8 20      .byte $20, $70, $F8, $20, $F8, $70, $20, $70
0000BCr 2  F8 70 20 70  
0000C0r 2                   ; Character $18 - ↑ (up arrow)
0000C0r 2  20 70 F8 20      .byte $20, $70, $F8, $20, $20, $20, $20, $00
0000C4r 2  20 20 20 00  
0000C8r 2                   ; Character $19 - ↓ (down arrow)
0000C8r 2  20 20 20 20      .byte $20, $20, $20, $20, $F8, $70, $20, $00
0000CCr 2  F8 70 20 00  
0000D0r 2                   ; Character $1A - → (right arrow)
0000D0r 2  00 20 30 F8      .byte $00, $20, $30, $F8, $30, $20, $00, $00
0000D4r 2  30 20 00 00  
0000D8r 2                   ; Character $1B - ← (left arrow)
0000D8r 2  00 20 60 F8      .byte $00, $20, $60, $F8, $60, $20, $00, $00
0000DCr 2  60 20 00 00  
0000E0r 2                   ; Character $1C - ∟ (right angle)
0000E0r 2  00 00 00 80      .byte $00, $00, $00, $80, $80, $80, $F8, $00
0000E4r 2  80 80 F8 00  
0000E8r 2                   ; Character $1D - ↔ (left/right arrow)
0000E8r 2  00 50 50 F8      .byte $00, $50, $50, $F8, $50, $50, $00, $00
0000ECr 2  50 50 00 00  
0000F0r 2                   ; Character $1E - ▲ (up-pointing triangle)
0000F0r 2  20 20 70 70      .byte $20, $20, $70, $70, $F8, $F8, $00, $00
0000F4r 2  F8 F8 00 00  
0000F8r 2                   ; Character $1F - ▼ (down-pointing triangle)
0000F8r 2  F8 F8 70 70      .byte $F8, $F8, $70, $70, $20, $20, $00, $00
0000FCr 2  20 20 00 00  
000100r 2                   ; Character $20 - SPACE
000100r 2  00 00 00 00      .byte $00, $00, $00, $00, $00, $00, $00, $00
000104r 2  00 00 00 00  
000108r 2                   ; Character $21 - !
