000880r 2               
000880r 2               ; =============================================================================
000880r 2               ;   F L O A T I N G - P O I N T   R U N T I M E
000880r 2               ;
000880r 2               ;   Externals required by the inlined MSBASIC FP code:
000880r 2               ;     ChrGet   - advance TXTPTR and load next non-space tokenized char
000880r 2               ;                (used by Fin; never exercised by the FP tests).
000880r 2               ;     BasErrorVec    - error vector; X = error code
000880r 2               ;     IqErr    - "?ILLEGAL QUANTITY" entry
000880r 2               ;     STROUT   - print NUL-terminated string at (A=lo, Y=hi)
000880r 2               ;     QtIn    - the literal " IN " string (used only by InPrt)
000880r 2               ; =============================================================================
000880r 2               
000880r 2               ; --- ChrGet / ChrGot --------------------------------------------------------
000880r 2               ; Real implementation (ROM, not ZP self-modifying).  Increments TXTPTR and
000880r 2               ; returns the next non-space byte at (TXTPTR) in A, with carry CLEAR if the
000880r 2               ; byte is a digit '0'-'9'.  ChrGot re-reads the current byte without
000880r 2               ; advancing first.  Both clobber only A and flags.
000880r 2               ;
000880r 2               ; Side effects on flags after the routine returns:
000880r 2               ;   Z=1  if A == $00 or A is a tokenized/keyword byte that wraps to zero
000880r 2               ;        (used by callers checking end-of-statement).
000880r 2               ;   C=0  if A is a digit ('0'-'9'); else C=1.
000880r 2               ;
000880r 2               ; Implementation matches msbasic-master/chrget.s.
000880r 2               ChrGet:
000880r 2  E6 04                inc     TXTPTR
000882r 2  D0 02                bne     ChrGot
000884r 2  E6 05                inc     TXTPTR+1
000886r 2               ChrGot:
000886r 2  B2 04                lda     (TXTPTR)
000888r 2  C9 3A                cmp     #':'
00088Ar 2  B0 0A                bcs     @out
00088Cr 2  C9 20                cmp     #' '
00088Er 2  F0 F0                beq     ChrGet
000890r 2  38                   sec
000891r 2  E9 30                sbc     #'0'
000893r 2  38                   sec
000894r 2  E9 D0                sbc     #$D0                    ; restore A; sets C=0 iff digit
000896r 2               @out:
000896r 2  60                   rts
000897r 2               
000897r 2               ; --- Error trampolines ------------------------------------------------------
000897r 2               ; The MSBASIC convention is "ldx #code / jmp ERROR".  Our BasError takes
000897r 2               ; the code in A, so translate.
000897r 2               BasErrorVec:
000897r 2  8A                   txa
000898r 2  4C rr rr             jmp     BasError
00089Br 2               
00089Br 2               IqErr:
00089Br 2  A2 0B                ldx     #ERR_ILLQUAN
00089Dr 2  4C rr rr             jmp     BasErrorVec
0008A0r 2               
0008A0r 2               ; --- String output ----------------------------------------------------------
0008A0r 2               ; FP code calls STROUT with (A=lo, Y=hi).  BasPrintStr matches that ABI.
0008A0r 2               STROUT          := BasPrintStr
0008A0r 2               
0008A0r 2               ; --- "IN " literal (referenced by InPrt) ----------------------------------
0008A0r 2               QtIn:
0008A0r 2  20 49 4E 20          .byte   " IN ",0
0008A4r 2  00           
0008A5r 2               
0008A5r 2               ; --- Shared RTS targets used by branches in the FP code --------------------
0008A5r 2               ; The original MSBASIC defines Rts3 in poke.s (which we don't include).
0008A5r 2               ; Provide a single shared RTS landing pad here.
0008A5r 2               Rts3:
0008A5r 2  60                   rts
