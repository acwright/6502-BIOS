00328Ar 2               
00328Ar 2               ; Built from the version equates rather than typed, so the header and
00328Ar 2               ; KernalVersion ($A07B) cannot disagree about which ROM this is.
00328Ar 2               MsgHeader:
00328Ar 2  41 43 36 35          .byte   .sprintf("AC6502 BIOS v%d.%d", BIOS_VERSION_MAJOR, BIOS_VERSION_MINOR),0
00328Er 2  30 32 20 42  
003292r 2  49 4F 53 20  
00329Br 2               
00329Br 2               ; The second line's lead-in.  A nod to the BASIC V2 of the classic machines,
00329Br 2               ; not this ROM's version, so it is typed rather than built from the equates.
00329Br 2               MsgBasicV2:
00329Br 2  0D 0A 42 41          .byte   $0D,$0A,"BASIC v2.0 ",0
00329Fr 2  53 49 43 20  
