002439r 2               
002439r 2               MsgRedo:
002439r 2  3F 52 45 44          .byte   "?REDO FROM START", $0D, $0A, 0
00243Dr 2  4F 20 46 52  
002441r 2  4F 4D 20 53  
00244Cr 2               MsgExtra:
00244Cr 2  3F 45 58 54          .byte   "?EXTRA IGNORED", $0D, $0A, 0
002450r 2  52 41 20 49  
002454r 2  47 4E 4F 52  
00245Dr 2               
00245Dr 2               ; ---------------------------------------------------------------------------
00245Dr 2               ; Statement: READ var[,var,...] -- pull next DATA item from BAS_DATAPTR
00245Dr 2               ; into the variable pointed to by PtrGet.
00245Dr 2               ; ---------------------------------------------------------------------------
00245Dr 2               BasCmdRead:
00245Dr 2  AE 1A 03             ldx     BAS_DATAPTR
002460r 2  AC 1B 03             ldy     BAS_DATAPTR+1
