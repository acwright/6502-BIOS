0029F8r 2               
0029F8r 2               ; BRK
0029F8r 2               BasCmdBrk:
0029F8r 2  00                   brk
0029F9r 2  00                   .byte   0
0029FAr 2  60                   rts
0029FBr 2               
0029FBr 2               ; POKE addr, val
0029FBr 2               ; The value expression is evaluated BEFORE the address is parked in INDEX:
0029FBr 2               ; FrmEvl clobbers every zero-page scratch pair (INDEX via LoadFacFromYa,
0029FBr 2               ; BAS_TMP1 via FacToU16 / the string functions), so the address has to ride
0029FBr 2               ; the hardware stack across the evaluation.
0029FBr 2               BasCmdPoke:
0029FBr 2  20 rr rr             jsr     EvalAddrU16
0029FEr 2  A5 11                lda     FAC+3                   ; hi
002A00r 2  48                   pha
002A01r 2  A5 12                lda     FAC+4                   ; lo
002A03r 2  48                   pha
002A04r 2  20 rr rr             jsr     ChkCom
002A07r 2  20 rr rr             jsr     GetByt                  ; X = val
002A0Ar 2  68                   pla
