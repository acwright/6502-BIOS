002921r 2  DA                   phx
002922r 2  20 rr rr             jsr     ChkCom
002925r 2  20 rr rr             jsr     GetByt                  ; X = m
002928r 2  DA                   phx
002929r 2  20 rr rr             jsr     ChkCom
00292Cr 2  20 rr rr             jsr     GetByt                  ; X = s
00292Fr 2  8A                   txa
002930r 2  A8                   tay                             ; Y = s
002931r 2  FA                   plx                             ; X = m
002932r 2  68                   pla                             ; A = h
002933r 2  4C rr rr             jmp     RtcWriteTime
002936r 2               
002936r 2               ; SETDATE c, y, m, d
002936r 2               BasCmdSetdate:
002936r 2  A9 04                lda     #HW_RTC
002938r 2  20 rr rr             jsr     ReqHw
00293Br 2  20 rr rr             jsr     GetByt
00293Er 2  8E 0B 03             stx     RTC_BUF_CENT
002941r 2  20 rr rr             jsr     ChkCom
002944r 2  20 rr rr             jsr     GetByt
002947r 2  DA                   phx                             ; year
002948r 2  20 rr rr             jsr     ChkCom
00294Br 2  20 rr rr             jsr     GetByt
00294Er 2  DA                   phx                             ; month
00294Fr 2  20 rr rr             jsr     ChkCom
002952r 2  20 rr rr             jsr     GetByt                  ; X=day
002955r 2  8A                   txa
002956r 2  FA                   plx                             ; X=month
002957r 2  7A                   ply                             ; Y=year
