0016FCr 2                       ; DATAPTR := TXTTAB - 1 so first READ does FindData and lands on
0016FCr 2                       ; the first DATA item.
0016FCr 2  38                   sec
0016FDr 2  AD 5D 03             lda     TXTTAB
001700r 2  E9 01                sbc     #1
001702r 2  8D 1A 03             sta     BAS_DATAPTR
001705r 2  AD 5E 03             lda     TXTTAB+1
