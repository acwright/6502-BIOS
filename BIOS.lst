000800r 2               
000800r 1               .segment "BASIC"
000000r 1               .include "BASIC.asm"
000000r 2               ; =============================================================================
000000r 2               ; BASIC v2.0  —  5-Byte Floating-Point MSBASIC-Compatible Interpreter
000000r 2               ;                for AC6502 Homebrew Computer
000000r 2               ;
000000r 2               ;   ROM Region  :  $C000-$EDFF  (11,776 bytes / $2E00)
000000r 2               ;   Segment     :  BASIC
000000r 2               ;   Entry point :  BasEntry  (first byte of segment = $C000)
000000r 2               ;   Assembler   :  ca65  (cc65 toolchain)
000000r 2               ;   Linker cfg  :  BIOS.cfg
000000r 2               ;
000000r 2               ;   Coding style :  Match the rest of the BIOS project.
000000r 2               ;                   * Routine / data labels : PascalCase  (e.g. BasEntry,
000000r 2               ;                     FAdd, NormalizeFac1, Lbl367F).
000000r 2               ;                   * Constants / equates    : UPPER_SNAKE_CASE
000000r 2               ;                     (e.g. BAS_TXTPTR, TOK_PRINT, ERR_SYNTAX).
000000r 2               ;                   * Local labels           : @camelCase or @PascalCase.
000000r 2               ;                   * Opcodes are lowercase.
000000r 2               ;
000000r 2               ;   Reference source tree:  msbasic-master/  (read-only; NOT linked).
000000r 2               ; =============================================================================
000000r 2               
000000r 2                       .segment "BASIC"
000000r 2               
000000r 2                       .macpack longbranch     ; jeq/jne/etc. used by ported MSBASIC FP code
000000r 3               .macro  jeq     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                       bne     *+5
000000r 3                       jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               beq     Target
000000r 3                       .else
000000r 3                               bne     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jne     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               beq     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bne     Target
000000r 3                       .else
000000r 3                               beq     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jmi     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bpl     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bmi     Target
000000r 3                       .else
000000r 3                               bpl     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jpl     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bmi     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bpl     Target
000000r 3                       .else
000000r 3                               bmi     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jcs     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bcc     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bcs     Target
000000r 3                       .else
000000r 3                               bcc     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jcc     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bcs     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bcc     Target
000000r 3                       .else
000000r 3                               bcs     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jvs     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bvc     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bvs     Target
000000r 3                       .else
000000r 3                               bvc     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               .macro  jvc     Target
000000r 3                       .if     .match(Target, 0)
000000r 3                               bvs     *+5
000000r 3                               jmp     Target
000000r 3                       .elseif .def(Target) .and .const((*-2)-(Target)) .and ((*+2)-(Target) <= 127)
000000r 3                               bvc     Target
000000r 3                       .else
000000r 3                               bvs     *+5
000000r 3                               jmp     Target
000000r 3                       .endif
000000r 3               .endmacro
000000r 3               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   Z E R O - P A G E   E Q U A T E S
000000r 2               ;
000000r 2               ;   $00-$03   Kernal reserved
000000r 2               ;   $04-$23   BASIC primary workspace
000000r 2               ;   $24-$39   Kernal reserved
000000r 2               ;   $3A-$FF   BASIC spill (FP scratch in later phases)
000000r 2               ; =============================================================================
000000r 2               
000000r 2               BAS_TXTPTR      := $04          ; $04-$05  ChrGet / parse pointer
000000r 2               BAS_CURLINE     := $06          ; $06-$07  Pointer to current executing line
000000r 2               BAS_LINNUM      := $08          ; $08-$09  Parsed line number / scratch (= LINNUM)
000000r 2               
000000r 2               ; ----- Floating-point primary block ($0A-$1B, contiguous) -------------------
000000r 2               ; The MSBASIC float code accesses these via ZP,X with one label as the
000000r 2               ; immediate base (e.g. EXPSGN,X / SHIFTSIGNEXT,X / TMPEXP,X), so this entire
000000r 2               ; block MUST stay contiguous in this exact order.  See msbasic-master/
000000r 2               ; zeropage.s for the reference layout.
000000r 2               BAS_TMPEXP      := $0A          ; $0A      TMPEXP / INDX (alias)
000000r 2               BAS_INDX        := $0A          ; $0A      (alias of TMPEXP per msbasic SMALL)
000000r 2               BAS_EXPON       := $0B          ; $0B      EXPON
000000r 2               BAS_LOWTR       := $0C          ; $0C      LOWTR
000000r 2               BAS_EXPSGN      := $0D          ; $0D      EXPSGN  (== FAC-1 scratch byte)
000000r 2               BAS_FAC         := $0E          ; $0E-$12  FAC  (5 bytes)
000000r 2               BAS_FACSIGN     := $13          ; $13      FACSIGN  (== FAC+5)
000000r 2               BAS_SERLEN      := $14          ; $14      SERLEN
000000r 2               BAS_SHIFTSGN    := $15          ; $15      SHIFTSIGNEXT (== ARG-1 scratch)
000000r 2               BAS_ARG         := $16          ; $16-$1A  ARG  (5 bytes)
000000r 2               BAS_ARGSIGN     := $1B          ; $1B      ARGSIGN  (== ARG+5)
000000r 2               ; ----------------------------------------------------------------------------
000000r 2               
000000r 2               BAS_STRNG1      := $1C          ; $1C-$1D  STRNG1 (= SGNCPR; +1 = FACEXTENSION)
000000r 2               BAS_STRNG2      := $1E          ; $1E-$1F  STRNG2
000000r 2               
000000r 2               BAS_INDEX       := $20          ; $20-$21  General index pointer (line walk + msbasic INDEX)
000000r 2               BAS_DEST        := $22          ; $22-$23  Destination pointer (msbasic DEST)
000000r 2               
000000r 2               ; ----- Spill area: $3A-$67 --------------------------------------------------
000000r 2               BAS_TMP1        := $3A          ; $3A-$3B  General-purpose 16-bit pointer
000000r 2               BAS_TMP2        := $3C          ; $3C-$3D  General-purpose 16-bit pointer
000000r 2               BAS_TMP3        := $3E          ; $3E      Spill scratch byte
000000r 2               BAS_VARPNT      := $3F          ; $3F-$40  Current variable address
000000r 2               BAS_QUOTEFLG    := $41          ; $41      Tokenizer quote-state
000000r 2               BAS_DETOKY      := $42          ; $42      Saved Y across detokenize calls
000000r 2               
000000r 2               ; FP-only scratch registers (single bytes unless noted)
000000r 2               BAS_ARGEXT      := $43          ; ARGEXTENSION
000000r 2               BAS_CHARAC      := $44          ; CHARAC (string-quote/end char tracker)
000000r 2               BAS_CPRMASK     := $45          ; CPRMASK (FComp result mask)
000000r 2               BAS_FORPNT      := $46          ; $46-$47  FORPNT
000000r 2               BAS_RESULT      := $48          ; $48-$4C  RESULT  (5-byte FMult accumulator)
000000r 2               BAS_TEMP1       := $4D          ; $4D-$51  TEMP1  (5-byte FP scratch)
000000r 2               BAS_TEMP2       := $52          ; $52-$56  TEMP2  (5-byte FP scratch)
000000r 2               BAS_TEMP3       := $57          ; $57-$5B  TEMP3  (5-byte FP scratch)
000000r 2               BAS_RNDSEED     := $5C          ; $5C-$60  RNDSEED (5-byte FP value)
000000r 2               BAS_KWPTR       := $61          ; $61-$62  Keyword-table walker pointer
000000r 2               
000000r 2               ; ----- Variable / array / string-heap workspace ($63-$85) -----------------
000000r 2               BAS_DIMFLG      := $63          ; DIM-mode flag (nonzero = called from DIM)
000000r 2               BAS_VALTYP      := $64          ; $64-$65  Value type ($00=numeric, $FF=string)
000000r 2               BAS_EOLPNTR     := $66          ; Array scratch: dim count / pointer
000000r 2               BAS_DATAFLG     := $67          ; GetSpa: GC retry flag
000000r 2               BAS_SUBFLG      := $68          ; PtrGet: $40 from GETARYPT, $80 from DEF FN
000000r 2               BAS_INPUTFLG    := $69          ; INPUT/READ flag
000000r 2               BAS_ENDCHR      := $6A          ; StrLt2 secondary terminator
000000r 2               BAS_TEMPPT      := $6B          ; Top-of-temp-string-stack pointer
000000r 2               BAS_LASTPT      := $6C          ; $6C-$6D  Last temp descriptor allocated
000000r 2               BAS_TEMPST      := $6E          ; $6E-$76  Temp descriptor stack (3 * 3 bytes)
000000r 2               BAS_HIGHDS      := $77          ; $77-$78  Bltu dest end+1
000000r 2               BAS_HIGHTR      := $79          ; $79-$7A  Bltu source end+1
000000r 2               BAS_VARNAM      := $7B          ; $7B-$7C  Variable name pair (with type bits)
000000r 2               BAS_DSCPTR      := $7D          ; $7D-$7E  String descriptor pointer
000000r 2               BAS_DSCLEN      := $7F          ; $7F-$80  String descriptor length / GC scratch
000000r 2               BAS_FNCNAM      := $81          ; $81-$82  GC: highest-string descriptor ptr
000000r 2               BAS_Z52         := $83          ; GC scratch byte
000000r 2               BAS_FRESPC      := $84          ; $84-$85  Free-string-space pointer
000000r 2               ; ----------------------------------------------------------------------------
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; Symbol aliases used by the inlined MSBASIC FP code.  These let the ported
000000r 2               ; routines keep their original names without a global rename pass.
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               FAC             := BAS_FAC
000000r 2               FAC_LAST        := BAS_FAC + 4
000000r 2               FACSIGN         := BAS_FACSIGN
000000r 2               ARG             := BAS_ARG
000000r 2               ARG_LAST        := BAS_ARG + 4
000000r 2               ARGSIGN         := BAS_ARGSIGN
000000r 2               INDEX           := BAS_INDEX
000000r 2               DEST            := BAS_DEST
000000r 2               STRNG1          := BAS_STRNG1
000000r 2               STRNG2          := BAS_STRNG2
000000r 2               SGNCPR          := BAS_STRNG1            ; aliased as in msbasic zeropage.s
000000r 2               FACEXTENSION    := BAS_STRNG1 + 1        ; aliased as in msbasic zeropage.s
000000r 2               TXTPTR          := BAS_TXTPTR
000000r 2               LINNUM          := BAS_LINNUM
000000r 2               CURLIN          := BAS_CURLIN            ; non-ZP ($0369) — only used by InPrt
000000r 2               VARPNT          := BAS_VARPNT
000000r 2               ARGEXTENSION    := BAS_ARGEXT
000000r 2               EXPON           := BAS_EXPON
000000r 2               EXPSGN          := BAS_EXPSGN
000000r 2               LOWTR           := BAS_LOWTR
000000r 2               INDX            := BAS_INDX
000000r 2               TMPEXP          := BAS_TMPEXP
000000r 2               SERLEN          := BAS_SERLEN
000000r 2               SHIFTSIGNEXT    := BAS_SHIFTSGN
000000r 2               CHARAC          := BAS_CHARAC
000000r 2               CPRMASK         := BAS_CPRMASK
000000r 2               FORPNT          := BAS_FORPNT
000000r 2               RESULT          := BAS_RESULT
000000r 2               RESULT_LAST     := BAS_RESULT + 4
000000r 2               TEMP1           := BAS_TEMP1
000000r 2               TEMP2           := BAS_TEMP2
000000r 2               TEMP3           := BAS_TEMP3
000000r 2               RNDSEED         := BAS_RNDSEED
000000r 2               
000000r 2               ; ----- Aliases used by ported msbasic var/array/string code ----------------
000000r 2               DIMFLG          := BAS_DIMFLG
000000r 2               VALTYP          := BAS_VALTYP
000000r 2               EOLPNTR         := BAS_EOLPNTR
000000r 2               DATAFLG         := BAS_DATAFLG
000000r 2               SUBFLG          := BAS_SUBFLG
000000r 2               INPUTFLG        := BAS_INPUTFLG
000000r 2               ENDCHR          := BAS_ENDCHR
000000r 2               TEMPPT          := BAS_TEMPPT
000000r 2               LASTPT          := BAS_LASTPT
000000r 2               TEMPST          := BAS_TEMPST
000000r 2               HIGHDS          := BAS_HIGHDS
000000r 2               HIGHTR          := BAS_HIGHTR
000000r 2               VARNAM          := BAS_VARNAM
000000r 2               DSCPTR          := BAS_DSCPTR
000000r 2               DSCLEN          := BAS_DSCLEN
000000r 2               FNCNAM          := BAS_FNCNAM
000000r 2               Z52             := BAS_Z52
000000r 2               FRESPC          := BAS_FRESPC
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; Constants required by the ported FP code.
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               BYTES_FP        = 5
000000r 2               MANTISSA_BYTES  = 4
000000r 2               MAX_EXPON       = 10
000000r 2               STACK2          = $0100             ; Fout output buffer base (bottom of stack page)
000000r 2               
000000r 2               ; Variable / array layout constants (CONFIG_2 / CBM2-class equivalents).
000000r 2               BYTES_PER_VARIABLE = 7              ; 2 name + 5 value (numeric or descriptor)
000000r 2               BYTES_PER_ELEMENT  = 5              ; numeric array element size
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; Aliases for the runtime pointers that live in $035D+ (defined in BIOS.inc).
000000r 2               ; The msbasic var/array/string code references them by these short names.
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               TXTTAB          := BAS_TXTTAB
000000r 2               VARTAB          := BAS_VARTAB
000000r 2               ARYTAB          := BAS_ARYTAB
000000r 2               STREND          := BAS_STREND
000000r 2               FRETOP          := BAS_FRETOP
000000r 2               MEMSIZ          := BAS_MEMSIZ
000000r 2               
000000r 2               ; ERR_OVERFLOW / ERR_DIVZERO already defined below; alias zerodiv:
000000r 2               ERR_ZERODIV     = 6                 ; matches ERR_DIVZERO
000000r 2               
000000r 2               ; Fin parses these as numeric-prefix tokens.  Final token assignments are
000000r 2               ; wired up when the expression evaluator goes live; until then $00 is fine
000000r 2               ; (will not appear in tokenised input).
000000r 2               TOKEN_PLUS      = $00
000000r 2               TOKEN_MINUS     = $00
000000r 2               
000000r 2               ; Rnd(0) source: 6 stable but variable bytes from kernel vars (IRQ_PTR/BRK_PTR
000000r 2               ; etc.).  Just needs to exist — used only when Rnd is called with arg 0.
000000r 2               ENTROPY         = $0300
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   R A M   L A Y O U T   ( B A S I C   W O R K S P A C E )
000000r 2               ;
000000r 2               ;   $0400-$04FF   Input line buffer (256 bytes)
000000r 2               ;   $0500-$05FF   Tokenized line scratch (256 bytes)
000000r 2               ;
000000r 2               ;   GOSUB / FOR stacks live elsewhere; $0500-$05FF doubles as the
000000r 2               ;   tokenization scratch buffer.  $0600-$07FF overlaps FS_SECTOR_BUF and
000000r 2               ;   is left untouched here.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               BAS_LINBUF      := $0400        ; Raw input line  (NUL-terminated)
000000r 2               BAS_TOKBUF      := $0500        ; Tokenized scratch buffer (NUL-terminated)
000000r 2               
000000r 2               BAS_LINBUF_MAX  = 200           ; Max accepted input length (bytes)
000000r 2               BAS_TOKBUF_MAX  = 250           ; Max tokenized payload bytes
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   P R O G R A M   S T O R A G E
000000r 2               ;
000000r 2               ;   Lines at $0800+ : [next-lo][next-hi][num-lo][num-hi][tokens...][$00]
000000r 2               ;   End-of-program  : a "next-pointer" of $0000.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               BAS_PRG_START   = $0800
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   T O K E N   E Q U A T E S
000000r 2               ;
000000r 2               ;   Tokens are assigned sequentially starting at $80.  KEEP THE TABLE BELOW
000000r 2               ;   IN SYNC WITH THESE EQUATES.  If you reorder or insert keywords, renumber.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               TOK_BASE        = $80
000000r 2               
000000r 2               TOK_END         = $80
000000r 2               TOK_FOR         = $81
000000r 2               TOK_NEXT        = $82
000000r 2               TOK_DATA        = $83
000000r 2               TOK_INPUT       = $84
000000r 2               TOK_DIM         = $85
000000r 2               TOK_READ        = $86
000000r 2               TOK_LET         = $87
000000r 2               TOK_GOTO        = $88
000000r 2               TOK_RUN         = $89
000000r 2               TOK_IF          = $8A
000000r 2               TOK_RESTORE     = $8B
000000r 2               TOK_GOSUB       = $8C
000000r 2               TOK_RETURN      = $8D
000000r 2               TOK_REM         = $8E
000000r 2               TOK_STOP        = $8F
000000r 2               TOK_ON          = $90
000000r 2               TOK_WAIT        = $91
000000r 2               TOK_LOAD        = $92
000000r 2               TOK_SAVE        = $93
000000r 2               TOK_DEF         = $94
000000r 2               TOK_POKE        = $95
000000r 2               TOK_PRINT       = $96
000000r 2               TOK_CONT        = $97
000000r 2               TOK_LIST        = $98
000000r 2               TOK_CLR         = $99
000000r 2               TOK_NEW         = $9A
000000r 2               TOK_TAB         = $9B
000000r 2               TOK_TO          = $9C
000000r 2               TOK_FN          = $9D
000000r 2               TOK_SPC         = $9E
000000r 2               TOK_THEN        = $9F
000000r 2               TOK_NOT         = $A0
000000r 2               TOK_STEP        = $A1
000000r 2               TOK_AND         = $A2
000000r 2               TOK_OR          = $A3
000000r 2               TOK_ELSE        = $A4
000000r 2               TOK_SYS         = $A5
000000r 2               TOK_DIR         = $A6
000000r 2               TOK_DEL         = $A7
000000r 2               TOK_CLS         = $A8
000000r 2               TOK_LOCATE      = $A9
000000r 2               TOK_COLOR       = $AA
000000r 2               TOK_SOUND       = $AB
000000r 2               TOK_VOL         = $AC
000000r 2               TOK_TIME        = $AD
000000r 2               TOK_DATE        = $AE
000000r 2               TOK_SETTIME     = $AF
000000r 2               TOK_SETDATE     = $B0
000000r 2               TOK_NVRAM       = $B1
000000r 2               TOK_PAUSE       = $B2
000000r 2               TOK_BANK        = $B3
000000r 2               TOK_BRK         = $B4
000000r 2               TOK_MEM         = $B5
000000r 2               TOK_SGN         = $B6
000000r 2               TOK_INT         = $B7
000000r 2               TOK_ABS         = $B8
000000r 2               TOK_FRE         = $B9
000000r 2               TOK_POS         = $BA
000000r 2               TOK_SQR         = $BB
000000r 2               TOK_RND         = $BC
000000r 2               TOK_LOG         = $BD
000000r 2               TOK_EXP         = $BE
000000r 2               TOK_COS         = $BF
000000r 2               TOK_SIN         = $C0
000000r 2               TOK_TAN         = $C1
000000r 2               TOK_ATN         = $C2
000000r 2               TOK_PEEK        = $C3
000000r 2               TOK_LEN         = $C4
000000r 2               TOK_STRSTR      = $C5           ; STR$
000000r 2               TOK_VAL         = $C6
000000r 2               TOK_ASC         = $C7
000000r 2               TOK_CHRSTR      = $C8           ; CHR$
000000r 2               TOK_LEFTSTR     = $C9           ; LEFT$
000000r 2               TOK_RIGHTSTR    = $CA           ; RIGHT$
000000r 2               TOK_MIDSTR      = $CB           ; MID$
000000r 2               TOK_JOY         = $CC
000000r 2               TOK_INKEY       = $CD
000000r 2               TOK_HEX         = $CE
000000r 2               TOK_MIN         = $CF
000000r 2               TOK_MAX         = $D0
000000r 2               TOK_DISK        = $D1           ; select current CF disk bank
000000r 2               TOK_BLOAD       = $D2           ; binary load to address
000000r 2               TOK_BSAVE       = $D3           ; binary save from address
000000r 2               TOK_FORMAT      = $D4           ; erase current disk directory
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   E R R O R   C O D E S
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ERR_SYNTAX      = 0
000000r 2               ERR_OVERFLOW    = 1
000000r 2               ERR_OUTOFMEM    = 2
000000r 2               ERR_UNDEFSTMT   = 3
000000r 2               ERR_BADSUBSCR   = 4
000000r 2               ERR_REDIM       = 5
000000r 2               ERR_DIVZERO     = 6
000000r 2               ERR_ILLDIRECT   = 7
000000r 2               ERR_TYPEMISM    = 8
000000r 2               ERR_LONGSTR     = 9
000000r 2               ERR_FORMULA     = 10
000000r 2               ERR_ILLQUAN     = 11
000000r 2               ERR_RG          = 12            ; RETURN without GOSUB
000000r 2               ERR_NF          = 13            ; NEXT without FOR
000000r 2               ERR_OD          = 14            ; OUT OF DATA
000000r 2               ERR_NODEV       = 15
000000r 2               ERR_CANTCONT    = 16
000000r 2               
000000r 2               ; Aliases used by ported msbasic code.
000000r 2               ERR_BADSUBS     = ERR_BADSUBSCR
000000r 2               ERR_REDIMD      = ERR_REDIM
000000r 2               ERR_FRMCPX      = ERR_FORMULA
000000r 2               ERR_MEMFULL     = ERR_OUTOFMEM
000000r 2               ERR_STRLONG     = ERR_LONGSTR
000000r 2               ERR_ILLQTY      = ERR_ILLQUAN
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   B A S E N T R Y   -   $C000
000000r 2               ;
000000r 2               ;   First byte of segment.  Reached from:
000000r 2               ;     * Kernal cold-boot path
000000r 2               ;     * Monitor 'X' command (warm re-entry)
000000r 2               ;
000000r 2               ;   Cold-vs-warm detection: BAS_WARM holds $A5 once cold init has run.
000000r 2               ;   Re-entry skips banner and goes straight to the OK prompt.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               BasEntry:
000000r 2  A2 FF                ldx     #$FF                    ; reset stack on (re)entry
000002r 2  9A                   txs
000003r 2  D8                   cld
000004r 2               
000004r 2  AD 6F 03             lda     BAS_WARM
000007r 2  C9 A5                cmp     #$A5
000009r 2  F0 08                beq     @Warm
00000Br 2               
00000Br 2  20 rr rr             jsr     BasColdInit
00000Er 2  20 rr rr             jsr     BasBanner
000011r 2  80 00                bra     BasReadyLoop
000013r 2               
000013r 2               @Warm:
000013r 2                       ; Warm restart - skip banner; the OK printer will lead with CRLF.
000013r 2               
000013r 2               ; -----------------------------------------------------------------------------
000013r 2               ; BasReadyLoop - REPL: print OK, read a line, dispatch.
000013r 2               ; -----------------------------------------------------------------------------
000013r 2               BasReadyLoop:
000013r 2  20 rr rr             jsr     BasPrintOK
000016r 2               @nextline:
000016r 2  20 rr rr             jsr     BasReadLine             ; fills BAS_LINBUF, NUL-terminated
000019r 2  20 rr rr             jsr     BasProcessLine
00001Cr 2  80 F8                bra     @nextline
00001Er 2               
00001Er 2               ; =============================================================================
00001Er 2               ;   B a s C o l d I n i t
00001Er 2               ; =============================================================================
00001Er 2               ; Initialise BASIC runtime variables.  Called once on first entry.
00001Er 2               ; =============================================================================
00001Er 2               BasColdInit:
00001Er 2                       ; ---------------------------------------------------------------------
00001Er 2                       ; Zero the BASIC-owned zero-page workspace first.  On a cold boot RAM
00001Er 2                       ; holds random power-up values, and the inlined MSBASIC math/parse code
00001Er 2                       ; treats several scratch cells as invariant-zero (e.g. SHIFTSIGNEXT,
00001Er 2                       ; FACEXTENSION, ARGEXTENSION) — they are only written on certain code
00001Er 2                       ; paths and assumed already 0 otherwise.  A random value in any of them
00001Er 2                       ; corrupts results; this is what produced the bogus "84405.0911 BYTES
00001Er 2                       ; FREE" banner on real hardware.  Clearing the whole region up front
00001Er 2                       ; eliminates this entire class of uninitialised-read bugs.  The two
00001Er 2                       ; ranges are the BASIC primary workspace ($04-$23) and the FP / var /
00001Er 2                       ; array / string spill ($3A-$85); $24-$39 is Kernal-reserved and left
00001Er 2                       ; untouched.  Specific non-zero values (CURLIN, TEMPPT, RND seed, etc.)
00001Er 2                       ; are written further down, after this clear.
00001Er 2  A9 00                lda     #0
000020r 2  A2 04                ldx     #BAS_TXTPTR             ; $04..$23
000022r 2               @ClrZpLo:
000022r 2  95 00                sta     ZP,x
000024r 2  E8                   inx
000025r 2  E0 24                cpx     #BAS_DEST+2
000027r 2  D0 F9                bne     @ClrZpLo
000029r 2  A2 3A                ldx     #BAS_TMP1               ; $3A..$85
00002Br 2               @ClrZpHi:
00002Br 2  95 00                sta     ZP,x
00002Dr 2  E8                   inx
00002Er 2  E0 86                cpx     #BAS_FRESPC+2
000030r 2  D0 F9                bne     @ClrZpHi
000032r 2               
000032r 2                       ; TXTTAB / MEMSIZ are constants for our memory map.
000032r 2  A9 00                lda     #<BAS_PRG_START
000034r 2  8D 5D 03             sta     BAS_TXTTAB
000037r 2  A9 08                lda     #>BAS_PRG_START
000039r 2  8D 5E 03             sta     BAS_TXTTAB+1
00003Cr 2               
00003Cr 2  A9 00                lda     #<$8000
00003Er 2  8D 67 03             sta     BAS_MEMSIZ
000041r 2  A9 80                lda     #>$8000
000043r 2  8D 68 03             sta     BAS_MEMSIZ+1
000046r 2               
000046r 2                       ; Auto-detect a pre-loaded program at $0800: if the first word looks
000046r 2                       ; like a valid next-pointer (high byte in [$08, $80)), walk the chain
000046r 2                       ; to compute end-of-program.  Otherwise install an empty program.
000046r 2  AD 01 08             lda     BAS_PRG_START+1         ; high byte of first next-ptr
000049r 2  C9 08                cmp     #$08
00004Br 2  90 43                bcc     @InstallEmpty
00004Dr 2  C9 80                cmp     #$80
00004Fr 2  B0 3F                bcs     @InstallEmpty
000051r 2               
000051r 2                       ; Walk the chain to find the end-marker (next-ptr = 0).
000051r 2  A9 00                lda     #<BAS_PRG_START
000053r 2  85 3A                sta     BAS_TMP1
000055r 2  A9 08                lda     #>BAS_PRG_START
000057r 2  85 3B                sta     BAS_TMP1+1
000059r 2               @WalkLoop:
000059r 2  A0 01                ldy     #1
00005Br 2  B1 3A                lda     (BAS_TMP1),y            ; next-ptr high byte
00005Dr 2  F0 20                beq     @WalkDone               ; 0 → end-marker reached
00005Fr 2  C9 80                cmp     #>$8000                 ; next-ptr must point below MEMSIZ
000061r 2  B0 2D                bcs     @InstallEmpty           ; out of range → not a real program
000063r 2  85 3D                sta     BAS_TMP2+1              ; stash candidate next-ptr
000065r 2  A0 00                ldy     #0
000067r 2  B1 3A                lda     (BAS_TMP1),y            ; next-ptr low byte
000069r 2  85 3C                sta     BAS_TMP2
00006Br 2                       ; Program lines are stored in strictly ascending address order.  If the
00006Br 2                       ; candidate next-ptr does not advance upward, we are walking random
00006Br 2                       ; power-up RAM (which on a cold boot can otherwise loop forever) — bail
00006Br 2                       ; out and install an empty program instead.
00006Br 2  A5 3A                lda     BAS_TMP1
00006Dr 2  C5 3C                cmp     BAS_TMP2
00006Fr 2  A5 3B                lda     BAS_TMP1+1
000071r 2  E5 3D                sbc     BAS_TMP2+1
000073r 2  B0 1B                bcs     @InstallEmpty           ; current >= candidate → invalid chain
000075r 2  A5 3C                lda     BAS_TMP2                ; advance to the next line
000077r 2  85 3A                sta     BAS_TMP1
000079r 2  A5 3D                lda     BAS_TMP2+1
00007Br 2  85 3B                sta     BAS_TMP1+1
00007Dr 2  80 DA                bra     @WalkLoop
00007Fr 2               @WalkDone:
00007Fr 2                       ; BAS_TMP1 points at the end-marker; VARTAB = TMP1 + 2.
00007Fr 2  18                   clc
000080r 2  A5 3A                lda     BAS_TMP1
000082r 2  69 02                adc     #2
000084r 2  8D 5F 03             sta     BAS_VARTAB
000087r 2  A5 3B                lda     BAS_TMP1+1
000089r 2  69 00                adc     #0
00008Br 2  8D 60 03             sta     BAS_VARTAB+1
00008Er 2  80 12                bra     @InitFinalize
000090r 2               
000090r 2               @InstallEmpty:
000090r 2                       ; Write [00][00] end-marker at $0800; VARTAB = $0802.
000090r 2  A9 00                lda     #0
000092r 2  8D 00 08             sta     BAS_PRG_START
000095r 2  8D 01 08             sta     BAS_PRG_START+1
000098r 2  A9 02                lda     #<(BAS_PRG_START+2)
00009Ar 2  8D 5F 03             sta     BAS_VARTAB
00009Dr 2  A9 08                lda     #>(BAS_PRG_START+2)
00009Fr 2  8D 60 03             sta     BAS_VARTAB+1
0000A2r 2               
0000A2r 2               @InitFinalize:
0000A2r 2                       ; ARYTAB = STREND = VARTAB; FRETOP = MEMSIZ.
0000A2r 2  AD 5F 03             lda     BAS_VARTAB
0000A5r 2  8D 61 03             sta     BAS_ARYTAB
0000A8r 2  8D 63 03             sta     BAS_STREND
0000ABr 2  AD 60 03             lda     BAS_VARTAB+1
0000AEr 2  8D 62 03             sta     BAS_ARYTAB+1
0000B1r 2  8D 64 03             sta     BAS_STREND+1
0000B4r 2  AD 67 03             lda     BAS_MEMSIZ
0000B7r 2  8D 65 03             sta     BAS_FRETOP
0000BAr 2  AD 68 03             lda     BAS_MEMSIZ+1
0000BDr 2  8D 66 03             sta     BAS_FRETOP+1
0000C0r 2               
0000C0r 2                       ; CURLIN = $FFFF (direct mode marker).
0000C0r 2  A9 FF                lda     #$FF
0000C2r 2  8D 69 03             sta     BAS_CURLIN
0000C5r 2  8D 6A 03             sta     BAS_CURLIN+1
0000C8r 2               
0000C8r 2                       ; Clear CONT state and pending-key.
0000C8r 2  9C 6B 03             stz     BAS_OLDLIN
0000CBr 2  9C 6C 03             stz     BAS_OLDLIN+1
0000CEr 2  9C 6D 03             stz     BAS_OLDTEXT
0000D1r 2  9C 6E 03             stz     BAS_OLDTEXT+1
0000D4r 2  9C 1A 03             stz     BAS_DATAPTR
0000D7r 2  9C 1B 03             stz     BAS_DATAPTR+1
0000DAr 2  9C 1C 03             stz     BAS_STOPLINE
0000DDr 2  9C 1D 03             stz     BAS_STOPLINE+1
0000E0r 2  9C 1E 03             stz     BAS_STOPTXT
0000E3r 2  9C 1F 03             stz     BAS_STOPTXT+1
0000E6r 2  9C 0E 03             stz     BAS_PENDKEY
0000E9r 2  9C 70 03             stz     BAS_POSX                ; PRINT column counter (non-ZP)
0000ECr 2               
0000ECr 2                       ; ZP runtime flags (QUOTEFLG, DIMFLG, VALTYP, DATAFLG, SUBFLG,
0000ECr 2                       ; INPUTFLG, SHIFTSIGNEXT, ...) are already zeroed by the cold-init
0000ECr 2                       ; clear loop above; only non-zero / non-ZP state is set here.
0000ECr 2               
0000ECr 2                       ; Temp-string descriptor stack: TEMPPT = TEMPST.
0000ECr 2  A9 6E                lda     #BAS_TEMPST
0000EEr 2  85 6B                sta     BAS_TEMPPT
0000F0r 2               
0000F0r 2                       ; Initialise Rnd seed from the embedded constant.
0000F0r 2  A2 04                ldx     #4
0000F2r 2               @SeedCopy:
0000F2r 2  BD rr rr             lda     RndSeedInit,x
0000F5r 2  95 5C                sta     RNDSEED,x
0000F7r 2  CA                   dex
0000F8r 2  10 F8                bpl     @SeedCopy
0000FAr 2               
0000FAr 2                       ; Mark warm-start magic.
0000FAr 2  A9 A5                lda     #$A5
0000FCr 2  8D 6F 03             sta     BAS_WARM
0000FFr 2  60                   rts
000100r 2               
000100r 2               ; =============================================================================
000100r 2               ;   B a s B a n n e r
000100r 2               ; =============================================================================
000100r 2               BasBanner:
000100r 2  A9 rr                lda     #<MsgBanner
000102r 2  A0 rr                ldy     #>MsgBanner
000104r 2  20 rr rr             jsr     BasPrintStr
000107r 2                       ; Print "<n> BYTES FREE" line.
000107r 2  38                   sec
000108r 2  AD 67 03             lda     BAS_MEMSIZ
00010Br 2  ED 5F 03             sbc     BAS_VARTAB
00010Er 2  A8                   tay
00010Fr 2  AD 68 03             lda     BAS_MEMSIZ+1
000112r 2  ED 60 03             sbc     BAS_VARTAB+1
000115r 2  20 rr rr             jsr     GivAyf
000118r 2                       ; Print the byte count left-aligned: Fout always emits a leading
000118r 2                       ; sign character (' ' for positive, '-' for negative).  For the
000118r 2                       ; banner we skip that leading space so the number lines up with
000118r 2                       ; the left edge of the title above it.
000118r 2  20 rr rr             jsr     Fout                    ; (Y,A) -> NUL-terminated buffer
00011Br 2  85 20                sta     INDEX
00011Dr 2  84 21                sty     INDEX+1
00011Fr 2  A0 00                ldy     #0
000121r 2  B1 20                lda     (INDEX),y
000123r 2  C9 20                cmp     #' '
000125r 2  D0 01                bne     @bnLoop
000127r 2  C8                   iny                             ; skip the positive-sign space
000128r 2               @bnLoop:
000128r 2  B1 20                lda     (INDEX),y
00012Ar 2  F0 06                beq     @bnDone
00012Cr 2  20 rr rr             jsr     PrintCh
00012Fr 2  C8                   iny
000130r 2  D0 F6                bne     @bnLoop
000132r 2               @bnDone:
000132r 2  A9 rr                lda     #<MsgBytesFreeNL
000134r 2  A0 rr                ldy     #>MsgBytesFreeNL
000136r 2  4C rr rr             jmp     BasPrintStr
000139r 2               
000139r 2               ; =============================================================================
000139r 2               ;   B a s P r i n t O K
000139r 2               ; =============================================================================
000139r 2               BasPrintOK:
000139r 2  20 rr rr             jsr     BasPrintCRLF
00013Cr 2  A9 rr                lda     #<MsgOK
00013Er 2  A0 rr                ldy     #>MsgOK
000140r 2  4C rr rr             jmp     BasPrintStr
000143r 2               
000143r 2               ; =============================================================================
000143r 2               ;   B a s P r i n t S t r  /  B a s P r i n t C R L F
000143r 2               ; =============================================================================
000143r 2               ; These were promoted to the KERNAL jump table as PrintStr ($A090) and
000143r 2               ; PrintCRLF ($A093) so cartridges can reuse them and the KERNAL no longer
000143r 2               ; depends on BASIC-segment code.  Keep the old BASIC names as aliases so the
000143r 2               ; existing call sites (and A=lo/Y=hi convention) are unchanged.
000143r 2               BasPrintStr     := PrintStr
000143r 2               BasPrintCRLF    := PrintCRLF
000143r 2               
000143r 2               ; =============================================================================
000143r 2               ;   B a s R e a d L i n e
000143r 2               ; =============================================================================
000143r 2               ; Read a line of input into BAS_LINBUF, NUL-terminated.  Echoes characters
000143r 2               ; manually (does not use Chrin's auto-echo).  Supports CR, BS ($08), ESC
000143r 2               ; ($1B = cancel and restart line).  Caps stored length at BAS_LINBUF_MAX
000143r 2               ; (extra characters are silently dropped from the buffer but still echoed
000143r 2               ; -- acceptable truncation behavior).
000143r 2               ;
000143r 2               ; Output : BAS_LINBUF holds the raw line, terminated with $00.
000143r 2               ; =============================================================================
000143r 2               BasReadLine:
000143r 2  A0 00                ldy     #0
000145r 2               @Loop:
000145r 2  20 rr rr             jsr     BasReadKey              ; A = next key, blocking
000148r 2  C9 0D                cmp     #$0D
00014Ar 2  F0 30                beq     @Done
00014Cr 2  C9 08                cmp     #$08
00014Er 2  F0 19                beq     @Backspace
000150r 2  C9 1B                cmp     #$1B
000152r 2  F0 21                beq     @Cancel
000154r 2  C9 20                cmp     #$20                    ; reject control codes below space
000156r 2  90 ED                bcc     @Loop
000158r 2  C9 7F                cmp     #$7F                    ; reject DEL and 8-bit
00015Ar 2  B0 E9                bcs     @Loop
00015Cr 2                       ; Printable - store and echo.
00015Cr 2  C0 C8                cpy     #BAS_LINBUF_MAX
00015Er 2  B0 E5                bcs     @Loop                   ; full - drop quietly
000160r 2  99 00 04             sta     BAS_LINBUF,y
000163r 2  C8                   iny
000164r 2  20 rr rr             jsr     Chrout
000167r 2  80 DC                bra     @Loop
000169r 2               
000169r 2               @Backspace:
000169r 2  C0 00                cpy     #0
00016Br 2  F0 D8                beq     @Loop                   ; nothing to erase
00016Dr 2  88                   dey
00016Er 2  A9 08                lda     #$08                    ; video / serial driver erases on BS
000170r 2  20 rr rr             jsr     Chrout
000173r 2  80 D0                bra     @Loop
000175r 2               
000175r 2               @Cancel:
000175r 2  20 rr rr             jsr     BasPrintCRLF
000178r 2  A0 00                ldy     #0
00017Ar 2  80 C9                bra     @Loop
00017Cr 2               
00017Cr 2               @Done:
00017Cr 2  A9 00                lda     #0
00017Er 2  99 00 04             sta     BAS_LINBUF,y
000181r 2  20 rr rr             jsr     BasPrintCRLF
000184r 2  60                   rts
000185r 2               
000185r 2               ; =============================================================================
000185r 2               ;   B a s R e a d K e y
000185r 2               ; =============================================================================
000185r 2               ; Spin until a key is available in the input buffer; return it in A
000185r 2               ; (no echo).
000185r 2               ; =============================================================================
000185r 2               BasReadKey:
000185r 2               @Wait:
000185r 2  20 rr rr             jsr     BufferSize
000188r 2  F0 FB                beq     @Wait
00018Ar 2  4C rr rr             jmp     ReadBuffer              ; tail-call: returns A=byte
00018Dr 2               
00018Dr 2               ; =============================================================================
00018Dr 2               ;   B a s P r o c e s s L i n e
00018Dr 2               ; =============================================================================
00018Dr 2               ; Triage BAS_LINBUF after reading: empty, numbered (insert/replace/delete),
00018Dr 2               ; or immediate command.
00018Dr 2               ; =============================================================================
00018Dr 2               BasProcessLine:
00018Dr 2  A2 00                ldx     #0
00018Fr 2               @SkipSpaces:
00018Fr 2  BD 00 04             lda     BAS_LINBUF,x
000192r 2  F0 07                beq     @Empty
000194r 2  C9 20                cmp     #' '
000196r 2  D0 04                bne     @HasContent
000198r 2  E8                   inx
000199r 2  80 F4                bra     @SkipSpaces
00019Br 2               @Empty:
00019Br 2  60                   rts                             ; nothing to do; caller will reprompt
00019Cr 2               
00019Cr 2               @HasContent:
00019Cr 2  C9 30                cmp     #'0'
00019Er 2  90 1A                bcc     @Immediate
0001A0r 2  C9 3A                cmp     #'9'+1
0001A2r 2  B0 16                bcs     @Immediate
0001A4r 2               
0001A4r 2               ; --- Numbered line -----------------------------------------------------------
0001A4r 2  20 rr rr             jsr     BasParseLineNum         ; consumes digits at BAS_LINBUF+X
0001A7r 2                       ; X now points to first non-digit; allow exactly one optional space.
0001A7r 2  BD 00 04             lda     BAS_LINBUF,x
0001AAr 2  C9 20                cmp     #' '
0001ACr 2  D0 01                bne     @TokenizeRest
0001AEr 2  E8                   inx
0001AFr 2               @TokenizeRest:
0001AFr 2  20 rr rr             jsr     BasCrunch               ; tokenize from BAS_LINBUF+X to BAS_TOKBUF
0001B2r 2  B0 03                bcs     @StoreLine              ; carry set = success
0001B4r 2  4C rr rr             jmp     BasErrSyntax
0001B7r 2               
0001B7r 2               @StoreLine:
0001B7r 2  4C rr rr             jmp     BasStoreLine            ; insert/replace/delete by line number
0001BAr 2               
0001BAr 2               @Immediate:
0001BAr 2                       ; Immediate (no line number) - tokenize whole line and dispatch.
0001BAr 2  A2 00                ldx     #0
0001BCr 2  20 rr rr             jsr     BasCrunch
0001BFr 2  B0 03                bcs     @ImmDispatch
0001C1r 2  4C rr rr             jmp     BasErrSyntax
0001C4r 2               @ImmDispatch:
0001C4r 2  20 rr rr             jsr     BasDispatchImmediate
0001C7r 2  4C rr rr             jmp     BasPrintOK              ; MS BASIC: OK only after immediate
0001CAr 2               
0001CAr 2               ; =============================================================================
0001CAr 2               ;   B a s P a r s e L i n e N u m
0001CAr 2               ; =============================================================================
0001CAr 2               ; Parse decimal digits at BAS_LINBUF,X into BAS_LINNUM (16-bit).
0001CAr 2               ; X advances past the digits.  Saturates at $FFFF on overflow.
0001CAr 2               ; =============================================================================
0001CAr 2               BasParseLineNum:
0001CAr 2  64 08                stz     BAS_LINNUM
0001CCr 2  64 09                stz     BAS_LINNUM+1
0001CEr 2               @Loop:
0001CEr 2  BD 00 04             lda     BAS_LINBUF,x
0001D1r 2  C9 30                cmp     #'0'
0001D3r 2  90 35                bcc     @Done
0001D5r 2  C9 3A                cmp     #'9'+1
0001D7r 2  B0 31                bcs     @Done
0001D9r 2                       ; Multiply LINNUM by 10.
0001D9r 2  48                   pha
0001DAr 2  06 08                asl     BAS_LINNUM              ; *2
0001DCr 2  26 09                rol     BAS_LINNUM+1
0001DEr 2  A5 08                lda     BAS_LINNUM
0001E0r 2  85 3A                sta     BAS_TMP1
0001E2r 2  A5 09                lda     BAS_LINNUM+1
0001E4r 2  85 3B                sta     BAS_TMP1+1
0001E6r 2  06 08                asl     BAS_LINNUM              ; *4
0001E8r 2  26 09                rol     BAS_LINNUM+1
0001EAr 2  06 08                asl     BAS_LINNUM              ; *8
0001ECr 2  26 09                rol     BAS_LINNUM+1
0001EEr 2  18                   clc                             ; *8 + *2 = *10
0001EFr 2  A5 08                lda     BAS_LINNUM
0001F1r 2  65 3A                adc     BAS_TMP1
0001F3r 2  85 08                sta     BAS_LINNUM
0001F5r 2  A5 09                lda     BAS_LINNUM+1
0001F7r 2  65 3B                adc     BAS_TMP1+1
0001F9r 2  85 09                sta     BAS_LINNUM+1
0001FBr 2                       ; Add digit value.
0001FBr 2  68                   pla
0001FCr 2  29 0F                and     #$0F
0001FEr 2  18                   clc
0001FFr 2  65 08                adc     BAS_LINNUM
000201r 2  85 08                sta     BAS_LINNUM
000203r 2  90 02                bcc     @NoCarry
000205r 2  E6 09                inc     BAS_LINNUM+1
000207r 2               @NoCarry:
000207r 2  E8                   inx
000208r 2  80 C4                bra     @Loop
00020Ar 2               @Done:
00020Ar 2  60                   rts
00020Br 2               
00020Br 2               ; =============================================================================
00020Br 2               ;   B a s C r u n c h
00020Br 2               ; =============================================================================
00020Br 2               ; Tokenize BAS_LINBUF starting at offset X into BAS_TOKBUF.
00020Br 2               ;
00020Br 2               ; Tokenization rules:
00020Br 2               ;   - Outside quoted strings, lowercase a-z are folded to uppercase.
00020Br 2               ;   - Outside quoted strings, alphabetic runs are matched against the
00020Br 2               ;     keyword table; on a match the token byte is emitted in place of the
00020Br 2               ;     keyword characters.
00020Br 2               ;   - Inside double quotes, characters are copied verbatim until the
00020Br 2               ;     closing quote (or end of line).
00020Br 2               ;   - After a REM token, the rest of the line is copied verbatim.
00020Br 2               ;   - Disallowed punctuation (@, &, [, ], {, }, |, \, `, ~) raises
00020Br 2               ;     ?SYNTAX ERROR via carry-clear return.
00020Br 2               ;
00020Br 2               ; Output : BAS_TOKBUF holds the tokenized line, NUL-terminated.
00020Br 2               ; Returns: carry SET on success, carry CLEAR on syntax error.
00020Br 2               ; Clobbers: A, X, Y, BAS_TMP1/TMP2/TMP3.
00020Br 2               ; =============================================================================
00020Br 2               BasCrunch:
00020Br 2                       ; X = src index, Y = dst index
00020Br 2  A0 00                ldy     #0
00020Dr 2  64 41                stz     BAS_QUOTEFLG
00020Fr 2               @Scan:
00020Fr 2  C0 FA                cpy     #BAS_TOKBUF_MAX
000211r 2  B0 0A                bcs     @Overflow
000213r 2  BD 00 04             lda     BAS_LINBUF,x
000216r 2  D0 07                bne     @NotEnd
000218r 2                       ; End of input.
000218r 2  99 00 05             sta     BAS_TOKBUF,y            ; A=0
00021Br 2  38                   sec
00021Cr 2  60                   rts
00021Dr 2               @Overflow:
00021Dr 2                       ; Tokenized line too long; treat as syntax error.
00021Dr 2  18                   clc
00021Er 2  60                   rts
00021Fr 2               
00021Fr 2               @NotEnd:
00021Fr 2  C9 22                cmp     #'"'
000221r 2  F0 56                beq     @Quote
000223r 2                       ; Lowercase to uppercase outside quotes.
000223r 2  C9 61                cmp     #'a'
000225r 2  90 06                bcc     @CheckAlpha
000227r 2  C9 7B                cmp     #'z'+1
000229r 2  B0 02                bcs     @CheckAlpha
00022Br 2  29 DF                and     #$DF
00022Dr 2               @CheckAlpha:
00022Dr 2                       ; Alphabetic? Try keyword match.
00022Dr 2  C9 41                cmp     #'A'
00022Fr 2  90 3A                bcc     @NotAlpha
000231r 2  C9 5B                cmp     #'Z'+1
000233r 2  B0 36                bcs     @NotAlpha
000235r 2                       ; Alpha - try matching a keyword starting at BAS_LINBUF,x.
000235r 2  20 rr rr             jsr     BasMatchKeyword         ; returns C set (A=token, X advanced) or C clear
000238r 2  90 1D                bcc     @CopyAlpha
00023Ar 2                       ; Match: emit token byte.
00023Ar 2  99 00 05             sta     BAS_TOKBUF,y
00023Dr 2  C8                   iny
00023Er 2  C9 8E                cmp     #TOK_REM
000240r 2  D0 CD                bne     @Scan
000242r 2                       ; After REM: copy the remainder verbatim.
000242r 2               @RemCopy:
000242r 2  C0 FA                cpy     #BAS_TOKBUF_MAX
000244r 2  B0 D7                bcs     @Overflow
000246r 2  BD 00 04             lda     BAS_LINBUF,x
000249r 2  F0 07                beq     @TermAndExit
00024Br 2  99 00 05             sta     BAS_TOKBUF,y
00024Er 2  C8                   iny
00024Fr 2  E8                   inx
000250r 2  80 F0                bra     @RemCopy
000252r 2               @TermAndExit:
000252r 2  99 00 05             sta     BAS_TOKBUF,y            ; A=0
000255r 2  38                   sec
000256r 2  60                   rts
000257r 2               
000257r 2               @CopyAlpha:
000257r 2                       ; No keyword match - copy a single alpha char (re-uppercase here, since
000257r 2                       ; BasMatchKeyword returns the original LINBUF byte).
000257r 2  BD 00 04             lda     BAS_LINBUF,x
00025Ar 2  C9 61                cmp     #'a'
00025Cr 2  90 06                bcc     @CASto
00025Er 2  C9 7B                cmp     #'z'+1
000260r 2  B0 02                bcs     @CASto
000262r 2  29 DF                and     #$DF
000264r 2               @CASto:
000264r 2  99 00 05             sta     BAS_TOKBUF,y
000267r 2  C8                   iny
000268r 2  E8                   inx
000269r 2  80 A4                bra     @Scan
00026Br 2               
00026Br 2               @NotAlpha:
00026Br 2                       ; Punctuation / digit / space.  Validate against the disallowed set.
00026Br 2  20 rr rr             jsr     BasValidPunct
00026Er 2  90 07                bcc     @SyntaxFail
000270r 2  99 00 05             sta     BAS_TOKBUF,y
000273r 2  C8                   iny
000274r 2  E8                   inx
000275r 2  80 98                bra     @Scan
000277r 2               @SyntaxFail:
000277r 2  18                   clc
000278r 2  60                   rts
000279r 2               
000279r 2               @Quote:
000279r 2                       ; Copy opening quote, then everything up to closing quote (or end).
000279r 2  99 00 05             sta     BAS_TOKBUF,y
00027Cr 2  C8                   iny
00027Dr 2  E8                   inx
00027Er 2               @QuoteLoop:
00027Er 2  C0 FA                cpy     #BAS_TOKBUF_MAX
000280r 2  B0 9B                bcs     @Overflow
000282r 2  BD 00 04             lda     BAS_LINBUF,x
000285r 2  F0 CB                beq     @TermAndExit
000287r 2  99 00 05             sta     BAS_TOKBUF,y
00028Ar 2  C8                   iny
00028Br 2  E8                   inx
00028Cr 2  C9 22                cmp     #'"'
00028Er 2  D0 EE                bne     @QuoteLoop
000290r 2  4C rr rr             jmp     @Scan
000293r 2               
000293r 2               ; =============================================================================
000293r 2               ;   B a s V a l i d P u n c t
000293r 2               ; =============================================================================
000293r 2               ; Verify A is an acceptable non-keyword character.
000293r 2               ; Carry SET = OK, carry CLEAR = illegal.
000293r 2               ; Allowed: anything in $20-$7E EXCEPT @, &, [, ], {, }, |, \, `, ~.
000293r 2               ; =============================================================================
000293r 2               BasValidPunct:
000293r 2  C9 40                cmp     #'@'
000295r 2  F0 26                beq     @Bad
000297r 2  C9 26                cmp     #'&'
000299r 2  F0 22                beq     @Bad
00029Br 2  C9 5B                cmp     #'['
00029Dr 2  F0 1E                beq     @Bad
00029Fr 2  C9 5D                cmp     #']'
0002A1r 2  F0 1A                beq     @Bad
0002A3r 2  C9 7B                cmp     #'{'
0002A5r 2  F0 16                beq     @Bad
0002A7r 2  C9 7D                cmp     #'}'
0002A9r 2  F0 12                beq     @Bad
0002ABr 2  C9 7C                cmp     #'|'
0002ADr 2  F0 0E                beq     @Bad
0002AFr 2  C9 5C                cmp     #'\'
0002B1r 2  F0 0A                beq     @Bad
0002B3r 2  C9 60                cmp     #'`'
0002B5r 2  F0 06                beq     @Bad
0002B7r 2  C9 7E                cmp     #'~'
0002B9r 2  F0 02                beq     @Bad
0002BBr 2  38                   sec
0002BCr 2  60                   rts
0002BDr 2               @Bad:
0002BDr 2  18                   clc
0002BEr 2  60                   rts
0002BFr 2               
0002BFr 2               ; =============================================================================
0002BFr 2               ;   B a s M a t c h K e y w o r d
0002BFr 2               ; =============================================================================
0002BFr 2               ; Try to match a keyword from KeywordTbl starting at BAS_LINBUF,X.
0002BFr 2               ;
0002BFr 2               ; On match  : carry SET, A = token byte, X advanced past the matched
0002BFr 2               ;             keyword characters in BAS_LINBUF.
0002BFr 2               ; On miss   : carry CLEAR, X unchanged, A = original character at LINBUF,X.
0002BFr 2               ;
0002BFr 2               ; Match algorithm:
0002BFr 2               ;   - Walk KeywordTbl, comparing characters (folding LINBUF lowercase to
0002BFr 2               ;     uppercase) to each keyword in turn.  A keyword's last byte has bit 7
0002BFr 2               ;     set; the byte after the table's final keyword is $00.
0002BFr 2               ;   - Token value = TOK_BASE + (index of keyword in table).
0002BFr 2               ; =============================================================================
0002BFr 2               BasMatchKeyword:
0002BFr 2                       ; Save initial X for rollback on miss; preserve caller's Y (BasCrunch
0002BFr 2                       ; uses Y as the TOKBUF destination index).
0002BFr 2  86 3E                stx     BAS_TMP3
0002C1r 2  5A                   phy
0002C2r 2                       ; Walk the keyword table via a 16-bit ZP pointer (BAS_KWPTR), since
0002C2r 2                       ; the table is larger than 256 bytes.  Y is held at 0 throughout and
0002C2r 2                       ; we advance BAS_KWPTR byte-by-byte instead of relying on Y.
0002C2r 2  A9 rr                lda     #<KeywordTbl
0002C4r 2  85 61                sta     BAS_KWPTR
0002C6r 2  A9 rr                lda     #>KeywordTbl
0002C8r 2  85 62                sta     BAS_KWPTR+1
0002CAr 2  A9 80                lda     #TOK_BASE
0002CCr 2  85 3A                sta     BAS_TMP1                ; current candidate token
0002CEr 2  A0 00                ldy     #0
0002D0r 2               @KeywordLoop:
0002D0r 2                       ; Restore X to start of input keyword.
0002D0r 2  A6 3E                ldx     BAS_TMP3
0002D2r 2               @CharLoop:
0002D2r 2  B1 61                lda     (BAS_KWPTR),y           ; Y == 0
0002D4r 2  F0 3B                beq     @NoMatch                ; reached table terminator
0002D6r 2  48                   pha
0002D7r 2  29 7F                and     #$7F
0002D9r 2  85 3C                sta     BAS_TMP2                ; expected char (uppercase)
0002DBr 2                       ; Read input char and uppercase it.
0002DBr 2  BD 00 04             lda     BAS_LINBUF,x
0002DEr 2  C9 61                cmp     #'a'
0002E0r 2  90 06                bcc     @InpCmp
0002E2r 2  C9 7B                cmp     #'z'+1
0002E4r 2  B0 02                bcs     @InpCmp
0002E6r 2  29 DF                and     #$DF
0002E8r 2               @InpCmp:
0002E8r 2  C5 3C                cmp     BAS_TMP2
0002EAr 2  D0 0C                bne     @CharMismatch
0002ECr 2  68                   pla                             ; restore raw table byte
0002EDr 2                       ; Match - is this the last char of the keyword?
0002EDr 2  30 1C                bmi     @WholeMatch             ; bit 7 set -> full keyword matched
0002EFr 2                       ; Advance both pointers and continue.
0002EFr 2  E6 61                inc     BAS_KWPTR
0002F1r 2  D0 02                bne     @CharNoCarry
0002F3r 2  E6 62                inc     BAS_KWPTR+1
0002F5r 2               @CharNoCarry:
0002F5r 2  E8                   inx
0002F6r 2  80 DA                bra     @CharLoop
0002F8r 2               
0002F8r 2               @CharMismatch:
0002F8r 2  68                   pla
0002F9r 2                       ; Skip ahead to start of next keyword in table.  Walk byte-by-byte
0002F9r 2                       ; until we consume a byte with bit 7 set (last char of this keyword)
0002F9r 2                       ; or hit the $00 terminator.
0002F9r 2               @SkipKeyword:
0002F9r 2  B1 61                lda     (BAS_KWPTR),y           ; Y == 0
0002FBr 2  F0 14                beq     @NoMatch                ; hit table terminator
0002FDr 2  E6 61                inc     BAS_KWPTR
0002FFr 2  D0 02                bne     @SkipNoCarry
000301r 2  E6 62                inc     BAS_KWPTR+1
000303r 2               @SkipNoCarry:
000303r 2  C9 80                cmp     #$80                    ; carry set iff loaded byte >= $80
000305r 2  90 F2                bcc     @SkipKeyword
000307r 2                       ; Fall through: byte had bit 7 set => end of keyword.
000307r 2               @AdvanceTok:
000307r 2  E6 3A                inc     BAS_TMP1
000309r 2  80 C5                bra     @KeywordLoop
00030Br 2               
00030Br 2               @WholeMatch:
00030Br 2                       ; X points at the LAST matched char in input; advance past it.
00030Br 2  E8                   inx
00030Cr 2  A5 3A                lda     BAS_TMP1
00030Er 2  7A                   ply                             ; restore caller's Y
00030Fr 2  38                   sec
000310r 2  60                   rts
000311r 2               
000311r 2               @NoMatch:
000311r 2  A6 3E                ldx     BAS_TMP3                ; restore caller's X
000313r 2  7A                   ply                             ; restore caller's Y
000314r 2  BD 00 04             lda     BAS_LINBUF,x
000317r 2  18                   clc
000318r 2  60                   rts
000319r 2               
000319r 2               ; =============================================================================
000319r 2               ;   B a s S t o r e L i n e
000319r 2               ; =============================================================================
000319r 2               ; Insert or replace BAS_LINNUM in the program with the tokenized payload in
000319r 2               ; BAS_TOKBUF.  If BAS_TOKBUF is empty, delete the existing line.
000319r 2               ;
000319r 2               ; Algorithm:
000319r 2               ;   1. Find existing line number (or insertion point).
000319r 2               ;   2. If exact match, delete that line (close the gap, decrement VARTAB).
000319r 2               ;   3. If payload non-empty, splice in [next][num][payload][$00].
000319r 2               ;   4. Relink all next-pointers.
000319r 2               ; =============================================================================
000319r 2               BasStoreLine:
000319r 2                       ; Locate insertion point.  BAS_INDEX <- pointer; carry set = exact match.
000319r 2  20 rr rr             jsr     BasFindLine
00031Cr 2               
00031Cr 2  90 03                bcc     @NoExisting
00031Er 2                       ; Line exists - delete it first.
00031Er 2  20 rr rr             jsr     BasDeleteAtIndex
000321r 2               @NoExisting:
000321r 2                       ; If tokbuf is empty, we're done (delete-only operation).
000321r 2  AD 00 05             lda     BAS_TOKBUF
000324r 2  D0 04                bne     @InsertNew
000326r 2  20 rr rr             jsr     BasRelink
000329r 2  60                   rts
00032Ar 2               
00032Ar 2               @InsertNew:
00032Ar 2  20 rr rr             jsr     BasInsertAtIndex
00032Dr 2  90 04                bcc     @NoMem
00032Fr 2  20 rr rr             jsr     BasRelink
000332r 2  60                   rts
000333r 2               @NoMem:
000333r 2  A9 02                lda     #ERR_OUTOFMEM
000335r 2  4C rr rr             jmp     BasError
000338r 2               
000338r 2               ; =============================================================================
000338r 2               ;   B a s F i n d L i n e
000338r 2               ; =============================================================================
000338r 2               ; Locate BAS_LINNUM in the program list.
000338r 2               ;
000338r 2               ; On entry : BAS_LINNUM = target line number.
000338r 2               ; On exit  : BAS_INDEX = pointer to start of either the matching line or the
000338r 2               ;            first line whose number > target (or end-marker).
000338r 2               ;            Carry SET if exact match, CLEAR otherwise.
000338r 2               ; =============================================================================
000338r 2               BasFindLine:
000338r 2  AD 5D 03             lda     BAS_TXTTAB
00033Br 2  85 20                sta     BAS_INDEX
00033Dr 2  AD 5E 03             lda     BAS_TXTTAB+1
000340r 2  85 21                sta     BAS_INDEX+1
000342r 2               @Loop:
000342r 2  A0 01                ldy     #1
000344r 2  B1 20                lda     (BAS_INDEX),y
000346r 2  F0 25                beq     @NotFound               ; end-marker (next-hi = 0)
000348r 2               
000348r 2                       ; Compare line numbers: (INDEX+2/+3) vs LINNUM.
000348r 2  A0 03                ldy     #3
00034Ar 2  B1 20                lda     (BAS_INDEX),y
00034Cr 2  C5 09                cmp     BAS_LINNUM+1
00034Er 2  90 0D                bcc     @Advance                ; line < target
000350r 2  D0 1B                bne     @TooHigh                ; line > target -> insertion point
000352r 2  88                   dey
000353r 2  B1 20                lda     (BAS_INDEX),y
000355r 2  C5 08                cmp     BAS_LINNUM
000357r 2  90 04                bcc     @Advance
000359r 2  D0 12                bne     @TooHigh
00035Br 2                       ; Exact match.
00035Br 2  38                   sec
00035Cr 2  60                   rts
00035Dr 2               
00035Dr 2               @Advance:
00035Dr 2                       ; Follow next-pointer.
00035Dr 2  A0 00                ldy     #0
00035Fr 2  B1 20                lda     (BAS_INDEX),y
000361r 2  48                   pha
000362r 2  A0 01                ldy     #1
000364r 2  B1 20                lda     (BAS_INDEX),y
000366r 2  85 21                sta     BAS_INDEX+1
000368r 2  68                   pla
000369r 2  85 20                sta     BAS_INDEX
00036Br 2  80 D5                bra     @Loop
00036Dr 2               
00036Dr 2               @NotFound:
00036Dr 2               @TooHigh:
00036Dr 2  18                   clc
00036Er 2  60                   rts
00036Fr 2               
00036Fr 2               ; =============================================================================
00036Fr 2               ;   B a s D e l e t e A t I n d e x
00036Fr 2               ; =============================================================================
00036Fr 2               ; Delete the line whose start is at BAS_INDEX.
00036Fr 2               ; Closes the gap by copying [next-line .. VARTAB-1] down to (BAS_INDEX...)
00036Fr 2               ; and decrements VARTAB by the deleted size.
00036Fr 2               ; =============================================================================
00036Fr 2               BasDeleteAtIndex:
00036Fr 2                       ; BAS_TMP1 = next-line address (read from current line's next ptr).
00036Fr 2  A0 00                ldy     #0
000371r 2  B1 20                lda     (BAS_INDEX),y
000373r 2  85 3A                sta     BAS_TMP1
000375r 2  C8                   iny
000376r 2  B1 20                lda     (BAS_INDEX),y
000378r 2  85 3B                sta     BAS_TMP1+1
00037Ar 2               
00037Ar 2                       ; gap-size = TMP1 - INDEX  (positive)
00037Ar 2                       ; Copy from TMP1 to INDEX, byte by byte, until TMP1 reaches VARTAB.
00037Ar 2                       ; BAS_DEST = INDEX (write cursor); BAS_TMP2 = src cursor (= TMP1).
00037Ar 2  A5 20                lda     BAS_INDEX
00037Cr 2  85 22                sta     BAS_DEST
00037Er 2  A5 21                lda     BAS_INDEX+1
000380r 2  85 23                sta     BAS_DEST+1
000382r 2               
000382r 2               @CopyLoop:
000382r 2                       ; Done when TMP1 == VARTAB.
000382r 2  A5 3A                lda     BAS_TMP1
000384r 2  CD 5F 03             cmp     BAS_VARTAB
000387r 2  A5 3B                lda     BAS_TMP1+1
000389r 2  ED 60 03             sbc     BAS_VARTAB+1
00038Cr 2  B0 14                bcs     @CopyDone
00038Er 2               
00038Er 2  A0 00                ldy     #0
000390r 2  B1 3A                lda     (BAS_TMP1),y
000392r 2  91 22                sta     (BAS_DEST),y
000394r 2               
000394r 2  E6 3A                inc     BAS_TMP1
000396r 2  D0 02                bne     @IncDest
000398r 2  E6 3B                inc     BAS_TMP1+1
00039Ar 2               @IncDest:
00039Ar 2  E6 22                inc     BAS_DEST
00039Cr 2  D0 E4                bne     @CopyLoop
00039Er 2  E6 23                inc     BAS_DEST+1
0003A0r 2  80 E0                bra     @CopyLoop
0003A2r 2               
0003A2r 2               @CopyDone:
0003A2r 2                       ; VARTAB = DEST.
0003A2r 2  A5 22                lda     BAS_DEST
0003A4r 2  8D 5F 03             sta     BAS_VARTAB
0003A7r 2  A5 23                lda     BAS_DEST+1
0003A9r 2  8D 60 03             sta     BAS_VARTAB+1
0003ACr 2                       ; Mirror to ARYTAB/STREND (vars/arrays empty after edit; keep them
0003ACr 2                       ; tracking VARTAB).
0003ACr 2  8D 62 03             sta     BAS_ARYTAB+1
0003AFr 2  8D 64 03             sta     BAS_STREND+1
0003B2r 2  AD 5F 03             lda     BAS_VARTAB
0003B5r 2  8D 61 03             sta     BAS_ARYTAB
0003B8r 2  8D 63 03             sta     BAS_STREND
0003BBr 2  60                   rts
0003BCr 2               
0003BCr 2               ; =============================================================================
0003BCr 2               ;   B a s I n s e r t A t I n d e x
0003BCr 2               ; =============================================================================
0003BCr 2               ; Splice a new line ([next-placeholder][num-lo][num-hi][payload][$00]) in
0003BCr 2               ; at BAS_INDEX, shifting following bytes upward.
0003BCr 2               ;
0003BCr 2               ; On entry : BAS_INDEX = insertion address, BAS_LINNUM = line number,
0003BCr 2               ;            BAS_TOKBUF = NUL-terminated payload (non-empty).
0003BCr 2               ; On exit  : Carry SET on success, CLEAR if not enough memory.
0003BCr 2               ;            VARTAB / ARYTAB / STREND advanced to new end-of-program.
0003BCr 2               ; =============================================================================
0003BCr 2               BasInsertAtIndex:
0003BCr 2                       ; Compute payload length L (excluding NUL): scan TOKBUF.
0003BCr 2  A0 00                ldy     #0
0003BEr 2               @LenScan:
0003BEr 2  B9 00 05             lda     BAS_TOKBUF,y
0003C1r 2  F0 03                beq     @LenDone
0003C3r 2  C8                   iny
0003C4r 2  D0 F8                bne     @LenScan
0003C6r 2               @LenDone:
0003C6r 2                       ; Total line size = 4 (header) + L + 1 (terminator) = L + 5.
0003C6r 2                       ; Store size in BAS_TMP3 (assumes <= 250+5 = 255, fits in one byte).
0003C6r 2  98                   tya
0003C7r 2  18                   clc
0003C8r 2  69 05                adc     #5
0003CAr 2  85 3E                sta     BAS_TMP3                ; line size in bytes (<=255)
0003CCr 2               
0003CCr 2                       ; Memory check: VARTAB + size <= MEMSIZ.
0003CCr 2  18                   clc
0003CDr 2  AD 5F 03             lda     BAS_VARTAB
0003D0r 2  65 3E                adc     BAS_TMP3
0003D2r 2  85 3A                sta     BAS_TMP1
0003D4r 2  AD 60 03             lda     BAS_VARTAB+1
0003D7r 2  69 00                adc     #0
0003D9r 2  85 3B                sta     BAS_TMP1+1
0003DBr 2  A5 3A                lda     BAS_TMP1
0003DDr 2  CD 67 03             cmp     BAS_MEMSIZ
0003E0r 2  A5 3B                lda     BAS_TMP1+1
0003E2r 2  ED 68 03             sbc     BAS_MEMSIZ+1
0003E5r 2  90 02                bcc     @SizeOK
0003E7r 2  18                   clc                             ; out of memory
0003E8r 2  60                   rts
0003E9r 2               @SizeOK:
0003E9r 2                       ; Shift bytes [INDEX .. VARTAB-1] up by TMP3.
0003E9r 2                       ; Copy from high-to-low to avoid overlap clobber.
0003E9r 2                       ; src  = VARTAB-1
0003E9r 2                       ; dst  = VARTAB-1 + TMP3
0003E9r 2  AD 5F 03             lda     BAS_VARTAB
0003ECr 2  38                   sec
0003EDr 2  E9 01                sbc     #1
0003EFr 2  85 3A                sta     BAS_TMP1                ; src
0003F1r 2  AD 60 03             lda     BAS_VARTAB+1
0003F4r 2  E9 00                sbc     #0
0003F6r 2  85 3B                sta     BAS_TMP1+1
0003F8r 2  18                   clc
0003F9r 2  A5 3A                lda     BAS_TMP1
0003FBr 2  65 3E                adc     BAS_TMP3
0003FDr 2  85 22                sta     BAS_DEST                ; dst
0003FFr 2  A5 3B                lda     BAS_TMP1+1
000401r 2  69 00                adc     #0
000403r 2  85 23                sta     BAS_DEST+1
000405r 2               @Shift:
000405r 2                       ; Stop when TMP1 < INDEX (i.e. INDEX-1 reached -> done).
000405r 2  A5 3A                lda     BAS_TMP1
000407r 2  C5 20                cmp     BAS_INDEX
000409r 2  A5 3B                lda     BAS_TMP1+1
00040Br 2  E5 21                sbc     BAS_INDEX+1
00040Dr 2  90 18                bcc     @ShiftDone
00040Fr 2               
00040Fr 2  A0 00                ldy     #0
000411r 2  B1 3A                lda     (BAS_TMP1),y
000413r 2  91 22                sta     (BAS_DEST),y
000415r 2               
000415r 2                       ; dec TMP1
000415r 2  A5 3A                lda     BAS_TMP1
000417r 2  D0 02                bne     @T1NoBorrow
000419r 2  C6 3B                dec     BAS_TMP1+1
00041Br 2               @T1NoBorrow:
00041Br 2  C6 3A                dec     BAS_TMP1
00041Dr 2                       ; dec DEST
00041Dr 2  A5 22                lda     BAS_DEST
00041Fr 2  D0 02                bne     @DNoBorrow
000421r 2  C6 23                dec     BAS_DEST+1
000423r 2               @DNoBorrow:
000423r 2  C6 22                dec     BAS_DEST
000425r 2  80 DE                bra     @Shift
000427r 2               
000427r 2               @ShiftDone:
000427r 2                       ; Write new line header at BAS_INDEX.
000427r 2  A0 00                ldy     #0
000429r 2  A9 FF                lda     #$FF                    ; placeholder next-ptr (Relink fixes)
00042Br 2  91 20                sta     (BAS_INDEX),y
00042Dr 2  C8                   iny
00042Er 2  91 20                sta     (BAS_INDEX),y
000430r 2  C8                   iny
000431r 2  A5 08                lda     BAS_LINNUM
000433r 2  91 20                sta     (BAS_INDEX),y
000435r 2  C8                   iny
000436r 2  A5 09                lda     BAS_LINNUM+1
000438r 2  91 20                sta     (BAS_INDEX),y
00043Ar 2  C8                   iny
00043Br 2               
00043Br 2                       ; Copy payload from BAS_TOKBUF (NUL terminator included).
00043Br 2  A2 00                ldx     #0
00043Dr 2               @PayloadCopy:
00043Dr 2  BD 00 05             lda     BAS_TOKBUF,x
000440r 2  91 20                sta     (BAS_INDEX),y
000442r 2  F0 04                beq     @PayloadDone
000444r 2  E8                   inx
000445r 2  C8                   iny
000446r 2  80 F5                bra     @PayloadCopy
000448r 2               @PayloadDone:
000448r 2                       ; Update VARTAB.
000448r 2  18                   clc
000449r 2  AD 5F 03             lda     BAS_VARTAB
00044Cr 2  65 3E                adc     BAS_TMP3
00044Er 2  8D 5F 03             sta     BAS_VARTAB
000451r 2  AD 60 03             lda     BAS_VARTAB+1
000454r 2  69 00                adc     #0
000456r 2  8D 60 03             sta     BAS_VARTAB+1
000459r 2                       ; Mirror to ARYTAB/STREND.
000459r 2  AD 5F 03             lda     BAS_VARTAB
00045Cr 2  8D 61 03             sta     BAS_ARYTAB
00045Fr 2  8D 63 03             sta     BAS_STREND
000462r 2  AD 60 03             lda     BAS_VARTAB+1
000465r 2  8D 62 03             sta     BAS_ARYTAB+1
000468r 2  8D 64 03             sta     BAS_STREND+1
00046Br 2               
00046Br 2  38                   sec
00046Cr 2  60                   rts
00046Dr 2               
00046Dr 2               ; =============================================================================
00046Dr 2               ;   B a s R e l i n k
00046Dr 2               ; =============================================================================
00046Dr 2               ; Walk the program list and rewrite every next-pointer to the address of
00046Dr 2               ; the following line (computed by scanning forward to the line's NUL
00046Dr 2               ; terminator).  Stops when a next-pointer's high byte is already 0
00046Dr 2               ; (the [00][00] end-marker, which is left untouched).
00046Dr 2               ; =============================================================================
00046Dr 2               BasRelink:
00046Dr 2  AD 5D 03             lda     BAS_TXTTAB
000470r 2  85 20                sta     BAS_INDEX
000472r 2  AD 5E 03             lda     BAS_TXTTAB+1
000475r 2  85 21                sta     BAS_INDEX+1
000477r 2               @Loop:
000477r 2  A0 01                ldy     #1
000479r 2  B1 20                lda     (BAS_INDEX),y
00047Br 2  F0 2B                beq     @Done                   ; end-marker reached
00047Dr 2               
00047Dr 2                       ; Find the NUL terminator at INDEX + Y for some Y >= 4.
00047Dr 2  A0 04                ldy     #4
00047Fr 2               @Scan:
00047Fr 2  B1 20                lda     (BAS_INDEX),y
000481r 2  F0 03                beq     @Found
000483r 2  C8                   iny
000484r 2  D0 F9                bne     @Scan
000486r 2               @Found:
000486r 2  C8                   iny                             ; one past NUL = next line address
000487r 2                       ; next = INDEX + Y
000487r 2  98                   tya
000488r 2  18                   clc
000489r 2  65 20                adc     BAS_INDEX
00048Br 2  85 3A                sta     BAS_TMP1
00048Dr 2  A5 21                lda     BAS_INDEX+1
00048Fr 2  69 00                adc     #0
000491r 2  85 3B                sta     BAS_TMP1+1
000493r 2               
000493r 2                       ; Write new next-pointer at (INDEX),0/1.
000493r 2  A0 00                ldy     #0
000495r 2  A5 3A                lda     BAS_TMP1
000497r 2  91 20                sta     (BAS_INDEX),y
000499r 2  C8                   iny
00049Ar 2  A5 3B                lda     BAS_TMP1+1
00049Cr 2  91 20                sta     (BAS_INDEX),y
00049Er 2               
00049Er 2                       ; Advance INDEX = TMP1.
00049Er 2  A5 3A                lda     BAS_TMP1
0004A0r 2  85 20                sta     BAS_INDEX
0004A2r 2  A5 3B                lda     BAS_TMP1+1
0004A4r 2  85 21                sta     BAS_INDEX+1
0004A6r 2  80 CF                bra     @Loop
0004A8r 2               @Done:
0004A8r 2  60                   rts
0004A9r 2               
0004A9r 2               ; =============================================================================
0004A9r 2               ;   B a s D i s p a t c h I m m e d i a t e
0004A9r 2               ; =============================================================================
0004A9r 2               ; Execute a tokenized line (BAS_TOKBUF) in immediate mode by entering the
0004A9r 2               ; statement loop (BasNewstt) with TXTPTR pointing one byte before the first
0004A9r 2               ; tokenized byte.  Re-anchors the CPU stack so that FOR / GOSUB frames
0004A9r 2               ; stored on the stack can be located by the scanners.
0004A9r 2               ; =============================================================================
0004A9r 2               BasDispatchImmediate:
0004A9r 2                       ; Write a ':' sentinel just before BAS_TOKBUF so NEWSTT's initial
0004A9r 2                       ; (TXTPTR),y read takes the @nextStmt path and CHRGETs the first token.
0004A9r 2  A9 3A                lda     #':'
0004ABr 2  8D FF 04             sta     BAS_TOKBUF-1
0004AEr 2  A9 FF                lda     #<(BAS_TOKBUF-1)
0004B0r 2  85 04                sta     TXTPTR
0004B2r 2  A9 04                lda     #>(BAS_TOKBUF-1)
0004B4r 2  85 05                sta     TXTPTR+1
0004B6r 2  9C 70 03             stz     BAS_POSX
0004B9r 2                       ; Direct mode: CURLIN = $FFFF (msbasic convention).
0004B9r 2  A9 FF                lda     #$FF
0004BBr 2  8D 69 03             sta     BAS_CURLIN
0004BEr 2  8D 6A 03             sta     BAS_CURLIN+1
0004C1r 2                       ; Reset CPU stack so FOR / GOSUB frame scanners have a clean baseline.
0004C1r 2  A2 FF                ldx     #$FF
0004C3r 2  9A                   txs
0004C4r 2  4C rr rr             jmp     BasNewstt
0004C7r 2               
0004C7r 2               ; =============================================================================
0004C7r 2               ;   B a s C m d N e w
0004C7r 2               ; =============================================================================
0004C7r 2               ; Reset program storage to empty: write [00][00] at $0800 and reset the
0004C7r 2               ; runtime pointers.
0004C7r 2               ; =============================================================================
0004C7r 2               BasCmdNew:
0004C7r 2  9C 00 08             stz     BAS_PRG_START
0004CAr 2  9C 01 08             stz     BAS_PRG_START+1
0004CDr 2  A9 02                lda     #<(BAS_PRG_START+2)
0004CFr 2  8D 5F 03             sta     BAS_VARTAB
0004D2r 2  8D 61 03             sta     BAS_ARYTAB
0004D5r 2  8D 63 03             sta     BAS_STREND
0004D8r 2  A9 08                lda     #>(BAS_PRG_START+2)
0004DAr 2  8D 60 03             sta     BAS_VARTAB+1
0004DDr 2  8D 62 03             sta     BAS_ARYTAB+1
0004E0r 2  8D 64 03             sta     BAS_STREND+1
0004E3r 2  AD 67 03             lda     BAS_MEMSIZ
0004E6r 2  8D 65 03             sta     BAS_FRETOP
0004E9r 2  AD 68 03             lda     BAS_MEMSIZ+1
0004ECr 2  8D 66 03             sta     BAS_FRETOP+1
0004EFr 2  60                   rts
0004F0r 2               
0004F0r 2               ; =============================================================================
0004F0r 2               ;   B a s C m d L i s t
0004F0r 2               ; =============================================================================
0004F0r 2               ; Print every stored line in order.  Each line: decimal line number, single
0004F0r 2               ; space, detokenized payload, CRLF.
0004F0r 2               ; =============================================================================
0004F0r 2               BasCmdList:
0004F0r 2  AD 5D 03             lda     BAS_TXTTAB
0004F3r 2  85 20                sta     BAS_INDEX
0004F5r 2  AD 5E 03             lda     BAS_TXTTAB+1
0004F8r 2  85 21                sta     BAS_INDEX+1
0004FAr 2               @LineLoop:
0004FAr 2  A0 01                ldy     #1
0004FCr 2  B1 20                lda     (BAS_INDEX),y
0004FEr 2  F0 3D                beq     @Done                   ; end-marker
000500r 2                       ; Print line number.
000500r 2  A0 02                ldy     #2
000502r 2  B1 20                lda     (BAS_INDEX),y
000504r 2  85 08                sta     BAS_LINNUM
000506r 2  C8                   iny
000507r 2  B1 20                lda     (BAS_INDEX),y
000509r 2  85 09                sta     BAS_LINNUM+1
00050Br 2  20 rr rr             jsr     BasPrintLineNum
00050Er 2  A9 20                lda     #' '
000510r 2  20 rr rr             jsr     Chrout
000513r 2               
000513r 2                       ; Detokenize from offset 4 to the NUL terminator.
000513r 2  A0 04                ldy     #4
000515r 2               @DetokLoop:
000515r 2  B1 20                lda     (BAS_INDEX),y
000517r 2  F0 12                beq     @LineEnd
000519r 2  30 06                bmi     @Token
00051Br 2  20 rr rr             jsr     Chrout
00051Er 2  C8                   iny
00051Fr 2  80 F4                bra     @DetokLoop
000521r 2               @Token:
000521r 2  84 42                sty     BAS_DETOKY
000523r 2  20 rr rr             jsr     BasPrintKeyword         ; preserves nothing useful
000526r 2  A4 42                ldy     BAS_DETOKY
000528r 2  C8                   iny
000529r 2  80 EA                bra     @DetokLoop
00052Br 2               @LineEnd:
00052Br 2  20 rr rr             jsr     BasPrintCRLF
00052Er 2                       ; Advance INDEX via next-pointer.
00052Er 2  A0 00                ldy     #0
000530r 2  B1 20                lda     (BAS_INDEX),y
000532r 2  48                   pha
000533r 2  C8                   iny
000534r 2  B1 20                lda     (BAS_INDEX),y
000536r 2  85 21                sta     BAS_INDEX+1
000538r 2  68                   pla
000539r 2  85 20                sta     BAS_INDEX
00053Br 2  80 BD                bra     @LineLoop
00053Dr 2               @Done:
00053Dr 2  60                   rts
00053Er 2               
00053Er 2               ; =============================================================================
00053Er 2               ;   B a s P r i n t L i n e N u m
00053Er 2               ; =============================================================================
00053Er 2               ; Print BAS_LINNUM (16-bit unsigned) as decimal (no leading zeros, no sign).
00053Er 2               ; Thin shim over the KERNAL PrintDecU16 ($A096); the decimal-print core now
00053Er 2               ; lives once in the KERNAL (shared with FsPrintSize).
00053Er 2               ; Clobbers : A, X, Y, FS_FILE_SIZE, FS_DIR_IDX.
00053Er 2               ; =============================================================================
00053Er 2               BasPrintLineNum:
00053Er 2  A5 08                lda     BAS_LINNUM
000540r 2  A6 09                ldx     BAS_LINNUM+1
000542r 2  4C rr rr             jmp     PrintDecU16
000545r 2               
000545r 2               ; =============================================================================
000545r 2               ;   B a s C m d P r i n t
000545r 2               ; =============================================================================
000545r 2               ; Immediate-mode PRINT.  X on entry = offset into BAS_TOKBUF where the
000545r 2               ; PRINT token sits.  Items separated by ';' (no separator) or ',' (advance
000545r 2               ; to next 14-column print zone).  Trailing ';' or ',' suppresses CRLF.
000545r 2               ;
000545r 2               ; Special-cased token: HEX(n) -> emit "$XXXX" hex form (does not call
000545r 2               ; FrmEvl; consumes the token + parens here).
000545r 2               ; =============================================================================
000545r 2               BasCmdPrint:
000545r 2                       ; TXTPTR is positioned with ChrGot returning TOK_PRINT.  Advance
000545r 2                       ; past the token; col counter is reset by the dispatcher's outer loop.
000545r 2  20 rr rr             jsr     ChrGet                  ; consume PRINT token
000548r 2               
000548r 2               BasPrLoop:
000548r 2  20 rr rr             jsr     ChrGot
00054Br 2  D0 03 4C rr          jeq     BasPrEndNl
00054Fr 2  rr           
000550r 2  C9 3A                cmp     #':'
000552r 2  D0 03 4C rr          jeq     BasPrEndNl
000556r 2  rr           
000557r 2  C9 A4                cmp     #TOK_ELSE
000559r 2  D0 03 4C rr          jeq     BasPrEndNl
00055Dr 2  rr           
00055Er 2  C9 3B                cmp     #';'
000560r 2  D0 03 4C rr          jeq     BasPrSep
000564r 2  rr           
000565r 2  C9 2C                cmp     #','
000567r 2  D0 03 4C rr          jeq     BasPrComma
00056Br 2  rr           
00056Cr 2  C9 CE                cmp     #TOK_HEX
00056Er 2  D0 17                bne     @chkTab
000570r 2                       ; HEX(n) in PRINT context: emit "$XXXX".
000570r 2  20 rr rr             jsr     ChrGet                  ; consume HEX
000573r 2  20 rr rr             jsr     ChkOpn
000576r 2  20 rr rr             jsr     FrmEvl
000579r 2  20 rr rr             jsr     ChkNum
00057Cr 2  20 rr rr             jsr     ChkCls
00057Fr 2  20 rr rr             jsr     AyInt
000582r 2  20 rr rr             jsr     PrintHex16
000585r 2  80 6A                bra     BasPrAfter
000587r 2               @chkTab:
000587r 2  C9 9B                cmp     #TOK_TAB
000589r 2  D0 2D                bne     @chkSpc
00058Br 2  20 rr rr             jsr     ChrGet                  ; consume TAB
00058Er 2  20 rr rr             jsr     ChkOpn
000591r 2  20 rr rr             jsr     FrmNum
000594r 2  20 rr rr             jsr     ChkCls
000597r 2  20 rr rr             jsr     AyInt
00059Ar 2  A5 11                lda     FAC+3                   ; column count must fit in a byte
00059Cr 2  D0 53                bne     BasPrAfter
00059Er 2  A5 12                lda     FAC+4
0005A0r 2  CD 70 03             cmp     BAS_POSX
0005A3r 2  90 4C                bcc     BasPrAfter              ; already at/past target column
0005A5r 2  38                   sec
0005A6r 2  ED 70 03             sbc     BAS_POSX
0005A9r 2  A8                   tay
0005AAr 2  F0 45                beq     BasPrAfter
0005ACr 2               @tabLoop:
0005ACr 2  5A                   phy
0005ADr 2  A9 20                lda     #' '
0005AFr 2  20 rr rr             jsr     PrintCh
0005B2r 2  7A                   ply
0005B3r 2  88                   dey
0005B4r 2  D0 F6                bne     @tabLoop
0005B6r 2  80 39                bra     BasPrAfter
0005B8r 2               @chkSpc:
0005B8r 2  C9 9E                cmp     #TOK_SPC
0005BAr 2  D0 23                bne     @expr
0005BCr 2  20 rr rr             jsr     ChrGet                  ; consume SPC
0005BFr 2  20 rr rr             jsr     ChkOpn
0005C2r 2  20 rr rr             jsr     FrmNum
0005C5r 2  20 rr rr             jsr     ChkCls
0005C8r 2  20 rr rr             jsr     AyInt
0005CBr 2  A5 11                lda     FAC+3
0005CDr 2  D0 22                bne     BasPrAfter
0005CFr 2  A4 12                ldy     FAC+4
0005D1r 2  F0 1E                beq     BasPrAfter
0005D3r 2               @spcLoop:
0005D3r 2  5A                   phy
0005D4r 2  A9 20                lda     #' '
0005D6r 2  20 rr rr             jsr     PrintCh
0005D9r 2  7A                   ply
0005DAr 2  88                   dey
0005DBr 2  D0 F6                bne     @spcLoop
0005DDr 2  80 12                bra     BasPrAfter
0005DFr 2               @expr:
0005DFr 2  20 rr rr             jsr     FrmEvl
0005E2r 2  24 64                bit     VALTYP
0005E4r 2  30 05                bmi     @prStr
0005E6r 2  20 rr rr             jsr     PrintNum
0005E9r 2  80 06                bra     BasPrAfter
0005EBr 2               @prStr:
0005EBr 2  20 rr rr             jsr     PrintStrFAC
0005EEr 2  20 rr rr             jsr     FreFac
0005F1r 2               BasPrAfter:
0005F1r 2  20 rr rr             jsr     ChrGot
0005F4r 2  D0 03 4C rr          jeq     BasPrEndNl
0005F8r 2  rr           
0005F9r 2  C9 3A                cmp     #':'
0005FBr 2  D0 03 4C rr          jeq     BasPrEndNl
0005FFr 2  rr           
000600r 2  C9 A4                cmp     #TOK_ELSE
000602r 2  D0 03 4C rr          jeq     BasPrEndNl
000606r 2  rr           
000607r 2  C9 3B                cmp     #';'
000609r 2  D0 03 4C rr          jeq     BasPrSep
00060Dr 2  rr           
00060Er 2  C9 2C                cmp     #','
000610r 2  D0 03 4C rr          jeq     BasPrComma
000614r 2  rr           
000615r 2  4C rr rr             jmp     SynErr
000618r 2               BasPrSep:
000618r 2  20 rr rr             jsr     ChrGet                  ; consume ;
00061Br 2  20 rr rr             jsr     ChrGot
00061Er 2  F0 40                beq     BasPrEndNoNl            ; trailing ; -> no CRLF
000620r 2  C9 3A                cmp     #':'
000622r 2  F0 3C                beq     BasPrEndNoNl
000624r 2  4C rr rr             jmp     BasPrLoop
000627r 2               BasPrComma:
000627r 2  20 rr rr             jsr     ChrGet
00062Ar 2                       ; Pad to next multiple of 14 (MS-BASIC 14-column zone).
00062Ar 2                       ; col_mod = BAS_POSX mod 14; if 0 already at zone, else emit (14-col_mod) spaces.
00062Ar 2  AD 70 03             lda     BAS_POSX
00062Dr 2  85 3A                sta     BAS_TMP1
00062Fr 2               @modA:
00062Fr 2  A5 3A                lda     BAS_TMP1
000631r 2  C9 0E                cmp     #14
000633r 2  90 07                bcc     @modB
000635r 2  38                   sec
000636r 2  E9 0E                sbc     #14
000638r 2  85 3A                sta     BAS_TMP1
00063Ar 2  80 F3                bra     @modA
00063Cr 2               @modB:
00063Cr 2  C9 00                cmp     #0
00063Er 2  F0 0D                beq     @padDone
000640r 2               @padSp:
000640r 2  A9 20                lda     #' '
000642r 2  20 rr rr             jsr     PrintCh
000645r 2  E6 3A                inc     BAS_TMP1
000647r 2  A5 3A                lda     BAS_TMP1
000649r 2  C9 0E                cmp     #14
00064Br 2  D0 F3                bne     @padSp
00064Dr 2               @padDone:
00064Dr 2  20 rr rr             jsr     ChrGot
000650r 2  F0 0E                beq     BasPrEndNoNl
000652r 2  C9 3A                cmp     #':'
000654r 2  F0 0A                beq     BasPrEndNoNl
000656r 2  4C rr rr             jmp     BasPrLoop
000659r 2               BasPrEndNl:
000659r 2  20 rr rr             jsr     BasPrintCRLF
00065Cr 2  9C 70 03             stz     BAS_POSX
00065Fr 2  60                   rts
000660r 2               BasPrEndNoNl:
000660r 2  60                   rts
000661r 2               
000661r 2               ; ---------------------------------------------------------------------------
000661r 2               ; PrintCh -- emit A through Chrout, maintaining BAS_POSX (CR resets it).
000661r 2               ; ---------------------------------------------------------------------------
000661r 2               PrintCh:
000661r 2  C9 0D                cmp     #$0D
000663r 2  F0 0C                beq     @cr
000665r 2  C9 0A                cmp     #$0A
000667r 2  F0 08                beq     @cr
000669r 2  48                   pha
00066Ar 2  EE 70 03             inc     BAS_POSX
00066Dr 2  68                   pla
00066Er 2  4C rr rr             jmp     Chrout
000671r 2               @cr:
000671r 2  9C 70 03             stz     BAS_POSX
000674r 2  4C rr rr             jmp     Chrout
000677r 2               
000677r 2               ; ---------------------------------------------------------------------------
000677r 2               ; PrintNum -- emit FAC as ASCII via Fout, tracking column.
000677r 2               ; ---------------------------------------------------------------------------
000677r 2               PrintNum:
000677r 2  20 rr rr             jsr     Fout                    ; (Y,A) = NUL-terminated buffer
00067Ar 2  85 20                sta     INDEX
00067Cr 2  84 21                sty     INDEX+1
00067Er 2  A0 00                ldy     #0
000680r 2               @loop:
000680r 2  B1 20                lda     (INDEX),y
000682r 2  F0 06                beq     @done
000684r 2  20 rr rr             jsr     PrintCh
000687r 2  C8                   iny
000688r 2  D0 F6                bne     @loop
00068Ar 2               @done:
00068Ar 2  60                   rts
00068Br 2               
00068Br 2               ; ---------------------------------------------------------------------------
00068Br 2               ; PrintStrFAC -- emit string-descriptor at FAC..FAC+2.
00068Br 2               ; ---------------------------------------------------------------------------
00068Br 2               PrintStrFAC:
00068Br 2  A5 0F                lda     FAC+1
00068Dr 2  85 20                sta     INDEX
00068Fr 2  A5 10                lda     FAC+2
000691r 2  85 21                sta     INDEX+1
000693r 2  A0 00                ldy     #0
000695r 2               @loop:
000695r 2  C4 0E                cpy     FAC
000697r 2  F0 08                beq     @done
000699r 2  B1 20                lda     (INDEX),y
00069Br 2  20 rr rr             jsr     PrintCh
00069Er 2  C8                   iny
00069Fr 2  80 F4                bra     @loop
0006A1r 2               @done:
0006A1r 2  60                   rts
0006A2r 2               
0006A2r 2               ; ---------------------------------------------------------------------------
0006A2r 2               ; PrintHex16 -- emit FAC+3,FAC+4 (lo,hi) as "$XXXX".
0006A2r 2               ; ---------------------------------------------------------------------------
0006A2r 2               PrintHex16:
0006A2r 2  A9 24                lda     #'$'
0006A4r 2  20 rr rr             jsr     PrintCh
0006A7r 2  A5 11                lda     FAC+3
0006A9r 2  20 rr rr             jsr     PrintHexByte
0006ACr 2  A5 12                lda     FAC+4
0006AEr 2                       ; fall through
0006AEr 2               PrintHexByte:
0006AEr 2  48                   pha
0006AFr 2  4A                   lsr     a
0006B0r 2  4A                   lsr     a
0006B1r 2  4A                   lsr     a
0006B2r 2  4A                   lsr     a
0006B3r 2  20 rr rr             jsr     @nib
0006B6r 2  68                   pla
0006B7r 2  29 0F                and     #$0F
0006B9r 2               @nib:
0006B9r 2  C9 0A                cmp     #10
0006BBr 2  90 02                bcc     @dig
0006BDr 2  69 06                adc     #'A'-'9'-2              ; +'A'-10-1 (carry already set)
0006BFr 2               @dig:
0006BFr 2  69 30                adc     #'0'
0006C1r 2  4C rr rr             jmp     PrintCh
0006C4r 2               
0006C4r 2               ; =============================================================================
0006C4r 2               ;   B a s P r i n t K e y w o r d
0006C4r 2               ; =============================================================================
0006C4r 2               ; Print the keyword whose token byte is in A (bit 7 set).
0006C4r 2               ; Walks the keyword table to find entry (A - TOK_BASE) and prints its chars.
0006C4r 2               ; =============================================================================
0006C4r 2               BasPrintKeyword:
0006C4r 2  38                   sec
0006C5r 2  E9 80                sbc     #TOK_BASE               ; A = index
0006C7r 2  AA                   tax
0006C8r 2                       ; Walk via 16-bit BAS_KWPTR since the table is > 256 bytes.
0006C8r 2  A9 rr                lda     #<KeywordTbl
0006CAr 2  85 61                sta     BAS_KWPTR
0006CCr 2  A9 rr                lda     #>KeywordTbl
0006CEr 2  85 62                sta     BAS_KWPTR+1
0006D0r 2  A0 00                ldy     #0
0006D2r 2               @FindLoop:
0006D2r 2  E0 00                cpx     #0
0006D4r 2  F0 0F                beq     @PrintIt
0006D6r 2                       ; Skip current keyword: walk byte-by-byte until we consume a byte
0006D6r 2                       ; whose bit 7 is set (last char of the keyword).
0006D6r 2               @Skip:
0006D6r 2  B1 61                lda     (BAS_KWPTR),y           ; Y == 0
0006D8r 2  E6 61                inc     BAS_KWPTR
0006DAr 2  D0 02                bne     @SkipNoCarry
0006DCr 2  E6 62                inc     BAS_KWPTR+1
0006DEr 2               @SkipNoCarry:
0006DEr 2  C9 80                cmp     #$80                    ; C set iff loaded byte >= $80
0006E0r 2  90 F4                bcc     @Skip
0006E2r 2               @SkipEnd:
0006E2r 2  CA                   dex
0006E3r 2  80 ED                bra     @FindLoop
0006E5r 2               @PrintIt:
0006E5r 2               @PrintLoop:
0006E5r 2  B1 61                lda     (BAS_KWPTR),y           ; Y == 0
0006E7r 2  E6 61                inc     BAS_KWPTR
0006E9r 2  D0 02                bne     @PrintNoCarry
0006EBr 2  E6 62                inc     BAS_KWPTR+1
0006EDr 2               @PrintNoCarry:
0006EDr 2  48                   pha
0006EEr 2  29 7F                and     #$7F
0006F0r 2  20 rr rr             jsr     Chrout
0006F3r 2  68                   pla
0006F4r 2  10 EF                bpl     @PrintLoop
0006F6r 2  60                   rts
0006F7r 2               
0006F7r 2               ; =============================================================================
0006F7r 2               ;   E R R O R   H A N D L I N G
0006F7r 2               ; =============================================================================
0006F7r 2               
0006F7r 2               BasErrSyntax:
0006F7r 2  A9 00                lda     #ERR_SYNTAX
0006F9r 2                       ; fall through
0006F9r 2               
0006F9r 2               ; BasError - print "?<msg> ERROR[ IN nnnn]" and return to the REPL.
0006F9r 2               ;   Input: A = error code (index into ErrorMessages).
0006F9r 2               ;   Resets the stack, prints, and jumps to BasReadyLoop.
0006F9r 2               BasError:
0006F9r 2  85 3E                sta     BAS_TMP3                ; stash code (stack reset wipes A on stack)
0006FBr 2  A2 FF                ldx     #$FF
0006FDr 2  9A                   txs
0006FEr 2  20 rr rr             jsr     BasPrintCRLF
000701r 2  A9 3F                lda     #'?'
000703r 2  20 rr rr             jsr     Chrout
000706r 2  A5 3E                lda     BAS_TMP3
000708r 2                       ; A = error code; print the matching message.
000708r 2  20 rr rr             jsr     BasPrintErrorMsg
00070Br 2                       ; Append " ERROR" and (if not direct mode) line number.
00070Br 2  A9 rr                lda     #<MsgErrorWord
00070Dr 2  A0 rr                ldy     #>MsgErrorWord
00070Fr 2  20 rr rr             jsr     BasPrintStr
000712r 2  AD 6A 03             lda     BAS_CURLIN+1
000715r 2  C9 FF                cmp     #$FF
000717r 2  F0 14                beq     @NoLine
000719r 2  A9 rr                lda     #<MsgInWord
00071Br 2  A0 rr                ldy     #>MsgInWord
00071Dr 2  20 rr rr             jsr     BasPrintStr
000720r 2  AD 69 03             lda     BAS_CURLIN
000723r 2  85 08                sta     BAS_LINNUM
000725r 2  AD 6A 03             lda     BAS_CURLIN+1
000728r 2  85 09                sta     BAS_LINNUM+1
00072Ar 2  20 rr rr             jsr     BasPrintLineNum
00072Dr 2               @NoLine:
00072Dr 2                       ; Mark direct mode and bounce back to REPL.
00072Dr 2  A9 FF                lda     #$FF
00072Fr 2  8D 69 03             sta     BAS_CURLIN
000732r 2  8D 6A 03             sta     BAS_CURLIN+1
000735r 2  4C rr rr             jmp     BasReadyLoop
000738r 2               
000738r 2               ; BasPrintErrorMsg - print message #A from the error-message table.
000738r 2               ;   Each message is NUL-terminated; the table is a sequence of those.
000738r 2               BasPrintErrorMsg:
000738r 2  AA                   tax
000739r 2  A9 rr                lda     #<ErrorMessages
00073Br 2  85 3A                sta     BAS_TMP1
00073Dr 2  A9 rr                lda     #>ErrorMessages
00073Fr 2  85 3B                sta     BAS_TMP1+1
000741r 2               @Skip:
000741r 2  E0 00                cpx     #0
000743r 2  F0 17                beq     @Print
000745r 2                       ; Walk past one message (advance until NUL, then one more).
000745r 2               @SkipLoop:
000745r 2  A0 00                ldy     #0
000747r 2  B1 3A                lda     (BAS_TMP1),y
000749r 2  F0 08                beq     @SkipDone
00074Br 2  E6 3A                inc     BAS_TMP1
00074Dr 2  D0 F6                bne     @SkipLoop
00074Fr 2  E6 3B                inc     BAS_TMP1+1
000751r 2  80 F2                bra     @SkipLoop
000753r 2               @SkipDone:
000753r 2  E6 3A                inc     BAS_TMP1
000755r 2  D0 02                bne     @SkippedHi
000757r 2  E6 3B                inc     BAS_TMP1+1
000759r 2               @SkippedHi:
000759r 2  CA                   dex
00075Ar 2  80 E5                bra     @Skip
00075Cr 2               @Print:
00075Cr 2  A5 3A                lda     BAS_TMP1
00075Er 2  A4 3B                ldy     BAS_TMP1+1
000760r 2  4C rr rr             jmp     BasPrintStr
000763r 2               
000763r 2               
000763r 2               ; =============================================================================
000763r 2               ;   F L O A T I N G - P O I N T   R U N T I M E
000763r 2               ;
000763r 2               ;   Externals required by the inlined MSBASIC FP code:
000763r 2               ;     ChrGet   - advance TXTPTR and load next non-space tokenized char
000763r 2               ;                (used by Fin; never exercised by the FP tests).
000763r 2               ;     BasErrorVec    - error vector; X = error code
000763r 2               ;     IqErr    - "?ILLEGAL QUANTITY" entry
000763r 2               ;     STROUT   - print NUL-terminated string at (A=lo, Y=hi)
000763r 2               ;     QtIn    - the literal " IN " string (used only by InPrt)
000763r 2               ; =============================================================================
000763r 2               
000763r 2               ; --- ChrGet / ChrGot --------------------------------------------------------
000763r 2               ; Real implementation (ROM, not ZP self-modifying).  Increments TXTPTR and
000763r 2               ; returns the next non-space byte at (TXTPTR) in A, with carry CLEAR if the
000763r 2               ; byte is a digit '0'-'9'.  ChrGot re-reads the current byte without
000763r 2               ; advancing first.  Both clobber only A and flags.
000763r 2               ;
000763r 2               ; Side effects on flags after the routine returns:
000763r 2               ;   Z=1  if A == $00 or A is a tokenized/keyword byte that wraps to zero
000763r 2               ;        (used by callers checking end-of-statement).
000763r 2               ;   C=0  if A is a digit ('0'-'9'); else C=1.
000763r 2               ;
000763r 2               ; Implementation matches msbasic-master/chrget.s.
000763r 2               ChrGet:
000763r 2  E6 04                inc     TXTPTR
000765r 2  D0 02                bne     ChrGot
000767r 2  E6 05                inc     TXTPTR+1
000769r 2               ChrGot:
000769r 2  B2 04                lda     (TXTPTR)
00076Br 2  C9 3A                cmp     #':'
00076Dr 2  B0 0A                bcs     @out
00076Fr 2  C9 20                cmp     #' '
000771r 2  F0 F0                beq     ChrGet
000773r 2  38                   sec
000774r 2  E9 30                sbc     #'0'
000776r 2  38                   sec
000777r 2  E9 D0                sbc     #$D0                    ; restore A; sets C=0 iff digit
000779r 2               @out:
000779r 2  60                   rts
00077Ar 2               
00077Ar 2               ; --- Error trampolines ------------------------------------------------------
00077Ar 2               ; The MSBASIC convention is "ldx #code / jmp ERROR".  Our BasError takes
00077Ar 2               ; the code in A, so translate.
00077Ar 2               BasErrorVec:
00077Ar 2  8A                   txa
00077Br 2  4C rr rr             jmp     BasError
00077Er 2               
00077Er 2               IqErr:
00077Er 2  A2 0B                ldx     #ERR_ILLQUAN
000780r 2  4C rr rr             jmp     BasErrorVec
000783r 2               
000783r 2               ; --- String output ----------------------------------------------------------
000783r 2               ; FP code calls STROUT with (A=lo, Y=hi).  BasPrintStr matches that ABI.
000783r 2               STROUT          := BasPrintStr
000783r 2               
000783r 2               ; --- "IN " literal (referenced by InPrt) ----------------------------------
000783r 2               QtIn:
000783r 2  20 49 4E 20          .byte   " IN ",0
000787r 2  00           
000788r 2               
000788r 2               ; --- Shared RTS targets used by branches in the FP code --------------------
000788r 2               ; The original MSBASIC defines Rts3 in poke.s (which we don't include).
000788r 2               ; Provide a single shared RTS landing pad here.
000788r 2               Rts3:
000788r 2  60                   rts
000789r 2               
000789r 2               ; =============================================================================
000789r 2               ;   F L O A T I N G - P O I N T   R U N T I M E   ( P h a s e   2 )
000789r 2               ;
000789r 2               ;   Inline-ported from msbasic-master/{float,trig,rnd}.s.  Symbol aliases for
000789r 2               ;   FAC, ARG, INDEX, etc. are defined at the top of this file.  External hooks
000789r 2               ;   (ChrGet, BasErrorVec, IqErr, STROUT, QtIn) are stubbed below.
000789r 2               ; =============================================================================
000789r 2               
000789r 2               ; ===== from msbasic-master/float.s =====
000789r 2               ; (.segment removed - inlined into BASIC)
000789r 2               
000789r 2               TEMP1X = TEMP1+(5-BYTES_FP)
000789r 2               
000789r 2               ; ----------------------------------------------------------------------------
000789r 2               ; ADD 0.5 TO FAC
000789r 2               ; ----------------------------------------------------------------------------
000789r 2               FAddH:
000789r 2  A9 rr                lda     #<ConHalf
00078Br 2  A0 rr                ldy     #>ConHalf
00078Dr 2  4C rr rr             jmp     FAdd
000790r 2               
000790r 2               ; ----------------------------------------------------------------------------
000790r 2               ; FAC = (Y,A) - FAC
000790r 2               ; ----------------------------------------------------------------------------
000790r 2               FSub:
000790r 2  20 rr rr             jsr     LoadArgFromYa
000793r 2               
000793r 2               ; ----------------------------------------------------------------------------
000793r 2               ; FAC = ARG - FAC
000793r 2               ; ----------------------------------------------------------------------------
000793r 2               FSubT:
000793r 2  A5 13                lda     FACSIGN
000795r 2  49 FF                eor     #$FF
000797r 2  85 13                sta     FACSIGN
000799r 2  45 1B                eor     ARGSIGN
00079Br 2  85 1C                sta     SGNCPR
00079Dr 2  A5 0E                lda     FAC
00079Fr 2  4C rr rr             jmp     FAddT
0007A2r 2               
0007A2r 2               ; ----------------------------------------------------------------------------
0007A2r 2               ; Commodore BASIC V2 Easter Egg
0007A2r 2               ; ----------------------------------------------------------------------------
0007A2r 2               
0007A2r 2               ; ----------------------------------------------------------------------------
0007A2r 2               ; SHIFT SMALLER ARGUMENT MORE THAN 7 BITS
0007A2r 2               ; ----------------------------------------------------------------------------
0007A2r 2               FAdd1:
0007A2r 2  20 rr rr             jsr     ShiftRight
0007A5r 2  90 3C                bcc     FAdd3
0007A7r 2               
0007A7r 2               ; ----------------------------------------------------------------------------
0007A7r 2               ; FAC = (Y,A) + FAC
0007A7r 2               ; ----------------------------------------------------------------------------
0007A7r 2               FAdd:
0007A7r 2  20 rr rr             jsr     LoadArgFromYa
0007AAr 2               
0007AAr 2               ; ----------------------------------------------------------------------------
0007AAr 2               ; FAC = ARG + FAC
0007AAr 2               ; ----------------------------------------------------------------------------
0007AAr 2               FAddT:
0007AAr 2  D0 03                bne     Lbl365B
0007ACr 2  4C rr rr             jmp     CopyArgToFac
0007AFr 2               Lbl365B:
0007AFr 2  A6 1D                ldx     FACEXTENSION
0007B1r 2  86 43                stx     ARGEXTENSION
0007B3r 2  A2 16                ldx     #ARG
0007B5r 2  A5 16                lda     ARG
0007B7r 2               FAdd2:
0007B7r 2  A8                   tay
0007B8r 2  F0 CE                beq     Rts3
0007BAr 2  38                   sec
0007BBr 2  E5 0E                sbc     FAC
0007BDr 2  F0 24                beq     FAdd3
0007BFr 2  90 12                bcc     Lbl367F
0007C1r 2  84 0E                sty     FAC
0007C3r 2  A4 1B                ldy     ARGSIGN
0007C5r 2  84 13                sty     FACSIGN
0007C7r 2  49 FF                eor     #$FF
0007C9r 2  69 00                adc     #$00
0007CBr 2  A0 00                ldy     #$00
0007CDr 2  84 43                sty     ARGEXTENSION
0007CFr 2  A2 0E                ldx     #FAC
0007D1r 2  D0 04                bne     Lbl3683
0007D3r 2               Lbl367F:
0007D3r 2  A0 00                ldy     #$00
0007D5r 2  84 1D                sty     FACEXTENSION
0007D7r 2               Lbl3683:
0007D7r 2  C9 F9                cmp     #$F9
0007D9r 2  30 C7                bmi     FAdd1
0007DBr 2  A8                   tay
0007DCr 2  A5 1D                lda     FACEXTENSION
0007DEr 2  56 01                lsr     1,x
0007E0r 2  20 rr rr             jsr     ShiftRight4
0007E3r 2               FAdd3:
0007E3r 2  24 1C                bit     SGNCPR
0007E5r 2  10 57                bpl     FAdd4
0007E7r 2  A0 0E                ldy     #FAC
0007E9r 2  E0 16                cpx     #ARG
0007EBr 2  F0 02                beq     Lbl369B
0007EDr 2  A0 16                ldy     #ARG
0007EFr 2               Lbl369B:
0007EFr 2  38                   sec
0007F0r 2  49 FF                eor     #$FF
0007F2r 2  65 43                adc     ARGEXTENSION
0007F4r 2  85 1D                sta     FACEXTENSION
0007F6r 2  B9 04 00             lda     4,y
0007F9r 2  F5 04                sbc     4,x
0007FBr 2  85 12                sta     FAC+4
0007FDr 2  B9 03 00             lda     3,y
