00288Fr 2                       ; Compute reg = Hz<<4 + Hz - Hz/4
00288Fr 2  A5 12                lda     FAC+4
002891r 2  85 3A                sta     BAS_TMP1
002893r 2  A5 11                lda     FAC+3
002895r 2  85 3B                sta     BAS_TMP1+1
002897r 2  A5 3A                lda     BAS_TMP1
002899r 2  85 3C                sta     BAS_TMP2
00289Br 2  A5 3B                lda     BAS_TMP1+1
00289Dr 2  85 3D                sta     BAS_TMP2+1
00289Fr 2  A2 04                ldx     #4
0028A1r 2               @shl:
0028A1r 2  06 3A                asl     BAS_TMP1
0028A3r 2  26 3B                rol     BAS_TMP1+1
0028A5r 2  CA                   dex
0028A6r 2  D0 F9                bne     @shl
0028A8r 2  18                   clc
0028A9r 2  A5 3A                lda     BAS_TMP1
0028ABr 2  65 3C                adc     BAS_TMP2
0028ADr 2  85 3A                sta     BAS_TMP1
0028AFr 2  A5 3B                lda     BAS_TMP1+1
0028B1r 2  65 3D                adc     BAS_TMP2+1
0028B3r 2  85 3B                sta     BAS_TMP1+1
0028B5r 2  46 3D                lsr     BAS_TMP2+1
0028B7r 2  66 3C                ror     BAS_TMP2
0028B9r 2  46 3D                lsr     BAS_TMP2+1
0028BBr 2  66 3C                ror     BAS_TMP2
0028BDr 2  38                   sec
0028BEr 2  A5 3A                lda     BAS_TMP1
0028C0r 2  E5 3C                sbc     BAS_TMP2
0028C2r 2  48                   pha                             ; freqLo
0028C3r 2  A5 3B                lda     BAS_TMP1+1
0028C5r 2  E5 3D                sbc     BAS_TMP2+1
0028C7r 2  48                   pha                             ; freqHi
0028C8r 2  20 rr rr             jsr     ChkCom
0028CBr 2  20 rr rr             jsr     EvalU16                 ; dur in FAC+3/+4
0028CEr 2                       ; Stack (top-down): freqHi, freqLo, voice
0028CEr 2  7A                   ply                             ; Y = freqHi
