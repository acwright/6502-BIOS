001743r 2               .if 0
001743r 2               ; (Removed in Phase 8: _VARTEST debug harness lived here.)
001743r 2               VT_SetTxt:
001743r 2                       ; Set TXTPTR = VT_TXTPTR_TMP - 1 then ChrGet to load first char.
001743r 2                       ; Actually simpler: caller passes (Y,A) = pointer; we set TXTPTR =
001743r 2                       ; (Y,A) - 1 and call ChrGet to land on (Y,A).
001743r 2                       sta     TXTPTR
001743r 2                       sty     TXTPTR+1
001743r 2                       lda     TXTPTR
001743r 2                       bne     @nb
001743r 2                       dec     TXTPTR+1
001743r 2               @nb:
001743r 2                       dec     TXTPTR
001743r 2                       jmp     ChrGet
001743r 2               
001743r 2               VT_StoreFAC:
001743r 2                       ; Round and store FAC at (VARPNT).
001743r 2                       ldx     VARPNT
001743r 2                       ldy     VARPNT+1
001743r 2                       jmp     StoreFacAtYxRounded
001743r 2               
001743r 2               VT_LoadFAC:
001743r 2                       ; Load FAC from (VARPNT).
001743r 2                       lda     VARPNT
001743r 2                       ldy     VARPNT+1
001743r 2                       jmp     LoadFacFromYa
001743r 2               
001743r 2               VT_VPSAVE       = $86           ; 2-byte ZP VARPNT save (_VARTEST debug)
001743r 2               
001743r 2               BasCmdVarTest:
001743r 2                       jsr     BasCmdClr
001743r 2               
001743r 2                       ; --- Test 1: A=3.14, B=A*2 ---
001743r 2                       lda     #<VT_NameA
001743r 2                       ldy     #>VT_NameA
001743r 2                       jsr     VT_SetTxt
001743r 2                       jsr     PtrGet                  ; creates A; VARPNT -> A's value
001743r 2                       ; FAC = 3.14
001743r 2                       lda     #<VT_pi
001743r 2                       ldy     #>VT_pi
001743r 2                       jsr     LoadFacFromYa
001743r 2                       jsr     VT_StoreFAC
001743r 2               
001743r 2                       lda     #<VT_NameB
001743r 2                       ldy     #>VT_NameB
001743r 2                       jsr     VT_SetTxt
001743r 2                       jsr     PtrGet                  ; creates B
001743r 2                       ; Save B's VARPNT.
001743r 2                       lda     VARPNT
001743r 2                       sta     VT_VPSAVE
001743r 2                       lda     VARPNT+1
001743r 2                       sta     VT_VPSAVE+1
001743r 2               
001743r 2                       ; Look up A again (already exists).
001743r 2                       lda     #<VT_NameA
001743r 2                       ldy     #>VT_NameA
001743r 2                       jsr     VT_SetTxt
001743r 2                       jsr     PtrGet
001743r 2                       jsr     VT_LoadFAC              ; FAC = A = 3.14
001743r 2                       ; Multiply by 2.
001743r 2                       lda     #<FpC2
001743r 2                       ldy     #>FpC2
001743r 2                       jsr     FMult                   ; FAC = 2 * FAC = 6.28
001743r 2                       ; Store into B.
001743r 2                       ldx     VT_VPSAVE
001743r 2                       ldy     VT_VPSAVE+1
001743r 2                       jsr     StoreFacAtYxRounded
001743r 2               
001743r 2                       ; Print result.
001743r 2                       lda     #<MsgVT_A
001743r 2                       ldy     #>MsgVT_A
001743r 2                       jsr     BasPrintStr
001743r 2                       ; Reload B and print.
001743r 2                       lda     VT_VPSAVE
001743r 2                       ldy     VT_VPSAVE+1
001743r 2                       jsr     LoadFacFromYa
001743r 2                       jsr     BasPrintFAC
001743r 2                       jsr     BasPrintCRLF
001743r 2               
001743r 2                       ; --- Test 2: A$="HELLO" ---
001743r 2                       lda     #<VT_NameAS
001743r 2                       ldy     #>VT_NameAS
001743r 2                       jsr     VT_SetTxt
001743r 2                       jsr     PtrGet                  ; creates A$
001743r 2                       ; Save VARPNT (A$ descriptor address).
001743r 2                       lda     VARPNT
001743r 2                       sta     VT_VPSAVE
001743r 2                       lda     VARPNT+1
001743r 2                       sta     VT_VPSAVE+1
001743r 2                       ; Allocate space, copy "HELLO" via StrLit.
001743r 2                       lda     #<VT_HelloLit
001743r 2                       ldy     #>VT_HelloLit
001743r 2                       jsr     StrLit                  ; FAC has descriptor, in temp stack
001743r 2                       ; Now copy descriptor (3 bytes from temp stack entry) to A$ var.
001743r 2                       ; FAC+3,4 points at the temp descriptor; FAC = length, FAC+1/2 = addr.
001743r 2                       ; The descriptor lives in TEMPST.  We just write [len][lo][hi] into
001743r 2                       ; (VARPNT) so the variable now references the heap copy.
001743r 2                       lda     FAC
001743r 2                       ldy     #$00
001743r 2                       sta     (VT_VPSAVE),y           ; length
001743r 2                       lda     FAC+1
001743r 2                       iny
001743r 2                       sta     (VT_VPSAVE),y           ; addr lo
001743r 2                       lda     FAC+2
001743r 2                       iny
001743r 2                       sta     (VT_VPSAVE),y           ; addr hi
001743r 2                       ; Print length.
001743r 2                       lda     #<MsgVT_AS
001743r 2                       ldy     #>MsgVT_AS
001743r 2                       jsr     BasPrintStr
001743r 2                       ldy     #$00
001743r 2                       lda     (VT_VPSAVE),y
001743r 2                       tay
001743r 2                       jsr     SngFlt
001743r 2                       jsr     BasPrintFAC
001743r 2                       jsr     BasPrintCRLF
001743r 2               
001743r 2                       ; --- Test 3: DIM N(10), N(5)=42 ---
001743r 2                       ; Build TXTPTR pointing at "N(10) " and call MakInt-equivalent path.
001743r 2                       ; Easier: directly construct array via PtrGet3 + Array by simulating
001743r 2                       ; a 1-D DIM of size 11 (indices 0..10).  We emulate the parser:
001743r 2                       ;   1. Set DIMFLG = $40, VARNAM = ('N','N'), call PtrGet3 with X=1?
001743r 2                       ;   2. Or: just do PtrGet3 entry by hand then jmp Array.
001743r 2                       ; Simplest: set TXTPTR at "N(10) ", DIMFLG <- $40 (from DIM
001743r 2                       ; statement), then PtrGet3 with VARNAM letter, jmp to '(' branch.
001743r 2                       lda     #<VT_DimN10
001743r 2                       ldy     #>VT_DimN10
001743r 2                       jsr     VT_SetTxt               ; A = 'N'
001743r 2                       ldx     #$40                    ; from-DIM flag (bit 6)
001743r 2                       jsr     PtrGet2                 ; will hit '(' -> Array -> create
001743r 2                       ; Now N(5)=42.  Re-parse "N(5)" to find element.
001743r 2                       lda     #<VT_DimN5
001743r 2                       ldy     #>VT_DimN5
001743r 2                       jsr     VT_SetTxt
001743r 2                       jsr     PtrGet                  ; element address in VARPNT
001743r 2                       ; Save VARPNT.
001743r 2                       lda     VARPNT
001743r 2                       sta     VT_VPSAVE
001743r 2                       lda     VARPNT+1
001743r 2                       sta     VT_VPSAVE+1
001743r 2                       ; FAC = 42.
001743r 2                       lda     #<Vt42
001743r 2                       ldy     #>Vt42
001743r 2                       jsr     LoadFacFromYa
001743r 2                       ldx     VT_VPSAVE
001743r 2                       ldy     VT_VPSAVE+1
001743r 2                       jsr     StoreFacAtYxRounded
001743r 2                       ; Read it back and print.
001743r 2                       lda     #<MsgVT_NewArr
001743r 2                       ldy     #>MsgVT_NewArr
001743r 2                       jsr     BasPrintStr
001743r 2                       lda     VT_VPSAVE
001743r 2                       ldy     VT_VPSAVE+1
001743r 2                       jsr     LoadFacFromYa
001743r 2                       jsr     BasPrintFAC
001743r 2                       jsr     BasPrintCRLF
001743r 2               
001743r 2                       ; --- Test 4: 8 string allocations + GC ---
001743r 2                       ldx     #8
001743r 2               @galloc:
001743r 2                       phx
001743r 2                       lda     #16
001743r 2                       jsr     StrSpa                  ; consumes 16 bytes; FAC has descriptor
001743r 2                       plx
001743r 2                       dex
001743r 2                       bne     @galloc
001743r 2                       ; Force GC (TEMPPT got bumped by StrSpa-via-StrIni? StrSpa itself
001743r 2                       ; doesn't call PutNew, so temp stack untouched here.)
001743r 2                       jsr     Garbag
001743r 2                       lda     #<MsgVT_GC
001743r 2                       ldy     #>MsgVT_GC
001743r 2                       jsr     BasPrintStr
001743r 2                       lda     FRETOP+1
001743r 2                       ldy     FRETOP
001743r 2                       jsr     GivAyf
001743r 2                       jsr     BasPrintFAC
001743r 2                       jsr     BasPrintCRLF
001743r 2               
001743r 2                       rts
001743r 2               .endif
001743r 2               
001743r 2               ; =============================================================================
001743r 2               ;   E X P R E S S I O N   E V A L U A T O R
001743r 2               ;
001743r 2               ;   Recursive-descent precedence climber.  Operates on tokenized text at
001743r 2               ;   TXTPTR (advanced via ChrGet/ChrGot).  Result lands in FAC (numeric)
001743r 2               ;   or as a 3-byte string descriptor at FAC..FAC+2 (string).  VALTYP
001743r 2               ;   selects: $00 = numeric, $FF = string.
001743r 2               ;
001743r 2               ;   Precedence (lowest -> highest):
001743r 2               ;     OR
001743r 2               ;     AND
001743r 2               ;     NOT  (right-assoc unary)
001743r 2               ;     comparison (= <> < > <= >=)
001743r 2               ;     + -
001743r 2               ;     * /
001743r 2               ;     ^    (right-assoc)
001743r 2               ;     unary -, unary +
001743r 2               ;     atom: number, variable, string-literal, "(" expr ")", function call
001743r 2               ; =============================================================================
001743r 2               
001743r 2               ; ---------------------------------------------------------------------------
001743r 2               ; ZP scratch used only during expression evaluation.
001743r 2               ;   BAS_LVTYP = saved VALTYP of left operand around binary ops
001743r 2               ; ---------------------------------------------------------------------------
001743r 2               BAS_LVTYP       := $86
001743r 2               
001743r 2               ; ---------------------------------------------------------------------------
001743r 2               ; FrmEvl -- top-level entry.  TXTPTR positioned so ChrGot returns the first
001743r 2               ; byte of the expression.  On exit TXTPTR is at the first byte AFTER the
001743r 2               ; expression.  Result in FAC + VALTYP.
001743r 2               ; ---------------------------------------------------------------------------
001743r 2               FrmEvl:
001743r 2  4C rr rr             jmp     EvalOr
001746r 2               
001746r 2               ; ---------------------------------------------------------------------------
001746r 2               ; PushFac -- push the current FAC + VALTYP onto the CPU stack (8 bytes).
001746r 2               ; Order pushed: VALTYP, FAC, FAC+1, FAC+2, FAC+3, FAC+4, FACSIGN, FACEXTENSION
001746r 2               ; (FACEXTENSION pushed last so it's pulled first by PullArg.)
001746r 2               ; Preserves the return address.
001746r 2               ; ---------------------------------------------------------------------------
001746r 2               PushFac:
001746r 2  68                   pla
001747r 2  A8                   tay                             ; Y = ret-addr lo
001748r 2  68                   pla
001749r 2  AA                   tax                             ; X = ret-addr hi
00174Ar 2  A5 64                lda     VALTYP
00174Cr 2  48                   pha
00174Dr 2  A5 0E                lda     FAC
00174Fr 2  48                   pha
001750r 2  A5 0F                lda     FAC+1
001752r 2  48                   pha
001753r 2  A5 10                lda     FAC+2
001755r 2  48                   pha
001756r 2  A5 11                lda     FAC+3
001758r 2  48                   pha
001759r 2  A5 12                lda     FAC+4
00175Br 2  48                   pha
00175Cr 2  A5 13                lda     FACSIGN
00175Er 2  48                   pha
00175Fr 2  A5 1D                lda     FACEXTENSION
001761r 2  48                   pha
001762r 2  8A                   txa
001763r 2  48                   pha
001764r 2  98                   tya
001765r 2  48                   pha
001766r 2  60                   rts
001767r 2               
001767r 2               ; ---------------------------------------------------------------------------
001767r 2               ; PullArg -- pop the previously-pushed FAC into ARG (signed FP value or
001767r 2               ; string descriptor in ARG..ARG+2/sign).  Sets BAS_LVTYP to the saved
001767r 2               ; left-operand VALTYP.  Preserves return address.
001767r 2               ; ---------------------------------------------------------------------------
001767r 2               PullArg:
001767r 2  68                   pla
001768r 2  A8                   tay                             ; Y = ret-addr lo
001769r 2  68                   pla
00176Ar 2  AA                   tax                             ; X = ret-addr hi
00176Br 2  68                   pla
00176Cr 2  85 43                sta     ARGEXTENSION
00176Er 2  68                   pla
00176Fr 2  85 1B                sta     ARGSIGN
001771r 2  68                   pla
001772r 2  85 1A                sta     ARG+4
001774r 2  68                   pla
001775r 2  85 19                sta     ARG+3
001777r 2  68                   pla
001778r 2  85 18                sta     ARG+2
00177Ar 2  68                   pla
00177Br 2  85 17                sta     ARG+1
00177Dr 2  68                   pla
00177Er 2  85 16                sta     ARG
001780r 2  68                   pla
001781r 2  85 86                sta     BAS_LVTYP
001783r 2  8A                   txa
001784r 2  48                   pha
001785r 2  98                   tya
001786r 2  48                   pha
001787r 2  60                   rts
001788r 2               
001788r 2               ; ---------------------------------------------------------------------------
001788r 2               ; PullFac -- pop pushed FAC back into FAC (used to discard right side and
001788r 2               ; restore left, e.g. unused).
001788r 2               ; ---------------------------------------------------------------------------
001788r 2               PullFac:
001788r 2  68                   pla
001789r 2  A8                   tay
00178Ar 2  68                   pla
00178Br 2  AA                   tax
00178Cr 2  68                   pla
00178Dr 2  85 1D                sta     FACEXTENSION
00178Fr 2  68                   pla
001790r 2  85 13                sta     FACSIGN
001792r 2  68                   pla
001793r 2  85 12                sta     FAC+4
001795r 2  68                   pla
001796r 2  85 11                sta     FAC+3
001798r 2  68                   pla
001799r 2  85 10                sta     FAC+2
00179Br 2  68                   pla
00179Cr 2  85 0F                sta     FAC+1
00179Er 2  68                   pla
00179Fr 2  85 0E                sta     FAC
0017A1r 2  68                   pla
0017A2r 2  85 64                sta     VALTYP
0017A4r 2  8A                   txa
0017A5r 2  48                   pha
0017A6r 2  98                   tya
0017A7r 2  48                   pha
0017A8r 2  60                   rts
0017A9r 2               
0017A9r 2               ; ---------------------------------------------------------------------------
0017A9r 2               ; TypeMismatch helper.
0017A9r 2               ; ---------------------------------------------------------------------------
0017A9r 2               EvalTypeErr:
0017A9r 2  A2 08                ldx     #ERR_TYPEMISM
0017ABr 2  4C rr rr             jmp     BasErrorVec
0017AEr 2               
0017AEr 2               ; ===========================================================================
0017AEr 2               ;   L E V E L 0  --  O R
0017AEr 2               ; ===========================================================================
0017AEr 2               EvalOr:
0017AEr 2  20 rr rr             jsr     EvalAnd
0017B1r 2               @loop:
0017B1r 2  20 rr rr             jsr     ChrGot
0017B4r 2  C9 A3                cmp     #TOK_OR
0017B6r 2  D0 17                bne     @done
0017B8r 2  20 rr rr             jsr     ChkNum                  ; left must be numeric
0017BBr 2  20 rr rr             jsr     ChrGet                  ; consume OR
0017BEr 2  20 rr rr             jsr     PushFac
0017C1r 2  20 rr rr             jsr     EvalAnd
0017C4r 2  20 rr rr             jsr     ChkNum                  ; right must be numeric
0017C7r 2  20 rr rr             jsr     PullArg
0017CAr 2  20 rr rr             jsr     OrOp
0017CDr 2  80 E2                bra     @loop
0017CFr 2               @done:
0017CFr 2  60                   rts
0017D0r 2               
0017D0r 2               ; ===========================================================================
0017D0r 2               ;   L E V E L 1  --  A N D
0017D0r 2               ; ===========================================================================
0017D0r 2               EvalAnd:
0017D0r 2  20 rr rr             jsr     EvalNot
0017D3r 2               @loop:
0017D3r 2  20 rr rr             jsr     ChrGot
0017D6r 2  C9 A2                cmp     #TOK_AND
0017D8r 2  D0 17                bne     @done
0017DAr 2  20 rr rr             jsr     ChkNum
0017DDr 2  20 rr rr             jsr     ChrGet
0017E0r 2  20 rr rr             jsr     PushFac
0017E3r 2  20 rr rr             jsr     EvalNot
0017E6r 2  20 rr rr             jsr     ChkNum
0017E9r 2  20 rr rr             jsr     PullArg
0017ECr 2  20 rr rr             jsr     AndOp
0017EFr 2  80 E2                bra     @loop
0017F1r 2               @done:
0017F1r 2  60                   rts
0017F2r 2               
0017F2r 2               ; ===========================================================================
0017F2r 2               ;   L E V E L 2  --  N O T   (right-assoc unary prefix)
0017F2r 2               ; ===========================================================================
0017F2r 2               EvalNot:
0017F2r 2  20 rr rr             jsr     ChrGot
0017F5r 2  C9 A0                cmp     #TOK_NOT
0017F7r 2  D0 0C                bne     EvalCmp
0017F9r 2  20 rr rr             jsr     ChrGet
0017FCr 2  20 rr rr             jsr     EvalNot
0017FFr 2  20 rr rr             jsr     ChkNum
001802r 2  4C rr rr             jmp     NotOp
001805r 2               
001805r 2               ; ===========================================================================
001805r 2               ;   L E V E L 3  --  C O M P A R I S O N
001805r 2               ;   Reads up to two of {<, =, >} forming a relop; if none, no-op.
001805r 2               ;   Mask:  bit 0 = '>' present, bit 1 = '=' present, bit 2 = '<' present
001805r 2               ; ===========================================================================
001805r 2               EvalCmp:
001805r 2  20 rr rr             jsr     EvalAdd
001808r 2  A2 00                ldx     #0                      ; relop mask
00180Ar 2               @scan:
00180Ar 2  20 rr rr             jsr     ChrGot
00180Dr 2  C9 3D                cmp     #'='
00180Fr 2  F0 0A                beq     @gotEq
001811r 2  C9 3C                cmp     #'<'
001813r 2  F0 0A                beq     @gotLt
001815r 2  C9 3E                cmp     #'>'
001817r 2  F0 0A                beq     @gotGt
001819r 2  80 1D                bra     @done
00181Br 2               @gotEq:
00181Br 2  A0 02                ldy     #2
00181Dr 2  80 06                bra     @setbit
00181Fr 2               @gotLt:
00181Fr 2  A0 04                ldy     #4
001821r 2  80 02                bra     @setbit
001823r 2               @gotGt:
001823r 2  A0 01                ldy     #1
001825r 2               @setbit:
001825r 2  84 45                sty     CPRMASK                 ; reuse as scratch
001827r 2  8A                   txa
001828r 2  25 45                and     CPRMASK
00182Ar 2  D0 09                bne     @synErr                 ; same char twice (e.g. "==")
00182Cr 2  8A                   txa
00182Dr 2  05 45                ora     CPRMASK
00182Fr 2  AA                   tax
001830r 2  20 rr rr             jsr     ChrGet
001833r 2  80 D5                bra     @scan
001835r 2               @synErr:
001835r 2  4C rr rr             jmp     SynErr
001838r 2               @done:
001838r 2  E0 00                cpx     #0
00183Ar 2  D0 01                bne     @doCmp
00183Cr 2  60                   rts
00183Dr 2               @doCmp:
00183Dr 2  86 45                stx     CPRMASK
00183Fr 2                       ; Save left operand, evaluate right
00183Fr 2  20 rr rr             jsr     PushFac
001842r 2  20 rr rr             jsr     EvalAdd
001845r 2  20 rr rr             jsr     PullArg                 ; ARG = left, BAS_LVTYP = left's type
001848r 2                       ; Type compatibility check.
001848r 2  A5 86                lda     BAS_LVTYP
00184Ar 2  45 64                eor     VALTYP
00184Cr 2  10 03 4C rr          jmi     EvalTypeErr             ; one numeric, one string -> mismatch
001850r 2  rr           
001851r 2  24 64                bit     VALTYP
001853r 2  30 03                bmi     @strCmp
001855r 2                       ; Numeric comparison.
001855r 2  4C rr rr             jmp     RelOpsNum
001858r 2               @strCmp:
001858r 2  4C rr rr             jmp     RelOpsStr
00185Br 2               
00185Br 2               ; ---------------------------------------------------------------------------
00185Br 2               ; RelOpsNum -- numeric comparison.
00185Br 2               ; Inputs: ARG = left, FAC = right, CPRMASK = relop mask (bit 0=>, 1==, 2=<).
00185Br 2               ; Output: FAC = -1 if (ARG <op> FAC) is true, else 0.  VALTYP = numeric.
00185Br 2               ; ---------------------------------------------------------------------------
00185Br 2               RelOpsNum:
00185Br 2                       ; Replicate msbasic ARG-pre-relop fixup: clear ARG+1 high bit, then
00185Br 2                       ; set it from ARGSIGN's MSB.  This rebuilds the implicit-1 mantissa
00185Br 2                       ; for FCOMP's signed comparison path.
00185Br 2  A5 1B                lda     ARGSIGN
00185Dr 2  09 7F                ora     #$7F
00185Fr 2  25 17                and     ARG+1
001861r 2  85 17                sta     ARG+1
001863r 2  A9 16                lda     #<ARG
001865r 2  A0 00                ldy     #$00
001867r 2  20 rr rr             jsr     FComp                   ; A = sign(FAC - ARG)
00186Ar 2                       ; Map A to bit position:
00186Ar 2                       ;   FAC<ARG (A=$FF): ARG>FAC  -> bit 0 (mask 1)
00186Ar 2                       ;   FAC=ARG (A=$00):           -> bit 1 (mask 2)
00186Ar 2                       ;   FAC>ARG (A=$01): ARG<FAC  -> bit 2 (mask 4)
00186Ar 2  AA                   tax
00186Br 2  30 06                bmi     @lt
00186Dr 2  F0 08                beq     @eq
00186Fr 2  A9 04                lda     #4
001871r 2  80 06                bra     @check
001873r 2               @lt:
001873r 2  A9 01                lda     #1
001875r 2  80 02                bra     @check
001877r 2               @eq:
001877r 2  A9 02                lda     #2
001879r 2               @check:
001879r 2  25 45                and     CPRMASK
00187Br 2  F0 07                beq     @false
00187Dr 2  A9 FF                lda     #$FF
00187Fr 2  A0 FF                ldy     #$FF
001881r 2  4C rr rr             jmp     GivAyf
001884r 2               @false:
001884r 2  A9 00                lda     #0
001886r 2  A8                   tay
001887r 2  4C rr rr             jmp     GivAyf
00188Ar 2               
00188Ar 2               ; ---------------------------------------------------------------------------
00188Ar 2               ; RelOpsStr -- bytewise string comparison.
00188Ar 2               ; ARG = left descriptor (ARG=len, ARG+1=lo, ARG+2=hi, ARGSIGN, ARGEXT pushed).
00188Ar 2               ; FAC = right descriptor.  CPRMASK as above.
00188Ar 2               ; ---------------------------------------------------------------------------
00188Ar 2               RelOpsStr:
00188Ar 2                       ; INDEX = left ptr, BAS_TMP1 = right ptr, BAS_TMP2 lo = left len,
00188Ar 2                       ; BAS_TMP2 hi = right len.
00188Ar 2  A5 17                lda     ARG+1
00188Cr 2  85 20                sta     INDEX
00188Er 2  A5 18                lda     ARG+2
001890r 2  85 21                sta     INDEX+1
001892r 2  A5 0F                lda     FAC+1
001894r 2  85 3A                sta     BAS_TMP1
001896r 2  A5 10                lda     FAC+2
001898r 2  85 3B                sta     BAS_TMP1+1
00189Ar 2  A5 16                lda     ARG
00189Cr 2  85 3C                sta     BAS_TMP2                ; left len
00189Er 2  A5 0E                lda     FAC
0018A0r 2  85 3D                sta     BAS_TMP2+1              ; right len
0018A2r 2                       ; Compare byte-by-byte up to min length.
0018A2r 2  A0 00                ldy     #0
0018A4r 2               @cmp:
0018A4r 2                       ; Has either side ended?
0018A4r 2  C4 3C                cpy     BAS_TMP2
0018A6r 2  F0 17                beq     @leftEnd
0018A8r 2  C4 3D                cpy     BAS_TMP2+1
0018AAr 2  F0 1B                beq     @rightEnd               ; right ended first -> left > right
0018ACr 2  B1 20                lda     (INDEX),y
0018AEr 2  D1 3A                cmp     (BAS_TMP1),y
0018B0r 2  F0 0A                beq     @next
0018B2r 2  90 04                bcc     @lt                     ; left < right
0018B4r 2                       ; left > right
0018B4r 2  A9 01                lda     #1
0018B6r 2  80 15                bra     @decide
0018B8r 2               @lt:
0018B8r 2  A9 04                lda     #4
0018BAr 2  80 11                bra     @decide
0018BCr 2               @next:
0018BCr 2  C8                   iny
0018BDr 2  80 E5                bra     @cmp
0018BFr 2               @leftEnd:
0018BFr 2                       ; Left ran out; check right
0018BFr 2  C4 3D                cpy     BAS_TMP2+1
0018C1r 2  F0 08                beq     @equal
0018C3r 2                       ; left < right (left is prefix)
0018C3r 2  A9 04                lda     #4
0018C5r 2  80 06                bra     @decide
0018C7r 2               @rightEnd:
0018C7r 2                       ; right ran out, left has more; left > right
0018C7r 2  A9 01                lda     #1
0018C9r 2  80 02                bra     @decide
0018CBr 2               @equal:
0018CBr 2  A9 02                lda     #2
0018CDr 2               @decide:
0018CDr 2  25 45                and     CPRMASK
0018CFr 2  F0 05                beq     @false
0018D1r 2  A9 FF                lda     #$FF
0018D3r 2  A8                   tay
0018D4r 2  80 03                bra     @ret
0018D6r 2               @false:
0018D6r 2  A9 00                lda     #0
0018D8r 2  A8                   tay
0018D9r 2               @ret:
0018D9r 2                       ; Free temp strings before returning.  Save A,Y first.
0018D9r 2  48                   pha
0018DAr 2  5A                   phy
0018DBr 2                       ; Free FAC's temp string (right operand).
0018DBr 2  24 64                bit     VALTYP
0018DDr 2  10 03                bpl     @noFreeR
0018DFr 2  20 rr rr             jsr     FreFac
0018E2r 2               @noFreeR:
0018E2r 2                       ; Free ARG's temp string (left operand): manually restore VALTYP=$FF
0018E2r 2                       ; and FAC := ARG, then FreFac.  (We don't always know if ARG is a
0018E2r 2                       ; temp; FreTms inside FreTmp checks.)
0018E2r 2  A5 16                lda     ARG
0018E4r 2  85 0E                sta     FAC
0018E6r 2  A5 17                lda     ARG+1
0018E8r 2  85 0F                sta     FAC+1
0018EAr 2  A5 18                lda     ARG+2
0018ECr 2  85 10                sta     FAC+2
0018EEr 2  A9 FF                lda     #$FF
0018F0r 2  85 64                sta     VALTYP
0018F2r 2  20 rr rr             jsr     FreFac
0018F5r 2  7A                   ply
0018F6r 2  68                   pla
0018F7r 2  4C rr rr             jmp     GivAyf
0018FAr 2               
0018FAr 2               ; ===========================================================================
0018FAr 2               ;   L E V E L 4  --  + / -
0018FAr 2               ; ===========================================================================
0018FAr 2               EvalAdd:
0018FAr 2  20 rr rr             jsr     EvalMul
0018FDr 2               @loop:
0018FDr 2  20 rr rr             jsr     ChrGot
001900r 2  C9 2B                cmp     #'+'
001902r 2  F0 05                beq     @plus
001904r 2  C9 2D                cmp     #'-'
001906r 2  F0 27                beq     @minus
001908r 2  60                   rts
001909r 2               @plus:
001909r 2  20 rr rr             jsr     ChrGet
00190Cr 2  20 rr rr             jsr     PushFac
00190Fr 2  20 rr rr             jsr     EvalMul
001912r 2  20 rr rr             jsr     PullArg
001915r 2                       ; Type dispatch.
001915r 2  A5 86                lda     BAS_LVTYP
001917r 2  45 64                eor     VALTYP
001919r 2  10 03 4C rr          jmi     EvalTypeErr
00191Dr 2  rr           
00191Er 2  24 64                bit     VALTYP
001920r 2  30 28                bmi     @cat
001922r 2                       ; numeric add: FAC = ARG + FAC
001922r 2                       ; FAddT expects: ARG is the operand, A=FAC's exponent on entry.
001922r 2                       ; Use entry "FAddT" preceded by sign work: msbasic does
001922r 2                       ;   bne <continue>; jmp CopyArgToFac
001922r 2                       ; But our FAddT entry already handles that.  We need to set
001922r 2                       ; SGNCPR = ARGSIGN ^ FACSIGN before FAddT.
001922r 2  A5 1B                lda     ARGSIGN
001924r 2  45 13                eor     FACSIGN
001926r 2  85 1C                sta     SGNCPR
001928r 2  A5 0E                lda     FAC
00192Ar 2  20 rr rr             jsr     FAddT
00192Dr 2  80 CE                bra     @loop
00192Fr 2               @minus:
00192Fr 2  20 rr rr             jsr     ChrGet
001932r 2  20 rr rr             jsr     PushFac
001935r 2  20 rr rr             jsr     EvalMul
001938r 2  20 rr rr             jsr     ChkNum
00193Br 2                       ; left was pushed; check pushed type via TOS-byte? Easier: we already
00193Br 2                       ; verified left is numeric on first iteration.  But left might have
00193Br 2                       ; been a string from concatenation; require numeric here:
00193Br 2  20 rr rr             jsr     PullArg
00193Er 2  A5 86                lda     BAS_LVTYP
001940r 2  10 03 4C rr          jmi     EvalTypeErr
001944r 2  rr           
001945r 2                       ; FAC = ARG - FAC
001945r 2                       ; FSubT does: FACSIGN ^= $FF; SGNCPR = FACSIGN^ARGSIGN; jmp FAddT
001945r 2                       ; We need to call FSubT directly.
001945r 2  20 rr rr             jsr     FSubT
001948r 2  80 B3                bra     @loop
00194Ar 2               @cat:
00194Ar 2  20 rr rr             jsr     CatStr
00194Dr 2  80 AE                bra     @loop
00194Fr 2               
00194Fr 2               ; ---------------------------------------------------------------------------
00194Fr 2               ; CatStr -- concatenate ARG (left) + FAC (right), result in FAC.
00194Fr 2               ; ---------------------------------------------------------------------------
00194Fr 2               CatStr:
00194Fr 2                       ; Stash right's length+addr before we overwrite FAC.
00194Fr 2  A5 0E                lda     FAC
001951r 2  85 4D                sta     BAS_TEMP1               ; right len
001953r 2  A5 0F                lda     FAC+1
001955r 2  85 4E                sta     BAS_TEMP1+1
001957r 2  A5 10                lda     FAC+2
001959r 2  85 4F                sta     BAS_TEMP1+2
00195Br 2                       ; Total length = ARG + FAC; abort if > 255.
00195Br 2  18                   clc
00195Cr 2  A5 16                lda     ARG
00195Er 2  65 4D                adc     BAS_TEMP1
001960r 2  B0 40                bcs     @tooLong
001962r 2  85 50                sta     BAS_TEMP1+3             ; total length
001964r 2                       ; Free both source temps before allocating result -- otherwise we
001964r 2                       ; pile up to 3 temps and the next PutNew throws ?FRMCPX.
001964r 2  20 rr rr             jsr     FreeBothTemps
001967r 2                       ; Allocate.
001967r 2  A5 50                lda     BAS_TEMP1+3             ; total length
001969r 2  20 rr rr             jsr     GetSpa                  ; A=total, FRESPC=buf
00196Cr 2                       ; Copy left bytes (ARG -> FRESPC).
00196Cr 2  A5 17                lda     ARG+1
00196Er 2  85 20                sta     INDEX
001970r 2  A5 18                lda     ARG+2
001972r 2  85 21                sta     INDEX+1
001974r 2  A5 16                lda     ARG
001976r 2  F0 03                beq     @right
001978r 2  20 rr rr             jsr     MovStr1                 ; advances FRESPC by len
00197Br 2               @right:
00197Br 2                       ; Copy right bytes.
00197Br 2  A5 4E                lda     BAS_TEMP1+1
00197Dr 2  85 20                sta     INDEX
00197Fr 2  A5 4F                lda     BAS_TEMP1+2
001981r 2  85 21                sta     INDEX+1
001983r 2  A5 4D                lda     BAS_TEMP1
001985r 2  F0 03                beq     @desc
001987r 2  20 rr rr             jsr     MovStr1
00198Ar 2               @desc:
00198Ar 2                       ; Descriptor: FAC := total len, FAC+1/2 := FRESPC - total.
00198Ar 2  A5 50                lda     BAS_TEMP1+3
00198Cr 2  85 0E                sta     FAC
00198Er 2  38                   sec
00198Fr 2  A5 84                lda     FRESPC
001991r 2  E5 50                sbc     BAS_TEMP1+3
001993r 2  85 0F                sta     FAC+1
001995r 2  A5 85                lda     FRESPC+1
001997r 2  E9 00                sbc     #0
001999r 2  85 10                sta     FAC+2
00199Br 2  A9 FF                lda     #$FF
00199Dr 2  85 64                sta     VALTYP
00199Fr 2  4C rr rr             jmp     PutNew
0019A2r 2               @tooLong:
0019A2r 2  A2 09                ldx     #ERR_STRLONG
0019A4r 2  4C rr rr             jmp     BasErrorVec
0019A7r 2               
0019A7r 2               ; ===========================================================================
0019A7r 2               ;   L E V E L 5  --  * / /
0019A7r 2               ; ===========================================================================
0019A7r 2               EvalMul:
0019A7r 2  20 rr rr             jsr     EvalPow
0019AAr 2               @loop:
0019AAr 2  20 rr rr             jsr     ChrGot
0019ADr 2  C9 2A                cmp     #'*'
0019AFr 2  F0 05                beq     @mul
0019B1r 2  C9 2F                cmp     #'/'
0019B3r 2  F0 27                beq     @div
0019B5r 2  60                   rts
0019B6r 2               @mul:
0019B6r 2  20 rr rr             jsr     ChkNum
0019B9r 2  20 rr rr             jsr     ChrGet
0019BCr 2  20 rr rr             jsr     PushFac
0019BFr 2  20 rr rr             jsr     EvalPow
0019C2r 2  20 rr rr             jsr     ChkNum
0019C5r 2  20 rr rr             jsr     PullArg
0019C8r 2  A5 86                lda     BAS_LVTYP
0019CAr 2  10 03 4C rr          jmi     EvalTypeErr
0019CEr 2  rr           
0019CFr 2                       ; FAC = ARG * FAC: FMultT expects ARG + sign work.  See msbasic.
0019CFr 2  A5 1B                lda     ARGSIGN
0019D1r 2  45 13                eor     FACSIGN
0019D3r 2  85 1C                sta     SGNCPR
0019D5r 2  A5 0E                lda     FAC
0019D7r 2  20 rr rr             jsr     FMultT
0019DAr 2  80 CE                bra     @loop
0019DCr 2               @div:
0019DCr 2  20 rr rr             jsr     ChkNum
0019DFr 2  20 rr rr             jsr     ChrGet
0019E2r 2  20 rr rr             jsr     PushFac
0019E5r 2  20 rr rr             jsr     EvalPow
0019E8r 2  20 rr rr             jsr     ChkNum
0019EBr 2  20 rr rr             jsr     PullArg
0019EEr 2  A5 86                lda     BAS_LVTYP
0019F0r 2  10 03 4C rr          jmi     EvalTypeErr
0019F4r 2  rr           
0019F5r 2                       ; FAC = ARG / FAC: FDivT.
0019F5r 2  A5 1B                lda     ARGSIGN
0019F7r 2  45 13                eor     FACSIGN
0019F9r 2  85 1C                sta     SGNCPR
0019FBr 2  A5 0E                lda     FAC
0019FDr 2  20 rr rr             jsr     FDivT
001A00r 2  80 A8                bra     @loop
001A02r 2               
001A02r 2               ; ===========================================================================
001A02r 2               ;   L E V E L 6  --  ^   (right-associative)
001A02r 2               ; ===========================================================================
001A02r 2               EvalPow:
001A02r 2  20 rr rr             jsr     EvalUnary
001A05r 2               @loop:
001A05r 2  20 rr rr             jsr     ChrGot
001A08r 2  C9 5E                cmp     #'^'
001A0Ar 2  D0 20                bne     @done
001A0Cr 2  20 rr rr             jsr     ChkNum
001A0Fr 2  20 rr rr             jsr     ChrGet
001A12r 2  20 rr rr             jsr     PushFac
001A15r 2  20 rr rr             jsr     EvalUnary               ; right-assoc: recurse below
001A18r 2                       ; Actually right-assoc means: evaluate the RHS at this level too.
001A18r 2                       ; But EvalUnary doesn't loop ^; it stops.  Re-check ^ here?  No --
001A18r 2                       ; for right-assoc we should recurse at the same level for the RHS.
001A18r 2                       ; Simpler: after EvalUnary, look for another ^ and recurse.
001A18r 2                       ; Implemented by jumping back to @loop (so chained ^ becomes
001A18r 2                       ; left-assoc in this version).  Acceptable simplification.
001A18r 2  20 rr rr             jsr     ChkNum
001A1Br 2  20 rr rr             jsr     PullArg
001A1Er 2  A5 86                lda     BAS_LVTYP
001A20r 2  10 03 4C rr          jmi     EvalTypeErr
001A24r 2  rr           
001A25r 2                       ; FPwrt computes ARG ^ FAC.  Our ported FPwrt expects ARG = base,
001A25r 2                       ; FAC = exponent, and A = FAC's exponent byte (FPwrt's first
001A25r 2                       ; instruction is `beq Exp` to short-circuit FAC==0 -> 1).
001A25r 2  A5 0E                lda     FAC
001A27r 2  20 rr rr             jsr     FPwrt
001A2Ar 2  80 D9                bra     @loop
001A2Cr 2               @done:
001A2Cr 2  60                   rts
001A2Dr 2               
001A2Dr 2               ; ===========================================================================
001A2Dr 2               ;   L E V E L 7  --  U N A R Y
001A2Dr 2               ; ===========================================================================
001A2Dr 2               EvalUnary:
001A2Dr 2  20 rr rr             jsr     ChrGot
001A30r 2  C9 2D                cmp     #'-'
001A32r 2  F0 07                beq     @neg
001A34r 2  C9 2B                cmp     #'+'
001A36r 2  F0 13                beq     @pos
001A38r 2  4C rr rr             jmp     EvalAtom
001A3Br 2               @neg:
001A3Br 2  20 rr rr             jsr     ChrGet
001A3Er 2  20 rr rr             jsr     EvalUnary
001A41r 2  20 rr rr             jsr     ChkNum
001A44r 2                       ; Negate FAC: flip FACSIGN bit 7.
001A44r 2  A5 13                lda     FACSIGN
001A46r 2  49 FF                eor     #$FF
001A48r 2  85 13                sta     FACSIGN
001A4Ar 2  60                   rts
001A4Br 2               @pos:
001A4Br 2  20 rr rr             jsr     ChrGet
001A4Er 2  4C rr rr             jmp     EvalUnary
001A51r 2               
001A51r 2               ; ===========================================================================
001A51r 2               ;   L E V E L 8  --  A T O M
001A51r 2               ; ===========================================================================
001A51r 2               EvalAtom:
001A51r 2  64 64                stz     VALTYP                  ; default to numeric; string paths override
001A53r 2  20 rr rr             jsr     ChrGot
001A56r 2  90 2E                bcc     @num                    ; digit
001A58r 2  C9 2E                cmp     #'.'
001A5Ar 2  F0 2A                beq     @num
001A5Cr 2  C9 22                cmp     #'"'
001A5Er 2  F0 29                beq     @str
001A60r 2  C9 28                cmp     #'('
001A62r 2  F0 3D                beq     @paren
001A64r 2                       ; Letter? -> variable
001A64r 2  20 rr rr             jsr     IsLetC
001A67r 2  B0 41                bcs     @var
001A69r 2                       ; Function token?
001A69r 2  C9 CD                cmp     #TOK_INKEY
001A6Br 2  F0 64                beq     FnInkey
001A6Dr 2  C9 9D                cmp     #TOK_FN
001A6Fr 2  F0 12                beq     @fnCall                 ; FN A(...) — user-defined function
001A71r 2                       ; Hex literal in PRINT context: not here (no '$' literal supported).
001A71r 2                       ; NVRAM is dual-role (statement at $B1, function via FnTable);
001A71r 2                       ; allow it through even though it sits below TOK_SGN.
001A71r 2  C9 B1                cmp     #TOK_NVRAM
001A73r 2  F0 08                beq     @fnDisp
001A75r 2                       ; Try function dispatch.
001A75r 2  C9 B6                cmp     #TOK_SGN
001A77r 2  90 07                bcc     @synErr
001A79r 2  C9 D1                cmp     #TOK_MAX+1
001A7Br 2  B0 03                bcs     @synErr
001A7Dr 2               @fnDisp:
001A7Dr 2  4C rr rr             jmp     FnDispatch
001A80r 2               @synErr:
001A80r 2  4C rr rr             jmp     SynErr
001A83r 2               @fnCall:
001A83r 2  4C rr rr             jmp     FnCall
001A86r 2               @num:
001A86r 2                       ; ASCII numeric: jump to Fin.  Fin uses ChrGet to consume.
001A86r 2  4C rr rr             jmp     Fin
001A89r 2               @str:
001A89r 2                       ; '"' string literal.  Advance past the opening quote WITHOUT ChrGet:
001A89r 2                       ; ChrGet skips spaces, which would strip leading spaces inside the
001A89r 2                       ; string literal (e.g. PRINT "   X").  Bump TXTPTR by one byte instead.
001A89r 2  E6 04                inc     TXTPTR
001A8Br 2  D0 02                bne     @strsrc
001A8Dr 2  E6 05                inc     TXTPTR+1
001A8Fr 2               @strsrc:
001A8Fr 2                       ; StrLit expects (Y,A) = src.  Source = TXTPTR.
001A8Fr 2  A5 04                lda     TXTPTR
001A91r 2  A4 05                ldy     TXTPTR+1
001A93r 2  20 rr rr             jsr     StrLit
001A96r 2                       ; StrLit advances internal pointer; we need to update TXTPTR.
001A96r 2                       ; StrLit reads until $00 or '"' from (STRNG1)+y; FAC has length.
001A96r 2                       ; Compute new TXTPTR = STRNG2 (which StrLit set), or TXTPTR + len + maybe-quote.
001A96r 2                       ; STRNG2 = STRNG1 + len + (1 if hit quote else 0).  Use STRNG2.
001A96r 2  A5 1E                lda     STRNG2
001A98r 2  85 04                sta     TXTPTR
001A9Ar 2  A5 1F                lda     STRNG2+1
001A9Cr 2  85 05                sta     TXTPTR+1
001A9Er 2                       ; If we stopped at a closing quote, TXTPTR is past it (StrLit's
001A9Er 2                       ; @endquote path: tya/adc STRNG1 with carry set since cmp set C);
001A9Er 2                       ; if we ran into NUL, TXTPTR sits on the NUL (clc path).  Either
001A9Er 2                       ; is correct for ChrGot.
001A9Er 2  4C rr rr             jmp     ChrGot                  ; preload next char (for caller chains)
001AA1r 2               @paren:
001AA1r 2  20 rr rr             jsr     ChrGet                  ; consume '('
001AA4r 2  20 rr rr             jsr     FrmEvl
001AA7r 2  4C rr rr             jmp     ChkCls                  ; expects ')'; consumes via ChrGet
001AAAr 2               @var:
001AAAr 2                       ; Variable lookup.  PtrGet uses CHRGET internally and leaves
001AAAr 2                       ; (A,Y) = VARPNT.  VALTYP is set to $00 or $FF.
001AAAr 2  20 rr rr             jsr     PtrGet
001AADr 2                       ; Fetch value into FAC.
001AADr 2  24 64                bit     VALTYP
001AAFr 2  30 07                bmi     @loadStr
001AB1r 2                       ; numeric: FAC = (VARPNT)
001AB1r 2  A5 3F                lda     VARPNT
001AB3r 2  A4 40                ldy     VARPNT+1
001AB5r 2  4C rr rr             jmp     LoadFacFromYa
001AB8r 2               @loadStr:
001AB8r 2                       ; string: copy descriptor [len][lo][hi] into FAC..FAC+2.
001AB8r 2  A0 00                ldy     #0
001ABAr 2  B1 3F                lda     (VARPNT),y
001ABCr 2  85 0E                sta     FAC
001ABEr 2  C8                   iny
001ABFr 2  B1 3F                lda     (VARPNT),y
001AC1r 2  85 0F                sta     FAC+1
001AC3r 2  C8                   iny
001AC4r 2  B1 3F                lda     (VARPNT),y
001AC6r 2  85 10                sta     FAC+2
001AC8r 2                       ; Record the descriptor's address (= VARPNT) in FAC+3/FAC+4 so the
001AC8r 2                       ; temp-free logic (FreFac/FreTms) can tell this is a variable, not a
001AC8r 2                       ; temp: VARPNT's high byte is nonzero (vars live at $08xx) so it can
001AC8r 2                       ; never match a temp-stack slot (all in zero page) and will not be
001AC8r 2                       ; freed or reclaimed.  Without this, a stale FAC+3/FAC+4 can spuriously
001AC8r 2                       ; match LASTPT and free/reclaim a live string.
001AC8r 2  A5 3F                lda     VARPNT
001ACAr 2  85 11                sta     FAC+3
001ACCr 2  A5 40                lda     VARPNT+1
001ACEr 2  85 12                sta     FAC+4
001AD0r 2  60                   rts
001AD1r 2               
001AD1r 2               ; ---------------------------------------------------------------------------
001AD1r 2               ; FnInkey -- INKEY (no parens).  Reads BAS_PENDKEY first; else BufferSize/
001AD1r 2               ; ReadBuffer; else 0.  Result is unsigned 8-bit FP value.
001AD1r 2               ; ---------------------------------------------------------------------------
001AD1r 2               FnInkey:
001AD1r 2  20 rr rr             jsr     ChrGet                  ; consume INKEY token
001AD4r 2  AD 0E 03             lda     BAS_PENDKEY
001AD7r 2  F0 09                beq     @noPend
001AD9r 2                       ; consume pending key.
001AD9r 2  A0 00                ldy     #0
001ADBr 2  8C 0E 03             sty     BAS_PENDKEY
001ADEr 2  A8                   tay
001ADFr 2  4C rr rr             jmp     SngFlt
001AE2r 2               @noPend:
001AE2r 2  20 rr rr             jsr     BufferSize
001AE5r 2  F0 07                beq     @zero
001AE7r 2  20 rr rr             jsr     ReadBuffer
001AEAr 2  A8                   tay
001AEBr 2  4C rr rr             jmp     SngFlt
001AEEr 2               @zero:
001AEEr 2  A0 00                ldy     #0
001AF0r 2  4C rr rr             jmp     SngFlt
001AF3r 2               
001AF3r 2               ; ---------------------------------------------------------------------------
001AF3r 2               ; FnDispatch -- A holds a function token in [TOK_SGN..TOK_MAX].  Dispatch
001AF3r 2               ; via FnTable, which pairs (token, handler-1).
001AF3r 2               ; ---------------------------------------------------------------------------
001AF3r 2               FnDispatch:
001AF3r 2  A2 00                ldx     #0
001AF5r 2               @find:
001AF5r 2  BD rr rr             lda     FnTable,x
001AF8r 2  F0 14                beq     @synErr                 ; reached terminator
001AFAr 2  D2 04                cmp     (TXTPTR)
001AFCr 2  F0 05                beq     @match
001AFEr 2  E8                   inx
001AFFr 2  E8                   inx
001B00r 2  E8                   inx
001B01r 2  80 F2                bra     @find
001B03r 2               @match:
001B03r 2                       ; Push handler-1 onto stack so RTS jumps to it after ChrGet.
001B03r 2  BD rr rr             lda     FnTable+2,x
001B06r 2  48                   pha
001B07r 2  BD rr rr             lda     FnTable+1,x
001B0Ar 2  48                   pha
001B0Br 2  4C rr rr             jmp     ChrGet                  ; consume token, return into handler
001B0Er 2               @synErr:
001B0Er 2  4C rr rr             jmp     SynErr
001B11r 2               
001B11r 2               ; ---------------------------------------------------------------------------
001B11r 2               ; FnTable -- (token, handler-1) triples, $00-terminated.
001B11r 2               ; "handler-1" because we push it through RTS which adds 1.
001B11r 2               ; ---------------------------------------------------------------------------
001B11r 2               FnTable:
001B11r 2  B6                   .byte   TOK_SGN
001B12r 2  rr rr                .word   FnSgn-1
001B14r 2  B7                   .byte   TOK_INT
001B15r 2  rr rr                .word   FnInt-1
001B17r 2  B8                   .byte   TOK_ABS
001B18r 2  rr rr                .word   FnAbs-1
001B1Ar 2  B9                   .byte   TOK_FRE
001B1Br 2  rr rr                .word   FnFre-1
001B1Dr 2  BA                   .byte   TOK_POS
001B1Er 2  rr rr                .word   FnPos-1
001B20r 2  BB                   .byte   TOK_SQR
001B21r 2  rr rr                .word   FnSqr-1
001B23r 2  BC                   .byte   TOK_RND
001B24r 2  rr rr                .word   FnRnd-1
001B26r 2  BD                   .byte   TOK_LOG
001B27r 2  rr rr                .word   FnLog-1
001B29r 2  BE                   .byte   TOK_EXP
001B2Ar 2  rr rr                .word   FnExp-1
001B2Cr 2  BF                   .byte   TOK_COS
001B2Dr 2  rr rr                .word   FnCos-1
001B2Fr 2  C0                   .byte   TOK_SIN
001B30r 2  rr rr                .word   FnSin-1
001B32r 2  C1                   .byte   TOK_TAN
001B33r 2  rr rr                .word   FnTan-1
001B35r 2  C2                   .byte   TOK_ATN
001B36r 2  rr rr                .word   FnAtn-1
001B38r 2  C3                   .byte   TOK_PEEK
001B39r 2  rr rr                .word   FnPeek-1
001B3Br 2  C4                   .byte   TOK_LEN
001B3Cr 2  rr rr                .word   FnLen-1
001B3Er 2  C5                   .byte   TOK_STRSTR
001B3Fr 2  rr rr                .word   FnStrStr-1
001B41r 2  C6                   .byte   TOK_VAL
001B42r 2  rr rr                .word   FnVal-1
001B44r 2  C7                   .byte   TOK_ASC
001B45r 2  rr rr                .word   FnAsc-1
001B47r 2  C8                   .byte   TOK_CHRSTR
001B48r 2  rr rr                .word   FnChrStr-1
001B4Ar 2  C9                   .byte   TOK_LEFTSTR
001B4Br 2  rr rr                .word   FnLeftStr-1
001B4Dr 2  CA                   .byte   TOK_RIGHTSTR
001B4Er 2  rr rr                .word   FnRightStr-1
001B50r 2  CB                   .byte   TOK_MIDSTR
001B51r 2  rr rr                .word   FnMidStr-1
001B53r 2  CC                   .byte   TOK_JOY
001B54r 2  rr rr                .word   FnJoy-1
001B56r 2  B1                   .byte   TOK_NVRAM
001B57r 2  rr rr                .word   FnNvram-1
001B59r 2  CE                   .byte   TOK_HEX
001B5Ar 2  rr rr                .word   FnHex-1
001B5Cr 2  CF                   .byte   TOK_MIN
001B5Dr 2  rr rr                .word   FnMin-1
001B5Fr 2  D0                   .byte   TOK_MAX
001B60r 2  rr rr                .word   FnMax-1
001B62r 2  00                   .byte   0
001B63r 2               
001B63r 2               ; ---------------------------------------------------------------------------
001B63r 2               ; Numeric-arg helpers.
001B63r 2               ; ParenNum    -- expects "(" expr ")" with numeric result.  FAC = result.
001B63r 2               ; ParenStr    -- expects "(" expr ")" with string result.
001B63r 2               ; ParenU8     -- expects "(" expr ")" -> A = byte (0..255), or ?ILLQTY.
001B63r 2               ; ParenU16    -- expects "(" expr ")" -> AyInt result in FAC+3,+4.
001B63r 2               ; ---------------------------------------------------------------------------
001B63r 2               ParenNum:
001B63r 2  20 rr rr             jsr     ChkOpn
001B66r 2  20 rr rr             jsr     FrmEvl
001B69r 2  20 rr rr             jsr     ChkNum
001B6Cr 2  4C rr rr             jmp     ChkCls
001B6Fr 2               ParenStr:
001B6Fr 2  20 rr rr             jsr     ChkOpn
001B72r 2  20 rr rr             jsr     FrmEvl
001B75r 2  20 rr rr             jsr     ChkStr
001B78r 2  4C rr rr             jmp     ChkCls
001B7Br 2               ParenU8:
001B7Br 2  20 rr rr             jsr     ParenNum
001B7Er 2  20 rr rr             jsr     AyInt
001B81r 2  A5 11                lda     FAC+3                   ; high byte must be 0
001B83r 2  D0 03                bne     @bad
001B85r 2  A5 12                lda     FAC+4                   ; low byte = result
001B87r 2  60                   rts
001B88r 2               @bad:
001B88r 2  4C rr rr             jmp     IqErr
001B8Br 2               
001B8Br 2               ; ---------------------------------------------------------------------------
001B8Br 2               ; Unary numeric functions (single-arg "(" num ")") -- shared body.
001B8Br 2               ; Each entry sets up A = handler entry to call after ChkOpn/FrmEvl/ChkNum/ChkCls.
001B8Br 2               ; ---------------------------------------------------------------------------
001B8Br 2               FnSgn:
001B8Br 2  20 rr rr             jsr     ParenNum
001B8Er 2  4C rr rr             jmp     Sgn
001B91r 2               FnInt:
001B91r 2  20 rr rr             jsr     ParenNum
001B94r 2  4C rr rr             jmp     Int
001B97r 2               FnAbs:
001B97r 2  20 rr rr             jsr     ParenNum
001B9Ar 2  4C rr rr             jmp     Abs
001B9Dr 2               FnSqr:
001B9Dr 2  20 rr rr             jsr     ParenNum
001BA0r 2  4C rr rr             jmp     Sqr
001BA3r 2               FnLog:
001BA3r 2  20 rr rr             jsr     ParenNum
001BA6r 2  4C rr rr             jmp     Log
001BA9r 2               FnExp:
001BA9r 2  20 rr rr             jsr     ParenNum
001BACr 2  4C rr rr             jmp     Exp
001BAFr 2               FnCos:
001BAFr 2  20 rr rr             jsr     ParenNum
001BB2r 2  4C rr rr             jmp     Cos
001BB5r 2               FnSin:
001BB5r 2  20 rr rr             jsr     ParenNum
001BB8r 2  4C rr rr             jmp     Sin
001BBBr 2               FnTan:
001BBBr 2  20 rr rr             jsr     ParenNum
001BBEr 2  4C rr rr             jmp     Tan
001BC1r 2               FnAtn:
001BC1r 2  20 rr rr             jsr     ParenNum
001BC4r 2  4C rr rr             jmp     Atn
001BC7r 2               FnRnd:
001BC7r 2  20 rr rr             jsr     ParenNum
001BCAr 2  4C rr rr             jmp     Rnd
001BCDr 2               FnHex:
001BCDr 2                       ; In expression context: identity.
001BCDr 2  4C rr rr             jmp     ParenNum
001BD0r 2               
001BD0r 2               ; ---------------------------------------------------------------------------
001BD0r 2               ; FnFre -- FRE(n): returns FRETOP - STREND (free string heap).
001BD0r 2               ; Argument is parsed and ignored.
001BD0r 2               ; ---------------------------------------------------------------------------
001BD0r 2               FnFre:
001BD0r 2  20 rr rr             jsr     ParenNum
001BD3r 2  38                   sec
001BD4r 2  AD 65 03             lda     FRETOP
001BD7r 2  ED 63 03             sbc     STREND
001BDAr 2  A8                   tay
001BDBr 2  AD 66 03             lda     FRETOP+1
001BDEr 2  ED 64 03             sbc     STREND+1
001BE1r 2  4C rr rr             jmp     GivAyf
001BE4r 2               
001BE4r 2               ; ---------------------------------------------------------------------------
001BE4r 2               ; FnPos -- POS(n): not yet maintained; returns 0.
001BE4r 2               ; ---------------------------------------------------------------------------
001BE4r 2               FnPos:
001BE4r 2  20 rr rr             jsr     ParenNum
001BE7r 2  A0 00                ldy     #0
001BE9r 2  4C rr rr             jmp     SngFlt
001BECr 2               
001BECr 2               ; ---------------------------------------------------------------------------
001BECr 2               ; FnPeek -- PEEK(addr): byte at addr -> FP.
001BECr 2               ; ---------------------------------------------------------------------------
001BECr 2               FnPeek:
001BECr 2  20 rr rr             jsr     ParenNum
001BEFr 2  20 rr rr             jsr     FacToU16
001BF2r 2  A5 12                lda     FAC+4                   ; lo byte
001BF4r 2  85 20                sta     INDEX
001BF6r 2  A5 11                lda     FAC+3                   ; hi byte
001BF8r 2  85 21                sta     INDEX+1
001BFAr 2  A0 00                ldy     #0
001BFCr 2  B1 20                lda     (INDEX),y
001BFEr 2  A8                   tay
001BFFr 2  4C rr rr             jmp     SngFlt
001C02r 2               
001C02r 2               ; ---------------------------------------------------------------------------
001C02r 2               ; FnJoy -- JOY(n): 1 or 2.  If GPIO absent, returns 0.
001C02r 2               ; ---------------------------------------------------------------------------
001C02r 2               FnJoy:
001C02r 2  20 rr rr             jsr     ParenU8
001C05r 2  48                   pha
001C06r 2  AD 0D 03             lda     HW_PRESENT
001C09r 2  29 20                and     #HW_GPIO
001C0Br 2  F0 1C                beq     @absent
001C0Dr 2  68                   pla
001C0Er 2  C9 01                cmp     #1
001C10r 2  F0 09                beq     @j1
001C12r 2  C9 02                cmp     #2
001C14r 2  F0 0C                beq     @j2
001C16r 2  A2 0B                ldx     #ERR_ILLQUAN
001C18r 2  4C rr rr             jmp     BasErrorVec
001C1Br 2               @j1:
001C1Br 2  20 rr rr             jsr     ReadJoystick1
001C1Er 2  A8                   tay
001C1Fr 2  4C rr rr             jmp     SngFlt
001C22r 2               @j2:
001C22r 2  20 rr rr             jsr     ReadJoystick2
001C25r 2  A8                   tay
001C26r 2  4C rr rr             jmp     SngFlt
001C29r 2               @absent:
001C29r 2  68                   pla
001C2Ar 2  A0 00                ldy     #0
001C2Cr 2  4C rr rr             jmp     SngFlt
001C2Fr 2               
001C2Fr 2               ; ---------------------------------------------------------------------------
001C2Fr 2               ; FnNvram -- NVRAM(addr): if RTC absent, return 0.
001C2Fr 2               ; ---------------------------------------------------------------------------
001C2Fr 2               FnNvram:
001C2Fr 2  20 rr rr             jsr     ParenU8
001C32r 2  48                   pha
001C33r 2  AD 0D 03             lda     HW_PRESENT
001C36r 2  29 04                and     #HW_RTC
001C38r 2  F0 09                beq     @absent
001C3Ar 2  68                   pla
001C3Br 2  AA                   tax
001C3Cr 2  20 rr rr             jsr     RtcReadNVRAM
001C3Fr 2  A8                   tay
001C40r 2  4C rr rr             jmp     SngFlt
001C43r 2               @absent:
001C43r 2  68                   pla
001C44r 2  A0 00                ldy     #0
001C46r 2  4C rr rr             jmp     SngFlt
001C49r 2               
001C49r 2               ; ---------------------------------------------------------------------------
001C49r 2               ; FnMin / FnMax -- two numeric args, smaller / larger.
001C49r 2               ; ---------------------------------------------------------------------------
001C49r 2               FnMin:
001C49r 2  20 rr rr             jsr     MinMaxArgs              ; ARG = a, FAC = b, BAS_TMP3 = sign(b-a)
001C4Cr 2                       ; Want smaller: if b>=a return a (ARG); else return b (FAC).
001C4Cr 2  10 01                bpl     @retArg                 ; sign>=0 means b>=a
001C4Er 2  60                   rts                             ; FAC already = b
001C4Fr 2               @retArg:
001C4Fr 2  4C rr rr             jmp     CopyArgToFac
001C52r 2               FnMax:
001C52r 2  20 rr rr             jsr     MinMaxArgs
001C55r 2                       ; Want larger: if b>=a return b (FAC); else return a (ARG).
001C55r 2  10 03                bpl     @retFac
001C57r 2  4C rr rr             jmp     CopyArgToFac
001C5Ar 2               @retFac:
001C5Ar 2  60                   rts
001C5Br 2               
001C5Br 2               ; MinMaxArgs -- consume "(" a "," b ")" with numerics; ARG=a, FAC=b.
001C5Br 2               ; Returns A = sign(b - a) (FF/00/01) and N flag set accordingly.
001C5Br 2               MinMaxArgs:
001C5Br 2  20 rr rr             jsr     ChkOpn
001C5Er 2  20 rr rr             jsr     FrmEvl
001C61r 2  20 rr rr             jsr     ChkNum
001C64r 2  20 rr rr             jsr     PushFac                 ; save a
001C67r 2  20 rr rr             jsr     ChkCom
001C6Ar 2  20 rr rr             jsr     FrmEvl
001C6Dr 2  20 rr rr             jsr     ChkNum
001C70r 2  20 rr rr             jsr     ChkCls
001C73r 2  20 rr rr             jsr     PullArg                 ; ARG = a, FAC = b
001C76r 2                       ; Stash ARG so we can restore after FComp's destructive sign-pack.
001C76r 2  A5 16                lda     ARG
001C78r 2  85 4D                sta     BAS_TEMP1
001C7Ar 2  A5 17                lda     ARG+1
001C7Cr 2  85 4E                sta     BAS_TEMP1+1
001C7Er 2  A5 18                lda     ARG+2
001C80r 2  85 4F                sta     BAS_TEMP1+2
001C82r 2  A5 19                lda     ARG+3
001C84r 2  85 50                sta     BAS_TEMP1+3
001C86r 2  A5 1A                lda     ARG+4
001C88r 2  85 51                sta     BAS_TEMP1+4
001C8Ar 2  A5 1B                lda     ARGSIGN
001C8Cr 2  85 52                sta     BAS_TEMP1+5
001C8Er 2                       ; Pack ARGSIGN into bit 7 of ARG+1 so FComp reads it correctly.
001C8Er 2  A5 1B                lda     ARGSIGN
001C90r 2  09 7F                ora     #$7F
001C92r 2  25 17                and     ARG+1
001C94r 2  85 17                sta     ARG+1
001C96r 2  A9 16                lda     #<ARG
001C98r 2  A0 00                ldy     #$00
001C9Ar 2  20 rr rr             jsr     FComp                   ; A = sign(FAC - ARG)
001C9Dr 2  48                   pha
001C9Er 2                       ; Restore ARG.
001C9Er 2  A5 4D                lda     BAS_TEMP1
001CA0r 2  85 16                sta     ARG
001CA2r 2  A5 4E                lda     BAS_TEMP1+1
001CA4r 2  85 17                sta     ARG+1
001CA6r 2  A5 4F                lda     BAS_TEMP1+2
001CA8r 2  85 18                sta     ARG+2
001CAAr 2  A5 50                lda     BAS_TEMP1+3
001CACr 2  85 19                sta     ARG+3
001CAEr 2  A5 51                lda     BAS_TEMP1+4
001CB0r 2  85 1A                sta     ARG+4
001CB2r 2  A5 52                lda     BAS_TEMP1+5
001CB4r 2  85 1B                sta     ARGSIGN
001CB6r 2  68                   pla                             ; restore A, sets N/Z flags
001CB7r 2  60                   rts
001CB8r 2               
001CB8r 2               ; ---------------------------------------------------------------------------
001CB8r 2               ; FnLen -- LEN(s$): length of string.
001CB8r 2               ; ---------------------------------------------------------------------------
001CB8r 2               FnLen:
001CB8r 2  20 rr rr             jsr     ParenStr
001CBBr 2  A5 0E                lda     FAC                     ; length
001CBDr 2  48                   pha                             ; FreFac returns with Y = descriptor hi
001CBEr 2  20 rr rr             jsr     FreFac                  ; release temp string if any
001CC1r 2  68                   pla
001CC2r 2  A8                   tay
001CC3r 2  4C rr rr             jmp     SngFlt
001CC6r 2               
001CC6r 2               ; ---------------------------------------------------------------------------
001CC6r 2               ; FnAsc -- ASC(s$): code of first char; ?ILLQTY if empty.
001CC6r 2               ; ---------------------------------------------------------------------------
001CC6r 2               FnAsc:
001CC6r 2  20 rr rr             jsr     ParenStr
001CC9r 2  A5 0E                lda     FAC
001CCBr 2  F0 15                beq     @bad
001CCDr 2                       ; Read first byte of string.
001CCDr 2  A5 0F                lda     FAC+1
001CCFr 2  85 20                sta     INDEX
001CD1r 2  A5 10                lda     FAC+2
001CD3r 2  85 21                sta     INDEX+1
001CD5r 2  A0 00                ldy     #0
001CD7r 2  B1 20                lda     (INDEX),y
001CD9r 2  48                   pha
001CDAr 2  20 rr rr             jsr     FreFac
001CDDr 2  68                   pla
001CDEr 2  A8                   tay
001CDFr 2  4C rr rr             jmp     SngFlt
001CE2r 2               @bad:
001CE2r 2  4C rr rr             jmp     IqErr
001CE5r 2               
001CE5r 2               ; ---------------------------------------------------------------------------
001CE5r 2               ; FnChrStr -- CHR$(n): 1-char string.
001CE5r 2               ; ---------------------------------------------------------------------------
001CE5r 2               FnChrStr:
001CE5r 2  20 rr rr             jsr     ParenU8
001CE8r 2  48                   pha
001CE9r 2  A9 01                lda     #1
001CEBr 2  20 rr rr             jsr     GetSpa                  ; (Y,X) = addr; A unchanged
001CEEr 2  68                   pla
001CEFr 2  A0 00                ldy     #0
001CF1r 2  91 84                sta     (FRESPC),y
001CF3r 2                       ; Build descriptor in FAC.
001CF3r 2  A9 01                lda     #1
001CF5r 2  85 0E                sta     FAC
001CF7r 2  A5 84                lda     FRESPC
001CF9r 2  85 0F                sta     FAC+1
001CFBr 2  A5 85                lda     FRESPC+1
001CFDr 2  85 10                sta     FAC+2
001CFFr 2                       ; Advance FRESPC past the byte we just wrote.
001CFFr 2  E6 84                inc     FRESPC
001D01r 2  D0 02                bne     @nb
001D03r 2  E6 85                inc     FRESPC+1
001D05r 2               @nb:
001D05r 2  4C rr rr             jmp     PutNew
001D08r 2               
001D08r 2               ; ---------------------------------------------------------------------------
001D08r 2               ; FnStrStr -- STR$(n): convert numeric to string.
001D08r 2               ; ---------------------------------------------------------------------------
001D08r 2               FnStrStr:
001D08r 2  20 rr rr             jsr     ParenNum
001D0Br 2  20 rr rr             jsr     Fout                    ; A=lo, Y=hi -> NUL-terminated buffer
001D0Er 2                       ; (A,Y) = pointer to NUL-terminated ASCII number string in STACK2.
001D0Er 2  20 rr rr             jsr     StrLit                  ; allocates + copies + PutNew
001D11r 2  60                   rts
001D12r 2               
001D12r 2               ; ---------------------------------------------------------------------------
001D12r 2               ; FnVal -- VAL(s$): parse leading numeric from string.
001D12r 2               ; Temporarily NUL-terminates the string in place, redirects TXTPTR, calls
001D12r 2               ; Fin, then restores.
001D12r 2               ; ---------------------------------------------------------------------------
001D12r 2               FnVal:
001D12r 2  20 rr rr             jsr     ParenStr
001D15r 2  A5 0E                lda     FAC
001D17r 2  D0 08                bne     @nz
001D19r 2                       ; empty string -> 0
001D19r 2  20 rr rr             jsr     FreFac
001D1Cr 2  64 64                stz     VALTYP                  ; result is numeric (ParenStr set $FF)
001D1Er 2  4C rr rr             jmp     ZeroFac
001D21r 2               @nz:
001D21r 2                       ; Stash length, address into TEMP1..TEMP1+2.
001D21r 2  85 4D                sta     TEMP1                   ; length
001D23r 2  A5 0F                lda     FAC+1
001D25r 2  85 4E                sta     TEMP1+1
001D27r 2  A5 10                lda     FAC+2
001D29r 2  85 4F                sta     TEMP1+2
001D2Br 2                       ; Save the byte at offset = length and replace with $00.
001D2Br 2  A5 4E                lda     TEMP1+1
001D2Dr 2  85 20                sta     INDEX
001D2Fr 2  A5 4F                lda     TEMP1+2
001D31r 2  85 21                sta     INDEX+1
001D33r 2  A4 4D                ldy     TEMP1
001D35r 2  B1 20                lda     (INDEX),y
001D37r 2  85 50                sta     TEMP1+3                 ; saved byte
001D39r 2  A9 00                lda     #0
001D3Br 2  91 20                sta     (INDEX),y
001D3Dr 2                       ; Save TXTPTR.
001D3Dr 2  A5 04                lda     TXTPTR
001D3Fr 2  48                   pha
001D40r 2  A5 05                lda     TXTPTR+1
001D42r 2  48                   pha
001D43r 2                       ; TXTPTR := INDEX - 1, then ChrGet to load first char.
001D43r 2  A5 4E                lda     TEMP1+1
001D45r 2  85 04                sta     TXTPTR
001D47r 2  A5 4F                lda     TEMP1+2
001D49r 2  85 05                sta     TXTPTR+1
001D4Br 2  A5 04                lda     TXTPTR
001D4Dr 2  D0 02                bne     @nb
001D4Fr 2  C6 05                dec     TXTPTR+1
001D51r 2               @nb:
001D51r 2  C6 04                dec     TXTPTR
001D53r 2  20 rr rr             jsr     ChrGet                  ; first char
001D56r 2  20 rr rr             jsr     Fin                     ; FAC := value
001D59r 2                       ; Restore the saved byte.
001D59r 2  A5 4E                lda     TEMP1+1
001D5Br 2  85 20                sta     INDEX
001D5Dr 2  A5 4F                lda     TEMP1+2
001D5Fr 2  85 21                sta     INDEX+1
001D61r 2  A4 4D                ldy     TEMP1
001D63r 2  A5 50                lda     TEMP1+3
001D65r 2  91 20                sta     (INDEX),y
001D67r 2                       ; Restore TXTPTR.
001D67r 2  68                   pla
001D68r 2  85 05                sta     TXTPTR+1
001D6Ar 2  68                   pla
001D6Br 2  85 04                sta     TXTPTR
001D6Dr 2  64 64                stz     VALTYP                  ; Fin left VALTYP = $FF from ParenStr
001D6Fr 2  60                   rts
001D70r 2               
001D70r 2               ; ---------------------------------------------------------------------------
001D70r 2               ; FnLeftStr -- LEFT$(s$, n): leftmost n chars.
001D70r 2               ; ---------------------------------------------------------------------------
001D70r 2               FnLeftStr:
001D70r 2  20 rr rr             jsr     ChkOpn
001D73r 2  20 rr rr             jsr     FrmEvl
001D76r 2  20 rr rr             jsr     ChkStr
001D79r 2  20 rr rr             jsr     ChkCom
001D7Cr 2  20 rr rr             jsr     PushFac                 ; save string descriptor
001D7Fr 2  20 rr rr             jsr     FrmEvl
001D82r 2  20 rr rr             jsr     ChkNum
001D85r 2  20 rr rr             jsr     ChkCls
001D88r 2  20 rr rr             jsr     AyInt
001D8Br 2  20 rr rr             jsr     PullArg                 ; ARG = string descriptor (BAS_TMP1 clobbered)
001D8Er 2                       ; FAC still holds the integer n; check range and copy now.
001D8Er 2  A5 11                lda     FAC+3
001D90r 2  D0 16                bne     @bad
001D92r 2  A5 12                lda     FAC+4
001D94r 2  85 3B                sta     BAS_TMP1+1              ; n
001D96r 2                       ; Clamp n to ARG (length).
001D96r 2  A5 3B                lda     BAS_TMP1+1
001D98r 2  C5 16                cmp     ARG
001D9Ar 2  90 02                bcc     @ok
001D9Cr 2  A5 16                lda     ARG
001D9Er 2               @ok:
001D9Er 2  85 3B                sta     BAS_TMP1+1
001DA0r 2                       ; Free the source temp BEFORE allocating result so the slot frees up.
001DA0r 2  20 rr rr             jsr     FreeArgString
001DA3r 2                       ; Offset = 0 for LEFT$.
001DA3r 2  64 3A                stz     BAS_TMP1
001DA5r 2                       ; Allocate, copy first n bytes.
001DA5r 2  4C rr rr             jmp     SubstrCommon            ; tail-call (rts to caller)
001DA8r 2               @bad:
001DA8r 2  4C rr rr             jmp     IqErr
001DABr 2               
001DABr 2               ; ---------------------------------------------------------------------------
001DABr 2               ; FnRightStr -- RIGHT$(s$, n): rightmost n chars.
001DABr 2               ; ---------------------------------------------------------------------------
001DABr 2               FnRightStr:
001DABr 2  20 rr rr             jsr     ChkOpn
001DAEr 2  20 rr rr             jsr     FrmEvl
001DB1r 2  20 rr rr             jsr     ChkStr
001DB4r 2  20 rr rr             jsr     ChkCom
001DB7r 2  20 rr rr             jsr     PushFac
001DBAr 2  20 rr rr             jsr     FrmEvl
001DBDr 2  20 rr rr             jsr     ChkNum
001DC0r 2  20 rr rr             jsr     ChkCls
001DC3r 2  20 rr rr             jsr     AyInt
001DC6r 2  20 rr rr             jsr     PullArg                 ; ARG = string descriptor (BAS_TMP1 clobbered)
001DC9r 2  A5 11                lda     FAC+3
001DCBr 2  D0 1B                bne     @bad
001DCDr 2  A5 12                lda     FAC+4
001DCFr 2  85 3B                sta     BAS_TMP1+1              ; n
001DD1r 2                       ; Clamp n.
001DD1r 2  A5 3B                lda     BAS_TMP1+1
001DD3r 2  C5 16                cmp     ARG
001DD5r 2  90 02                bcc     @ok
001DD7r 2  A5 16                lda     ARG
001DD9r 2               @ok:
001DD9r 2  85 3B                sta     BAS_TMP1+1
001DDBr 2                       ; offset = ARG - n.
001DDBr 2  A5 16                lda     ARG
001DDDr 2  38                   sec
001DDEr 2  E5 3B                sbc     BAS_TMP1+1
001DE0r 2  85 3A                sta     BAS_TMP1                ; start offset
001DE2r 2  20 rr rr             jsr     FreeArgString
001DE5r 2  4C rr rr             jmp     SubstrCommon
001DE8r 2               @bad:
001DE8r 2  4C rr rr             jmp     IqErr
001DEBr 2               
001DEBr 2               ; ---------------------------------------------------------------------------
001DEBr 2               ; FnMidStr -- MID$(s$, m [, n]): substring starting at m (1-based).
001DEBr 2               ; ---------------------------------------------------------------------------
001DEBr 2               FnMidStr:
001DEBr 2  20 rr rr             jsr     ChkOpn
001DEEr 2  20 rr rr             jsr     FrmEvl
001DF1r 2  20 rr rr             jsr     ChkStr
001DF4r 2  20 rr rr             jsr     ChkCom
001DF7r 2  20 rr rr             jsr     PushFac
001DFAr 2                       ; Read m.
001DFAr 2  20 rr rr             jsr     FrmEvl
001DFDr 2  20 rr rr             jsr     ChkNum
001E00r 2  20 rr rr             jsr     AyInt
001E03r 2  A5 11                lda     FAC+3
001E05r 2  D0 4B                bne     @bad
001E07r 2  A5 12                lda     FAC+4
001E09r 2  F0 47                beq     @bad                    ; m must be >= 1
001E0Br 2  38                   sec
001E0Cr 2  E9 01                sbc     #1
001E0Er 2  48                   pha                             ; offset = m-1; FrmEvl below would
001E0Fr 2                                                       ; clobber BAS_TMP1, so park it here
001E0Fr 2                       ; Optional ", n".
001E0Fr 2  20 rr rr             jsr     ChrGot
001E12r 2  C9 2C                cmp     #','
001E14r 2  F0 04                beq     @hasN
001E16r 2                       ; No n: take rest -> n = 255 (will clamp).
001E16r 2  A9 FF                lda     #255
001E18r 2  80 12                bra     @gotN
001E1Ar 2               @hasN:
001E1Ar 2  20 rr rr             jsr     ChrGet
001E1Dr 2  20 rr rr             jsr     FrmEvl
001E20r 2  20 rr rr             jsr     ChkNum
001E23r 2  20 rr rr             jsr     AyInt
001E26r 2  A5 11                lda     FAC+3
001E28r 2  D0 28                bne     @bad
001E2Ar 2  A5 12                lda     FAC+4
001E2Cr 2               @gotN:
001E2Cr 2  85 3B                sta     BAS_TMP1+1
001E2Er 2  68                   pla
001E2Fr 2  85 3A                sta     BAS_TMP1
001E31r 2  20 rr rr             jsr     ChkCls
001E34r 2  20 rr rr             jsr     PullArg                 ; ARG = string
001E37r 2                       ; Clamp offset to length.
001E37r 2  A5 3A                lda     BAS_TMP1
001E39r 2  C5 16                cmp     ARG
001E3Br 2  90 04                bcc     @offOk
001E3Dr 2  A5 16                lda     ARG                     ; offset = length -> empty result
001E3Fr 2  85 3A                sta     BAS_TMP1
001E41r 2               @offOk:
001E41r 2                       ; Clamp n to (length - offset).
001E41r 2  38                   sec
001E42r 2  A5 16                lda     ARG
001E44r 2  E5 3A                sbc     BAS_TMP1
001E46r 2  C5 3B                cmp     BAS_TMP1+1
001E48r 2  B0 02                bcs     @nOk
001E4Ar 2  85 3B                sta     BAS_TMP1+1
001E4Cr 2               @nOk:
001E4Cr 2  20 rr rr             jsr     FreeArgString
001E4Fr 2  4C rr rr             jmp     SubstrCommon
001E52r 2               @bad:
001E52r 2  4C rr rr             jmp     IqErr
001E55r 2               
001E55r 2               ; ---------------------------------------------------------------------------
001E55r 2               ; SubstrCommon -- copy BAS_TMP1+1 bytes from ARG-string at offset BAS_TMP1
001E55r 2               ; into a new heap allocation; result descriptor in FAC; PutNew.
001E55r 2               ; ---------------------------------------------------------------------------
001E55r 2               SubstrCommon:
001E55r 2                       ; Allocate.
001E55r 2  A5 3B                lda     BAS_TMP1+1
001E57r 2  20 rr rr             jsr     GetSpa                  ; FRESPC = new buffer
001E5Ar 2                       ; Source pointer = ARG+1 (lo/hi) + BAS_TMP1.
001E5Ar 2  18                   clc
001E5Br 2  A5 17                lda     ARG+1
001E5Dr 2  65 3A                adc     BAS_TMP1
001E5Fr 2  85 20                sta     INDEX
001E61r 2  A5 18                lda     ARG+2
001E63r 2  69 00                adc     #0
001E65r 2  85 21                sta     INDEX+1
001E67r 2                       ; Copy BAS_TMP1+1 bytes from (INDEX) to (FRESPC).
001E67r 2  A4 3B                ldy     BAS_TMP1+1
001E69r 2  F0 0B                beq     @done
001E6Br 2  A0 00                ldy     #0
001E6Dr 2               @cp:
001E6Dr 2  B1 20                lda     (INDEX),y
001E6Fr 2  91 84                sta     (FRESPC),y
001E71r 2  C8                   iny
001E72r 2  C4 3B                cpy     BAS_TMP1+1
001E74r 2  D0 F7                bne     @cp
001E76r 2               @done:
001E76r 2                       ; Build descriptor.
001E76r 2  A5 3B                lda     BAS_TMP1+1
001E78r 2  85 0E                sta     FAC
001E7Ar 2  A5 84                lda     FRESPC
001E7Cr 2  85 0F                sta     FAC+1
001E7Er 2  A5 85                lda     FRESPC+1
001E80r 2  85 10                sta     FAC+2
001E82r 2                       ; Advance FRESPC by length consumed.
001E82r 2  18                   clc
001E83r 2  A5 84                lda     FRESPC
001E85r 2  65 3B                adc     BAS_TMP1+1
001E87r 2  85 84                sta     FRESPC
001E89r 2  90 02                bcc     @nb
001E8Br 2  E6 85                inc     FRESPC+1
001E8Dr 2               @nb:
001E8Dr 2  4C rr rr             jmp     PutNew
001E90r 2               
001E90r 2               ; FreeArgString -- if ARG holds a temp string descriptor (most-recent
001E90r 2               ; on TEMPST), pop just the descriptor.  Heap is left intact so callers
001E90r 2               ; that still need the source bytes can copy them safely; orphaned heap
001E90r 2               ; will be reclaimed by Garbag.
001E90r 2               FreeArgString:
001E90r 2  A5 19                lda     ARG+3                   ; descriptor address lo
001E92r 2  A4 1A                ldy     ARG+4                   ; descriptor address hi (always $00)
001E94r 2  4C rr rr             jmp     FreTms
001E97r 2               
001E97r 2               ; Cleanup that releases both ARG's and FAC's temp descriptors (called from
001E97r 2               ; CatStr after content has been stashed but before new allocation).
001E97r 2               FreeBothTemps:
001E97r 2                       ; Free FAC's temp first (it is currently LASTPT).
001E97r 2  A5 11                lda     FAC+3
001E99r 2  A4 12                ldy     FAC+4
001E9Br 2  20 rr rr             jsr     FreTms
001E9Er 2                       ; Then ARG's (now LASTPT after FAC's removal).
001E9Er 2  A5 19                lda     ARG+3
001EA0r 2  A4 1A                ldy     ARG+4
001EA2r 2  4C rr rr             jmp     FreTms
001EA5r 2  60                   rts
001EA6r 2               
001EA6r 2               ; ===========================================================================
001EA6r 2               ;   E V A L U A T O R   -   B I N A R Y   O P E R A T O R   H E L P E R S
001EA6r 2               ; ===========================================================================
001EA6r 2               
001EA6r 2               ; ---------------------------------------------------------------------------
001EA6r 2               ; AndOp -- FAC = ARG AND FAC (bitwise on 16-bit signed ints).
001EA6r 2               ; ---------------------------------------------------------------------------
001EA6r 2               AndOp:
001EA6r 2  20 rr rr             jsr     AyInt                   ; FAC -> int (FAC+3=hi, FAC+4=lo)
001EA9r 2  A5 11                lda     FAC+3
001EABr 2  85 3A                sta     BAS_TMP1                ; saved hi
001EADr 2  A5 12                lda     FAC+4
001EAFr 2  85 3B                sta     BAS_TMP1+1              ; saved lo
001EB1r 2  20 rr rr             jsr     CopyArgToFac
001EB4r 2  20 rr rr             jsr     AyInt
001EB7r 2  A5 12                lda     FAC+4
001EB9r 2  25 3B                and     BAS_TMP1+1
001EBBr 2  A8                   tay                             ; Y = lo result
001EBCr 2  A5 11                lda     FAC+3
001EBEr 2  25 3A                and     BAS_TMP1                ; A = hi result
001EC0r 2  4C rr rr             jmp     GivAyf
001EC3r 2               
001EC3r 2               ; ---------------------------------------------------------------------------
001EC3r 2               ; OrOp -- FAC = ARG OR FAC.
001EC3r 2               ; ---------------------------------------------------------------------------
001EC3r 2               OrOp:
001EC3r 2  20 rr rr             jsr     AyInt
001EC6r 2  A5 11                lda     FAC+3
001EC8r 2  85 3A                sta     BAS_TMP1                ; saved hi
001ECAr 2  A5 12                lda     FAC+4
001ECCr 2  85 3B                sta     BAS_TMP1+1              ; saved lo
001ECEr 2  20 rr rr             jsr     CopyArgToFac
001ED1r 2  20 rr rr             jsr     AyInt
001ED4r 2  A5 12                lda     FAC+4
001ED6r 2  05 3B                ora     BAS_TMP1+1
001ED8r 2  A8                   tay                             ; Y = lo
001ED9r 2  A5 11                lda     FAC+3
001EDBr 2  05 3A                ora     BAS_TMP1                ; A = hi
001EDDr 2  4C rr rr             jmp     GivAyf
001EE0r 2               
001EE0r 2               ; ---------------------------------------------------------------------------
001EE0r 2               ; NotOp -- FAC = NOT FAC (bitwise complement of 16-bit signed int).
001EE0r 2               ; ---------------------------------------------------------------------------
001EE0r 2               NotOp:
001EE0r 2  20 rr rr             jsr     AyInt
001EE3r 2  A5 12                lda     FAC+4
001EE5r 2  49 FF                eor     #$FF
001EE7r 2  A8                   tay                             ; Y = lo
001EE8r 2  A5 11                lda     FAC+3
001EEAr 2  49 FF                eor     #$FF                    ; A = hi
001EECr 2  4C rr rr             jmp     GivAyf
001EEFr 2               
001EEFr 2               ; ---------------------------------------------------------------------------
001EEFr 2               ; BasCmdLet -- minimal LET (assignment).  Entered with ChrGot returning
001EEFr 2               ; the first letter of the variable name.  No `LET` keyword required.
001EEFr 2               ; ---------------------------------------------------------------------------
001EEFr 2               BasCmdLet:
001EEFr 2  20 rr rr             jsr     PtrGet                  ; VARPNT, VALTYP set; TXTPTR past name
001EF2r 2                       ; Save VARPNT and the variable's VALTYP across FrmEvl.
001EF2r 2  A5 3F                lda     VARPNT
001EF4r 2  48                   pha
001EF5r 2  A5 40                lda     VARPNT+1
001EF7r 2  48                   pha
001EF8r 2  A5 64                lda     VALTYP
001EFAr 2  48                   pha
001EFBr 2  20 rr rr             jsr     ChrGot
001EFEr 2  C9 3D                cmp     #'='
001F00r 2  D0 36                bne     @synErr
001F02r 2  20 rr rr             jsr     ChrGet
001F05r 2  20 rr rr             jsr     FrmEvl
001F08r 2  68                   pla                             ; saved variable VALTYP
001F09r 2  85 3E                sta     BAS_TMP3
001F0Br 2  45 64                eor     VALTYP
001F0Dr 2  30 2F                bmi     @typeErr
001F0Fr 2  68                   pla
001F10r 2  85 40                sta     VARPNT+1
001F12r 2  68                   pla
001F13r 2  85 3F                sta     VARPNT
001F15r 2  24 3E                bit     BAS_TMP3
001F17r 2  30 07                bmi     @storeStr
001F19r 2                       ; Numeric: store FAC into (VARPNT) (5 bytes).
001F19r 2  A6 3F                ldx     VARPNT
001F1Br 2  A4 40                ldy     VARPNT+1
001F1Dr 2  4C rr rr             jmp     StoreFacAtYxRounded
001F20r 2               @storeStr:
001F20r 2  A0 00                ldy     #0
001F22r 2  A5 0E                lda     FAC
001F24r 2  91 3F                sta     (VARPNT),y
001F26r 2  C8                   iny
001F27r 2  A5 0F                lda     FAC+1
001F29r 2  91 3F                sta     (VARPNT),y
001F2Br 2  C8                   iny
001F2Cr 2  A5 10                lda     FAC+2
001F2Er 2  91 3F                sta     (VARPNT),y
001F30r 2                       ; If the RHS was a temporary string (StrLt2/PutNew pushed it and left
001F30r 2                       ; its descriptor address in FAC+3/FAC+4 == LASTPT), pop it now that
001F30r 2                       ; the variable owns the heap copy.  Pop only (FreTms), never FreFac --
001F30r 2                       ; reclaiming would free the string we just stored.  For a plain
001F30r 2                       ; variable RHS, @loadStr set FAC+3/FAC+4 to that variable's address
001F30r 2                       ; (nonzero high byte), which cannot match a temp slot, so FreTms is a
001F30r 2                       ; no-op.  Without this, >3 consecutive string LETs leak the 3-slot
001F30r 2                       ; temp stack (?FORMULA TOO COMPLEX).
001F30r 2  A5 11                lda     FAC+3
001F32r 2  A4 12                ldy     FAC+4
001F34r 2  20 rr rr             jsr     FreTms
001F37r 2  60                   rts
001F38r 2               @synErr:
001F38r 2  68                   pla
001F39r 2  68                   pla
001F3Ar 2  68                   pla
001F3Br 2  4C rr rr             jmp     SynErr
001F3Er 2               @typeErr:
001F3Er 2  68                   pla
001F3Fr 2  68                   pla
001F40r 2  A2 08                ldx     #ERR_TYPEMISM
001F42r 2  4C rr rr             jmp     BasErrorVec
001F45r 2               
001F45r 2               ; =============================================================================
001F45r 2               ;   C O N T R O L   F L O W   /   S T A T E M E N T   L O O P
001F45r 2               ;
001F45r 2               ;   BasNewstt drives execution for both direct mode (TXTPTR in BAS_TOKBUF)
001F45r 2               ;   and run mode (TXTPTR walks program lines from BAS_TXTTAB).  Statement
001F45r 2               ;   dispatch follows the msbasic convention: push (routine_addr - 1) and
001F45r 2               ;   tail-jump through ChrGet, so the routine entry is reached via RTS.
001F45r 2               ;
001F45r 2               ;   FOR and GOSUB store frames on the CPU stack and JMP back to BasNewstt;
001F45r 2               ;   NEXT and RETURN scan the stack for a matching tag, then TXS to discard
001F45r 2               ;   the frame and resume.
001F45r 2               ; =============================================================================
001F45r 2               
001F45r 2               NUM_STMT_TOKENS = TOK_MEM + 1 - TOK_BASE       ; $36 entries
001F45r 2               
001F45r 2               BasNewstt:
001F45r 2  20 rr rr             jsr     BasCheckBreak
001F48r 2                       ; Save TXTPTR -> OLDTEXT for CONT, except in direct mode.
001F48r 2  AD 6A 03             lda     BAS_CURLIN+1
001F4Br 2  C9 FF                cmp     #$FF
001F4Dr 2  F0 0A                beq     @noSave
001F4Fr 2  A5 04                lda     TXTPTR
001F51r 2  8D 6D 03             sta     BAS_OLDTEXT
001F54r 2  A5 05                lda     TXTPTR+1
001F56r 2  8D 6E 03             sta     BAS_OLDTEXT+1
001F59r 2               @noSave:
001F59r 2  A0 00                ldy     #0
001F5Br 2  B1 04                lda     (TXTPTR),y
001F5Dr 2  F0 10                beq     @endLine
001F5Fr 2  C9 A4                cmp     #TOK_ELSE
001F61r 2  F0 07                beq     @skipElse               ; THEN-branch ran; skip ELSE clause to EOL
001F63r 2  C9 3A                cmp     #':'
001F65r 2  F0 34                beq     @nextStmt
001F67r 2  4C rr rr             jmp     SynErr
001F6Ar 2               @skipElse:
001F6Ar 2                       ; Advance TXTPTR until we land on a $00 terminator.
001F6Ar 2               @skLoop:
001F6Ar 2  20 rr rr             jsr     ChrGet
001F6Dr 2  D0 FB                bne     @skLoop
001F6Fr 2                       ; Fall through to @endLine with TXTPTR at $00.
001F6Fr 2               @endLine:
001F6Fr 2                       ; Direct mode: end of buffer -> back to REPL.
001F6Fr 2  AD 6A 03             lda     BAS_CURLIN+1
001F72r 2  C9 FF                cmp     #$FF
001F74r 2  D0 03                bne     @walkNext
001F76r 2  4C rr rr             jmp     BasReadyLoop            ; OK is printed by BasReadyLoop
001F79r 2               @walkNext:
001F79r 2                       ; Run mode: examine next-pointer at offsets +1,+2.
001F79r 2  A0 02                ldy     #2
001F7Br 2  B1 04                lda     (TXTPTR),y
001F7Dr 2  D0 06                bne     @loadLine               ; nonzero hi -> next line exists
001F7Fr 2                       ; End of program -> halt and return to REPL.
001F7Fr 2  A2 FF                ldx     #$FF
001F81r 2  9A                   txs
001F82r 2  4C rr rr             jmp     BasReadyLoop
001F85r 2               @loadLine:
001F85r 2  C8                   iny                             ; y=3
001F86r 2  B1 04                lda     (TXTPTR),y
001F88r 2  8D 69 03             sta     BAS_CURLIN
001F8Br 2  C8                   iny                             ; y=4
001F8Cr 2  B1 04                lda     (TXTPTR),y
001F8Er 2  8D 6A 03             sta     BAS_CURLIN+1
001F91r 2  98                   tya                             ; A=4
001F92r 2  18                   clc
001F93r 2  65 04                adc     TXTPTR
001F95r 2  85 04                sta     TXTPTR
001F97r 2  90 02                bcc     @nextStmt
001F99r 2  E6 05                inc     TXTPTR+1
001F9Br 2               @nextStmt:
001F9Br 2  20 rr rr             jsr     ChrGet
001F9Er 2  20 rr rr             jsr     BasExecuteStatement
001FA1r 2  4C rr rr             jmp     BasNewstt
001FA4r 2               
001FA4r 2               ; ---------------------------------------------------------------------------
001FA4r 2               ; BasExecuteStatement -- A = current tokenized byte (loaded by ChrGet).
001FA4r 2               ;   * A = 0  -> RTS (no-op; end of statement chain).
001FA4r 2               ;   * A < $80 (letter) -> JMP BasCmdLet.
001FA4r 2               ;   * A is a statement token ($80..TOK_MEM) -> dispatch via BasTokenAddrTbl.
001FA4r 2               ;   * Otherwise -> ?SYNTAX ERROR.
001FA4r 2               ; ---------------------------------------------------------------------------
001FA4r 2               BasExecuteStatement:
001FA4r 2  F0 30                beq     @ret
001FA6r 2  38                   sec
001FA7r 2  E9 80                sbc     #TOK_BASE
001FA9r 2  90 25                bcc     @doLet
001FABr 2  C9 36                cmp     #NUM_STMT_TOKENS
001FADr 2  B0 0D                bcs     @ext
001FAFr 2  0A                   asl     a
001FB0r 2  A8                   tay
001FB1r 2  B9 rr rr             lda     BasTokenAddrTbl+1,y
001FB4r 2  48                   pha
001FB5r 2  B9 rr rr             lda     BasTokenAddrTbl,y
001FB8r 2  48                   pha
001FB9r 2  4C rr rr             jmp     ChrGet
001FBCr 2               @ext:
001FBCr 2                       ; Extended statement tokens DISK/BLOAD/BSAVE/FORMAT ($D1-$D4).
001FBCr 2                       ; Bodies live in the Kernal via BasExtAddrTbl (thin-BASIC strategy).
001FBCr 2  38                   sec
001FBDr 2  E9 51                sbc     #(TOK_DISK - TOK_BASE)
001FBFr 2  C9 04                cmp     #4
001FC1r 2  B0 10                bcs     @synErr
001FC3r 2  0A                   asl     a
001FC4r 2  A8                   tay
001FC5r 2  B9 rr rr             lda     BasExtAddrTbl+1,y
001FC8r 2  48                   pha
001FC9r 2  B9 rr rr             lda     BasExtAddrTbl,y
001FCCr 2  48                   pha
001FCDr 2  4C rr rr             jmp     ChrGet
001FD0r 2               @doLet:
001FD0r 2  4C rr rr             jmp     BasCmdLet
001FD3r 2               @synErr:
001FD3r 2  4C rr rr             jmp     SynErr
001FD6r 2               @ret:
001FD6r 2  60                   rts
001FD7r 2               
001FD7r 2               ; ---------------------------------------------------------------------------
001FD7r 2               ; BasCheckBreak -- poll input buffer for Ctrl-C / ESC.  On break, save
001FD7r 2               ; CONT context and bounce to REPL.  Other keys are stashed in BAS_PENDKEY
001FD7r 2               ; for INKEY to retrieve.
001FD7r 2               ; ---------------------------------------------------------------------------
001FD7r 2               BasCheckBreak:
001FD7r 2                       ; In direct mode (CURLIN hi == $FF) skip the break check entirely;
001FD7r 2                       ; otherwise we would drain pending REPL keystrokes and corrupt the
001FD7r 2                       ; next BasReadLine input.  Break is only meaningful while RUNning.
001FD7r 2  AD 6A 03             lda     BAS_CURLIN+1
001FDAr 2  C9 FF                cmp     #$FF
001FDCr 2  F0 13                beq     @no
001FDEr 2  20 rr rr             jsr     BufferSize
001FE1r 2  F0 0E                beq     @no
001FE3r 2  20 rr rr             jsr     ReadBuffer
001FE6r 2  C9 03                cmp     #$03
001FE8r 2  F0 08                beq     @break
001FEAr 2  C9 1B                cmp     #$1B
001FECr 2  F0 04                beq     @break
001FEEr 2  8D 0E 03             sta     BAS_PENDKEY
001FF1r 2               @no:
001FF1r 2  60                   rts
001FF2r 2               @break:
001FF2r 2                       ; OLDLIN/OLDTEXT already track the executing line.  Make sure the
001FF2r 2                       ; saved values reflect the current line so CONT can resume.
001FF2r 2  AD 69 03             lda     BAS_CURLIN
001FF5r 2  8D 6B 03             sta     BAS_OLDLIN
001FF8r 2  AD 6A 03             lda     BAS_CURLIN+1
001FFBr 2  8D 6C 03             sta     BAS_OLDLIN+1
001FFEr 2  A2 FF                ldx     #$FF
002000r 2  9A                   txs
002001r 2  20 rr rr             jsr     BasPrintCRLF
002004r 2  A9 rr                lda     #<MsgBreak
002006r 2  A0 rr                ldy     #>MsgBreak
002008r 2  20 rr rr             jsr     BasPrintStr
00200Br 2  AD 6A 03             lda     BAS_CURLIN+1
00200Er 2  C9 FF                cmp     #$FF
002010r 2  F0 14                beq     @noLine
002012r 2  A9 rr                lda     #<MsgInWord
002014r 2  A0 rr                ldy     #>MsgInWord
002016r 2  20 rr rr             jsr     BasPrintStr
002019r 2  AD 69 03             lda     BAS_CURLIN
00201Cr 2  85 08                sta     BAS_LINNUM
00201Er 2  AD 6A 03             lda     BAS_CURLIN+1
002021r 2  85 09                sta     BAS_LINNUM+1
002023r 2  20 rr rr             jsr     BasPrintLineNum
002026r 2               @noLine:
002026r 2  A9 FF                lda     #$FF
002028r 2  8D 69 03             sta     BAS_CURLIN
00202Br 2  8D 6A 03             sta     BAS_CURLIN+1
00202Er 2  4C rr rr             jmp     BasReadyLoop
002031r 2               
002031r 2  42 52 45 41  MsgBreak: .byte "BREAK",0
002035r 2  4B 00        
002037r 2               
002037r 2               ; ---------------------------------------------------------------------------
002037r 2               ; LinGet -- parse decimal digits at TXTPTR into BAS_LINNUM (16-bit).
002037r 2               ; Caller has set carry conditions appropriate to ChrGet entry.  TXTPTR
002037r 2               ; ends pointing at the first non-digit.
002037r 2               ; ---------------------------------------------------------------------------
002037r 2               LinGet:
002037r 2  A2 00                ldx     #0
002039r 2  86 08                stx     BAS_LINNUM
00203Br 2  86 09                stx     BAS_LINNUM+1
00203Dr 2               @loop:
00203Dr 2  B0 3A                bcs     @done
00203Fr 2  E9 2F                sbc     #$2F                    ; carry already set
002041r 2  85 44                sta     CHARAC
002043r 2                       ; LINNUM *= 10
002043r 2  A5 08                lda     BAS_LINNUM
002045r 2  85 3A                sta     BAS_TMP1
002047r 2  A5 09                lda     BAS_LINNUM+1
002049r 2  85 3B                sta     BAS_TMP1+1
00204Br 2  C9 19                cmp     #$19
00204Dr 2  B0 2B                bcs     @ovf
00204Fr 2  06 08                asl     BAS_LINNUM
002051r 2  26 09                rol     BAS_LINNUM+1
002053r 2  06 08                asl     BAS_LINNUM
002055r 2  26 09                rol     BAS_LINNUM+1
002057r 2  18                   clc
002058r 2  A5 08                lda     BAS_LINNUM
00205Ar 2  65 3A                adc     BAS_TMP1
00205Cr 2  85 08                sta     BAS_LINNUM
00205Er 2  A5 09                lda     BAS_LINNUM+1
002060r 2  65 3B                adc     BAS_TMP1+1
002062r 2  85 09                sta     BAS_LINNUM+1
002064r 2  06 08                asl     BAS_LINNUM
002066r 2  26 09                rol     BAS_LINNUM+1
002068r 2  18                   clc
002069r 2  A5 08                lda     BAS_LINNUM
00206Br 2  65 44                adc     CHARAC
00206Dr 2  85 08                sta     BAS_LINNUM
00206Fr 2  90 02                bcc     @nextDigit
002071r 2  E6 09                inc     BAS_LINNUM+1
002073r 2               @nextDigit:
002073r 2  20 rr rr             jsr     ChrGet
002076r 2  4C rr rr             jmp     @loop
002079r 2               @done:
002079r 2  60                   rts
00207Ar 2               @ovf:
00207Ar 2  A2 00                ldx     #ERR_SYNTAX
00207Cr 2  4C rr rr             jmp     BasErrorVec
00207Fr 2               
00207Fr 2               ; ---------------------------------------------------------------------------
00207Fr 2               ; FndLin -- find program line whose number matches BAS_LINNUM.
00207Fr 2               ;   On success: carry SET, BAS_TMP1 (LOWTR alias) = address of line.
00207Fr 2               ;   On failure: carry CLEAR, BAS_TMP1 = address where line would belong.
00207Fr 2               ; ---------------------------------------------------------------------------
00207Fr 2               FndLin:
00207Fr 2  AD 5D 03             lda     BAS_TXTTAB
002082r 2  AE 5E 03             ldx     BAS_TXTTAB+1
002085r 2               @walk:
002085r 2  85 3A                sta     BAS_TMP1
002087r 2  86 3B                stx     BAS_TMP1+1
002089r 2  A0 01                ldy     #1
00208Br 2  B1 3A                lda     (BAS_TMP1),y
00208Dr 2  F0 20                beq     @notFound               ; next-hi=0 -> end of program
00208Fr 2  A0 03                ldy     #3                      ; line-num-lo offset
002091r 2  A5 09                lda     BAS_LINNUM+1
002093r 2  D1 3A                cmp     (BAS_TMP1),y            ; compare hi byte at +3? need iny
002095r 2                       ; Actually format: +0 next-lo, +1 next-hi, +2 num-lo, +3 num-hi
002095r 2  90 18                bcc     @notFound               ; LINNUM-hi < line-hi -> miss
002097r 2  D0 09                bne     @advance                ; LINNUM-hi > line-hi -> next line
002099r 2  88                   dey                             ; y=2 = num-lo
00209Ar 2  A5 08                lda     BAS_LINNUM
00209Cr 2  D1 3A                cmp     (BAS_TMP1),y
00209Er 2  90 0F                bcc     @notFound
0020A0r 2  F0 0F                beq     @found
0020A2r 2               @advance:
0020A2r 2  A0 00                ldy     #0
0020A4r 2  B1 3A                lda     (BAS_TMP1),y
0020A6r 2  48                   pha
0020A7r 2  A0 01                ldy     #1
0020A9r 2  B1 3A                lda     (BAS_TMP1),y
0020ABr 2  AA                   tax
0020ACr 2  68                   pla
0020ADr 2  B0 D6                bcs     @walk                   ; carry=1 means continue (always)
0020AFr 2               @notFound:
0020AFr 2  18                   clc
0020B0r 2  60                   rts
0020B1r 2               @found:
0020B1r 2  38                   sec
0020B2r 2  60                   rts
0020B3r 2               
0020B3r 2               ; ---------------------------------------------------------------------------
0020B3r 2               ; BasCmdGoto -- TXTPTR points at line-number digits.
0020B3r 2               ; ---------------------------------------------------------------------------
0020B3r 2               BasCmdGoto:
0020B3r 2  20 rr rr             jsr     LinGet
0020B6r 2  20 rr rr             jsr     BasRemn                 ; skip remainder of statement
0020B9r 2  20 rr rr             jsr     FndLin
0020BCr 2  90 0E                bcc     @undef
0020BEr 2                       ; LOWTR (BAS_TMP1) = target line addr.  TXTPTR = LOWTR - 1
0020BEr 2                       ; (so NEWSTT sees the previous line's $00 terminator at offset 0).
0020BEr 2  38                   sec
0020BFr 2  A5 3A                lda     BAS_TMP1
0020C1r 2  E9 01                sbc     #1
0020C3r 2  85 04                sta     TXTPTR
0020C5r 2  A5 3B                lda     BAS_TMP1+1
0020C7r 2  E9 00                sbc     #0
0020C9r 2  85 05                sta     TXTPTR+1
0020CBr 2  60                   rts
0020CCr 2               @undef:
0020CCr 2  A2 03                ldx     #ERR_UNDEFSTMT
0020CEr 2  4C rr rr             jmp     BasErrorVec
0020D1r 2               
0020D1r 2               ; ---------------------------------------------------------------------------
0020D1r 2               ; BasCmdGosub -- push 5-byte frame on stack, then GOTO target.
0020D1r 2               ; Frame layout (top-down): [tag $8C][CURLIN-lo][CURLIN-hi][TXTPTR-lo][TXTPTR-hi]
0020D1r 2               ; ---------------------------------------------------------------------------
0020D1r 2               BasCmdGosub:
0020D1r 2                       ; Refuse to nest deeper than page 1 can hold.  msbasic guards every
0020D1r 2                       ; stack-frame push with GETSTK; this is that check specialised to
0020D1r 2                       ; GOSUB's fixed frame (msbasic's `LDA #3 : JSR GETSTK`, i.e. 3*2
0020D1r 2                       ; bytes of frame plus GETSTK's $3E-byte margin for the interpreter's
0020D1r 2                       ; own JSR nesting inside the subroutine).  Without it the frames run
0020D1r 2                       ; off the bottom of the stack and corrupt page 1 instead of raising
0020D1r 2                       ; an error.
0020D1r 2  BA                   tsx
0020D2r 2  E0 44                cpx     #GOSUB_STACK_MIN
0020D4r 2  90 1A                bcc     @outOfMemory
0020D6r 2  A5 05                lda     TXTPTR+1
0020D8r 2  48                   pha
0020D9r 2  A5 04                lda     TXTPTR
0020DBr 2  48                   pha
0020DCr 2  AD 6A 03             lda     BAS_CURLIN+1
0020DFr 2  48                   pha
0020E0r 2  AD 69 03             lda     BAS_CURLIN
0020E3r 2  48                   pha
0020E4r 2  A9 8C                lda     #TOK_GOSUB
0020E6r 2  48                   pha
0020E7r 2  20 rr rr             jsr     ChrGot
0020EAr 2  20 rr rr             jsr     BasCmdGoto
0020EDr 2  4C rr rr             jmp     BasNewstt
0020F0r 2               @outOfMemory:
0020F0r 2  A9 02                lda     #ERR_OUTOFMEM
0020F2r 2  4C rr rr             jmp     BasError
0020F5r 2               
0020F5r 2               ; ---------------------------------------------------------------------------
0020F5r 2               ; BasCmdReturn -- locate GOSUB frame on stack and resume at saved TXTPTR.
0020F5r 2               ; Per msbasic: scan the CPU stack from SP+5 (skipping return-routine's caller
0020F5r 2               ; return + this scan's own JSR return).  RTS at end pops the leaked
0020F5r 2               ; EXEC-return that GOSUB left behind.
0020F5r 2               ; ---------------------------------------------------------------------------
0020F5r 2               BasCmdReturn:
0020F5r 2  20 rr rr             jsr     GtForPnt
0020F8r 2                       ; X now points to the slot just BELOW a frame tag (or end of stack).
0020F8r 2  9A                   txs
0020F9r 2  C9 8C                cmp     #TOK_GOSUB
0020FBr 2  F0 05                beq     @ok
0020FDr 2  A2 0C                ldx     #ERR_RG
0020FFr 2  4C rr rr             jmp     BasErrorVec
002102r 2               @ok:
002102r 2  68                   pla                             ; tag (already in A, this discards)
002103r 2  68                   pla
002104r 2  8D 69 03             sta     BAS_CURLIN
002107r 2  68                   pla
002108r 2  8D 6A 03             sta     BAS_CURLIN+1
00210Br 2  68                   pla
00210Cr 2  85 04                sta     TXTPTR
00210Er 2  68                   pla
00210Fr 2  85 05                sta     TXTPTR+1
002111r 2                       ; Skip remainder of GOSUB-target statement (DATAN-style).
002111r 2  20 rr rr             jsr     BasDatan
002114r 2                       ; Advance TXTPTR by Y (number of bytes to terminator).
002114r 2  98                   tya
002115r 2  18                   clc
002116r 2  65 04                adc     TXTPTR
002118r 2  85 04                sta     TXTPTR
00211Ar 2  90 02                bcc     @noinc
00211Cr 2  E6 05                inc     TXTPTR+1
00211Er 2               @noinc:
00211Er 2  60                   rts
00211Fr 2               
00211Fr 2               ; ---------------------------------------------------------------------------
00211Fr 2               ; GtForPnt -- scan CPU stack for FOR/GOSUB frames.
00211Fr 2               ;   On entry: BAS_FORPNT (FORPNT) = $FFxx for "match any tag".
00211Fr 2               ;   Returns: X = stack pointer where the matching frame's tag-1 lives,
00211Fr 2               ;            A = tag byte found (or 0 if end-of-stack).  Z=1 if found tag,
00211Fr 2               ;            Z=0 (A=0) if no frame found.
00211Fr 2               ; ---------------------------------------------------------------------------
00211Fr 2               GtForPnt:
00211Fr 2  BA                   tsx
002120r 2  E8                   inx
002121r 2  E8                   inx
002122r 2  E8                   inx
002123r 2  E8                   inx
002124r 2               @scan:
002124r 2  BD 01 01             lda     $0101,x                 ; tag candidate
002127r 2  C9 81                cmp     #TOK_FOR
002129r 2  D0 24                bne     @notFor
00212Br 2                       ; Compare frame's variable address to FORPNT.
00212Br 2  A5 47                lda     BAS_FORPNT+1
00212Dr 2  D0 0A                bne     @skipVar                ; FORPNT+1 = $FF -> skip variable test
00212Fr 2  BD 02 01             lda     $0102,x
002132r 2  85 46                sta     BAS_FORPNT
002134r 2  BD 03 01             lda     $0103,x
002137r 2  85 47                sta     BAS_FORPNT+1
002139r 2               @skipVar:
002139r 2  DD 03 01             cmp     $0103,x
00213Cr 2  D0 07                bne     @advance
00213Er 2  A5 46                lda     BAS_FORPNT
002140r 2  DD 02 01             cmp     $0102,x
002143r 2  F0 11                beq     @found
002145r 2               @advance:
002145r 2  8A                   txa
002146r 2  18                   clc
002147r 2  69 12                adc     #18                     ; BYTES_PER_FRAME (FOR)
002149r 2  AA                   tax
00214Ar 2  D0 D8                bne     @scan
00214Cr 2                       ; Walked off stack
00214Cr 2  A9 00                lda     #0
00214Er 2  60                   rts
00214Fr 2               @notFor:
00214Fr 2  C9 8C                cmp     #TOK_GOSUB
002151r 2  F0 03                beq     @found
002153r 2  A9 00                lda     #0
002155r 2  60                   rts
002156r 2               @found:
002156r 2  60                   rts
002157r 2               
002157r 2               ; ---------------------------------------------------------------------------
002157r 2               ; BasRemn -- scan TXTPTR forward to next ':' or end-of-line.
002157r 2               ; Sets Y to byte offset of terminator from current TXTPTR.  Honours quotes.
002157r 2               ; ---------------------------------------------------------------------------
002157r 2               BasDatan:
002157r 2  A2 3A                ldx     #':'
002159r 2  2C                   .byte   $2C                     ; BIT abs absorbs next 2-byte LDX
00215Ar 2               BasRemn:
00215Ar 2  A2 00                ldx     #0
00215Cr 2  86 44                stx     CHARAC
00215Er 2  A0 00                ldy     #0
002160r 2  84 6A                sty     ENDCHR
002162r 2               @swap:
002162r 2  A5 6A                lda     ENDCHR
002164r 2  A6 44                ldx     CHARAC
002166r 2  85 44                sta     CHARAC
002168r 2  86 6A                stx     ENDCHR
00216Ar 2               @scan:
00216Ar 2  B1 04                lda     (TXTPTR),y
00216Cr 2  F0 0B                beq     @done
00216Er 2  C5 6A                cmp     ENDCHR
002170r 2  F0 07                beq     @done
002172r 2  C8                   iny
002173r 2  C9 22                cmp     #'"'
002175r 2  F0 EB                beq     @swap
002177r 2  D0 F1                bne     @scan
002179r 2               @done:
002179r 2  60                   rts
00217Ar 2               
00217Ar 2               ; ---------------------------------------------------------------------------
00217Ar 2               ; Statement: REM -- skip to end of line.
00217Ar 2               ; Statement: DATA -- treated like REM at execution time (just skip).
00217Ar 2               ; ---------------------------------------------------------------------------
00217Ar 2               BasCmdRem:
00217Ar 2  20 rr rr             jsr     BasRemn
00217Dr 2  80 03                bra     BasAddon
00217Fr 2               BasCmdData:
00217Fr 2  20 rr rr             jsr     BasDatan
002182r 2               BasAddon:
002182r 2  98                   tya
002183r 2  18                   clc
002184r 2  65 04                adc     TXTPTR
002186r 2  85 04                sta     TXTPTR
002188r 2  90 02                bcc     @done
00218Ar 2  E6 05                inc     TXTPTR+1
00218Cr 2               @done:
00218Cr 2  60                   rts
00218Dr 2               
00218Dr 2               ; ---------------------------------------------------------------------------
00218Dr 2               ; Statement: IF expr THEN (linenum | stmt) [ELSE stmt]
00218Dr 2               ;   IF expr GOTO linenum is also accepted.
00218Dr 2               ;   If expr is false, skip rest of line (REM-style).
00218Dr 2               ;   ELSE: scan ahead for TOK_ELSE on this line.
00218Dr 2               ; ---------------------------------------------------------------------------
00218Dr 2               BasCmdIf:
00218Dr 2  20 rr rr             jsr     FrmEvl
002190r 2  20 rr rr             jsr     ChrGot
002193r 2  C9 88                cmp     #TOK_GOTO
002195r 2  F0 05                beq     @testTrue
002197r 2  A9 9F                lda     #TOK_THEN
002199r 2  20 rr rr             jsr     SynChr
00219Cr 2               @testTrue:
00219Cr 2  A5 0E                lda     FAC
00219Er 2  D0 1E                bne     @true
0021A0r 2                       ; FALSE: scan to end-of-line OR a TOK_ELSE; if ELSE found, advance
0021A0r 2                       ; TXTPTR past it and resume execution there.
0021A0r 2  A0 00                ldy     #0
0021A2r 2               @searchElse:
0021A2r 2  B1 04                lda     (TXTPTR),y
0021A4r 2  F0 07                beq     @noElse
0021A6r 2  C9 A4                cmp     #TOK_ELSE
0021A8r 2  F0 09                beq     @gotElse
0021AAr 2  C8                   iny
0021ABr 2  D0 F5                bne     @searchElse
0021ADr 2               @noElse:
0021ADr 2                       ; Skip remainder of line (no ELSE).
0021ADr 2  20 rr rr             jsr     BasRemn
0021B0r 2  4C rr rr             jmp     BasAddon
0021B3r 2               @gotElse:
0021B3r 2                       ; Advance TXTPTR past ELSE token, then run the ELSE branch as a
0021B3r 2                       ; statement.  Falling through to @true's tail is deliberate: the
0021B3r 2                       ; branch after ELSE is dispatched exactly like the one after THEN,
0021B3r 2                       ; so `ELSE <linenum>` is an implicit GOTO too.  Returning here
0021B3r 2                       ; instead would leave TXTPTR mid-statement and the interpreter loop
0021B3r 2                       ; would report ?SYNTAX ERROR.
0021B3r 2  C8                   iny
0021B4r 2  98                   tya
0021B5r 2  18                   clc
0021B6r 2  65 04                adc     TXTPTR
0021B8r 2  85 04                sta     TXTPTR
0021BAr 2  90 02                bcc     @true
0021BCr 2  E6 05                inc     TXTPTR+1
0021BEr 2               @true:
0021BEr 2                       ; TRUE: if next is a digit, IF expr THEN <linenum> -> implicit GOTO.
0021BEr 2  20 rr rr             jsr     ChrGot
0021C1r 2  90 03                bcc     @goto                   ; carry CLEAR -> digit
0021C3r 2                       ; Otherwise dispatch as a statement (msbasic: jmp EXECUTE_STATEMENT).
0021C3r 2  4C rr rr             jmp     BasExecuteStatement
0021C6r 2               @goto:
0021C6r 2  4C rr rr             jmp     BasCmdGoto
0021C9r 2               
0021C9r 2               ; ---------------------------------------------------------------------------
0021C9r 2               ; Statement: ON expr GOTO/GOSUB linenum,linenum,...
0021C9r 2               ; ---------------------------------------------------------------------------
0021C9r 2               BasCmdOn:
0021C9r 2  20 rr rr             jsr     GetByt                  ; X = expr byte (1..255)
0021CCr 2  48                   pha                             ; save GOTO/GOSUB token byte
0021CDr 2  C9 8C                cmp     #TOK_GOSUB
0021CFr 2  F0 04                beq     @loop
0021D1r 2  C9 88                cmp     #TOK_GOTO
0021D3r 2  D0 14                bne     @synErr
0021D5r 2               @loop:
0021D5r 2  C6 12                dec     FAC+4
0021D7r 2  D0 04                bne     @next
0021D9r 2  68                   pla
0021DAr 2                       ; Re-dispatch through statement table so trampoline ChrGet skips the
0021DAr 2                       ; current separator (',' or 0) before the GOTO/GOSUB handler runs.
0021DAr 2  4C rr rr             jmp     BasExecuteStatement
0021DDr 2               @next:
0021DDr 2  20 rr rr             jsr     ChrGet
0021E0r 2  20 rr rr             jsr     LinGet
0021E3r 2  C9 2C                cmp     #','
0021E5r 2  F0 EE                beq     @loop
0021E7r 2  68                   pla
0021E8r 2  60                   rts
0021E9r 2               @synErr:
0021E9r 2  68                   pla
0021EAr 2  4C rr rr             jmp     SynErr
0021EDr 2               
0021EDr 2               ; ---------------------------------------------------------------------------
0021EDr 2               ; GetByt / GtByteCom -- evaluate expression in TXTPTR to byte 0..255 in X.
0021EDr 2               ;   GetByt: TXTPTR is at first byte of expression.
0021EDr 2               ;   GtByteCom: consume comma first.
0021EDr 2               ; ---------------------------------------------------------------------------
0021EDr 2               GtByteCom:
0021EDr 2  20 rr rr             jsr     ChrGet
0021F0r 2               GetByt:
0021F0r 2  20 rr rr             jsr     FrmNum
0021F3r 2  20 rr rr             jsr     MkInt
0021F6r 2  A6 11                ldx     FAC+3
0021F8r 2  D0 05                bne     @ovf
0021FAr 2  A6 12                ldx     FAC+4
0021FCr 2  4C rr rr             jmp     ChrGot
0021FFr 2               @ovf:
0021FFr 2  4C rr rr             jmp     IqErr
002202r 2               
002202r 2               ; ---------------------------------------------------------------------------
002202r 2               ; Statement: RUN [linenum]
002202r 2               ; ---------------------------------------------------------------------------
002202r 2               BasCmdRun:
002202r 2  20 rr rr             jsr     ChrGot
002205r 2  D0 1F                bne     @withLine
002207r 2  20 rr rr             jsr     BasCmdClr
00220Ar 2                       ; Set TXTPTR = TXTTAB - 1 ; ensure that byte = 0.
00220Ar 2  38                   sec
00220Br 2  AD 5D 03             lda     BAS_TXTTAB
00220Er 2  E9 01                sbc     #1
002210r 2  85 04                sta     TXTPTR
002212r 2  AD 5E 03             lda     BAS_TXTTAB+1
002215r 2  E9 00                sbc     #0
002217r 2  85 05                sta     TXTPTR+1
002219r 2                       ; Force the byte at TXTTAB-1 to be zero so NEWSTT walks the chain.
002219r 2  A9 00                lda     #0
00221Br 2  A0 00                ldy     #0
00221Dr 2  91 04                sta     (TXTPTR),y
00221Fr 2                       ; Leave direct-mode (CURLIN+1=$FF); @loadLine will set real value.
00221Fr 2  9C 69 03             stz     BAS_CURLIN
002222r 2  9C 6A 03             stz     BAS_CURLIN+1
002225r 2  60                   rts
002226r 2               @withLine:
002226r 2  20 rr rr             jsr     BasCmdClr
002229r 2  20 rr rr             jsr     ChrGot
00222Cr 2  4C rr rr             jmp     BasCmdGoto
00222Fr 2               
00222Fr 2               ; ---------------------------------------------------------------------------
00222Fr 2               ; Statement: END / STOP -- save CONT context and return to REPL.
00222Fr 2               ; ---------------------------------------------------------------------------
00222Fr 2               BasCmdEnd:
00222Fr 2  18                   clc
002230r 2  24                   .byte   $24                     ; BIT zp -> skip next byte (sec)
002231r 2               BasCmdStop:
002231r 2  38                   sec
002232r 2                       ; Save the END/STOP flag (carry) before ChrGot clobbers it.
002232r 2  08                   php
002233r 2  20 rr rr             jsr     ChrGot
002236r 2  D0 57                bne     @synErrPlp
002238r 2  28                   plp
002239r 2                       ; Save CONT state.
002239r 2  A5 04                lda     TXTPTR
00223Br 2  8D 6D 03             sta     BAS_OLDTEXT
00223Er 2  A5 05                lda     TXTPTR+1
002240r 2  8D 6E 03             sta     BAS_OLDTEXT+1
002243r 2  AD 69 03             lda     BAS_CURLIN
002246r 2  8D 6B 03             sta     BAS_OLDLIN
002249r 2  AD 6A 03             lda     BAS_CURLIN+1
00224Cr 2  8D 6C 03             sta     BAS_OLDLIN+1
00224Fr 2  A2 FF                ldx     #$FF
002251r 2  9A                   txs
002252r 2  90 30                bcc     @end
002254r 2                       ; STOP path: print "BREAK[ IN nnnn]".
002254r 2  20 rr rr             jsr     BasPrintCRLF
002257r 2  A9 rr                lda     #<MsgBreak
002259r 2  A0 rr                ldy     #>MsgBreak
00225Br 2  20 rr rr             jsr     BasPrintStr
00225Er 2  AD 6A 03             lda     BAS_CURLIN+1
002261r 2  C9 FF                cmp     #$FF
002263r 2  F0 14                beq     @endNoLine
002265r 2  A9 rr                lda     #<MsgInWord
002267r 2  A0 rr                ldy     #>MsgInWord
002269r 2  20 rr rr             jsr     BasPrintStr
00226Cr 2  AD 69 03             lda     BAS_CURLIN
00226Fr 2  85 08                sta     BAS_LINNUM
002271r 2  AD 6A 03             lda     BAS_CURLIN+1
002274r 2  85 09                sta     BAS_LINNUM+1
002276r 2  20 rr rr             jsr     BasPrintLineNum
002279r 2               @endNoLine:
002279r 2  A9 FF                lda     #$FF
00227Br 2  8D 69 03             sta     BAS_CURLIN
00227Er 2  8D 6A 03             sta     BAS_CURLIN+1
002281r 2  4C rr rr             jmp     BasReadyLoop
002284r 2               @end:
002284r 2  A9 FF                lda     #$FF
002286r 2  8D 69 03             sta     BAS_CURLIN
002289r 2  8D 6A 03             sta     BAS_CURLIN+1
00228Cr 2  4C rr rr             jmp     BasReadyLoop
00228Fr 2               @synErrPlp:
00228Fr 2  28                   plp
002290r 2               @synErr:
002290r 2  4C rr rr             jmp     SynErr
002293r 2               
002293r 2               ; ---------------------------------------------------------------------------
002293r 2               ; Statement: CONT -- resume execution from saved OLDTEXT/OLDLIN.
002293r 2               ; ---------------------------------------------------------------------------
002293r 2               BasCmdCont:
002293r 2  20 rr rr             jsr     ChrGot
002296r 2  D0 21                bne     @synErr
002298r 2  AD 6E 03             lda     BAS_OLDTEXT+1
00229Br 2  D0 05                bne     @canCont
00229Dr 2  A2 10                ldx     #ERR_CANTCONT
00229Fr 2  4C rr rr             jmp     BasErrorVec
0022A2r 2               @canCont:
0022A2r 2  AD 6D 03             lda     BAS_OLDTEXT
0022A5r 2  85 04                sta     TXTPTR
0022A7r 2  AD 6E 03             lda     BAS_OLDTEXT+1
0022AAr 2  85 05                sta     TXTPTR+1
0022ACr 2  AD 6B 03             lda     BAS_OLDLIN
0022AFr 2  8D 69 03             sta     BAS_CURLIN
0022B2r 2  AD 6C 03             lda     BAS_OLDLIN+1
0022B5r 2  8D 6A 03             sta     BAS_CURLIN+1
0022B8r 2  60                   rts
0022B9r 2               @synErr:
0022B9r 2  4C rr rr             jmp     SynErr
0022BCr 2               
0022BCr 2               ; ---------------------------------------------------------------------------
0022BCr 2               ; Statement: RESTORE -- DATAPTR := TXTTAB - 1.
0022BCr 2               ; ---------------------------------------------------------------------------
0022BCr 2               BasCmdRestore:
0022BCr 2  38                   sec
0022BDr 2  AD 5D 03             lda     BAS_TXTTAB
0022C0r 2  E9 01                sbc     #1
0022C2r 2  8D 1A 03             sta     BAS_DATAPTR
0022C5r 2  AD 5E 03             lda     BAS_TXTTAB+1
0022C8r 2  E9 00                sbc     #0
0022CAr 2  8D 1B 03             sta     BAS_DATAPTR+1
0022CDr 2  60                   rts
0022CEr 2               
0022CEr 2               ; ---------------------------------------------------------------------------
0022CEr 2               ; Statement: INPUT [<"prompt">{,;}] var[,var,...]
0022CEr 2               ;   Prompts user for input, reads a line, parses it into the variable list.
0022CEr 2               ;   "abc";VAR  prints  abc?    (question + space appended)
0022CEr 2               ;   "abc",VAR  prints  abc      (no question mark)
0022CEr 2               ;   no prompt: prints  ?
0022CEr 2               ;   On bad numeric input or premature end-of-line: "?REDO FROM START"
0022CEr 2               ;   and reprompt.  Trailing un-consumed input: "?EXTRA IGNORED".
0022CEr 2               ; ---------------------------------------------------------------------------
0022CEr 2               BasCmdInput:
0022CEr 2                       ; INPUT is illegal in direct mode.
0022CEr 2  AD 6A 03             lda     BAS_CURLIN+1
0022D1r 2  C9 FF                cmp     #$FF
0022D3r 2  D0 05                bne     @notDirect
0022D5r 2  A2 07                ldx     #ERR_ILLDIRECT
0022D7r 2  4C rr rr             jmp     BasErrorVec
0022DAr 2               @notDirect:
0022DAr 2                       ; ChrGot returns first char after the INPUT token.
0022DAr 2  20 rr rr             jsr     ChrGot
0022DDr 2  C9 22                cmp     #'"'
0022DFr 2  D0 27                bne     @noPrompt
0022E1r 2                       ; Parse string literal & print it; FrmEvl will leave descriptor in FAC.
0022E1r 2  20 rr rr             jsr     FrmEvl
0022E4r 2  20 rr rr             jsr     ChkStr
0022E7r 2  20 rr rr             jsr     PrintStrFAC
0022EAr 2  20 rr rr             jsr     FreFac
0022EDr 2  20 rr rr             jsr     ChrGot
0022F0r 2  C9 3B                cmp     #';'
0022F2r 2  F0 09                beq     @semi
0022F4r 2  C9 2C                cmp     #','
0022F6r 2  D0 0D                bne     @badPrompt
0022F8r 2  20 rr rr             jsr     ChrGet                  ; consume ','
0022FBr 2  80 0E                bra     @afterPrompt
0022FDr 2               @semi:
0022FDr 2  20 rr rr             jsr     ChrGet                  ; consume ';'
002300r 2  20 rr rr             jsr     BasInpQues              ; '? '
002303r 2  80 06                bra     @afterPrompt
002305r 2               @badPrompt:
002305r 2  4C rr rr             jmp     SynErr
002308r 2               @noPrompt:
002308r 2  20 rr rr             jsr     BasInpQues              ; '? '
00230Br 2               @afterPrompt:
00230Br 2                       ; Save program TXTPTR (start of var-list) for REDO retry.
00230Br 2  A5 04                lda     TXTPTR
00230Dr 2  8D 71 03             sta     BAS_INPSAV
002310r 2  A5 05                lda     TXTPTR+1
002312r 2  8D 72 03             sta     BAS_INPSAV+1
002315r 2               @retry:
002315r 2  20 rr rr             jsr     BasReadLine             ; reads to BAS_LINBUF, NUL-terminated, prints CRLF
002318r 2                       ; Set up data pointer with leading ',' sentinel just before LINBUF.
002318r 2  A9 2C                lda     #','
00231Ar 2  8D FF 03             sta     BAS_LINBUF-1
00231Dr 2  A9 FF                lda     #<(BAS_LINBUF-1)
00231Fr 2  85 3A                sta     BAS_TMP1
002321r 2  A9 03                lda     #>(BAS_LINBUF-1)
002323r 2  85 3B                sta     BAS_TMP1+1
002325r 2                       ; Restore program TXTPTR.
002325r 2  AD 71 03             lda     BAS_INPSAV
002328r 2  85 04                sta     TXTPTR
00232Ar 2  AD 72 03             lda     BAS_INPSAV+1
00232Dr 2  85 05                sta     TXTPTR+1
00232Fr 2  64 69                stz     BAS_INPUTFLG            ; INPUT mode ($00)
002331r 2               @nextVar:
002331r 2  20 rr rr             jsr     PtrGet                  ; advance program TXTPTR past var name
002334r 2  85 46                sta     BAS_FORPNT
002336r 2  84 47                sty     BAS_FORPNT+1
002338r 2                       ; Save program TXTPTR; switch to data side.
002338r 2  A5 05                lda     TXTPTR+1
00233Ar 2  48                   pha
00233Br 2  A5 04                lda     TXTPTR
00233Dr 2  48                   pha
00233Er 2  A5 3A                lda     BAS_TMP1
002340r 2  85 04                sta     TXTPTR
002342r 2  A5 3B                lda     BAS_TMP1+1
002344r 2  85 05                sta     TXTPTR+1
002346r 2  20 rr rr             jsr     ChrGot
002349r 2  D0 05                bne     @gotData
00234Br 2                       ; Out of input data before var list exhausted -> REDO.
00234Br 2  68                   pla
00234Cr 2  68                   pla
00234Dr 2  4C rr rr             jmp     @doRedo
002350r 2               @gotData:
002350r 2  20 rr rr             jsr     ChrGet                  ; consume the separator/sentinel
002353r 2  24 64                bit     VALTYP
002355r 2  30 2E                bmi     @inpStr
002357r 2                       ; Numeric: must start with digit, '+', '-' or '.'; else REDO.
002357r 2  20 rr rr             jsr     ChrGot
00235Ar 2  90 11                bcc     @numOk                  ; carry clear == digit
00235Cr 2  C9 2D                cmp     #'-'
00235Er 2  F0 0D                beq     @numOk
002360r 2  C9 2B                cmp     #'+'
