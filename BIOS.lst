002885r 2               
002885r 2               ; SOUND voice, freq, dur (freq=Hz, dur=centisec)
002885r 2               ;   Hz -> SID register: reg = Hz * 16.75 ≈ Hz<<4 + Hz - Hz/4
002885r 2               BasCmdSound:
002885r 2  A9 40                lda     #HW_SID
002887r 2  20 rr rr             jsr     ReqHw
00288Ar 2  20 rr rr             jsr     GetByt                  ; X = voice (1..3)
00288Dr 2  CA                   dex
00288Er 2  DA                   phx                             ; voice (0-indexed) on stack
00288Fr 2  20 rr rr             jsr     ChkCom
002892r 2  20 rr rr             jsr     EvalU16                 ; freq Hz: hi=FAC+3, lo=FAC+4
002895r 2                       ; Compute reg = Hz<<4 + Hz - Hz/4
002895r 2  A5 12                lda     FAC+4
002897r 2  85 3A                sta     BAS_TMP1
002899r 2  A5 11                lda     FAC+3
00289Br 2  85 3B                sta     BAS_TMP1+1
00289Dr 2  A5 3A                lda     BAS_TMP1
00289Fr 2  85 3C                sta     BAS_TMP2
0028A1r 2  A5 3B                lda     BAS_TMP1+1
0028A3r 2  85 3D                sta     BAS_TMP2+1
0028A5r 2  A2 04                ldx     #4
0028A7r 2               @shl:
0028A7r 2  06 3A                asl     BAS_TMP1
0028A9r 2  26 3B                rol     BAS_TMP1+1
0028ABr 2  CA                   dex
0028ACr 2  D0 F9                bne     @shl
0028AEr 2  18                   clc
0028AFr 2  A5 3A                lda     BAS_TMP1
0028B1r 2  65 3C                adc     BAS_TMP2
0028B3r 2  85 3A                sta     BAS_TMP1
0028B5r 2  A5 3B                lda     BAS_TMP1+1
0028B7r 2  65 3D                adc     BAS_TMP2+1
0028B9r 2  85 3B                sta     BAS_TMP1+1
0028BBr 2  46 3D                lsr     BAS_TMP2+1
0028BDr 2  66 3C                ror     BAS_TMP2
0028BFr 2  46 3D                lsr     BAS_TMP2+1
0028C1r 2  66 3C                ror     BAS_TMP2
0028C3r 2  38                   sec
0028C4r 2  A5 3A                lda     BAS_TMP1
0028C6r 2  E5 3C                sbc     BAS_TMP2
0028C8r 2  48                   pha                             ; freqLo
0028C9r 2  A5 3B                lda     BAS_TMP1+1
0028CBr 2  E5 3D                sbc     BAS_TMP2+1
0028CDr 2  48                   pha                             ; freqHi
0028CEr 2  20 rr rr             jsr     ChkCom
0028D1r 2  20 rr rr             jsr     EvalU16                 ; dur in FAC+3/+4
0028D4r 2                       ; Stack (top-down): freqHi, freqLo, voice
0028D4r 2  7A                   ply                             ; Y = freqHi
0028D5r 2  FA                   plx                             ; X = freqLo
0028D6r 2  68                   pla                             ; A = voice
0028D7r 2  20 rr rr             jsr     SidPlayNote
0028DAr 2  A5 12                lda     FAC+4
0028DCr 2  A6 11                ldx     FAC+3
0028DEr 2  20 rr rr             jsr     SysDelay
0028E1r 2  4C rr rr             jmp     SidSilence
