001121r 2               ;   V A R I A B L E S ,   A R R A Y S ,   S T R I N G   H E A P
001121r 2               ;
001121r 2               ;   Inline-ported from msbasic-master/{var,array,string,memory}.s and
001121r 2               ;   misc2.s (GivAyf/SngFlt).  All MSBASIC externals are resolved here:
001121r 2               ;
001121r 2               ;     SynErr / MemErr / IqErr / SubErr / Gme        - error trampolines
001121r 2               ;     ChkCom / ChkCls / ChkNum / ChkStr             - parser predicates
001121r 2               ;     MakInt / FrmNum / FrmEvl                      - minimal stubs (only
001121r 2               ;                                                     handle literal unsigned
001121r 2               ;                                                     decimals via Fin; full
001121r 2               ;                                                     evaluator wired in a
001121r 2               ;                                                     later phase)
001121r 2               ;     IsLetC                                        - ASCII letter test
001121r 2               ;     PtrGet / Array / GetAry                       - variable lookup
001121r 2               ;     StrIni / StrSpa / GetSpa / PutNew / MovStr    - string allocation
001121r 2               ;     Garbag (and helpers)                          - string GC
001121r 2               ;     Bltu / Reason                                 - block-up-move helpers
001121r 2               ;     AyInt / GivAyf / SngFlt                       - FP <-> 16-bit int
001121r 2               ;     BasCmdClr                                     - implements CLR / NEW core
001121r 2               ; =============================================================================
001121r 2               
001121r 2               ; ---------------------------------------------------------------------------
001121r 2               ; SynErr / MemErr / IqErr / SubErr / Gme -- error trampolines.
001121r 2               ; The msbasic convention is "ldx #code; jmp ERROR".  Our BasError takes the
001121r 2               ; code in A, so translate; BasErrorVec (defined earlier) does that translation.
001121r 2               ; ---------------------------------------------------------------------------
001121r 2               SynErr:
001121r 2  A2 00                ldx     #ERR_SYNTAX
001123r 2  4C rr rr             jmp     BasErrorVec
001126r 2               
001126r 2               MemErr:
001126r 2  A2 02                ldx     #ERR_MEMFULL
001128r 2  4C rr rr             jmp     BasErrorVec
00112Br 2               
00112Br 2               SubErr:
00112Br 2  A2 04                ldx     #ERR_BADSUBS
