001824r 2               ; ---------------------------------------------------------------------------
001824r 2               ; BasCmdClr -- implement CLR (clear vars/arrays/strings without erasing program).
001824r 2               ;   VARTAB := PRGEND (already correct in our model)
001824r 2               ;   ARYTAB := STREND := VARTAB
001824r 2               ;   FRETOP := MEMSIZ
001824r 2               ;   TEMPPT := TEMPST, DATAPTR := TXTTAB-1, stacks emptied
001824r 2               ; ---------------------------------------------------------------------------
001824r 2               BasCmdClr:
001824r 2                       ; Reset the CPU stack, msbasic's STKINI: any FOR or GOSUB frame a
001824r 2                       ; suspended program left there is being abandoned along with its
001824r 2                       ; variables, and RUN starting on top of one would let a later NEXT find
001824r 2                       ; a loop from the previous run.  The return address rides across the
001824r 2                       ; reset so this is still an ordinary subroutine to its callers.
001824r 2  68                   pla                             ; return address low
001825r 2  A8                   tay
001826r 2  68                   pla                             ; return address high
001827r 2  A2 FF                ldx     #$FF
001829r 2  9A                   txs
00182Ar 2  8E 75 03             stx     BAS_STKBASE
00182Dr 2  48                   pha
00182Er 2  98                   tya
00182Fr 2  48                   pha
001830r 2                       ; ARYTAB = STREND = VARTAB
001830r 2  AD 5F 03             lda     VARTAB
001833r 2  8D 61 03             sta     ARYTAB
001836r 2  8D 63 03             sta     STREND
001839r 2  AD 60 03             lda     VARTAB+1
00183Cr 2  8D 62 03             sta     ARYTAB+1
00183Fr 2  8D 64 03             sta     STREND+1
001842r 2                       ; FRETOP = MEMSIZ
001842r 2  AD 67 03             lda     MEMSIZ
001845r 2  8D 65 03             sta     FRETOP
001848r 2  AD 68 03             lda     MEMSIZ+1
00184Br 2  8D 66 03             sta     FRETOP+1
00184Er 2                       ; Reset temp string descriptor stack.
00184Er 2  A9 6E                lda     #BAS_TEMPST
001850r 2  85 6B                sta     TEMPPT
001852r 2  64 6C                stz     LASTPT
001854r 2  64 6D                stz     LASTPT+1
001856r 2                       ; CONT state, DATA pointer, pending key.
001856r 2                       ; DATAPTR := TXTTAB - 1 so first READ does FindData and lands on
001856r 2                       ; the first DATA item.
001856r 2  38                   sec
001857r 2  AD 5D 03             lda     TXTTAB
00185Ar 2  E9 01                sbc     #1
00185Cr 2  8D 1A 03             sta     BAS_DATAPTR
00185Fr 2  AD 5E 03             lda     TXTTAB+1
001862r 2  E9 00                sbc     #0
001864r 2  8D 1B 03             sta     BAS_DATAPTR+1
001867r 2  9C 6B 03             stz     BAS_OLDLIN
00186Ar 2  9C 6C 03             stz     BAS_OLDLIN+1
00186Dr 2  9C 6D 03             stz     BAS_OLDTEXT
001870r 2  9C 6E 03             stz     BAS_OLDTEXT+1
001873r 2  9C 1C 03             stz     BAS_STOPLINE
001876r 2  9C 1D 03             stz     BAS_STOPLINE+1
001879r 2  9C 1E 03             stz     BAS_STOPTXT
00187Cr 2  9C 1F 03             stz     BAS_STOPTXT+1
00187Fr 2  9C 0E 03             stz     BAS_PENDKEY
001882r 2  64 63                stz     DIMFLG
001884r 2  64 68                stz     SUBFLG
001886r 2  64 64                stz     VALTYP
001888r 2  64 65                stz     VALTYP+1
