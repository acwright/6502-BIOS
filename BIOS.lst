0008D6r 2  85 1C                sta     SGNCPR
0008D8r 2  A5 0E                lda     FAC
0008DAr 2  4C rr rr             jmp     FAddT
0008DDr 2               
0008DDr 2               ; ----------------------------------------------------------------------------
0008DDr 2               ; Commodore BASIC V2 Easter Egg
0008DDr 2               ; ----------------------------------------------------------------------------
0008DDr 2               
0008DDr 2               ; ----------------------------------------------------------------------------
