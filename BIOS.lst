0010F0r 2               ; SynErr / MemErr / IqErr / SubErr / Gme -- error trampolines.
0010F0r 2               ; The msbasic convention is "ldx #code; jmp ERROR".  Our BasError takes the
0010F0r 2               ; code in A, so translate; BasErrorVec (defined earlier) does that translation.
0010F0r 2               ; ---------------------------------------------------------------------------
0010F0r 2               SynErr:
0010F0r 2  A2 00                ldx     #ERR_SYNTAX
0010F2r 2  4C rr rr             jmp     BasErrorVec
0010F5r 2               
0010F5r 2               MemErr:
0010F5r 2  A2 02                ldx     #ERR_MEMFULL
0010F7r 2  4C rr rr             jmp     BasErrorVec
0010FAr 2               
0010FAr 2               SubErr:
0010FAr 2  A2 04                ldx     #ERR_BADSUBS
0010FCr 2  4C rr rr             jmp     BasErrorVec
0010FFr 2               
0010FFr 2               Gse:
0010FFr 2  4C rr rr             jmp     SubErr
001102r 2               
001102r 2               Gme:
001102r 2  4C rr rr             jmp     MemErr
