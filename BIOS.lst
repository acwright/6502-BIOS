0009A4r 2               NormalizeFac4:
0009A4r 2  10 F2                bpl     NormalizeFac3
0009A6r 2  38                   sec
0009A7r 2  E5 0E                sbc     FAC
0009A9r 2  B0 C7                bcs     ZeroFac
0009ABr 2  49 FF                eor     #$FF
0009ADr 2  69 01                adc     #$01
0009AFr 2  85 0E                sta     FAC
0009B1r 2               NormalizeFac5:
0009B1r 2  90 0E                bcc     Lbl3764
0009B3r 2               NormalizeFac6:
