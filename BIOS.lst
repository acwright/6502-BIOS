001713r 2  9C 6D 03             stz     BAS_OLDTEXT
001716r 2  9C 6E 03             stz     BAS_OLDTEXT+1
001719r 2  9C 1C 03             stz     BAS_STOPLINE
00171Cr 2  9C 1D 03             stz     BAS_STOPLINE+1
00171Fr 2  9C 1E 03             stz     BAS_STOPTXT
001722r 2  9C 1F 03             stz     BAS_STOPTXT+1
